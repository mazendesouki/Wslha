+-- دالة: التحقق من كود الخصم
+CREATE OR REPLACE FUNCTION validate_promo(p_code TEXT, p_phone TEXT, p_amount DECIMAL)
+RETURNS JSON LANGUAGE plpgsql SECURITY DEFINER AS $$
+DECLARE
+  promo promo_codes%ROWTYPE;
+  used  INT;
+  discount DECIMAL;
+BEGIN
+  SELECT * INTO promo FROM promo_codes WHERE code = UPPER(p_code) AND is_active = true;
+  IF NOT FOUND THEN
+    RETURN json_build_object('valid', false, 'error', 'الكود غير صحيح');
+  END IF;
+  IF promo.valid_to IS NOT NULL AND promo.valid_to < NOW() THEN
+    RETURN json_build_object('valid', false, 'error', 'انتهت صلاحية الكود');
+  END IF;
+  IF promo.used_count >= promo.usage_limit THEN
+    RETURN json_build_object('valid', false, 'error', 'تم استنفاد الكود');
+  END IF;
+  SELECT COUNT(*) INTO used FROM promo_usage WHERE code = p_code AND phone = p_phone;
+  IF used > 0 THEN
+    RETURN json_build_object('valid', false, 'error', 'استخدمت هذا الكود مسبقاً');
+  END IF;
+  IF p_amount < promo.min_order THEN
+    RETURN json_build_object('valid', false, 'error', 'الحد الأدنى للطلب ' || promo.min_order || ' ج.م');
+  END IF;
+  IF promo.discount_type = 'percent' THEN
+    discount := p_amount * promo.discount_value / 100;
+    IF promo.max_discount IS NOT NULL THEN
+      discount := LEAST(discount, promo.max_discount);
+    END IF;
+  ELSE
+    discount := promo.discount_value;
+  END IF;
+  RETURN json_build_object(
+    'valid',        true,
+    'discount',     discount,
+    'discount_pct', promo.discount_type = 'percent',
+    'description',  promo.description
+  );
+END; $$;
