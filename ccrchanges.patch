From 0e8b4d609809ee3b723a7f9d8d2e0d6c2522a1d0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 21 Jun 2026 15:23:39 +0000
Subject: [PATCH 4/4] =?UTF-8?q?feat(db):=20comprehensive=20Supabase=20sche?=
 =?UTF-8?q?ma=20=E2=80=94=20users,=20drivers,=20merchants,=20vehicles,=20m?=
 =?UTF-8?q?aps,=20notifications?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

New tables:
- accounts: enhanced with national_id, avatar, email, device_token, last_seen
- drivers: full driver profile with vehicle info, docs, services, stats
- merchants: full merchant profile with business docs, bank info, store settings
- vehicles: vehicle registry linked to drivers with full documentation
- driver_locations: enhanced with speed, accuracy, vehicle_type, order_id
- location_history: historical GPS tracking per ride/order
- service_requests: unified service request table (ride/delivery/airport/rental)
- notifications: real-time notifications for all user roles
- service_areas: 10 Damietta service zones with base fare and per-km pricing
- promo_codes: discount codes with percentage/fixed amounts and usage limits
- promo_usage: tracks who used which code
- driver_earnings: detailed per-trip earnings with commission breakdown
- store_products: menu/product catalog for merchant stores
- user_documents: centralized document storage for all user types
- support_tickets: customer support ticket system
- admin_logs: audit trail of all admin actions

RPC Functions:
- get_admin_stats(): complete admin dashboard KPIs
- get_driver_stats(phone): driver summary (trips, earnings, wallet, rating)
- get_merchant_stats(phone): merchant summary (orders, revenue, wallet)
- update_driver_stats_on_complete(phone): refresh driver aggregates
- find_nearby_drivers(lat, lng, km): geospatial driver search for maps
- validate_promo(code, phone, amount): promo code validation
- send_notification(phone, role, type, title, body, data): create notification

Co-Authored-By: Claude <noreply@anthropic.com>
---
 supabase-new-tables.sql | 784 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 784 insertions(+)
 create mode 100644 supabase-new-tables.sql

diff --git a/supabase-new-tables.sql b/supabase-new-tables.sql
new file mode 100644
index 0000000..237989e
--- /dev/null
+++ b/supabase-new-tables.sql
@@ -0,0 +1,784 @@
+-- ══════════════════════════════════════════════════════════════
+-- وصّلها — Supabase New Tables & API Services
+-- شغّل في: Supabase → SQL Editor
+-- ══════════════════════════════════════════════════════════════
+
+-- ────────────────────────────────────────────────────────────
+-- 1. USERS — ملف المستخدم الكامل
+-- ────────────────────────────────────────────────────────────
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS national_id      TEXT;
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS national_id_url  TEXT;
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS date_of_birth    DATE;
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS gender           TEXT CHECK (gender IN ('male','female')) DEFAULT 'male';
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS avatar_url       TEXT;
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS address          TEXT;
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS city             TEXT DEFAULT 'دمياط';
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS email            TEXT;
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS verified_at      TIMESTAMP WITH TIME ZONE;
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS last_seen        TIMESTAMP WITH TIME ZONE;
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS device_token     TEXT;   -- FCM / APNS token
+ALTER TABLE accounts ADD COLUMN IF NOT EXISTS notes            TEXT;   -- admin notes
+
+CREATE INDEX IF NOT EXISTS idx_accounts_role      ON accounts(role);
+CREATE INDEX IF NOT EXISTS idx_accounts_status    ON accounts(status);
+CREATE INDEX IF NOT EXISTS idx_accounts_city      ON accounts(city);
+CREATE INDEX IF NOT EXISTS idx_accounts_national  ON accounts(national_id);
+
+-- RLS
+ALTER TABLE accounts ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "allow_anon_all_accounts" ON accounts;
+CREATE POLICY "allow_anon_all_accounts" ON accounts
+  FOR ALL TO anon, authenticated USING (true) WITH CHECK (true);
+
+
+-- ────────────────────────────────────────────────────────────
+-- 2. DRIVERS — ملف السائق الكامل
+-- ────────────────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS drivers (
+  phone               TEXT PRIMARY KEY REFERENCES accounts(phone) ON DELETE CASCADE,
+  full_name           TEXT NOT NULL,
+  national_id         TEXT NOT NULL,
+  national_id_expiry  DATE,
+  national_id_front   TEXT,
+  national_id_back    TEXT,
+
+  -- رخصة القيادة
+  license_number      TEXT NOT NULL,
+  license_expiry      DATE,
+  license_photo       TEXT,
+
+  -- بيانات السيارة
+  vehicle_make        TEXT,   -- تويوتا، هيونداي
+  vehicle_model       TEXT,   -- كورولا، اكسنت
+  vehicle_year        INT,
+  vehicle_color       TEXT,
+  vehicle_plate       TEXT,
+  vehicle_type        TEXT DEFAULT 'sedan',  -- sedan, suv, van, motorcycle
+
+  -- وثائق السيارة
+  vehicle_reg_number  TEXT,
+  vehicle_reg_expiry  DATE,
+  vehicle_reg_photo   TEXT,
+  insurance_expiry    DATE,
+  insurance_photo     TEXT,
+  inspection_expiry   DATE,
+  inspection_photo    TEXT,
+
+  -- صور السيارة
+  vehicle_photo_front TEXT,
+  vehicle_photo_back  TEXT,
+  vehicle_photo_right TEXT,
+  vehicle_photo_left  TEXT,
+
+  -- السائق
+  driver_photo        TEXT,
+  good_conduct_url    TEXT,
+
+  -- الخدمات المتاحة
+  service_ride        BOOLEAN DEFAULT true,
+  service_delivery    BOOLEAN DEFAULT false,
+  service_airport     BOOLEAN DEFAULT false,
+
+  -- الإحصائيات
+  total_trips         INT DEFAULT 0,
+  total_earnings      DECIMAL(12,2) DEFAULT 0,
+  rating_avg          DECIMAL(3,2) DEFAULT 0,
+  rating_count        INT DEFAULT 0,
+
+  -- الحالة
+  status              TEXT DEFAULT 'approved',  -- approved, suspended, inactive
+  approved_at         TIMESTAMP WITH TIME ZONE,
+  approved_by         TEXT,   -- admin phone
+
+  created_at          TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
+  updated_at          TIMESTAMP WITH TIME ZONE DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS idx_drivers_status        ON drivers(status);
+CREATE INDEX IF NOT EXISTS idx_drivers_vehicle_type  ON drivers(vehicle_type);
+CREATE INDEX IF NOT EXISTS idx_drivers_service_ride  ON drivers(service_ride);
+
+ALTER TABLE drivers ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "allow_anon_all_drivers" ON drivers;
+CREATE POLICY "allow_anon_all_drivers" ON drivers
+  FOR ALL TO anon, authenticated USING (true) WITH CHECK (true);
+
+
+-- ────────────────────────────────────────────────────────────
+-- 3. MERCHANTS — ملف التاجر الكامل
+-- ────────────────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS merchants (
+  phone                 TEXT PRIMARY KEY REFERENCES accounts(phone) ON DELETE CASCADE,
+  business_name         TEXT NOT NULL,
+  business_name_en      TEXT,
+  business_type         TEXT NOT NULL,  -- restaurant, pharmacy, grocery, electronics
+  business_description  TEXT,
+  business_logo         TEXT,
+  business_cover        TEXT,
+
+  -- العنوان
+  address               TEXT,
+  area                  TEXT,
+  city                  TEXT DEFAULT 'دمياط',
+  lat                   DOUBLE PRECISION,
+  lng                   DOUBLE PRECISION,
+
+  -- وثائق تجارية
+  commercial_reg        TEXT,
+  commercial_reg_date   DATE,
+  commercial_reg_photo  TEXT,
+  tax_card              TEXT,
+  tax_card_photo        TEXT,
+  work_permit_photo     TEXT,
+  national_id           TEXT,
+  national_id_photo     TEXT,
+
+  -- معلومات البنك/السداد
+  bank_name             TEXT,
+  bank_iban             TEXT,
+  bank_account_name     TEXT,
+
+  -- إعدادات المتجر
+  delivery_fee          DECIMAL(8,2) DEFAULT 10,
+  min_order             DECIMAL(8,2) DEFAULT 0,
+  estimated_time        INT DEFAULT 30,  -- minutes
+  opens_at              TIME DEFAULT '08:00',
+  closes_at             TIME DEFAULT '23:00',
+  is_open               BOOLEAN DEFAULT true,
+  is_active             BOOLEAN DEFAULT true,
+
+  -- الإحصائيات
+  total_orders          INT DEFAULT 0,
+  total_revenue         DECIMAL(12,2) DEFAULT 0,
+  rating_avg            DECIMAL(3,2) DEFAULT 0,
+  rating_count          INT DEFAULT 0,
+
+  status                TEXT DEFAULT 'approved',  -- approved, suspended, inactive
+  approved_at           TIMESTAMP WITH TIME ZONE,
+  approved_by           TEXT,
+
+  created_at            TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
+  updated_at            TIMESTAMP WITH TIME ZONE DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS idx_merchants_status         ON merchants(status);
+CREATE INDEX IF NOT EXISTS idx_merchants_business_type  ON merchants(business_type);
+CREATE INDEX IF NOT EXISTS idx_merchants_city           ON merchants(city);
+CREATE INDEX IF NOT EXISTS idx_merchants_is_active      ON merchants(is_active);
+
+ALTER TABLE merchants ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "allow_anon_all_merchants" ON merchants;
+CREATE POLICY "allow_anon_all_merchants" ON merchants
+  FOR ALL TO anon, authenticated USING (true) WITH CHECK (true);
+
+
+-- ────────────────────────────────────────────────────────────
+-- 4. VEHICLES — سجل السيارات
+-- ────────────────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS vehicles (
+  id                TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
+  driver_phone      TEXT NOT NULL REFERENCES accounts(phone) ON DELETE CASCADE,
+
+  make              TEXT NOT NULL,   -- تويوتا
+  model             TEXT NOT NULL,   -- كورولا
+  year              INT NOT NULL,
+  color             TEXT NOT NULL,
+  plate             TEXT NOT NULL UNIQUE,
+  type              TEXT DEFAULT 'sedan',  -- sedan, suv, van, motorcycle, truck
+
+  -- وثائق
+  reg_number        TEXT,
+  reg_expiry        DATE,
+  reg_photo         TEXT,
+  insurance_expiry  DATE,
+  insurance_photo   TEXT,
+  inspection_expiry DATE,
+  inspection_photo  TEXT,
+
+  -- صور السيارة
+  photo_front       TEXT,
+  photo_back        TEXT,
+  photo_right       TEXT,
+  photo_left        TEXT,
+
+  is_primary        BOOLEAN DEFAULT true,   -- السيارة الرئيسية للسائق
+  is_active         BOOLEAN DEFAULT true,
+
+  created_at        TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
+  updated_at        TIMESTAMP WITH TIME ZONE DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS idx_vehicles_driver  ON vehicles(driver_phone);
+CREATE INDEX IF NOT EXISTS idx_vehicles_plate   ON vehicles(plate);
+CREATE INDEX IF NOT EXISTS idx_vehicles_type    ON vehicles(type);
+
+ALTER TABLE vehicles ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "allow_anon_all_vehicles" ON vehicles;
+CREATE POLICY "allow_anon_all_vehicles" ON vehicles
+  FOR ALL TO anon, authenticated USING (true) WITH CHECK (true);
+
+
+-- ────────────────────────────────────────────────────────────
+-- 5. VEHICLE_LOCATIONS — مواقع السيارات اللحظية (محسّن)
+-- ────────────────────────────────────────────────────────────
+ALTER TABLE driver_locations ADD COLUMN IF NOT EXISTS speed        DOUBLE PRECISION DEFAULT 0;
+ALTER TABLE driver_locations ADD COLUMN IF NOT EXISTS accuracy     DOUBLE PRECISION DEFAULT 0;
+ALTER TABLE driver_locations ADD COLUMN IF NOT EXISTS vehicle_type TEXT DEFAULT 'sedan';
+ALTER TABLE driver_locations ADD COLUMN IF NOT EXISTS plate        TEXT;
+ALTER TABLE driver_locations ADD COLUMN IF NOT EXISTS order_id     TEXT;  -- active delivery order
+
+-- إضافة Realtime للمواقع
+ALTER PUBLICATION supabase_realtime ADD TABLE driver_locations;
+
+-- جدول سجل المسارات (تتبع التاريخي)
+CREATE TABLE IF NOT EXISTS location_history (
+  id           TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
+  driver_phone TEXT NOT NULL,
+  lat          DOUBLE PRECISION NOT NULL,
+  lng          DOUBLE PRECISION NOT NULL,
+  speed        DOUBLE PRECISION DEFAULT 0,
+  heading      DOUBLE PRECISION DEFAULT 0,
+  ride_id      TEXT,
+  order_id     TEXT,
+  recorded_at  TIMESTAMP WITH TIME ZONE DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS idx_loc_history_driver  ON location_history(driver_phone);
+CREATE INDEX IF NOT EXISTS idx_loc_history_ride    ON location_history(ride_id);
+CREATE INDEX IF NOT EXISTS idx_loc_history_order   ON location_history(order_id);
+CREATE INDEX IF NOT EXISTS idx_loc_history_time    ON location_history(recorded_at DESC);
+
+ALTER TABLE location_history ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "allow_anon_all_loc_history" ON location_history;
+CREATE POLICY "allow_anon_all_loc_history" ON location_history
+  FOR ALL TO anon, authenticated USING (true) WITH CHECK (true);
+
+
+-- ────────────────────────────────────────────────────────────
+-- 6. SERVICE_REQUESTS — طلبات الخدمة الموحّدة
+-- ────────────────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS service_requests (
+  id              TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
+  type            TEXT NOT NULL,  -- ride, delivery, airport, rental
+  status          TEXT DEFAULT 'pending',
+    -- pending → accepted → in_progress → completed | cancelled
+
+  -- العميل
+  customer_phone  TEXT NOT NULL,
+  customer_name   TEXT,
+
+  -- السائق (بعد القبول)
+  driver_phone    TEXT,
+  driver_name     TEXT,
+
+  -- التاجر (للتوصيل)
+  merchant_phone  TEXT,
+  store_id        TEXT,
+
+  -- المواقع
+  from_lat        DOUBLE PRECISION,
+  from_lng        DOUBLE PRECISION,
+  from_address    TEXT,
+  to_lat          DOUBLE PRECISION,
+  to_lng          DOUBLE PRECISION,
+  to_address      TEXT,
+
+  -- التسعير
+  base_fare       DECIMAL(8,2),
+  distance_km     DECIMAL(8,2),
+  fare            DECIMAL(8,2),
+  commission_pct  DECIMAL(5,2) DEFAULT 15,
+  commission_amt  DECIMAL(8,2),
+  driver_earn     DECIMAL(8,2),
+
+  -- التوقيت
+  scheduled_at    TIMESTAMP WITH TIME ZONE,
+  accepted_at     TIMESTAMP WITH TIME ZONE,
+  started_at      TIMESTAMP WITH TIME ZONE,
+  completed_at    TIMESTAMP WITH TIME ZONE,
+  cancelled_at    TIMESTAMP WITH TIME ZONE,
+  cancel_reason   TEXT,
+
+  notes           TEXT,
+  created_at      TIMESTAMP WITH TIME ZONE DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS idx_sr_customer  ON service_requests(customer_phone);
+CREATE INDEX IF NOT EXISTS idx_sr_driver    ON service_requests(driver_phone);
+CREATE INDEX IF NOT EXISTS idx_sr_status    ON service_requests(status);
+CREATE INDEX IF NOT EXISTS idx_sr_type      ON service_requests(type);
+CREATE INDEX IF NOT EXISTS idx_sr_created   ON service_requests(created_at DESC);
+
+ALTER TABLE service_requests ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "allow_anon_all_service_req" ON service_requests;
+CREATE POLICY "allow_anon_all_service_req" ON service_requests
+  FOR ALL TO anon, authenticated USING (true) WITH CHECK (true);
+
+ALTER PUBLICATION supabase_realtime ADD TABLE service_requests;
+
+
+-- ────────────────────────────────────────────────────────────
+-- 7. NOTIFICATIONS — الإشعارات لجميع المستخدمين
+-- ────────────────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS notifications (
+  id           TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
+  to_phone     TEXT NOT NULL,
+  role         TEXT DEFAULT 'customer',  -- customer, driver, merchant, admin
+  type         TEXT NOT NULL,
+    -- new_ride, ride_accepted, ride_completed, order_status,
+    -- payment, rating, system, promo
+  title        TEXT NOT NULL,
+  body         TEXT NOT NULL,
+  icon         TEXT DEFAULT '🔔',
+  data         JSONB,              -- extra payload (ride_id, order_id, etc.)
+  is_read      BOOLEAN DEFAULT false,
+  created_at   TIMESTAMP WITH TIME ZONE DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS idx_notif_phone    ON notifications(to_phone);
+CREATE INDEX IF NOT EXISTS idx_notif_unread   ON notifications(to_phone, is_read) WHERE is_read = false;
+CREATE INDEX IF NOT EXISTS idx_notif_created  ON notifications(created_at DESC);
+
+ALTER TABLE notifications ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "allow_anon_all_notif" ON notifications;
+CREATE POLICY "allow_anon_all_notif" ON notifications
+  FOR ALL TO anon, authenticated USING (true) WITH CHECK (true);
+
+ALTER PUBLICATION supabase_realtime ADD TABLE notifications;
+
+
+-- ────────────────────────────────────────────────────────────
+-- 8. SERVICE_AREAS — مناطق الخدمة والخرائط
+-- ────────────────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS service_areas (
+  id           TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
+  name         TEXT NOT NULL,        -- دمياط الجديدة، رأس البر
+  name_en      TEXT,
+  city         TEXT DEFAULT 'دمياط',
+  lat          DOUBLE PRECISION NOT NULL,
+  lng          DOUBLE PRECISION NOT NULL,
+  radius_km    DOUBLE PRECISION DEFAULT 5,  -- نطاق الخدمة بالكيلومتر
+  fare_base    DECIMAL(8,2) DEFAULT 20,     -- أجرة البداية
+  fare_per_km  DECIMAL(8,2) DEFAULT 5,      -- سعر الكيلومتر
+  is_active    BOOLEAN DEFAULT true,
+  sort_order   INT DEFAULT 0,
+  created_at   TIMESTAMP WITH TIME ZONE DEFAULT NOW()
+);
+
+INSERT INTO service_areas (id, name, name_en, lat, lng, radius_km, fare_base, fare_per_km, sort_order) VALUES
+  ('area-01', 'دمياط الجديدة',  'New Damietta',   31.4200, 31.8100, 10, 15, 4, 1),
+  ('area-02', 'دمياط القديمة',  'Old Damietta',   31.4165, 31.8140, 8,  12, 4, 2),
+  ('area-03', 'رأس البر',       'Ras El Bar',     31.4770, 31.8320, 6,  20, 5, 3),
+  ('area-04', 'كفر سعد',        'Kafr Saad',      31.3660, 31.7350, 8,  15, 4, 4),
+  ('area-05', 'فارسكور',        'Faraskour',      31.3315, 31.7143, 10, 18, 5, 5),
+  ('area-06', 'الزرقا',         'El Zarqa',       31.3442, 31.8350, 8,  15, 4, 6),
+  ('area-07', 'ميت أبو غالب',  'Meet Abu Ghalib', 31.3900, 31.7900, 6,  12, 4, 7),
+  ('area-08', 'شربين',          'Sherbin',        31.1872, 31.5355, 8,  20, 5, 8),
+  ('area-09', 'ميت سلسيل',     'Meet Salsil',    31.2700, 31.6900, 6,  18, 5, 9),
+  ('area-10', 'المطار',         'Airport',        31.3600, 31.7200, 5,  50, 8, 10)
+ON CONFLICT (id) DO NOTHING;
+
+ALTER TABLE service_areas ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "allow_anon_select_areas" ON service_areas;
+CREATE POLICY "allow_anon_select_areas" ON service_areas
+  FOR SELECT TO anon, authenticated USING (true);
+
+
+-- ────────────────────────────────────────────────────────────
+-- 9. PROMO_CODES — أكواد الخصم
+-- ────────────────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS promo_codes (
+  id              TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
+  code            TEXT NOT NULL UNIQUE,
+  description     TEXT,
+  discount_type   TEXT DEFAULT 'percent',  -- percent, fixed
+  discount_value  DECIMAL(8,2) NOT NULL,
+  min_order       DECIMAL(8,2) DEFAULT 0,
+  max_discount    DECIMAL(8,2),            -- حد أقصى للخصم
+  usage_limit     INT DEFAULT 100,
+  used_count      INT DEFAULT 0,
+  valid_from      TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
+  valid_to        TIMESTAMP WITH TIME ZONE,
+  applies_to      TEXT DEFAULT 'all',      -- all, ride, delivery, airport
+  is_active       BOOLEAN DEFAULT true,
+  created_by      TEXT,                    -- admin phone
+  created_at      TIMESTAMP WITH TIME ZONE DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS idx_promo_code    ON promo_codes(code);
+CREATE INDEX IF NOT EXISTS idx_promo_active  ON promo_codes(is_active);
+
+ALTER TABLE promo_codes ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "allow_anon_select_promo" ON promo_codes;
+CREATE POLICY "allow_anon_select_promo" ON promo_codes
+  FOR SELECT TO anon, authenticated USING (true);
+DROP POLICY IF EXISTS "allow_auth_manage_promo" ON promo_codes;
+CREATE POLICY "allow_auth_manage_promo" ON promo_codes
+  FOR ALL TO authenticated USING (true) WITH CHECK (true);
+
+
+-- ────────────────────────────────────────────────────────────
+-- 10. PROMO_USAGE — استخدام الأكواد
+-- ────────────────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS promo_usage (
+  id           TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
+  code         TEXT NOT NULL REFERENCES promo_codes(code),
+  phone        TEXT NOT NULL,
+  order_id     TEXT,
+  ride_id      TEXT,
+  discount_amt DECIMAL(8,2),
+  used_at      TIMESTAMP WITH TIME ZONE DEFAULT NOW()
