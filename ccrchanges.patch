+-- دالة: تحديث إحصائيات السائق عند اكتمال رحلة
+CREATE OR REPLACE FUNCTION update_driver_stats_on_complete(p_phone TEXT)
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER AS $$
+BEGIN
+  UPDATE drivers SET
+    total_trips    = (SELECT COUNT(*) FROM rides WHERE driver_phone = p_phone AND status = 'completed') +
+                     (SELECT COUNT(*) FROM orders WHERE driver_phone = p_phone AND status = 'delivered'),
+    total_earnings = (SELECT COALESCE(SUM(net_earn),0) FROM driver_earnings WHERE driver_phone = p_phone),
+    rating_avg     = (SELECT COALESCE(AVG(rating)::DECIMAL(3,2), 0) FROM ratings WHERE driver_phone = p_phone),
+    rating_count   = (SELECT COUNT(*) FROM ratings WHERE driver_phone = p_phone),
+    updated_at     = NOW()
+  WHERE phone = p_phone;
+END; $$;
+
+-- دالة: البحث عن السائقين المتاحين قريباً (للخريطة)
+CREATE OR REPLACE FUNCTION find_nearby_drivers(
+  p_lat  DOUBLE PRECISION,
+  p_lng  DOUBLE PRECISION,
+  p_km   DOUBLE PRECISION DEFAULT 5
+)
+RETURNS TABLE (
+  driver_phone TEXT,
+  driver_name  TEXT,
+  lat          DOUBLE PRECISION,
+  lng          DOUBLE PRECISION,
+  heading      DOUBLE PRECISION,
+  distance_km  DOUBLE PRECISION
+) LANGUAGE plpgsql SECURITY DEFINER AS $$
+BEGIN
+  RETURN QUERY
+  SELECT
+    dl.driver_phone,
+    dl.driver_name,
+    dl.lat,
+    dl.lng,
+    dl.heading,
+    ROUND(
+      (6371 * acos(
+        cos(radians(p_lat)) * cos(radians(dl.lat)) *
+        cos(radians(dl.lng) - radians(p_lng)) +
+        sin(radians(p_lat)) * sin(radians(dl.lat))
+      ))::numeric, 2
+    )::DOUBLE PRECISION AS distance_km
+  FROM driver_locations dl
+  WHERE dl.is_online = true
+    AND dl.ride_id IS NULL
+    AND dl.updated_at > NOW() - INTERVAL '2 minutes'
+    AND (
+      6371 * acos(
+        cos(radians(p_lat)) * cos(radians(dl.lat)) *
+        cos(radians(dl.lng) - radians(p_lng)) +
+        sin(radians(p_lat)) * sin(radians(dl.lat))
+      )
+    ) <= p_km
+  ORDER BY distance_km ASC
+  LIMIT 20;
+END; $$;
