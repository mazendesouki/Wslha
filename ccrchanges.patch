+-- دالة: إحصائيات الأدمن الكاملة
+CREATE OR REPLACE FUNCTION get_admin_stats()
+RETURNS JSON LANGUAGE plpgsql SECURITY DEFINER AS $$
+DECLARE result JSON;
+BEGIN
+  SELECT json_build_object(
+    'total_users',       (SELECT COUNT(*) FROM accounts WHERE role = 'customer'),
+    'total_drivers',     (SELECT COUNT(*) FROM accounts WHERE role = 'driver' AND status = 'approved'),
+    'total_merchants',   (SELECT COUNT(*) FROM accounts WHERE role = 'merchant' AND status = 'approved'),
+    'pending_drivers',   (SELECT COUNT(*) FROM driver_applications WHERE status = 'pending'),
+    'pending_merchants', (SELECT COUNT(*) FROM merchant_applications WHERE status = 'pending'),
+    'today_rides',       (SELECT COUNT(*) FROM rides WHERE created_at::date = CURRENT_DATE),
+    'today_orders',      (SELECT COUNT(*) FROM orders WHERE created_at::date = CURRENT_DATE),
+    'today_revenue',     (SELECT COALESCE(SUM(fare),0) FROM rides WHERE status='completed' AND completed_at::date = CURRENT_DATE),
+    'total_wallets',     (SELECT COALESCE(SUM(balance),0) FROM wallets),
+    'online_drivers',    (SELECT COUNT(*) FROM driver_locations WHERE is_online = true)
+  ) INTO result;
+  RETURN result;
+END; $$;
+
+-- دالة: إحصائيات السائق
+CREATE OR REPLACE FUNCTION get_driver_stats(p_phone TEXT)
+RETURNS JSON LANGUAGE plpgsql SECURITY DEFINER AS $$
+DECLARE result JSON;
+BEGIN
+  SELECT json_build_object(
+    'total_trips',    (SELECT COUNT(*) FROM rides WHERE driver_phone = p_phone AND status = 'completed'),
+    'total_orders',   (SELECT COUNT(*) FROM orders WHERE driver_phone = p_phone AND status = 'delivered'),
+    'total_earnings', (SELECT COALESCE(SUM(net_earn),0) FROM driver_earnings WHERE driver_phone = p_phone),
+    'wallet_balance', (SELECT COALESCE(balance,0) FROM wallets WHERE phone = p_phone),
+    'total_points',   (SELECT COALESCE(total_points,0) FROM points WHERE phone = p_phone),
+    'rating_avg',     (SELECT COALESCE(AVG(rating),0) FROM ratings WHERE driver_phone = p_phone),
+    'rating_count',   (SELECT COUNT(*) FROM ratings WHERE driver_phone = p_phone)
+  ) INTO result;
+  RETURN result;
+END; $$;
+
+-- دالة: إحصائيات التاجر
+CREATE OR REPLACE FUNCTION get_merchant_stats(p_phone TEXT)
+RETURNS JSON LANGUAGE plpgsql SECURITY DEFINER AS $$
+DECLARE result JSON;
+BEGIN
+  SELECT json_build_object(
+    'total_orders',   (SELECT COUNT(*) FROM orders WHERE store_phone = p_phone),
+    'today_orders',   (SELECT COUNT(*) FROM orders WHERE store_phone = p_phone AND created_at::date = CURRENT_DATE),
+    'total_revenue',  (SELECT COALESCE(SUM(total),0) FROM orders WHERE store_phone = p_phone AND status = 'delivered'),
+    'today_revenue',  (SELECT COALESCE(SUM(total),0) FROM orders WHERE store_phone = p_phone AND status = 'delivered' AND delivered_at::date = CURRENT_DATE),
+    'wallet_balance', (SELECT COALESCE(balance,0) FROM wallets WHERE phone = p_phone),
+    'pending_orders', (SELECT COUNT(*) FROM orders WHERE store_phone = p_phone AND status IN ('pending','preparing'))
+  ) INTO result;
+  RETURN result;
+END; $$;
