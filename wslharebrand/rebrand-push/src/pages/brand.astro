---
import Layout from '../components/layout.astro';

const colors = {
  brand: [
    { name: 'Primary',       var: '--color-primary',       hex: '#0E4B49', text: '#fff' },
    { name: 'Primary Dark',  var: '--color-primary-dark',  hex: '#082F2E', text: '#fff' },
    { name: 'Primary Light', var: '--color-primary-light', hex: '#E3EDEC', text: '#16262A' },
    { name: 'Accent',        var: '--color-accent',        hex: '#B8863B', text: '#fff' },
    { name: 'Accent Dark',   var: '--color-accent-dark',   hex: '#96692A', text: '#fff' },
  ],
  semantic: [
    { name: 'Success', hex: '#22C55E', text: '#fff' },
    { name: 'Warning', hex: '#D97706', text: '#fff' },
    { name: 'Danger',  hex: '#DC2626', text: '#fff' },
    { name: 'Info',    hex: '#2563EB', text: '#fff' },
  ],
  neutral: [
    { name: 'Text',       hex: '#16262A', text: '#fff' },
    { name: 'Text Muted', hex: '#5B6B6A', text: '#fff' },
    { name: 'Text Faint', hex: '#8A9998', text: '#fff' },
    { name: 'Border',     hex: '#E2E8F0', text: '#16262A' },
    { name: 'BG Soft',    hex: '#F8FAFC', text: '#16262A' },
    { name: 'Dark BG',    hex: '#0B1514', text: '#fff' },
  ],
};

const typeScale = [
  { name: '5XL — Display', size: '3.25rem', weight: 900, sample: 'وصّلها' },
  { name: '4XL — H1',      size: '2.25rem', weight: 900, sample: 'العنوان الرئيسي' },
  { name: '3XL — H2',      size: '1.875rem', weight: 800, sample: 'عنوان فرعي كبير' },
  { name: '2XL — H3',      size: '1.5rem',  weight: 800, sample: 'عنوان قسم' },
  { name: 'XL — Lead',     size: '1.25rem', weight: 700, sample: 'نص بارز تمهيدي' },
  { name: 'Base — Body',   size: '1rem',    weight: 400, sample: 'نص الفقرة الأساسي لخدمة وصّلها للتوصيل السريع.' },
  { name: 'SM — Caption',  size: '0.875rem', weight: 400, sample: 'نص توضيحي صغير' },
];

const radii = [
  { name: 'sm', val: '6px' }, { name: 'base', val: '10px' },
  { name: 'lg', val: '14px' }, { name: 'xl', val: '18px' },
  { name: '2xl', val: '24px' }, { name: 'full', val: '999px' },
];
const shadows = [
  { name: 'sm', val: '0 1px 4px rgba(0,0,0,.06)' },
  { name: 'base', val: '0 4px 16px rgba(0,0,0,.08)' },
  { name: 'md', val: '0 8px 32px rgba(0,0,0,.10)' },
  { name: 'lg', val: '0 16px 48px rgba(0,0,0,.12)' },
];
---

<style>
  .brand { background: #F5F7FF; min-height: calc(100vh - var(--nav-height)); padding-bottom: var(--sp-20); }

  /* Hero */
  .brand-hero {
    background: linear-gradient(135deg, #0F172A 0%, #082F2E 50%, #6D5DF6 100%);
    color: #fff; padding: var(--sp-16) var(--sp-6) var(--sp-12); text-align: center; position: relative; overflow: hidden;
  }
  .brand-hero::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(600px 300px at 80% 0%, rgba(245,184,0,.18), transparent 60%);
  }
  .brand-hero__inner { position: relative; max-width: 720px; margin: 0 auto; }
  .brand-hero__kicker {
    display: inline-block; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.3);
    padding: 6px 16px; border-radius: 999px; font-size: .8rem; font-weight: 800; margin-bottom: var(--sp-5);
  }
  .brand-hero__title { font-size: clamp(2rem, 6vw, 3.25rem); font-weight: 900; margin-bottom: var(--sp-3); }
  .brand-hero__sub { font-size: var(--text-base); opacity: .85; line-height: 1.7; max-width: 520px; margin: 0 auto; }

  .brand-wrap { max-width: 980px; margin: 0 auto; padding: 0 var(--sp-5); }

  /* Section */
  .b-sec { margin-top: var(--sp-12); }
  .b-sec__head { display: flex; align-items: baseline; gap: var(--sp-3); margin-bottom: var(--sp-5); }
  .b-sec__num {
    font-size: .8rem; font-weight: 900; color: #fff; background: var(--color-primary);
    width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .b-sec__title { font-size: var(--text-2xl); font-weight: 900; color: var(--color-text); }
  .b-sec__desc { font-size: var(--text-sm); color: var(--color-text-muted); margin-top: 2px; }

  .b-card {
    background: #fff; border: 1px solid var(--color-border); border-radius: 20px;
    padding: var(--sp-6); box-shadow: 0 4px 20px rgba(40,60,140,.06);
  }

  /* Logo showcase */
  .logo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  @media(max-width:640px){ .logo-grid { grid-template-columns: 1fr; } }
  .logo-tile {
    border-radius: 16px; padding: var(--sp-8); display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: var(--sp-3); min-height: 160px; border: 1px solid var(--color-border);
  }
  .logo-tile--light { background: #fff; }
  .logo-tile--dark  { background: var(--color-dark-bg); }
  .logo-wordmark { font-size: 2.2rem; font-weight: 900; letter-spacing: -1px; display: flex; align-items: center; gap: 10px; }
  .logo-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 5px rgba(245,184,0,.25); }
  .logo-tile--light .logo-wordmark { color: var(--color-primary); }
  .logo-tile--dark  .logo-wordmark { color: #fff; }
  .logo-tile__cap { font-size: .75rem; font-weight: 700; color: var(--color-text-faint); }

  /* Color swatches */
  .sw-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--sp-3); }
  .swatch { border-radius: 14px; overflow: hidden; border: 1px solid var(--color-border); }
  .swatch__top { height: 90px; display: flex; align-items: flex-end; padding: 10px; font-weight: 800; font-size: .8rem; }
  .swatch__meta { padding: 9px 12px; background: #fff; }
  .swatch__name { font-size: .82rem; font-weight: 800; color: var(--color-text); }
  .swatch__hex  { font-size: .72rem; color: var(--color-text-muted); font-family: monospace; direction: ltr; text-align: left; cursor: pointer; }
  .swatch__hex:hover { color: var(--color-primary); }

  .sub-label { font-size: .8rem; font-weight: 800; color: var(--color-text-muted); margin: var(--sp-5) 0 var(--sp-3); text-transform: uppercase; letter-spacing: .04em; }

  /* Typography */
  .type-row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-4); padding: var(--sp-4) 0; border-bottom: 1px dashed var(--color-border); }
  .type-row:last-child { border-bottom: none; }
  .type-sample { color: var(--color-text); line-height: 1.3; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .type-meta { font-size: .7rem; color: var(--color-text-faint); font-family: monospace; white-space: nowrap; direction: ltr; }

  /* Components demo */
  .demo-row { display: flex; flex-wrap: wrap; gap: var(--sp-3); align-items: center; }
  .d-btn { padding: 13px 26px; border-radius: 14px; font-weight: 900; font-size: .95rem; border: none; cursor: pointer; transition: transform .15s; }
  .d-btn:hover { transform: translateY(-2px); }
  .d-btn--primary { background: var(--color-primary); color: #fff; box-shadow: 0 8px 22px rgba(59,110,248,.3); }
  .d-btn--accent  { background: linear-gradient(135deg,#F5B800,#FF9D00); color: #1A1A2E; box-shadow: 0 8px 22px rgba(245,184,0,.3); }
  .d-btn--outline { background: #fff; color: var(--color-primary); border: 2px solid var(--color-primary); }
  .d-btn--dark    { background: var(--color-dark-bg); color: #fff; }
  .d-badge { padding: 4px 14px; border-radius: 999px; font-size: .78rem; font-weight: 800; }
  .d-badge--green  { background: #DCFCE7; color: #16A34A; }
  .d-badge--blue   { background: #DBEAFE; color: #2563EB; }
  .d-badge--gold   { background: #FEF3C7; color: #B45309; }
  .d-badge--red    { background: #FEE2E2; color: #DC2626; }

  /* Tokens */
  .tok-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px,1fr)); gap: var(--sp-4); }
  .tok { text-align: center; }
  .tok__box { background: var(--color-primary); margin: 0 auto var(--sp-2); }
  .radius-box { width: 70px; height: 70px; }
  .shadow-box { width: 80px; height: 60px; background: #fff !important; border-radius: 12px; }
  .tok__name { font-size: .8rem; font-weight: 800; color: var(--color-text); }
  .tok__val  { font-size: .68rem; color: var(--color-text-faint); font-family: monospace; direction: ltr; }
</style>

<Layout title="الهوية البصرية | وصّلها" description="دليل الهوية البصرية والعلامة التجارية لوصّلها" page="brand">
  <div class="brand">
    <div class="brand-hero">
      <div class="brand-hero__inner">
        <span class="brand-hero__kicker">🎨 دليل الهوية البصرية</span>
        <h1 class="brand-hero__title">علامة وصّلها التجارية</h1>
        <p class="brand-hero__sub">نظام تصميم متكامل — ألوان، خطوط، ومكوّنات تضمن تجربة متّسقة عبر كل صفحات التطبيق.</p>
      </div>
    </div>

    <div class="brand-wrap">

      <!-- 1. Logo -->
      <section class="b-sec">
        <div class="b-sec__head">
          <span class="b-sec__num">1</span>
          <div><div class="b-sec__title">الشعار</div><div class="b-sec__desc">الكلمة المرسومة + النقطة الذهبية المميّزة</div></div>
        </div>
        <div class="b-card">
          <div class="logo-grid">
            <div class="logo-tile logo-tile--light">
              <div class="logo-wordmark"><span class="logo-dot"></span> وصّلها</div>
              <span class="logo-tile__cap">على خلفية فاتحة</span>
            </div>
            <div class="logo-tile logo-tile--dark">
              <div class="logo-wordmark"><span class="logo-dot"></span> وصّلها</div>
              <span class="logo-tile__cap">على خلفية داكنة</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Colors -->
      <section class="b-sec">
        <div class="b-sec__head">
          <span class="b-sec__num">2</span>
          <div><div class="b-sec__title">نظام الألوان</div><div class="b-sec__desc">اضغط على أي كود HEX لنسخه</div></div>
        </div>
        <div class="b-card">
          <div class="sub-label">ألوان العلامة</div>
          <div class="sw-grid">
            {colors.brand.map(c => (
              <div class="swatch">
                <div class="swatch__top" style={`background:${c.hex};color:${c.text}`}>{c.name}</div>
                <div class="swatch__meta">
                  <div class="swatch__name">{c.name}</div>
                  <div class="swatch__hex" data-hex={c.hex}>{c.hex}</div>
                </div>
              </div>
            ))}
          </div>

          <div class="sub-label">ألوان الدلالة</div>
          <div class="sw-grid">
            {colors.semantic.map(c => (
              <div class="swatch">
                <div class="swatch__top" style={`background:${c.hex};color:${c.text}`}>{c.name}</div>
                <div class="swatch__meta">
                  <div class="swatch__name">{c.name}</div>
                  <div class="swatch__hex" data-hex={c.hex}>{c.hex}</div>
                </div>
              </div>
            ))}
          </div>

          <div class="sub-label">الحياديات</div>
          <div class="sw-grid">
            {colors.neutral.map(c => (
              <div class="swatch">
                <div class="swatch__top" style={`background:${c.hex};color:${c.text}`}>{c.name}</div>
                <div class="swatch__meta">
                  <div class="swatch__name">{c.name}</div>
                  <div class="swatch__hex" data-hex={c.hex}>{c.hex}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 3. Typography -->
      <section class="b-sec">
        <div class="b-sec__head">
          <span class="b-sec__num">3</span>
          <div><div class="b-sec__title">الخطوط</div><div class="b-sec__desc">خط Cairo — العائلة الرسمية للعلامة</div></div>
        </div>
        <div class="b-card">
          {typeScale.map(t => (
            <div class="type-row">
              <div class="type-sample" style={`font-size:${t.size};font-weight:${t.weight}`}>{t.sample}</div>
              <div class="type-meta">{t.name} · {t.weight}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. Components -->
      <section class="b-sec">
        <div class="b-sec__head">
          <span class="b-sec__num">4</span>
          <div><div class="b-sec__title">المكوّنات</div><div class="b-sec__desc">أزرار وشارات بالأسلوب الموحّد</div></div>
        </div>
        <div class="b-card">
          <div class="sub-label">الأزرار</div>
          <div class="demo-row">
            <button class="d-btn d-btn--primary">زر أساسي</button>
            <button class="d-btn d-btn--accent">زر ذهبي</button>
            <button class="d-btn d-btn--outline">زر محدّد</button>
            <button class="d-btn d-btn--dark">زر داكن</button>
          </div>
          <div class="sub-label">الشارات</div>
          <div class="demo-row">
            <span class="d-badge d-badge--green">معتمد</span>
            <span class="d-badge d-badge--blue">قيد المراجعة</span>
            <span class="d-badge d-badge--gold">معلّق</span>
            <span class="d-badge d-badge--red">مرفوض</span>
          </div>
        </div>
      </section>

      <!-- 5. Radii & Shadows -->
      <section class="b-sec">
        <div class="b-sec__head">
          <span class="b-sec__num">5</span>
          <div><div class="b-sec__title">الحواف والظلال</div><div class="b-sec__desc">قيم نصف القطر والظلال المعتمدة</div></div>
        </div>
        <div class="b-card">
          <div class="sub-label">نصف القطر (Radius)</div>
          <div class="tok-grid">
            {radii.map(r => (
              <div class="tok">
                <div class="tok__box radius-box" style={`border-radius:${r.val}`}></div>
                <div class="tok__name">{r.name}</div>
                <div class="tok__val">{r.val}</div>
              </div>
            ))}
          </div>
          <div class="sub-label">الظلال (Shadow)</div>
          <div class="tok-grid">
            {shadows.map(s => (
              <div class="tok">
                <div class="tok__box shadow-box" style={`box-shadow:${s.val}`}></div>
                <div class="tok__name">{s.name}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<script is:inline>
  document.querySelectorAll('.swatch__hex').forEach(el => {
    el.addEventListener('click', () => {
      const hex = el.getAttribute('data-hex');
      if (!hex) return;
      navigator.clipboard?.writeText(hex);
      const prev = el.textContent;
      el.textContent = '✓ تم النسخ';
      setTimeout(() => { el.textContent = prev; }, 1100);
    });
  });
</script>
