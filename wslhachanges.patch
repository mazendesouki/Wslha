diff --git a/supabase/schema.sql b/supabase/schema.sql
new file mode 100644
index 0000000..3d235ef
--- /dev/null
+++ b/supabase/schema.sql
@@ -0,0 +1,257 @@
+-- ============================================================
+--  وصّلها — Supabase Database Schema
+--  Project: wslha-941c8
+--  Apply via: Supabase Dashboard → SQL Editor → Run
+-- ============================================================
+
+-- ── 1. ACCOUNTS ─────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS public.accounts (
+  id           uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  phone        text NOT NULL UNIQUE,
+  name         text NOT NULL,
+  username     text UNIQUE,
+  email        text UNIQUE,
+  password     text,
+  role         text NOT NULL DEFAULT 'customer'
+                   CHECK (role IN ('customer','driver','merchant','admin')),
+  status       text NOT NULL DEFAULT 'active'
+                   CHECK (status IN ('active','approved','pending','suspended')),
+  city         text,
+  created_at   timestamptz DEFAULT now()
+);
+
+-- ── 2. OTPs ─────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS public.otps (
+  id          uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  phone       text NOT NULL,
+  code        text NOT NULL,
+  created_at  timestamptz DEFAULT now(),
+  expires_at  timestamptz DEFAULT (now() + interval '5 minutes')
+);
+
+-- Function used by login to verify OTP
+CREATE OR REPLACE FUNCTION public.verify_otp(p_phone text, p_code text)
+RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER AS $$
+DECLARE
+  rec record;
+BEGIN
+  SELECT * INTO rec FROM public.otps
+  WHERE phone = p_phone AND code = p_code AND expires_at > now()
+  ORDER BY created_at DESC LIMIT 1;
+  IF FOUND THEN
+    DELETE FROM public.otps WHERE phone = p_phone;
+    RETURN true;
+  END IF;
+  RETURN false;
+END;
+$$;
+
+-- ── 3. RIDES ────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS public.rides (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  customer_phone  text NOT NULL,
+  customer_name   text NOT NULL,
+  customer_lat    double precision,
+  customer_lng    double precision,
+  from_area       text NOT NULL,
+  from_lat        double precision NOT NULL,
+  from_lng        double precision NOT NULL,
+  to_area         text NOT NULL,
+  to_lat          double precision NOT NULL,
+  to_lng          double precision NOT NULL,
+  distance_km     numeric NOT NULL,
+  fare            numeric NOT NULL,
+  eta_minutes     integer NOT NULL,
+  passengers      integer DEFAULT 1,
+  payment         text DEFAULT 'cash' CHECK (payment IN ('cash','wallet','card')),
+  notes           text,
+  ride_type       text DEFAULT 'local' CHECK (ride_type IN ('local','airport','intl')),
+  status          text DEFAULT 'pending'
+                  CHECK (status IN ('pending','accepted','arrived','in_progress','completed','cancelled')),
+  driver_phone    text,
+  driver_name     text,
+  driver_lat      double precision,
+  driver_lng      double precision,
+  accepted_at     timestamptz,
+  arrived_at      timestamptz,
+  started_at      timestamptz,
+  completed_at    timestamptz,
+  cancelled_at    timestamptz,
+  rating          integer CHECK (rating BETWEEN 1 AND 5),
+  created_at      timestamptz DEFAULT now()
+);
+
+-- Index for fast pending-ride queries (driver dashboard)
+CREATE INDEX IF NOT EXISTS idx_rides_status_driver
+  ON public.rides (status, driver_phone, created_at);
+
+-- ── 4. DRIVER LOCATIONS ─────────────────────────────────────
+-- One row per driver, updated every 3s via UPSERT
+CREATE TABLE IF NOT EXISTS public.driver_locations (
+  driver_phone  text PRIMARY KEY,
+  driver_name   text,
+  lat           double precision NOT NULL,
+  lng           double precision NOT NULL,
+  is_online     boolean DEFAULT true,
+  ride_id       uuid REFERENCES public.rides(id) ON DELETE SET NULL,
+  updated_at    timestamptz DEFAULT now()
+);
+
+-- ── 5. ORDERS (store delivery) ───────────────────────────────
+CREATE TABLE IF NOT EXISTS public.orders (
+  id                   uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  code                 text NOT NULL,
+  store_id             text NOT NULL,
+  store_name           text NOT NULL,
+  store_emoji          text,
+  store_lat            double precision,
+  store_lng            double precision,
+  customer_name        text NOT NULL,
+  customer_phone       text NOT NULL,
+  customer_lat         double precision,
+  customer_lng         double precision,
+  area                 text,
+  address              text,
+  items                jsonb NOT NULL DEFAULT '[]',
+  items_summary        text,
+  subtotal             numeric NOT NULL DEFAULT 0,
+  delivery_fee         numeric NOT NULL DEFAULT 0,
+  total                numeric NOT NULL DEFAULT 0,
+  payment              text DEFAULT 'cash',
+  notes                text,
+  delivery_instructions text,
+  scheduled_at         timestamptz,
+  status               text DEFAULT 'pending'
+                       CHECK (status IN ('pending','accepted','preparing','ready','picked_up','delivered','cancelled')),
+  driver_phone         text,
+  driver_name          text,
+  merchant_phone       text,
+  accepted_at          timestamptz,
+  delivered_at         timestamptz,
+  created_at           timestamptz DEFAULT now()
+);
+
+CREATE INDEX IF NOT EXISTS idx_orders_customer
+  ON public.orders (customer_phone, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_orders_status_driver
+  ON public.orders (status, driver_phone, created_at);
+
+-- ── 6. STORES ────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS public.stores (
+  id            text PRIMARY KEY,
+  name          text NOT NULL,
+  category      text,
+  category_id   text,
+  emoji         text,
+  area          text,
+  address       text,
+  phone         text,
+  lat           double precision,
+  lng           double precision,
+  rating        numeric DEFAULT 4.5,
+  reviews       integer DEFAULT 0,
+  delivery_time text,
+  delivery_fee  numeric DEFAULT 20,
+  min_order     numeric DEFAULT 50,
+  tagline       text,
+  is_open       boolean DEFAULT true,
+  merchant_phone text,
+  created_at    timestamptz DEFAULT now()
+);
+
+-- ── 7. RATINGS ───────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS public.ratings (
+  id             uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  driver_phone   text,
+  customer_phone text,
+  rating         integer NOT NULL CHECK (rating BETWEEN 1 AND 5),
+  comment        text,
+  service_type   text CHECK (service_type IN ('ride','delivery')),
+  ride_id        uuid REFERENCES public.rides(id) ON DELETE SET NULL,
+  order_id       uuid REFERENCES public.orders(id) ON DELETE SET NULL,
+  created_at     timestamptz DEFAULT now()
+);
+
+-- ── 8. WALLETS ───────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS public.wallets (
+  phone       text PRIMARY KEY,
+  balance     numeric DEFAULT 0,
+  updated_at  timestamptz DEFAULT now()
+);
+
+CREATE TABLE IF NOT EXISTS public.wallet_transactions (
+  id          uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  phone       text NOT NULL,
+  amount      numeric NOT NULL,
+  type        text CHECK (type IN ('credit','debit','refund')),
+  note        text,
+  ref_id      uuid,
+  created_at  timestamptz DEFAULT now()
+);
+
+-- ── 9. DRIVER APPLICATIONS ──────────────────────────────────
+CREATE TABLE IF NOT EXISTS public.driver_applications (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  name            text NOT NULL,
+  phone           text NOT NULL UNIQUE,
+  city            text,
+  vehicle_type    text,
+  vehicle_plate   text,
+  national_id     text,
+  status          text DEFAULT 'pending'
+                  CHECK (status IN ('pending','approved','rejected')),
+  notes           text,
+  created_at      timestamptz DEFAULT now()
+);
+
+-- ── 10. ENABLE REALTIME ──────────────────────────────────────
+-- Run in Supabase Dashboard → Database → Replication → enable for:
+-- rides, driver_locations, orders
+
+-- ── ROW LEVEL SECURITY ───────────────────────────────────────
+-- Enable RLS on all tables
+ALTER TABLE public.accounts          ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.rides             ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.driver_locations  ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.orders            ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.stores            ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.ratings           ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.wallets           ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.wallet_transactions ENABLE ROW LEVEL SECURITY;
+
+-- ACCOUNTS: anyone can read/create (for registration & login lookup)
+CREATE POLICY "accounts_select" ON public.accounts FOR SELECT USING (true);
+CREATE POLICY "accounts_insert" ON public.accounts FOR INSERT WITH CHECK (true);
+CREATE POLICY "accounts_update" ON public.accounts FOR UPDATE USING (true);
+
+-- OTPs: allow insert/delete from anon (login flow)
+ALTER TABLE public.otps ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "otps_all" ON public.otps FOR ALL USING (true) WITH CHECK (true);
+
+-- RIDES: public read/create; anyone can update (driver accepts)
+CREATE POLICY "rides_select" ON public.rides FOR SELECT USING (true);
+CREATE POLICY "rides_insert" ON public.rides FOR INSERT WITH CHECK (true);
+CREATE POLICY "rides_update" ON public.rides FOR UPDATE USING (true);
+CREATE POLICY "rides_delete" ON public.rides FOR DELETE USING (true);
+
+-- DRIVER_LOCATIONS: full public access (real-time GPS tracking)
+CREATE POLICY "driver_locations_all" ON public.driver_locations
+  FOR ALL USING (true) WITH CHECK (true);
+
+-- ORDERS: public read/create/update
+CREATE POLICY "orders_select" ON public.orders FOR SELECT USING (true);
+CREATE POLICY "orders_insert" ON public.orders FOR INSERT WITH CHECK (true);
+CREATE POLICY "orders_update" ON public.orders FOR UPDATE USING (true);
+
+-- STORES: public read-only
+CREATE POLICY "stores_select" ON public.stores FOR SELECT USING (true);
+
+-- RATINGS: public create/read
+CREATE POLICY "ratings_select" ON public.ratings FOR SELECT USING (true);
+CREATE POLICY "ratings_insert" ON public.ratings FOR INSERT WITH CHECK (true);
+
+-- WALLETS: public read/write (for recharge flow)
+CREATE POLICY "wallets_all" ON public.wallets
+  FOR ALL USING (true) WITH CHECK (true);
+CREATE POLICY "wallet_tx_all" ON public.wallet_transactions
+  FOR ALL USING (true) WITH CHECK (true);
-- 
2.43.0


From c6eca3f1443b5a893bf9b85466cb6ae13063a6b8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 20 Jun 2026 01:45:39 +0000
Subject: [PATCH 2/2] fix(track): use per-user orders key to auto-fill last
 order code

track.astro was reading from the generic 'wslha_orders' key instead
of the per-user 'wslha_orders_<phone>' key, causing the wrong order
to appear when multiple accounts share the same device.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/pages/track.astro | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/pages/track.astro b/src/pages/track.astro
index f7cff7a..61b4f8f 100644
--- a/src/pages/track.astro
+++ b/src/pages/track.astro
@@ -1016,7 +1016,9 @@ import PageHero from '../components/PageHero.astro';
     track(trackParam);
   } else {
     try {
-      const orders = JSON.parse(localStorage.getItem('wslha_orders') || '[]');
+      const _tu = JSON.parse(localStorage.getItem('wslha_user') || '{}');
+      const _tk = _tu.phone ? 'wslha_orders_' + _tu.phone : 'wslha_orders';
+      const orders = JSON.parse(localStorage.getItem(_tk) || '[]');
       const last = orders.find((o) => (o.kind === 'store' && o.code) || (o.kind === 'airport' && o.id));
       if (last) {
         const ref = last.code || last.id;
-- 
