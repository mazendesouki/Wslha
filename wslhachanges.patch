+      ['l-name','i-name'].forEach(id => { const el = document.getElementById(id); if (el) el.value = _n; });
+      ['l-phone','i-phone'].forEach(id => { const el = document.getElementById(id); if (el) el.value = _p; });
+    } catch { ['l-name','l-phone','i-name','i-phone'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; }); }
     fromPlace = null; toPlace = null; intlOriginPlace = null;
     document.getElementById('from-area').value = '';
     document.getElementById('to-area').value = '';
@@ -2445,4 +2451,15 @@ import { POPULAR_PLACES, PLACES, PLACE_CATEGORIES, CATEGORY_COLORS } from '../da
     `<p style="font-size:var(--text-xs);color:var(--color-text-faint);margin-bottom:var(--sp-3);">أسعار 2026 — عداد ${BASE_FARE} ج.م + ${RATE_PER_KM} ج.م/كم — الحد الأدنى ${MIN_FARE} ج.م</p>`
   );
   renderFareGuide(false);
+
