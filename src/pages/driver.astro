---
import Layout from '../components/layout.astro';
---
<Layout title="انضم كسائق — وصّلها" currentPage="driver">

<style>
/* ── Base ── */
.driver-page { background: var(--color-bg-soft); min-height: calc(100vh - var(--nav-height)); }

/* ── Hero ── */
.driver-hero {
  background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 45%, #3B6EF8 75%, #6D5DF6 100%);
  color: #fff;
  padding: var(--sp-12) var(--sp-6) var(--sp-16);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.driver-hero::before {
  content: '';
  position: absolute; inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M0 0h80v80H0z'/%3E%3Ccircle cx='40' cy='40' r='20'/%3E%3C/g%3E%3C/svg%3E");
  pointer-events: none;
}
.driver-hero__inner { position: relative; max-width: 680px; margin: 0 auto; }
.driver-hero__badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.25);
  border-radius: var(--radius-full); padding: 6px 16px;
  font-size: var(--text-xs); font-weight: var(--weight-bold); color: rgba(255,255,255,.9);
  margin-bottom: var(--sp-5);
}
.driver-hero__title { font-size: clamp(1.8rem, 5vw, 2.8rem); font-weight: var(--weight-black); line-height: 1.2; margin-bottom: var(--sp-4); }
.driver-hero__sub   { font-size: var(--text-base); color: rgba(255,255,255,.75); line-height: 1.7; max-width: 480px; margin: 0 auto var(--sp-8); }
.benefits-row {
  display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; margin-bottom: var(--sp-6);
}
.benefit-chip {
  display: flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
  border-radius: var(--radius-lg); padding: var(--sp-3) var(--sp-4);
  font-size: var(--text-sm); font-weight: var(--weight-bold); color: #fff;
}

/* ── Progress ── */
.progress-wrap {
  max-width: 760px; margin: -28px auto 0; padding: 0 var(--sp-6);
  position: relative; z-index: 10;
}
.progress-card {
  background: rgba(255,255,255,.9); backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,.9);
  border-radius: 22px; padding: var(--sp-5) var(--sp-6);
  box-shadow: 0 20px 50px rgba(40,60,140,.16);
}
.progress-steps {
  display: flex; align-items: center; gap: 0;
}
.step-item {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  flex: 1; position: relative;
}
.step-item:not(:last-child)::after {
  content: '';
  position: absolute; top: 18px; right: -50%;
  width: 100%; height: 2px;
  background: var(--color-border);
  z-index: 0;
  transition: background .3s;
}
.step-item.done:not(:last-child)::after { background: #16A34A; }
.step-item.active:not(:last-child)::after { background: var(--color-primary); }
.step-circle {
  width: 38px; height: 38px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--text-sm); font-weight: var(--weight-black);
  border: 2.5px solid var(--color-border);
  background: var(--color-bg-soft); color: var(--color-text-muted);
  position: relative; z-index: 1;
  transition: all .35s cubic-bezier(.4,0,.2,1);
}
.step-item.active .step-circle {
  background: linear-gradient(135deg, var(--color-primary), #6D5DF6);
  border-color: var(--color-primary); color: #fff;
  box-shadow: 0 0 0 5px rgba(59,110,248,.18); transform: scale(1.1);
}
.step-item.done .step-circle {
  background: #16A34A; border-color: #16A34A; color: #fff;
}
.step-label {
  font-size: 10px; font-weight: var(--weight-bold); color: var(--color-text-muted);
  text-align: center; white-space: nowrap; display: none;
}
@media(min-width:640px) { .step-label { display: block; } }
.step-item.active .step-label { color: var(--color-primary); }
.step-item.done .step-label  { color: #16A34A; }

/* ── Form container ── */
.form-wrap { max-width: 760px; margin: var(--sp-8) auto var(--sp-20); padding: 0 var(--sp-6); }

/* ── Step cards ── */
.step-panel { display: none; }
.step-panel.is-active { display: block; animation: fadeSlide .3s ease; }
@keyframes fadeSlide { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }

.step-title-row {
  display: flex; align-items: center; gap: var(--sp-3);
  margin-bottom: var(--sp-5);
}
.step-icon {
  width: 52px; height: 52px; border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--color-primary), #2952D9);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem; flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(59,110,248,.3);
}
.step-title    { font-size: var(--text-xl); font-weight: var(--weight-black); color: var(--color-text); }
.step-subtitle { font-size: var(--text-sm); color: var(--color-text-muted); margin-top: 2px; }

/* ── Cards ── */
.card {
  background: var(--color-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-lg); margin-bottom: var(--sp-4);
  box-shadow: var(--shadow-sm); overflow: hidden;
}
.card__head {
  padding: var(--sp-3) var(--sp-5); border-bottom: 1px solid var(--color-border);
  font-size: var(--text-sm); font-weight: var(--weight-black); color: var(--color-text);
  background: var(--color-bg-soft); display: flex; align-items: center; gap: 8px;
}
.card__body { padding: var(--sp-5); }

/* ── Form elements ── */
.fg       { display: flex; flex-direction: column; gap: var(--sp-2); }
.fg--full  { grid-column: 1 / -1; }
.grid-2   { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
.grid-3   { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--sp-4); }
@media(max-width:560px){ .grid-2, .grid-3 { grid-template-columns: 1fr; } }

label     { font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--color-text); }
label .req { color: #DC2626; }
.fi {
  padding: 14px 16px;
  border: 2px solid var(--color-border); border-radius: 14px;
  font-family: var(--font-body); font-size: var(--text-base); color: var(--color-text);
  background: var(--color-bg); width: 100%; transition: border-color .18s, box-shadow .18s;
  box-sizing: border-box;
}
.fi:focus  { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 4px rgba(59,110,248,.13); }
.fi.error  { border-color: #DC2626; background: #FFF5F5; }
.fi[readonly] { background: var(--color-bg-soft); cursor: default; }
.field-err { font-size: var(--text-xs); color: #DC2626; display: none; }

/* ── Upload zones ── */
.upload-zone {
  border: 2px dashed var(--color-border); border-radius: 16px;
  padding: var(--sp-5); text-align: center; cursor: pointer;
  transition: all .2s; background: var(--color-bg-soft); position: relative;
}
.upload-zone:hover  { border-color: var(--color-primary); background: var(--color-primary-light); transform: translateY(-1px); }
.upload-zone.has-file { border-color: #16A34A; border-style: solid; background: #F0FDF4; }
.upload-zone input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
.upload-zone__icon { font-size: 1.8rem; margin-bottom: var(--sp-2); }
.upload-zone__text { font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--color-text-muted); }
.upload-zone__sub  { font-size: var(--text-xs); color: var(--color-text-faint); margin-top: 4px; }
.upload-status {
  font-size: var(--text-xs); font-weight: var(--weight-bold);
  margin-top: var(--sp-2); min-height: 16px;
}
.upload-preview {
  width: 100%; max-height: 140px; object-fit: cover;
  border-radius: var(--radius); margin-top: var(--sp-2);
  border: 1px solid var(--color-border); display: none;
}

/* ── Radio pills ── */
.radio-row { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
.radio-pill {
  display: flex; align-items: center; gap: 6px;
  padding: var(--sp-2) var(--sp-4); border: 1.5px solid var(--color-border);
  border-radius: var(--radius-full); cursor: pointer;
  font-size: var(--text-sm); font-weight: var(--weight-bold);
  transition: all .2s; user-select: none;
}
.radio-pill input { display: none; }
.radio-pill:hover   { border-color: var(--color-primary); color: var(--color-primary); }
.radio-pill.sel     { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
.radio-pill.sel-green { background: #16A34A; border-color: #16A34A; color: #fff; }

/* ── Info / warn boxes ── */
.info-box {
  display: flex; gap: var(--sp-3); align-items: flex-start;
  padding: var(--sp-4); border-radius: var(--radius);
  font-size: var(--text-sm); line-height: 1.7;
  margin-bottom: var(--sp-4);
}
.info-box--blue   { background: #EFF6FF; border: 1px solid #BFDBFE; color: #1D4ED8; }
.info-box--amber  { background: #FFFBEB; border: 1px solid #FDE68A; color: #92400E; }
.info-box--red    { background: #FFF5F5; border: 1px solid #FECACA; color: #B91C1C; }
.info-box--green  { background: #F0FDF4; border: 1px solid #BBF7D0; color: #15803D; }
.info-box__icon   { font-size: 1.2rem; flex-shrink: 0; margin-top: 1px; }

/* ── Error banner ── */
.err-banner {
  display: none; padding: var(--sp-4); border-radius: var(--radius);
  background: #FFF5F5; border: 1px solid #FECACA; color: #B91C1C;
  font-size: var(--text-sm); font-weight: var(--weight-bold);
  margin-top: var(--sp-4);
}

/* ── Nav buttons ── */
.nav-btns {
  display: flex; gap: var(--sp-3); justify-content: space-between;
  align-items: center; margin-top: var(--sp-6); padding-top: var(--sp-5);
  border-top: 1px solid var(--color-border);
}
.btn-back {
  padding: 14px 22px;
  background: #fff; color: var(--color-text-muted);
  border: 2px solid var(--color-border); border-radius: 14px;
  font-family: var(--font-body); font-size: var(--text-sm); font-weight: var(--weight-bold);
  cursor: pointer; transition: all .2s;
}
.btn-back:hover { border-color: var(--color-primary); color: var(--color-primary); }
.btn-next {
  padding: 14px 34px;
  background: var(--color-primary); color: #fff;
  border: none; border-radius: 14px;
  font-family: var(--font-body); font-size: var(--text-base); font-weight: var(--weight-black);
  cursor: pointer; transition: all .18s; display: flex; align-items: center; gap: 8px;
  box-shadow: 0 8px 22px rgba(59,110,248,.32);
}
.btn-next:hover    { background: #2952D9; transform: translateY(-2px); }
.btn-next:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }
.btn-next--green   { background: #16A34A; box-shadow: 0 8px 22px rgba(22,163,74,.32); }
.btn-next--green:hover { background: #15803D; }

/* ── Review grid ── */
.review-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: var(--sp-3); margin-bottom: var(--sp-4);
}
.review-item {
  background: var(--color-bg-soft); border: 1px solid var(--color-border);
  border-radius: var(--radius); padding: var(--sp-3) var(--sp-4);
}
.review-item__label { font-size: 11px; font-weight: var(--weight-bold); color: var(--color-text-muted); margin-bottom: 2px; }
.review-item__value { font-size: var(--text-sm); font-weight: var(--weight-semi); color: var(--color-text); }
.review-docs {
  display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-bottom: var(--sp-4);
}
.doc-chip {
  display: flex; align-items: center; gap: 5px;
  padding: 4px 10px; border-radius: var(--radius-full);
  font-size: var(--text-xs); font-weight: var(--weight-bold);
}
.doc-chip--ok  { background: #DCFCE7; color: #16A34A; border: 1px solid #BBF7D0; }
.doc-chip--miss{ background: #FEF9C3; color: #92400E; border: 1px solid #FDE68A; }

/* ── Success ── */
.success-wrap {
  display: none; text-align: center;
  padding: var(--sp-16) var(--sp-6);
  max-width: 520px; margin: 0 auto;
}
.success-wrap.is-shown { display: block; animation: fadeSlide .4s ease; }
.success-icon { font-size: 5rem; margin-bottom: var(--sp-5); animation: pop .5s cubic-bezier(.175,.885,.32,1.275) both; }
@keyframes pop { 0%{transform:scale(0);opacity:0} 100%{transform:scale(1);opacity:1} }
.success-title { font-size: var(--text-2xl); font-weight: var(--weight-black); color: #16A34A; margin-bottom: var(--sp-3); }
.success-card {
  background: #F0FDF4; border: 1.5px solid #86EFAC; border-radius: var(--radius-xl);
  padding: var(--sp-6); margin: 0 auto var(--sp-6); text-align: right;
}
.success-card__title { font-weight: var(--weight-black); color: #15803D; font-size: var(--text-lg); margin-bottom: var(--sp-3); }
.success-card__text  { color: #166534; line-height: 1.8; font-size: var(--text-sm); }
.timeline-item {
  display: flex; align-items: center; gap: var(--sp-3);
  padding: var(--sp-3); background: #fff; border-radius: var(--radius);
  border: 1px solid #BBF7D0; margin-top: var(--sp-3);
}
.timeline-item__icon { font-size: 1.4rem; flex-shrink: 0; }
.timeline-item__title{ font-weight: var(--weight-bold); font-size: var(--text-sm); color: #15803D; }
.timeline-item__sub  { font-size: var(--text-xs); color: #4ADE80; }
.success-actions { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; }
</style>

<!-- ── Hero ── -->
<div class="driver-page" id="main-content">
<div class="driver-hero" id="driver-hero">
  <div class="driver-hero__inner">
    <div class="driver-hero__badge">🚗 انضمام السائقين</div>
    <h1 class="driver-hero__title">ابدأ رحلتك معنا<br>وحقّق دخلاً يومياً</h1>
    <p class="driver-hero__sub">انضم لأكبر شبكة توصيل في دمياط — اعمل بأوقاتك وحقق دخلاً حراً</p>
    <div class="benefits-row">
      <div class="benefit-chip">💰 دخل يومي مضمون</div>
      <div class="benefit-chip">⏰ أوقات مرنة</div>
      <div class="benefit-chip">📱 تطبيق سهل الاستخدام</div>
      <div class="benefit-chip">🛡️ دعم فوري</div>
    </div>
  </div>
</div>

<!-- ── Progress bar ── -->
<div class="progress-wrap" id="progress-wrap" style="display:none">
  <div class="progress-card">
    <div class="progress-steps" id="progress-steps">
      <div class="step-item" data-step="0">
        <div class="step-circle">1</div>
        <div class="step-label">الحساب</div>
      </div>
      <div class="step-item" data-step="1">
        <div class="step-circle">2</div>
        <div class="step-label">البيانات الشخصية</div>
      </div>
      <div class="step-item" data-step="2">
        <div class="step-circle">3</div>
        <div class="step-label">الوثائق</div>
      </div>
      <div class="step-item" data-step="3">
        <div class="step-circle">4</div>
        <div class="step-label">السيارة</div>
      </div>
      <div class="step-item" data-step="4">
        <div class="step-circle">5</div>
        <div class="step-label">المراجعة</div>
      </div>
    </div>
  </div>
</div>

<!-- ── Form panels ── -->
<div class="form-wrap">

  <!-- ══ Step 0: Create Account ══ -->
  <div class="step-panel is-active" id="panel-0">
    <div class="step-title-row">
      <div class="step-icon">📱</div>
      <div>
        <div class="step-title">إنشاء حساب سائق</div>
        <div class="step-subtitle">أدخل بياناتك لبدء الطلب — لن يستغرق الأمر أكثر من دقيقتين</div>
      </div>
    </div>

    <div class="info-box info-box--blue">
      <span class="info-box__icon">ℹ️</span>
      <span>لا تحتاج حساباً مسبقاً — سننشئه لك تلقائياً. إذا كان لديك حساب بالفعل يمكنك <a href="/login?next=/driver" style="font-weight:900;color:inherit;text-decoration:underline">تسجيل الدخول</a> أولاً.</span>
    </div>

    <div class="card">
      <div class="card__head">🙋 بياناتك الشخصية</div>
      <div class="card__body">
        <div class="grid-2">
          <div class="fg">
            <label for="r-name">الاسم الكامل <span class="req">*</span></label>
            <input class="fi" id="r-name" type="text" placeholder="الاسم الرباعي" autocomplete="name"/>
            <span class="field-err" id="err-r-name"></span>
          </div>
          <div class="fg">
            <label for="r-phone">رقم الجوال <span class="req">*</span></label>
            <input class="fi" id="r-phone" type="tel" placeholder="01xxxxxxxxx" dir="ltr" autocomplete="tel"/>
            <span class="field-err" id="err-r-phone"></span>
          </div>
          <div class="fg">
            <label for="r-pass">كلمة المرور <span class="req">*</span></label>
            <input class="fi" id="r-pass" type="password" placeholder="6 أحرف على الأقل"/>
            <span class="field-err" id="err-r-pass"></span>
          </div>
          <div class="fg">
            <label for="r-city">المدينة <span class="req">*</span></label>
            <select class="fi" id="r-city">
              <option value="دمياط الجديدة">دمياط الجديدة</option>
              <option value="وسط دمياط">وسط دمياط</option>
              <option value="رأس البر">رأس البر</option>
              <option value="كفر سعد">كفر سعد</option>
              <option value="فارسكور">فارسكور</option>
              <option value="الزرقا">الزرقا</option>
              <option value="شربين">شربين</option>
            </select>
          </div>
        </div>
        <div class="err-banner" id="err-register"></div>
      </div>
    </div>

    <!-- What you'll need -->
    <div class="card">
      <div class="card__head">📋 ما ستحتاجه لإكمال الطلب</div>
      <div class="card__body">
        <div class="grid-2">
          <div style="display:flex;flex-direction:column;gap:var(--sp-2)">
            <div style="font-size:var(--text-xs);font-weight:var(--weight-bold);color:var(--color-text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">وثائق شخصية</div>
            <div style="display:flex;align-items:center;gap:8px;font-size:var(--text-sm)">✅ صورة شخصية واضحة</div>
            <div style="display:flex;align-items:center;gap:8px;font-size:var(--text-sm)">✅ بطاقة هوية وطنية (وجهان)</div>
            <div style="display:flex;align-items:center;gap:8px;font-size:var(--text-sm)">✅ رخصة قيادة سارية</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:var(--sp-2)">
            <div style="font-size:var(--text-xs);font-weight:var(--weight-bold);color:var(--color-text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">وثائق السيارة</div>
            <div style="display:flex;align-items:center;gap:8px;font-size:var(--text-sm)">✅ رخصة سيارة + تأمين + فحص</div>
            <div style="display:flex;align-items:center;gap:8px;font-size:var(--text-sm)">✅ صور السيارة (4 جوانب)</div>
            <div style="display:flex;align-items:center;gap:8px;font-size:var(--text-sm)">✅ شهادة حسن سيرة (الفيش) — مطلوبة · 🔵 التأمين والفحص اختياريان</div>
          </div>
        </div>
      </div>
    </div>

    <div class="nav-btns" style="justify-content:flex-end;border-top:none;padding-top:0">
      <button class="btn-next" id="btn-register" onclick="doRegister()">
        التالي — البيانات الشخصية
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>

  <!-- ══ Step 1: Personal Info ══ -->
  <div class="step-panel" id="panel-1">
    <div class="step-title-row">
      <div class="step-icon">👤</div>
      <div>
        <div class="step-title">البيانات الشخصية</div>
        <div class="step-subtitle">صورة شخصية وبيانات الهوية</div>
      </div>
    </div>

    <div class="card">
      <div class="card__head">🤳 الصورة الشخصية</div>
      <div class="card__body">
        <div class="fg">
          <label>صورة شخصية واضحة للوجه <span class="req">*</span></label>
          <div class="upload-zone" id="zone-driver-photo">
            <div class="upload-zone__icon">📷</div>
            <div class="upload-zone__text">انقر أو اسحب لرفع صورتك</div>
            <div class="upload-zone__sub">JPG أو PNG · يجب أن يكون الوجه واضحاً</div>
