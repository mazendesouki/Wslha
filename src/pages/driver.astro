});

/* ── Validations ── */
// Valid, non-expired date (YYYY-MM-DD, today or later).
function isFutureDate(v) {
  if (!v) return false;
  var d = new Date(v);
  if (isNaN(d.getTime())) return false;
  var today = new Date(); today.setHours(0, 0, 0, 0);
  return d >= today;
}
// Mark an upload zone as missing (red) and count it.
function needUpload(key, zoneId, statusId, miss, label) {
  if (uploads[key]) {
    var zOk = $(zoneId); if (zOk) zOk.style.borderColor = '';
    return true;
  }
  var z = $(zoneId); if (z) z.style.borderColor = '#DC2626';
  var s = $(statusId); if (s) { s.textContent = '⚠️ مطلوب'; s.style.color = '#DC2626'; }
  miss.push(label);
  return false;
}

function validatePersonal() {
  var ok = true, miss = [];
  showErr('err-personal', '');

  var nameMsg = vName($('p-name').value);
  if (nameMsg) { fieldErr('err-p-name', nameMsg); ok = false; } else clearFieldErr('err-p-name');

  if (!$('p-nat-id').value.trim()) {
    fieldErr('err-p-nat-id', 'رقم الهوية مطلوب'); ok = false;
  } else clearFieldErr('err-p-nat-id');

  var ne = $('p-nat-expiry').value;
  if (!ne) { fieldErr('err-p-nat-expiry', 'تاريخ انتهاء الهوية مطلوب'); ok = false; }
  else if (!isFutureDate(ne)) { fieldErr('err-p-nat-expiry', 'الهوية منتهية — أدخل تاريخاً سارياً'); ok = false; }
  else clearFieldErr('err-p-nat-expiry');

  if (!needUpload('driver-photo', 'zone-driver-photo', 'status-driver-photo', miss, 'الصورة الشخصية')) ok = false;

  if (miss.length) showErr('err-personal', '⚠️ مستندات مطلوبة: ' + miss.join('، '));
  else if (!ok) showErr('err-personal', '⚠️ يرجى تصحيح الحقول المطلوبة.');
  return ok;
}

function validateDocs() {
  var ok = true, miss = [];
  showErr('err-docs', '');

  // National ID images
  if (!needUpload('nat-front', 'zone-nat-front', 'status-nat-front', miss, 'الهوية (أمامي)')) ok = false;
  if (!needUpload('nat-back',  'zone-nat-back',  'status-nat-back',  miss, 'الهوية (خلفي)')) ok = false;

  // Driving license
  if (!$('d-lic-num').value.trim()) { fieldErr('err-d-lic-num', 'رقم رخصة القيادة مطلوب'); ok = false; }
  else clearFieldErr('err-d-lic-num');
  var le = $('d-lic-exp').value;
  if (!le) { fieldErr('err-d-lic-exp', 'تاريخ انتهاء الرخصة مطلوب'); ok = false; }
  else if (!isFutureDate(le)) { fieldErr('err-d-lic-exp', 'الرخصة منتهية — أدخل تاريخاً سارياً'); ok = false; }
  else clearFieldErr('err-d-lic-exp');
  if (!needUpload('license', 'zone-license', 'status-license', miss, 'صورة رخصة القيادة')) ok = false;

  // Vehicle registration
  if (!$('d-vreg-num').value.trim()) { fieldErr('err-d-vreg-num', 'رقم رخصة السيارة مطلوب'); ok = false; }
  else clearFieldErr('err-d-vreg-num');
  var ve = $('d-vreg-exp').value;
  if (!ve) { showErr('err-docs', ''); ok = false; miss.push('تاريخ انتهاء رخصة السيارة'); }
  else if (!isFutureDate(ve)) { ok = false; miss.push('رخصة السيارة منتهية'); }
  if (!needUpload('vreg', 'zone-vreg', 'status-vreg', miss, 'صورة رخصة السيارة')) ok = false;

  // Insurance & inspection: OPTIONAL — but if a date is entered it must be valid.
  var ins = $('d-ins-exp').value;
  if (ins && !isFutureDate(ins)) { ok = false; miss.push('تاريخ التأمين غير صالح أو منتهٍ'); }
  var insp = $('d-insp-exp').value;
  if (insp && !isFutureDate(insp)) { ok = false; miss.push('تاريخ الفحص غير صالح أو منتهٍ'); }

  // Criminal record (الفيش / حسن السيرة): MANDATORY
  if (!needUpload('conduct', 'zone-conduct', 'status-conduct', miss, 'شهادة حسن السيرة (الفيش)')) ok = false;

  if (miss.length) showErr('err-docs', '⚠️ مطلوب: ' + miss.join('، '));
  else if (!ok) showErr('err-docs', '⚠️ يرجى تصحيح الحقول المطلوبة.');
  return ok;
}

function validateVehicle() {
  var ok = true, miss = [];
  showErr('err-vehicle', '');

  var checks = [
    ['v-model', 'err-v-model', 'موديل السيارة مطلوب'],
    ['v-color', 'err-v-color', 'لون السيارة مطلوب'],
    ['v-year',  'err-v-year',  'سنة الصنع مطلوبة'],
    ['v-plate', 'err-v-plate', 'رقم اللوحة مطلوب'],
    ['v-hw-text','err-v-hw-text','النص المكتوب بخط اليد مطلوب'],
  ];
  checks.forEach(function(c) {
    var val = ($( c[0]).value || '').trim();
    if (!val) { fieldErr(c[1], c[2]); ok = false; }
    else clearFieldErr(c[1]);
  });

  // Year sanity
  var yr = parseInt(($('v-year').value || '').trim(), 10);
  if (yr && (yr < 2000 || yr > 2030)) { fieldErr('err-v-year', 'سنة صنع غير صحيحة'); ok = false; }

  // Required vehicle photos (4 sides + plate)
  if (!needUpload('veh-front', 'zone-veh-front', 'status-veh-front', miss, 'صورة أمامية')) ok = false;
  if (!needUpload('veh-back',  'zone-veh-back',  'status-veh-back',  miss, 'صورة خلفية')) ok = false;
  if (!needUpload('veh-right', 'zone-veh-right', 'status-veh-right', miss, 'صورة يمين')) ok = false;
  if (!needUpload('veh-left',  'zone-veh-left',  'status-veh-left',  miss, 'صورة يسار')) ok = false;
  if (!needUpload('plate',     'zone-plate',     'status-plate',     miss, 'صورة لوحة الترقيم')) ok = false;

  if (miss.length) showErr('err-vehicle', '⚠️ صور مطلوبة: ' + miss.join('، '));
  else if (!ok) showErr('err-vehicle', '⚠️ يرجى تعبئة جميع الحقول المطلوبة');
  return ok;
}

/* ── Build review ── */
function buildReview() {
  // Personal
  var personalRows = [
    ['الاسم الكامل', $('p-name').value],
    ['رقم الجوال', USER && USER.phone],
    ['رقم الهوية', $('p-nat-id').value],
    ['انتهاء الهوية', $('p-nat-expiry').value],
    ['رخصة القيادة', $('d-lic-num').value],
    ['انتهاء الرخصة', $('d-lic-exp').value],
  ];
  $('review-personal').innerHTML = '<div class="review-grid">' +
    personalRows.filter(function(r){ return r[1]; }).map(function(r) {
      return '<div class="review-item"><div class="review-item__label">' + r[0] + '</div><div class="review-item__value">' + r[1] + '</div></div>';
    }).join('') + '</div>';

  // Docs
  var docKeys = [
    ['driver-photo','صورة شخصية'],['nat-front','هوية (أمامي)'],['nat-back','هوية (خلفي)'],
    ['license','رخصة قيادة'],['vreg','رخصة سيارة'],['insurance','تأمين'],
    ['inspection','فحص دوري'],['conduct','حسن سيرة'],
  ];
  $('review-docs').innerHTML = '<div class="review-docs">' +
    docKeys.map(function(d) {
      var has = !!uploads[d[0]];
      return '<div class="doc-chip ' + (has ? 'doc-chip--ok' : 'doc-chip--miss') + '">' + (has ? '✅' : '—') + ' ' + d[1] + '</div>';
    }).join('') + '</div>';

  // Vehicle
  var vehRows = [
    ['موديل', $('v-model').value],
    ['اللون', $('v-color').value],
    ['سنة الصنع', $('v-year').value],
    ['رقم اللوحة', $('v-plate').value],
    ['الملكية', {owned:'ملكي',rented:'إيجار',borrowed:'مستعارة'}[document.querySelector('input[name="ownership"]:checked') && document.querySelector('input[name="ownership"]:checked').value] || '—'],
    ['مخدرات', (document.querySelector('input[name="drugs"]:checked') || {}).value === 'no' ? '❌ لا' : '⚠️ نعم'],
  ];
  $('review-vehicle').innerHTML = '<div class="review-grid">' +
    vehRows.map(function(r) {
      return '<div class="review-item"><div class="review-item__label">' + r[0] + '</div><div class="review-item__value">' + r[1] + '</div></div>';
    }).join('') + '</div>';
}

/* ── Submit ── */
window.submitApp = async function() {
  if (!validatePersonal()) { showErr('err-submit', '⚠️ بيانات شخصية ناقصة — راجع الخطوة 1.'); setPanel(1); return; }
  if (!validateDocs())     { showErr('err-submit', '⚠️ وثائق ناقصة أو منتهية — راجع الخطوة 2.'); setPanel(2); return; }
  if (!validateVehicle())  { showErr('err-submit', '⚠️ بيانات سيارة ناقصة — راجع الخطوة 3.'); setPanel(3); return; }
  var btn = $('btn-submit');
  btn.disabled = true;
  btn.textContent = '⏳ جاري الإرسال…';
  showErr('err-submit', '');

  var plateNum = ($('v-plate').value || '').trim();
  var hwText   = ($('v-hw-text').value || '').trim();

  var payload = {
    phone:              USER.phone,
    status:             'pending',
    full_name:          $('p-name').value.trim(),
    national_id_number: $('p-nat-id').value.trim(),
    national_id_expiry: $('p-nat-expiry').value,
    national_id_front_url: uploads['nat-front'] || null,
    national_id_back_url:  uploads['nat-back']  || null,
    driver_photo_url:   uploads['driver-photo'] || null,
    license_number:     $('d-lic-num').value.trim(),
    license_expiry:     $('d-lic-exp').value,
    license_photo_url:  uploads['license'] || null,
    vehicle_reg_number: $('d-vreg-num').value.trim() || plateNum,
    vehicle_reg_expiry: $('d-vreg-exp').value,
    vehicle_reg_photo_url: uploads['vreg'] || null,
    insurance_expiry:   $('d-ins-exp').value,
    insurance_photo_url:uploads['insurance'] || null,
    inspection_expiry:  $('d-insp-exp').value,
    inspection_photo_url:uploads['inspection'] || null,
    vehicle_model:      $('v-model').value.trim(),
    vehicle_color:      $('v-color').value.trim(),
    vehicle_year:       $('v-year').value,
    vehicle_purchase_date: $('v-purchase').value || null,
    vehicle_ownership:  (document.querySelector('input[name="ownership"]:checked') || {}).value || 'owned',
    vehicle_front_url:  uploads['veh-front'] || null,
    vehicle_back_url:   uploads['veh-back']  || null,
    vehicle_right_url:  uploads['veh-right'] || null,
    vehicle_left_url:   uploads['veh-left']  || null,
    plate_photo_url:    uploads['plate']     || null,
    handwritten_text:   (plateNum ? 'لوحة: ' + plateNum + ' — ' : '') + hwText,
    handwritten_photo_url: uploads['plate']  || null,
    good_conduct_url:   uploads['conduct']   || null,
    uses_drugs:         (document.querySelector('input[name="drugs"]:checked') || {}).value || 'no',
    created_at:         new Date().toISOString(),
  };

  try {
    // Step 1: find existing preliminary record
    var existingApp = await getApp(USER.phone);

    var saved = false;

    if (existingApp && existingApp.id) {
      // Step 2a: PATCH by ID — guaranteed to update exactly 1 row
      var resPatch = await fetch(SB_URL + '/rest/v1/driver_applications?id=eq.' + encodeURIComponent(existingApp.id), {
        method: 'PATCH',
        headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
        body: JSON.stringify(payload),
      });
      if (resPatch.ok) {
        saved = true;
      } else {
        var pErr = '';
        try { var pe = await resPatch.json(); pErr = pe.message || pe.hint || pe.details || ''; } catch {}
        console.warn('PATCH failed:', resPatch.status, pErr);
      }
    }

    if (!saved) {
      // Step 2b: POST new record
      var resPost = await fetch(SB_URL + '/rest/v1/driver_applications', {
        method: 'POST',
        headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
        body: JSON.stringify(Object.assign({ id: crypto.randomUUID() }, payload)),
      });
      if (!resPost.ok) {
        var detail = '';
        try { var jj = await resPost.json(); detail = jj.message || jj.hint || jj.details || ''; } catch { detail = await resPost.text().catch(function(){ return ''; }); }
        throw new Error('فشل حفظ الطلب (' + resPost.status + '): ' + detail);
      }
      saved = true;
    }

    // Show success
    document.querySelectorAll('.step-panel').forEach(function(p){ p.classList.remove('is-active'); });
    $('success-panel').classList.add('is-shown');
    $('progress-wrap').style.display = 'none';
    window.scrollTo({ top: 0, behavior: 'smooth' });

  } catch(e) {
    showErr('err-submit', '❌ ' + (e.message || 'حدث خطأ. تحقق من الاتصال وحاول مجدداً.'));
    btn.disabled = false;
    btn.textContent = '📤 إرسال الطلب النهائي';
  }
};

})();
</script>

<style is:inline>
@keyframes spin { to { transform: rotate(360deg); } }
</style>

</Layout>
