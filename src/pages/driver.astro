/* ── Validations ── */
// Valid, non-expired date (YYYY-MM-DD, today or later).
function isFutureDate(v) {
  if (!v) return false;
  var d = new Date(v);
  if (isNaN(d.getTime())) return false;
  var today = new Date(); today.setHours(0, 0, 0, 0);
  return d >= today;
}
// Mark an upload zone as missing (red) and count it.
function needUpload(key, zoneId, statusId, miss, label) {
  if (uploads[key]) {
    var zOk = $(zoneId); if (zOk) zOk.style.borderColor = '';
    return true;
  }
  var z = $(zoneId); if (z) z.style.borderColor = '#DC2626';
  var s = $(statusId); if (s) { s.textContent = '⚠️ مطلوب'; s.style.color = '#DC2626'; }
  miss.push(label);
  return false;
}

function validatePersonal() {
  var ok = true, miss = [];
  showErr('err-personal', '');

  var nameMsg = vName($('p-name').value);
  if (nameMsg) { fieldErr('err-p-name', nameMsg); ok = false; } else clearFieldErr('err-p-name');

  var natId = $('p-nat-id').value.trim();
  if (!natId) {
    fieldErr('err-p-nat-id', 'رقم الهوية مطلوب'); ok = false;
  } else if (!isValidEgyptianNationalId(natId)) {
    fieldErr('err-p-nat-id', 'رقم قومي غير صحيح — لازم يكون 14 رقم ويبدأ بـ 2 أو 3'); ok = false;
  } else if (natIdTaken) {
    fieldErr('err-p-nat-id', 'هذا الرقم القومي مسجّل بالفعل'); ok = false;
  } else clearFieldErr('err-p-nat-id');

  var ne = $('p-nat-expiry').value;
  if (!ne) { fieldErr('err-p-nat-expiry', 'تاريخ انتهاء الهوية مطلوب'); ok = false; }
  else if (!isFutureDate(ne)) { fieldErr('err-p-nat-expiry', 'الهوية منتهية — أدخل تاريخاً سارياً'); ok = false; }
  else clearFieldErr('err-p-nat-expiry');

  if (!needUpload('driver-photo', 'zone-driver-photo', 'status-driver-photo', miss, 'الصورة الشخصية')) ok = false;

  if (miss.length) showErr('err-personal', '⚠️ مستندات مطلوبة: ' + miss.join('، '));
  else if (!ok) showErr('err-personal', '⚠️ يرجى تصحيح الحقول المطلوبة.');
  return ok;
}

function validateDocs() {
  var ok = true, miss = [];
  showErr('err-docs', '');

  // National ID images
  if (!needUpload('nat-front', 'zone-nat-front', 'status-nat-front', miss, 'الهوية (أمامي)')) ok = false;
  if (!needUpload('nat-back',  'zone-nat-back',  'status-nat-back',  miss, 'الهوية (خلفي)')) ok = false;

  // Driving license
  if (!$('d-lic-num').value.trim()) { fieldErr('err-d-lic-num', 'رقم رخصة القيادة مطلوب'); ok = false; }
  else clearFieldErr('err-d-lic-num');
  var le = $('d-lic-exp').value;
  if (!le) { fieldErr('err-d-lic-exp', 'تاريخ انتهاء الرخصة مطلوب'); ok = false; }
  else if (!isFutureDate(le)) { fieldErr('err-d-lic-exp', 'الرخصة منتهية — أدخل تاريخاً سارياً'); ok = false; }
  else clearFieldErr('err-d-lic-exp');
  if (!needUpload('license', 'zone-license', 'status-license', miss, 'صورة رخصة القيادة')) ok = false;

  // Vehicle registration — wording kept generic ("المركبة") since this
  // step applies the same to سيارة/دراجة نارية/سيارة نقل.
  if (!$('d-vreg-num').value.trim()) { fieldErr('err-d-vreg-num', 'رقم رخصة المركبة مطلوب'); ok = false; }
  else clearFieldErr('err-d-vreg-num');
  var ve = $('d-vreg-exp').value;
  if (!ve) { showErr('err-docs', ''); ok = false; miss.push('تاريخ انتهاء رخصة المركبة'); }
  else if (!isFutureDate(ve)) { ok = false; miss.push('رخصة المركبة منتهية'); }
  if (!needUpload('vreg', 'zone-vreg', 'status-vreg', miss, 'صورة رخصة المركبة')) ok = false;

  // Insurance & inspection: OPTIONAL — but if a date is entered it must be valid.
  var ins = $('d-ins-exp').value;
  if (ins && !isFutureDate(ins)) { ok = false; miss.push('تاريخ التأمين غير صالح أو منتهٍ'); }
  var insp = $('d-insp-exp').value;
  if (insp && !isFutureDate(insp)) { ok = false; miss.push('تاريخ الفحص غير صالح أو منتهٍ'); }

  // Criminal record (الفيش / حسن السيرة): MANDATORY
  if (!needUpload('conduct', 'zone-conduct', 'status-conduct', miss, 'شهادة حسن السيرة (الفيش)')) ok = false;

  if (miss.length) showErr('err-docs', '⚠️ مطلوب: ' + miss.join('، '));
  else if (!ok) showErr('err-docs', '⚠️ يرجى تصحيح الحقول المطلوبة.');
  return ok;
}

function validateVehicle() {
  var ok = true, miss = [];
  showErr('err-vehicle', '');

  var checks = [
    ['v-model', 'err-v-model', 'الماركة والموديل مطلوبين'],
    ['v-color', 'err-v-color', 'اللون مطلوب'],
    ['v-year',  'err-v-year',  'سنة الصنع مطلوبة'],
    ['v-plate', 'err-v-plate', 'رقم اللوحة مطلوب'],
    ['v-hw-text','err-v-hw-text','النص المكتوب بخط اليد مطلوب'],
  ];
  checks.forEach(function(c) {
    var val = ($( c[0]).value || '').trim();
    if (!val) { fieldErr(c[1], c[2]); ok = false; }
    else clearFieldErr(c[1]);
  });

  // Year sanity
  var yr = parseInt(($('v-year').value || '').trim(), 10);
  if (yr && (yr < 2000 || yr > 2030)) { fieldErr('err-v-year', 'سنة صنع غير صحيحة'); ok = false; }

  // Required vehicle photos (4 sides + plate)
  if (!needUpload('veh-front', 'zone-veh-front', 'status-veh-front', miss, 'صورة أمامية')) ok = false;
  if (!needUpload('veh-back',  'zone-veh-back',  'status-veh-back',  miss, 'صورة خلفية')) ok = false;
  if (!needUpload('veh-right', 'zone-veh-right', 'status-veh-right', miss, 'صورة يمين')) ok = false;
  if (!needUpload('veh-left',  'zone-veh-left',  'status-veh-left',  miss, 'صورة يسار')) ok = false;
  if (!needUpload('plate',     'zone-plate',     'status-plate',     miss, 'صورة لوحة الترقيم')) ok = false;

  if (miss.length) showErr('err-vehicle', '⚠️ صور مطلوبة: ' + miss.join('، '));
  else if (!ok) showErr('err-vehicle', '⚠️ يرجى تعبئة جميع الحقول المطلوبة');
  return ok;
}

