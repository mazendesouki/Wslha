<script is:inline>
(function() {

var SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
var SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
var SB_H   = { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY };

var USER       = null;
var currentPanel = 0;
var uploads    = {};

/* ── Load user ── */
try { USER = JSON.parse(localStorage.getItem('wslha_user') || 'null'); } catch {}

/* ── فئة السيارة (سيدان/SUV/فان) تُستخدم لتحديد شريحة التسعير؛ الماركة والموديل
      كتابة حرة يكتبها السائق كما هي في رخصة سيارته. ── */

/* ── Init ── */
// Arriving from the driver app's native account-creation step
// (features/auth/driver_merchant_register_screen.dart) always wins over
// whatever's already in localStorage — a browser that's ever logged into
// this site before (e.g. an admin testing on their own phone) already
// has a stale wslha_user sitting there, which would otherwise resume
// THAT session instead of the fresh registration this link is actually
// for. The account and a preliminary driver_applications row already
// exist at this point, so this skips straight past panel 0 (account) to
// panel 1 (البيانات الشخصية — still needs the national ID number/expiry,
// which the native step doesn't collect) instead of making them
// re-enter everything. Session storage isn't shared between the app and
// this page, so this re-does the lookup rather than trusting the URL.
//
// The personal photo (?photo=<url>) rides along as its own query param
// rather than being looked up from driver_applications — that table's
// national_id_number/expiry, license_number/expiry, and every vehicle
// column are NOT NULL with no default, so the app can never successfully
// pre-create a row with just phone/name/photo; there's nothing in the DB
// yet to look the photo up from. It's picked up here and only actually
// saved once submitApp() sends the complete row.
var qsPhone = new URLSearchParams(window.location.search).get('phone');
var qsPhoto = new URLSearchParams(window.location.search).get('photo');
var qsName  = new URLSearchParams(window.location.search).get('name');
if (qsPhone) {
  setPanel(0);
  var normalizedQsPhone = qsPhone.replace(/^\+20/, '0');
  (async function resumeFromApp() {
      try {
        var lookupRes = await fetch(SB_URL + '/rest/v1/rpc/lookup_account', {
          method: 'POST', headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json' }),
          body: JSON.stringify({ p_phone: normalizedQsPhone }),
        });
        var rows = lookupRes.ok ? await lookupRes.json() : [];
        if (!(Array.isArray(rows) && rows.length && rows[0].role === 'driver')) {
          var rPhone = $('r-phone'); if (rPhone) rPhone.value = normalizedQsPhone;
          return;
        }
        var acc = rows[0];
        // The name just typed on the app's registration screen wins over
        // whatever's on the account row — e.g. the account already
        // existed under a different name (upgraded from another role),
        // or lookup_account simply didn't return one. Either way, don't
        // make them retype what they already gave the app.
        USER = { phone: acc.phone, name: (qsName && qsName.trim()) || acc.name || '', role: 'driver', status: acc.status || 'pending', city: acc.city || '' };
        USER.avatar = dAvatar(USER.name);
        localStorage.setItem('wslha_user', JSON.stringify(USER));

        if (qsPhoto) {
          uploads['driver-photo'] = qsPhoto;
          var prev = $('prev-driver-photo');
          if (prev) { prev.src = qsPhoto; prev.style.display = 'block'; }
          var zone = $('zone-driver-photo');
          if (zone) zone.classList.add('has-file');
          var status = $('status-driver-photo');
          if (status) { status.textContent = '✅ اتصورت من التطبيق بالفعل'; status.style.color = '#16A34A'; }
        }

        showProgressBar();
        prefillUser();
        setPanel(1);
      } catch (e) {
        var rPhoneFallback = $('r-phone'); if (rPhoneFallback) rPhoneFallback.value = normalizedQsPhone;
      }
  })();
} else if (USER && USER.phone) {
  showProgressBar();
  setPanel(1);
  prefillUser();
} else {
  setPanel(0);
}

/* ── Helpers ── */
function $(id) { return document.getElementById(id); }

function normPhone(p) {
  p = (p || '').replace(/\s+/g, '');
  if (p.startsWith('+2')) return p;
  if (p.startsWith('002')) return '+' + p.slice(2);
  if (p.startsWith('01')) return '+2' + p;
  return p;
}
// Canonical Egyptian mobile (local 01XXXXXXXXX) — '' if invalid.
// Mirrors src/utils/validation.ts so all signup flows match.
function canonLocal(p) {
  var v = (p || '').replace(/[\s\-()]/g, '');
  if (v.indexOf('+20') === 0) v = '0' + v.slice(3);
  else if (v.indexOf('0020') === 0) v = '0' + v.slice(4);
  else if (v.indexOf('20') === 0 && v.length === 12) v = '0' + v.slice(2);
  return /^01[0125][0-9]{8}$/.test(v) ? v : '';
}
// Default avatar (SVG data-URI from initials) for every new account.
function dAvatar(name) {
  var clean = (name || '؟').trim();
  var parts = clean.split(/\s+/).filter(Boolean);
  var initials = (parts[0] ? parts[0][0] : '؟') + (parts[1] ? parts[1][0] : '');
  var grads = [['#0E4B49','#6D5DF6'],['#16A34A','#0EA5A0'],['#F59E0B','#EF4444'],['#8B5CF6','#EC4899'],['#0EA5E9','#22C55E'],['#F43F5E','#FB923C']];
  var hash = 0; for (var i = 0; i < clean.length; i++) hash = (hash * 31 + clean.charCodeAt(i)) >>> 0;
  var g = grads[hash % grads.length];
  var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="'+g[0]+'"/><stop offset="1" stop-color="'+g[1]+'"/></linearGradient></defs><rect width="120" height="120" rx="60" fill="url(#g)"/><text x="60" y="60" dy=".36em" text-anchor="middle" fill="#fff" font-family="Cairo,sans-serif" font-size="48" font-weight="800">'+initials+'</text></svg>';
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
}
// Garbage-resistant full-name check. Returns '' if valid, else message.
function vName(n) {
  n = (n || '').trim().replace(/\s+/g, ' ');
  if (n.length < 4 || n.length > 50) return 'أدخل اسمك الكامل (4-50 حرفاً).';
  if (!/^[A-Za-z؀-ۿ ]+$/.test(n)) return 'الاسم: حروف فقط بدون أرقام أو رموز.';
  var w = n.split(' ').filter(Boolean);
  if (w.length < 2) return 'أدخل الاسم الكامل (اسمان على الأقل).';
  if (w.some(function(x){ return x.length < 2; })) return 'كل جزء من الاسم حرفان على الأقل.';
  if (w.some(function(x){ return /^(.)\1+$/.test(x); })) return 'الاسم غير صالح، أدخل اسمك الحقيقي.';
  return '';
}
// Strong password (8+, upper, lower, digit, alphanumeric). '' if valid.
function vPass(p) {
  p = p || '';
  if (p.length < 8) return 'كلمة المرور 8 أحرف على الأقل.';
  if (!/^[A-Za-z0-9]+$/.test(p)) return 'بدون مسافات أو رموز — حروف وأرقام فقط.';
  if (!/[A-Z]/.test(p)) return 'يجب أن تحتوي على حرف كبير (A-Z).';
  if (!/[a-z]/.test(p)) return 'يجب أن تحتوي على حرف صغير (a-z).';
  if (!/[0-9]/.test(p)) return 'يجب أن تحتوي على رقم.';
  return '';
}
function localPhone(p) { return p.startsWith('+20') ? '0' + p.slice(3) : p; }
function orFilter(p) {
  var intl   = p.startsWith('01') ? '+2' + p : p;
  var local  = p.startsWith('+20') ? '0' + p.slice(3) : p;
  return 'or=(phone.eq.' + encodeURIComponent(intl) + ',phone.eq.' + encodeURIComponent(local) + ')';
}

function fieldErr(id, msg) {
  var el = $(id); if (!el) return;
  // 'block' صراحةً — القيمة الفارغة '' بتسيب قاعدة الـ CSS (display:none) تكسب تاني فالرسالة ماتظهرش
  el.textContent = msg; el.style.display = msg ? 'block' : 'none';
  var fi = el.previousElementSibling;
  if (fi && fi.classList.contains('fi')) fi.classList.toggle('error', !!msg);
}
function clearFieldErr(id) { fieldErr(id, ''); }

function showErr(bannerId, msg) {
  var el = $(bannerId); if (!el) return;
  el.textContent = msg; el.style.display = msg ? '' : 'none';
}

function showProgressBar() {
  $('driver-hero').style.paddingBottom = 'var(--sp-20)';
  $('progress-wrap').style.display = '';
}

/* ── Panel navigation ── */
function setPanel(n) {
  document.querySelectorAll('.step-panel').forEach(function(p){ p.classList.remove('is-active'); });
  var panel = $('panel-' + n);
  if (panel) panel.classList.add('is-active');
  currentPanel = n;

  // Update progress steps
  document.querySelectorAll('.step-item').forEach(function(s) {
    var sn = +s.dataset.step;
    s.classList.remove('active', 'done');
    if (sn === n) s.classList.add('active');
    else if (sn < n) s.classList.add('done');
    // Show checkmark in circle for done steps
    var circle = s.querySelector('.step-circle');
    if (circle) {
      if (sn < n) circle.textContent = '✓';
      else circle.textContent = sn + 1;
    }
  });

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function goPanel(n) {
  // Validate current before advancing
  if (n > currentPanel) {
    if (currentPanel === 1 && !validatePersonal()) return;
    if (currentPanel === 2 && !validateDocs()) return;
    if (currentPanel === 3 && !validateVehicle()) return;
    if (currentPanel === 4) return; // submit handled separately
  }
  if (n === 4) buildReview();
  setPanel(n);
}
window.goPanel = goPanel;

/* ── Prefill ── */
function prefillUser() {
  if (!USER) return;
  var pPhone = $('p-phone'); if (pPhone) pPhone.value = USER.phone || '';
  var pName  = $('p-name');  if (pName && USER.name) pName.value = USER.name;
  var hwInst = $('hw-instruction');
  if (hwInst) hwInst.textContent = '"أنا ' + (USER.name || 'السائق') + ' أقدم هذا الطلب للانضمام كسائق في وصّلها"';
}

/* ── Register ── */
window.doRegister = async function() {
  var name    = ($('r-name').value  || '').trim();
  var phone   = ($('r-phone').value || '').trim();
  var pass    = ($('r-pass').value  || '').trim();
  var passConfirm = ($('r-pass-confirm').value || '').trim();
  var city    = $('r-city').value;
  var btn     = $('btn-register');

  var ok = true;
  clearFieldErr('err-r-name');
  clearFieldErr('err-r-phone');
  clearFieldErr('err-r-pass');
  clearFieldErr('err-r-pass-confirm');
  showErr('err-register', '');

  var nameMsg = vName(name);
  if (nameMsg) { fieldErr('err-r-name', nameMsg); ok = false; }
  var pLocal = canonLocal(phone);
  if (!pLocal) {
    fieldErr('err-r-phone', 'رقم جوال مصري صحيح: 11 رقماً يبدأ بـ 010/011/012/015'); ok = false;
  }
  var passMsg = vPass(pass);
  if (passMsg) { fieldErr('err-r-pass', passMsg); ok = false; }
  if (!passMsg && pass !== passConfirm) { fieldErr('err-r-pass-confirm', 'كلمة المرور غير متطابقة'); ok = false; }
  if (!ok) return;

  var phone14 = pLocal;
  btn.disabled = true;
  btn.innerHTML = '<span style="display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite"></span> جاري التحقق…';

  var timeout = function(ms) {
    return new Promise(function(_, rej) { setTimeout(function(){ rej(new Error('انتهت مهلة الاتصال')); }, ms); });
  };

  try {
    // Check existing account
    var checkRes = await Promise.race([
      fetch(SB_URL + '/rest/v1/rpc/lookup_account', {
        method: 'POST', headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json' }),
        body: JSON.stringify({ p_phone: phone14 }),
      }),
      timeout(10000)
    ]);
    var existing = checkRes.ok ? await checkRes.json() : [];

    if (Array.isArray(existing) && existing.length > 0) {
      var acc = existing[0];
      if (acc.role === 'driver') {
        // "بعد تسجيل البيانات الشخصية والنوع يتم انشاء الحساب تلقائي بدون
        // تكملة إنشاء الحساب" — the account row (role='driver') gets
        // created right after step 0, so re-entering the same phone
        // later (e.g. after a reload) used to jump straight to the
        // dashboard even if documents/vehicle/photos were never filled.
        // Only treat this as "already fully registered" when the
        // application is actually complete (has vehicle_model) or
        // already reviewed — otherwise resume registration instead of
        // skipping the rest of it.
        var existingApp = await getApp(acc.phone, 'status,vehicle_model');
        var isComplete = existingApp && (existingApp.status !== 'pending' || existingApp.vehicle_model);
        if (isComplete) {
          localStorage.setItem('wslha_user', JSON.stringify({ phone: acc.phone, name: acc.name || name, role: 'driver', status: acc.status || 'pending', city: acc.city || city, avatar: dAvatar(acc.name || name) }));
          window.location.href = '/driver-dashboard';
          return;
        }
        USER = { phone: acc.phone, name: acc.name || name, role: 'driver', status: acc.status || 'pending', city: acc.city || city };
        if (!USER.avatar) USER.avatar = dAvatar(USER.name);
        localStorage.setItem('wslha_user', JSON.stringify(USER));
        showProgressBar();
        prefillUser();
        setPanel(1);
        return;
      }
      // Upgrade to driver — a direct PATCH here 401s ("permission denied
      // for table accounts"): anon has no SELECT grant on accounts
      // (security06accountslockdown.sql), and PostgREST needs it
      // internally to evaluate a PATCH's WHERE filter even though the
      // operation itself is an UPDATE. upgrade_account_role() is a
      // SECURITY DEFINER RPC that does this safely instead — see
      // db/security-16-account-role-upgrade.sql.
      await Promise.race([
        fetch(SB_URL + '/rest/v1/rpc/upgrade_account_role', {
          method: 'POST',
          headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json' }),
          body: JSON.stringify({ p_phone: acc.phone, p_role: 'driver' }),
        }),
        timeout(10000)
      ]);
      USER = { phone: acc.phone, name: acc.name || name, role: 'driver', status: 'pending', city: acc.city || city };
    } else {
      // Create new account
      var createRes = await Promise.race([
        fetch(SB_URL + '/rest/v1/accounts', {
          method: 'POST',
          headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
          body: JSON.stringify({ id: crypto.randomUUID(), phone: phone14, name: name, password: pass, role: 'driver', status: 'pending', city: city }),
        }),
        timeout(10000)
      ]);
      if (!createRes.ok) {
        var d = '';
        try { var j = await createRes.json(); d = j.message || j.hint || j.details || ''; } catch { d = await createRes.text().catch(function(){ return ''; }); }
        throw new Error('فشل إنشاء الحساب (' + createRes.status + '): ' + d);
      }
      USER = { phone: phone14, name: name, role: 'driver', status: 'pending', city: city };
    }

    if (!USER.avatar) USER.avatar = dAvatar(USER.name);
    localStorage.setItem('wslha_user', JSON.stringify(USER));

    // Create preliminary application record
    var existingApp = await getApp(USER.phone);
    if (!existingApp) {
      await Promise.race([
        fetch(SB_URL + '/rest/v1/driver_applications', {
          method: 'POST',
          headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
          body: JSON.stringify({ id: crypto.randomUUID(), phone: USER.phone, full_name: USER.name, status: 'pending', created_at: new Date().toISOString() }),
        }),
        timeout(8000)
      ]).catch(function(){});
    }

    showProgressBar();
    prefillUser();
    setPanel(1);

  } catch(e) {
    showErr('err-register', '❌ ' + (e.message || 'حدث خطأ. تحقق من الاتصال وحاول مجدداً.'));
    btn.disabled = false;
    btn.innerHTML = 'التالي — البيانات الشخصية <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
  }
};

async function getApp(phone, fields) {
  try {
    var r = await fetch(SB_URL + '/rest/v1/driver_applications?' + orFilter(phone) + '&select=' + (fields || 'id') + '&limit=1', { headers: SB_H });
    var d = r.ok ? await r.json() : [];
    return Array.isArray(d) && d.length > 0 ? d[0] : null;
  } catch { return null; }
}

/* ── File uploads ── */
// ── الرقم القومي المصري: 14 رقم، أول رقم قرن الميلاد (2=1900، 3=2000)،
//    يليه سنة/شهر/يوم ميلاد فعليين — يرفض أي رقم عشوائي أو تنسيق خاطئ.
function isValidEgyptianNationalId(id) {
  if (!/^[23]\d{13}$/.test(id)) return false;
  var century = id[0] === '2' ? 1900 : 2000;
  var year  = century + parseInt(id.slice(1, 3), 10);
  var month = parseInt(id.slice(3, 5), 10);
  var day   = parseInt(id.slice(5, 7), 10);
  if (month < 1 || month > 12) return false;
  var daysInMonth = new Date(year, month, 0).getDate();
  return day >= 1 && day <= daysInMonth;
}
var natIdTaken = false;
var natIdCheckTimer = null;
$('p-nat-id') && $('p-nat-id').addEventListener('input', function() {
  var v = this.value.trim();
  natIdTaken = false;
  clearTimeout(natIdCheckTimer);
  if (v && !isValidEgyptianNationalId(v)) {
    fieldErr('err-p-nat-id', 'رقم قومي غير صحيح — لازم يكون 14 رقم ويبدأ بـ 2 أو 3');
    return;
  }
  clearFieldErr('err-p-nat-id');
  if (!v) return;
  natIdCheckTimer = setTimeout(async function() {
    try {
      var res = await fetch(SB_URL + '/rest/v1/rpc/check_national_id_availability', {
        method: 'POST', headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json' }),
        body: JSON.stringify({ p_value: v }),
      });
      if (!res.ok) return;
      var available = await res.json();
      if (available === false) {
        natIdTaken = true;
        fieldErr('err-p-nat-id', 'هذا الرقم القومي مسجّل بالفعل');
      }
    } catch {}
  }, 600);
});

// ── كشف وجه (مجاني، في المتصفح) على الصورة الشخصية بس — يمنع رفع صورة
//    عشوائية (منظر، مستند، شعار...) بدل صورة شخصية فعلية.
var _faceApiReady = null;
function loadFaceApi() {
  if (_faceApiReady) return _faceApiReady;
  _faceApiReady = new Promise(function(resolve, reject) {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js';
    s.onload = function() {
      faceapi.nets.tinyFaceDetector
        .loadFromUri('https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights')
        .then(function() { resolve(true); }, reject);
    };
    s.onerror = function() { reject(new Error('face_api_load_failed')); };
    document.head.appendChild(s);
  });
  return _faceApiReady;
}
async function photoHasFace(file) {
  await loadFaceApi();
  var img = await new Promise(function(resolve, reject) {
    var el = new Image();
    el.onload = function() { resolve(el); };
    el.onerror = reject;
    el.src = URL.createObjectURL(file);
  });
  var detection = await faceapi.detectSingleFace(img, new faceapi.TinyFaceDetectorOptions());
  URL.revokeObjectURL(img.src);
  return !!detection;
}

// Center-crop + resize to a small square — only used for the personal
// photo (driver-photo), so its stored file is a consistent, reasonably
// sized headshot instead of whatever resolution/aspect ratio the
// driver's phone camera produced.
function resizeImageToSquare(file, size) {
  return new Promise(function(resolve, reject) {
    var img = new Image();
    img.onload = function() {
      var canvas = document.createElement('canvas');
      canvas.width = size; canvas.height = size;
      var ctx = canvas.getContext('2d');
      var scale = Math.max(size / img.width, size / img.height);
      var w = img.width * scale, h = img.height * scale;
      ctx.drawImage(img, (size - w) / 2, (size - h) / 2, w, h);
      URL.revokeObjectURL(img.src);
      canvas.toBlob(function(blob) {
        if (!blob) { reject(new Error('resize_failed')); return; }
        resolve(new File([blob], (file.name || 'photo') + '.jpg', { type: 'image/jpeg' }));
      }, 'image/jpeg', 0.9);
    };
    img.onerror = function() { reject(new Error('resize_load_failed')); };
    img.src = URL.createObjectURL(file);
  });
}

window.handleUpload = async function(input, key, zoneId) {
  var file = input.files[0];
  if (!file) return;
  var zone   = $(zoneId);
  var prev   = $('prev-' + key);
  var status = $('status-' + key);

  if (key === 'driver-photo') {
    if (status) { status.textContent = '🔍 جارٍ التحقق من وجود وجه واضح…'; status.style.color = 'var(--color-text-muted)'; }
    try {
      var hasFace = await photoHasFace(file);
      if (!hasFace) {
        input.value = '';
        if (prev)   { prev.style.display = 'none'; }
        if (status) { status.textContent = '⚠️ الصورة دي مش واضح فيها وجه — ارفع صورة شخصية حقيقية واضحة.'; status.style.color = '#DC2626'; }
        if (zone)   { zone.style.borderColor = '#DC2626'; zone.classList.remove('has-file'); }
        delete uploads[key];
        return;
      }
    } catch (e) {
      // تعذّر تحميل أداة الكشف (مثلاً بدون إنترنت) — نكمل بدون حجب رفع الصورة
      // بدل ما نمنع السائق من التسجيل بسبب مشكلة شبكة لا علاقة له بها.
    }
    try { file = await resizeImageToSquare(file, 400); } catch (e) { /* ارفع الأصلية لو فشل القص */ }
  }

  // Preview
  var reader = new FileReader();
  reader.onload = function(e) {
    if (prev) { prev.src = e.target.result; prev.style.display = 'block'; }
  };
  reader.readAsDataURL(file);

  if (status) { status.textContent = '⏳ جاري الرفع…'; status.style.color = 'var(--color-text-muted)'; }
  if (zone)   { zone.style.borderColor = 'var(--color-primary)'; }

  var ext  = (file.name.split('.').pop() || 'jpg').toLowerCase();
  var path = 'driver-apps/' + (USER && USER.phone || 'anon') + '/' + key + '-' + Date.now() + '.' + ext;

  try {
    var res = await fetch(SB_URL + '/storage/v1/object/documents/' + path, {
      method: 'POST',
      headers: { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY, 'Content-Type': file.type || 'image/jpeg' },
      body: file,
    });
    if (res.ok) {
      var publicUrl = SB_URL + '/storage/v1/object/public/documents/' + path;

      // Duplicate-image + (for official documents) AI content check —
      // server-side, see src/pages/api/documents/verify.ts. Runs after
      // the upload since the check needs a fetchable URL; a rejection
      // here removes the file from `uploads` so the submit-time
      // validation catches it as missing, same as never having uploaded
      // anything.
      if (status) { status.textContent = '🔍 جارٍ مراجعة المستند…'; status.style.color = 'var(--color-text-muted)'; }
      try {
        var vRes = await fetch('/api/documents/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ imageUrl: publicUrl, docType: key, phone: (USER && USER.phone) || 'anon' }),
        });
        // The endpoint returns a real JSON body on every explicit
        // rejection too (409/422/etc, not just 200) — vRes.ok is only
        // true for 2xx, so it must NOT gate whether we parse the body,
        // or every rejection silently reads as { ok: true }.
        var vData;
        try { vData = await vRes.json(); } catch (e) { vData = { ok: true }; } // unparsable body = infra issue, fail open
        if (vData.ok === false) {
          input.value = '';
          delete uploads[key];
          if (prev)   { prev.style.display = 'none'; }
          if (zone)   { zone.style.borderColor = '#DC2626'; zone.classList.remove('has-file'); }
          var msg = vData.reason === 'duplicate_image'
            ? '⚠️ الصورة دي مُستخدمة بالفعل في تسجيل آخر — ارفع صورة تانية.'
            : (vData.reason === 'not_matching_document'
                ? '⚠️ الصورة دي مش واضح إنها المستند المطلوب' + (vData.detail ? (' — ' + vData.detail) : '') + '. ارفع صورة واضحة للمستند الصحيح.'
                : '⚠️ تعذّرت مراجعة الصورة — حاول ترفعها تاني.');
          if (status) { status.textContent = msg; status.style.color = '#DC2626'; }
          return;
        }
      } catch (e) {
        // تعذّر الوصول لخدمة المراجعة نفسها (مش رفض صريح) — نكمل عشان
        // مشكلة شبكة عندنا ما توقفش تسجيل سائق حقيقي.
      }

      uploads[key] = publicUrl;
      if (status) { status.textContent = '✅ تم الرفع بنجاح'; status.style.color = '#16A34A'; }
      if (zone)   { zone.classList.add('has-file'); }
    } else {
      uploads[key] = URL.createObjectURL(file);
      if (status) { status.textContent = '📎 ' + file.name; status.style.color = 'var(--color-text-muted)'; }
      if (zone)   { zone.classList.add('has-file'); }
    }
  } catch {
    uploads[key] = URL.createObjectURL(file);
    if (status) { status.textContent = '📎 ' + file.name; status.style.color = 'var(--color-text-muted)'; }
    if (zone)   { zone.classList.add('has-file'); }
  }
};

