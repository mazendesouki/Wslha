---
import Layout from '../components/layout.astro';
---
<Layout title="تقديم طلب سائق — وصّلها" currentPage="driver">
<style>
  .apply-wrap{max-width:860px;margin:0 auto;padding:var(--sp-8) var(--sp-6) var(--sp-20)}
  .step-header{display:flex;align-items:center;gap:var(--sp-3);padding:var(--sp-5) var(--sp-6);background:linear-gradient(135deg,var(--color-primary),#2952D9);color:#fff;border-radius:var(--radius-lg);margin-bottom:var(--sp-6)}
  .step-header__icon{font-size:2.2rem}
  .step-header__title{font-size:var(--text-xl);font-weight:var(--weight-black)}
  .step-header__sub{font-size:var(--text-sm);opacity:.85;margin-top:4px}
  .steps-nav{display:flex;gap:var(--sp-1);margin-bottom:var(--sp-6);overflow-x:auto;scrollbar-width:none}
  .steps-nav::-webkit-scrollbar{display:none}
  .step-pill{padding:var(--sp-2) var(--sp-4);border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:var(--weight-bold);white-space:nowrap;background:var(--color-bg-soft);color:var(--color-text-muted);border:1.5px solid var(--color-border);cursor:default}
  .step-pill.active{background:var(--color-primary);color:#fff;border-color:var(--color-primary)}
  .step-pill.done{background:var(--color-bg-soft);color:#16A34A;border-color:#16A34A}
  .card{background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-lg);margin-bottom:var(--sp-5);box-shadow:var(--shadow-sm)}
  .card__head{padding:var(--sp-4) var(--sp-5);border-bottom:1px solid var(--color-border);font-size:var(--text-base);font-weight:var(--weight-black);color:var(--color-text)}
  .card__body{padding:var(--sp-5)}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4)}
  .form-group{display:flex;flex-direction:column;gap:var(--sp-2)}
  .form-group--full{grid-column:1/-1}
  label{font-size:var(--text-sm);font-weight:var(--weight-bold);color:var(--color-text)}
  label .req{color:#DC2626;margin-right:2px}
  .form-input,.form-select,.form-textarea{padding:var(--sp-3) var(--sp-4);border:1.5px solid var(--color-border);border-radius:var(--radius);font-family:var(--font-body);font-size:var(--text-base);color:var(--color-text);background:var(--color-bg);transition:border-color var(--ease);width:100%}
  .form-input:focus,.form-select:focus,.form-textarea:focus{outline:none;border-color:var(--color-primary)}
  .form-input[type="date"]{direction:ltr;text-align:right}
  .form-textarea{min-height:80px;resize:vertical}
  .upload-zone{border:2px dashed var(--color-border);border-radius:var(--radius);padding:var(--sp-5);text-align:center;cursor:pointer;transition:all var(--ease);position:relative;background:var(--color-bg-soft)}
  .upload-zone:hover{border-color:var(--color-primary);background:var(--color-primary-light)}
  .upload-zone input[type="file"]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
  .upload-zone__icon{font-size:2rem;margin-bottom:var(--sp-2)}
  .upload-zone__text{font-size:var(--text-sm);font-weight:var(--weight-bold);color:var(--color-text-muted)}
  .upload-zone__sub{font-size:var(--text-xs);color:var(--color-text-faint);margin-top:4px}
  .upload-preview{width:100%;height:140px;object-fit:cover;border-radius:var(--radius);margin-top:var(--sp-2);border:1px solid var(--color-border);display:none}
  .upload-name{font-size:var(--text-xs);color:var(--color-primary);margin-top:var(--sp-1);font-weight:var(--weight-bold)}
  .radio-group{display:flex;gap:var(--sp-3);flex-wrap:wrap}
  .radio-btn{display:flex;align-items:center;gap:var(--sp-2);padding:var(--sp-2) var(--sp-4);border:1.5px solid var(--color-border);border-radius:var(--radius-full);cursor:pointer;transition:all var(--ease);font-size:var(--text-sm);font-weight:var(--weight-bold)}
  .radio-btn input{display:none}
  .radio-btn.selected{background:var(--color-primary);color:#fff;border-color:var(--color-primary)}
  .nav-buttons{display:flex;gap:var(--sp-3);justify-content:space-between;margin-top:var(--sp-6)}
  .btn-next{padding:var(--sp-3) var(--sp-8);background:var(--color-primary);color:#fff;border:none;border-radius:var(--radius);font-family:var(--font-body);font-size:var(--text-base);font-weight:var(--weight-bold);cursor:pointer;transition:all var(--ease)}
  .btn-next:hover{background:#2952D9;transform:translateY(-1px)}
  .btn-next:disabled{opacity:.5;cursor:not-allowed;transform:none}
  .btn-back{padding:var(--sp-3) var(--sp-6);background:var(--color-bg-soft);color:var(--color-text-muted);border:1.5px solid var(--color-border);border-radius:var(--radius);font-family:var(--font-body);font-size:var(--text-base);font-weight:var(--weight-bold);cursor:pointer}
  .info-box{padding:var(--sp-4);background:var(--color-primary-light);border:1px solid var(--color-primary);border-radius:var(--radius);font-size:var(--text-sm);color:var(--color-primary);line-height:1.7;margin-bottom:var(--sp-5)}
  .warn-box{padding:var(--sp-4);background:#FEF9C3;border:1px solid #FDE047;border-radius:var(--radius);font-size:var(--text-sm);color:#92400E;line-height:1.7;margin-bottom:var(--sp-5)}
  .success-state{text-align:center;padding:var(--sp-12) var(--sp-6)}
  .success-state__icon{font-size:4rem;margin-bottom:var(--sp-4)}
  .success-state__title{font-size:var(--text-2xl);font-weight:var(--weight-black);color:var(--color-text);margin-bottom:var(--sp-3)}
  .success-state__text{color:var(--color-text-muted);font-size:var(--text-base);line-height:1.7;max-width:480px;margin:0 auto var(--sp-6)}
  .err{color:#DC2626;font-size:var(--text-xs);margin-top:4px;display:none}
  @media(max-width:600px){.form-grid{grid-template-columns:1fr}.apply-wrap{padding:var(--sp-6) var(--sp-4) var(--sp-20)}}
</style>

<div class="apply-wrap" id="main-content">
  <div id="app-form-wrap">
    <!-- Step 0: Create account (shown when not logged in) -->
    <div class="form-step hidden" id="step-0">
      <div class="step-header">
        <div class="step-header__icon">📱</div>
        <div><div class="step-header__title">إنشاء حساب سائق</div><div class="step-header__sub">سجّل بياناتك لبدء تقديم طلب الانضمام</div></div>
      </div>
      <div class="info-box">لا تحتاج لحساب مسبق — سنُنشئه لك الآن. إذا كان لديك حساب بالفعل يمكنك <a href="/login?next=/driver" style="font-weight:900;color:var(--color-primary)">تسجيل الدخول</a> أولاً.</div>
      <div class="card">
        <div class="card__head">بياناتك الشخصية</div>
        <div class="card__body">
          <div class="form-grid">
            <div class="form-group">
              <label for="reg-name">الاسم الكامل <span class="req">*</span></label>
              <input class="form-input" id="reg-name" type="text" placeholder="اسمك رباعياً"/>
            </div>
            <div class="form-group">
              <label for="reg-phone">رقم الجوال <span class="req">*</span></label>
              <input class="form-input" id="reg-phone" type="tel" placeholder="01xxxxxxxxx" dir="ltr"/>
            </div>
            <div class="form-group">
              <label for="reg-password">كلمة المرور <span class="req">*</span></label>
              <input class="form-input" id="reg-password" type="password" placeholder="6 أحرف على الأقل"/>
            </div>
            <div class="form-group">
              <label for="reg-city">المدينة</label>
              <select class="form-select" id="reg-city">
                <option value="دمياط الجديدة">دمياط الجديدة</option>
                <option value="وسط دمياط">وسط دمياط</option>
                <option value="رأس البر">رأس البر</option>
                <option value="كفر سعد">كفر سعد</option>
                <option value="فارسكور">فارسكور</option>
              </select>
            </div>
          </div>
          <div id="reg-err" class="warn-box" style="display:none;margin-top:var(--sp-4)"></div>
        </div>
      </div>
      <div class="nav-buttons">
        <div></div>
        <button class="btn-next" id="reg-next-btn" onclick="registerAndProceed()">التالي ← البيانات الشخصية</button>
      </div>
    </div>

    <!-- Step indicator (hidden until account created) -->
    <div class="steps-nav" id="steps-nav" style="display:none">
      <div class="step-pill active" data-step="1">1. البيانات الشخصية</div>
      <div class="step-pill" data-step="2">2. وثائق الهوية والرخصة</div>
      <div class="step-pill" data-step="3">3. بيانات السيارة</div>
      <div class="step-pill" data-step="4">4. صور السيارة والمستندات</div>
      <div class="step-pill" data-step="5">5. مراجعة وإرسال</div>
    </div>

    <!-- ── Step 1: Personal ──────────────────────────────── -->
    <div class="form-step" id="step-1">
      <div class="step-header">
        <div class="step-header__icon">👤</div>
        <div><div class="step-header__title">البيانات الشخصية</div><div class="step-header__sub">معلومات الهوية والتحقق</div></div>
      </div>
      <div class="card">
        <div class="card__head">صورة السائق الشخصية</div>
        <div class="card__body">
          <div class="form-group">
            <label>صورة شخصية واضحة <span class="req">*</span></label>
            <div class="upload-zone" id="zone-driver-photo">
              <div class="upload-zone__icon">🤳</div>
              <div class="upload-zone__text">انقر لرفع صورتك الشخصية</div>
              <div class="upload-zone__sub">يجب أن يكون الوجه واضحاً · JPG أو PNG</div>
              <input type="file" accept="image/*" onchange="handleUpload(this,'driver-photo','zone-driver-photo')"/>
            </div>
            <img id="prev-driver-photo" class="upload-preview" alt=""/>
            <div class="upload-name" id="name-driver-photo"></div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card__head">البيانات الشخصية</div>
        <div class="card__body">
          <div class="form-grid">
            <div class="form-group">
              <label for="full-name">الاسم الكامل رباعياً <span class="req">*</span></label>
              <input class="form-input" id="full-name" type="text" placeholder="الاسم الكامل"/>
            </div>
            <div class="form-group">
              <label>رقم الهوية الوطنية <span class="req">*</span></label>
              <input class="form-input" id="nat-id-num" type="text" placeholder="14 رقم" maxlength="20"/>
            </div>
            <div class="form-group">
              <label>تاريخ انتهاء الهوية <span class="req">*</span></label>
              <input class="form-input" id="nat-id-expiry" type="date"/>
            </div>
            <div class="form-group">
              <label>رقم الجوال المسجل</label>
              <input class="form-input" id="disp-phone" type="tel" readonly style="background:var(--color-bg-soft)"/>
            </div>
          </div>
        </div>
      </div>
      <div class="warn-box">⚠️ يجب أن يكون اسمك مطابقاً للهوية الوطنية. أي تلاعب في البيانات سيؤدي إلى الرفض الفوري وحظر الحساب.</div>
      <div class="nav-buttons">
        <div></div>
        <button class="btn-next" onclick="goStep(2)">التالي ← الوثائق</button>
      </div>
    </div>

    <!-- ── Step 2: Documents ──────────────────────────────── -->
    <div class="form-step hidden" id="step-2">
      <div class="step-header">
        <div class="step-header__icon">📄</div>
        <div><div class="step-header__title">وثائق الهوية والرخصة</div><div class="step-header__sub">صور واضحة وغير منتهية الصلاحية</div></div>
      </div>
      <div class="card">
        <div class="card__head">الهوية الوطنية</div>
        <div class="card__body">
          <div class="form-grid">
            <div class="form-group">
              <label>صورة الهوية (الوجه الأمامي) <span class="req">*</span></label>
              <div class="upload-zone" id="zone-nat-front">
                <div class="upload-zone__icon">🪪</div>
                <div class="upload-zone__text">الوجه الأمامي</div>
                <input type="file" accept="image/*" onchange="handleUpload(this,'nat-front','zone-nat-front')"/>
              </div>
              <img id="prev-nat-front" class="upload-preview" alt=""/>
            </div>
            <div class="form-group">
              <label>صورة الهوية (الوجه الخلفي) <span class="req">*</span></label>
              <div class="upload-zone" id="zone-nat-back">
                <div class="upload-zone__icon">🪪</div>
                <div class="upload-zone__text">الوجه الخلفي</div>
                <input type="file" accept="image/*" onchange="handleUpload(this,'nat-back','zone-nat-back')"/>
              </div>
              <img id="prev-nat-back" class="upload-preview" alt=""/>
            </div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card__head">رخصة القيادة</div>
        <div class="card__body">
          <div class="form-grid">
            <div class="form-group">
              <label>رقم رخصة القيادة <span class="req">*</span></label>
              <input class="form-input" id="license-num" type="text" placeholder="رقم الرخصة"/>
            </div>
            <div class="form-group">
              <label>تاريخ انتهاء الرخصة <span class="req">*</span></label>
              <input class="form-input" id="license-expiry" type="date"/>
            </div>
            <div class="form-group form-group--full">
              <label>صورة رخصة القيادة <span class="req">*</span></label>
              <div class="upload-zone" id="zone-license">
                <div class="upload-zone__icon">🪪</div>
                <div class="upload-zone__text">صورة رخصة القيادة</div>
                <input type="file" accept="image/*" onchange="handleUpload(this,'license','zone-license')"/>
              </div>
              <img id="prev-license" class="upload-preview" alt=""/>
            </div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card__head">رخصة السيارة والتأمين والفحص</div>
        <div class="card__body">
          <div class="form-grid">
            <div class="form-group">
              <label>رقم رخصة السيارة <span class="req">*</span></label>
              <input class="form-input" id="vreg-num" type="text" placeholder="رقم الرخصة"/>
            </div>
            <div class="form-group">
              <label>تاريخ انتهاء رخصة السيارة <span class="req">*</span></label>
              <input class="form-input" id="vreg-expiry" type="date"/>
            </div>
            <div class="form-group">
              <label>صورة رخصة السيارة <span class="req">*</span></label>
              <div class="upload-zone" id="zone-vreg">
                <div class="upload-zone__icon">📋</div>
                <div class="upload-zone__text">رخصة السيارة</div>
                <input type="file" accept="image/*" onchange="handleUpload(this,'vreg','zone-vreg')"/>
              </div>
              <img id="prev-vreg" class="upload-preview" alt=""/>
            </div>
            <div class="form-group">
              <label>تاريخ انتهاء التأمين <span class="req">*</span></label>
              <input class="form-input" id="insurance-expiry" type="date"/>
              <label style="margin-top:var(--sp-2)">صورة وثيقة التأمين</label>
              <div class="upload-zone" id="zone-insurance">
                <div class="upload-zone__icon">🛡️</div>
                <div class="upload-zone__text">وثيقة التأمين</div>
                <input type="file" accept="image/*" onchange="handleUpload(this,'insurance','zone-insurance')"/>
              </div>
              <img id="prev-insurance" class="upload-preview" alt=""/>
            </div>
            <div class="form-group">
              <label>تاريخ انتهاء الفحص الدوري <span class="req">*</span></label>
              <input class="form-input" id="inspection-expiry" type="date"/>
              <label style="margin-top:var(--sp-2)">صورة شهادة الفحص الدوري</label>
              <div class="upload-zone" id="zone-inspection">
                <div class="upload-zone__icon">🔍</div>
                <div class="upload-zone__text">شهادة الفحص الدوري</div>
                <input type="file" accept="image/*" onchange="handleUpload(this,'inspection','zone-inspection')"/>
              </div>
              <img id="prev-inspection" class="upload-preview" alt=""/>
            </div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card__head">شهادة حسن السيرة (اختياري)</div>
        <div class="card__body">
          <div class="form-group">
            <label>شهادة حسن السيرة من وزارة الداخلية</label>
            <div class="upload-zone" id="zone-conduct">
              <div class="upload-zone__icon">📜</div>
              <div class="upload-zone__text">شهادة حسن السيرة (اختياري)</div>
              <input type="file" accept="image/*,application/pdf" onchange="handleUpload(this,'conduct','zone-conduct')"/>
            </div>
            <img id="prev-conduct" class="upload-preview" alt=""/>
          </div>
        </div>
      </div>
      <div class="nav-buttons">
        <button class="btn-back" onclick="goStep(1)">→ رجوع</button>
        <button class="btn-next" onclick="goStep(3)">التالي ← بيانات السيارة</button>
      </div>
    </div>

    <!-- ── Step 3: Vehicle ────────────────────────────────── -->
    <div class="form-step hidden" id="step-3">
      <div class="step-header">
        <div class="step-header__icon">🚗</div>
        <div><div class="step-header__title">بيانات السيارة</div><div class="step-header__sub">معلومات المركبة والملكية</div></div>
      </div>
      <div class="card">
        <div class="card__head">مواصفات السيارة</div>
        <div class="card__body">
          <div class="form-grid">
            <div class="form-group">
              <label>موديل السيارة <span class="req">*</span></label>
              <input class="form-input" id="veh-model" type="text" placeholder="مثال: تويوتا كورولا"/>
            </div>
            <div class="form-group">
              <label>لون السيارة <span class="req">*</span></label>
              <input class="form-input" id="veh-color" type="text" placeholder="مثال: أبيض"/>
            </div>
            <div class="form-group">
              <label>سنة الصنع <span class="req">*</span></label>
              <input class="form-input" id="veh-year" type="number" placeholder="مثال: 2020" min="2000" max="2030"/>
            </div>
            <div class="form-group">
              <label>تاريخ الشراء <span class="req">*</span></label>
              <input class="form-input" id="veh-purchase" type="date"/>
            </div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card__head">ملكية السيارة</div>
        <div class="card__body">
          <div class="form-group">
            <label>السيارة <span class="req">*</span></label>
            <div class="radio-group" id="ownership-group">
              <label class="radio-btn selected" data-val="owned"><input type="radio" name="ownership" value="owned" checked/> ملكي</label>
              <label class="radio-btn" data-val="rented"><input type="radio" name="ownership" value="rented"/> إيجار</label>
              <label class="radio-btn" data-val="borrowed"><input type="radio" name="ownership" value="borrowed"/> مستعارة من صديق/أهل</label>
            </div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card__head">أسئلة إضافية مهمة</div>
        <div class="card__body">
          <div class="form-group">
            <label>هل تتعاطى أي نوع من المخدرات؟ <span class="req">*</span></label>
            <div class="radio-group" id="drugs-group">
              <label class="radio-btn selected" data-val="no"><input type="radio" name="drugs" value="no" checked/> ❌ لا</label>
              <label class="radio-btn" data-val="yes"><input type="radio" name="drugs" value="yes"/> ⚠️ نعم</label>
            </div>
            <p style="font-size:var(--text-xs);color:var(--color-text-muted);margin-top:var(--sp-2)">الإجابة بـ "نعم" تعني رفض الطلب تلقائياً وفقاً للسياسة.</p>
          </div>
        </div>
      </div>
      <div class="nav-buttons">
        <button class="btn-back" onclick="goStep(2)">→ رجوع</button>
        <button class="btn-next" onclick="goStep(4)">التالي ← صور السيارة</button>
      </div>
    </div>

    <!-- ── Step 4: Vehicle Photos ─────────────────────────── -->
    <div class="form-step hidden" id="step-4">
      <div class="step-header">
        <div class="step-header__icon">📸</div>
        <div><div class="step-header__title">صور السيارة والتحقق</div><div class="step-header__sub">4 صور من جوانب مختلفة + لوحة الترقيم</div></div>
      </div>
      <div class="info-box">
        📋 <strong>تعليمات مهمة:</strong> في صورة لوحة الترقيم، يجب كتابة الجملة التالية بخط اليد على ورقة وإظهارها بجانب اللوحة:<br>
        <strong id="handwritten-instruction">"أنا [اسمك] أقدم هذا الطلب للانضمام كسائق في وصّلها"</strong>
      </div>
      <div class="card">
        <div class="card__head">صور السيارة الأربع الجوانب</div>
        <div class="card__body">
          <div class="form-grid">
            <div class="form-group">
              <label>الواجهة الأمامية <span class="req">*</span></label>
              <div class="upload-zone" id="zone-veh-front">
                <div class="upload-zone__icon">🚗</div>
                <div class="upload-zone__text">الواجهة الأمامية</div>
                <input type="file" accept="image/*" onchange="handleUpload(this,'veh-front','zone-veh-front')"/>
              </div>
              <img id="prev-veh-front" class="upload-preview" alt=""/>
              <div class="upload-name" id="name-veh-front"></div>
            </div>
