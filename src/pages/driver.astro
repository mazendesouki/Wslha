  var initials = (parts[0] ? parts[0][0] : '؟') + (parts[1] ? parts[1][0] : '');
  var grads = [['#3B6EF8','#6D5DF6'],['#16A34A','#0EA5A0'],['#F59E0B','#EF4444'],['#8B5CF6','#EC4899'],['#0EA5E9','#22C55E'],['#F43F5E','#FB923C']];
  var hash = 0; for (var i = 0; i < clean.length; i++) hash = (hash * 31 + clean.charCodeAt(i)) >>> 0;
  var g = grads[hash % grads.length];
  var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="'+g[0]+'"/><stop offset="1" stop-color="'+g[1]+'"/></linearGradient></defs><rect width="120" height="120" rx="60" fill="url(#g)"/><text x="60" y="60" dy=".36em" text-anchor="middle" fill="#fff" font-family="Cairo,sans-serif" font-size="48" font-weight="800">'+initials+'</text></svg>';
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
}
// Garbage-resistant full-name check. Returns '' if valid, else message.
function vName(n) {
  n = (n || '').trim().replace(/\s+/g, ' ');
  if (n.length < 4 || n.length > 50) return 'أدخل اسمك الكامل (4-50 حرفاً).';
  if (!/^[A-Za-z؀-ۿ ]+$/.test(n)) return 'الاسم: حروف فقط بدون أرقام أو رموز.';
  var w = n.split(' ').filter(Boolean);
  if (w.length < 2) return 'أدخل الاسم الكامل (اسمان على الأقل).';
  if (w.some(function(x){ return x.length < 2; })) return 'كل جزء من الاسم حرفان على الأقل.';
  if (w.some(function(x){ return /^(.)\1+$/.test(x); })) return 'الاسم غير صالح، أدخل اسمك الحقيقي.';
  return '';
}
// Strong password (8+, upper, lower, digit, alphanumeric). '' if valid.
function vPass(p) {
  p = p || '';
  if (p.length < 8) return 'كلمة المرور 8 أحرف على الأقل.';
  if (!/^[A-Za-z0-9]+$/.test(p)) return 'بدون مسافات أو رموز — حروف وأرقام فقط.';
  if (!/[A-Z]/.test(p)) return 'يجب أن تحتوي على حرف كبير (A-Z).';
  if (!/[a-z]/.test(p)) return 'يجب أن تحتوي على حرف صغير (a-z).';
  if (!/[0-9]/.test(p)) return 'يجب أن تحتوي على رقم.';
  return '';
}
function localPhone(p) { return p.startsWith('+20') ? '0' + p.slice(3) : p; }
function orFilter(p) {
  var intl   = p.startsWith('01') ? '+2' + p : p;
  var local  = p.startsWith('+20') ? '0' + p.slice(3) : p;
  return 'or=(phone.eq.' + encodeURIComponent(intl) + ',phone.eq.' + encodeURIComponent(local) + ')';
}

function fieldErr(id, msg) {
  var el = $(id); if (!el) return;
  el.textContent = msg; el.style.display = msg ? '' : 'none';
  var fi = el.previousElementSibling;
  if (fi && fi.classList.contains('fi')) fi.classList.toggle('error', !!msg);
}
function clearFieldErr(id) { fieldErr(id, ''); }

function showErr(bannerId, msg) {
  var el = $(bannerId); if (!el) return;
  el.textContent = msg; el.style.display = msg ? '' : 'none';
}

function showProgressBar() {
  $('driver-hero').style.paddingBottom = 'var(--sp-20)';
  $('progress-wrap').style.display = '';
}

/* ── Panel navigation ── */
function setPanel(n) {
  document.querySelectorAll('.step-panel').forEach(function(p){ p.classList.remove('is-active'); });
  var panel = $('panel-' + n);
  if (panel) panel.classList.add('is-active');
  currentPanel = n;

  // Update progress steps
  document.querySelectorAll('.step-item').forEach(function(s) {
    var sn = +s.dataset.step;
    s.classList.remove('active', 'done');
    if (sn === n) s.classList.add('active');
    else if (sn < n) s.classList.add('done');
    // Show checkmark in circle for done steps
    var circle = s.querySelector('.step-circle');
    if (circle) {
      if (sn < n) circle.textContent = '✓';
      else circle.textContent = sn + 1;
    }
  });

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function goPanel(n) {
  // Validate current before advancing
  if (n > currentPanel) {
    if (currentPanel === 1 && !validatePersonal()) return;
    if (currentPanel === 2 && !validateDocs()) return;
    if (currentPanel === 3 && !validateVehicle()) return;
    if (currentPanel === 4) return; // submit handled separately
  }
  if (n === 4) buildReview();
  setPanel(n);
}
window.goPanel = goPanel;

/* ── Prefill ── */
function prefillUser() {
  if (!USER) return;
  var pPhone = $('p-phone'); if (pPhone) pPhone.value = USER.phone || '';
  var pName  = $('p-name');  if (pName && USER.name) pName.value = USER.name;
  var hwInst = $('hw-instruction');
  if (hwInst) hwInst.textContent = '"أنا ' + (USER.name || 'السائق') + ' أقدم هذا الطلب للانضمام كسائق في وصّلها"';
}

/* ── Register ── */
window.doRegister = async function() {
  var name  = ($('r-name').value  || '').trim();
  var phone = ($('r-phone').value || '').trim();
  var pass  = ($('r-pass').value  || '').trim();
  var city  = $('r-city').value;
  var btn   = $('btn-register');

  var ok = true;
  clearFieldErr('err-r-name');
  clearFieldErr('err-r-phone');
  clearFieldErr('err-r-pass');
  showErr('err-register', '');

  var nameMsg = vName(name);
  if (nameMsg) { fieldErr('err-r-name', nameMsg); ok = false; }
  var pLocal = canonLocal(phone);
  if (!pLocal) {
    fieldErr('err-r-phone', 'رقم جوال مصري صحيح: 11 رقماً يبدأ بـ 010/011/012/015'); ok = false;
  }
  var passMsg = vPass(pass);
  if (passMsg) { fieldErr('err-r-pass', passMsg); ok = false; }
  if (!ok) return;

  var phone14 = pLocal;
  btn.disabled = true;
  btn.innerHTML = '<span style="display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite"></span> جاري التحقق…';

  var timeout = function(ms) {
    return new Promise(function(_, rej) { setTimeout(function(){ rej(new Error('انتهت مهلة الاتصال')); }, ms); });
  };

  try {
    // Check existing account
    var checkRes = await Promise.race([
      fetch(SB_URL + '/rest/v1/rpc/lookup_account', {
        method: 'POST', headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json' }),
        body: JSON.stringify({ p_phone: phone14 }),
      }),
      timeout(10000)
    ]);
    var existing = checkRes.ok ? await checkRes.json() : [];

    if (Array.isArray(existing) && existing.length > 0) {
      var acc = existing[0];
      if (acc.role === 'driver') {
        localStorage.setItem('wslha_user', JSON.stringify({ phone: acc.phone, name: acc.name || name, role: 'driver', status: acc.status || 'pending', city: acc.city || city, avatar: dAvatar(acc.name || name) }));
        window.location.href = '/driver-dashboard';
        return;
      }
      // Upgrade to driver
      await Promise.race([
        fetch(SB_URL + '/rest/v1/accounts?phone=eq.' + encodeURIComponent(acc.phone), {
          method: 'PATCH',
          headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
          body: JSON.stringify({ role: 'driver', status: 'pending' }),
        }),
        timeout(10000)
      ]);
      USER = { phone: acc.phone, name: acc.name || name, role: 'driver', status: 'pending', city: acc.city || city };
    } else {
      // Create new account
      var createRes = await Promise.race([
        fetch(SB_URL + '/rest/v1/accounts', {
          method: 'POST',
          headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
          body: JSON.stringify({ id: crypto.randomUUID(), phone: phone14, name: name, password: pass, role: 'driver', status: 'pending', city: city }),
        }),
        timeout(10000)
      ]);
      if (!createRes.ok) {
        var d = '';
        try { var j = await createRes.json(); d = j.message || j.hint || j.details || ''; } catch { d = await createRes.text().catch(function(){ return ''; }); }
        throw new Error('فشل إنشاء الحساب (' + createRes.status + '): ' + d);
      }
      USER = { phone: phone14, name: name, role: 'driver', status: 'pending', city: city };
    }

    if (!USER.avatar) USER.avatar = dAvatar(USER.name);
    localStorage.setItem('wslha_user', JSON.stringify(USER));

    // Create preliminary application record
    var existingApp = await getApp(USER.phone);
    if (!existingApp) {
      await Promise.race([
        fetch(SB_URL + '/rest/v1/driver_applications', {
          method: 'POST',
          headers: Object.assign({}, SB_H, { 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
          body: JSON.stringify({ id: crypto.randomUUID(), phone: USER.phone, full_name: USER.name, status: 'pending', created_at: new Date().toISOString() }),
        }),
        timeout(8000)
      ]).catch(function(){});
    }

    showProgressBar();
    prefillUser();
    setPanel(1);

  } catch(e) {
    showErr('err-register', '❌ ' + (e.message || 'حدث خطأ. تحقق من الاتصال وحاول مجدداً.'));
    btn.disabled = false;
    btn.innerHTML = 'التالي — البيانات الشخصية <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
  }
};

async function getApp(phone) {
  try {
    var r = await fetch(SB_URL + '/rest/v1/driver_applications?' + orFilter(phone) + '&select=id&limit=1', { headers: SB_H });
    var d = r.ok ? await r.json() : [];
    return Array.isArray(d) && d.length > 0 ? d[0] : null;
  } catch { return null; }
}

/* ── File uploads ── */
window.handleUpload = async function(input, key, zoneId) {
  var file = input.files[0];
  if (!file) return;
  var zone   = $(zoneId);
  var prev   = $('prev-' + key);
  var status = $('status-' + key);

  // Preview
  var reader = new FileReader();
  reader.onload = function(e) {
    if (prev) { prev.src = e.target.result; prev.style.display = 'block'; }
  };
  reader.readAsDataURL(file);

  if (status) { status.textContent = '⏳ جاري الرفع…'; status.style.color = 'var(--color-text-muted)'; }
  if (zone)   { zone.style.borderColor = 'var(--color-primary)'; }

  var ext  = (file.name.split('.').pop() || 'jpg').toLowerCase();
  var path = 'driver-apps/' + (USER && USER.phone || 'anon') + '/' + key + '-' + Date.now() + '.' + ext;

  try {
    var res = await fetch(SB_URL + '/storage/v1/object/documents/' + path, {
      method: 'POST',
      headers: { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY, 'Content-Type': file.type || 'image/jpeg' },
      body: file,
    });
    if (res.ok) {
      uploads[key] = SB_URL + '/storage/v1/object/public/documents/' + path;
      if (status) { status.textContent = '✅ تم الرفع بنجاح'; status.style.color = '#16A34A'; }
      if (zone)   { zone.classList.add('has-file'); }
    } else {
      uploads[key] = URL.createObjectURL(file);
      if (status) { status.textContent = '📎 ' + file.name; status.style.color = 'var(--color-text-muted)'; }
      if (zone)   { zone.classList.add('has-file'); }
    }
  } catch {
    uploads[key] = URL.createObjectURL(file);
    if (status) { status.textContent = '📎 ' + file.name; status.style.color = 'var(--color-text-muted)'; }
    if (zone)   { zone.classList.add('has-file'); }
  }
};

/* ── Radio pills ── */
document.querySelectorAll('.radio-row').forEach(function(row) {
  row.querySelectorAll('.radio-pill').forEach(function(pill) {
    pill.addEventListener('click', function() {
      var isGreen = row.id === 'grp-drugs';
      row.querySelectorAll('.radio-pill').forEach(function(p) { p.classList.remove('sel', 'sel-green'); });
      pill.classList.add(isGreen && pill.dataset.v === 'no' ? 'sel-green' : 'sel');
      pill.querySelector('input').checked = true;
    });
