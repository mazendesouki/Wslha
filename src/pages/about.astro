---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';

const ICONS = {
  bolt:   `<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>`,
  shake:  `<path d="M8 12 3 7l2-2 5 5"/><path d="M16 12l5-5-2-2-5 5"/><path d="M8 12l3 3a2 2 0 0 0 3 0l3-3"/><path d="m11 15-2 2a1.5 1.5 0 0 1-2-2l4-4"/>`,
  shield: `<path d="M12 3 5 6v6c0 4.6 3 8 7 9 4-1 7-4.4 7-9V6l-7-3z"/><path d="m9 12 2 2 4-4"/>`,
  chat:   `<path d="M4 5h16v11H8l-4 4V5z"/><path d="M8 9h8M8 12.5h5"/>`,
  // ── How-it-works step icons ──
  tap:    `<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10 18h4"/><path d="M12 6v4l2.5 1.5" stroke-width="1.5"/>`,
  route:  `<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8 7c3 0 3 4 6 4s3-4 6-4" stroke-dasharray="2 2.4"/>`,
  box:    `<path d="M3 8 12 3l9 5-9 5-9-5z"/><path d="M3 8v9l9 5 9-5V8"/><path d="M12 13v9"/>`,
  // ── Service icons ──
  car:    `<path d="M4 16V11l2-5h12l2 5v5"/><path d="M4 16h16"/><circle cx="7.5" cy="16.5" r="1.5"/><circle cx="16.5" cy="16.5" r="1.5"/><path d="M6 11h12"/>`,
  bag:    `<path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>`,
  cart:   `<circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/>`,
};

interface Step { icon: string; title: string; desc: string; }
const STEPS: Step[] = [
  { icon: ICONS.tap,   title: 'اطلب من التطبيق',        desc: 'اختر مشوارك أو منتجك من التطبيق أو الموقع في ثوانٍ، وأكّد الطلب.'      },
  { icon: ICONS.route, title: 'السائق أو المندوب في الطريق', desc: 'تابع موقعه لحظياً على الخريطة من لحظة القبول حتى الوصول إليك.' },
  { icon: ICONS.box,   title: 'استلم طلبك',              desc: 'استلم طلبك أو اوصل لوجهتك، وقيّم تجربتك لمساعدتنا على التحسين.'        },
];

interface Service { icon: string; title: string; desc: string; href: string; }
const SERVICES: Service[] = [
  { icon: ICONS.car,  title: 'المشاوير',              desc: 'مشاوير داخل دمياط الجديدة وخارج المحافظة، وتوصيل من وإلى المطار.', href: '/services' },
  { icon: ICONS.bag,  title: 'توصيل من المتاجر',       desc: 'اطلب من مطاعمك وصيدلياتك ومتاجرك المفضّلة، ويوصلها المندوب لباب بيتك.', href: '/stores'   },
  { icon: ICONS.cart, title: 'السوق الإلكتروني',        desc: 'بيع واشترِ منتجات مستعملة من داخل دمياط بسهولة وأمان.',              href: '/marketplace' },
];

interface Value { icon: string; title: string; desc: string; }
const VALUES: Value[] = [
  { icon: ICONS.bolt,   title: 'السرعة',      desc: 'نلتزم بأسرع أوقات التوصيل دون التنازل عن الجودة.'      },
  { icon: ICONS.shake,  title: 'الثقة',       desc: 'نبني علاقة طويلة الأمد مع عملائنا قائمة على الشفافية.' },
  { icon: ICONS.shield, title: 'الأمان',      desc: 'كل شحنة مؤمّنة بالكامل من لحظة الاستلام حتى التسليم.'  },
  { icon: ICONS.chat,   title: 'خدمة العميل', desc: 'فريق دعم متاح 24/7 يضع رضاك في المقام الأول.'          },
];

interface Milestone { year: string; title: string; desc: string; }
const MILESTONES: Milestone[] = [
  { year: '2026', title: 'انطلاق وصّلها',    desc: 'بدأنا رحلتنا بخدمة التوصيل المحلي في دمياط الجديدة.'   },
  { year: '2026', title: 'توصيل المطار',     desc: 'أضفنا خدمة التوصيل من وإلى مطار برج العرب باحترافية.'  },
  { year: '2026', title: 'المتاجر الشريكة',  desc: 'توسّعنا بشراكات مع المتاجر والمطاعم في دمياط.'         },
  { year: '2027', title: 'التوسّع التدريجي', desc: 'نخطط للوصول إلى مناطق جديدة وتقديم خدمات أوسع.'        },
];

const STATS = [
  { value: '+500', label: 'عميل سعيد'      },
  { value: '30 د',  label: 'متوسط التوصيل' },
  { value: '24/7',  label: 'خدمة متاحة'    },
  { value: '99%',   label: 'نسبة الرضا'    },
];
---

<style>
  /* ── Story ───────────────────────────────────────────────── */
  .story { background: var(--color-bg); }
  .services { background: var(--color-bg); }

  .story__inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    align-items: center;
  }

  .story__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    margin-bottom: var(--sp-5);
    line-height: 1.2;
    color: var(--color-text);
  }

  .story__text {
    color: var(--color-text-muted);
    line-height: 1.9;
    font-size: var(--text-base);
    margin-bottom: var(--sp-4);
  }

  .story__visual {
    background: var(--color-primary-light);
    border-radius: var(--radius-2xl);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-10);
  }

  .story__visual svg {
    width: 100%;
    height: 100%;
    max-width: 320px;
    max-height: 320px;
  }

  /* ── Stats band ──────────────────────────────────────────── */
  .stats-band {
    background: var(--color-primary-dark);
    padding: var(--sp-12) var(--sp-6);
  }

  .stats-band__grid {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    text-align: center;
  }

  .stats-band__grid > div { border-inline-start: 1px solid rgba(255,255,255,0.15); }
  .stats-band__grid > div:first-child { border-inline-start: none; }

  .stats-band__value { font-family: var(--font-display); font-size: var(--text-4xl); font-weight: 800; color: #fff; line-height: 1; margin-bottom: var(--sp-2); }
  .stats-band__label { color: rgba(255,255,255,0.75); font-size: var(--text-sm); font-weight: var(--weight-semi); }

  /* ── How it works (illustrated steps) ───────────────────────── */
  .how { background: var(--color-bg-soft); }

  .how__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-8);
    max-width: var(--container);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    counter-reset: how-step;
  }

  .how-step {
    position: relative;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--sp-8) var(--sp-6);
    text-align: center;
  }

  .how-step::before {
    counter-increment: how-step;
    content: counter(how-step);
    position: absolute;
    top: var(--sp-4);
    inset-inline-start: var(--sp-5);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-sm);
    color: var(--color-primary);
    opacity: .5;
  }

  .how-step__icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--sp-5);
  }
  .how-step__icon svg { width: 30px; height: 30px; }

  .how-step__title { font-size: var(--text-lg); font-weight: var(--weight-black); margin-bottom: var(--sp-2); }
  .how-step__desc  { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; }

  /* ── Services showcase ───────────────────────────────────────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-6);
    max-width: var(--container);
    margin: 0 auto;
  }

  .service-card {
    display: block;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--sp-8);
    text-decoration: none;
    transition: border-color var(--ease), box-shadow var(--ease), transform var(--ease);
  }

  .service-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-primary);
    transform: translateY(-3px);
  }

  .service-card__icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sp-5);
  }
  .service-card__icon svg { width: 26px; height: 26px; }

  .service-card__title { font-size: var(--text-lg); font-weight: var(--weight-black); color: var(--color-text); margin-bottom: var(--sp-2); }
  .service-card__desc  { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; margin-bottom: var(--sp-4); }
  .service-card__link  { font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--color-primary); }

  /* ── Values ──────────────────────────────────────────────── */
  .values { background: var(--color-bg-soft); }

  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-6);
  }

  .value-card {
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--sp-8);
    border: 1.5px solid var(--color-border);
    text-align: center;
    transition: border-color var(--ease), box-shadow var(--ease), transform var(--ease);
  }

  .value-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-primary);
    transform: translateY(-3px);
  }

  .value-card__icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--sp-4);
  }
  .value-card__icon svg { width: 26px; height: 26px; }

  .value-card__title { font-size: var(--text-lg); font-weight: var(--weight-black); margin-bottom: var(--sp-2); }
  .value-card__desc  { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; }

  /* ── Timeline ────────────────────────────────────────────── */
  .journey { background: var(--color-bg); }

  .journey__list {
    max-width: 720px;
    margin: 0 auto;
    position: relative;
    padding-right: var(--sp-10);
    list-style: none;
  }

  .journey__list::before {
    content: '';
    position: absolute;
    right: 11px;
    top: var(--sp-2);
    bottom: var(--sp-2);
    width: 2px;
    background: var(--color-border);
  }

  .journey__item {
    position: relative;
    margin-bottom: var(--sp-8);
  }

  .journey__item:last-child { margin-bottom: 0; }

  .journey__dot {
    position: absolute;
    right: calc(-1 * var(--sp-10));
    top: 2px;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    border: 4px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-primary);
  }

  .journey__year {
    display: inline-block;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    padding: 2px var(--sp-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--sp-2);
  }

  .journey__title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--sp-1); }
  .journey__desc  { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; }

  /* ── CTA ─────────────────────────────────────────────────── */
  .about-cta {
    background: var(--color-primary-light);
    padding: var(--sp-20) var(--sp-6);
    text-align: center;
  }

  .about-cta__title { font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 800; margin-bottom: var(--sp-4); }
  .about-cta__desc  { color: var(--color-text-muted); font-size: var(--text-base); margin-bottom: var(--sp-8); }

  .about-cta__actions { display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 900px) {
    .story__inner      { grid-template-columns: 1fr; gap: var(--sp-10); }
    .story__visual     { order: -1; }
    .how__grid         { grid-template-columns: 1fr; }
    .services-grid     { grid-template-columns: 1fr; }
    .values__grid      { grid-template-columns: 1fr 1fr; }
    .stats-band__grid  { grid-template-columns: repeat(2, 1fr); gap: var(--sp-8); }
    .stats-band__grid > div:nth-child(3) { border-inline-start: none; }
  }

  @media (max-width: 560px) {
    .values__grid { grid-template-columns: 1fr; }
  }
</style>

<Layout
  title="من نحن"
  description="تعرّف على وصّلها — قصتنا، قيمنا، ورحلتنا في تقديم خدمة توصيل سريعة وموثوقة"
  page="about"
>
  <PageHero
    badge="من نحن"
    title="نوصّلها لك بثقة"
    subtitle="نحن فريق شغوف بتقديم أسرع وأكثر خدمات التوصيل موثوقية"
  />

  <!-- Story -->
  <section class="section story" aria-labelledby="story-title">
    <div class="story__inner">
      <div>
        <h2 class="story__title" id="story-title">قصتنا</h2>
        <p class="story__text">
          بدأت <strong>وصّلها</strong> من فكرة بسيطة: أن يحصل كل شخص في دمياط الجديدة
          على ما يحتاجه — مشوار، طلب من متجره المفضّل، أو حتى منتج مستعمل — في مكان
          واحد وبثقة، دون أن يغادر منزله. لاحظنا التحدي اليومي في التنقل والتوصيل
          بسرعة وأمان، فقررنا أن نبني منصة واحدة تجمعهم كلهم.
        </p>
        <p class="story__text">
          اليوم، نربط بين عملاء دمياط والسائقين والمتاجر عبر شبكة مندوبين محترفين
          ونظام تتبع لحظي — من المشوار، للتوصيل من المتجر، للسوق الإلكتروني —
          كل محطة في رحلتك اليومية معنا.
        </p>
      </div>
      <div class="story__visual" role="img" aria-label="خريطة توضح خدمات وصّلها الثلاث: المشاوير، والتوصيل من المتاجر، والسوق الإلكتروني">
        <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M55 55 C 75 100, 165 95, 185 185" stroke="#C9DEDC" stroke-width="4" stroke-linecap="round" stroke-dasharray="2 11"/>

          <!-- origin pin -->
          <g transform="translate(55,55)">
            <circle r="11" fill="#0E4B49"/>
            <circle r="4.5" fill="#fff"/>
          </g>

          <!-- ride stop -->
          <g transform="translate(100,85)">
            <circle r="26" fill="#F2F7F6" stroke="#0E4B49" stroke-width="2.5"/>
            <g transform="translate(-13,-9)" stroke="#0E4B49" stroke-width="1.9" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 16V11l2-5h12l2 5v5"/>
              <path d="M4 16h16"/>
              <path d="M6 11h12"/>
              <circle cx="7.5" cy="16.5" r="1.6" fill="#0E4B49" stroke="none"/>
              <circle cx="16.5" cy="16.5" r="1.6" fill="#0E4B49" stroke="none"/>
            </g>
          </g>

          <!-- delivery-box stop -->
          <g transform="translate(155,120)">
            <circle r="26" fill="#E3EDEC" stroke="#0E4B49" stroke-width="2.5"/>
            <g transform="translate(-13,-13)" stroke="#0E4B49" stroke-width="1.9" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 8 12 3l9 5-9 5-9-5z"/>
              <path d="M3 8v9l9 5 9-5V8"/>
              <path d="M12 13v9"/>
            </g>
          </g>

          <!-- marketplace-bag stop -->
          <g transform="translate(175,168)">
            <circle r="26" fill="#F8FBFA" stroke="#0E4B49" stroke-width="2.5"/>
            <g transform="translate(-11,-13)" stroke="#0E4B49" stroke-width="1.9" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8h12l1 12H5L6 8z"/>
              <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
            </g>
          </g>

          <!-- destination pin -->
          <g transform="translate(185,185)">
            <path d="M0 -17 C10 -17 17 -10 17 0 C17 12 0 26 0 26 C0 26 -17 12 -17 0 C-17 -10 -10 -17 0 -17Z" fill="#B8863B"/>
            <circle r="5.5" fill="#fff"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section how" aria-labelledby="how-title">
    <div class="container">
      <SectionHeader badge="كيف تعمل" title="من الطلب إلى الاستلام" subtitle="ثلاث خطوات بسيطة لأي خدمة على وصّلها" id="how-title" />
      <ol class="how__grid" role="list">
        {STEPS.map(s => (
          <li class="how-step">
            <div class="how-step__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </div>
            <h3 class="how-step__title">{s.title}</h3>
            <p class="how-step__desc">{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Services -->
  <section class="section services" aria-labelledby="services-title">
    <div class="container">
      <SectionHeader badge="خدماتنا" title="كل احتياجاتك في مكان واحد" subtitle="من المشاوير للتوصيل للسوق الإلكتروني — كله جوّه وصّلها" id="services-title" />
      <div class="services-grid">
        {SERVICES.map(s => (
          <a class="service-card" href={s.href}>
            <div class="service-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </div>
            <h3 class="service-card__title">{s.title}</h3>
            <p class="service-card__desc">{s.desc}</p>
            <span class="service-card__link">تصفّح الخدمة ←</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-band" aria-label="إنجازاتنا بالأرقام">
    <dl class="stats-band__grid">
      {STATS.map(s => (
        <div>
          <dt class="sr-only">{s.label}</dt>
          <dd class="stats-band__value" aria-label={`${s.value} — ${s.label}`}>{s.value}</dd>
          <p class="stats-band__label" aria-hidden="true">{s.label}</p>
        </div>
      ))}
    </dl>
  </section>

  <!-- Values -->
  <section class="section values" aria-labelledby="values-title">
    <div class="container">
      <SectionHeader badge="قيمنا" title="ما الذي يحرّكنا" subtitle="مبادئ نلتزم بها في كل توصيلة" id="values-title" />
      <ul class="values__grid" role="list">
        {VALUES.map(v => (
          <li class="value-card">
            <div class="value-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={v.icon} />
            </div>
            <h3 class="value-card__title">{v.title}</h3>
            <p class="value-card__desc">{v.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Journey -->
  <section class="section journey" aria-labelledby="journey-title">
    <div class="container">
      <SectionHeader badge="رحلتنا" title="محطات رئيسية على طول الطريق" subtitle="من هذا العام إلى التوسع التدريجي" id="journey-title" />
      <ol class="journey__list">
        {MILESTONES.map(m => (
          <li class="journey__item">
            <div class="journey__dot" aria-hidden="true"></div>
            <span class="journey__year">{m.year}</span>
            <h3 class="journey__title">{m.title}</h3>
            <p class="journey__desc">{m.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta" aria-labelledby="about-cta-title">
    <h2 class="about-cta__title" id="about-cta-title">جاهز لتجربة وصّلها؟</h2>
    <p class="about-cta__desc">اطلب أول توصيلة لك اليوم واكتشف الفرق</p>
    <div class="about-cta__actions">
      <a href="/register" id="about-cta-order" class="btn btn--accent">اطلب الآن</a>
      <a href="/contact" class="btn btn--outline">تواصل معنا</a>
    </div>
  </section>
</Layout>

<script>
  // "اطلب الآن" sends a logged-in user straight to رحلات (rides), and an
  // anonymous visitor to التسجيل first — no store browsing detour.
  try {
    const user = JSON.parse(localStorage.getItem('wslha_user') || 'null');
    const link = document.getElementById('about-cta-order') as HTMLAnchorElement | null;
    if (link) link.href = user?.phone ? '/rides' : '/register';
  } catch {}
</script>
