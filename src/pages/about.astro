---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';

interface Value {
  icon: string;
  title: string;
  desc: string;
}

const VALUES: Value[] = [
  { icon: '⚡', title: 'السرعة',     desc: 'نلتزم بأسرع أوقات التوصيل دون التنازل عن الجودة.'        },
  { icon: '🤝', title: 'الثقة',      desc: 'نبني علاقة طويلة الأمد مع عملائنا قائمة على الشفافية.'   },
  { icon: '🛡️', title: 'الأمان',     desc: 'كل شحنة مؤمّنة بالكامل من لحظة الاستلام حتى التسليم.'   },
  { icon: '💙', title: 'خدمة العميل', desc: 'فريق دعم متاح 24/7 يضع رضاك في المقام الأول.'           },
];

interface Milestone {
  year: string;
  title: string;
  desc: string;
}

const MILESTONES: Milestone[] = [
  { year: '2024', title: 'انطلاق وصّلها',      desc: 'بدأنا رحلتنا بخدمة التوصيل المحلي في دمياط الجديدة.' },
  { year: '2024', title: 'توصيل المطار',       desc: 'أضفنا خدمة التوصيل من وإلى مطار برج العرب باحترافية.' },
  { year: '2024', title: 'المتاجر الشريكة',    desc: 'توسّعنا بشراكات مع مئات المتاجر والمطاعم في دمياط.'  },
  { year: '2025', title: 'التوسّع المحافظاتي', desc: 'نخطط للوصول إلى محافظات جديدة وخدمات أوسع.'          },
];

const STATS = [
  { value: '+500',  label: 'عميل سعيد'      },
  { value: '30 د',  label: 'متوسط التوصيل' },
  { value: '24/7',  label: 'خدمة متاحة'     },
  { value: '99%',   label: 'نسبة الرضا'    },
];
---

<style>
  /* ── Story ───────────────────────────────────────────────── */
  .story { background: var(--color-bg); }

  .story__inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    align-items: center;
  }

  .story__title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    margin-bottom: var(--sp-5);
    line-height: 1.2;
    color: var(--color-text);
  }

  .story__text {
    color: var(--color-text-muted);
    line-height: 1.9;
    font-size: var(--text-base);
    margin-bottom: var(--sp-4);
  }

  .story__visual {
    background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
    border-radius: var(--radius-2xl);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-10);
  }

  .story__visual svg {
    width: 100%;
    height: 100%;
    max-width: 320px;
    max-height: 320px;
  }

  /* ── Stats band ──────────────────────────────────────────── */
  .stats-band {
    background: var(--color-primary);
    padding: var(--sp-12) var(--sp-6);
  }

  .stats-band__grid {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
    text-align: center;
  }

  .stats-band__value { font-size: var(--text-4xl); font-weight: var(--weight-black); color: #fff; line-height: 1; margin-bottom: var(--sp-2); }
  .stats-band__label { color: rgba(255,255,255,0.8); font-size: var(--text-sm); font-weight: var(--weight-semi); }

  /* ── Values ──────────────────────────────────────────────── */
  .values { background: var(--color-bg-soft); }

  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-6);
  }

  .value-card {
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--sp-8);
    border: 1.5px solid var(--color-border);
    text-align: center;
    transition: border-color var(--ease), box-shadow var(--ease), transform var(--ease);
  }

  .value-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-primary);
    transform: translateY(-3px);
  }

  .value-card__icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-2xl);
    margin: 0 auto var(--sp-4);
  }

  .value-card__title { font-size: var(--text-lg); font-weight: var(--weight-black); margin-bottom: var(--sp-2); }
  .value-card__desc  { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; }

  /* ── Timeline ────────────────────────────────────────────── */
  .journey { background: var(--color-bg); }

  .journey__list {
    max-width: 720px;
    margin: 0 auto;
    position: relative;
    padding-right: var(--sp-10);
    list-style: none;
  }

  .journey__list::before {
    content: '';
    position: absolute;
    right: 11px;
    top: var(--sp-2);
    bottom: var(--sp-2);
    width: 2px;
    background: var(--color-border);
  }

  .journey__item {
    position: relative;
    margin-bottom: var(--sp-8);
  }

  .journey__item:last-child { margin-bottom: 0; }

  .journey__dot {
    position: absolute;
    right: calc(-1 * var(--sp-10));
    top: 2px;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    border: 4px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-primary);
  }

  .journey__year {
    display: inline-block;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    padding: 2px var(--sp-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--sp-2);
  }

  .journey__title { font-size: var(--text-lg); font-weight: var(--weight-black); margin-bottom: var(--sp-1); }
  .journey__desc  { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; }

  /* ── CTA ─────────────────────────────────────────────────── */
  .about-cta {
    background: var(--color-primary-light);
    padding: var(--sp-20) var(--sp-6);
    text-align: center;
  }

  .about-cta__title { font-size: var(--text-3xl); font-weight: var(--weight-black); margin-bottom: var(--sp-4); }
  .about-cta__desc  { color: var(--color-text-muted); font-size: var(--text-base); margin-bottom: var(--sp-8); }

  .about-cta__actions { display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 900px) {
    .story__inner      { grid-template-columns: 1fr; gap: var(--sp-10); }
    .story__visual     { order: -1; }
    .values__grid      { grid-template-columns: 1fr 1fr; }
    .stats-band__grid  { grid-template-columns: repeat(2, 1fr); gap: var(--sp-8); }
  }

  @media (max-width: 560px) {
    .values__grid { grid-template-columns: 1fr; }
  }
</style>

<Layout
  title="من نحن"
  description="تعرّف على وصّلها — قصتنا، قيمنا، ورحلتنا في تقديم خدمة توصيل سريعة وموثوقة"
  page="about"
>
  <PageHero
    badge="🏢 من نحن"
    title="نوصّلها لك بثقة"
    subtitle="نحن فريق شغوف بتقديم أسرع وأكثر خدمات التوصيل موثوقية"
  />

  <!-- Story -->
  <section class="section story" aria-labelledby="story-title">
    <div class="story__inner">
      <div>
        <h2 class="story__title" id="story-title">قصتنا</h2>
        <p class="story__text">
          بدأت <strong>وصّلها</strong> من فكرة بسيطة: أن يحصل كل شخص في دمياط الجديدة
          على ما يريد، من أي متجر، دون أن يغادر منزله. لاحظنا التحدي اليومي في
          إيصال الطلبات بسرعة وأمان، فقررنا أن نبني حلاً يجمع بين التقنية والخدمة.
        </p>
        <p class="story__text">
          اليوم، نربط بين عملاء دمياط والمتاجر والمطار عبر شبكة مندوبين محترفين
          ونظام تتبع لحظي، لنوصّل أكثر من مجرد طرود — نوصّل الثقة والراحة.
        </p>
      </div>
      <div class="story__visual" role="img" aria-label="صندوق توصيل">
        <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Box body -->
          <path d="M40 90 L120 60 L200 90 L200 180 L120 210 L40 180 Z" fill="#E8F0FE" stroke="#93C5FD" stroke-width="2.5" stroke-linejoin="round"/>
          <!-- Box top left face -->
          <path d="M40 90 L120 120 L120 210 L40 180 Z" fill="#BFDBFE" stroke="#93C5FD" stroke-width="2.5" stroke-linejoin="round"/>
          <!-- Box top right face -->
          <path d="M200 90 L120 120 L120 210 L200 180 Z" fill="#DBEAFE" stroke="#93C5FD" stroke-width="2.5" stroke-linejoin="round"/>
          <!-- Box top face -->
          <path d="M40 90 L120 60 L200 90 L120 120 Z" fill="#EFF6FF" stroke="#93C5FD" stroke-width="2.5" stroke-linejoin="round"/>
          <!-- Tape strip on top -->
          <path d="M90 75 L150 105" stroke="#93C5FD" stroke-width="5" stroke-linecap="round"/>
          <!-- Up arrow left -->
          <g transform="translate(62, 120)">
            <line x1="0" y1="30" x2="0" y2="5" stroke="#3B82F6" stroke-width="3" stroke-linecap="round"/>
            <polyline points="-8,14 0,4 8,14" fill="none" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
          <!-- Up arrow left 2 -->
          <g transform="translate(82, 128)">
            <line x1="0" y1="30" x2="0" y2="5" stroke="#3B82F6" stroke-width="3" stroke-linecap="round"/>
            <polyline points="-8,14 0,4 8,14" fill="none" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
          <!-- Up arrow right -->
          <g transform="translate(155, 120)">
            <line x1="0" y1="30" x2="0" y2="5" stroke="#3B82F6" stroke-width="3" stroke-linecap="round"/>
            <polyline points="-8,14 0,4 8,14" fill="none" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
          <!-- Up arrow right 2 -->
          <g transform="translate(175, 128)">
            <line x1="0" y1="30" x2="0" y2="5" stroke="#3B82F6" stroke-width="3" stroke-linecap="round"/>
            <polyline points="-8,14 0,4 8,14" fill="none" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
          <!-- Label on right face -->
          <rect x="133" y="138" width="44" height="28" rx="3" fill="white" stroke="#BFDBFE" stroke-width="1.5"/>
          <line x1="139" y1="147" x2="171" y2="147" stroke="#BFDBFE" stroke-width="1.5"/>
          <line x1="139" y1="153" x2="165" y2="153" stroke="#BFDBFE" stroke-width="1.5"/>
          <line x1="139" y1="159" x2="168" y2="159" stroke="#BFDBFE" stroke-width="1.5"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-band" aria-label="إنجازاتنا بالأرقام">
    <dl class="stats-band__grid">
      {STATS.map(s => (
        <div>
          <dt class="sr-only">{s.label}</dt>
          <dd class="stats-band__value" aria-label={`${s.value} — ${s.label}`}>{s.value}</dd>
          <p class="stats-band__label" aria-hidden="true">{s.label}</p>
        </div>
      ))}
    </dl>
  </section>

  <!-- Values -->
  <section class="section values" aria-labelledby="values-title">
    <div class="container">
      <SectionHeader badge="قيمنا" title="ما الذي يحرّكنا" subtitle="مبادئ نلتزم بها في كل توصيلة" id="values-title" />
      <ul class="values__grid" role="list">
        {VALUES.map(v => (
          <li class="value-card">
            <div class="value-card__icon" aria-hidden="true">{v.icon}</div>
            <h3 class="value-card__title">{v.title}</h3>
            <p class="value-card__desc">{v.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Journey -->
  <section class="section journey" aria-labelledby="journey-title">
    <div class="container">
      <SectionHeader badge="رحلتنا" title="محطات في طريقنا" subtitle="من البداية وحتى اليوم" id="journey-title" />
      <ol class="journey__list">
        {MILESTONES.map(m => (
          <li class="journey__item">
            <div class="journey__dot" aria-hidden="true"></div>
            <span class="journey__year">{m.year}</span>
            <h3 class="journey__title">{m.title}</h3>
            <p class="journey__desc">{m.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta" aria-labelledby="about-cta-title">
    <h2 class="about-cta__title" id="about-cta-title">جاهز لتجربة وصّلها؟</h2>
    <p class="about-cta__desc">اطلب أول توصيلة لك اليوم واكتشف الفرق</p>
    <div class="about-cta__actions">
      <a href="/order"   class="btn btn--accent">🛵 اطلب الآن</a>
      <a href="/contact" class="btn btn--outline">تواصل معنا</a>
    </div>
  </section>
</Layout>
