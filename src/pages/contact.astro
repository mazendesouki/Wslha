---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';

interface ContactCard {
  icon: string;
  label: string;
  value: string;
  href: string;
}

const ICONS = {
  phone: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81 19.79 19.79 0 0 1 0 1.18 2 2 0 0 1 2 -1h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L6.09 7.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" transform="translate(0 3)"/>`,
  chat:  `<path d="M4 5h16v11H8l-4 4V5z"/><path d="M8 9h8M8 12.5h5"/>`,
  mail:  `<path d="M4 4h16v16H4z"/><path d="m4 6 8 7 8-7"/>`,
  pin:   `<path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>`,
};

const CONTACT_CARDS: ContactCard[] = [
  { icon: ICONS.phone, label: 'اتصل بنا',           value: '0020 1102 667324',  href: 'tel:+201102667324'          },
  { icon: ICONS.chat,  label: 'واتساب',              value: '0020 1102 667324',  href: 'https://wa.me/201102667324' },
  { icon: ICONS.mail,  label: 'البريد الإلكتروني',  value: 'info@wslha.co',     href: 'mailto:info@wslha.co'       },
  { icon: ICONS.pin,   label: 'الموقع',              value: 'دمياط الجديدة، مصر',    href: '#'                       },
];

interface WorkHours {
  days: string;
  hours: string;
}

const WORK_HOURS: WorkHours[] = [
  { days: 'الأحد – الخميس', hours: '8 ص – 10 م'   },
  { days: 'الجمعة',          hours: '2 م – 9 م'    },
  { days: 'السبت',           hours: '9 ص – 9 م'    },
  { days: 'دعم طارئ',       hours: '24 / 7'        },
];

const SUBJECTS = [
  'استفسار عن طلب',
  'طلب خدمة توصيل',
  'شراكة تجارية',
  'شكوى',
  'أخرى',
];
---

<style>
  .contact-wrap {
    padding: var(--sp-12) var(--sp-6) var(--sp-20);
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: var(--sp-12);
    align-items: start;
  }

  /* Info column */
  .contact-info { display: flex; flex-direction: column; gap: var(--sp-4); }

  .contact-card {
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-5) var(--sp-6);
    display: flex;
    gap: var(--sp-4);
    align-items: center;
    transition: border-color var(--ease), box-shadow var(--ease);
  }

  .contact-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-primary);
  }

  .contact-card__icon {
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .contact-card__icon svg { width: 22px; height: 22px; }

  .contact-card__label { font-size: var(--text-xs);  color: var(--color-text-faint); font-weight: var(--weight-bold); margin-bottom: 2px; }
  .contact-card__value { font-weight: var(--weight-black); color: var(--color-primary); font-size: var(--text-sm); }

  /* Hours */
  .hours {
    background: var(--color-primary-light);
    border-radius: var(--radius-lg);
    padding: var(--sp-5) var(--sp-6);
    border: 1.5px solid var(--color-border);
  }

  .hours__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    margin-bottom: var(--sp-4);
    color: var(--color-text);
  }

  .hours__row {
    display: flex;
    justify-content: space-between;
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .hours__row:last-child { border-bottom: none; }
  .hours__row strong    { color: var(--color-primary); font-weight: var(--weight-bold); }

  /* Form column */
  .form-box {
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--sp-10);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
  }

  .form-box__title    { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; margin-bottom: var(--sp-1); color: var(--color-text); }
  .form-box__subtitle { color: var(--color-text-muted); font-size: var(--text-sm); margin-bottom: var(--sp-8); }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
  }

  .field { margin-bottom: var(--sp-4); }

  .field__label {
    display: block;
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    margin-bottom: var(--sp-2);
    color: var(--color-text);
  }

  .field__input,
  .field__select,
  .field__textarea {
    width: 100%;
    padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--text-base);
    outline: none;
    transition: border-color var(--ease);
    direction: rtl;
    color: var(--color-text);
    background: var(--color-bg);
  }

  .field__input:focus,
  .field__select:focus,
  .field__textarea:focus { border-color: var(--color-primary); }

  .field__input::placeholder,
  .field__textarea::placeholder { color: var(--color-text-faint); }

  .field__textarea { resize: vertical; min-height: 110px; }

  .form-submit {
    width: 100%;
    padding: var(--sp-4);
    background: var(--color-accent);
    color: var(--color-text);
    border: none;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-weight: var(--weight-black);
    font-size: var(--text-base);
    cursor: pointer;
    transition: background var(--ease), transform var(--ease);
    margin-top: var(--sp-2);
  }

  .form-submit:hover          { background: var(--color-accent-dark); transform: translateY(-1px); }
  .form-submit:focus-visible  { outline: 3px solid var(--color-primary); outline-offset: 3px; }
  .form-submit:disabled       { opacity: 0.6; cursor: not-allowed; transform: none; }

  .form-success {
    display: none;
    background: var(--color-primary-light);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--sp-4) var(--sp-5);
    text-align: center;
    color: var(--color-primary);
    font-weight: var(--weight-bold);
    margin-top: var(--sp-4);
  }

  .form-success.is-visible { display: block; }

  .form-error {
    display: none;
    background: #FEE2E2;
    color: #B91C1C;
    border-radius: var(--radius);
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--text-sm);
    margin-bottom: var(--sp-4);
  }
  .form-error.is-visible { display: block; }

  @media (max-width: 768px) {
    .contact-wrap { grid-template-columns: 1fr; }
    .form-row     { grid-template-columns: 1fr; }
    .form-box     { padding: var(--sp-6); }
  }
</style>

<script>
  import { isEgyptianMobile, EG_PHONE_ERROR } from '../utils/phone';

  /* ── Config ─────────────────────────────────────────────── */
  // Hardcoded like every other page's Supabase client (wallet.astro,
  // courier.astro, etc.) — this used to read PUBLIC_SB_URL/PUBLIC_SB_KEY
  // from env vars, which were never actually set at deploy time, so
  // saveToSupabase() silently no-opped (`if (!SB_URL || !SB_KEY) return`)
  // on every submission while the form still showed a fake success message.
  const SB_URL  = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY  = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H    = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` };

  const EJS_SERVICE  = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID   || '';
  const EJS_TEMPLATE = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID  || '';
  const EJS_REPLY    = import.meta.env.PUBLIC_EMAILJS_REPLY_ID     || '';
  const EJS_KEY      = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY   || '';

  const form     = document.getElementById('contact-form')  as HTMLFormElement;
  const submit   = form.querySelector('.form-submit')        as HTMLButtonElement;
  const success  = document.getElementById('form-success')   as HTMLElement;
  const errorBox = document.getElementById('cf-error')       as HTMLElement;

  /* ── Load EmailJS SDK lazily ────────────────────────────── */
  function loadEmailJS(): Promise<void> {
    return new Promise((resolve) => {
      if ((window as any).emailjs) { resolve(); return; }
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
      s.onload = () => { (window as any).emailjs.init({ publicKey: EJS_KEY }); resolve(); };
      document.head.appendChild(s);
    });
  }

  /* ── Save to Supabase ───────────────────────────────────── */
  async function saveToSupabase(data: Record<string, string>): Promise<void> {
    if (!SB_URL || !SB_KEY) return;
    try {
      await fetch(`${SB_URL}/rest/v1/messages`, {
        method: 'POST',
        headers: { ...SB_H, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify({
          id:         `msg-${Date.now()}`,
          name:       data.name,
          phone:      data.phone,
          email:      data.email || null,
          subject:    data.subject,
          message:    data.message,
          status:     'unread',
          created_at: new Date().toISOString(),
        }),
      });
    } catch { /* non-blocking */ }
  }

  /* ── Submit handler ─────────────────────────────────────── */
  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    errorBox.classList.remove('is-visible');

    const name    = (document.getElementById('cf-name')    as HTMLInputElement).value.trim();
    const phone   = (document.getElementById('cf-phone')   as HTMLInputElement).value.trim();
    const email   = (document.getElementById('cf-email')   as HTMLInputElement).value.trim();
    const subject = (document.getElementById('cf-subject') as HTMLSelectElement).value;
    const message = (document.getElementById('cf-message') as HTMLTextAreaElement).value.trim();

    if (!isEgyptianMobile(phone)) {
      errorBox.textContent = EG_PHONE_ERROR;
      errorBox.classList.add('is-visible');
      (document.getElementById('cf-phone') as HTMLInputElement).focus();
      return;
    }

    submit.disabled = true;
    submit.textContent = '⏳ جاري الإرسال…';

    const params = { name, phone, email, subject, message, to_email: 'info@wslha.co' };

    try {
      /* 1. Save to Supabase (non-blocking) */
      saveToSupabase({ name, phone, email, subject, message });

      /* 2. Send notification email to admin */
      if (EJS_SERVICE && EJS_TEMPLATE && EJS_KEY) {
        await loadEmailJS();
        await (window as any).emailjs.send(EJS_SERVICE, EJS_TEMPLATE, params);

        /* 3. Send auto-reply to user (if they gave an email) */
        if (email && EJS_REPLY) {
          await (window as any).emailjs.send(EJS_SERVICE, EJS_REPLY, {
            ...params, to_email: email,
          });
        }
      }

      form.reset();
      success.classList.add('is-visible');
      success.focus();
    } catch {
      errorBox.textContent = '❌ تعذّر الإرسال. تحقق من اتصالك وحاول مجدداً.';
      errorBox.classList.add('is-visible');
    } finally {
      submit.disabled = false;
      submit.textContent = 'إرسال الرسالة ←';
    }
  });
</script>

<Layout
  title="تواصل معنا"
  description="تواصل مع فريق وصّلها لأي استفسار أو دعم — نحن هنا 24/7"
  page="contact"
>
  <PageHero
    badge="تواصل معنا"
    title="نحن هنا لمساعدتك"
    subtitle="فريق دعمنا متاح 24/7 للإجابة على جميع استفساراتك"
  />

  <div class="contact-wrap">

    <!-- Info -->
    <aside aria-label="معلومات التواصل">
      <div class="contact-info">
        {CONTACT_CARDS.map(card => (
          <a href={card.href} class="contact-card" rel={card.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <div class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </div>
            <div>
              <p class="contact-card__label">{card.label}</p>
              <p class="contact-card__value">{card.value}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="hours" style="margin-top: var(--sp-4)">
        <h2 class="hours__title">ساعات العمل</h2>
        <dl>
          {WORK_HOURS.map(h => (
            <div class="hours__row">
              <dt>{h.days}</dt>
              <dd><strong>{h.hours}</strong></dd>
            </div>
          ))}
        </dl>
      </div>
    </aside>

    <!-- Form -->
    <div class="form-box">
      <h2 class="form-box__title">أرسل لنا رسالة</h2>
      <p class="form-box__subtitle">سنرد عليك في أقرب وقت</p>

      <form id="contact-form" novalidate>
        <div class="form-row">
          <div class="field">
            <label class="field__label" for="cf-name">الاسم الكامل <span aria-hidden="true">*</span></label>
            <input id="cf-name" class="field__input" type="text" placeholder="محمد أحمد" required autocomplete="name">
          </div>
          <div class="field">
            <label class="field__label" for="cf-phone">رقم الجوال <span aria-hidden="true">*</span></label>
            <input id="cf-phone" class="field__input" type="tel" placeholder="010 1234 5678" inputmode="numeric" maxlength="11" pattern="01[0125][0-9]{8}" required autocomplete="tel">
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="cf-email">البريد الإلكتروني</label>
          <input id="cf-email" class="field__input" type="email" placeholder="example@email.com" autocomplete="email">
        </div>

        <div class="field">
          <label class="field__label" for="cf-subject">الموضوع <span aria-hidden="true">*</span></label>
          <select id="cf-subject" class="field__select" required>
            <option value="" disabled selected>اختر الموضوع</option>
            {SUBJECTS.map(s => <option value={s}>{s}</option>)}
          </select>
        </div>

        <div class="field">
          <label class="field__label" for="cf-message">رسالتك <span aria-hidden="true">*</span></label>
          <textarea id="cf-message" class="field__textarea" placeholder="اكتب رسالتك هنا..." required></textarea>
        </div>

        <div id="cf-error" class="form-error" role="alert" aria-live="polite"></div>
        <button type="submit" class="form-submit">إرسال الرسالة ←</button>
      </form>

      <div
        id="form-success"
        class="form-success"
        role="alert"
        aria-live="polite"
        tabindex="-1"
      >
        ✅ تم إرسال رسالتك بنجاح! سنتواصل معك قريباً.
      </div>
    </div>

  </div>
</Layout>
