---
import Layout from '../components/layout.astro';
---

<style>
  .page-hero {
    background: linear-gradient(135deg, #f0fdf4, #dcfce7);
    padding: 4rem 1.5rem 3rem;
    text-align: center;
  }
  .page-hero h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 0.75rem; }
  .page-hero p { color: #64748b; font-size: 1.05rem; }

  .contact-section {
    padding: 4rem 1.5rem 5rem;
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .contact-section { grid-template-columns: 1fr; }
  }

  /* Info side */
  .contact-info { display: flex; flex-direction: column; gap: 1.5rem; }

  .contact-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid #e2e8f0;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    transition: all 0.3s;
  }

  .contact-card:hover {
    border-color: #16a34a;
    box-shadow: 0 4px 20px rgba(22,163,74,0.1);
  }

  .contact-icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    background: #f0fdf4;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .contact-card-title {
    font-weight: 800;
    margin-bottom: 0.25rem;
    font-size: 0.95rem;
  }

  .contact-card-value {
    color: #16a34a;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .contact-card-sub {
    color: #94a3b8;
    font-size: 0.8rem;
    margin-top: 0.15rem;
  }

  .hours-box {
    background: #f0fdf4;
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid #bbf7d0;
  }

  .hours-title {
    font-weight: 800;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hours-row {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-bottom: 1px solid #dcfce7;
    font-size: 0.875rem;
  }

  .hours-row:last-child { border-bottom: none; }
  .hours-row span:last-child { color: #16a34a; font-weight: 700; }

  /* Form side */
  .contact-form-box {
    background: #fff;
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 8px 40px rgba(0,0,0,0.08);
  }

  .contact-form-box h2 {
    font-size: 1.4rem;
    font-weight: 900;
    margin-bottom: 0.5rem;
  }

  .form-subtitle { color: #64748b; font-size: 0.9rem; margin-bottom: 2rem; }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 500px) {
    .form-grid { grid-template-columns: 1fr; }
  }

  .form-group { margin-bottom: 1rem; }
  .form-group.full { grid-column: 1 / -1; }

  .form-label {
    display: block;
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 0.4rem;
    color: #374151;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    font-family: 'Cairo', sans-serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
    direction: rtl;
    color: #1a1a2e;
    background: #fff;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: #16a34a;
  }

  .form-input::placeholder,
  .form-textarea::placeholder { color: #94a3b8; }

  .form-textarea { resize: vertical; min-height: 120px; }

  .submit-btn {
    width: 100%;
    padding: 1rem;
    background: #16a34a;
    color: #fff;
    border: none;
    border-radius: 12px;
    font-family: 'Cairo', sans-serif;
    font-weight: 800;
    font-size: 1.05rem;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 0.5rem;
  }
  .submit-btn:hover { background: #15803d; transform: translateY(-1px); }

  .success-msg {
    display: none;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
    color: #15803d;
    font-weight: 700;
    margin-top: 1rem;
  }

  .success-msg.show { display: block; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.style.opacity = '0.5';
      form.style.pointerEvents = 'none';
      setTimeout(() => {
        form.style.opacity = '1';
        form.style.pointerEvents = 'auto';
        form.reset();
        document.getElementById('successMsg').classList.add('show');
      }, 1200);
    });
  });
</script>

<Layout title="تواصل معنا" description="تواصل مع فريق وصّلها لأي استفسار أو طلب دعم" page="contact">

  <section class="page-hero">
    <div style="display:inline-block; background:rgba(22,163,74,0.12); color:#15803d; font-weight:700; font-size:0.8rem; padding:0.35rem 1rem; border-radius:100px; margin-bottom:1rem;">📞 تواصل معنا</div>
    <h1>نحن هنا لمساعدتك</h1>
    <p>فريق دعمنا متاح 24/7 للإجابة على جميع استفساراتك</p>
  </section>

  <div class="contact-section">
    <!-- Info -->
    <div class="contact-info">
      <div class="contact-card">
        <div class="contact-icon">📞</div>
        <div>
          <div class="contact-card-title">اتصل بنا</div>
          <div class="contact-card-value">920-000-000</div>
          <div class="contact-card-sub">متاح 24 ساعة / 7 أيام</div>
        </div>
      </div>

      <div class="contact-card">
        <div class="contact-icon">💬</div>
        <div>
          <div class="contact-card-title">واتساب</div>
          <div class="contact-card-value">+966 50 000 0000</div>
          <div class="contact-card-sub">رد سريع خلال دقائق</div>
        </div>
      </div>

      <div class="contact-card">
        <div class="contact-icon">✉️</div>
        <div>
          <div class="contact-card-title">البريد الإلكتروني</div>
          <div class="contact-card-value">info@wslha.co</div>
          <div class="contact-card-sub">رد خلال ساعة واحدة</div>
        </div>
      </div>

      <div class="contact-card">
        <div class="contact-icon">📍</div>
        <div>
          <div class="contact-card-title">مقرنا الرئيسي</div>
          <div class="contact-card-value">الرياض، المملكة العربية السعودية</div>
          <div class="contact-card-sub">طريق الملك عبدالله</div>
        </div>
      </div>

      <div class="hours-box">
        <div class="hours-title">🕐 ساعات العمل</div>
        <div class="hours-row">
          <span>الأحد – الخميس</span>
          <span>8 صباحاً – 10 مساءً</span>
        </div>
        <div class="hours-row">
          <span>الجمعة</span>
          <span>2 مساءً – 9 مساءً</span>
        </div>
        <div class="hours-row">
          <span>السبت</span>
          <span>9 صباحاً – 9 مساءً</span>
        </div>
        <div class="hours-row">
          <span>الدعم الطارئ</span>
          <span>24/7</span>
        </div>
      </div>
    </div>

    <!-- Form -->
    <div class="contact-form-box">
      <h2>أرسل لنا رسالة</h2>
      <p class="form-subtitle">سنرد عليك في أقرب وقت ممكن</p>

      <form id="contactForm">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label" for="name">الاسم الكامل</label>
            <input id="name" class="form-input" type="text" placeholder="محمد أحمد" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="phone">رقم الجوال</label>
            <input id="phone" class="form-input" type="tel" placeholder="05X XXX XXXX" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">البريد الإلكتروني</label>
          <input id="email" class="form-input" type="email" placeholder="example@email.com" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="subject">الموضوع</label>
          <select id="subject" class="form-select" required>
            <option value="" disabled selected>اختر الموضوع</option>
            <option value="tracking">استفسار عن شحنة</option>
            <option value="new-order">طلب خدمة جديدة</option>
            <option value="business">حلول الأعمال</option>
            <option value="complaint">تقديم شكوى</option>
            <option value="other">أخرى</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="message">رسالتك</label>
          <textarea
            id="message"
            class="form-textarea"
            placeholder="اكتب رسالتك هنا..."
            required
          ></textarea>
        </div>

        <button type="submit" class="submit-btn">إرسال الرسالة ←</button>
      </form>

      <div class="success-msg" id="successMsg">
        ✅ تم إرسال رسالتك بنجاح! سنتواصل معك قريباً.
      </div>
    </div>
  </div>

</Layout>
