---
import Layout from '../components/layout.astro';
---

<style>
  .page-hero {
    background: #3B6EF8;
    padding: 3.5rem 1.5rem 3rem;
    text-align: center;
    color: #fff;
  }
  .page-hero h1 { font-size: 2.2rem; font-weight: 900; margin-bottom: 0.6rem; }
  .page-hero p { color: rgba(255,255,255,0.8); font-size: 1rem; }

  .contact-wrap {
    padding: 4rem 1.5rem 5rem;
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .contact-wrap { grid-template-columns: 1fr; }
  }

  /* Info side */
  .info-cards { display: flex; flex-direction: column; gap: 1rem; }

  .info-card {
    background: #fff;
    border: 1.5px solid #E2E8F0;
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    transition: all 0.2s;
  }

  .info-card:hover {
    border-color: #3B6EF8;
    box-shadow: 0 4px 20px rgba(59,110,248,0.1);
  }

  .info-icon {
    width: 46px; height: 46px;
    border-radius: 12px;
    background: #EEF2FF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .info-label { font-size: 0.78rem; color: #94A3B8; font-weight: 700; margin-bottom: 0.15rem; }
  .info-value { font-weight: 800; color: #3B6EF8; font-size: 0.9rem; }

  .hours-box {
    background: #EEF2FF;
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    border: 1.5px solid #C7D7FD;
    margin-top: 0.5rem;
  }

  .hours-title {
    font-weight: 800;
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
    color: #1A1A2E;
  }

  .hours-row {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0;
    border-bottom: 1px solid #DBEAFE;
    font-size: 0.83rem;
  }

  .hours-row:last-child { border-bottom: none; }
  .hours-row strong { color: #3B6EF8; }

  /* Form side */
  .form-box {
    background: #fff;
    border-radius: 18px;
    padding: 2.5rem;
    box-shadow: 0 8px 40px rgba(59,110,248,0.08);
    border: 1px solid #E2E8F0;
  }

  .form-box h2 {
    font-size: 1.3rem;
    font-weight: 900;
    margin-bottom: 0.3rem;
    color: #1A1A2E;
  }

  .form-sub { color: #64748B; font-size: 0.875rem; margin-bottom: 2rem; }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .form-row { grid-template-columns: 1fr; }
  }

  .fg { margin-bottom: 1rem; }
  .fg label {
    display: block;
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 0.4rem;
    color: #374151;
  }

  .fg input,
  .fg select,
  .fg textarea {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border: 2px solid #E2E8F0;
    border-radius: 10px;
    font-family: 'Cairo', sans-serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
    direction: rtl;
    color: #1A1A2E;
    background: #fff;
  }

  .fg input:focus,
  .fg select:focus,
  .fg textarea:focus { border-color: #3B6EF8; }

  .fg input::placeholder,
  .fg textarea::placeholder { color: #94A3B8; }

  .fg textarea { resize: vertical; min-height: 110px; }

  .submit-btn {
    width: 100%;
    padding: 1rem;
    background: #F5B800;
    color: #1A1A2E;
    border: none;
    border-radius: 10px;
    font-family: 'Cairo', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.18s;
    margin-top: 0.25rem;
  }

  .submit-btn:hover { background: #D9A200; transform: translateY(-1px); }

  .success-alert {
    display: none;
    background: #EEF2FF;
    border: 1.5px solid #C7D7FD;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    text-align: center;
    color: #3B6EF8;
    font-weight: 700;
    margin-top: 1rem;
  }

  .success-alert.show { display: block; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm');
    form.addEventListener('submit', e => {
      e.preventDefault();
      form.style.opacity = '0.5';
      form.style.pointerEvents = 'none';
      setTimeout(() => {
        form.style.opacity = '1';
        form.style.pointerEvents = 'auto';
        form.reset();
        document.getElementById('successAlert').classList.add('show');
      }, 1000);
    });
  });
</script>

<Layout title="تواصل معنا" description="تواصل مع فريق وصّلها لأي استفسار" page="contact">

  <section class="page-hero">
    <div style="display:inline-block; background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.3); color:#fff; font-weight:700; font-size:0.8rem; padding:0.3rem 1rem; border-radius:100px; margin-bottom:1rem;">📞 تواصل معنا</div>
    <h1>نحن هنا لمساعدتك</h1>
    <p>فريق دعمنا متاح 24/7 للإجابة على جميع استفساراتك</p>
  </section>

  <div class="contact-wrap">
    <!-- Info -->
    <div>
      <div class="info-cards">
        <div class="info-card">
          <div class="info-icon">📞</div>
          <div>
            <div class="info-label">اتصل بنا</div>
            <div class="info-value">920-000-000</div>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">💬</div>
          <div>
            <div class="info-label">واتساب</div>
            <div class="info-value">+218 91 000 0000</div>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">✉️</div>
          <div>
            <div class="info-label">البريد الإلكتروني</div>
            <div class="info-value">info@wslha.co</div>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">📍</div>
          <div>
            <div class="info-label">الموقع</div>
            <div class="info-value">طرابلس، ليبيا</div>
          </div>
        </div>
      </div>

      <div class="hours-box">
        <div class="hours-title">🕐 ساعات العمل</div>
        <div class="hours-row"><span>الأحد – الخميس</span><strong>8 ص – 10 م</strong></div>
        <div class="hours-row"><span>الجمعة</span><strong>2 م – 9 م</strong></div>
        <div class="hours-row"><span>السبت</span><strong>9 ص – 9 م</strong></div>
        <div class="hours-row"><span>دعم طارئ</span><strong>24/7</strong></div>
      </div>
    </div>

    <!-- Form -->
    <div class="form-box">
      <h2>أرسل لنا رسالة</h2>
      <p class="form-sub">سنرد عليك في أقرب وقت</p>

      <form id="contactForm">
        <div class="form-row">
          <div class="fg">
            <label for="c-name">الاسم الكامل</label>
            <input id="c-name" type="text" placeholder="محمد أحمد" required>
          </div>
          <div class="fg">
            <label for="c-phone">رقم الجوال</label>
            <input id="c-phone" type="tel" placeholder="091 000 0000" required>
          </div>
        </div>

        <div class="fg">
          <label for="c-email">البريد الإلكتروني</label>
          <input id="c-email" type="email" placeholder="example@email.com">
        </div>

        <div class="fg">
          <label for="c-subject">الموضوع</label>
          <select id="c-subject" required>
            <option value="" disabled selected>اختر الموضوع</option>
            <option>استفسار عن طلب</option>
            <option>طلب خدمة توصيل</option>
            <option>شراكة تجارية</option>
            <option>شكوى</option>
            <option>أخرى</option>
          </select>
        </div>

        <div class="fg">
          <label for="c-msg">رسالتك</label>
          <textarea id="c-msg" placeholder="اكتب رسالتك هنا..." required></textarea>
        </div>

        <button type="submit" class="submit-btn">إرسال الرسالة ←</button>
      </form>

      <div class="success-alert" id="successAlert">
        ✅ تم إرسال رسالتك بنجاح! سنتواصل معك قريباً.
      </div>
    </div>
  </div>

</Layout>
