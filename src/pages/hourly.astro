---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';

const HOURS_OPTIONS = [2, 4, 6, 8, 12];
const CATEGORIES = [
  { id: 'sedan', label: '🚗 سيدان (سيارات حديثة)', rate: 300, note: 'من 300 ج.م/ساعة — حتى 3 ركاب' },
  { id: 'suv',   label: '🚙 SUV / كروز',            rate: 500, note: 'من 500 ج.م/ساعة — حتى 6 ركاب' },
  { id: 'van',   label: '🚐 ميكروباص',              rate: 600, note: 'من 600 ج.م/ساعة — حتى 8 ركاب' },
];
---

<style>
  .hourly-page { max-width: 720px; margin: 0 auto; padding: var(--sp-8) var(--sp-6) var(--sp-20); }
  .hourly-card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); box-shadow: var(--shadow-md); overflow: hidden;
  }
  .form-section { padding: var(--sp-6); }
  .field { margin-bottom: var(--sp-4); }
  .field__label { display: block; font-weight: var(--weight-bold); font-size: var(--text-sm); margin-bottom: var(--sp-2); color: var(--color-text); }
  .field__input, .field__select, .field__textarea {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border); border-radius: var(--radius);
    font-family: var(--font-body); font-size: var(--text-sm);
    direction: rtl; background: var(--color-bg); color: var(--color-text); outline: none; transition: border-color var(--ease);
    box-sizing: border-box;
  }
  .field__input:focus, .field__select:focus, .field__textarea:focus { border-color: var(--color-primary); }
  .field__textarea { resize: vertical; min-height: 60px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); }

  .opt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-2); }
  .opt {
    border: 2px solid var(--color-border); border-radius: var(--radius-lg);
    padding: var(--sp-3); cursor: pointer; text-align: center; transition: all var(--ease);
  }
  .opt input { position: absolute; opacity: 0; width: 0; }
  .opt:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-light); }
  .opt__label { font-weight: var(--weight-bold); font-size: var(--text-sm); }
  .opt__sub { font-size: 11px; color: var(--color-text-faint); margin-top: 2px; }

  .route-summary {
    margin: 0 var(--sp-6) var(--sp-4);
    background: linear-gradient(135deg, #F2F7F6, #E3EDEC);
    border: 1px solid #C9DEDC; border-radius: var(--radius-xl);
    padding: var(--sp-3) var(--sp-5);
    display: flex; gap: var(--sp-4); align-items: center; justify-content: space-between;
    transition: opacity 0.3s;
  }
  .route-summary.empty { opacity: 0.45; }
  .route-summary__stat { text-align: center; }
  .route-summary__val { font-size: var(--text-lg); font-weight: var(--weight-black); color: var(--color-primary); }
  .route-summary__val--price { color: #16a34a; }
  .route-summary__key { font-size: 10px; color: var(--color-text-faint); }
  .route-summary__divider { width: 1px; height: 28px; background: #C9DEDC; flex-shrink: 0; }

  .submit-btn {
    width: 100%; padding: var(--sp-4); border-radius: var(--radius-lg);
    background: var(--color-primary); color: #fff; font-family: var(--font-body);
    font-size: var(--text-sm); font-weight: var(--weight-black);
    border: none; cursor: pointer; transition: all var(--ease);
  }
  .submit-btn:hover:not(:disabled) { background: var(--color-primary-dark); }
  .submit-btn:disabled { opacity: .45; cursor: not-allowed; }
  .alert-error { padding: var(--sp-3); border-radius: var(--radius); font-size: var(--text-sm); margin-bottom: var(--sp-3); display: none; background: #fef2f2; border: 1px solid #fca5a5; color: #b91c1c; }
  .alert-error.visible { display: block; }

  @media (max-width: 560px) {
    .form-row { grid-template-columns: 1fr; }
    .opt-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<Layout title="سائق تحت الطلب | وصّلها" page="hourly">
  <PageHero
    title="سائق تحت الطلب 🕐"
    subtitle="للرحلات والسفر الطويل بين المحافظات — القاهرة، الإسكندرية، وأي وجهة بعيدة — وقضاء حوائجك اليومية، بالساعة حسب فئة السيارة"
  />

  <div class="hourly-page">
    <div class="hourly-card" id="booking-card">
      <div class="form-section">
        <div id="hourly-alert" class="alert-error"></div>

        <div class="field">
          <label class="field__label">عدد الساعات</label>
          <div class="opt-grid" id="hours-grid">
            {HOURS_OPTIONS.map((h, i) => (
              <label class="opt">
                <input type="radio" name="h-hours" value={h} checked={i === 1} />
                <div class="opt__label">{h} ساعات</div>
              </label>
            ))}
          </div>
        </div>

        <div class="field">
          <label class="field__label">فئة السيارة</label>
          <div class="opt-grid" id="cat-grid">
            {CATEGORIES.map((c, i) => (
              <label class="opt">
                <input type="radio" name="h-cat" value={c.id} checked={i === 0} />
                <div class="opt__label">{c.label}</div>
                <div class="opt__sub">{c.note}</div>
              </label>
            ))}
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="h-from">نقطة الانطلاق</label>
          <input id="h-from" type="text" class="field__input" placeholder="من أين يبدأ السائق معك؟" autocomplete="off" />
        </div>

        <div class="field">
          <label class="field__label" for="h-notes-2">الوجهة أو الغرض من الرحلة</label>
          <input id="h-notes-2" type="text" class="field__input" placeholder="مثلاً: القاهرة والعودة، الإسكندرية، قضاء حوائج داخل دمياط..." />
        </div>

        <div class="form-row" id="h-contact-row">
          <div class="field"><label class="field__label" for="h-name">الاسم الكامل</label><input id="h-name" type="text" class="field__input" placeholder="محمد أحمد" /></div>
          <div class="field"><label class="field__label" for="h-phone">رقم الجوال</label><input id="h-phone" type="tel" class="field__input" placeholder="010 1234 5678" /></div>
        </div>
        <div class="form-row">
          <div class="field">
            <label class="field__label" for="h-time">وقت البدء</label>
            <select id="h-time" class="field__select">
              <option value="now">الآن فورًا</option><option value="30">بعد 30 دقيقة</option><option value="60">بعد ساعة</option>
            </select>
          </div>
          <div class="field">
            <label class="field__label" for="h-passengers">عدد الركاب</label>
            <select id="h-passengers" class="field__select">
              <option value="1">1 راكب</option><option value="2">2 ركاب</option><option value="3">3 ركاب</option><option value="4">4 ركاب</option>
            </select>
          </div>
        </div>
        <div class="field"><label class="field__label" for="h-notes">ملاحظات إضافية (اختياري)</label><textarea id="h-notes" class="field__textarea" placeholder="مثلاً: عدد الأمتعة، مواعيد محددة، توقفات إضافية..."></textarea></div>
        <div class="field">
          <label class="field__label">طريقة الدفع</label>
          <select id="h-payment" class="field__select">
            <option value="cash">💵 كاش عند الانتهاء</option>
            <option value="wallet">📱 فودافون كاش / إنستاباي</option>
          </select>
        </div>
      </div>

      <div id="route-summary" class="route-summary">
        <div class="route-summary__stat"><div id="sum-hours" class="route-summary__val">4</div><div class="route-summary__key">ساعات</div></div>
        <div class="route-summary__divider"></div>
        <div class="route-summary__stat"><div id="sum-rate" class="route-summary__val">300</div><div class="route-summary__key">ج.م / ساعة</div></div>
        <div class="route-summary__divider"></div>
        <div class="route-summary__stat"><div id="sum-price" class="route-summary__val route-summary__val--price">1200</div><div class="route-summary__key">إجمالي الأجرة</div></div>
      </div>

      <div class="form-section" style="padding-top:0">
        <button id="hourly-submit-btn" class="submit-btn" type="button" disabled>🕐 اطلب سائقك الآن</button>
        <div id="hourly-hint" style="font-size:var(--text-xs);color:var(--color-text-faint);text-align:center;margin-top:var(--sp-2)">اختر نقطة الانطلاق أولاً</div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' };

  const RATES: Record<string, number> = { sedan: 300, suv: 500, van: 600 };

  function normPhone(s: string) { return s.replace(/[\s\-()+]/g, ''); }
  const EG = /^01[0125][0-9]{8}$/;

  function currentHours(): number {
    return parseInt((document.querySelector('input[name="h-hours"]:checked') as HTMLInputElement)?.value || '4');
  }
  function currentCat(): string {
    return (document.querySelector('input[name="h-cat"]:checked') as HTMLInputElement)?.value || 'sedan';
  }
  function fareFor(): number {
    return currentHours() * (RATES[currentCat()] ?? RATES.sedan);
  }
  function updateSummary() {
    document.getElementById('sum-hours')!.textContent = String(currentHours());
    document.getElementById('sum-rate')!.textContent = String(RATES[currentCat()] ?? RATES.sedan);
    document.getElementById('sum-price')!.textContent = String(fareFor());
  }
  document.querySelectorAll('input[name="h-hours"], input[name="h-cat"]').forEach(r => r.addEventListener('change', updateSummary));
  updateSummary();

  function hideContactFieldsIfLoggedIn() {
    try {
      const u = JSON.parse(localStorage.getItem('wslha_user') || 'null');
      if (u?.name && u?.phone) {
        (document.getElementById('h-name') as HTMLInputElement).value  = u.name;
        (document.getElementById('h-phone') as HTMLInputElement).value = u.phone;
        const row = document.getElementById('h-contact-row');
        if (row) row.hidden = true;
      }
    } catch {}
  }
  hideContactFieldsIfLoggedIn();

  // ── Google Places (Damietta-only) ──
  const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';
  let fromPlace: { name: string; lat: number; lng: number } | null = null;

  function loadGoogleMaps(): Promise<void> {
    return new Promise((resolve) => {
      if ((window as any).google?.maps) { resolve(); return; }
      (window as any).__gmHourlyInit = resolve;
      const s = document.createElement('script');
      s.src = `https://maps.googleapis.com/maps/api/js?key=${GMAPS_KEY}&libraries=places&callback=__gmHourlyInit&language=ar&region=EG`;
      s.async = true;
      document.head.appendChild(s);
    });
  }

  function refreshReadiness() {
    const btn  = document.getElementById('hourly-submit-btn') as HTMLButtonElement;
    const hint = document.getElementById('hourly-hint')!;
    if (fromPlace) { btn.disabled = false; hint.style.display = 'none'; }
    else            { btn.disabled = true;  hint.style.display = ''; }
  }

  let placesInited = false;
  async function initPlaces() {
    if (placesInited) return;
    placesInited = true;
    await loadGoogleMaps();
    const G = (window as any).google.maps;
    const damiettaBias = new G.LatLngBounds({ lat: 31.20, lng: 31.50 }, { lat: 31.65, lng: 32.10 });
    const acFrom = new G.places.Autocomplete(document.getElementById('h-from'), {
      bounds: damiettaBias, componentRestrictions: { country: 'eg' }, strictBounds: true, types: [], fields: ['geometry', 'name', 'formatted_address'],
    });
    acFrom.addListener('place_changed', () => {
      const p = acFrom.getPlace();
      if (!p?.geometry?.location) return;
      fromPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
      refreshReadiness();
    });
  }
  document.getElementById('h-from')?.addEventListener('focus', () => { initPlaces(); }, { once: true });

  document.getElementById('hourly-submit-btn')?.addEventListener('click', async () => {
    const errEl = document.getElementById('hourly-alert')!;
    errEl.classList.remove('visible');

    const name  = (document.getElementById('h-name') as HTMLInputElement).value.trim();
    const phone = normPhone((document.getElementById('h-phone') as HTMLInputElement).value.trim());
    if (!name)           { errEl.textContent = 'يرجى إدخال الاسم.'; errEl.classList.add('visible'); return; }
    if (!EG.test(phone)) { errEl.textContent = 'رقم جوال غير صحيح (01...)'; errEl.classList.add('visible'); return; }
    if (!fromPlace)       { errEl.textContent = 'يرجى اختيار نقطة الانطلاق.'; errEl.classList.add('visible'); return; }

    const hours  = currentHours();
    const cat    = currentCat();
    const fare   = fareFor();
    const pax    = (document.getElementById('h-passengers') as HTMLSelectElement).value;
    const pay    = (document.getElementById('h-payment') as HTMLSelectElement).value;
    const destination = (document.getElementById('h-notes-2') as HTMLInputElement).value.trim();
    const notes  = (document.getElementById('h-notes') as HTMLTextAreaElement).value.trim();

    const btn = document.getElementById('hourly-submit-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'جاري إرسال الطلب...';

    try {
      const res = await fetch(`${SB_URL}/rest/v1/rides`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify({
          customer_phone: phone, customer_name: name,
          from_area: fromPlace.name, from_lat: fromPlace.lat, from_lng: fromPlace.lng,
          // لا وجهة ثابتة في الحجز بالساعة — السائق يفضل مع العميل طول المدة
          // (ممكن تشمل رحلة طويلة بين المحافظات، الوجهة/الغرض بيتسجّل في notes).
          to_area: fromPlace.name, to_lat: fromPlace.lat, to_lng: fromPlace.lng,
          distance_km: 0, fare, eta_minutes: hours * 60,
          passengers: parseInt(pax), payment: pay,
          notes: `🕐 سائق تحت الطلب — ${hours} ساعات — 🚘 ${cat}`
            + (destination ? ` — الوجهة/الغرض: ${destination}` : '')
            + (notes ? ' — ' + notes : ''),
          vehicle_year: 2022,
          status: 'pending', ride_type: 'hourly',
        }),
      });
      if (!res.ok) {
        const detail = await res.text().catch(() => '');
        console.error('[hourly] ride insert failed', res.status, detail);
        errEl.textContent = 'تعذر إرسال الطلب، حاول مرة أخرى.'; errEl.classList.add('visible');
        btn.disabled = false; btn.textContent = '🕐 اطلب سائقك الآن';
        return;
      }
      window.location.href = '/rides';
    } catch (e) {
      console.error('[hourly] ride insert error', e);
      errEl.textContent = 'تعذر إرسال الطلب، تحقق من الاتصال وحاول مرة أخرى.'; errEl.classList.add('visible');
      btn.disabled = false; btn.textContent = '🕐 اطلب سائقك الآن';
    }
  });
</script>
