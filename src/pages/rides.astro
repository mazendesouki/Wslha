</Layout>

<script define:vars={{ AREAS }}>
  // ── Supabase ──
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' };

  // ── Google Maps API key ──
  const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';

  // ── distance & pricing helpers (أسعار 2026) ──
  const BASE_FARE   = 20;   // ج.م — عداد الانطلاق
  const RATE_PER_KM = 10;   // ج.م / كم — طريق فعلي
  const MIN_FARE    = 25;   // ج.م — الحد الأدنى

  function haversineKm(lat1, lng1, lat2, lng2) {
    const R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
    const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)**2;
    return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
  }
  // roadKm = المسافة الفعلية على الطريق (من OSRM)، أو haversine×1.35 كتقدير
  function fareFor(roadKm) {
    return Math.ceil(Math.max(BASE_FARE + roadKm * RATE_PER_KM, MIN_FARE) / 5) * 5;
  }
  function fareBreakdown(roadKm) {
    const dist   = +(roadKm).toFixed(1);
    const distCost = +(roadKm * RATE_PER_KM).toFixed(0);
    const total  = fareFor(roadKm);
    return `<span style="color:var(--color-text-faint);font-size:11px;">عداد ${BASE_FARE} + ${dist}كم × ${RATE_PER_KM} = <strong style="color:#16a34a">${total} ج.م</strong></span>`;
  }
  function etaMin(km)  { return Math.ceil(km * 1.35 / 40 * 60); }
  function normPhone(s){ return s.replace(/[\s\-()+]/g,''); }
  const EG = /^01[0125][0-9]{8}$/;

  // real road distance from OSRM (updated after route fetch)
  let _realRoadKm = 0;
  let _realEtaMin = 0;

  // ── Google Maps setup ──
  let map = null, fromMarker = null, toMarker = null, routeLine = null, driverMarker = null;
  let gmapsReady = false, pendingRoute = null;

  // Load Google Maps JS API dynamically
  function loadGoogleMaps() {
    return new Promise((resolve, reject) => {
      if (window.google?.maps) { resolve(); return; }
      window._gmapsCb = () => resolve();
      const s = document.createElement('script');
      s.src = `https://maps.googleapis.com/maps/api/js?key=${GMAPS_KEY}&callback=_gmapsCb&language=ar&region=EG`;
      s.async = true; s.defer = true;
      s.onerror = () => reject(new Error('gmaps-load-failed'));
      document.head.appendChild(s);
    });
  }

  function pinIcon(color) {
    return {
      path: 'M12 0C7 0 3 4 3 9c0 6.5 9 15 9 15s9-8.5 9-15c0-5-4-9-9-9z',
      fillColor: color, fillOpacity: 1,
      strokeColor: '#fff', strokeWeight: 3,
      scale: 1.6, anchor: new google.maps.Point(12, 24),
    };
  }
  const carSymbol = {
    path: 'M5 11l1.5-4.5h11L19 11m-1.5 5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0m-8 0a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0M3 11v6h2m14-6v6h-2m-12 0h10',
    fillColor: '#1d4ed8', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 1,
    scale: 1.4, anchor: { x: 12, y: 12 },
  };

  async function initMap() {
    if (map) return true;
    try {
      await loadGoogleMaps();
      document.getElementById('map-placeholder').style.display = 'none';
      document.getElementById('ride-map').style.display = 'block';
      map = new google.maps.Map(document.getElementById('ride-map'), {
        center: { lat: 31.418, lng: 31.814 }, zoom: 11,
        mapTypeControl: false, streetViewControl: false, fullscreenControl: true,
        styles: [{ featureType: 'poi', stylers: [{ visibility: 'off' }] }],
      });
      gmapsReady = true;
      return true;
    } catch {
      document.getElementById('map-placeholder').innerHTML =
        '<span style="font-size:2rem;margin-bottom:8px">🗺️</span>' +
        '<span>الخريطة التفاعلية غير متاحة<br>' +
        '<span style="font-size:11px;color:#9ca3af;">المسافة والسعر محسوبان بدقة</span></span>';
      return false;
    }
  }

  function clearMap() {
    [fromMarker, toMarker, routeLine, driverMarker].forEach(o => o && o.setMap(null));
    fromMarker = toMarker = routeLine = driverMarker = null;
  }

  async function showRoute(from, to) {
    const ok = await initMap();
    if (!ok) return;
    clearMap();

    fromMarker = new google.maps.Marker({
      position: { lat: from.lat, lng: from.lng }, map,
      icon: pinIcon('#3b82f6'), title: 'الانطلاق: ' + from.name,
    });
    toMarker = new google.maps.Marker({
      position: { lat: to.lat, lng: to.lng }, map,
      icon: pinIcon('#ef4444'), title: 'الوصول: ' + to.name,
    });

    // Road geometry + distance via OSRM
    let coords;
    try {
      const osrm = `https://router.project-osrm.org/route/v1/driving/${from.lng},${from.lat};${to.lng},${to.lat}?overview=full&geometries=geojson`;
      const data = await (await fetch(osrm)).json();
      if (data.routes?.[0]) {
        coords = data.routes[0].geometry.coordinates.map(([lng,lat]) => ({ lat, lng }));
        // Use actual road distance & duration from OSRM
        _realRoadKm  = data.routes[0].distance / 1000;
        _realEtaMin  = Math.max(1, Math.ceil(data.routes[0].duration / 60));
        const realFare = fareFor(_realRoadKm);
        document.getElementById('sum-dist').textContent  = _realRoadKm.toFixed(1) + ' كم';
        document.getElementById('sum-eta').textContent   = _realEtaMin + ' دق';
        document.getElementById('sum-price').textContent = realFare + ' ج.م';
        const bkEl = document.getElementById('fare-breakdown');
        if (bkEl) bkEl.innerHTML = fareBreakdown(_realRoadKm);
      }
    } catch {}
    if (!coords) coords = [{ lat: from.lat, lng: from.lng }, { lat: to.lat, lng: to.lng }];
    window._routeCoords = coords;

    routeLine = new google.maps.Polyline({
      path: coords, map, strokeColor: '#3b82f6', strokeOpacity: 0.85, strokeWeight: 5,
    });

    const bounds = new google.maps.LatLngBounds();
    coords.forEach(c => bounds.extend(c));
    map.fitBounds(bounds, 50);
  }

  // ── live simulation ──
  function startLiveTracking(from, to, etaMinutes) {
    if (!gmapsReady) return;
    if (driverMarker) driverMarker.setMap(null);
    const coords = window._routeCoords || [{ lat: from.lat, lng: from.lng }, { lat: to.lat, lng: to.lng }];
    const totalSteps = coords.length;
    let step = 0;

    driverMarker = new google.maps.Marker({
      position: coords[0], map, icon: carSymbol, zIndex: 999,
    });
    document.getElementById('live-badge').style.display = 'inline-flex';

    const msPerStep = Math.max(1500, (etaMinutes * 60 * 1000) / totalSteps);

    window._liveInterval = setInterval(() => {
      if (step >= totalSteps - 1) {
        clearInterval(window._liveInterval);
        setTimeout(() => advanceStatus('done'), 1000);
        return;
      }
      step++;
      driverMarker.setPosition(coords[step]);

      const pct = step / (totalSteps - 1);
      if (pct >= 0.05 && !window._st_assigned) { window._st_assigned = true; advanceStatus('assigned'); }
      if (pct >= 0.15 && !window._st_arrived)  { window._st_arrived = true;  advanceStatus('arrived'); }
      if (pct >= 0.20 && !window._st_onride)   { window._st_onride  = true;  advanceStatus('onride'); }
    }, msPerStep);
  }

  function advanceStatus(stage) {
    const now = new Date().toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
    if (stage === 'assigned') {
      document.getElementById('st-confirmed').className = 'status-step done';
      document.getElementById('st-assigned').className  = 'status-step active';
    }
    if (stage === 'arrived') {
      document.getElementById('st-assigned').className  = 'status-step done';
      document.getElementById('st-arrived').className   = 'status-step active';
      document.getElementById('st-arrived-time').textContent = now;
    }
    if (stage === 'onride') {
      document.getElementById('st-arrived').className   = 'status-step done';
      document.getElementById('st-onride').className    = 'status-step active';
      document.getElementById('st-onride-time').textContent = now;
    }
    if (stage === 'done') {
      document.getElementById('st-onride').className    = 'status-step done';
      document.getElementById('st-done').className      = 'status-step done';
      document.getElementById('st-done-time').textContent = now;
      document.getElementById('live-badge').style.display = 'none';
    }
  }

  // ── ride state ──
  let activeRideId = null;
  let ridePoller   = null;
  let _currentFrom = null, _currentTo = null, _currentEta = 0;
  let _driverShown = false, _onRide = false;

  async function sbCreateRide(payload) {
    try {
      const res = await fetch(`${SB_URL}/rest/v1/rides`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify(payload),
      });
      const rows = await res.json();
      return Array.isArray(rows) ? rows[0] : null;
    } catch { return null; }
  }

  async function sbCancelRide(id) {
    try {
      await fetch(`${SB_URL}/rest/v1/rides?id=eq.${id}`, {
        method: 'PATCH',
        headers: { ...SB_H, Prefer: 'return=minimal' },
        body: JSON.stringify({ status: 'cancelled' }),
      });
    } catch {}
  }

  async function pollRideStatus() {
    if (!activeRideId) return;
    try {
      const res = await fetch(`${SB_URL}/rest/v1/rides?id=eq.${activeRideId}&select=*`, { headers: SB_H });
      const rows = await res.json();
      if (!Array.isArray(rows) || rows.length === 0) return;
      const ride = rows[0];

      if ((ride.status === 'accepted' || ride.status === 'in_progress' || ride.status === 'completed') && !_driverShown) {
        _driverShown = true;
        showDriverFound(ride);
      }
      if (ride.status === 'in_progress' && !_onRide) {
        _onRide = true;
        document.getElementById('driver-card-status').textContent = 'في الطريق للوجهة 🚗';
        advanceStatus('onride');
      }
      if (ride.status === 'completed') {
        stopPoller();
        advanceStatus('done');
        setTimeout(() => showFinalSuccess(ride), 1800);
      }
      if (ride.status === 'cancelled') {
        stopPoller();
        resetToBooking();
      }
    } catch {}
  }

  function stopPoller() {
    if (ridePoller) { clearInterval(ridePoller); ridePoller = null; }
  }

  function showSearching(fromName, toName, fare) {
    document.getElementById('booking-card').style.display = 'none';
    document.getElementById('success-card').classList.remove('visible');
    document.getElementById('driver-card').classList.remove('visible');
    document.getElementById('searching-card').classList.add('visible');
    document.getElementById('fare-section').style.display = 'none';
    document.getElementById('search-from').textContent = fromName;
    document.getElementById('search-to').textContent   = toName;
    document.getElementById('search-fare').textContent  = fare + ' ج.م';
  }

  function showDriverFound(ride) {
    document.getElementById('searching-card').classList.remove('visible');
    const card = document.getElementById('driver-card');
    card.classList.add('visible');
    document.getElementById('driver-card-name').textContent    = ride.driver_name  || 'السائق';
    document.getElementById('driver-card-status').textContent  = 'السائق في الطريق إليك 🚗';
    document.getElementById('driver-call-btn').setAttribute('href', 'tel:' + (ride.driver_phone || ''));
    document.getElementById('driver-card-from').textContent = ride.from_area;
    document.getElementById('driver-card-to').textContent   = ride.to_area;
    document.getElementById('driver-card-fare').textContent = ride.fare;
    advanceStatus('assigned');
    if (window._routeCoords && _currentFrom && _currentTo) {
      startLiveTracking(_currentFrom, _currentTo, _currentEta);
    }
  }

  function showFinalSuccess(ride) {
    document.getElementById('driver-card').classList.remove('visible');
    document.getElementById('ride-status').classList.remove('visible');
    const details = [
      ['من', ride.from_area], ['إلى', ride.to_area],
      ['المسافة', (ride.distance_km * 1.35).toFixed(1) + ' كم'],
      ['السائق', ride.driver_name || '—'],
      ['السعر', ride.fare + ' ج.م', true],
    ];
    document.getElementById('success-details').innerHTML = details
      .map(([k, v, p]) => `<div class="detail-row"><span class="detail-row__key">${k}</span><span class="detail-row__val${p ? ' detail-row__val--price' : ''}">${v}</span></div>`)
      .join('');
    document.getElementById('success-card').classList.add('visible');
  }

  function resetToBooking() {
    stopPoller();
    activeRideId = null; _driverShown = false; _onRide = false;
    if (window._liveInterval) { clearInterval(window._liveInterval); window._liveInterval = null; }
    document.getElementById('searching-card').classList.remove('visible');
    document.getElementById('driver-card').classList.remove('visible');
    document.getElementById('booking-card').style.display = '';
    document.getElementById('ride-status').classList.remove('visible');
    document.getElementById('fare-section').style.display = '';
    document.getElementById('live-badge').style.display = 'none';
    ['st-confirmed','st-assigned','st-arrived','st-onride','st-done']
      .forEach(id => document.getElementById(id).className = 'status-step');
    window._st_assigned = window._st_arrived = window._st_onride = false;
  }

  document.getElementById('cancel-ride-btn').addEventListener('click', async () => {
    if (activeRideId) await sbCancelRide(activeRideId);
    resetToBooking();
    clearMap();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ── selectors ──
  const fromSel = document.getElementById('from-area');
  const toSel   = document.getElementById('to-area');
  const summary = document.getElementById('route-summary');

  function areaBy(sel) {
    const o = sel.options[sel.selectedIndex];
    if (!o?.value) return null;
    return { id: o.value, name: o.text, lat: +o.dataset.lat, lng: +o.dataset.lng };
  }

  const confirmBtn = document.getElementById('confirm-btn');
  const submitHint = document.getElementById('submit-hint');

  function updateUI() {
    const from = areaBy(fromSel), to = areaBy(toSel);
    if (!from || !to || from.id === to.id) {
      // Reset to placeholder state
      document.getElementById('sum-dist').textContent  = '—';
      document.getElementById('sum-eta').textContent   = '—';
      document.getElementById('sum-price').textContent = '—';
      const bkEl = document.getElementById('fare-breakdown');
      if (bkEl) bkEl.innerHTML = '';
      summary.classList.add('empty');
      confirmBtn.disabled = true;
      confirmBtn.classList.remove('ready');
      submitHint.classList.add('visible');
      return;
    }
    // Estimate while OSRM loads
    _realRoadKm = 0; _realEtaMin = 0;
    const km      = haversineKm(from.lat, from.lng, to.lat, to.lng);
    const estRoad = km * 1.35;
    document.getElementById('sum-dist').textContent  = '~' + estRoad.toFixed(1) + ' كم';
    document.getElementById('sum-eta').textContent   = etaMin(km) + ' دق';
    document.getElementById('sum-price').textContent = fareFor(estRoad) + ' ج.م';
    const bkEl = document.getElementById('fare-breakdown');
    if (bkEl) bkEl.innerHTML = '<span style="color:var(--color-text-faint);font-size:11px;">جاري حساب المسافة الفعلية...</span>';
    summary.classList.remove('empty');
    confirmBtn.disabled = false;
    confirmBtn.classList.add('ready');
    submitHint.classList.remove('visible');
    showRoute(from, to); // will update with real distance after OSRM
  }

  fromSel.addEventListener('change', updateUI);
  toSel.addEventListener('change', updateUI);
  document.getElementById('swap-btn').addEventListener('click', () => {
    const v = fromSel.value; fromSel.value = toSel.value; toSel.value = v; updateUI();
  });

  // Browser restores dropdown values on page reload WITHOUT firing change events —
  // manually trigger if both already have values (e.g. after back-navigation or reload)
  if (fromSel.value && toSel.value) updateUI();

  // ── confirm ──
  document.getElementById('confirm-btn').addEventListener('click', async () => {
    const from = areaBy(fromSel), to = areaBy(toSel);
    if (!from || !to) return;
    const name  = document.getElementById('r-name').value.trim();
    const phone = normPhone(document.getElementById('r-phone').value.trim());
    const errEl = document.getElementById('alert-error');
    errEl.classList.remove('visible');
    if (!name)          { errEl.textContent = 'يرجى إدخال الاسم.'; errEl.classList.add('visible'); return; }
    if (!EG.test(phone)){ errEl.textContent = 'رقم جوال مصري غير صحيح (يبدأ بـ 010 أو 011 أو 012 أو 015).'; errEl.classList.add('visible'); return; }

    const km       = haversineKm(from.lat, from.lng, to.lat, to.lng);
    const roadKm   = _realRoadKm > 0 ? _realRoadKm : km * 1.35;
    const fare     = fareFor(roadKm);
    const eta      = _realEtaMin > 0 ? _realEtaMin : etaMin(km);
    const pax    = document.getElementById('r-passengers').value;
    const pay    = document.querySelector('input[name="r-payment"]:checked').value;
    const notes  = document.getElementById('r-notes').value.trim();

    confirmBtn.disabled    = true;
    confirmBtn.classList.remove('ready');
    confirmBtn.textContent = 'جاري إرسال الطلب...';

    // POST to Supabase
    const ridePayload = {
      customer_phone: phone, customer_name: name,
      from_area: from.name, from_lat: from.lat, from_lng: from.lng,
      to_area:   to.name,   to_lat:   to.lat,   to_lng:   to.lng,
      distance_km: roadKm, fare, eta_minutes: eta,
      passengers: parseInt(pax), payment: pay, notes,
      status: 'pending',
    };
    const ride = await sbCreateRide(ridePayload);
    activeRideId = ride?.id || null;

    // Save to localStorage for orders history
    try {
      const orders = JSON.parse(localStorage.getItem('wslha_orders') || '[]');
      orders.unshift({ id: ride?.id || ('R'+Date.now()), type:'ride', from:from.name, to:to.name, name, phone, passengers:pax, payment:pay, fare, eta, distance: roadKm.toFixed(1), status:'pending', createdAt:new Date().toISOString() });
      localStorage.setItem('wslha_orders', JSON.stringify(orders));
    } catch {}

    confirmBtn.disabled    = false;
    confirmBtn.classList.add('ready');
    confirmBtn.textContent = '🚗 تأكيد الطلب وتتبع الرحلة';

    // Show ride status panel
    document.getElementById('ride-status').classList.add('visible');
    document.getElementById('st-confirmed-time').textContent = new Date().toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
    document.getElementById('st-confirmed').className = 'status-step done';
    document.getElementById('st-assigned').className  = 'status-step active';

    _currentFrom = from; _currentTo = to; _currentEta = eta;
    _driverShown = false; _onRide = false;
    if (window._liveInterval) clearInterval(window._liveInterval);
    window._st_assigned = window._st_arrived = window._st_onride = false;

    // Show route on map
    showRoute(from, to);

    showSearching(from.name, to.name, fare);

    // Start polling for driver
    if (activeRideId) {
      ridePoller = setInterval(pollRideStatus, 2000);
    } else {
      // Supabase unavailable — simulate after delay
      setTimeout(() => {
        _driverShown = true;
        showDriverFound({ driver_name: 'السائق المتاح', driver_phone: '', from_area: from.name, to_area: to.name, fare });
        setTimeout(() => startLiveTracking(from, to, eta), 1000);
      }, 4000);
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ── new ride ──
  document.getElementById('new-ride-btn').addEventListener('click', () => {
    ['r-name','r-phone','r-notes'].forEach(id => (document.getElementById(id) as HTMLInputElement).value = '');
    (document.getElementById('r-passengers') as HTMLSelectElement).value = '1';
    (document.getElementById('r-time') as HTMLSelectElement).value = 'now';
    (document.querySelector('input[name="r-payment"][value="cash"]') as HTMLInputElement).checked = true;
    fromSel.value = ''; toSel.value = '';
    document.getElementById('success-card').classList.remove('visible');
    clearMap();
    resetToBooking();
    updateUI();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ── fare guide (2026 prices) ──
  const SAMPLE = [
    ['center','new-damietta'],['center','ras-el-bar'],['center','kafr-saad'],
    ['center','faraskur'],['new-damietta','ras-el-bar'],['center','zarqa'],
    ['center','el-saro'],['center','kafr-batikh'],
  ];
  const grid = document.getElementById('fare-grid');
  SAMPLE.forEach(([fid,tid]) => {
    const f = AREAS.find(a => a.id === fid), t = AREAS.find(a => a.id === tid);
    if (!f || !t) return;
    const estRoad = haversineKm(f.lat, f.lng, t.lat, t.lng) * 1.35;
    const fare = fareFor(estRoad);
    grid.insertAdjacentHTML('beforeend',
      `<div class="fare-card">
        <div class="fare-card__route">
          <div class="fare-card__from">${f.name}</div>
          <div class="fare-card__to">← ${t.name}</div>
          <div style="font-size:10px;color:var(--color-text-faint);margin-top:2px;">~${estRoad.toFixed(1)} كم</div>
        </div>
        <div class="fare-card__price">${fare} ج.م</div>
      </div>`
    );
  });
  // Add pricing note
  document.getElementById('fare-section').insertAdjacentHTML('afterbegin',
    `<p style="font-size:var(--text-xs);color:var(--color-text-faint);margin-bottom:var(--sp-3);">
      أسعار 2026 — عداد انطلاق ${BASE_FARE} ج.م + ${RATE_PER_KM} ج.م/كم — الحد الأدنى ${MIN_FARE} ج.م
    </p>`
  );
</script>
