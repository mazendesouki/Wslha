  // (Trip-type toggle buttons removed — no listeners needed.)

  // ═══════════════════════════════════════════
  //  LOCAL FORM
  // ═══════════════════════════════════════════
  const summary     = document.getElementById('route-summary');
  const localBtn    = document.getElementById('local-confirm-btn');
  const localHint   = document.getElementById('local-hint');

  function updateUI() {
    const from = fromPlace, to = toPlace;
    if (!from || !to) {
      document.getElementById('sum-dist').textContent  = '—';
      document.getElementById('sum-eta').textContent   = '—';
      document.getElementById('sum-price').textContent = '—';
      document.getElementById('fare-breakdown').innerHTML = '';
      summary.classList.add('empty');
      localBtn.disabled = true;
      localBtn.classList.remove('ready');
      localHint.classList.add('visible');
      return;
    }
    _realRoadKm = 0; _realEtaMin = 0;
    const km      = haversineKm(from.lat, from.lng, to.lat, to.lng);
    const estRoad = km * 1.35;
    document.getElementById('sum-dist').textContent  = '~' + estRoad.toFixed(1) + ' كم';
    document.getElementById('sum-eta').textContent   = etaMin(km) + ' دق';
    document.getElementById('sum-price').textContent = fareFor(estRoad) + ' ج.م';
    document.getElementById('fare-breakdown').innerHTML = '<span style="color:var(--color-text-faint);font-size:11px;">جاري حساب المسافة الفعلية...</span>';
    summary.classList.remove('empty');
    localBtn.disabled = false;
    localBtn.classList.add('ready');
    localHint.classList.remove('visible');
    showRoute(from, to);
  }

  document.getElementById('swap-btn').addEventListener('click', () => {
    const tmp = fromPlace; fromPlace = toPlace; toPlace = tmp;
    document.getElementById('from-area').value = fromPlace?.name || '';
    document.getElementById('to-area').value   = toPlace?.name  || '';
    updateUI();
  });

  // Local confirm
  localBtn.addEventListener('click', async () => {
    const errEl = document.getElementById('local-alert');
    errEl.classList.remove('visible');
    const name  = document.getElementById('l-name').value.trim();
    const phone = normPhone(document.getElementById('l-phone').value.trim());
    if (!name)           { errEl.textContent = 'يرجى إدخال الاسم.'; errEl.classList.add('visible'); return; }
    if (!EG.test(phone)) { errEl.textContent = 'رقم جوال غير صحيح (01...)'; errEl.classList.add('visible'); return; }

    const from = fromPlace, to = toPlace;
    if (!from || !to) return;

    const km     = haversineKm(from.lat, from.lng, to.lat, to.lng);
    const roadKm = _realRoadKm > 0 ? _realRoadKm : km * 1.35;
    const fare   = fareFor(roadKm);
    const eta    = _realEtaMin > 0 ? _realEtaMin : etaMin(km);
    const pax    = document.getElementById('l-passengers').value;
    const pay    = document.querySelector('input[name="l-payment"]:checked').value;
    const notes  = document.getElementById('l-notes').value.trim();

    localBtn.disabled = true;
    localBtn.classList.remove('ready');
    localBtn.textContent = 'جاري إرسال الطلب...';

    const ride = await sbCreateRide({
      customer_phone: phone, customer_name: name,
      from_area: from.name, from_lat: from.lat, from_lng: from.lng,
      to_area: to.name, to_lat: to.lat, to_lng: to.lng,
      distance_km: roadKm, fare, eta_minutes: eta,
      passengers: parseInt(pax), payment: pay, notes,
      status: 'pending', ride_type: 'local',
    });
    activeRideId = ride?.id || null;

    try {
      const _ru = JSON.parse(localStorage.getItem('wslha_user') || '{}');
      const _rk = _ru.phone ? 'wslha_orders_' + _ru.phone : 'wslha_orders';
      const orders = JSON.parse(localStorage.getItem(_rk) || '[]');
      orders.unshift({ id: ride?.id || ('R'+Date.now()), type:'ride', icon:'🚗', route:from.name+' → '+to.name, price:fare+' ج.م', from:from.name, to:to.name, name, phone, passengers:pax, payment:pay, fare, eta, distance: roadKm.toFixed(1), status:'pending', createdAt:new Date().toISOString() });
      localStorage.setItem(_rk, JSON.stringify(orders));
    } catch {}

    localBtn.disabled = false;
    localBtn.classList.add('ready');
    localBtn.textContent = '🚗 تأكيد الطلب وتتبع الرحلة';

    document.getElementById('ride-status').classList.add('visible');
    document.getElementById('st-confirmed-time').textContent = new Date().toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
    document.getElementById('st-confirmed').className = 'status-step done';
    document.getElementById('st-assigned').className  = 'status-step active';

    _currentFrom = from; _currentTo = to; _currentEta = eta;
    _driverShown = false; _onRide = false;
    window._st_assigned = window._st_arrived = window._st_onride = false;
    if (window._liveInterval) clearInterval(window._liveInterval);

    showRoute(from, to);
    showSearching(from.name, to.name, fare);

    if (activeRideId) {
      subscribeRideStatus(activeRideId);

      // After 30s with no driver acceptance → try to assign from available drivers in DB
      window._driverFallbackTimer = setTimeout(async () => {
        if (_driverShown) return;
        const assigned = await findAndAssignDriver(activeRideId);
        if (assigned && !_driverShown) {
          // A real driver was assigned as fallback
          _driverShown = true;
          showDriverFound(assigned);
          if (window._routeCoords && _currentFrom && _currentTo)
            startLiveTracking(_currentFrom, _currentTo, _currentEta);
        } else if (!_driverShown) {
          // No drivers available — update searching screen
          const titleEl = document.querySelector('#searching-card .search-title');
          const subEl   = document.querySelector('#searching-card .search-sub');
          if (titleEl) titleEl.textContent = 'جاري البحث عن سائق...';
          if (subEl)   subEl.textContent   = 'لا يوجد سائقون متاحون حالياً، سيتم الإشعار عند توفر أحدهم';
        }
      }, 30000);
    } else {
      // ride creation failed — no activeRideId
      showToast('تعذر إرسال الطلب، تحقق من الاتصال وحاول مرة أخرى');
      setTimeout(() => resetToBooking(), 2500);
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ═══════════════════════════════════════════
  //  INTERNATIONAL / AIRPORT FORM
  // ═══════════════════════════════════════════
  const intlAirportSel = document.getElementById('intl-airport');
