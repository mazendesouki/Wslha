  async function initMap() {
    if (map) return true;
    try {
      await loadGoogleMaps();
      document.getElementById('map-placeholder').style.display = 'none';
      document.getElementById('ride-map').style.display = 'block';
      const G = window.google.maps;
      map = new G.Map(document.getElementById('ride-map'), {
        center: { lat: 31.392, lng: 31.755 }, zoom: 13,
        mapTypeControl: false, fullscreenControl: false, streetViewControl: false,
        styles: [
          { featureType: 'poi', elementType: 'labels', stylers: [{ visibility: 'off' }] },
          { featureType: 'transit', stylers: [{ visibility: 'off' }] },
        ],
      });
      gmapsReady = true;

      // Map click → pin mode (inDrive style)
      map.addListener('click', async (e) => {
        if (!pinMode) return;
        const G = window.google.maps;
        const lat = e.latLng.lat(), lng = e.latLng.lng();
        if (pinMarker) pinMarker.setMap(null);
        const color = pinMode === 'from' ? '#3b82f6' : '#ef4444';
        pinMarker = new G.Marker({
          position: { lat, lng }, map, zIndex: 9999,
          animation: G.Animation.DROP,
          icon: {
            path: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z',
            fillColor: color, fillOpacity: 1, strokeColor: '#fff', strokeWeight: 2,
            scale: 2, anchor: new G.Point(12, 22),
          },
        });
        document.getElementById('btn-pin-confirm').disabled = false;
        document.getElementById('pin-mode-label').textContent =
          pinMode === 'from' ? '📍 نقطة الانطلاق محددة — اضغط تأكيد' : '📍 الوجهة محددة — اضغط تأكيد';
      });

      // Add all New Damietta landmarks
      addLandmarkMarkers();
      return true;
    } catch {
      document.getElementById('map-placeholder').innerHTML =
        '<span style="font-size:2rem;margin-bottom:8px">🗺️</span>' +
        '<span>الخريطة غير متاحة<br>' +
        '<span style="font-size:11px;color:#9ca3af;">المسافة والسعر محسوبان بدقة</span></span>';
      return false;
    }
  }

  function clearMap() {
    [fromMarker, toMarker, driverMarker].forEach(m => m && m.setMap(null));
    fromMarker = toMarker = driverMarker = null;
    if (routeRenderer) { routeRenderer.setMap(null); routeRenderer = null; }
  }

  function gMarker(lat, lng, label, color, title) {
    const G = window.google.maps;
    return new G.Marker({
      position: { lat, lng }, map, title,
      icon: { path: G.SymbolPath.CIRCLE, fillColor: color, fillOpacity: 1, strokeColor: '#fff', strokeWeight: 3, scale: 11 },
      label: { text: label, color: '#fff', fontSize: '13px', fontWeight: 'bold' },
    });
  }

  async function showRoute(from, to) {
    const ok = await initMap();
    if (!ok) return;
    clearMap();

    const G = window.google.maps;
    fromMarker = gMarker(from.lat, from.lng, 'A', '#3b82f6', 'الانطلاق: ' + from.name);
    toMarker   = gMarker(to.lat,   to.lng,   'B', '#ef4444', 'الوصول: '  + to.name);

    try {
      routeRenderer = new G.DirectionsRenderer({
        map, suppressMarkers: true,
        polylineOptions: { strokeColor: '#3b82f6', strokeWeight: 5, strokeOpacity: 0.85 },
      });
      const result = await new Promise((res, rej) =>
        new G.DirectionsService().route({
          origin: { lat: from.lat, lng: from.lng },
          destination: { lat: to.lat, lng: to.lng },
          travelMode: G.TravelMode.DRIVING,
        }, (r, s) => s === 'OK' ? res(r) : rej(s))
      );
      routeRenderer.setDirections(result);
      const leg = result.routes[0].legs[0];
      _realRoadKm = leg.distance.value / 1000;
      _realEtaMin = Math.max(1, Math.ceil(leg.duration.value / 60));
      const realFare = fareFor(_realRoadKm);
      document.getElementById('sum-dist').textContent  = _realRoadKm.toFixed(1) + ' كم';
      document.getElementById('sum-eta').textContent   = _realEtaMin + ' دق';
      document.getElementById('sum-price').textContent = realFare + ' ج.م';
      const bkEl = document.getElementById('fare-breakdown');
      if (bkEl) bkEl.innerHTML = fareBreakdown(_realRoadKm);
      window._routeCoords = result.routes[0].overview_path.map(p => ({ lat: p.lat(), lng: p.lng() }));
    } catch {
      const bounds = new G.LatLngBounds({ lat: from.lat, lng: from.lng }, { lat: to.lat, lng: to.lng });
      map.fitBounds(bounds);
    }
  }

  // ── live simulation ──
  function startLiveTracking(from, to, etaMinutes) {
    if (!gmapsReady || !map) return;
    if (driverMarker) driverMarker.setMap(null);
    const coords = window._routeCoords || [{ lat: from.lat, lng: from.lng }, { lat: to.lat, lng: to.lng }];
    const totalSteps = coords.length;
    let step = 0;

    const G = window.google.maps;
    driverMarker = new G.Marker({
      position: coords[0], map, title: 'السائق', zIndex: 999,
      icon: { path: G.SymbolPath.FORWARD_CLOSED_ARROW, fillColor: '#16a34a', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 2, scale: 7 },
    });
    document.getElementById('live-badge').style.display = 'inline-flex';

    const msPerStep = Math.max(1500, (etaMinutes * 60 * 1000) / totalSteps);
    window._liveInterval = setInterval(() => {
      if (step >= totalSteps - 1) {
        clearInterval(window._liveInterval);
        setTimeout(() => advanceStatus('done'), 1000);
        return;
      }
      step++;
      driverMarker.setPosition(coords[step]);
      const pct = step / (totalSteps - 1);
      if (pct >= 0.05 && !window._st_assigned) { window._st_assigned = true; advanceStatus('assigned'); }
      if (pct >= 0.15 && !window._st_arrived)  { window._st_arrived = true;  advanceStatus('arrived'); }
      if (pct >= 0.20 && !window._st_onride)   { window._st_onride  = true;  advanceStatus('onride'); }
    }, msPerStep);
  }

  function advanceStatus(stage) {
    const now = new Date().toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
    if (stage === 'assigned') {
      document.getElementById('st-confirmed').className = 'status-step done';
      document.getElementById('st-assigned').className  = 'status-step active';
    }
    if (stage === 'arrived') {
      document.getElementById('st-assigned').className  = 'status-step done';
      document.getElementById('st-arrived').className   = 'status-step active';
      document.getElementById('st-arrived-time').textContent = now;
    }
    if (stage === 'onride') {
      document.getElementById('st-arrived').className   = 'status-step done';
      document.getElementById('st-onride').className    = 'status-step active';
      document.getElementById('st-onride-time').textContent = now;
    }
    if (stage === 'done') {
      document.getElementById('st-onride').className    = 'status-step done';
      document.getElementById('st-done').className      = 'status-step done';
      document.getElementById('st-done-time').textContent = now;
      document.getElementById('live-badge').style.display = 'none';
    }
  }

  // ── ride state ──
  let activeRideId  = null;
  let ridePoller    = null;   // fallback REST poll
  let _rideChannel  = null;   // Supabase Realtime channel
  let _currentFrom = null, _currentTo = null, _currentEta = 0;
  let _driverShown = false, _onRide = false;

  async function sbCreateRide(payload) {
    try {
      const res = await fetch(`${SB_URL}/rest/v1/rides`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify(payload),
      });
      const rows = await res.json();
      return Array.isArray(rows) ? rows[0] : null;
    } catch { return null; }
  }

  /* ── Auto-assign real driver from accounts table ── */
  async function findAndAssignDriver(rideId) {
    try {
      const res = await fetch(
        `${SB_URL}/rest/v1/accounts?role=eq.driver&or=(status.eq.active,status.eq.approved)&select=name,phone,city&order=created_at.asc&limit=20`,
        { headers: SB_H }
      );
      if (!res.ok) return null;
      const drivers = await res.json();
      if (!Array.isArray(drivers) || drivers.length === 0) return null;

      // Pick a random available driver for fairness
      const driver = drivers[Math.floor(Math.random() * drivers.length)];
      const driverName  = driver.name  || 'السائق';
      const driverPhone = driver.phone || '';

      const patchRes = await fetch(`${SB_URL}/rest/v1/rides?id=eq.${rideId}`, {
        method: 'PATCH',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify({ driver_name: driverName, driver_phone: driverPhone, status: 'accepted' }),
      });
      if (!patchRes.ok) return null;
      const rows = await patchRes.json();
      return Array.isArray(rows) ? rows[0] : null;
    } catch { return null; }
  }

  async function sbCancelRide(id) {
    try {
      await fetch(`${SB_URL}/rest/v1/rides?id=eq.${id}`, {
        method: 'PATCH',
        headers: { ...SB_H, Prefer: 'return=minimal' },
        body: JSON.stringify({ status: 'cancelled' }),
      });
    } catch {}
  }

  async function pollRideStatus() {
    if (!activeRideId) return;
    try {
      const res = await fetch(`${SB_URL}/rest/v1/rides?id=eq.${activeRideId}&select=*`, { headers: SB_H });
      const rows = await res.json();
      if (!Array.isArray(rows) || rows.length === 0) return;
      handleRideUpdate(rows[0]);
    } catch {}
  }

  let _locationChannel = null;

  function stopPoller() {
    if (ridePoller) { clearInterval(ridePoller); ridePoller = null; }
    if (_rideChannel) { _rideChannel.unsubscribe(); _rideChannel = null; }
    if (_locationChannel) { _locationChannel.unsubscribe(); _locationChannel = null; }
    clearInterval(window._locPoller); window._locPoller = null;
  }

  function updateRealDriverMarker(lat, lng) {
    if (!lat || !lng) return;
    // Stop the simulated animation — real GPS takes over
    if (window._liveInterval) { clearInterval(window._liveInterval); window._liveInterval = null; }
    const G = window.google?.maps;
    if (!G || !map) return;
    const pos = { lat: Number(lat), lng: Number(lng) };
    if (driverMarker) {
      driverMarker.setPosition(pos);
    } else {
      driverMarker = new G.Marker({
        position: pos, map, title: 'السائق', zIndex: 999,
        icon: { path: G.SymbolPath.FORWARD_CLOSED_ARROW, fillColor: '#16a34a', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 2, scale: 7 },
      });
      document.getElementById('live-badge').style.display = 'inline-flex';
    }
  }

  function subscribeDriverLocation(driverPhone) {
    if (!driverPhone) return;
    async function pollLocation() {
      try {
        const p = encodeURIComponent(driverPhone);
        const res = await fetch(`${SB_URL}/rest/v1/driver_locations?driver_phone=eq.${p}&select=lat,lng&limit=1`, { headers: SB_H });
        const rows = await res.json();
        if (Array.isArray(rows) && rows[0]) updateRealDriverMarker(rows[0].lat, rows[0].lng);
      } catch {}
    }
    function tryLocRealtime() {
      if (!_sb) {
        window._locPoller = setInterval(pollLocation, 3000);
        return;
      }
      _locationChannel = _sb.channel('loc-' + driverPhone)
        .on('postgres_changes', { event: '*', schema: 'public', table: 'driver_locations',
          filter: `driver_phone=eq.${driverPhone}` },
          payload => { const l = payload.new; if (l?.lat && l?.lng) updateRealDriverMarker(l.lat, l.lng); })
        .subscribe(status => {
          if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
            if (!window._locPoller) window._locPoller = setInterval(pollLocation, 3000);
          }
          if (status === 'SUBSCRIBED') { clearInterval(window._locPoller); window._locPoller = null; }
        });
    }
    if (_sb) tryLocRealtime();
    else setTimeout(tryLocRealtime, 1500);
    // Initial fetch immediately
    pollLocation();
  }

  function handleRideUpdate(ride) {
    if ((ride.status === 'accepted' || ride.status === 'arrived' || ride.status === 'in_progress' || ride.status === 'completed') && !_driverShown) {
      _driverShown = true;
      showDriverFound(ride);
    }
    if (ride.status === 'arrived' && !window._st_arrived) {
      window._st_arrived = true;
      advanceStatus('arrived');
      document.getElementById('driver-card-status').textContent = 'السائق وصل إليك 📍';
    }
    if (ride.status === 'in_progress' && !_onRide) {
      _onRide = true;
      document.getElementById('driver-card-status').textContent = 'في الطريق للوجهة 🚗';
      advanceStatus('onride');
    }
    if (ride.status === 'completed') {
      stopPoller();
      advanceStatus('done');
      setTimeout(() => showRatingScreen(ride), 1800);
    }
    if (ride.status === 'cancelled') {
      stopPoller();
      resetToBooking();
    }
  }

  function subscribeRideStatus(rideId) {
    stopPoller();
    if (!rideId) return;

    function tryRealtime() {
      if (!_sb) { ridePoller = setInterval(pollRideStatus, 2500); return; }
      _rideChannel = _sb.channel(`ride-${rideId}`)
        .on('postgres_changes', {
          event: 'UPDATE', schema: 'public', table: 'rides',
          filter: `id=eq.${rideId}`,
        }, payload => handleRideUpdate(payload.new))
        .subscribe(status => {
          if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
            // Realtime فشل → fallback polling
            if (!ridePoller) ridePoller = setInterval(pollRideStatus, 2500);
          }
          if (status === 'SUBSCRIBED') {
            clearInterval(ridePoller); ridePoller = null;
          }
        });
    }

    if (_sb) tryRealtime();
    else setTimeout(tryRealtime, 1500);
  }

  let _searchWaitInterval = null;
  function startSearchWaitTimer() {
    stopSearchWaitTimer();
    const start = Date.now();
    const banner = document.getElementById('search-wait-banner');
    const text = document.getElementById('search-wait-text');
    function tick() {
      const e = Math.floor((Date.now() - start) / 1000);
      const m = Math.floor(e / 60), s = e % 60;
      text.textContent = `${m}:${String(s).padStart(2,'0')}`;
      if (e >= 60) banner.style.display = 'block';
    }
    tick();
    _searchWaitInterval = setInterval(tick, 1000);
    setTimeout(() => { if (banner) banner.style.display = 'block'; }, 60000);
  }
  function stopSearchWaitTimer() {
    if (_searchWaitInterval) { clearInterval(_searchWaitInterval); _searchWaitInterval = null; }
    const banner = document.getElementById('search-wait-banner');
    if (banner) banner.style.display = 'none';
  }

  function showSearching(fromName, toName, fare) {
    document.getElementById('booking-card').style.display = 'none';
    document.getElementById('success-card').classList.remove('visible');
    document.getElementById('driver-card').classList.remove('visible');
    document.getElementById('searching-card').classList.add('visible');
    document.getElementById('fare-section').style.display = 'none';
    document.getElementById('search-from').textContent = fromName;
    document.getElementById('search-to').textContent   = toName;
    document.getElementById('search-fare').textContent  = fare + ' ج.م';
    startSearchWaitTimer();
  }

  function showDriverFound(ride) {
    stopSearchWaitTimer();
    document.getElementById('searching-card').classList.remove('visible');
    const card = document.getElementById('driver-card');
    card.classList.add('visible');
    document.getElementById('driver-card-name').textContent    = ride.driver_name  || 'السائق';
    document.getElementById('driver-card-status').textContent  = 'السائق في الطريق إليك 🚗';
    document.getElementById('driver-call-btn').setAttribute('href', 'tel:' + (ride.driver_phone || ''));
    document.getElementById('driver-card-from').textContent = ride.from_area;
    document.getElementById('driver-card-to').textContent   = ride.to_area;
    document.getElementById('driver-card-fare').textContent = ride.fare;
    advanceStatus('assigned');
    // Subscribe to real GPS from driver_locations
    if (ride.driver_phone) subscribeDriverLocation(ride.driver_phone);
    if (window._routeCoords && _currentFrom && _currentTo) {
      startLiveTracking(_currentFrom, _currentTo, _currentEta);
    }
  }

  let _selectedRating = 0;

  function showRatingScreen(ride) {
    document.getElementById('driver-card').classList.remove('visible');
    document.getElementById('ride-status').classList.remove('visible');
    window._completedRide = ride;
    _selectedRating = 0;
    document.querySelectorAll('.star-btn').forEach(b => { b.textContent = '☆'; });
    document.getElementById('submit-rating-btn').disabled = true;
    document.getElementById('rating-comment').value = '';
    document.getElementById('rating-driver-name').textContent = ride.driver_name ? `قيّم تجربتك مع ${ride.driver_name}` : 'قيّم تجربتك مع السائق';

    const payEl = document.getElementById('payment-reminder');
    if (ride.payment === 'wallet') {
      payEl.innerHTML = `💳 يرجى إرسال <strong>${ride.fare} ج.م</strong> للسائق عبر فودافون كاش / إنستاباي`;
      payEl.style.display = '';
    } else {
      payEl.innerHTML = `💵 يرجى دفع <strong>${ride.fare} ج.م</strong> نقداً للسائق`;
      payEl.style.display = '';
    }
    document.getElementById('rating-card').style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showSuccessAfterRating(ride) {
    document.getElementById('rating-card').style.display = 'none';
    const now = new Date().toLocaleDateString('ar-EG', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' });
    document.getElementById('receipt-datetime').textContent = now;
    document.getElementById('receipt-route-from').textContent = ride.from_area || '—';
    document.getElementById('receipt-route-to').textContent = ride.to_area || '—';
    const gridItems = [
      { label: 'مدة الرحلة', value: (ride.eta_minutes || '—') + ' دقيقة' },
      { label: 'المسافة', value: (ride.distance_km ? (ride.distance_km * 1.35).toFixed(1) : '—') + ' كم' },
      { label: 'السائق', value: ride.driver_name || '—' },
      { label: 'طريقة الدفع', value: ride.payment === 'wallet' ? '💳 محفظة' : '💵 نقدي' },
    ];
    document.getElementById('receipt-details-grid').innerHTML = gridItems
      .map(i => `<div style="background:#f8fafc;border-radius:10px;padding:.75rem;text-align:center"><div style="font-size:.7rem;color:#9ca3af;margin-bottom:4px">${i.label}</div><div style="font-size:.875rem;font-weight:700">${i.value}</div></div>`)
      .join('');
    document.getElementById('receipt-total-fare').textContent = (ride.fare || '—') + ' ج.م';
    document.getElementById('receipt-fare-section').style.display = '';
    document.getElementById('success-details').innerHTML = '';
    document.getElementById('success-card').classList.add('visible');
  }

  document.querySelectorAll('.star-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      _selectedRating = Number(btn.dataset.val);
      document.querySelectorAll('.star-btn').forEach((b, i) => {
        b.textContent = i < _selectedRating ? '⭐' : '☆';
      });
      document.getElementById('submit-rating-btn').disabled = false;
    });
  });

  document.getElementById('submit-rating-btn').addEventListener('click', async () => {
    const ride = window._completedRide;
    if (!ride || !_selectedRating) return;
    try {
      await fetch(`${SB_URL}/rest/v1/ratings`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=minimal' },
        body: JSON.stringify({
          id: 'rat-' + Date.now(),
          driver_phone: ride.driver_phone || '',
          customer_phone: ride.customer_phone || '',
          rating: _selectedRating,
          comment: document.getElementById('rating-comment').value.trim() || null,
          service_type: 'ride',
          ride_id: ride.id,
          created_at: new Date().toISOString(),
        }),
      });
    } catch {}
    showSuccessAfterRating(ride);
  });

  document.getElementById('skip-rating-btn').addEventListener('click', () => {
    if (window._completedRide) showSuccessAfterRating(window._completedRide);
  });

  function resetToBooking() {
    stopPoller();
    stopSearchWaitTimer();
    if (window._driverFallbackTimer) { clearTimeout(window._driverFallbackTimer); window._driverFallbackTimer = null; }
    activeRideId = null; _driverShown = false; _onRide = false;
    window._completedRide = null; _selectedRating = 0;
    if (window._liveInterval) { clearInterval(window._liveInterval); window._liveInterval = null; }
    document.getElementById('rating-card').style.display = 'none';
    document.getElementById('success-card').classList.remove('visible');
    document.getElementById('searching-card').classList.remove('visible');
    document.getElementById('driver-card').classList.remove('visible');
    document.getElementById('booking-card').style.display = '';
    document.getElementById('ride-status').classList.remove('visible');
    document.getElementById('fare-section').style.display = '';
    document.getElementById('live-badge').style.display = 'none';
    ['st-confirmed','st-assigned','st-arrived','st-onride','st-done']
      .forEach(id => document.getElementById(id).className = 'status-step');
    window._st_assigned = window._st_arrived = window._st_onride = false;
    document.querySelectorAll('.star-btn').forEach(b => { b.textContent = '☆'; });
    document.getElementById('submit-rating-btn').disabled = true;
  }

  document.getElementById('cancel-ride-btn').addEventListener('click', async () => {
    if (activeRideId) await sbCancelRide(activeRideId);
    resetToBooking();
    clearMap();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

