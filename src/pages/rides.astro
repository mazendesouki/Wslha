    const list = q
      ? PLACES.filter(p => p.name.toLowerCase().includes(q) || (p.address || '').toLowerCase().includes(q))
      : PLACES.filter(p => p.popular).concat(PLACES.filter(p => !p.popular)).slice(0, 40);

    if (!list.length) {
      qpList.innerHTML = '<div class="ac-empty">لا توجد نتائج لـ «' + query + '»</div>';
      return;
    }

    const header = q
      ? `<div class="ac-section-hdr">نتائج البحث (${list.length})</div>`
      : '<div class="ac-section-hdr">⭐ الأماكن الشائعة</div>';

    qpList.innerHTML = header + list.map(p => {
      const color = CATEGORY_COLORS[p.category] || '#9ca3af';
      return `<div class="ac-item" role="button" tabindex="0"
          data-lat="${p.lat}" data-lng="${p.lng}" data-name="${p.name}">
          <div class="ac-icon-box" style="background:${color}22">
            <span style="font-size:1.2rem">${p.emoji || '📍'}</span>
          </div>
          <div class="ac-text">
