  const intlBtn        = document.getElementById('intl-confirm-btn');
  const intlHint       = document.getElementById('intl-hint');

  function selectedAirport() {
    const o = intlAirportSel.options[intlAirportSel.selectedIndex];
    if (!o?.value) return null;
    // strip fare from display name to get clean name
    const cleanName = o.value === 'port-said'  ? 'مطار بورسعيد' :
                      o.value === 'cairo'       ? 'مطار القاهرة الدولي' :
                      o.value === 'alex'        ? 'مطار برج العرب (إسكندرية)' :
                      o.value === 'sharm'       ? 'مطار شرم الشيخ' :
                      o.value === 'hurghada'    ? 'مطار الغردقة' : 'مطار الأقصر';
    return {
      id: o.value, name: cleanName,
      flatFare: Number(o.dataset.fare),
      driveMins: Number(o.dataset.mins),
      lat: Number(o.dataset.lat), lng: Number(o.dataset.lng),
    };
  }

