    { id: 'cafe',       label: '☕ كافيهات',      type: 'cafe'              },
    { id: 'restaurant', label: '🍕 مطاعم',         type: 'restaurant'        },
    { id: 'hospital',   label: '🏥 مستشفيات',      type: 'hospital'          },
    { id: 'bank',       label: '🏦 بنوك',           type: 'bank'              },
    { id: 'pharmacy',   label: '💊 صيدليات',        type: 'pharmacy'          },
    { id: 'grocery',    label: '🛒 سوبرماركت',      type: 'grocery_or_supermarket' },
    { id: 'beach',      label: '🏖️ شواطئ',          type: 'natural_feature'   },
    { id: 'school',     label: '🎓 جامعات ومدارس', type: 'school'            },
    { id: 'park',       label: '🌳 حدائق',          type: 'park'              },
