  // ── distance & pricing helpers (أسعار 2026 — محدّث مع ارتفاع الوقود) ──
  const BASE_FARE   = 25;   // ج.م — عداد الانطلاق
  const RATE_PER_KM = 12;   // ج.م / كم — طريق فعلي
  const MIN_FARE    = 35;   // ج.م — الحد الأدنى

  function haversineKm(lat1, lng1, lat2, lng2) {
    const R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
    const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)**2;
    return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
  }
  // roadKm = المسافة الفعلية على الطريق (من OSRM)، أو haversine×1.35 كتقدير
  function fareFor(roadKm) {
    return Math.ceil(Math.max(BASE_FARE + roadKm * RATE_PER_KM, MIN_FARE) / 5) * 5;
  }
  function fareBreakdown(roadKm) {
    const dist   = +(roadKm).toFixed(1);
    const distCost = +(roadKm * RATE_PER_KM).toFixed(0);
    const total  = fareFor(roadKm);
    return `<span style="color:var(--color-text-faint);font-size:11px;">عداد ${BASE_FARE} + ${dist}كم × ${RATE_PER_KM} = <strong style="color:#16a34a">${total} ج.م</strong></span>`;
  }
  function etaMin(km)  { return Math.ceil(km * 1.35 / 40 * 60); }
  function normPhone(s){ return s.replace(/[\s\-()+]/g,''); }
  const EG = /^01[0125][0-9]{8}$/;

  // real road distance from OSRM (updated after route fetch)
  let _realRoadKm = 0;
  let _realEtaMin = 0;

  // ── Google Maps setup ──
  const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';
