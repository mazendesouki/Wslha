      <div class="how-step"><div class="how-step__icon">💰</div><div class="how-step__title">السعر فوري</div><div class="how-step__desc">شفاف وثابت</div></div>
      <div class="how-step"><div class="how-step__icon">🚗</div><div class="how-step__title">السائق قادم</div><div class="how-step__desc">تتبع الرحلة مباشرة</div></div>
