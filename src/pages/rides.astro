  // ── Map pin mode (inDrive-style tap-to-pick) ──────────────────────────
  let pinMode = null; // 'from' | 'to' | null
  let pinMarker = null;

  function activatePinMode(mode) {
    pinMode = mode;
    qpMode = mode;
    // show pin overlay
    document.getElementById('pin-overlay').style.display = 'flex';
    document.getElementById('pin-mode-label').textContent =
      mode === 'from' ? '📍 اضغط لتحديد نقطة الانطلاق' : '📍 اضغط لتحديد الوجهة';
    document.getElementById('btn-pin-confirm').disabled = true;
    // ensure map is visible
    initMap();
  }

  function deactivatePinMode() {
    pinMode = null;
