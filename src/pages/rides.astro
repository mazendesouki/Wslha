  function clearMap() {
    [fromMarker, toMarker, driverMarker].forEach(m => m && m.setMap(null));
    fromMarker = toMarker = driverMarker = null;
    if (routeRenderer) { routeRenderer.setMap(null); routeRenderer = null; }
  }

  function gMarker(lat, lng, label, color, title) {
    const G = window.google.maps;
    return new G.Marker({
      position: { lat, lng }, map, title,
      icon: { path: G.SymbolPath.CIRCLE, fillColor: color, fillOpacity: 1, strokeColor: '#fff', strokeWeight: 3, scale: 11 },
      label: { text: label, color: '#fff', fontSize: '13px', fontWeight: 'bold' },
    });
  }

  async function showRoute(from, to) {
    const ok = await initMap();
    if (!ok) return;
    clearMap();

    const G = window.google.maps;
    fromMarker = gMarker(from.lat, from.lng, 'A', '#3b82f6', 'الانطلاق: ' + from.name);
    toMarker   = gMarker(to.lat,   to.lng,   'B', '#ef4444', 'الوصول: '  + to.name);

    try {
      routeRenderer = new G.DirectionsRenderer({
        map, suppressMarkers: true,
        polylineOptions: { strokeColor: '#3b82f6', strokeWeight: 5, strokeOpacity: 0.85 },
      });
      const result = await new Promise((res, rej) =>
        new G.DirectionsService().route({
          origin: { lat: from.lat, lng: from.lng },
          destination: { lat: to.lat, lng: to.lng },
          travelMode: G.TravelMode.DRIVING,
        }, (r, s) => s === 'OK' ? res(r) : rej(s))
      );
      routeRenderer.setDirections(result);
      const leg = result.routes[0].legs[0];
      _realRoadKm = leg.distance.value / 1000;
      _realEtaMin = Math.max(1, Math.ceil(leg.duration.value / 60));
      const realFare = fareFor(_realRoadKm);
      document.getElementById('sum-dist').textContent  = _realRoadKm.toFixed(1) + ' كم';
      document.getElementById('sum-eta').textContent   = _realEtaMin + ' دق';
      document.getElementById('sum-price').textContent = realFare + ' ج.م';
      const bkEl = document.getElementById('fare-breakdown');
      if (bkEl) bkEl.innerHTML = fareBreakdown(_realRoadKm);
      window._routeCoords = result.routes[0].overview_path.map(p => ({ lat: p.lat(), lng: p.lng() }));
    } catch {
      const bounds = new G.LatLngBounds({ lat: from.lat, lng: from.lng }, { lat: to.lat, lng: to.lng });
      map.fitBounds(bounds);
    }
  }

  // ── live simulation ──
  function startLiveTracking(from, to, etaMinutes) {
    if (!gmapsReady || !map) return;
    if (driverMarker) driverMarker.setMap(null);
    const coords = window._routeCoords || [{ lat: from.lat, lng: from.lng }, { lat: to.lat, lng: to.lng }];
    const totalSteps = coords.length;
    let step = 0;

    const G = window.google.maps;
    driverMarker = new G.Marker({
      position: coords[0], map, title: 'السائق', zIndex: 999,
      icon: { path: G.SymbolPath.FORWARD_CLOSED_ARROW, fillColor: '#16a34a', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 2, scale: 7 },
    });
    document.getElementById('live-badge').style.display = 'inline-flex';

    const msPerStep = Math.max(1500, (etaMinutes * 60 * 1000) / totalSteps);
    window._liveInterval = setInterval(() => {
      if (step >= totalSteps - 1) {
        clearInterval(window._liveInterval);
        setTimeout(() => advanceStatus('done'), 1000);
        return;
      }
      step++;
      driverMarker.setPosition(coords[step]);
      const pct = step / (totalSteps - 1);
      if (pct >= 0.05 && !window._st_assigned) { window._st_assigned = true; advanceStatus('assigned'); }
      if (pct >= 0.15 && !window._st_arrived)  { window._st_arrived = true;  advanceStatus('arrived'); }
      if (pct >= 0.20 && !window._st_onride)   { window._st_onride  = true;  advanceStatus('onride'); }
    }, msPerStep);
  }

  function advanceStatus(stage) {
    const now = new Date().toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
    if (stage === 'assigned') {
      document.getElementById('st-confirmed').className = 'status-step done';
      document.getElementById('st-assigned').className  = 'status-step active';
    }
    if (stage === 'arrived') {
      document.getElementById('st-assigned').className  = 'status-step done';
      document.getElementById('st-arrived').className   = 'status-step active';
      document.getElementById('st-arrived-time').textContent = now;
    }
    if (stage === 'onride') {
      document.getElementById('st-arrived').className   = 'status-step done';
      document.getElementById('st-onride').className    = 'status-step active';
      document.getElementById('st-onride-time').textContent = now;
    }
    if (stage === 'done') {
      document.getElementById('st-onride').className    = 'status-step done';
      document.getElementById('st-done').className      = 'status-step done';
      document.getElementById('st-done-time').textContent = now;
      document.getElementById('live-badge').style.display = 'none';
    }
  }

  // ── ride state ──
  let activeRideId  = null;
  let ridePoller    = null;   // fallback REST poll
  let _rideChannel  = null;   // Supabase Realtime channel
  let _currentFrom = null, _currentTo = null, _currentEta = 0;
  let _driverShown = false, _onRide = false;

  async function sbCreateRide(payload) {
    try {
      const res = await fetch(`${SB_URL}/rest/v1/rides`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify(payload),
      });
      const rows = await res.json();
      return Array.isArray(rows) ? rows[0] : null;
    } catch { return null; }
  }

  async function sbCancelRide(id) {
    try {
      await fetch(`${SB_URL}/rest/v1/rides?id=eq.${id}`, {
        method: 'PATCH',
        headers: { ...SB_H, Prefer: 'return=minimal' },
        body: JSON.stringify({ status: 'cancelled' }),
      });
    } catch {}
  }

  async function pollRideStatus() {
    if (!activeRideId) return;
    try {
      const res = await fetch(`${SB_URL}/rest/v1/rides?id=eq.${activeRideId}&select=*`, { headers: SB_H });
      const rows = await res.json();
      if (!Array.isArray(rows) || rows.length === 0) return;
      handleRideUpdate(rows[0]);
    } catch {}
  }

  function stopPoller() {
    if (ridePoller) { clearInterval(ridePoller); ridePoller = null; }
    if (_rideChannel) { _rideChannel.unsubscribe(); _rideChannel = null; }
  }

  function handleRideUpdate(ride) {
    if ((ride.status === 'accepted' || ride.status === 'in_progress' || ride.status === 'completed') && !_driverShown) {
      _driverShown = true;
      showDriverFound(ride);
    }
    if (ride.status === 'in_progress' && !_onRide) {
      _onRide = true;
      document.getElementById('driver-card-status').textContent = 'في الطريق للوجهة 🚗';
      advanceStatus('onride');
    }
    if (ride.status === 'completed') {
      stopPoller();
      advanceStatus('done');
      setTimeout(() => showFinalSuccess(ride), 1800);
    }
    if (ride.status === 'cancelled') {
      stopPoller();
      resetToBooking();
    }
  }

  function subscribeRideStatus(rideId) {
    stopPoller();
    if (!rideId) return;

    function tryRealtime() {
      if (!_sb) { ridePoller = setInterval(pollRideStatus, 2500); return; }
      _rideChannel = _sb.channel(`ride-${rideId}`)
        .on('postgres_changes', {
          event: 'UPDATE', schema: 'public', table: 'rides',
          filter: `id=eq.${rideId}`,
        }, payload => handleRideUpdate(payload.new))
        .subscribe(status => {
          if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
            // Realtime فشل → fallback polling
            if (!ridePoller) ridePoller = setInterval(pollRideStatus, 2500);
          }
          if (status === 'SUBSCRIBED') {
            clearInterval(ridePoller); ridePoller = null;
          }
        });
    }

    if (_sb) tryRealtime();
    else setTimeout(tryRealtime, 1500);
  }

