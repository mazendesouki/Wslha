    intlBtn.disabled = false;
    intlBtn.classList.add('ready');
    intlBtn.textContent = '✈️ تأكيد حجز التوصيل للمطار';

    _currentFrom = fromArea;
    _currentTo   = { id: airport.id, name: airport.name, lat: airport.lat, lng: airport.lng };
    _currentEta  = airport.driveMins;
    _driverShown = false; _onRide = false;
    window._st_assigned = window._st_arrived = window._st_onride = false;
    if (window._liveInterval) clearInterval(window._liveInterval);

    document.getElementById('ride-status').classList.add('visible');
    document.getElementById('st-confirmed-time').textContent = new Date().toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
    document.getElementById('st-confirmed').className = 'status-step done';
    document.getElementById('st-assigned').className  = 'status-step active';

    showRoute(fromArea, _currentTo);
    showSearching(fromArea.name, airport.name, airport.flatFare);

    if (activeRideId) {
      subscribeRideStatus(activeRideId);

      window._driverFallbackTimer = setTimeout(async () => {
        if (_driverShown) return;
        const assigned = await findAndAssignDriver(activeRideId);
        if (assigned && !_driverShown) {
          _driverShown = true;
          showDriverFound(assigned);
          if (window._routeCoords && _currentFrom && _currentTo)
            startLiveTracking(_currentFrom, _currentTo, _currentEta);
        } else if (!_driverShown) {
          const subEl = document.querySelector('#searching-card .search-sub');
          if (subEl) subEl.textContent = 'لا يوجد سائقون متاحون حالياً، سيتم الإشعار عند توفر أحدهم';
        }
      }, 30000);
    } else {
      showToast('تعذر إرسال الطلب، تحقق من الاتصال وحاول مرة أخرى');
      setTimeout(() => resetToBooking(), 2500);
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ── new ride ──
  document.getElementById('new-ride-btn').addEventListener('click', () => {
    ['l-name','l-phone','l-notes','i-name','i-phone','i-notes'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
    fromPlace = null; toPlace = null; intlOriginPlace = null;
    document.getElementById('from-area').value = '';
    document.getElementById('to-area').value = '';
    document.getElementById('intl-from-area').value = '';
    document.getElementById('success-card').classList.remove('visible');
    clearMap();
    resetToBooking();
    updateUI();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ═══════════════════════════════════════════
  //  FARE GUIDE (switches with type)
  // ═══════════════════════════════════════════
  const fareSection = document.getElementById('fare-section');
  const fareGrid    = document.getElementById('fare-grid');

  function renderFareGuide(isIntl) {
    fareGrid.innerHTML = '';
    if (isIntl) {
      fareSection.querySelector('h2').textContent = 'أسعار توصيل المطارات 2026';
      AIRPORTS.forEach(a => {
        fareGrid.insertAdjacentHTML('beforeend',
          `<div class="fare-card">
            <div class="fare-card__route">
              <div class="fare-card__from">✈️ ${a.name.replace(' ✈️','')}</div>
              <div class="fare-card__to">⏱ ${a.driveMins} دقيقة تقريباً</div>
            </div>
            <div class="fare-card__price">${a.flatFare.toLocaleString('ar-EG')} ج.م</div>
          </div>`
        );
      });
      fareSection.querySelector('p') && (fareSection.querySelector('p').textContent = 'سعر ثابت شامل من محافظة دمياط — لا توجد رسوم إضافية');
    } else {
      fareSection.querySelector('h2').textContent = 'دليل الأسعار المحلية 2026';
      const SAMPLE = [
        { from: 'وسط دمياط',       to: 'دمياط الجديدة',    km: 5.5 },
        { from: 'وسط دمياط',       to: 'رأس البر',          km: 12.0 },
        { from: 'وسط دمياط',       to: 'كفر سعد',           km: 8.0 },
        { from: 'وسط دمياط',       to: 'فارسكور',           km: 11.5 },
        { from: 'دمياط الجديدة',   to: 'رأس البر',          km: 9.5 },
        { from: 'وسط دمياط',       to: 'الزرقا',            km: 14.0 },
        { from: 'وسط دمياط',       to: 'منية النصر',        km: 18.0 },
        { from: 'دمياط الجديدة',   to: 'كفر سعد',           km: 6.5 },
      ];
      SAMPLE.forEach(({ from, to, km }) => {
        const fare = fareFor(km);
        fareGrid.insertAdjacentHTML('beforeend',
          `<div class="fare-card">
            <div class="fare-card__route">
              <div class="fare-card__from">${from}</div>
              <div class="fare-card__to">← ${to}</div>
              <div style="font-size:10px;color:var(--color-text-faint);margin-top:2px;">~${km.toFixed(1)} كم</div>
            </div>
            <div class="fare-card__price">${fare} ج.م</div>
          </div>`
        );
      });
      if (fareSection.querySelector('p')) fareSection.querySelector('p').textContent = `أسعار 2026 — عداد ${BASE_FARE} ج.م + ${RATE_PER_KM} ج.م/كم — الحد الأدنى ${MIN_FARE} ج.م`;
    }
  }

  // Initial render: local prices + pricing note
  fareSection.insertAdjacentHTML('afterbegin',
    `<p style="font-size:var(--text-xs);color:var(--color-text-faint);margin-bottom:var(--sp-3);">أسعار 2026 — عداد ${BASE_FARE} ج.م + ${RATE_PER_KM} ج.م/كم — الحد الأدنى ${MIN_FARE} ج.م</p>`
  );
  renderFareGuide(false);
</script>
