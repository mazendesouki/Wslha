  async function confirmPin() {
    if (!pinMarker) return;
    const lat = pinMarker.getPosition().lat();
    const lng = pinMarker.getPosition().lng();
    let name = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
    // reverse geocode
    try {
      const G = window.google.maps;
      const res = await new Promise((ok, fail) =>
        new G.Geocoder().geocode({ location: { lat, lng }, language: 'ar' }, (r, s) => s === 'OK' ? ok(r) : fail())
      );
      if (res[0]) name = res[0].formatted_address;
    } catch {}
    if (pinMode === 'from') {
      fromPlace = { name, lat, lng };
      document.getElementById('from-area').value = name;
    } else {
      toPlace = { name, lat, lng };
      document.getElementById('to-area').value = name;
