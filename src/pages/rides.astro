<script define:vars={{ AIRPORTS, PLACES, CATEGORY_COLORS }}>
  // ── Supabase ──
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' };

  // ── Supabase Realtime ──
  let _sb = null;
  (function loadSbClient() {
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js';
    s.onload = () => { _sb = window.supabase.createClient(SB_URL, SB_KEY); };
    document.head.appendChild(s);
  })();

  // ── distance & pricing helpers (أسعار 2026 — محدّث مع ارتفاع الوقود) ──
  const BASE_FARE   = 25;   // ج.م — عداد الانطلاق
  const RATE_PER_KM = 12;   // ج.م / كم — طريق فعلي
  const MIN_FARE    = 35;   // ج.م — الحد الأدنى

  function haversineKm(lat1, lng1, lat2, lng2) {
    const R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
    const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)**2;
    return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
  }
  // roadKm = المسافة الفعلية على الطريق (من OSRM)، أو haversine×1.35 كتقدير
  function fareFor(roadKm) {
    return Math.ceil(Math.max(BASE_FARE + roadKm * RATE_PER_KM, MIN_FARE) / 5) * 5;
  }
  function fareBreakdown(roadKm) {
    const dist   = +(roadKm).toFixed(1);
    const distCost = +(roadKm * RATE_PER_KM).toFixed(0);
    const total  = fareFor(roadKm);
    return `<span style="color:var(--color-text-faint);font-size:11px;">عداد ${BASE_FARE} + ${dist}كم × ${RATE_PER_KM} = <strong style="color:#16a34a">${total} ج.م</strong></span>`;
  }
  function etaMin(km)  { return Math.ceil(km * 1.35 / 40 * 60); }
  function normPhone(s){ return s.replace(/[\s\-()+]/g,''); }
  const EG = /^01[0125][0-9]{8}$/;

  // real road distance from OSRM (updated after route fetch)
  let _realRoadKm = 0;
  let _realEtaMin = 0;

  // ── Google Maps setup ──
  const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';
  let map = null, fromMarker = null, toMarker = null, routeRenderer = null, driverMarker = null;
  let gmapsReady = false;
  let fromPlace = null; // { name, lat, lng }
  let toPlace   = null; // { name, lat, lng }
  let intlOriginPlace = null; // { name, lat, lng }

  function loadGoogleMaps() {
    return new Promise((resolve) => {
      if (window.google?.maps) { resolve(); return; }
      window.__gmInit = resolve;
      const s = document.createElement('script');
      s.src = `https://maps.googleapis.com/maps/api/js?key=${GMAPS_KEY}&libraries=places&callback=__gmInit&language=ar&region=EG`;
      s.async = true;
      document.head.appendChild(s);
    });
  }

  async function initPlaces() {
    await loadGoogleMaps();
    const G = window.google.maps;

    // ── Full Egypt search — no bounds restriction, all place types ──────
    // Soft bias toward Damietta (non-strict) so nearby results appear first
    // but any place in Egypt can be found (cafes, beaches, shops, banks...)
    const damiettaBias = new G.LatLngBounds(
      { lat: 31.20, lng: 31.50 },
      { lat: 31.65, lng: 32.10 }
    );
    const opts = {
      bounds: damiettaBias,         // soft bias only — user can search anywhere
      componentRestrictions: { country: 'eg' },
      strictBounds: false,          // allow results outside Damietta
      types: [],                    // empty = all types (cafes, stores, streets, everything)
      fields: ['geometry', 'name', 'formatted_address', 'types'],
    };

    const acFrom = new G.places.Autocomplete(document.getElementById('from-area'), opts);
    const acTo   = new G.places.Autocomplete(document.getElementById('to-area'),   opts);

    acFrom.addListener('place_changed', () => {
      const p = acFrom.getPlace();
      if (!p?.geometry?.location) return;
      fromPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
      saveRecentPlace({ name: fromPlace.name, lat: fromPlace.lat, lng: fromPlace.lng });
      updateUI();
    });
    acTo.addListener('place_changed', () => {
      const p = acTo.getPlace();
      if (!p?.geometry?.location) return;
      toPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
      saveRecentPlace({ name: toPlace.name, lat: toPlace.lat, lng: toPlace.lng });
      updateUI();
    });

    const acIntlFrom = new G.places.Autocomplete(document.getElementById('intl-from-area'), {
      bounds: damiettaBias,
      componentRestrictions: { country: 'eg' },
      strictBounds: false,
      types: [],
      fields: ['geometry', 'name', 'formatted_address'],
    });
    acIntlFrom.addListener('place_changed', () => {
      const p = acIntlFrom.getPlace();
      if (!p?.geometry?.location) return;
      intlOriginPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
      updateIntlUI();
    });

    // GPS "my location" button — also reverse-geocodes to real address name
    document.getElementById('btn-my-loc')?.addEventListener('click', () => {
      if (!navigator.geolocation) return;
      const btn = document.getElementById('btn-my-loc');
      btn.textContent = '⏳';
      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          const { latitude: lat, longitude: lng } = pos.coords;
          btn.textContent = '✅';
          // try to get a human-readable address
          let name = 'موقعي الحالي';
          try {
            const geo = new G.Geocoder();
            const res = await new Promise((ok, fail) =>
              geo.geocode({ location: { lat, lng }, language: 'ar' }, (r, s) => s === 'OK' ? ok(r) : fail())
            );
            if (res[0]) name = res[0].formatted_address;
          } catch {}
          fromPlace = { name, lat, lng };
          document.getElementById('from-area').value = name;
          saveRecentPlace({ name, lat, lng });
          updateUI();
          setTimeout(() => { btn.textContent = '📍'; }, 2000);
        },
        () => { btn.textContent = '📍'; }
      );
    });

    // ── Map-tap to pick location (inDrive style) ──────────────────────
    document.getElementById('btn-pin-from')?.addEventListener('click', () => activatePinMode('from'));
    document.getElementById('btn-pin-to')?.addEventListener('click', () => activatePinMode('to'));
    document.getElementById('btn-pin-cancel')?.addEventListener('click', () => deactivatePinMode());
    document.getElementById('btn-pin-confirm')?.addEventListener('click', () => confirmPin());
  }

  // ── Recent places (localStorage) ─────────────────────────────────────
  function saveRecentPlace(p) {
    try {
      let recents = JSON.parse(localStorage.getItem('wslha_recent_places') || '[]');
      recents = [p, ...recents.filter(r => r.name !== p.name)].slice(0, 8);
      localStorage.setItem('wslha_recent_places', JSON.stringify(recents));
      renderRecents();
    } catch {}
  }
  function loadRecentPlaces() {
    try { return JSON.parse(localStorage.getItem('wslha_recent_places') || '[]'); } catch { return []; }
  }
  function renderRecents() {
    const list = loadRecentPlaces();
    const el = document.getElementById('recent-list');
    if (!el) return;
    if (!list.length) { el.parentElement.style.display = 'none'; return; }
    el.parentElement.style.display = 'block';
    el.innerHTML = list.map(p => `
      <button class="recent-chip" type="button" data-lat="${p.lat}" data-lng="${p.lng}" data-name="${p.name}">
        🕐 <span>${p.name}</span>
      </button>
    `).join('');
    el.querySelectorAll('.recent-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        const lat = parseFloat(btn.dataset.lat), lng = parseFloat(btn.dataset.lng), name = btn.dataset.name;
        if (qpMode === 'from') { fromPlace = { name, lat, lng }; document.getElementById('from-area').value = name; }
        else                   { toPlace   = { name, lat, lng }; document.getElementById('to-area').value   = name; }
        updateUI();
      });
    });
  }
  renderRecents();

  // ── Category quick-search (cafe, restaurant, beach, bank…) ───────────
