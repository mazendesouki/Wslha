    return {
      id: o.value, name: cleanName,
      flatFare: Number(o.dataset.fare),
      driveMins: Number(o.dataset.mins),
      lat: Number(o.dataset.lat), lng: Number(o.dataset.lng),
    };
  }

  function selectedIntlFrom() {
    return intlOriginPlace;
  }

  function updateIntlUI() {
    const airport  = selectedAirport();
    const fromArea = selectedIntlFrom();
    const flightVal = intlFlightTime.value;
    const address  = document.getElementById('intl-address').value.trim();

    // Show/hide airport summary card
    const summaryCard = document.getElementById('airport-summary');
    if (airport) {
      summaryCard.style.display = 'flex';
      document.getElementById('summary-fare').textContent = airport.flatFare.toLocaleString('ar-EG') + ' ج.م';
      document.getElementById('summary-drive').textContent = '⏱ وقت القيادة للمطار: ' + airport.driveMins + ' دقيقة تقريباً';
    } else {
      summaryCard.style.display = 'none';
    }

    // Calculate and show departure time
    const departEl = document.getElementById('summary-depart');
    if (airport && flightVal) {
      const flightDate = new Date(flightVal);
      const bufferMs   = (3 * 60 + airport.driveMins) * 60 * 1000;
      const departDate = new Date(flightDate.getTime() - bufferMs);
      document.getElementById('summary-depart-time').textContent =
        departDate.toLocaleString('ar-EG', { weekday:'short', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' });
      departEl.style.display = 'block';
    } else {
      if (departEl) departEl.style.display = 'none';
    }

    // Update map if both from and airport selected
    if (fromArea && airport) {
      showRoute(fromArea, { id: airport.id, name: airport.name, lat: airport.lat, lng: airport.lng });
    }

    // Enable/disable button
    const ready = !!fromArea && !!airport && !!flightVal && !!address;
    intlBtn.disabled = !ready;
    if (ready) {
      intlBtn.classList.add('ready');
      intlHint.classList.remove('visible');
    } else {
      intlBtn.classList.remove('ready');
      intlHint.classList.add('visible');
      intlHint.textContent = !fromArea ? 'اختر منطقتك أولاً' :
        !airport ? 'اختر المطار' :
        !address ? 'أدخل عنوان الاستلام' :
        'أدخل تاريخ ووقت الرحلة';
    }
  }

  intlAirportSel.addEventListener('change', updateIntlUI);
  intlFlightTime.addEventListener('input', updateIntlUI);
  intlFlightTime.addEventListener('change', updateIntlUI);
  document.getElementById('intl-address').addEventListener('input', updateIntlUI);

  // International confirm
  intlBtn.addEventListener('click', async () => {
    const errEl   = document.getElementById('intl-alert');
    errEl.classList.remove('visible');
    const name    = document.getElementById('i-name').value.trim();
    const phone   = normPhone(document.getElementById('i-phone').value.trim());
    if (!name)           { errEl.textContent = 'يرجى إدخال الاسم.'; errEl.classList.add('visible'); return; }
    if (!EG.test(phone)) { errEl.textContent = 'رقم جوال غير صحيح (01...)'; errEl.classList.add('visible'); return; }

    const airport   = selectedAirport();
    const fromArea  = selectedIntlFrom();
    const flightVal = intlFlightTime.value;
    const address   = document.getElementById('intl-address').value.trim();
    if (!airport || !fromArea || !flightVal || !address) return;

    const pax     = document.getElementById('i-passengers').value;
    const luggage = document.getElementById('i-luggage').value;
    const pay     = document.querySelector('input[name="i-payment"]:checked').value;
    const notes   = document.getElementById('i-notes').value.trim();

    const flightDate = new Date(flightVal);
    const bufferMs   = (3 * 60 + airport.driveMins) * 60 * 1000;
    const departDate = new Date(flightDate.getTime() - bufferMs);

    intlBtn.disabled = true;
    intlBtn.classList.remove('ready');
    intlBtn.textContent = 'جاري إرسال الحجز...';

    const ride = await sbCreateRide({
      customer_phone: phone, customer_name: name,
      from_area: fromArea.name, from_lat: fromArea.lat, from_lng: fromArea.lng,
      to_area: airport.name, to_lat: airport.lat, to_lng: airport.lng,
      distance_km: 0, fare: airport.flatFare, eta_minutes: airport.driveMins,
      passengers: parseInt(pax), payment: pay,
      notes: `✈️ ${airport.name} — استلام: ${address} — شنط: ${luggage} — إقلاع: ${flightDate.toLocaleString('ar-EG')} — مغادرة البيت: ${departDate.toLocaleString('ar-EG')}${notes ? ' — ' + notes : ''}`,
      status: 'pending', ride_type: 'airport',
    });
    activeRideId = ride?.id || null;

    try {
      const orders = JSON.parse(localStorage.getItem('wslha_orders') || '[]');
      orders.unshift({ id: ride?.id || ('R'+Date.now()), type:'airport', from:fromArea.name, to:airport.name, name, phone, passengers:pax, payment:pay, fare:airport.flatFare, eta:airport.driveMins, status:'pending', createdAt:new Date().toISOString() });
      localStorage.setItem('wslha_orders', JSON.stringify(orders));
    } catch {}

    intlBtn.disabled = false;
    intlBtn.classList.add('ready');
    intlBtn.textContent = '✈️ تأكيد حجز التوصيل للمطار';

    _currentFrom = fromArea;
    _currentTo   = { id: airport.id, name: airport.name, lat: airport.lat, lng: airport.lng };
    _currentEta  = airport.driveMins;
    _driverShown = false; _onRide = false;
    window._st_assigned = window._st_arrived = window._st_onride = false;
    if (window._liveInterval) clearInterval(window._liveInterval);

    document.getElementById('ride-status').classList.add('visible');
    document.getElementById('st-confirmed-time').textContent = new Date().toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
    document.getElementById('st-confirmed').className = 'status-step done';
    document.getElementById('st-assigned').className  = 'status-step active';

    showRoute(fromArea, _currentTo);
    showSearching(fromArea.name, airport.name, airport.flatFare);

    if (activeRideId) {
      subscribeRideStatus(activeRideId);
    } else {
      setTimeout(() => {
        _driverShown = true;
        showDriverFound({ driver_name: 'السائق المتاح', driver_phone: '', from_area: fromArea.name, to_area: airport.name, fare: airport.flatFare });
        setTimeout(() => startLiveTracking(fromArea, _currentTo, airport.driveMins), 1000);
      }, 4000);
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ── new ride ──
  document.getElementById('new-ride-btn').addEventListener('click', () => {
    ['l-name','l-phone','l-notes','i-name','i-phone','i-notes'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
    fromPlace = null; toPlace = null; intlOriginPlace = null;
    document.getElementById('from-area').value = '';
    document.getElementById('to-area').value = '';
    document.getElementById('intl-from-area').value = '';
    document.getElementById('success-card').classList.remove('visible');
    clearMap();
    resetToBooking();
    updateUI();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ═══════════════════════════════════════════
  //  FARE GUIDE (switches with type)
  // ═══════════════════════════════════════════
  const fareSection = document.getElementById('fare-section');
  const fareGrid    = document.getElementById('fare-grid');

  function renderFareGuide(isIntl) {
    fareGrid.innerHTML = '';
    if (isIntl) {
      fareSection.querySelector('h2').textContent = 'أسعار توصيل المطارات 2026';
      AIRPORTS.forEach(a => {
        fareGrid.insertAdjacentHTML('beforeend',
          `<div class="fare-card">
            <div class="fare-card__route">
              <div class="fare-card__from">✈️ ${a.name.replace(' ✈️','')}</div>
              <div class="fare-card__to">⏱ ${a.driveMins} دقيقة تقريباً</div>
            </div>
            <div class="fare-card__price">${a.flatFare.toLocaleString('ar-EG')} ج.م</div>
          </div>`
        );
      });
      fareSection.querySelector('p') && (fareSection.querySelector('p').textContent = 'سعر ثابت شامل من محافظة دمياط — لا توجد رسوم إضافية');
    } else {
      fareSection.querySelector('h2').textContent = 'دليل الأسعار المحلية 2026';
      const SAMPLE = [
        { from: 'وسط دمياط',       to: 'دمياط الجديدة',    km: 5.5 },
        { from: 'وسط دمياط',       to: 'رأس البر',          km: 12.0 },
        { from: 'وسط دمياط',       to: 'كفر سعد',           km: 8.0 },
        { from: 'وسط دمياط',       to: 'فارسكور',           km: 11.5 },
        { from: 'دمياط الجديدة',   to: 'رأس البر',          km: 9.5 },
        { from: 'وسط دمياط',       to: 'الزرقا',            km: 14.0 },
        { from: 'وسط دمياط',       to: 'منية النصر',        km: 18.0 },
        { from: 'دمياط الجديدة',   to: 'كفر سعد',           km: 6.5 },
      ];
      SAMPLE.forEach(({ from, to, km }) => {
        const fare = fareFor(km);
        fareGrid.insertAdjacentHTML('beforeend',
          `<div class="fare-card">
            <div class="fare-card__route">
              <div class="fare-card__from">${from}</div>
              <div class="fare-card__to">← ${to}</div>
              <div style="font-size:10px;color:var(--color-text-faint);margin-top:2px;">~${km.toFixed(1)} كم</div>
            </div>
            <div class="fare-card__price">${fare} ج.م</div>
          </div>`
        );
      });
      if (fareSection.querySelector('p')) fareSection.querySelector('p').textContent = `أسعار 2026 — عداد ${BASE_FARE} ج.م + ${RATE_PER_KM} ج.م/كم — الحد الأدنى ${MIN_FARE} ج.م`;
    }
  }

  // Initial render: local prices + pricing note
  fareSection.insertAdjacentHTML('afterbegin',
    `<p style="font-size:var(--text-xs);color:var(--color-text-faint);margin-bottom:var(--sp-3);">أسعار 2026 — عداد ${BASE_FARE} ج.م + ${RATE_PER_KM} ج.م/كم — الحد الأدنى ${MIN_FARE} ج.م</p>`
  );
  renderFareGuide(false);
</script>
