  // ── Landmark Markers on Map ──────────────────────────────────────────
  function addLandmarkMarkers() {
    if (!map || !window.google?.maps) return;
    // clear previous
    landmarkMarkers.forEach(m => m.setMap(null));
    landmarkMarkers = [];

    const G = window.google.maps;
    PLACES.forEach(place => {
      const color = CATEGORY_COLORS[place.category] || '#9ca3af';
      const marker = new G.Marker({
        position: { lat: place.lat, lng: place.lng },
        map,
        title: place.name,
        icon: {
          path: G.SymbolPath.CIRCLE,
          fillColor: color,
          fillOpacity: 0.85,
          strokeColor: '#fff',
          strokeWeight: 2,
          scale: place.popular ? 9 : 6,
        },
        zIndex: place.popular ? 5 : 3,
      });

      const infoWindow = new G.InfoWindow({
        content: `<div style="font-family:Cairo,sans-serif;direction:rtl;text-align:right;min-width:160px;padding:4px">
          <div style="font-size:13px;font-weight:700;color:#1e293b;margin-bottom:3px">${place.emoji} ${place.name}</div>
          ${place.address ? `<div style="font-size:11px;color:#64748b">${place.address}</div>` : ''}
          <div style="margin-top:8px;display:flex;gap:6px">
            <button onclick="window.__qpSetFrom('${place.id}')" style="flex:1;padding:4px 6px;background:#3b82f6;color:#fff;border:none;border-radius:6px;font-family:Cairo,sans-serif;font-size:11px;cursor:pointer">من هنا</button>
            <button onclick="window.__qpSetTo('${place.id}')" style="flex:1;padding:4px 6px;background:#ef4444;color:#fff;border:none;border-radius:6px;font-family:Cairo,sans-serif;font-size:11px;cursor:pointer">إلى هنا</button>
          </div>
        </div>`,
        maxWidth: 220,
      });

      marker.addListener('click', () => {
        // close all open info windows
        window.__openInfoWindow?.close();
        infoWindow.open(map, marker);
        window.__openInfoWindow = infoWindow;
      });

      landmarkMarkers.push(marker);
    });

    // show legend
    document.getElementById('map-legend').style.display = 'flex';
  }

  // expose global helpers for info window buttons
  window.__qpSetFrom = (id) => {
