    const address  = document.getElementById('intl-address').value.trim();

    // Show/hide airport summary card
    const summaryCard = document.getElementById('airport-summary');
    if (airport) {
      summaryCard.style.display = 'flex';
      document.getElementById('summary-fare').textContent = airport.flatFare.toLocaleString('ar-EG') + ' ج.م';
      document.getElementById('summary-drive').textContent = '⏱ وقت القيادة للمطار: ' + airport.driveMins + ' دقيقة تقريباً';
    } else {
      summaryCard.style.display = 'none';
    }

    // Calculate and show departure time
    const departEl = document.getElementById('summary-depart');
    if (airport && flightVal) {
      const flightDate = new Date(flightVal);
      const bufferMs   = (3 * 60 + airport.driveMins) * 60 * 1000;
      const departDate = new Date(flightDate.getTime() - bufferMs);
      document.getElementById('summary-depart-time').textContent =
        departDate.toLocaleString('ar-EG', { weekday:'short', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' });
      departEl.style.display = 'block';
    } else {
      if (departEl) departEl.style.display = 'none';
    }

    // Update map if both from and airport selected
    if (fromArea && airport) {
      showRoute(fromArea, { id: airport.id, name: airport.name, lat: airport.lat, lng: airport.lng });
    }

    // Enable/disable button
    const ready = !!fromArea && !!airport && !!flightVal && !!address;
    intlBtn.disabled = !ready;
    if (ready) {
      intlBtn.classList.add('ready');
      intlHint.classList.remove('visible');
    } else {
      intlBtn.classList.remove('ready');
      intlHint.classList.add('visible');
      intlHint.textContent = !fromArea ? 'اختر منطقتك أولاً' :
        !airport ? 'اختر المطار' :
        !address ? 'أدخل عنوان الاستلام' :
        'أدخل تاريخ ووقت الرحلة';
    }
  }

