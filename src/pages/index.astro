---
import Layout from '../components/layout.astro';

const STATS = [
  { value: '30د',  label: 'متوسط التوصيل' },
  { value: '24/7', label: 'خدمة متاحة'    },
  { value: '4.9',  label: 'تقييم العملاء' },
  { value: '100%', label: 'ضمان التوصيل'  },
];

const ICONS = {
  route: `<path d="M4 19c3-7 6 4 9-3s5-3 7-6"/><circle cx="4" cy="19" r="1.6" fill="currentColor" stroke="none"/><circle cx="20" cy="10" r="1.6" fill="currentColor" stroke="none"/>`,
  plane: `<path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/>`,
  pin:   `<path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>`,
  store: `<path d="M4 8.5 5.5 4h13L20 8.5"/><path d="M4 8.5v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-11"/><path d="M9 20.5v-6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v6"/>`,
  shield:`<path d="M12 3 5 6v6c0 4.6 3 8 7 9 4-1 7-4.4 7-9V6l-7-3z"/><path d="m9 12 2 2 4-4"/>`,
  chat:  `<path d="M4 5h16v11H8l-4 4V5z"/><path d="M8 9h8M8 12.5h5"/>`,
  tag:   `<path d="M12 3h6a1 1 0 0 1 1 1v6L11 18 3 10 12 3z" transform="translate(-0.5 1)"/><circle cx="15.5" cy="8.5" r="1.3" fill="currentColor" stroke="none"/>`,
};

const SERVICES = [
  { n: '01', icon: ICONS.route, title: 'مشاوير سريعة',   desc: 'مشاوير داخل دمياط الجديدة بأسعار ثابتة وشفافة، لا مفاجآت في الفاتورة.',            href: '/rides' },
  { n: '02', icon: ICONS.plane, title: 'توصيل المطار',   desc: 'توصيل احترافي من وإلى مطار دمياط في الوقت المحدد بدون تأخير.',                    href: '/airport' },
  { n: '03', icon: ICONS.pin,   title: 'تتبع لحظي',      desc: 'تابع موقع مندوبك على الخريطة لحظة بلحظة حتى وصول طلبك.',                          href: '/track' },
  { n: '04', icon: ICONS.store, title: 'لوحة التاجر',    desc: 'لوحة تحكم متكاملة للتجار لإدارة الطلبات والتوصيل بكل سهولة.',                       href: '/merchant-apply' },
  { n: '05', icon: ICONS.shield,title: 'أمان وضمان',     desc: 'شحناتك مؤمنة بالكامل مع ضمان الاسترداد الفوري عند أي مشكلة.',                      href: '/services' },
  { n: '06', icon: ICONS.chat,  title: 'دعم 24/7',       desc: 'فريق دعم متاح على مدار الساعة لمساعدتك في أي وقت تحتاجه.',                          href: '/contact' },
  { n: '07', icon: ICONS.tag,   title: 'سوق المستعمل',   desc: 'بيع واشترِ مستعمل من الجيران في دمياط الجديدة — نشر مجاني وفوري.',                  href: '/marketplace' },
];

const JOURNEY = [
  { icon: ICONS.pin,    title: 'حدد نقطتك',   desc: 'أدخل موقعك ووجهتك بسهولة'               },
  { icon: ICONS.route,  title: 'اختر الخدمة', desc: 'مشوار، توصيل مطار، أو توصيل طلبات'      },
  { icon: ICONS.shield, title: 'تأكيد فوري',  desc: 'سائق يُرسَل إليك خلال دقائق'             },
  { icon: ICONS.store,  title: 'استلم بأمان', desc: 'تتبع لحظي حتى وصولك'                    },
];

const REVIEWS = [
  { text: 'من أول ما نزّلت التطبيق وأنا مستخدمه كل يوم تقريبًا — السائق بيوصل فعلاً في الوقت المتفق عليه.', name: 'محمود عادل',  meta: 'عميل منذ 2026' },
  { text: 'كتاجر، لوحة التحكم سهّلت عليّ متابعة الطلبات جدًا. مفيش لخبطة زي قبل كده.',                        name: 'سارة الشريف',  meta: 'صاحبة متجر شريك' },
  { text: 'حجزت توصيل مطار في آخر لحظة والسائق كان في الموعد بالظبط. تجربة محترفة فعلاً.',                    name: 'يوسف كامل',   meta: 'عميل منذ 2026' },
];
---

<style>
  /* ── Hero: split manifest layout ─────────────────────────── */
  .hero {
    background: var(--color-bg);
    padding: var(--sp-16) var(--sp-6) 0;
  }

  .hero__inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--sp-14);
    align-items: end;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    margin-bottom: var(--sp-5);
  }
  .hero__eyebrow::before {
    content: '';
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 3px rgba(34,197,94,0.18);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--color-text);
    letter-spacing: -1px;
    margin-bottom: var(--sp-5);
  }
  .hero__title em { color: var(--color-primary); font-style: normal; }

  .hero__desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 460px;
    margin-bottom: var(--sp-8);
  }

  .hero__actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-bottom: var(--sp-10); }

  .hero__strip {
    display: flex;
    border-top: 1px solid var(--color-border);
    padding-top: var(--sp-5);
  }
  .hero__strip-item {
    flex: 1;
    padding-inline-end: var(--sp-4);
    border-inline-end: 1px solid var(--color-border);
  }
  .hero__strip-item:last-child { border-inline-end: none; padding-inline-end: 0; }
  .hero__strip-value { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; color: var(--color-text); display: block; }
  .hero__strip-label { font-size: 12px; color: var(--color-text-faint); font-weight: 600; }

  /* ── Hero visual: torn ticket card ───────────────────────── */
  .ticket {
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--radius-2xl);
    padding: var(--sp-7) var(--sp-6) 0;
    position: relative;
    box-shadow: var(--shadow-lg);
  }

  .ticket__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-6); }
  .ticket__brand { display: flex; align-items: center; gap: var(--sp-2); font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); }
  .ticket__brand svg { width: 26px; height: 26px; }
  .ticket__badge { font-size: 11px; font-weight: 700; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); border-radius: var(--radius-full); padding: 4px 10px; }

  .ticket__route { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-6); }
  .ticket__point { display: flex; flex-direction: column; gap: 2px; }
  .ticket__point-city { font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl); }
  .ticket__point-tag { font-size: 11px; opacity: 0.7; }
  .ticket__line { flex: 1; height: 0; border-top: 2px dashed rgba(255,255,255,0.35); position: relative; top: -10px; }
  .ticket__plane { opacity: 0.85; flex-shrink: 0; }

  .ticket__meta { display: flex; justify-content: space-between; padding-bottom: var(--sp-6); }
  .ticket__meta-item span { display: block; }
  .ticket__meta-label { font-size: 10px; opacity: 0.65; margin-bottom: 3px; }
  .ticket__meta-value { font-weight: 700; font-size: var(--text-sm); }

  .ticket__stub {
    background: var(--color-primary-dark);
    margin: 0 calc(-1 * 0px);
    border-radius: 0 0 var(--radius-2xl) var(--radius-2xl);
    padding: var(--sp-4) var(--sp-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }
  .ticket__stub::before {
    content: '';
    position: absolute;
    top: -10px; right: -10px;
    width: 20px; height: 20px;
    background: var(--color-bg);
    border-radius: 50%;
  }
  .ticket__stub::after {
    content: '';
    position: absolute;
    top: -10px; left: -10px;
    width: 20px; height: 20px;
    background: var(--color-bg);
    border-radius: 50%;
  }
  .ticket__stub-status { display: flex; align-items: center; gap: 8px; font-size: var(--text-sm); font-weight: 700; }
  .ticket__stub-dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 3px rgba(74,222,128,0.25); }
  .ticket__stub-time { font-size: var(--text-xs); opacity: 0.7; }

  /* ── Services: alternating manifest list ─────────────────── */
  .services { background: var(--color-bg); }

  .services__list { max-width: 880px; margin: 0 auto; border-top: 1px solid var(--color-border); }

  .service-row {
    display: grid;
    grid-template-columns: 64px 56px 1fr auto;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-6) var(--sp-2);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: background var(--ease);
  }
  .service-row:hover { background: var(--color-bg-soft); }

  .service-row__num { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; color: var(--color-border); }
  .service-row:hover .service-row__num { color: var(--color-accent); }

  .service-row__icon {
    width: 48px; height: 48px;
    border-radius: var(--radius-lg);
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .service-row__icon svg { width: 24px; height: 24px; }

  .service-row__title { font-size: var(--text-lg); font-weight: 700; margin-bottom: 4px; }
  .service-row__desc { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; max-width: 52ch; }

  .service-row__arrow { color: var(--color-text-faint); font-size: var(--text-xl); transition: transform var(--ease), color var(--ease); }
  .service-row:hover .service-row__arrow { color: var(--color-primary); transform: translateX(-4px); }

  @media (max-width: 640px) {
    .service-row { grid-template-columns: 40px 48px 1fr; }
    .service-row__arrow { display: none; }
  }

  /* ── Journey: connected timeline ─────────────────────────── */
  .journey { background: var(--color-bg-soft); }

  .journey__rail {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-6);
    position: relative;
  }
  .journey__rail::before {
    content: '';
    position: absolute;
    top: 28px; right: 10%; left: 10%;
    height: 1px;
    background: var(--color-border);
  }

  .journey-step { text-align: center; position: relative; }
  .journey-step__icon {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    color: var(--color-primary);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto var(--sp-4);
    position: relative;
    z-index: 1;
  }
  .journey-step__icon svg { width: 24px; height: 24px; }
  .journey-step__title { font-weight: 700; font-size: var(--text-base); margin-bottom: 4px; }
  .journey-step__desc { font-size: var(--text-sm); color: var(--color-text-muted); }

  @media (max-width: 640px) {
    .journey__rail { grid-template-columns: 1fr 1fr; }
    .journey__rail::before { display: none; }
  }

  /* ── Reviews: featured quote ──────────────────────────────── */
  .reviews { background: var(--color-bg); }
  .reviews__inner { max-width: 900px; margin: 0 auto; }

  .review-feature {
    text-align: center;
    padding-bottom: var(--sp-10);
    margin-bottom: var(--sp-10);
    border-bottom: 1px solid var(--color-border);
  }
  .review-feature__stars { color: var(--color-accent); letter-spacing: 3px; margin-bottom: var(--sp-5); }
  .review-feature__quote {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 46ch;
    margin: 0 auto var(--sp-5);
    text-wrap: balance;
  }
  .review-feature__author { font-weight: 700; font-size: var(--text-sm); }
  .review-feature__meta { font-size: var(--text-xs); color: var(--color-text-faint); }

  .reviews__minor { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-6); }
  .review-minor__text { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; margin-bottom: var(--sp-3); }
  .review-minor__author { font-weight: 700; font-size: var(--text-sm); }
  .review-minor__meta { font-size: var(--text-xs); color: var(--color-text-faint); }

  @media (max-width: 640px) {
    .reviews__minor { grid-template-columns: 1fr; }
  }

  /* ── CTA ─────────────────────────────────────────────────── */
  .cta {
    background: var(--color-primary-dark);
    padding: var(--sp-20) var(--sp-6);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta__mark { position: absolute; opacity: 0.06; width: 380px; height: 380px; left: -80px; top: 50%; transform: translateY(-50%); }
  .cta__inner { position: relative; z-index: 1; }
  .cta__title { font-family: var(--font-display); font-size: var(--text-4xl); font-weight: 800; color: #fff; margin-bottom: var(--sp-4); line-height: 1.2; }
  .cta__desc  { color: rgba(255,255,255,0.75); font-size: var(--text-base); margin-bottom: var(--sp-10); max-width: 480px; margin-inline: auto; line-height: 1.7; }
  .cta__actions { display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; }

  /* ── Section shell ───────────────────────────────────────── */
  .section-shell { padding: var(--sp-20) var(--sp-6); }
  .section-eyebrow {
    display: block; text-align: center;
    font-size: var(--text-sm); font-weight: 700; color: var(--color-accent-dark);
    margin-bottom: var(--sp-2);
  }
  .section-title {
    font-family: var(--font-display);
    text-align: center;
    font-size: var(--text-4xl); font-weight: 800; color: var(--color-text);
    margin-bottom: var(--sp-12);
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .ticket { max-width: 420px; margin: 0 auto; }
  }
  @media (max-width: 640px) {
    .hero__strip { flex-wrap: wrap; gap: var(--sp-4); }
    .hero__strip-item { flex: 1 1 40%; border-inline-end: none; }
    .cta__title { font-size: var(--text-3xl); }
  }
</style>

<Layout
  title="الرئيسية"
  description="وصّلها — خدمة توصيل سريعة وموثوقة في دمياط الجديدة. مشاوير، توصيل مطار، وتتبع لحظي."
  page="home"
>
  <!-- ── Hero ── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner">

      <div class="hero__text">
        <span class="hero__eyebrow">متاح الآن في دمياط الجديدة</span>
        <h1 class="hero__title" id="hero-title">نوصّلك لأي مكان <em>في دمياط</em></h1>
        <p class="hero__desc">
          خدمة توصيل سريعة وموثوقة — مشاوير داخل المدينة،
          توصيل احترافي من وإلى المطار، وسوق مستعمل محلي.
        </p>
        <div class="hero__actions">
          <a href="/rides"   class="btn btn--primary">اطلب مشوار</a>
          <a href="/airport" class="btn btn--outline">توصيل مطار</a>
        </div>
        <dl class="hero__strip">
          {STATS.map(s => (
            <div class="hero__strip-item">
              <dd class="hero__strip-value">{s.value}</dd>
              <dt class="hero__strip-label">{s.label}</dt>
            </div>
          ))}
        </dl>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="ticket">
          <div class="ticket__top">
            <div class="ticket__brand">
              <svg viewBox="0 0 100 100" fill="#fff"><circle cx="50" cy="37" r="16"/><path d="M50 51 L50 60" stroke="#fff" stroke-width="7" stroke-linecap="round"/><path d="M50 60 L37 88 M50 60 L50 92 M50 60 L63 88" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              وصّلها
            </div>
            <span class="ticket__badge">تتبع حي</span>
          </div>

          <div class="ticket__route">
            <div class="ticket__point">
              <span class="ticket__point-city">نقطة الانطلاق</span>
              <span class="ticket__point-tag">دمياط الجديدة</span>
            </div>
            <svg class="ticket__plane" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
            <div class="ticket__line"></div>
            <div class="ticket__point" style="text-align:left">
              <span class="ticket__point-city">الوجهة</span>
              <span class="ticket__point-tag">باب المستخدم</span>
            </div>
          </div>

          <div class="ticket__meta">
            <div class="ticket__meta-item">
              <span class="ticket__meta-label">مدة التوصيل</span>
              <span class="ticket__meta-value">٣٠ دقيقة</span>
            </div>
            <div class="ticket__meta-item">
              <span class="ticket__meta-label">التقييم</span>
              <span class="ticket__meta-value">★ 4.9</span>
            </div>
            <div class="ticket__meta-item">
              <span class="ticket__meta-label">الدفع</span>
              <span class="ticket__meta-value">آمن 🔒</span>
            </div>
          </div>

          <div class="ticket__stub">
            <div class="ticket__stub-status">
              <span class="ticket__stub-dot"></span>
              تم التوصيل بنجاح
            </div>
            <span class="ticket__stub-time">منذ 5 دقائق</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Services: manifest list ── -->
  <section class="section-shell services" aria-labelledby="services-title">
    <span class="section-eyebrow">خدماتنا</span>
    <h2 class="section-title" id="services-title">كل ما تحتاجه في مكان واحد</h2>
    <ul class="services__list" role="list">
      {SERVICES.map(s => (
        <li>
          <a href={s.href} class="service-row">
            <span class="service-row__num" aria-hidden="true">{s.n}</span>
            <span class="service-row__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </span>
            <span>
              <span class="service-row__title">{s.title}</span>
              <p class="service-row__desc">{s.desc}</p>
            </span>
            <span class="service-row__arrow" aria-hidden="true">←</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── Journey ── -->
  <section class="section-shell journey" aria-labelledby="journey-title">
    <span class="section-eyebrow">كيف تعمل؟</span>
    <h2 class="section-title" id="journey-title">أربع خطوات بسيطة</h2>
    <ol class="journey__rail">
      {JOURNEY.map(s => (
        <li class="journey-step">
          <div class="journey-step__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
          </div>
          <h3 class="journey-step__title">{s.title}</h3>
          <p class="journey-step__desc">{s.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── Reviews: featured quote ── -->
  <section class="section-shell reviews" aria-labelledby="reviews-title">
    <span class="section-eyebrow">ماذا يقول عملاؤنا</span>
    <h2 class="section-title sr-only" id="reviews-title">آراء العملاء</h2>
    <div class="reviews__inner">
      <div class="review-feature">
        <div class="review-feature__stars">★★★★★</div>
        <p class="review-feature__quote">"{REVIEWS[0].text}"</p>
        <div class="review-feature__author">{REVIEWS[0].name}</div>
        <div class="review-feature__meta">{REVIEWS[0].meta}</div>
      </div>
      <div class="reviews__minor">
        {REVIEWS.slice(1).map(r => (
          <div>
            <p class="review-minor__text">"{r.text}"</p>
            <div class="review-minor__author">{r.name}</div>
            <div class="review-minor__meta">{r.meta}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta" aria-labelledby="cta-title">
