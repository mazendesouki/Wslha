---
import Layout from '../components/layout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const STATS = [
  { value: '30د',   label: 'متوسط التوصيل', icon: '⚡' },
  { value: '24/7',  label: 'خدمة متاحة',    icon: '🕐' },
  { value: '4.9★',  label: 'تقييم العملاء', icon: '⭐' },
  { value: '100%',  label: 'ضمان التوصيل',  icon: '🔒' },
];

const SERVICES = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
    color: '#2563eb',
    bg: '#eff6ff',
    title: 'مشاوير سريعة',
    desc: 'مشاوير داخل دمياط الجديدة بأسعار ثابتة وشفافة، لا مفاجآت في الفاتورة.',
    href: '/rides'
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>`,
    color: '#7c3aed',
    bg: '#f5f3ff',
    title: 'توصيل المطار',
    desc: 'توصيل احترافي من وإلى مطار دمياط في الوقت المحدد بدون تأخير.',
    href: '/airport'
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    color: '#059669',
    bg: '#ecfdf5',
    title: 'تتبع لحظي',
    desc: 'تابع موقع مندوبك على الخريطة لحظة بلحظة حتى وصول طلبك.',
    href: '/track'
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    color: '#d97706',
    bg: '#fffbeb',
    title: 'لوحة التاجر',
    desc: 'لوحة تحكم متكاملة للتجار لإدارة الطلبات والتوصيل بكل سهولة.',
    href: '/merchant-apply'
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    color: '#dc2626',
    bg: '#fef2f2',
    title: 'أمان وضمان',
    desc: 'شحناتك مؤمنة بالكامل مع ضمان الاسترداد الفوري عند أي مشكلة.',
    href: '/services'
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`,
    color: '#0891b2',
    bg: '#ecfeff',
    title: 'دعم 24/7',
    desc: 'فريق دعم متاح على مدار الساعة لمساعدتك في أي وقت تحتاجه.',
    href: '/contact'
  },
];

const HOW_STEPS = [
  { num: '١', icon: '📍', title: 'حدد نقطتك',  desc: 'أدخل موقعك ووجهتك بسهولة' },
  { num: '٢', icon: '🚗', title: 'اختر الخدمة', desc: 'مشوار، توصيل مطار، أو توصيل طلبات' },
  { num: '٣', icon: '✅', title: 'تأكيد فوري',  desc: 'سائق يُرسَل إليك خلال دقائق' },
  { num: '٤', icon: '🏠', title: 'استلم بأمان', desc: 'تتبع لحظي حتى وصولك' },
];


---

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .hero {
    background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #1d4ed8 100%);
    padding: var(--sp-20) var(--sp-6) var(--sp-24);
    overflow: hidden;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 50%),
                      radial-gradient(circle at 80% 20%, rgba(255,255,255,0.07) 0%, transparent 40%);
    pointer-events: none;
  }

  /* Dot grid pattern */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.12) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
    opacity: 0.5;
  }

  .hero__inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-12);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* ── Text side ── */
  .hero__text { color: #fff; }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    padding: 6px var(--sp-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--sp-6);
    letter-spacing: 0.3px;
  }

  .hero__badge::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.3);
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(74,222,128,0.3); }
    50%       { box-shadow: 0 0 0 6px rgba(74,222,128,0.1); }
  }

  .hero__title {
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: var(--weight-black);
    line-height: 1.05;
    margin-bottom: var(--sp-4);
    letter-spacing: -1px;
  }

  .hero__subtitle {
    font-size: var(--text-xl);
    font-weight: var(--weight-semi);
    margin-bottom: var(--sp-3);
    opacity: 0.92;
    line-height: 1.5;
  }

  .hero__desc {
    font-size: var(--text-base);
    opacity: 0.75;
    line-height: 1.8;
    margin-bottom: var(--sp-8);
    max-width: 400px;
  }

  .hero__actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: var(--sp-8);
  }

  .hero__trust {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    opacity: 0.75;
    font-size: var(--text-sm);
  }

  .hero__trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: rgba(255,255,255,0.9);
  }

  /* ── Visual side ── */
  .hero__visual { position: relative; }

  .hero__card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: var(--radius-2xl);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hero__card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }

  .hero__truck {
    font-size: 5rem;
    animation: float 3s ease-in-out infinite;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.2));
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-10px); }
  }

  .hero__route {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    background: rgba(255,255,255,0.15);
    border-radius: var(--radius-full);
    padding: var(--sp-2) var(--sp-4);
  }

  .hero__route-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .hero__route-dot--start { background: #4ade80; }
  .hero__route-dot--end   { background: #f59e0b; }

  .hero__route-line {
    flex: 1;
    height: 2px;
    background: repeating-linear-gradient(to left, rgba(255,255,255,0.6) 0px, rgba(255,255,255,0.6) 8px, transparent 8px, transparent 16px);
    min-width: 60px;
  }

  .hero__route-label {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.9);
    font-weight: var(--weight-bold);
  }

  /* Floating cards */
  .hero__badge-img {
    position: absolute;
    top: var(--sp-4);
    right: calc(-1 * var(--sp-4));
    background: #f59e0b;
    color: #000;
    border-radius: var(--radius-lg);
    padding: var(--sp-3) var(--sp-5);
    text-align: center;
    box-shadow: 0 8px 24px rgba(245,158,11,0.4);
    border: 2px solid rgba(255,255,255,0.3);
  }

  .hero__badge-img-num   { font-size: var(--text-3xl); font-weight: var(--weight-black); line-height: 1; }
  .hero__badge-img-label { font-size: 11px; font-weight: var(--weight-bold); margin-top: 2px; }

  .hero__success {
    position: absolute;
    bottom: calc(-1 * var(--sp-5));
    left: calc(-1 * var(--sp-5));
    background: #fff;
    border-radius: var(--radius-lg);
    padding: var(--sp-3) var(--sp-4);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    border: 1px solid rgba(0,0,0,0.06);
  }

  .hero__success-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: #dcfce7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .hero__success-title { font-weight: var(--weight-black); font-size: var(--text-sm); color: var(--color-text); }
  .hero__success-time  { font-size: var(--text-xs); color: var(--color-text-faint); margin-top: 2px; }

  .hero__rating-badge {
    position: absolute;
    top: calc(-1 * var(--sp-4));
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    border-radius: var(--radius-full);
    padding: var(--sp-2) var(--sp-4);
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-black);
    color: var(--color-text);
    white-space: nowrap;
    border: 1px solid rgba(0,0,0,0.06);
  }

  .hero__stars { color: #f59e0b; font-size: 13px; letter-spacing: 1px; }

  /* ── Stats ──────────────────────────────────────────────── */
  .stats {
    background: var(--color-bg);
    padding: var(--sp-12) var(--sp-6);
    border-bottom: 1px solid var(--color-border);
    margin-top: calc(-1 * var(--sp-6));
    position: relative;
    z-index: 2;
  }

  .stats__grid {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
  }

  .stat-card {
    background: var(--color-bg-soft);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--sp-6) var(--sp-4);
    text-align: center;
    transition: border-color var(--ease), box-shadow var(--ease);
  }
  .stat-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-primary);
  }

  .stat-card__icon { font-size: 1.6rem; margin-bottom: var(--sp-2); line-height: 1; }
  .stat__value { font-size: var(--text-3xl); font-weight: var(--weight-black); color: var(--color-primary); line-height: 1; margin-bottom: var(--sp-1); display: block; }
  .stat__label { color: var(--color-text-muted); font-size: var(--text-xs); font-weight: var(--weight-semi); text-transform: uppercase; letter-spacing: 0.5px; }

  /* ── Services ───────────────────────────────────────────── */
  .services { background: var(--color-bg-soft); }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
  }

  .service-card {
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--sp-7);
    border: 1.5px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    cursor: default;
  }

  .service-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 32px rgba(37,99,235,0.10);
    transform: translateY(-4px);
  }

  .service-card__icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sp-5);
    flex-shrink: 0;
  }

  .service-card__title { font-size: var(--text-lg); font-weight: var(--weight-black); margin-bottom: var(--sp-2); color: var(--color-text); }
  .service-card__desc  { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; flex: 1; margin-bottom: var(--sp-5); }

  .service-card__link {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.2s;
    text-decoration: none;
  }
  .service-card:hover .service-card__link { gap: var(--sp-2); }

  /* ── How it works ───────────────────────────────────────── */
  .how { background: var(--color-bg); }

  .how__steps {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
    position: relative;
  }

  .how__steps::before {
    content: '';
    position: absolute;
    top: 34px;
    right: 12%;
    left: 12%;
    height: 2px;
    background: linear-gradient(to left, var(--color-primary), #bfdbfe);
    pointer-events: none;
    z-index: 0;
  }

  .how-step {
    text-align: center;
    padding: var(--sp-2);
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    border: 1.5px solid var(--color-border);
    padding: var(--sp-6) var(--sp-4);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .how-step:hover {
    border-color: var(--color-primary);
    box-shadow: 0 4px 16px rgba(37,99,235,0.08);
  }

  .how-step__num {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: #fff;
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--sp-2);
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 16px rgba(37,99,235,0.3);
  }

  .how-step__icon  { font-size: 1.5rem; margin-bottom: var(--sp-3); }
  .how-step__title { font-size: var(--text-base); font-weight: var(--weight-black); margin-bottom: var(--sp-2); }
  .how-step__desc  { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; }

  /* ── Reviews ────────────────────────────────────────────── */
  .reviews { background: var(--color-bg-soft); }

  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
  }

  .review-card {
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--sp-7);
    border: 1.5px solid var(--color-border);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .review-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }

  .review-card__stars { color: #f59e0b; font-size: 1.1rem; letter-spacing: 2px; margin-bottom: var(--sp-3); }
  .review-card__text  { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.7; margin-bottom: var(--sp-5); }

  .review-card__author {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .review-card__avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-primary), #7c3aed);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: var(--weight-black);
    font-size: var(--text-base);
    flex-shrink: 0;
  }

  .review-card__name { font-weight: var(--weight-bold); font-size: var(--text-sm); }
  .review-card__meta { font-size: var(--text-xs); color: var(--color-text-faint); }

  /* ── CTA ─────────────────────────────────────────────────── */
  .cta {
    background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
    padding: var(--sp-20) var(--sp-6);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  .cta__inner { position: relative; z-index: 1; }
  .cta__badge {
    display: inline-block;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: var(--radius-full);
    padding: 6px var(--sp-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: rgba(255,255,255,0.9);
    margin-bottom: var(--sp-5);
  }
  .cta__title { font-size: var(--text-4xl); font-weight: var(--weight-black); color: #fff; margin-bottom: var(--sp-4); line-height: 1.2; }
  .cta__desc  { color: rgba(255,255,255,0.75); font-size: var(--text-base); margin-bottom: var(--sp-10); max-width: 480px; margin-inline: auto; line-height: 1.7; }

  .cta__actions {
    display: flex;
    gap: var(--sp-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .services__grid { grid-template-columns: repeat(2, 1fr); }
    .reviews__grid  { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 900px) {
    .services__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    .hero__inner    { grid-template-columns: 1fr; gap: var(--sp-8); }
    .hero__visual   { order: -1; }
    .hero__title    { font-size: var(--text-4xl); }
    .hero__desc     { max-width: 100%; }
    .stats__grid    { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .stats__grid    { grid-template-columns: repeat(2, 1fr); }
    .services__grid { grid-template-columns: 1fr; }
    .how__steps     { grid-template-columns: 1fr 1fr; }
    .how__steps::before { display: none; }
    .reviews__grid  { grid-template-columns: 1fr; }
    .cta__title     { font-size: var(--text-3xl); }
  }
</style>

<Layout
  title="الرئيسية"
  description="وصّلها — خدمة توصيل سريعة وموثوقة في دمياط الجديدة. مشاوير، توصيل مطار، وتتبع لحظي."
  page="home"
>
  <!-- ── Hero ── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner">

      <div class="hero__text">
        <span class="hero__badge">متاح الآن في دمياط الجديدة</span>
        <h1 class="hero__title" id="hero-title">وصّلها</h1>
        <p class="hero__subtitle">نوصّلك لأي مكان في دمياط</p>
        <p class="hero__desc">
          خدمة توصيل سريعة وموثوقة — مشاوير داخل المدينة
          وتوصيل احترافي من وإلى المطار
        </p>
        <div class="hero__actions">
          <a href="/rides"   class="btn btn--accent">🚗 اطلب مشوار</a>
          <a href="/airport" class="btn btn--white">✈️ توصيل مطار</a>
        </div>
        <div class="hero__trust">
          <span class="hero__trust-item">✅ بدون رسوم خفية</span>
          <span class="hero__trust-item">⭐ تقييم 4.9</span>
          <span class="hero__trust-item">🔒 دفع آمن</span>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <!-- Rating badge -->
        <div class="hero__rating-badge">
          <span class="hero__stars">★★★★★</span>
          <span>4.9 — خدمة ممتازة</span>
        </div>

        <!-- Main visual card -->
        <div class="hero__card">
          <div class="hero__card-inner">
            <div class="hero__truck">🚗</div>
            <div class="hero__route">
              <span class="hero__route-dot hero__route-dot--start"></span>
              <span class="hero__route-line"></span>
              <span class="hero__route-label">٣٠ دقيقة</span>
              <span class="hero__route-line"></span>
              <span class="hero__route-dot hero__route-dot--end"></span>
            </div>
          </div>
        </div>

        <!-- 30 min badge -->
        <div class="hero__badge-img">
          <div class="hero__badge-img-num">30</div>
          <div class="hero__badge-img-label">دقيقة توصيل</div>
        </div>

        <!-- Success card -->
        <div class="hero__success" role="status">
          <div class="hero__success-icon" aria-hidden="true">✅</div>
          <div>
            <div class="hero__success-title">تم التوصيل بنجاح</div>
            <div class="hero__success-time">منذ 5 دقائق</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Stats ── -->
  <section class="stats" aria-label="إحصائيات الخدمة">
    <dl class="stats__grid">
      {STATS.map(s => (
        <div class="stat-card">
          <div class="stat-card__icon" aria-hidden="true">{s.icon}</div>
          <dt class="sr-only">{s.label}</dt>
          <dd class="stat__value">{s.value}</dd>
          <p class="stat__label">{s.label}</p>
        </div>
      ))}
    </dl>
  </section>

  <!-- ── Services ── -->
  <section class="section services" aria-labelledby="services-title">
    <div class="container">
      <SectionHeader
        badge="خدماتنا"
        title="كل ما تحتاجه في مكان واحد"
        subtitle="خدمات توصيل متكاملة تغطي جميع احتياجاتك في دمياط"
        id="services-title"
      />
      <ul class="services__grid" role="list">
        {SERVICES.map(s => (
          <li class="service-card">
            <div class="service-card__icon-wrap" style={`background:${s.bg};color:${s.color}`} aria-hidden="true" set:html={s.icon} />
            <h3 class="service-card__title">{s.title}</h3>
            <p class="service-card__desc">{s.desc}</p>
            <a href={s.href} class="service-card__link">اعرف المزيد ←</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── How it works ── -->
  <section class="section how" aria-labelledby="how-title">
    <div class="container">
      <SectionHeader badge="كيف تعمل؟" title="أربع خطوات بسيطة" subtitle="واطلب توصيلك في دقائق" id="how-title" />
      <ol class="how__steps">
        {HOW_STEPS.map(s => (
          <li class="how-step">
            <div class="how-step__num" aria-hidden="true">{s.num}</div>
            <div class="how-step__icon" aria-hidden="true">{s.icon}</div>
            <h3 class="how-step__title">{s.title}</h3>
            <p class="how-step__desc">{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta" aria-labelledby="cta-title">
    <div class="cta__inner">
      <div class="cta__badge">🚀 ابدأ الآن</div>
      <h2 class="cta__title" id="cta-title">جاهز للتوصيل؟</h2>
      <p class="cta__desc">انضم لآلاف العملاء الذين يثقون في وصّلها يومياً — سريع، موثوق، وبأسعار شفافة</p>
      <div class="cta__actions">
        <a href="/rides"   class="btn btn--accent">🚗 اطلب مشوار الآن</a>
        <a href="/airport" class="btn btn--white">✈️ حجز توصيل مطار</a>
      </div>
    </div>
  </section>
</Layout>
