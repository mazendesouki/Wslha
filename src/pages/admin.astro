let allWallets = [], allWalletAccounts = [], allTxLogs = [];

async function loadWalletsSection() {
  document.getElementById('wallets-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr>';
  document.getElementById('all-tx-tbody').innerHTML  = '<tr><td colspan="6" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr>';

  const [wallets, accounts, txData] = await Promise.all([
    sbGet('wallets?select=phone,balance,updated_at&order=balance.desc&limit=2000'),
    adminListAccounts(),
    sbGet('wallet_transactions?select=id,phone,amount,type,note,reference_id,created_at&order=created_at.desc&limit=500'),
  ]);

  allWalletAccounts = accounts || [];
  const acctMap = {};
  allWalletAccounts.forEach(a => { acctMap[a.phone] = a; });

  allWallets = (wallets || []).map(w => ({
    ...w, name: acctMap[w.phone]?.name || '', role: acctMap[w.phone]?.role || 'customer',
  }));
  allWalletAccounts.forEach(a => {
    if (!allWallets.find(w => w.phone === a.phone))
      allWallets.push({ phone: a.phone, balance: 0, name: a.name || '', role: a.role || 'customer' });
  });

  const totalBal    = allWallets.reduce((s,w) => s + Number(w.balance||0), 0);
  const driverBal   = allWallets.filter(w => w.role === 'driver').reduce((s,w) => s + Number(w.balance||0), 0);
  const merchantBal = allWallets.filter(w => w.role === 'merchant').reduce((s,w) => s + Number(w.balance||0), 0);

  document.getElementById('w-total-balance').textContent    = fmt(Math.round(totalBal))    + ' ج.م';
  document.getElementById('w-driver-balance').textContent   = fmt(Math.round(driverBal))   + ' ج.م';
  document.getElementById('w-merchant-balance').textContent = fmt(Math.round(merchantBal)) + ' ج.م';

  allTxLogs = (txData || []).map(t => ({ ...t, userName: acctMap[t.phone]?.name || (t.phone === 'platform' ? 'المنصة' : '') }));

  renderWalletsList();
  renderTxLog();
  loadPlatformFinance();
}

