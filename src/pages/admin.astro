      <td><button class="btn btn--ghost btn--sm" onclick="openOrderModal('${o.id}')">تفاصيل</button></td>
    </tr>`).join('') || '<tr><td colspan="9" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد طلبات</td></tr>';
  document.getElementById('orders-tbody').innerHTML = html;
}
document.getElementById('orders-search').addEventListener('input', renderOrders);
document.getElementById('orders-status-filter').addEventListener('change', renderOrders);

function openOrderModal(id) {
  currentOrderId = id;
  const o = allOrders.find(x => x.id === id);
  if (!o) return;
  document.getElementById('order-status-select').value = o.status||'pending';
  let items = '—';
  try {
    const arr = typeof o.items === 'string' ? JSON.parse(o.items) : o.items;
    if (Array.isArray(arr)) items = arr.map(i => `${i.qty||1}× ${i.emoji||''} ${i.name}`).join('<br>');
  } catch {}
  document.getElementById('order-modal-body').innerHTML = `
    <div class="info-grid">
      <div class="info-field"><div class="info-field__label">رقم الطلب</div><div class="info-field__val" style="direction:ltr">${o.code||o.id||'—'}</div></div>
      <div class="info-field"><div class="info-field__label">المتجر</div><div class="info-field__val">${o.store_name||'—'}</div></div>
      <div class="info-field"><div class="info-field__label">العميل</div><div class="info-field__val">${o.customer_name||'—'}</div></div>
      <div class="info-field"><div class="info-field__label">جوال العميل</div><div class="info-field__val" style="direction:ltr">${o.customer_phone||'—'}</div></div>
      <div class="info-field"><div class="info-field__label">العنوان</div><div class="info-field__val">${o.address||o.area||'—'}</div></div>
      <div class="info-field"><div class="info-field__label">السائق</div><div class="info-field__val">${o.driver_name||'—'}</div></div>
      <div class="info-field"><div class="info-field__label">المجموع الفرعي</div><div class="info-field__val">${fmt(o.subtotal)} ج.م</div></div>
      <div class="info-field"><div class="info-field__label">رسوم التوصيل</div><div class="info-field__val">${fmt(o.delivery_fee)} ج.م</div></div>
      <div class="info-field"><div class="info-field__label">الإجمالي</div><div class="info-field__val" style="font-size:1.1rem;color:var(--pr)">${fmt(o.total)} ج.م</div></div>
      <div class="info-field"><div class="info-field__label">طريقة الدفع</div><div class="info-field__val">${o.payment==='cash'?'💵 نقداً':'💳 بطاقة'}</div></div>
      <div class="info-field"><div class="info-field__label">تاريخ الطلب</div><div class="info-field__val">${fmtTime(o.created_at)}</div></div>
      <div class="info-field"><div class="info-field__label">الحالة الحالية</div><div class="info-field__val">${badge(o.status)}</div></div>
    </div>
    <div class="info-field" style="margin-top:.5rem"><div class="info-field__label">المنتجات</div><div class="info-field__val" style="line-height:1.8">${items}</div></div>`;
  document.getElementById('order-modal').classList.remove('hidden');
}
async function saveOrderStatus() {
  const status = document.getElementById('order-status-select').value;
  const ok = await sbPatch(`orders?id=eq.${encodeURIComponent(currentOrderId)}`, { status });
  if (ok) {
    showToast('✅ تم تحديث حالة الطلب', '#16A34A');
    closeModal('order-modal');
    loadOrders();
  } else showToast('❌ حدث خطأ', '#DC2626');
}
async function deleteCurrentOrder() {
  if (!confirm('حذف هذا الطلب نهائياً؟')) return;
  const ok = await sbDelete(`orders?id=eq.${encodeURIComponent(currentOrderId)}`);
  if (ok) { showToast('✅ تم الحذف', '#16A34A'); closeModal('order-modal'); loadOrders(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}

/* ═══════════════════ RIDES ═════════════════════════════════ */
let allRides = [];
async function loadRides() {
  const data = await sbGet('rides?select=*&order=created_at.desc&limit=500');
  allRides = data || [];
  renderRides();
}
function renderRides() {
  const search = document.getElementById('rides-search').value.trim().toLowerCase();
  const status = document.getElementById('rides-status-filter').value;
  let rows = allRides;
  if (search) rows = rows.filter(r => (r.id||'').toLowerCase().includes(search)||(r.customer_phone||'').includes(search)||(r.customer_name||'').toLowerCase().includes(search));
  if (status) rows = rows.filter(r => r.status === status);
  const html = rows.map(r => `
    <tr>
      <td style="direction:ltr;font-size:.75rem;color:#94A3B8">${r.id?.slice(0,10)||'—'}</td>
      <td style="font-weight:600">${r.customer_name||'—'}</td>
      <td>${r.from_area||'—'}</td>
      <td>${r.to_area||'—'}</td>
      <td style="font-weight:700;color:var(--pr)">${fmt(r.base_fare||r.fare)} ج.م</td>
      <td>${r.driver_name||'—'}</td>
      <td>${badge(r.status)}</td>
      <td style="font-size:.75rem">${fmtTime(r.created_at)}</td>
      <td>
        <select class="filter-select" style="font-size:.72rem;padding:.2rem .4rem" onchange="updateRideStatus('${r.id}',this.value)">
          <option value="">تغيير</option>
          <option value="pending">معلق</option>
          <option value="accepted">مقبول</option>
          <option value="in_progress">جارية</option>
          <option value="completed">مكتملة</option>
          <option value="cancelled">ملغاة</option>
        </select>
      </td>
    </tr>`).join('') || '<tr><td colspan="9" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد رحلات</td></tr>';
  document.getElementById('rides-tbody').innerHTML = html;
}
document.getElementById('rides-search').addEventListener('input', renderRides);
document.getElementById('rides-status-filter').addEventListener('change', renderRides);
async function updateRideStatus(id, status) {
  if (!status) return;
  const ok = await sbPatch(`rides?id=eq.${encodeURIComponent(id)}`, { status });
  if (ok) { showToast('✅ تم التحديث', '#16A34A'); loadRides(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}

/* ═══════════════════ STORES ════════════════════════════════ */
let allStores = [];
async function loadStores() {
  const data = await sbGet('stores?select=*&order=created_at.desc&limit=200');
  allStores = data || [];
  renderStores();
}
function renderStores() {
  const search = document.getElementById('stores-search').value.trim().toLowerCase();
  let rows = allStores;
  if (search) rows = rows.filter(s => (s.name||'').toLowerCase().includes(search)||(s.area||'').toLowerCase().includes(search));
  const html = rows.map(s => `
    <tr>
      <td style="font-weight:700">${s.emoji||''} ${s.name||'—'}</td>
      <td style="font-size:.82rem">${s.category||'—'}</td>
      <td>${s.area||'—'}</td>
      <td style="direction:ltr;font-size:.82rem">${s.owner_phone||'—'}</td>
      <td>${fmt(s.delivery_fee)} ج.م</td>
      <td>${s.rating||'—'} ⭐ (${s.reviews||0})</td>
      <td>
        <label style="display:flex;align-items:center;gap:.35rem;cursor:pointer">
          <input type="checkbox" ${s.is_active?'checked':''} onchange="toggleStore('${s.id}',this.checked)" style="cursor:pointer"/>
          <span style="font-size:.78rem">${s.is_active?'نشط':'معطل'}</span>
        </label>
      </td>
      <td><span class="badge ${s.is_open?'badge--green':'badge--gray'}">${s.is_open?'مفتوح':'مغلق'}</span></td>
      <td>
        <button class="btn btn--red btn--sm" onclick="deleteStore('${s.id}')">حذف</button>
      </td>
    </tr>`).join('') || '<tr><td colspan="9" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد متاجر</td></tr>';
  document.getElementById('stores-tbody').innerHTML = html;
}
document.getElementById('stores-search').addEventListener('input', renderStores);
async function toggleStore(id, is_active) {
  const ok = await sbPatch(`stores?id=eq.${encodeURIComponent(id)}`, { is_active });
  if (ok) showToast(`✅ ${is_active?'تم تفعيل':'تم تعطيل'} المتجر`, '#16A34A');
  else { showToast('❌ حدث خطأ', '#DC2626'); loadStores(); }
}
async function deleteStore(id) {
  if (!confirm('حذف هذا المتجر نهائياً؟')) return;
  const ok = await sbDelete(`stores?id=eq.${encodeURIComponent(id)}`);
  if (ok) { showToast('✅ تم الحذف', '#16A34A'); loadStores(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}

/* ═══════════════════ MESSAGES ══════════════════════════════ */
let currentMsg: any = null;

async function loadMessages() {
  const filter = (document.getElementById('msg-filter') as HTMLSelectElement).value;
  const q = filter ? `messages?status=eq.${filter}&order=created_at.desc` : 'messages?order=created_at.desc';
  const rows = await sbGet(q);
  const tbody = document.getElementById('messages-tbody')!;
  if (!rows?.length) { tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد رسائل</td></tr>'; return; }

  const unread = rows.filter((r:any) => r.status === 'unread').length;
  const badge = document.getElementById('badge-messages')!;
  if (unread > 0) { badge.textContent = String(unread); badge.classList.remove('hidden'); }
  else badge.classList.add('hidden');

  const statusLabel: Record<string,string> = { unread:'غير مقروء', read:'مقروء', replied:'تم الرد' };
  const statusColor: Record<string,string> = { unread:'#F59E0B', read:'#3B82F6', replied:'#16A34A' };

  tbody.innerHTML = rows.map((m: any) => `
    <tr style="${m.status === 'unread' ? 'background:rgba(245,158,11,.07)' : ''}">
      <td style="font-weight:700">${m.name}</td>
      <td>${m.phone}</td>
      <td style="color:#3B82F6">${m.email || '—'}</td>
      <td>${m.subject}</td>
      <td><span style="padding:2px 8px;border-radius:99px;font-size:.75rem;font-weight:700;background:${statusColor[m.status]}22;color:${statusColor[m.status]}">${statusLabel[m.status] || m.status}</span></td>
      <td style="font-size:.78rem;color:#64748B">${new Date(m.created_at).toLocaleDateString('ar-EG')}</td>
      <td><button onclick="openMsg(${JSON.stringify(JSON.stringify(m))})" style="padding:.3rem .7rem;background:#3B6EF8;color:#fff;border:none;border-radius:5px;font-size:.78rem;cursor:pointer">عرض</button></td>
    </tr>`).join('');
}

function openMsg(jsonStr: string) {
  currentMsg = JSON.parse(jsonStr);
  const m = currentMsg;
  (document.getElementById('msg-modal-subject') as HTMLElement).textContent = m.subject;
  (document.getElementById('msg-modal-name') as HTMLElement).textContent = m.name;
  (document.getElementById('msg-modal-phone') as HTMLElement).textContent = m.phone;
  (document.getElementById('msg-modal-email') as HTMLElement).textContent = m.email || '—';
  (document.getElementById('msg-modal-date') as HTMLElement).textContent = new Date(m.created_at).toLocaleString('ar-EG');
  (document.getElementById('msg-modal-body') as HTMLElement).textContent = m.message;
  const modal = document.getElementById('msg-modal')!;
  modal.style.display = 'flex';
  if (m.status === 'unread') updateMsgStatus(m.id, 'read');
}

async function updateMsgStatus(id: string, status: string) {
  await sbFetch(`${SB_URL}/rest/v1/messages?id=eq.${id}`, {
    method: 'PATCH', headers: { ...SB_H, 'Content-Type':'application/json', Prefer:'return=minimal' },
    body: JSON.stringify({ status }),
  });
  if (currentMsg?.id === id) currentMsg.status = status;
  loadMessages();
}

document.getElementById('msg-mark-read')?.addEventListener('click', () => { if (currentMsg) updateMsgStatus(currentMsg.id, 'read'); });
document.getElementById('msg-mark-replied')?.addEventListener('click', () => { if (currentMsg) updateMsgStatus(currentMsg.id, 'replied'); });
document.getElementById('msg-reply-email')?.addEventListener('click', () => {
  if (!currentMsg?.email) { showToast('لا يوجد بريد إلكتروني', '#F59E0B'); return; }
  window.open(`mailto:${currentMsg.email}?subject=رد: ${currentMsg.subject}`);
  updateMsgStatus(currentMsg.id, 'replied');
});
document.getElementById('msg-filter')?.addEventListener('change', loadMessages);
document.getElementById('msg-modal')?.addEventListener('click', (e) => {
  if (e.target === document.getElementById('msg-modal')) (document.getElementById('msg-modal') as HTMLElement).style.display = 'none';
});

/* ═══════════════════ FINANCE ═══════════════════════════════ */
async function loadFinance() {
  const [orders, rides] = await Promise.all([
    sbGet('orders?select=id,status,total,delivery_fee,created_at&order=created_at.desc&limit=1000'),
    sbGet('rides?select=id,status,base_fare,created_at&order=created_at.desc&limit=500'),
  ]);
  const delivered = (orders||[]).filter(o => o.status === 'delivered');
  const totalRev  = delivered.reduce((s,o) => s + (Number(o.total)||0), 0);
  const totalOrd  = delivered.length;
  const avgOrd    = totalOrd ? Math.round(totalRev / totalOrd) : 0;
  const doneRides = (rides||[]).filter(r => r.status==='completed');

  document.getElementById('fin-total-rev').textContent   = fmt(totalRev);
  document.getElementById('fin-total-orders').textContent = fmt(totalOrd);
  document.getElementById('fin-total-rides').textContent  = fmt(doneRides.length);
  document.getElementById('fin-avg-order').textContent    = fmt(avgOrd);

  // Monthly breakdown
  const monthMap = {};
  (orders||[]).forEach(o => {
    const d   = new Date(o.created_at||0);
    const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
    if (!monthMap[key]) monthMap[key] = { label: MONTHS_AR[d.getMonth()]+' '+d.getFullYear(), orders:0, delivered:0, revenue:0, rides:0 };
    monthMap[key].orders++;
    if (o.status === 'delivered') { monthMap[key].delivered++; monthMap[key].revenue += Number(o.total)||0; }
  });
  (rides||[]).forEach(r => {
    const d   = new Date(r.created_at||0);
    const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
    if (monthMap[key]) monthMap[key].rides++;
  });
  const rows = Object.entries(monthMap).sort((a,b) => b[0].localeCompare(a[0])).slice(0,18);
  document.getElementById('finance-tbody').innerHTML = rows.map(([,m]) => `
    <tr>
      <td style="font-weight:700">${m.label}</td>
      <td>${fmt(m.orders)}</td>
      <td>${fmt(m.delivered)}</td>
      <td style="font-weight:700;color:var(--pr)">${fmt(m.revenue)} ج.م</td>
      <td>${m.delivered ? fmt(Math.round(m.revenue/m.delivered)) : '—'} ج.م</td>
      <td>${fmt(m.rides)}</td>
    </tr>`).join('') || '<tr><td colspan="6" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد بيانات</td></tr>';
}

