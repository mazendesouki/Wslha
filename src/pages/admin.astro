            <option value="pending"  ${(u.status||'')==='pending' ?'selected':''}>معلق</option>
            <option value="approved" ${(u.status||'')==='approved'?'selected':''}>معتمد</option>
            <option value="banned"   ${(u.status||'')==='banned'  ?'selected':''}>محظور</option>
