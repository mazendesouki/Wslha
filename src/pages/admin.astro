}
document.getElementById('stores-search').addEventListener('input', renderStores);
async function toggleStore(id, is_active) {
  const ok = await sbPatch(`stores?id=eq.${encodeURIComponent(id)}`, { is_active });
  if (ok) showToast(`✅ ${is_active?'تم تفعيل':'تم تعطيل'} المتجر`, '#16A34A');
  else { showToast('❌ حدث خطأ', '#DC2626'); loadStores(); }
}
async function deleteStore(id) {
  if (!confirm('حذف هذا المتجر نهائياً؟')) return;
  const ok = await sbDelete(`stores?id=eq.${encodeURIComponent(id)}`);
  if (ok) { showToast('✅ تم الحذف', '#16A34A'); loadStores(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}

/* ═══════════════════ MARKETPLACE ═══════════════════════════ */
let allMarketItems = [];
async function loadMarketplaceSection() {
  const data = await sbGet('marketplace_items?select=*&order=created_at.desc&limit=500');
  allMarketItems = data || [];
  const underReview = allMarketItems.filter(i => i.status === 'under_review').length;
  const badge = document.getElementById('badge-marketplace');
  if (badge) { badge.textContent = String(underReview); badge.classList.toggle('hidden', !underReview); }
  renderMarketplace();
}
function renderMarketplace() {
  const search = document.getElementById('mkt-admin-search').value.trim().toLowerCase();
  const status = document.getElementById('mkt-admin-status').value;
  let rows = allMarketItems;
  if (search) rows = rows.filter(i => (i.title||'').toLowerCase().includes(search) || (i.seller_phone||'').includes(search));
  if (status) rows = rows.filter(i => i.status === status);
  const statusAr = { active:'نشط', sold:'تم البيع', removed:'محذوف', under_review:'قيد المراجعة' };
  const statusCls = { active:'badge--green', sold:'badge--gray', removed:'badge--red', under_review:'badge--orange' };
  const html = rows.map(i => `
    <tr style="${i.status==='under_review' ? 'background:rgba(217,119,6,.08)' : ''}">
      <td style="font-weight:700">${escapeHtml(i.title)}</td>
      <td style="direction:ltr;font-size:.8rem">${escapeHtml(i.seller_phone)}</td>
      <td>${i.seller_type==='merchant' ? '🏪 تاجر' : '👤 فرد'}</td>
      <td style="font-weight:700;color:var(--pr)">${fmt(i.price)} ج.م</td>
      <td>${i.reports_count > 0 ? `<span style="color:#DC2626;font-weight:700">${i.reports_count} ⚠️</span>` : '—'}</td>
      <td><span class="badge ${statusCls[i.status]||'badge--gray'}">${statusAr[i.status]||i.status}</span></td>
      <td style="font-size:.75rem">${fmtTime(i.created_at)}</td>
      <td>
        <div class="btn-row" style="flex-wrap:nowrap;gap:4px">
          ${i.status === 'under_review' ? `<button class="btn btn--green btn--sm" onclick="marketplaceModerate('${i.id}','approve')">اعتماد</button>` : ''}
          ${i.status !== 'removed' ? `<button class="btn btn--red btn--sm" onclick="marketplaceModerate('${i.id}','remove')">حذف</button>` : ''}
          <a class="btn btn--ghost btn--sm" href="/marketplace/item?id=${i.id}" target="_blank">عرض</a>
        </div>
      </td>
    </tr>`).join('') || '<tr><td colspan="8" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد إعلانات</td></tr>';
  document.getElementById('marketplace-tbody').innerHTML = html;
}
document.getElementById('mkt-admin-search').addEventListener('input', renderMarketplace);
document.getElementById('mkt-admin-status').addEventListener('change', renderMarketplace);

async function marketplaceModerate(itemId, action) {
  const msg = action === 'approve' ? 'اعتماد هذا الإعلان وإرجاعه للعرض العام؟' : 'حذف هذا الإعلان نهائياً؟';
  if (!confirm(msg)) return;
  const pass = getAdminPass();
  if (!pass) return;
  const ok = await sbRpc('admin_moderate_item', { p_admin_phone: ADMIN.phone, p_admin_password: pass, p_item_id: itemId, p_action: action });
  if (ok) { showToast(action === 'approve' ? '✅ تم الاعتماد' : '✅ تم الحذف', '#16A34A'); loadMarketplaceSection(); }
  else { clearAdminPass(); showToast('❌ فشل — تحقق من كلمة مرور المشرف', '#DC2626'); }
}

/* ═══════════════════ MESSAGES ══════════════════════════════ */
let currentMsg = null;
let allMessages = [];

async function loadMessages() {
  const filterEl = document.getElementById('msg-filter');
  const filter = filterEl ? filterEl.value : '';
  const q = filter ? `messages?status=eq.${filter}&order=created_at.desc` : 'messages?order=created_at.desc';
  const rows = await sbGet(q);
  allMessages = rows || [];
  const tbody = document.getElementById('messages-tbody');
  if (!tbody) return;
  if (!rows || !rows.length) { tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد رسائل</td></tr>'; return; }

  const unread = rows.filter(r => r.status === 'unread').length;
  const msgBadge = document.getElementById('badge-messages');
  if (msgBadge) {
    if (unread > 0) { msgBadge.textContent = String(unread); msgBadge.classList.remove('hidden'); }
    else msgBadge.classList.add('hidden');
  }

  const statusLabel = { unread:'غير مقروء', read:'مقروء', replied:'تم الرد' };
  const statusColor = { unread:'#F59E0B', read:'#3B82F6', replied:'#16A34A' };

  tbody.innerHTML = rows.map(m => `
    <tr style="${m.status === 'unread' ? 'background:rgba(245,158,11,.07)' : ''}">
      <td style="font-weight:700">${escapeHtml(m.name)}</td>
      <td>${escapeHtml(m.phone)}</td>
      <td style="color:#3B82F6">${escapeHtml(m.email) || '—'}</td>
      <td>${escapeHtml(m.subject)}</td>
      <td><span style="padding:2px 8px;border-radius:99px;font-size:.75rem;font-weight:700;background:${(statusColor[m.status]||'#94A3B8')}22;color:${statusColor[m.status]||'#94A3B8'}">${statusLabel[m.status] || m.status}</span></td>
      <td style="font-size:.78rem;color:#64748B">${new Date(m.created_at).toLocaleDateString('ar-EG')}</td>
      <td><button onclick="openMsg('${m.id}')" style="padding:.3rem .7rem;background:#0E4B49;color:#fff;border:none;border-radius:5px;font-size:.78rem;cursor:pointer">عرض</button></td>
    </tr>`).join('');
}

function openMsg(id) {
  const m = allMessages.find(x => x.id === id);
  if (!m) return;
  currentMsg = m;
  document.getElementById('msg-modal-subject').textContent = m.subject;
  document.getElementById('msg-modal-name').textContent = m.name;
  document.getElementById('msg-modal-phone').textContent = m.phone;
  document.getElementById('msg-modal-email').textContent = m.email || '—';
  document.getElementById('msg-modal-date').textContent = new Date(m.created_at).toLocaleString('ar-EG');
  document.getElementById('msg-modal-body').textContent = m.message;
  const modal = document.getElementById('msg-modal');
  if (modal) modal.style.display = 'flex';
  if (m.status === 'unread') updateMsgStatus(m.id, 'read');
}

async function updateMsgStatus(id, status) {
  await fetch(`${SB_URL}/rest/v1/messages?id=eq.${id}`, {
    method: 'PATCH', headers: { ...SB_H, Prefer:'return=minimal' },
    body: JSON.stringify({ status }),
  });
  if (currentMsg && currentMsg.id === id) currentMsg.status = status;
  loadMessages();
}

const msgMarkRead = document.getElementById('msg-mark-read');
const msgMarkReplied = document.getElementById('msg-mark-replied');
const msgReplyEmail = document.getElementById('msg-reply-email');
const msgFilter = document.getElementById('msg-filter');
const msgModalEl = document.getElementById('msg-modal');

// These buttons all worked before (the PATCH request fired fine) — but gave
// zero visible feedback: no toast, no modal update, nothing closed. From the
// admin's side that read as "the buttons don't do anything". Add the same
// showToast()/close-modal feedback every other admin action already gives.
if (msgMarkRead) msgMarkRead.addEventListener('click', async () => {
  if (!currentMsg) return;
  await updateMsgStatus(currentMsg.id, 'read');
  showToast('✅ تم التحديد كمقروء', '#3B82F6');
});
if (msgMarkReplied) msgMarkReplied.addEventListener('click', async () => {
  if (!currentMsg) return;
  await updateMsgStatus(currentMsg.id, 'replied');
  showToast('✅ تم تحديد الرسالة كـ"تم الرد"', '#16A34A');
  if (msgModalEl) msgModalEl.style.display = 'none';
});
if (msgReplyEmail) msgReplyEmail.addEventListener('click', async () => {
  if (!currentMsg || !currentMsg.email) { showToast('❌ لا يوجد بريد إلكتروني لهذه الرسالة', '#F59E0B'); return; }
  window.open(`mailto:${currentMsg.email}?subject=رد: ${currentMsg.subject}`);
  await updateMsgStatus(currentMsg.id, 'replied');
  showToast('📧 تم فتح تطبيق البريد وتحديد الرسالة كـ"تم الرد"', '#16A34A');
  if (msgModalEl) msgModalEl.style.display = 'none';
});
if (msgFilter) msgFilter.addEventListener('change', loadMessages);
if (msgModalEl) msgModalEl.addEventListener('click', (e) => {
  if (e.target === msgModalEl) msgModalEl.style.display = 'none';
});

/* ═══════════════════ FINANCE ═══════════════════════════════ */
async function loadFinance() {
  const [orders, rides, commissions] = await Promise.all([
    sbGet('orders?select=id,status,total,delivery_fee,created_at&order=created_at.desc&limit=1000'),
    sbGet('rides?select=id,status,fare,created_at&order=created_at.desc&limit=500'),
    sbGet('wallet_transactions?phone=eq.platform&select=amount,type,note,reference_id,created_at&order=created_at.desc&limit=500'),
  ]);
  const delivered = (orders||[]).filter(o => o.status === 'delivered');
  const totalRev  = delivered.reduce((s,o) => s + (Number(o.total)||0), 0);
  const totalOrd  = delivered.length;
  const avgOrd    = totalOrd ? Math.round(totalRev / totalOrd) : 0;
  const doneRides = (rides||[]).filter(r => r.status==='completed');

  // Commission totals
  const comms = (commissions||[]).filter(c => c.type === 'commission');
  const totalComm = comms.reduce((s,c) => s + Math.abs(Number(c.amount)||0), 0);
  const rideComm  = comms.filter(c => (c.note||'').includes('رحلة') && !(c.note||'').includes('مطار')).reduce((s,c) => s + Math.abs(Number(c.amount)||0), 0);
  const delivComm = comms.filter(c => (c.note||'').includes('توصيل')).reduce((s,c) => s + Math.abs(Number(c.amount)||0), 0);

  document.getElementById('fin-total-rev').textContent        = fmt(totalRev);
  document.getElementById('fin-total-commission').textContent  = fmt(totalComm);
  document.getElementById('fin-ride-commission').textContent   = fmt(rideComm);
  document.getElementById('fin-deliv-commission').textContent  = fmt(delivComm);
  document.getElementById('fin-total-orders').textContent     = fmt(totalOrd);
  document.getElementById('fin-total-rides').textContent      = fmt(doneRides.length);
  document.getElementById('fin-avg-order').textContent        = fmt(avgOrd);

  // Commission log
  document.getElementById('commission-tbody').innerHTML = comms.slice(0,30).map(c => {
    const d = new Date(c.created_at||0).toLocaleDateString('ar-EG', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
    const typeIcon = (c.note||'').includes('توصيل') ? '🛵' : (c.note||'').includes('مطار') ? '✈️' : '🚗';
    return `<tr>
      <td>${d}</td>
      <td>${typeIcon} ${(c.note||'').includes('توصيل') ? 'توصيل' : (c.note||'').includes('مطار') ? 'مطار' : 'رحلة'}</td>
      <td style="font-weight:700;color:#16A34A">+${fmt(Math.abs(Number(c.amount||0)))} ج.م</td>
      <td style="font-size:.8rem;color:#64748B">${c.note||'—'}</td>
      <td style="font-size:.75rem;color:#94A3B8;direction:ltr">${(c.reference_id||'').slice(0,12)||'—'}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="5" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد عمولات بعد</td></tr>';

  // Monthly breakdown
  const monthMap = {};
  (orders||[]).forEach(o => {
    const d   = new Date(o.created_at||0);
    const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
    if (!monthMap[key]) monthMap[key] = { label: MONTHS_AR[d.getMonth()]+' '+d.getFullYear(), orders:0, delivered:0, revenue:0, commission:0, rides:0 };
    monthMap[key].orders++;
    if (o.status === 'delivered') { monthMap[key].delivered++; monthMap[key].revenue += Number(o.total)||0; }
  });
  (rides||[]).forEach(r => {
    const d   = new Date(r.created_at||0);
    const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
    if (monthMap[key]) monthMap[key].rides++;
  });
  comms.forEach(c => {
    const d   = new Date(c.created_at||0);
    const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
    if (monthMap[key]) monthMap[key].commission += Math.abs(Number(c.amount)||0);
  });
  const rows = Object.entries(monthMap).sort((a,b) => b[0].localeCompare(a[0])).slice(0,18);
  document.getElementById('finance-tbody').innerHTML = rows.map(([,m]) => `
    <tr>
      <td style="font-weight:700">${m.label}</td>
      <td>${fmt(m.orders)}</td>
      <td>${fmt(m.delivered)}</td>
      <td style="font-weight:700;color:var(--pr)">${fmt(m.revenue)} ج.م</td>
      <td style="font-weight:700;color:#16A34A">${fmt(Math.round(m.commission))} ج.م</td>
      <td>${fmt(m.rides)}</td>
    </tr>`).join('') || '<tr><td colspan="6" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد بيانات</td></tr>';
}

