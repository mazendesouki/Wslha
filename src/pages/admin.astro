/* ── Approve / Reject ─────────────────────────────────────── */
function toggleReject(type) {
  const area = document.getElementById(`${type}-reject-area`);
  const tog  = document.getElementById(`${type}-reject-toggle`);
  const conf = document.getElementById(`${type}-reject-confirm`);
  area.style.display = area.style.display === 'block' ? 'none' : 'block';
  tog.classList.toggle('hidden', area.style.display === 'block');
  conf.classList.toggle('hidden', area.style.display !== 'block');
}

async function confirmApprove(type) {
  const phone = type === 'driver' ? currentDriverPhone : currentMerchantPhone;
  if (!confirm(`اعتماد هذا الطلب؟`)) return;
  const pass = getAdminPass();
  if (!pass) return;
  const ok = await sbRpc('admin_review_application', {
    p_admin_phone: ADMIN.phone, p_admin_password: pass,
    p_type: type, p_phone: phone, p_status: 'approved', p_reason: null,
  });
  if (ok) {
    showToast('✅ تم الاعتماد بنجاح', '#16A34A');
    closeModal(`${type}-modal`);
    type === 'driver' ? loadDriverApps() : loadMerchantApps();
    loadDash();
  } else { clearAdminPass(); showToast('❌ فشل — تحقق من كلمة مرور المشرف', '#DC2626'); }
}

async function confirmReject(type) {
  const phone  = type === 'driver' ? currentDriverPhone : currentMerchantPhone;
  const reason = document.getElementById(`${type}-reject-reason`).value.trim();
  if (!reason) { showToast('⚠️ أدخل سبب الرفض', '#D97706'); return; }
  if (!confirm('رفض هذا الطلب؟')) return;
  const pass = getAdminPass();
  if (!pass) return;
  const ok = await sbRpc('admin_review_application', {
    p_admin_phone: ADMIN.phone, p_admin_password: pass,
    p_type: type, p_phone: phone, p_status: 'rejected', p_reason: reason,
  });
  if (ok) {
    showToast('تم الرفض', '#DC2626');
    closeModal(`${type}-modal`);
    type === 'driver' ? loadDriverApps() : loadMerchantApps();
    loadDash();
  } else { clearAdminPass(); showToast('❌ فشل — تحقق من كلمة مرور المشرف', '#DC2626'); }
}

