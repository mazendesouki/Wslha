/* ── Auto-refresh ───────────────────────────────────────────── */
const REFRESH_INTERVAL = 30000; // 30 seconds
let refreshTimer = null;
let prevPendingCount = 0;

function setSyncing(on) {
  const badge = document.getElementById('live-badge');
  const label = document.getElementById('live-label');
  if (!badge || !label) return;
  if (on) { badge.classList.add('syncing'); label.textContent = 'يتم التحديث…'; }
  else     { badge.classList.remove('syncing'); label.textContent = 'مباشر'; }
}

async function autoRefreshDash() {
  setSyncing(true);
  try {
    // Lightweight KPI-only refresh
    const [users, orders, stores, dApps, mApps] = await Promise.all([
      sbGet('accounts?select=phone,role,status'),
      sbGet('orders?select=id,status,total,created_at'),
      sbGet('stores?select=id,is_active'),
      sbGet('driver_applications?select=id,phone,status,full_name'),
      sbGet('merchant_applications?select=id,phone,status,business_name'),
    ]);
    const today = new Date().toISOString().slice(0,10);
    const todayOrd  = (orders||[]).filter(o => (o.created_at||'').startsWith(today));
    const revenue   = todayOrd.filter(o => o.status==='delivered').reduce((s,o)=>s+(Number(o.total)||0),0);
    const pendingD  = (dApps||[]).filter(a=>a.status==='pending');
    const pendingM  = (mApps||[]).filter(a=>a.status==='pending');
    const pendingTotal = pendingD.length + pendingM.length;

    // Update KPIs
    const set = (id,v) => { const el=document.getElementById(id); if(el) el.textContent=fmt(v); };
    set('kpi-users',    (users||[]).length);
    set('kpi-drivers',  (users||[]).filter(u=>u.role==='driver'&&u.status==='approved').length);
    set('kpi-today-orders', todayOrd.length);
    set('kpi-revenue',  revenue);
    set('kpi-stores',   (stores||[]).filter(s=>s.is_active).length);
    set('kpi-pending',  pendingTotal);

    // Update sidebar badges
    const db = document.getElementById('badge-drivers');
    const mb = document.getElementById('badge-merchants');
    if (db) { db.textContent = pendingD.length; db.classList.toggle('hidden', pendingD.length===0); }
    if (mb) { mb.textContent = pendingM.length; mb.classList.toggle('hidden', pendingM.length===0); }

    // Alert if new pending apps appeared
    if (pendingTotal > prevPendingCount && prevPendingCount !== 0) {
      showToast(`🔔 طلب اعتماد جديد! (${pendingTotal} معلق)`, '#3B6EF8');
    }
    prevPendingCount = pendingTotal;

    // Always silently refresh pending driver/merchant counts for badges
    const dAppsQuiet = await sbGet('driver_applications?select=id,status&status=eq.pending');
    const mAppsQuiet = await sbGet('merchant_applications?select=id,status&status=eq.pending');
    const dPending = (dAppsQuiet||[]).length;
    const mPending = (mAppsQuiet||[]).length;
    const mainBadge = document.getElementById('dmain-pending-cnt');
    if (mainBadge) { mainBadge.textContent = dPending; mainBadge.style.display = dPending ? '' : 'none'; }

    // If currently viewing a section, refresh it too
    if (loaders[currentSection] && currentSection !== 'dash') loaders[currentSection]();

  } catch(e) { /* silent fail */ }
  setSyncing(false);
}

function startAutoRefresh() {
  if (refreshTimer) clearInterval(refreshTimer);
  refreshTimer = setInterval(autoRefreshDash, REFRESH_INTERVAL);
}

// Pause refresh on tab hidden, resume when visible
document.addEventListener('visibilitychange', () => {
  if (document.hidden) clearInterval(refreshTimer);
  else { autoRefreshDash(); startAutoRefresh(); }
});

/* ── Init ───────────────────────────────────────────────────── */
loadDash();
startAutoRefresh();
</script>
