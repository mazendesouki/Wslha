function renderNetProfitChart(byType) {
  const svg = document.getElementById('np-chart');
  const bars = [
    { label: 'رحلات',  val: Number(byType.ride||0),     color: '#16A34A' },
    { label: 'توصيل',  val: Number(byType.delivery||0), color: '#2563EB' },
    { label: 'مطار',   val: Number(byType.airport||0),  color: '#D97706' },
  ];
  const max = Math.max(1, ...bars.map(b => b.val));
  const barW = 100, gap = 30, top = 8, chartH = 60;
  svg.innerHTML = bars.map((b, i) => {
    const x = i * (barW + gap) + 20;
    const h = Math.max(2, (b.val / max) * chartH);
    const y = top + (chartH - h);
    return `<rect x="${x}" y="${y}" width="${barW}" height="${h}" rx="4" fill="${b.color}"/>` +
      `<text x="${x + barW/2}" y="${y - 4}" text-anchor="middle" font-size="11" font-weight="700" fill="#334155">${fmt(Math.round(b.val))}</text>` +
      `<text x="${x + barW/2}" y="${top + chartH + 14}" text-anchor="middle" font-size="10" fill="#64748B">${b.label}</text>`;
  }).join('');
}

