async function adminSettlePlatform() {
  const balText = (document.getElementById('np-balance').textContent||'0').replace(/[^\d.]/g,'');
  const bal = parseFloat(balText) || 0;
  if (bal <= 0) { showToast('لا يوجد صافي ربح متاح للسحب', '#D97706'); return; }

  const amountStr = prompt(`الرصيد المتاح: ${bal.toFixed(2)} ج.م\nأدخل المبلغ المطلوب سحبه:`, bal.toFixed(2));
  if (!amountStr) return;
  const amount = parseFloat(amountStr);
  if (!amount || amount <= 0) { showToast('مبلغ غير صالح', '#DC2626'); return; }
  if (amount > bal) { showToast('المبلغ أكبر من الرصيد المتاح', '#DC2626'); return; }

  const note = prompt('ملاحظة (اختياري):', '') || null;
  const pass = getAdminPass();
  if (!pass) return;
  const key = getActionKey();
  if (!key) return;

  if (!confirm(`تأكيد سحب ${amount.toFixed(2)} ج.م من أرباح المنصة؟`)) return;

  try {
    const result = await sbRpcJson('admin_withdraw_platform_profit', {
      p_admin_phone: ADMIN.phone, p_admin_password: pass, p_action_key: key,
      p_amount: amount, p_note: note,
    });
    showToast(`✅ تم سحب ${amount.toFixed(2)} ج.م — الرصيد المتبقي ${fmt(Math.round(result.balance_after))} ج.م`, '#16A34A');
    loadPlatformFinance();
  } catch (e) {
    showToast('❌ ' + (e.message || 'فشلت عملية السحب'), '#DC2626');
  }
}

