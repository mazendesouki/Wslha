let allWallets = [], allWalletAccounts = [], allTxLogs = [];

async function loadWalletsSection() {
  document.getElementById('wallets-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr>';
  document.getElementById('all-tx-tbody').innerHTML  = '<tr><td colspan="6" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr>';

  const [wallets, accounts, platformTxns, txData] = await Promise.all([
    sbGet('wallets?select=phone,balance,updated_at&order=balance.desc&limit=2000'),
    sbGet('accounts?select=phone,name,role&limit=2000'),
    sbGet('wallet_transactions?phone=eq.platform&select=amount,note,created_at&order=created_at.desc&limit=5000'),
    sbGet('wallet_transactions?select=id,phone,amount,type,note,reference_id,created_at&order=created_at.desc&limit=500'),
  ]);

  allWalletAccounts = accounts || [];
  const acctMap = {};
  allWalletAccounts.forEach(a => { acctMap[a.phone] = a; });

  allWallets = (wallets || []).map(w => ({
    ...w, name: acctMap[w.phone]?.name || '', role: acctMap[w.phone]?.role || 'customer',
  }));
  allWalletAccounts.forEach(a => {
    if (!allWallets.find(w => w.phone === a.phone))
      allWallets.push({ phone: a.phone, balance: 0, name: a.name || '', role: a.role || 'customer' });
  });

  const totalBal    = allWallets.reduce((s,w) => s + Number(w.balance||0), 0);
  const driverBal   = allWallets.filter(w => w.role === 'driver').reduce((s,w) => s + Number(w.balance||0), 0);
  const merchantBal = allWallets.filter(w => w.role === 'merchant').reduce((s,w) => s + Number(w.balance||0), 0);

  const platformComms   = (platformTxns || []).filter(t => !/تسوية/.test(t.note||''));
  const platformSettled = (platformTxns || []).filter(t => /تسوية/.test(t.note||''));
  const platformBal     = platformComms.reduce((s,t) => s + Number(t.amount||0), 0)
                        - platformSettled.reduce((s,t) => s + Math.abs(Number(t.amount||0)), 0);
  const rideComm    = (platformTxns||[]).filter(t => (t.note||'').includes('رحلة') && !(t.note||'').includes('مطار')).reduce((s,t) => s + Number(t.amount||0), 0);
  const delivComm   = (platformTxns||[]).filter(t => (t.note||'').includes('توصيل')).reduce((s,t) => s + Number(t.amount||0), 0);
  const airportComm = (platformTxns||[]).filter(t => (t.note||'').includes('مطار')).reduce((s,t) => s + Number(t.amount||0), 0);

  document.getElementById('w-platform-balance').textContent = fmt(Math.round(platformBal)) + ' ج.م';
  document.getElementById('w-total-balance').textContent    = fmt(Math.round(totalBal))    + ' ج.م';
  document.getElementById('w-driver-balance').textContent   = fmt(Math.round(driverBal))   + ' ج.م';
  document.getElementById('w-merchant-balance').textContent = fmt(Math.round(merchantBal)) + ' ج.م';
  document.getElementById('pw-ride').textContent     = fmt(Math.round(rideComm))    + ' ج.م';
  document.getElementById('pw-delivery').textContent = fmt(Math.round(delivComm))   + ' ج.م';
  document.getElementById('pw-airport').textContent  = fmt(Math.round(airportComm)) + ' ج.م';

  allTxLogs = (txData || []).map(t => ({ ...t, userName: acctMap[t.phone]?.name || (t.phone === 'platform' ? 'المنصة' : '') }));

  renderWalletsList();
  renderTxLog();
}

function renderWalletsList() {
  const roleFilter = document.getElementById('wallet-role-filter')?.value || '';
  const search     = (document.getElementById('wallet-search')?.value || '').trim().toLowerCase();
  const ROLE_AR    = { driver:'سائق', merchant:'تاجر', customer:'عميل', admin:'مشرف' };
  const ROLE_CLR   = { driver:'#1D4ED8', merchant:'#7C3AED', customer:'#064E3B', admin:'#DC2626' };

  let rows = allWallets;
  if (roleFilter) rows = rows.filter(w => w.role === roleFilter);
  if (search) rows = rows.filter(w => (w.name||'').toLowerCase().includes(search) || (w.phone||'').includes(search));
  rows = rows.slice().sort((a,b) => Number(b.balance||0) - Number(a.balance||0));

  if (!rows.length) {
    document.getElementById('wallets-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد نتائج</td></tr>';
    return;
  }
  document.getElementById('wallets-tbody').innerHTML = rows.slice(0,200).map(w => {
    const bal = Number(w.balance||0);
    const balClr = bal > 0 ? '#15803D' : bal < 0 ? '#DC2626' : '#64748B';
    const rAr = ROLE_AR[w.role] || w.role;
    const rClr = ROLE_CLR[w.role] || '#334155';
    const nameSafe = (w.name||'').replace(/'/g,"\\'");
    return `<tr>
      <td style="font-weight:700">${w.name||'—'}</td>
      <td dir="ltr">${w.phone}</td>
      <td><span style="background:${rClr}22;color:${rClr};font-size:.72rem;font-weight:700;padding:2px 8px;border-radius:99px">${rAr}</span></td>
      <td style="font-weight:800;color:${balClr}">${bal.toFixed(2)} ج.م</td>
      <td><div class="btn-row" style="flex-wrap:nowrap;gap:4px">
        <button class="btn btn--sm" style="background:#DCFCE7;color:#15803D" onclick="adminChargeWallet('${w.phone}','${nameSafe}')">شحن</button>
        <button class="btn btn--red btn--sm" onclick="adminDeductWallet('${w.phone}','${nameSafe}')">خصم</button>
        <button class="btn btn--sm" style="background:#F1F5F9;color:#334155" onclick="viewUserTransactions('${w.phone}','${nameSafe}')">سجل</button>
      </div></td>
    </tr>`;
  }).join('');
}

const TX_TYPES_AR = {
  earning:'أرباح', commission:'عمولة منصة', topup:'شحن', withdrawal:'سحب',
  transfer_out:'تحويل صادر', transfer_in:'تحويل وارد',
  admin_credit:'إضافة إدارية', admin_debit:'خصم إداري', payment:'دفع', refund:'استرداد'
};
const TX_CLR = {
  earning:'#16A34A', commission:'#1D4ED8', topup:'#0891B2', withdrawal:'#DC2626',
  transfer_out:'#D97706', transfer_in:'#7C3AED', admin_credit:'#16A34A', admin_debit:'#DC2626'
};

function renderTxLog() {
  const typeFilter = document.getElementById('tx-type-filter')?.value || '';
  const search     = (document.getElementById('tx-search')?.value || '').trim().toLowerCase();
  let rows = allTxLogs;
  if (typeFilter) rows = rows.filter(t => t.type === typeFilter);
  if (search) rows = rows.filter(t => (t.phone||'').includes(search) || (t.userName||'').includes(search) || (t.note||'').toLowerCase().includes(search));
  if (!rows.length) {
    document.getElementById('all-tx-tbody').innerHTML = '<tr><td colspan="6" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد نتائج</td></tr>';
    return;
  }
  document.getElementById('all-tx-tbody').innerHTML = rows.slice(0,200).map(t => {
    const d   = new Date(t.created_at||0).toLocaleDateString('ar-EG', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
    const amt = Number(t.amount||0);
    const ac  = amt >= 0 ? '#16A34A' : '#DC2626';
    const tc  = TX_CLR[t.type] || '#64748B';
    const tar = TX_TYPES_AR[t.type] || t.type;
    return `<tr>
      <td style="font-size:.78rem">${d}</td>
      <td dir="ltr" style="font-size:.78rem">${t.phone === 'platform' ? '🏢 منصة' : t.phone}</td>
      <td style="font-size:.82rem">${t.userName||'—'}</td>
      <td><span style="background:${tc}22;color:${tc};font-size:.7rem;font-weight:700;padding:2px 7px;border-radius:99px">${tar}</span></td>
      <td style="font-weight:800;color:${ac}">${amt>=0?'+':''}${amt.toFixed(2)} ج.م</td>
      <td style="font-size:.78rem;color:#64748B;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${t.note||t.reference_id||'—'}</td>
    </tr>`;
  }).join('');
}

let _walletOpPhone = '', _walletOpType = '';
function adminChargeWallet(phone, name) {
  _walletOpPhone = phone; _walletOpType = 'credit';
  document.getElementById('wallet-op-title').textContent = '💳 شحن محفظة';
  document.getElementById('wallet-op-user').textContent = name || phone;
  document.getElementById('wallet-op-phone-display').textContent = phone;
  document.getElementById('wallet-op-amount').value = '';
  document.getElementById('wallet-op-note').value = '';
  document.getElementById('wallet-op-msg').style.display = 'none';
  const btn = document.getElementById('wallet-op-confirm-btn');
  btn.textContent = '✅ تأكيد الشحن'; btn.style.background = '#16A34A'; btn.disabled = false;
  document.getElementById('wallet-op-modal').classList.remove('hidden');
}
function adminDeductWallet(phone, name) {
  _walletOpPhone = phone; _walletOpType = 'debit';
  document.getElementById('wallet-op-title').textContent = '➖ خصم من محفظة';
  document.getElementById('wallet-op-user').textContent = name || phone;
  document.getElementById('wallet-op-phone-display').textContent = phone;
  document.getElementById('wallet-op-amount').value = '';
  document.getElementById('wallet-op-note').value = '';
  document.getElementById('wallet-op-msg').style.display = 'none';
  const btn = document.getElementById('wallet-op-confirm-btn');
  btn.textContent = '⚠️ تأكيد الخصم'; btn.style.background = '#DC2626'; btn.disabled = false;
  document.getElementById('wallet-op-modal').classList.remove('hidden');
}

async function execAdminWalletOp() {
  const amtRaw = parseFloat(document.getElementById('wallet-op-amount').value);
  const note   = document.getElementById('wallet-op-note').value.trim() || (_walletOpType === 'credit' ? 'شحن إداري' : 'خصم إداري');
  const msgEl  = document.getElementById('wallet-op-msg');
  if (!amtRaw || amtRaw <= 0) {
    msgEl.style.cssText = 'display:block;background:#FEE2E2;color:#991B1B;font-size:.82rem;font-weight:700;padding:.5rem .75rem;border-radius:6px';
    msgEl.textContent = '⚠️ أدخل مبلغاً صحيحاً أكبر من صفر'; return;
  }
  const amt  = _walletOpType === 'credit' ? amtRaw : -amtRaw;
  const type = _walletOpType === 'credit' ? 'admin_credit' : 'admin_debit';
  const txId = `adm-${_walletOpType === 'credit' ? 'cr' : 'db'}-${Date.now()}`;
  const btn  = document.getElementById('wallet-op-confirm-btn');
  btn.textContent = 'جاري التنفيذ…'; btn.disabled = true;

  const [ok1, ok2] = await Promise.all([
    sbPost('rpc/add_wallet_balance', { p_phone: _walletOpPhone, p_amount: amt }),
    sbPost('wallet_transactions', { id: txId, phone: _walletOpPhone, amount: amt, type, note, created_at: new Date().toISOString() }),
  ]);

  btn.disabled = false;
  if (ok1 || ok2) {
    msgEl.style.cssText = 'display:block;background:#DCFCE7;color:#14532D;font-size:.82rem;font-weight:700;padding:.5rem .75rem;border-radius:6px';
    msgEl.textContent = _walletOpType === 'credit' ? `✅ تم شحن ${amtRaw.toFixed(2)} ج.م بنجاح` : `✅ تم خصم ${amtRaw.toFixed(2)} ج.م بنجاح`;
    setTimeout(() => { closeModal('wallet-op-modal'); loadWalletsSection(); }, 1200);
  } else {
    msgEl.style.cssText = 'display:block;background:#FEE2E2;color:#991B1B;font-size:.82rem;font-weight:700;padding:.5rem .75rem;border-radius:6px';
    msgEl.textContent = '❌ حدث خطأ — تحقق من الاتصال';
    btn.textContent = _walletOpType === 'credit' ? '✅ تأكيد الشحن' : '⚠️ تأكيد الخصم';
  }
}

async function viewUserTransactions(phone, name) {
  document.getElementById('user-tx-modal-title').textContent = `📋 معاملات: ${name || phone}`;
  document.getElementById('user-tx-tbody').innerHTML = '<tr><td colspan="4" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr>';
  document.getElementById('user-tx-modal').classList.remove('hidden');
  const txData = await sbGet(`wallet_transactions?phone=eq.${encodeURIComponent(phone)}&select=amount,type,note,reference_id,created_at&order=created_at.desc&limit=300`);
  if (!txData || !txData.length) {
    document.getElementById('user-tx-tbody').innerHTML = '<tr><td colspan="4" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد معاملات</td></tr>';
    return;
  }
  document.getElementById('user-tx-tbody').innerHTML = txData.map(t => {
    const d = new Date(t.created_at||0).toLocaleDateString('ar-EG', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
    const amt = Number(t.amount||0);
    const ac  = amt >= 0 ? '#16A34A' : '#DC2626';
    return `<tr>
      <td style="font-size:.78rem">${d}</td>
      <td style="font-size:.78rem"><span style="background:${(TX_CLR[t.type]||'#64748B')}22;color:${TX_CLR[t.type]||'#64748B'};font-size:.7rem;font-weight:700;padding:2px 7px;border-radius:99px">${TX_TYPES_AR[t.type]||t.type}</span></td>
      <td style="font-weight:800;color:${ac}">${amt>=0?'+':''}${amt.toFixed(2)} ج.م</td>
      <td style="font-size:.78rem;color:#64748B">${t.note||t.reference_id||'—'}</td>
    </tr>`;
  }).join('');
}

async function adminSettlePlatform() {
  const balText = (document.getElementById('w-platform-balance').textContent||'0').replace(/[^\d.]/g,'');
  const bal = parseFloat(balText) || 0;
  if (bal <= 0) { showToast('لا توجد عمولات مستحقة للتسوية', '#D97706'); return; }
  if (!confirm(`تسوية عمولات المنصة بقيمة ${bal.toFixed(2)} ج.م؟\nسيتم تسجيل عملية السحب في السجل.`)) return;
  const txId = `plat-settle-${Date.now()}`;
  const ok = await sbPost('wallet_transactions', {
    id: txId, phone: 'platform', amount: -bal,
    type: 'withdrawal', note: 'تسوية عمولات المنصة — إداري',
    created_at: new Date().toISOString()
  });
  if (ok) { showToast('✅ تمت تسوية العمولات بنجاح', '#16A34A'); loadWalletsSection(); }
  else showToast('❌ فشلت عملية التسوية', '#DC2626');
}

