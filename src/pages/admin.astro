    msg.style.cssText = 'display:block;background:#FEE2E2;color:#991B1B;font-size:.82rem;font-weight:700;padding:.5rem .75rem;border-radius:6px';
  }
  btn.disabled = false; btn.textContent = '💾 حفظ';
  setTimeout(() => { msg.style.display = 'none'; }, 4000);
}

