/* ── API helpers ────────────────────────────────────────────── */
async function sbGet(path) {
  const ctrl = new AbortController();
  const tid  = setTimeout(() => ctrl.abort(), 8000);
  try {
    const r = await fetch(`${SB_URL}/rest/v1/${path}`, { headers: SB_H, signal: ctrl.signal });
    clearTimeout(tid);
    return r.ok ? await r.json() : null;
  } catch { return null; }
}
async function sbPatch(path, body) {
  const r = await fetch(`${SB_URL}/rest/v1/${path}`, {
    method:'PATCH', headers:{...SB_H,Prefer:'return=minimal'}, body:JSON.stringify(body)
  });
  return r.ok;
}
async function sbPost(path, body) {
  const r = await fetch(`${SB_URL}/rest/v1/${path}`, {
    method:'POST', headers:{...SB_H,Prefer:'return=minimal'}, body:JSON.stringify(body)
  });
  return r.ok;
}
async function sbDelete(path) {
  const r = await fetch(`${SB_URL}/rest/v1/${path}`, { method:'DELETE', headers:SB_H });
  return r.ok;
}
// Privileged admin actions (promote / create admin, delete, approve, list
// PII, change settings) require the admin password; it is verified
// server-side (bcrypt) by the RPC. Cached in sessionStorage — asked once per
// browser tab session, not re-prompted on every page reload/tab switch —
// and cleared automatically when the tab closes (never persisted longer
// than that) or on a wrong-password failure / explicit logout.
let _adminPass = null;
try { _adminPass = sessionStorage.getItem('wslha_admin_pass') || null; } catch {}
function getAdminPass() {
  if (!_adminPass) {
    _adminPass = (prompt('للأمان، أدخل كلمة مرور المشرف لتأكيد العملية:') || '').trim() || null;
    if (_adminPass) { try { sessionStorage.setItem('wslha_admin_pass', _adminPass); } catch {} }
  }
  return _adminPass;
}
function clearAdminPass() {
  _adminPass = null;
  try { sessionStorage.removeItem('wslha_admin_pass'); } catch {}
}
// مفتاح أمان ثانٍ منفصل تمامًا عن كلمة مرور تسجيل الدخول — يُطلب في كل مرة
// (بلا تخزين مؤقت) لأي إجراء خطر: حذف حساب، ترقية/إنشاء أدمن.
function getActionKey() {
  return (prompt('🔒 إجراء حسّاس — أدخل مفتاح الأمان للتأكيد:') || '').trim() || null;
}
async function sbRpc(fn, body) {
  try {
    const r = await fetch(`${SB_URL}/rest/v1/rpc/${fn}`, {
      method:'POST', headers:{...SB_H,'Content-Type':'application/json'}, body:JSON.stringify(body)
    });
    if (!r.ok) return false;
    return (await r.json()) === true;
  } catch { return false; }
}
// Like sbRpc but for table-returning RPCs — returns the row array, or null on failure.
async function sbRpcRows(fn, body) {
  try {
    const r = await fetch(`${SB_URL}/rest/v1/rpc/${fn}`, {
      method:'POST', headers:{...SB_H,'Content-Type':'application/json'}, body:JSON.stringify(body)
    });
    if (!r.ok) return null;
    const rows = await r.json();
    return Array.isArray(rows) ? rows : null;
  } catch { return null; }
}
// For RPCs that return a jsonb scalar/object rather than a boolean or row set.
// Throws with the server's error message on failure so callers can show it.
async function sbRpcJson(fn, body) {
  const r = await fetch(`${SB_URL}/rest/v1/rpc/${fn}`, {
    method:'POST', headers:{...SB_H,'Content-Type':'application/json'}, body:JSON.stringify(body)
  });
  if (!r.ok) {
    let detail = '';
    try { const j = await r.json(); detail = j.message || j.hint || ''; } catch {}
    throw new Error(detail || `فشل الطلب (${r.status})`);
  }
  return await r.json();
}

// The accounts table can no longer be read directly by the anon key (closes
// mass user-data enumeration) — every bulk listing goes through this
// password-verified RPC instead. The admin password is asked once per
// session (cached in _adminPass) and silently reused for every subsequent
// listing/refresh — background timers never re-prompt on their own; if the
// password was wrong we just return an empty list until the admin retries
// via a manual "🔄 تحديث" click (which re-prompts once).
async function adminListAccounts(roleFilter) {
