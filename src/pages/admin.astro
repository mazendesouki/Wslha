        : `<div class="doc-card__img no-img">📄</div>`}
      <div class="doc-card__label">${label}</div>
    </div>`;
  const infoF = (label, val) => val ? `<div class="info-field"><div class="info-field__label">${label}</div><div class="info-field__val">${val}</div></div>` : '';

