const AV_COLORS = ['#3B6FB8','#1C8A57','#B0741C','#8B5CF6','#C2410C','#0E7490','#BE185D'];
function avatarChip(name, key) {
  let h = 0;
  const s = key || name || '';
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  const color = AV_COLORS[h % AV_COLORS.length];
  const parts = (name || '').trim().split(/\s+/).filter(Boolean);
  const initials = parts.length ? (parts.length === 1 ? parts[0].slice(0, 2) : parts[0][0] + parts[1][0]) : '؟';
  return `<div class="av-chip" style="background:${color}">${initials}</div>`;
}
