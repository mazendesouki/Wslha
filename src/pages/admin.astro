document.getElementById('sql-setup').textContent = SQL_SETUP;
function copySql() {
  navigator.clipboard.writeText(SQL_SETUP).then(() => showToast('✅ تم النسخ', '#16A34A'));
}

document.getElementById('create-admin-form').addEventListener('submit', async e => {
  e.preventDefault();
  const name  = document.getElementById('new-admin-name').value.trim();
  const phone = document.getElementById('new-admin-phone').value.trim();
  const pass  = document.getElementById('new-admin-pass').value;
  const msg   = document.getElementById('admin-create-msg');
  if (!name || !phone || !pass) { msg.textContent='أكمل جميع الحقول'; msg.style.cssText='display:block;background:#FEE2E2;color:#DC2626'; return; }
  const ok = await sbPost('accounts', {
    phone, name, password:pass, role:'admin', status:'active', created_at: new Date().toISOString()
  });
  if (ok) {
    msg.textContent = '✅ تم إنشاء حساب المشرف بنجاح';
    msg.style.cssText = 'display:block;background:#DCFCE7;color:#16A34A';
    document.getElementById('create-admin-form').reset();
  } else {
    msg.textContent = '❌ حدث خطأ (قد يكون الجوال مسجلاً مسبقاً)';
    msg.style.cssText = 'display:block;background:#FEE2E2;color:#DC2626';
  }
});

