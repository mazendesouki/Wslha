    document.getElementById('pw-delivery').textContent = fmt(Math.round(summary.by_type.delivery)) + ' ج.م';
    document.getElementById('pw-airport').textContent  = fmt(Math.round(summary.by_type.airport))  + ' ج.م';
    renderNetProfitChart(summary.by_type);
    document.getElementById('np-refresh-note').textContent = 'آخر تحديث: ' + new Date().toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
