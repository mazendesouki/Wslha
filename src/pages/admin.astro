async function execAdminWalletOp() {
  const amtRaw = parseFloat(document.getElementById('wallet-op-amount').value);
  const note   = document.getElementById('wallet-op-note').value.trim();
  const msgEl  = document.getElementById('wallet-op-msg');
  const showOpErr = (m) => {
    msgEl.style.cssText = 'display:block;background:#FEE2E2;color:#991B1B;font-size:.82rem;font-weight:700;padding:.5rem .75rem;border-radius:6px';
    msgEl.textContent = m;
  };
  if (!amtRaw || amtRaw <= 0) { showOpErr('⚠️ أدخل مبلغاً صحيحاً أكبر من صفر'); return; }
  // Mandatory documented reason — no anonymous/arbitrary balance changes.
  if (note.length < 5) { showOpErr('⚠️ السبب إلزامي (5 أحرف على الأقل) — كل عملية تُسجَّل وتُراجَع'); return; }
  // Record who performed the operation (admin identity) for the audit trail.
  const adminTag = (ADMIN && (ADMIN.name || ADMIN.phone)) ? ` — بواسطة ${ADMIN.name || ADMIN.phone}` : '';
  const fullNote = note + adminTag;
  const amt  = _walletOpType === 'credit' ? amtRaw : -amtRaw;
  const type = _walletOpType === 'credit' ? 'admin_credit' : 'admin_debit';
  const pass = getAdminPass();
  if (!pass) return;
  const btn  = document.getElementById('wallet-op-confirm-btn');
  btn.textContent = 'جاري التنفيذ…'; btn.disabled = true;

  // admin_adjust_wallet يسجّل المعاملة ويعدّل الرصيد سوا (ذرّي) بعد التحقق
  // من باسورد الأدمن — بدل نداء log_wallet_transaction/add_wallet_balance
  // مباشرة، اللي بقت add_wallet_balance مقفولة عن anon أصلاً (security-44).
  const ok1 = await sbRpc('admin_adjust_wallet', {
    p_admin_phone: ADMIN.phone, p_admin_password: pass,
    p_phone: _walletOpPhone, p_amount: amt, p_type: type, p_note: fullNote,
  });
  if (!ok1) clearAdminPass();

  btn.disabled = false;
  if (ok1) {
    msgEl.style.cssText = 'display:block;background:#DCFCE7;color:#14532D;font-size:.82rem;font-weight:700;padding:.5rem .75rem;border-radius:6px';
    msgEl.textContent = _walletOpType === 'credit' ? `✅ تم شحن ${amtRaw.toFixed(2)} ج.م بنجاح` : `✅ تم خصم ${amtRaw.toFixed(2)} ج.م بنجاح`;
    setTimeout(() => { closeModal('wallet-op-modal'); loadWalletsSection(); }, 1200);
  } else {
    msgEl.style.cssText = 'display:block;background:#FEE2E2;color:#991B1B;font-size:.82rem;font-weight:700;padding:.5rem .75rem;border-radius:6px';
    msgEl.textContent = '❌ حدث خطأ — تحقق من الاتصال';
    btn.textContent = _walletOpType === 'credit' ? '✅ تأكيد الشحن' : '⚠️ تأكيد الخصم';
  }
}

