async function loadDriverAccounts() {
  const data = await sbGet('accounts?role=eq.driver&select=*&order=created_at.desc&limit=500');
  allDriverAccounts = data || [];
  renderDriverAccounts();
}
function renderDriverAccounts() {
  const search = document.getElementById('drivers-acct-search').value.trim().toLowerCase();
  const status = document.getElementById('drivers-acct-status').value;
  let rows = allDriverAccounts;
  if (search) rows = rows.filter(u => (u.name||'').toLowerCase().includes(search)||(u.phone||'').includes(search));
  if (status) rows = rows.filter(u => (u.status||'active') === status);
  const html = rows.map((u,i) => `
