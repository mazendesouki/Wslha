      if (r.key === 'commission_delivery') { const el = document.getElementById('rate-delivery'); if(el) el.value = r.value; }
      if (r.key === 'commission_airport')  { const el = document.getElementById('rate-airport');  if(el) el.value = r.value; }
    });
  } catch {}
}

async function saveCommissionRates() {
  const btn = document.getElementById('save-rates-btn');
  const msg = document.getElementById('rates-msg');
  btn.disabled = true; btn.textContent = 'جاري الحفظ...';
  const pairs = [
    { key:'commission_ride',     value: document.getElementById('rate-ride').value },
    { key:'commission_delivery', value: document.getElementById('rate-delivery').value },
    { key:'commission_airport',  value: document.getElementById('rate-airport').value },
  ];
  try {
    await Promise.all(pairs.map(p =>
      fetch(`${SB_URL}/rest/v1/app_settings`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ key: p.key, value: p.value, updated_at: new Date().toISOString() }),
      })
    ));
    msg.textContent = '✅ تم حفظ النسب بنجاح — ستطبق على الرحلات القادمة';
    msg.style.cssText = 'display:block;background:#DCFCE7;color:#14532D;font-size:.82rem;font-weight:700;padding:.5rem .75rem;border-radius:6px';
    showToast('✅ تم حفظ نسب العمولة', '#16A34A');
  } catch {
    msg.textContent = 'حدث خطأ، حاول مرة أخرى';
    msg.style.cssText = 'display:block;background:#FEE2E2;color:#991B1B;font-size:.82rem;font-weight:700;padding:.5rem .75rem;border-radius:6px';
  }
  btn.disabled = false; btn.textContent = '💾 حفظ النسب';
  setTimeout(() => { msg.style.display = 'none'; }, 4000);
}

