/* ═══════════════════ CORPORATE CONTRACTS ════════════════════
   Deliberately its own top-level nav section (not folded into
   courier/stores/orders) — B2B monthly contracts are a distinct
   business line with their own review/approval flow. */
let allCorporateContracts = [], currentContractId = '';
const SERVICE_TYPE_AR = { delivery: 'توصيل طلبات', rides: 'مشاوير موظفين', both: 'توصيل ومشاوير' };

async function loadCorporateContracts() {
  const data = await sbGet('corporate_contracts?select=*&order=created_at.desc&limit=500');
  allCorporateContracts = data || [];
  const pending = allCorporateContracts.filter(c => c.status === 'pending').length;
  const b = document.getElementById('badge-corporate');
  if (pending > 0) { b.hidden = false; b.textContent = String(pending); } else b.hidden = true;
  renderCorporateContracts();
}
function renderCorporateContracts() {
  const search = document.getElementById('corporate-search').value.trim().toLowerCase();
  const status = document.getElementById('corporate-status-filter').value;
  let rows = allCorporateContracts;
  if (search) rows = rows.filter(c => (c.company_name||'').toLowerCase().includes(search)||(c.contact_phone||'').includes(search));
  if (status) rows = rows.filter(c => c.status === status);
  const html = rows.map(c => `
    <tr>
      <td style="font-weight:700">${escapeHtml(c.company_name)||'—'}</td>
      <td>${escapeHtml(c.contact_name)||'—'}</td>
      <td style="direction:ltr;font-size:.82rem">${escapeHtml(c.contact_phone)||'—'}</td>
      <td style="font-size:.82rem">${SERVICE_TYPE_AR[c.service_type]||c.service_type||'—'}</td>
      <td style="font-size:.82rem">${escapeHtml(c.monthly_volume)||'—'}</td>
      <td>${badge(c.status)}</td>
      <td style="font-size:.75rem">${fmtTime(c.created_at)}</td>
      <td><button class="btn btn--primary btn--sm" onclick="openCorporateModal('${c.id}')">📋 مراجعة</button></td>
    </tr>`).join('') || '<tr><td colspan="8" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد طلبات تعاقد بعد</td></tr>';
  document.getElementById('corporate-tbody').innerHTML = html;
}
document.getElementById('corporate-search').addEventListener('input', renderCorporateContracts);
document.getElementById('corporate-status-filter').addEventListener('change', renderCorporateContracts);

function openCorporateModal(id) {
  currentContractId = id;
  const c = allCorporateContracts.find(x => x.id === id);
  if (!c) return;
  document.getElementById('corporate-modal-body').innerHTML = `
    <div class="info-grid">
      <div class="info-field"><div style="font-size:.68rem;color:#64748B;margin-bottom:.15rem">اسم الشركة</div><div style="font-weight:700">${escapeHtml(c.company_name)||'—'}</div></div>
      <div class="info-field"><div style="font-size:.68rem;color:#64748B;margin-bottom:.15rem">المسؤول</div><div style="font-weight:700">${escapeHtml(c.contact_name)||'—'}</div></div>
      <div class="info-field"><div style="font-size:.68rem;color:#64748B;margin-bottom:.15rem">الجوال</div><div style="font-weight:700;direction:ltr">${escapeHtml(c.contact_phone)||'—'}</div></div>
      <div class="info-field"><div style="font-size:.68rem;color:#64748B;margin-bottom:.15rem">البريد الإلكتروني</div><div style="font-weight:700">${escapeHtml(c.contact_email)||'—'}</div></div>
      <div class="info-field"><div style="font-size:.68rem;color:#64748B;margin-bottom:.15rem">نوع الخدمة</div><div style="font-weight:700">${SERVICE_TYPE_AR[c.service_type]||c.service_type||'—'}</div></div>
      <div class="info-field"><div style="font-size:.68rem;color:#64748B;margin-bottom:.15rem">الحجم الشهري المتوقع</div><div style="font-weight:700">${escapeHtml(c.monthly_volume)||'—'}</div></div>
      <div class="info-field"><div style="font-size:.68rem;color:#64748B;margin-bottom:.15rem">الحالة</div><div>${badge(c.status)}</div></div>
      <div class="info-field"><div style="font-size:.68rem;color:#64748B;margin-bottom:.15rem">تاريخ الطلب</div><div style="font-weight:700">${fmtTime(c.created_at)}</div></div>
    </div>
    ${c.notes ? `<div class="info-field" style="margin-bottom:1rem"><div style="font-size:.68rem;color:#64748B;margin-bottom:.15rem">تفاصيل إضافية</div><div>${escapeHtml(c.notes)}</div></div>` : ''}
    ${c.status === 'approved' && c.proposed_fee ? `<div class="info-field" style="margin-bottom:1rem;background:#DCFCE7"><div style="font-size:.68rem;color:#14532D;margin-bottom:.15rem">السعر الشهري المعتمد</div><div style="font-weight:700;color:#14532D">${fmt(c.proposed_fee)} ج.م</div></div>` : ''}
    ${c.status === 'rejected' && c.rejection_reason ? `<div class="info-field" style="margin-bottom:1rem;background:#FEE2E2"><div style="font-size:.68rem;color:#991B1B;margin-bottom:.15rem">سبب الرفض</div><div style="color:#991B1B">${escapeHtml(c.rejection_reason)}</div></div>` : ''}
  `;
  const feeInput = document.getElementById('corporate-fee-input');
  const approveBtn = document.getElementById('corporate-approve-btn');
  const isPending = c.status === 'pending';
  feeInput.value = c.proposed_fee || '';
  feeInput.style.display = isPending ? '' : 'none';
  approveBtn.style.display = isPending ? '' : 'none';
  document.getElementById('corporate-modal').classList.remove('hidden');
}
async function corporateApprove() {
  const fee = parseFloat(document.getElementById('corporate-fee-input').value);
  if (!fee || fee <= 0) { showToast('⚠️ أدخل السعر الشهري المتفق عليه أولاً', '#D97706'); return; }
  const ok = await sbPatch(`corporate_contracts?id=eq.${encodeURIComponent(currentContractId)}`, {
    status: 'approved', proposed_fee: fee, reviewed_at: new Date().toISOString(),
  });
  if (ok) { showToast('✅ تم اعتماد العقد', '#16A34A'); closeModal('corporate-modal'); loadCorporateContracts(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}
async function corporateReject() {
  const reason = prompt('سبب رفض هذا الطلب؟') || '';
  if (!reason.trim()) return;
  const ok = await sbPatch(`corporate_contracts?id=eq.${encodeURIComponent(currentContractId)}`, {
    status: 'rejected', rejection_reason: reason.trim(), reviewed_at: new Date().toISOString(),
  });
  if (ok) { showToast('تم رفض الطلب', '#DC2626'); closeModal('corporate-modal'); loadCorporateContracts(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}

