<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>لوحة التحكم — وصّلها</title>
  <link rel="icon" href="/icon.svg" type="image/svg+xml"/>
  <style is:global>
    /* is:global — this whole dashboard is JS-driven (innerHTML-rendered
       tables, modals, cards); Astro's default scoped CSS only tags
       elements written directly in this file's static template with the
       data-astro-cid attribute its scoping relies on, so anything built
       at runtime (which is most of this page) silently got NO styling
       from a scoped <style> block. */
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;600;700&display=swap');
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      /* dark sidebar (slight teal bias, not flat navy) */
      --sb:#081716;--sb2:#0F2624;--sb3:#1D3B38;
      --tx:#EFF6F5;--tx2:#9DB3AF;--tx3:#5C716D;
      /* brand teal stays the accent everywhere; semantic colors are separate */
      --pr:#0E4B49;--pr2:#082F2E;--pr3:#3FA79A;--pr-l:#E1EEEC;
      --green:#1C8A57;--green-l:#DFF3E7;
      --red:#C2362A;--red-l:#FBE2DF;
      --orange:#B0741C;--orange-l:#FBEED9;
      --blue:#3B6FB8;--blue-l:#E4EBF8;
      --bg:#0E2422;--card:#fff;--card-2:#EAF0EE;--bdr:#DCE6E3;
      --radius:9px;--radius-lg:14px;
      --sh:0 1px 2px rgba(9,30,27,.05),0 8px 20px -12px rgba(9,30,27,.14);
      --sh-md:0 4px 10px rgba(9,30,27,.06),0 16px 32px -14px rgba(9,30,27,.2);
      --font-num:'JetBrains Mono',ui-monospace,monospace;
    }
    body{font-family:'Cairo',system-ui,sans-serif;background:var(--bg);color:#10201E;direction:rtl}
    a{text-decoration:none}
    button{font-family:inherit;cursor:pointer}
    .hidden{display:none!important}
    .num{font-family:var(--font-num);font-variant-numeric:tabular-nums;direction:ltr;unicode-bidi:isolate}

    /* ── Layout ───────────────────────────────────────────── */
    .admin-wrap{display:flex;min-height:100vh}

    /* Sidebar */
    .sidebar{width:258px;background:linear-gradient(185deg,var(--sb),var(--sb2));flex-shrink:0;display:flex;flex-direction:column;position:fixed;top:0;right:0;bottom:0;z-index:100;transition:transform .3s}
    .sidebar__logo{padding:1.4rem 1.5rem;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:.7rem}
    .sidebar__logo::before{content:'و';width:36px;height:36px;border-radius:10px;flex-shrink:0;background:linear-gradient(135deg,var(--pr3),var(--pr));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:.95rem;box-shadow:0 6px 16px -6px rgba(63,167,154,.55)}
    .sidebar__logo-name{font-size:1.2rem;font-weight:900;color:var(--tx)}
    .sidebar__logo-sub{font-size:.68rem;color:var(--tx3);margin-top:1px}
    .sidebar__admin{display:flex;align-items:center;gap:.75rem;padding:1rem 1.5rem;border-bottom:1px solid rgba(255,255,255,.06)}
    .sidebar__avatar{width:34px;height:34px;border-radius:50%;background:rgba(63,167,154,.16);display:flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:800;color:var(--pr3);flex-shrink:0}
    .sidebar__admin-name{font-size:.82rem;font-weight:700;color:var(--tx);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .sidebar__admin-role{font-size:.68rem;color:var(--tx3)}
    nav{flex:1;overflow-y:auto;padding:.75rem .75rem}
    .nav-item{display:flex;align-items:center;gap:.7rem;padding:.62rem .75rem;font-size:.85rem;font-weight:600;color:var(--tx2);transition:all .15s;cursor:pointer;border-radius:10px;width:100%;background:none;border:none;text-align:right;position:relative}
    .nav-item:hover{background:rgba(255,255,255,.05);color:var(--tx)}
    .nav-item.active{background:rgba(63,167,154,.14);color:#EFFBF9}
    .nav-item.active::after{content:'';position:absolute;right:-.75rem;top:50%;transform:translateY(-50%);width:3px;height:18px;border-radius:3px;background:var(--pr3)}
    .nav-item__icon{font-size:1.05rem;flex-shrink:0;opacity:.92}
    .nav-item__badge{margin-right:auto;background:var(--red);color:#fff;font-size:.63rem;font-weight:800;padding:1px 7px;border-radius:99px;min-width:20px;text-align:center;font-family:var(--font-num)}
    .nav-divider{height:1px;background:rgba(255,255,255,.06);margin:.6rem .75rem}
    .sidebar__logout{padding:.9rem 1.5rem;border-top:1px solid rgba(255,255,255,.06)}
    .btn-logout{display:flex;align-items:center;gap:.5rem;color:#F0A79E;font-size:.83rem;font-weight:700;background:rgba(194,54,42,.12);border:1px solid rgba(194,54,42,.22);border-radius:var(--radius);padding:.6rem 1rem;width:100%;justify-content:center;transition:all .2s}
    .btn-logout:hover{background:var(--red);color:#fff}

    /* Main content */
    .main{margin-right:258px;flex:1;display:flex;flex-direction:column;min-height:100vh}
    .topbar{background:var(--card);border-bottom:1px solid var(--bdr);padding:.9rem 1.6rem;display:flex;align-items:center;gap:1rem;position:sticky;top:0;z-index:50}
    .topbar__burger{display:none;background:none;border:1.5px solid var(--bdr);border-radius:var(--radius);padding:.4rem .6rem;font-size:1.1rem}
    .topbar__title{font-size:1.08rem;font-weight:900;color:#10201E;flex:1}
    .topbar__date{font-size:.78rem;color:var(--tx3)}
    .live-badge{display:flex;align-items:center;gap:.35rem;font-size:.72rem;font-weight:700;color:var(--green);background:var(--green-l);padding:.25rem .65rem;border-radius:99px;white-space:nowrap}
    .live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse-dot 1.4s ease-in-out infinite}
    @keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
    .live-badge.syncing .live-dot{background:var(--orange);animation:spin-dot 1s linear infinite}
    @keyframes spin-dot{to{transform:rotate(360deg)}}
    .content{padding:1.6rem;flex:1}
    .section{display:none}
    .section.active{display:block}

    /* ── Cards ────────────────────────────────────────────── */
    .card{background:var(--card);border:1px solid var(--bdr);border-radius:var(--radius-lg);box-shadow:var(--sh)}
    .card__head{padding:.9rem 1.3rem;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;gap:.6rem;flex-wrap:wrap}
    .card__title{font-size:.92rem;font-weight:800;color:#10201E}
    .card__body{padding:1.3rem}

    /* KPI grid — icon chip, tabular value, trend pill */
    .kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:1rem;margin-bottom:1.5rem}
    .kpi{position:relative;overflow:hidden;background:var(--card);border:1px solid var(--bdr);border-radius:var(--radius-lg);padding:1.2rem 1.3rem;box-shadow:var(--sh);display:flex;flex-direction:column;gap:.7rem;transition:transform .18s,box-shadow .18s}
    .kpi:hover{transform:translateY(-3px);box-shadow:var(--sh-md)}
    .kpi__row{display:flex;align-items:center;justify-content:space-between}
    /* Solid color chip (not a pale tint) — emoji glyphs render with their
       own fixed multicolor look regardless of CSS `color`, so the only way
       to make each KPI's category actually read as color-coded at a glance
       is a bold chip behind it, not a wash that blends into the card. */
    .kpi__icon-wrap{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;box-shadow:0 6px 14px -6px rgba(9,30,27,.35)}
    .kpi--blue .kpi__icon-wrap{background:linear-gradient(150deg,var(--pr3),var(--pr))}
    .kpi--green .kpi__icon-wrap{background:linear-gradient(150deg,#38B378,var(--green))}
    .kpi--orange .kpi__icon-wrap{background:linear-gradient(150deg,#D89A3E,var(--orange))}
    .kpi--red .kpi__icon-wrap{background:linear-gradient(150deg,#DA6156,var(--red))}
    .kpi__trend{font-size:.66rem;font-weight:800;padding:2px 8px;border-radius:99px;white-space:nowrap;font-family:var(--font-num)}
    .kpi__trend.up{background:var(--green-l);color:var(--green)}
    .kpi__trend.down{background:var(--red-l);color:var(--red)}
    .kpi__trend.flat{background:var(--card-2);color:var(--tx3)}
    .kpi--blue .kpi__trend{background:var(--pr-l);color:var(--pr)}
    .kpi--orange .kpi__trend{background:var(--orange-l);color:var(--orange)}
    .kpi__val{font-family:var(--font-num);font-variant-numeric:tabular-nums;font-size:1.65rem;font-weight:700;color:#10201E;line-height:1;letter-spacing:-.01em}
    .kpi__label{font-size:.78rem;color:var(--tx3);font-weight:600}
    .kpi--blue .kpi__val{color:var(--pr)}
    .kpi--green .kpi__val{color:var(--green)}
    .kpi--orange .kpi__val{color:var(--orange)}
    .kpi--red .kpi__val{color:var(--red)}

    /* ── Charts (hand-rolled SVG, no external lib) ───────────── */
    .chart-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:1.25rem;margin-bottom:1.25rem;align-items:start}
    .chart-grid__col{display:flex;flex-direction:column;gap:1.25rem}
    .chart-card__head{padding:1rem 1.25rem;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap}
    .chart-card__title{font-size:.9rem;font-weight:900;color:#1E293B;display:block}
    .chart-card__sub{font-size:.72rem;color:var(--tx3);font-weight:600;display:block;margin-top:1px}
    .chart-card__body{padding:1rem 1.25rem 1.15rem;position:relative}
    .chart-legend{display:flex;gap:1rem;flex-wrap:wrap}
    .chart-legend__item{display:flex;align-items:center;gap:.4rem;font-size:.75rem;font-weight:700;color:var(--tx3)}
    .chart-legend__dot{width:9px;height:9px;border-radius:3px;flex-shrink:0}
    .chart-svg{width:100%;height:auto;display:block;overflow:visible}
    .chart-tooltip{position:absolute;pointer-events:none;background:#1E293B;color:#fff;font-size:.72rem;font-weight:700;padding:.4rem .65rem;border-radius:8px;white-space:nowrap;transform:translate(-50%,-115%);z-index:5;box-shadow:var(--sh-md);transition:opacity .1s;text-align:center}
    .chart-tooltip.hidden{opacity:0;pointer-events:none}
    .chart-tooltip__sub{font-weight:600;color:#94A3B8;font-size:.66rem;margin-top:1px}
    @media(max-width:900px){.chart-grid{grid-template-columns:1fr}}

    /* ── Tables ───────────────────────────────────────────── */
    .tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
    table{width:100%;border-collapse:collapse;font-size:.85rem}
    th{padding:.68rem 1.1rem;text-align:right;font-size:.68rem;font-weight:700;color:var(--tx3);background:var(--card-2);border-bottom:1px solid var(--bdr);white-space:nowrap;text-transform:uppercase;letter-spacing:.05em}
    td{padding:.8rem 1.1rem;border-bottom:1px solid var(--bdr);color:#2A3B39;vertical-align:middle;text-align:right}
    td[colspan]{text-align:center}
    tr:last-child td{border-bottom:none}
    tr:hover td{background:var(--card-2)}

    /* ── User cell (avatar chip + name/subtext) ─────────────── */
    .user-cell{display:flex;align-items:center;gap:.65rem}
    .av-chip{width:34px;height:34px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.72rem;color:#fff}

    /* ── Badges ───────────────────────────────────────────── */
    .badge{display:inline-flex;align-items:center;gap:5px;padding:3px 10px 3px 9px;border-radius:99px;font-size:.72rem;font-weight:700;white-space:nowrap}
    .badge::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0}
    .badge--green{background:var(--green-l);color:var(--green)}
    .badge--red{background:var(--red-l);color:var(--red)}
    .badge--orange{background:var(--orange-l);color:var(--orange)}
    .badge--blue{background:var(--blue-l);color:var(--blue)}
    .badge--gray{background:var(--card-2);color:var(--tx3)}
    .badge--purple{background:var(--pr-l);color:var(--pr)}

    /* ── Buttons ──────────────────────────────────────────── */
    .btn{padding:.52rem 1.05rem;border-radius:var(--radius);font-family:inherit;font-size:.82rem;font-weight:700;border:none;cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:.35rem}
    .btn--primary{background:var(--pr);color:#fff}.btn--primary:hover{background:var(--pr2)}
    .btn--green{background:var(--green);color:#fff}.btn--green:hover{background:#156B45}
    .btn--red{background:var(--red-l);color:var(--red);border:1px solid #F3C3BD}.btn--red:hover{background:var(--red);color:#fff}
    .btn--orange{background:var(--orange-l);color:var(--orange);border:1px solid #F0D9AC}.btn--orange:hover{background:var(--orange);color:#fff}
    .btn--outline{background:var(--card);color:var(--pr);border:1.5px solid var(--pr-l)}.btn--outline:hover{background:var(--pr-l)}
    .btn--ghost{background:var(--card-2);color:var(--tx3);border:1.5px solid var(--bdr)}.btn--ghost:hover{border-color:var(--pr);color:var(--pr)}
    .btn--sm{padding:.32rem .7rem;font-size:.75rem}
    .btn-row{display:flex;gap:.4rem;flex-wrap:wrap}
    .link-btn{background:none;border:none;padding:0;margin:0;font:inherit;font-weight:700;color:var(--pr);cursor:pointer;text-decoration:none;text-align:right}
    .link-btn:hover{text-decoration:underline;color:var(--pr3)}

    /* ── Filters / Search ─────────────────────────────────── */
    .filters-bar{display:flex;gap:.75rem;margin-bottom:1.25rem;flex-wrap:wrap;align-items:center}
    .search-input{padding:.55rem .95rem;border:1.5px solid var(--bdr);border-radius:var(--radius);font-family:inherit;font-size:.85rem;background:var(--card-2);color:#2A3B39;flex:1;min-width:180px;transition:border-color .2s,background .2s}
    .search-input:focus{outline:none;border-color:var(--pr);background:var(--card)}
    .filter-select{padding:.5rem .8rem;border:1.5px solid var(--bdr);border-radius:var(--radius);font-family:inherit;font-size:.82rem;font-weight:600;background:var(--card-2);color:#2A3B39;cursor:pointer}
    .filter-select:focus{outline:none;border-color:var(--pr)}

    /* ── Tabs ─────────────────────────────────────────────── */
    .tab-bar{display:flex;gap:0;background:var(--card-2);border:1px solid var(--bdr);border-radius:var(--radius-lg);padding:3px;margin-bottom:1.25rem;overflow-x:auto;scrollbar-width:none}
    .tab-bar::-webkit-scrollbar{display:none}
    .tab-btn{padding:.45rem 1rem;border-radius:calc(var(--radius-lg) - 3px);border:none;background:transparent;font-family:inherit;font-size:.82rem;font-weight:700;color:var(--tx3);cursor:pointer;white-space:nowrap;transition:all .15s}
    .tab-btn.active{background:var(--pr);color:#fff}
    .tab-btn:not(.active):hover{background:var(--card);color:#2A3B39}

    /* ── Stats row ────────────────────────────────────────── */
    .dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem}

    /* ── Modal ────────────────────────────────────────────── */
    .modal-bg{position:fixed;inset:0;background:rgba(8,23,22,.55);z-index:1000;display:flex;align-items:center;justify-content:center;padding:1rem}
    .modal{background:var(--card);border-radius:var(--radius-lg);max-width:820px;width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 25px 60px rgba(9,30,27,.3)}
    .modal__head{padding:1.25rem 1.5rem;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--card);z-index:2}
    .modal__title{font-size:1rem;font-weight:800;color:#10201E}
    .modal__close{background:none;border:none;font-size:1.3rem;color:var(--tx3);cursor:pointer;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center}
    .modal__close:hover{background:var(--card-2)}
    .modal__body{padding:1.5rem}
    .modal__foot{padding:1rem 1.5rem;border-top:1px solid var(--bdr);display:flex;gap:.75rem;justify-content:flex-end;background:var(--card);position:sticky;bottom:0}

    /* Doc viewer */
    .doc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;margin-bottom:1.5rem}
    .doc-card{border:1px solid var(--bdr);border-radius:var(--radius);overflow:hidden}
    .doc-card__img{width:100%;height:140px;object-fit:cover;display:block;background:var(--card-2);cursor:pointer}
    .doc-card__img.no-img{display:flex;align-items:center;justify-content:center;color:var(--tx3);font-size:2rem}
    .doc-card__label{padding:.4rem .6rem;font-size:.72rem;font-weight:700;color:var(--tx3);background:var(--card-2);border-top:1px solid var(--bdr)}
    .info-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:.75rem;margin-bottom:1.5rem}
    .info-field{background:var(--card-2);border:1px solid var(--bdr);border-radius:var(--radius);padding:.6rem .8rem}
    .info-field__label{font-size:.68rem;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.03em;margin-bottom:.15rem}
    .info-field__val{font-size:.875rem;font-weight:600;color:#2A3B39}
    .reject-area{display:none;margin-top:1rem}

    /* ── Review modal (driver/merchant applications) ─────────── */
    .rev-header{display:flex;align-items:center;gap:1rem;padding-bottom:1.25rem;margin-bottom:1.5rem;border-bottom:1px solid var(--bdr)}
    .rev-avatar{width:72px;height:72px;border-radius:50%;object-fit:cover;flex-shrink:0;background:var(--card-2);box-shadow:0 0 0 3px var(--card),0 0 0 4px var(--bdr);cursor:pointer}
    .rev-avatar.no-img{display:flex;align-items:center;justify-content:center;font-size:1.7rem;color:var(--tx3);cursor:default}
    .rev-header__top{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}
    .rev-header__name{font-size:1.15rem;font-weight:800;color:#10201E}
    .rev-header__phone{font-size:.82rem;color:var(--tx3);direction:ltr;unicode-bidi:isolate;margin-top:3px;font-family:var(--font-num)}
    .rev-section{margin-bottom:1.5rem}
    .rev-section:last-child{margin-bottom:0}
    .rev-section__head{display:flex;align-items:center;gap:.5rem;font-size:.82rem;font-weight:800;color:#10201E;margin-bottom:.85rem;padding-right:.65rem;border-right:4px solid var(--pr)}
    .rev-fields{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:.6rem;margin-bottom:.85rem}
    .rev-field{background:var(--card-2);border:1px solid var(--bdr);border-radius:var(--radius);padding:.5rem .75rem}
    .rev-field__label{font-size:.65rem;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.03em;margin-bottom:.15rem}
    .rev-field__val{font-size:.85rem;font-weight:700;color:#2A3B39}
    .rev-field__val.is-expired{color:var(--red)}
    .rev-field__val.is-expiring{color:var(--orange)}
    .rev-docs{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:.7rem}
    .rev-doc{border:1px solid var(--bdr);border-radius:var(--radius);overflow:hidden;background:var(--card);transition:box-shadow .15s,transform .15s}
    .rev-doc:hover{box-shadow:0 8px 18px rgba(9,30,27,.12);transform:translateY(-2px)}
    .rev-doc__img{width:100%;height:100px;object-fit:cover;display:block;background:var(--card-2);cursor:pointer}
    .rev-doc__img.no-img{display:flex;align-items:center;justify-content:center;color:var(--tx3);font-size:1.5rem;cursor:default}
    .rev-doc__label{padding:.35rem .5rem;font-size:.66rem;font-weight:700;color:var(--tx3);background:var(--card-2);border-top:1px solid var(--bdr);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    textarea{width:100%;padding:.75rem 1rem;border:1.5px solid var(--bdr);border-radius:var(--radius);font-family:inherit;font-size:.875rem;resize:vertical;min-height:90px;transition:border-color .2s}
    textarea:focus{outline:none;border-color:var(--pr)}

    /* ── Toast ────────────────────────────────────────────── */
    .toast{position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%) translateY(60px);background:#10201E;color:#fff;padding:.65rem 1.25rem;border-radius:99px;font-size:.85rem;font-weight:700;z-index:9999;transition:transform .3s;white-space:nowrap}
    .toast.show{transform:translateX(-50%) translateY(0)}

    /* ── Responsive ───────────────────────────────────────── */
    @media(max-width:900px){
      .sidebar{transform:translateX(100%)}
      .sidebar.open{transform:translateX(0)}
      .main{margin-right:0}
      .topbar__burger{display:flex;align-items:center;justify-content:center}
      .sidebar-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:99;display:none}
      .sidebar-overlay.show{display:block}
      .kpi-grid{grid-template-columns:repeat(2,1fr)}
      .dash-grid{grid-template-columns:1fr}
    }
    @media(max-width:480px){
      .kpi-grid{grid-template-columns:1fr 1fr}
      .content{padding:1rem}
      .modal-bg{padding:.5rem}
    }
  </style>
</head>
<body>

<div class="sidebar-overlay" id="overlay"></div>

<!-- ── Sidebar ──────────────────────────────────────────────── -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar__logo">
    <div class="sidebar__logo-name">وصّلها</div>
    <div class="sidebar__logo-sub">لوحة التحكم الإدارية</div>
  </div>
  <div class="sidebar__admin">
    <div class="sidebar__avatar" id="admin-avatar">م</div>
    <div>
