<script is:inline>
/* ── Constants ─────────────────────────────────────────────── */
const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
const SB_H = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' };

const MONTHS_AR = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
const STATUS_AR = {
  pending:'قيد الانتظار', preparing:'قيد التحضير', on_the_way:'في الطريق',
  delivered:'تم التسليم', rejected:'مرفوض', approved:'معتمد',
  active:'نشط', banned:'محظور', cancelled:'ملغي',
  completed:'مكتمل', accepted:'مقبول', in_progress:'جارية',
};
const STATUS_CLS = {
  pending:'badge--orange', preparing:'badge--orange', on_the_way:'badge--blue',
  delivered:'badge--green', rejected:'badge--red', approved:'badge--green',
  active:'badge--green', banned:'badge--red', cancelled:'badge--red',
  completed:'badge--green', accepted:'badge--blue', in_progress:'badge--blue',
};

/* ── Auth guard ─────────────────────────────────────────────── */
let ADMIN;
try {
  ADMIN = JSON.parse(localStorage.getItem('wslha_admin') || 'null');
} catch { ADMIN = null; }
if (!ADMIN || ADMIN.role !== 'admin') { window.location.href = '/admin-login'; }
else {
  const n = ADMIN.name || ADMIN.phone || '';
  document.getElementById('admin-name').textContent = n;
  document.getElementById('admin-avatar').textContent = n[0] || 'م';
  document.getElementById('topbar-date').textContent = new Date().toLocaleDateString('ar-EG', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
}

/* ── Helpers ────────────────────────────────────────────────── */
function fmt(n) { return Number(n||0).toLocaleString('ar-EG'); }
function fmtDate(iso) {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleDateString('ar-EG', { year:'numeric', month:'short', day:'numeric' });
}
function fmtTime(iso) {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleDateString('ar-EG', { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' });
}
function badge(status) {
  const s = (status||'').toLowerCase();
  return `<span class="badge ${STATUS_CLS[s]||'badge--gray'}">${STATUS_AR[s]||status||'—'}</span>`;
}
function roleBadge(role) {
  const map = { customer:'badge--blue', driver:'badge--green', admin:'badge--purple' };
  const ar  = { customer:'عميل', driver:'سائق', admin:'مشرف' };
  return `<span class="badge ${map[role]||'badge--gray'}">${ar[role]||role||'—'}</span>`;
}
function showToast(msg, color='#1E293B') {
  const t = document.getElementById('toast');
  t.textContent = msg; t.style.background = color;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

/* ── API helpers ────────────────────────────────────────────── */
async function sbGet(path) {
  const ctrl = new AbortController();
  const tid  = setTimeout(() => ctrl.abort(), 8000);
  try {
    const r = await fetch(`${SB_URL}/rest/v1/${path}`, { headers: SB_H, signal: ctrl.signal });
    clearTimeout(tid);
    return r.ok ? await r.json() : null;
  } catch { return null; }
}
async function sbPatch(path, body) {
  const r = await fetch(`${SB_URL}/rest/v1/${path}`, {
    method:'PATCH', headers:{...SB_H,Prefer:'return=minimal'}, body:JSON.stringify(body)
  });
  return r.ok;
}
async function sbPost(path, body) {
  const r = await fetch(`${SB_URL}/rest/v1/${path}`, {
    method:'POST', headers:{...SB_H,Prefer:'return=minimal'}, body:JSON.stringify(body)
  });
  return r.ok;
}
async function sbDelete(path) {
  const r = await fetch(`${SB_URL}/rest/v1/${path}`, { method:'DELETE', headers:SB_H });
  return r.ok;
}

/* ── Navigation ─────────────────────────────────────────────── */
const sectionTitles = {
  dash:'لوحة التحكم', users:'إدارة المستخدمين', drivers:'إدارة السائقين',
  merchants:'إدارة التجار', orders:'إدارة الطلبات', rides:'إدارة الرحلات',
  stores:'إدارة المتاجر', finance:'التقارير المالية', settings:'الإعدادات'
};
let currentSection = 'dash';
const loaders = { dash:loadDash, users:loadUsers, drivers:loadDriverApps,
  merchants:loadMerchantApps, orders:loadOrders, rides:loadRides, stores:loadStores,
  messages:loadMessages, finance:loadFinance };

document.querySelectorAll('.nav-item').forEach(btn => {
  btn.addEventListener('click', () => {
    const s = btn.dataset.section;
    document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.section').forEach(el => el.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(`sec-${s}`).classList.add('active');
    document.getElementById('topbar-title').textContent = sectionTitles[s] || '';
    currentSection = s;
    closeSidebar();
    if (loaders[s]) loaders[s]();
  });
});

/* ── Sidebar mobile ─────────────────────────────────────────── */
function closeSidebar() {
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('overlay').classList.remove('show');
}
document.getElementById('burger').addEventListener('click', () => {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('overlay').classList.toggle('show');
});
document.getElementById('overlay').addEventListener('click', closeSidebar);

/* ── Logout ──────────────────────────────────────────────────── */
document.getElementById('logout-btn').addEventListener('click', () => {
  localStorage.removeItem('wslha_admin');
  window.location.href = '/admin-login';
});

/* ═══════════════════ DASHBOARD ════════════════════════════ */
async function loadDash() {
  const [users, orders, rides, stores, dApps, mApps] = await Promise.all([
    sbGet('accounts?select=phone,role,status,created_at'),
    sbGet('orders?select=id,code,customer_name,customer_phone,store_name,total,status,created_at&order=created_at.desc&limit=200'),
    sbGet('rides?select=id,status,base_fare,created_at'),
    sbGet('stores?select=id,is_active'),
    sbGet('driver_applications?select=id,phone,status&status=eq.pending'),
    sbGet('merchant_applications?select=id,phone,status,business_name&status=eq.pending'),
  ]);
  const today = new Date().toISOString().slice(0,10);
  const todayOrd = (orders||[]).filter(o => (o.created_at||'').startsWith(today));
  const revenue  = todayOrd.filter(o => o.status==='delivered').reduce((s,o)=>s+(Number(o.total)||0),0);
  const pendingTotal = (dApps||[]).length + (mApps||[]).length;

  document.getElementById('kpi-users').textContent        = fmt((users||[]).length);
  document.getElementById('kpi-drivers').textContent      = fmt((users||[]).filter(u=>u.role==='driver'&&u.status==='approved').length);
  document.getElementById('kpi-today-orders').textContent = fmt(todayOrd.length);
  document.getElementById('kpi-revenue').textContent      = fmt(revenue);
  document.getElementById('kpi-stores').textContent       = fmt((stores||[]).filter(s=>s.is_active).length);
  document.getElementById('kpi-pending').textContent      = fmt(pendingTotal);

  // Update sidebar badges
  const dn = (dApps||[]).length, mn = (mApps||[]).length;
  const db = document.getElementById('badge-drivers'), mb = document.getElementById('badge-merchants');
  db.textContent = dn; db.classList.toggle('hidden', dn === 0);
  mb.textContent = mn; mb.classList.toggle('hidden', mn === 0);

  // Recent orders table
  const recentRows = (orders||[]).slice(0,10).map(o => `
    <tr>
      <td style="direction:ltr;font-size:.78rem">${o.code||o.id?.slice(0,8)||'—'}</td>
      <td>${o.customer_name||'—'}</td>
      <td>${o.store_name||'—'}</td>
      <td style="font-weight:700;color:var(--pr)">${fmt(o.total)} ج.م</td>
      <td>${badge(o.status)}</td>
      <td style="font-size:.78rem">${fmtTime(o.created_at)}</td>
    </tr>`).join('');
  document.getElementById('dash-recent-orders').innerHTML = recentRows || '<tr><td colspan="6" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد طلبات</td></tr>';

  // Pending list
  const pendingHtml = [
    ...(dApps||[]).map(d => `
      <div style="display:flex;align-items:center;gap:.75rem;padding:.6rem 1rem;background:#F8FAFC;border-radius:8px;border:1px solid #E2E8F0">
        <span style="font-size:1.3rem">🚗</span>
        <div style="flex:1"><div style="font-size:.82rem;font-weight:700">${d.phone}</div><div style="font-size:.72rem;color:#64748B">طلب سائق</div></div>
        <button class="btn btn--primary btn--sm" onclick="openDriverModal('${d.phone}')">مراجعة</button>
      </div>`),
    ...(mApps||[]).map(m => `
      <div style="display:flex;align-items:center;gap:.75rem;padding:.6rem 1rem;background:#F8FAFC;border-radius:8px;border:1px solid #E2E8F0">
        <span style="font-size:1.3rem">🏪</span>
        <div style="flex:1"><div style="font-size:.82rem;font-weight:700">${m.business_name||m.phone}</div><div style="font-size:.72rem;color:#64748B">طلب تاجر</div></div>
        <button class="btn btn--primary btn--sm" onclick="openMerchantModal('${m.phone}')">مراجعة</button>
      </div>`),
  ].join('') || '<p style="color:#94A3B8;font-size:.875rem">لا توجد طلبات معلقة</p>';
  document.getElementById('dash-pending-list').innerHTML = pendingHtml;
}

/* ═══════════════════ USERS ═════════════════════════════════ */
let allUsers = [];
async function loadUsers() {
  const data = await sbGet('accounts?select=*&order=created_at.desc&limit=500');
  allUsers = data || [];
  renderUsers();
}
function renderUsers() {
  const search = document.getElementById('users-search').value.trim().toLowerCase();
  const role   = document.getElementById('users-role-filter').value;
  const status = document.getElementById('users-status-filter').value;
  let rows = allUsers;
  if (search) rows = rows.filter(u => (u.name||'').toLowerCase().includes(search)||(u.phone||'').includes(search));
  if (role)   rows = rows.filter(u => u.role === role);
  if (status) rows = rows.filter(u => (u.status||'active') === status);
  const html = rows.map((u,i) => `
    <tr>
      <td style="color:#94A3B8;font-size:.78rem">${i+1}</td>
      <td style="font-weight:700">${u.name||'—'}</td>
      <td style="direction:ltr;font-size:.85rem">${u.phone||'—'}</td>
      <td>${roleBadge(u.role)}</td>
      <td>${badge(u.status||'active')}</td>
      <td style="font-size:.82rem">${u.city||'—'}</td>
      <td style="font-size:.78rem">${fmtDate(u.created_at||u.createdAt)}</td>
      <td>
        <div class="btn-row">
          ${u.status==='banned'
            ? `<button class="btn btn--green btn--sm" onclick="changeUserStatus('${u.phone}','active')">تفعيل</button>`
            : `<button class="btn btn--orange btn--sm" onclick="changeUserStatus('${u.phone}','banned')">حظر</button>`}
          ${u.role !== 'admin' ? `<button class="btn btn--ghost btn--sm" onclick="makeAdmin('${u.phone}')">مشرف</button>` : ''}
          <button class="btn btn--red btn--sm" onclick="deleteUser('${u.phone}')">حذف</button>
        </div>
      </td>
    </tr>`).join('') || '<tr><td colspan="8" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد نتائج</td></tr>';
  document.getElementById('users-tbody').innerHTML = html;
}
document.getElementById('users-search').addEventListener('input', renderUsers);
document.getElementById('users-role-filter').addEventListener('change', renderUsers);
document.getElementById('users-status-filter').addEventListener('change', renderUsers);

async function changeUserStatus(phone, status) {
  if (!confirm(`هل أنت متأكد من تغيير الحالة إلى "${STATUS_AR[status]||status}"؟`)) return;
  const ok = await sbPatch(`accounts?phone=eq.${encodeURIComponent(phone)}`, { status });
  if (ok) { showToast('✅ تم تحديث الحالة', '#16A34A'); loadUsers(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}
async function makeAdmin(phone) {
  if (!confirm('منح صلاحيات المشرف لهذا المستخدم؟')) return;
  const ok = await sbPatch(`accounts?phone=eq.${encodeURIComponent(phone)}`, { role:'admin', status:'active' });
  if (ok) { showToast('✅ تم التحديث', '#16A34A'); loadUsers(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}
async function deleteUser(phone) {
  if (!confirm(`⚠️ حذف حساب ${phone}؟ هذا الإجراء لا يمكن التراجع عنه.`)) return;
  const ok = await sbDelete(`accounts?phone=eq.${encodeURIComponent(phone)}`);
  if (ok) { showToast('✅ تم الحذف', '#16A34A'); loadUsers(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}

