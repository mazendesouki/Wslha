async function courierAccept(id) {
  // 'preparing' is what trg_dispatch_new_order actually watches for — this
  // is the moment the shipment goes out to the nearest available driver,
  // same as a merchant accepting a store order.
  const ok = await sbPatch(`orders?id=eq.${encodeURIComponent(id)}`, { status: 'preparing', accepted_at: new Date().toISOString() });
  if (ok) { showToast('✅ تم قبول الشحنة — جارٍ البحث عن سائق', '#16A34A'); loadCourierOrders(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}
async function courierReject(id) {
  if (!confirm('رفض هذه الشحنة؟')) return;
  const ok = await sbPatch(`orders?id=eq.${encodeURIComponent(id)}`, { status: 'rejected' });
  if (ok) { showToast('تم رفض الشحنة', '#DC2626'); loadCourierOrders(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}

