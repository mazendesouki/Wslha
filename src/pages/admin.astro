<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>لوحة التحكم — وصّلها</title>
  <link rel="icon" href="/icon.svg" type="image/svg+xml"/>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap');
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --sb:#0F172A;--sb2:#1E293B;--sb3:#334155;
      --tx:#F1F5F9;--tx2:#94A3B8;--tx3:#64748B;
      --pr:#3B6EF8;--pr2:#2952D9;--pr-l:rgba(59,110,248,.12);
      --green:#16A34A;--green-l:#DCFCE7;
      --red:#DC2626;--red-l:#FEE2E2;
      --orange:#D97706;--orange-l:#FEF3C7;
      --bg:#F1F5F9;--card:#fff;--bdr:#E2E8F0;
      --radius:8px;--radius-lg:12px;
      --sh:0 1px 3px rgba(0,0,0,.1);--sh-md:0 4px 12px rgba(0,0,0,.1);
    }
    body{font-family:'Cairo',system-ui,sans-serif;background:var(--bg);color:#1E293B;direction:rtl}
    a{text-decoration:none}
    button{font-family:inherit;cursor:pointer}
    .hidden{display:none!important}

    /* ── Layout ───────────────────────────────────────────── */
    .admin-wrap{display:flex;min-height:100vh}

    /* Sidebar */
    .sidebar{width:260px;background:var(--sb);flex-shrink:0;display:flex;flex-direction:column;position:fixed;top:0;right:0;bottom:0;z-index:100;transition:transform .3s}
    .sidebar__logo{padding:1.5rem;border-bottom:1px solid var(--sb3)}
    .sidebar__logo-name{font-size:1.5rem;font-weight:900;background:linear-gradient(135deg,#3B6EF8,#818CF8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .sidebar__logo-sub{font-size:.72rem;color:var(--tx3);margin-top:2px}
    .sidebar__admin{display:flex;align-items:center;gap:.75rem;padding:1rem 1.5rem;border-bottom:1px solid var(--sb3)}
    .sidebar__avatar{width:36px;height:36px;border-radius:50%;background:var(--pr-l);border:2px solid var(--pr);display:flex;align-items:center;justify-content:center;font-size:.9rem;font-weight:900;color:var(--pr);flex-shrink:0}
    .sidebar__admin-name{font-size:.85rem;font-weight:700;color:var(--tx);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .sidebar__admin-role{font-size:.7rem;color:var(--tx3)}
    nav{flex:1;overflow-y:auto;padding:.75rem 0}
    .nav-item{display:flex;align-items:center;gap:.75rem;padding:.7rem 1.5rem;font-size:.875rem;font-weight:600;color:var(--tx2);transition:all .2s;cursor:pointer;border-right:3px solid transparent;width:100%;background:none;border-left:none;border-top:none;border-bottom:none;text-align:right}
    .nav-item:hover{background:rgba(255,255,255,.05);color:var(--tx)}
    .nav-item.active{background:var(--pr-l);color:var(--pr);border-right-color:var(--pr)}
    .nav-item__icon{font-size:1.1rem;flex-shrink:0}
    .nav-item__badge{margin-right:auto;background:var(--red);color:#fff;font-size:.65rem;font-weight:700;padding:1px 7px;border-radius:99px;min-width:20px;text-align:center}
    .nav-divider{height:1px;background:var(--sb3);margin:.5rem 1.5rem}
    .sidebar__logout{padding:.75rem 1.5rem;border-top:1px solid var(--sb3)}
    .btn-logout{display:flex;align-items:center;gap:.5rem;color:var(--red);font-size:.85rem;font-weight:700;background:rgba(220,38,38,.1);border:1px solid rgba(220,38,38,.2);border-radius:var(--radius);padding:.6rem 1rem;width:100%;justify-content:center;transition:all .2s}
    .btn-logout:hover{background:var(--red);color:#fff}

    /* Main content */
    .main{margin-right:260px;flex:1;display:flex;flex-direction:column;min-height:100vh}
    .topbar{background:var(--card);border-bottom:1px solid var(--bdr);padding:.875rem 1.5rem;display:flex;align-items:center;gap:1rem;position:sticky;top:0;z-index:50}
    .topbar__burger{display:none;background:none;border:1.5px solid var(--bdr);border-radius:var(--radius);padding:.4rem .6rem;font-size:1.1rem}
    .topbar__title{font-size:1.1rem;font-weight:900;color:#1E293B;flex:1}
    .topbar__date{font-size:.78rem;color:var(--tx3)}
    .content{padding:1.5rem;flex:1}
    .section{display:none}
    .section.active{display:block}

    /* ── Cards ────────────────────────────────────────────── */
    .card{background:var(--card);border:1px solid var(--bdr);border-radius:var(--radius-lg);box-shadow:var(--sh)}
    .card__head{padding:.875rem 1.25rem;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between}
    .card__title{font-size:.95rem;font-weight:900;color:#1E293B}
    .card__body{padding:1.25rem}

    /* KPI grid */
    .kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem}
    .kpi{background:var(--card);border:1px solid var(--bdr);border-radius:var(--radius-lg);padding:1.25rem;box-shadow:var(--sh);display:flex;flex-direction:column;gap:.5rem}
    .kpi__icon{font-size:1.6rem}
    .kpi__val{font-size:1.8rem;font-weight:900;color:#1E293B;line-height:1}
    .kpi__label{font-size:.78rem;color:var(--tx3);font-weight:600}
    .kpi--blue .kpi__val{color:var(--pr)}
    .kpi--green .kpi__val{color:var(--green)}
    .kpi--orange .kpi__val{color:var(--orange)}
    .kpi--red .kpi__val{color:var(--red)}

    /* ── Tables ───────────────────────────────────────────── */
    .tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
    table{width:100%;border-collapse:collapse;font-size:.85rem}
    th{padding:.7rem 1rem;text-align:right;font-size:.72rem;font-weight:700;color:var(--tx3);background:#F8FAFC;border-bottom:1px solid var(--bdr);white-space:nowrap;text-transform:uppercase;letter-spacing:.03em}
    td{padding:.8rem 1rem;border-bottom:1px solid var(--bdr);color:#334155;vertical-align:middle}
    tr:last-child td{border-bottom:none}
    tr:hover td{background:#F8FAFC}

    /* ── Badges ───────────────────────────────────────────── */
    .badge{padding:2px 10px;border-radius:99px;font-size:.72rem;font-weight:700;white-space:nowrap}
    .badge--green{background:var(--green-l);color:var(--green)}
    .badge--red{background:var(--red-l);color:var(--red)}
    .badge--orange{background:var(--orange-l);color:var(--orange)}
    .badge--blue{background:#DBEAFE;color:#2563EB}
    .badge--gray{background:#F1F5F9;color:#64748B}
    .badge--purple{background:#EDE9FE;color:#7C3AED}

    /* ── Buttons ──────────────────────────────────────────── */
    .btn{padding:.5rem 1rem;border-radius:var(--radius);font-family:inherit;font-size:.82rem;font-weight:700;border:none;cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:.35rem}
    .btn--primary{background:var(--pr);color:#fff}.btn--primary:hover{background:var(--pr2)}
    .btn--green{background:var(--green);color:#fff}.btn--green:hover{background:#15803D}
    .btn--red{background:var(--red-l);color:var(--red);border:1px solid #FECACA}.btn--red:hover{background:var(--red);color:#fff}
    .btn--orange{background:var(--orange-l);color:var(--orange);border:1px solid #FDE68A}.btn--orange:hover{background:var(--orange);color:#fff}
    .btn--ghost{background:transparent;color:var(--tx3);border:1.5px solid var(--bdr)}.btn--ghost:hover{border-color:var(--pr);color:var(--pr)}
    .btn--sm{padding:.3rem .7rem;font-size:.75rem}
    .btn-row{display:flex;gap:.4rem;flex-wrap:wrap}

    /* ── Filters / Search ─────────────────────────────────── */
    .filters-bar{display:flex;gap:.75rem;margin-bottom:1.25rem;flex-wrap:wrap;align-items:center}
    .search-input{padding:.5rem .9rem;border:1.5px solid var(--bdr);border-radius:var(--radius);font-family:inherit;font-size:.875rem;background:var(--card);color:#334155;flex:1;min-width:180px;transition:border-color .2s}
    .search-input:focus{outline:none;border-color:var(--pr)}
    .filter-select{padding:.5rem .75rem;border:1.5px solid var(--bdr);border-radius:var(--radius);font-family:inherit;font-size:.82rem;background:var(--card);color:#334155;cursor:pointer}
    .filter-select:focus{outline:none;border-color:var(--pr)}

    /* ── Tabs ─────────────────────────────────────────────── */
    .tab-bar{display:flex;gap:0;background:var(--card);border:1px solid var(--bdr);border-radius:var(--radius-lg);padding:3px;margin-bottom:1.25rem;overflow-x:auto;scrollbar-width:none}
    .tab-bar::-webkit-scrollbar{display:none}
    .tab-btn{padding:.45rem 1rem;border-radius:calc(var(--radius-lg) - 3px);border:none;background:transparent;font-family:inherit;font-size:.82rem;font-weight:700;color:var(--tx3);cursor:pointer;white-space:nowrap;transition:all .15s}
    .tab-btn.active{background:var(--pr);color:#fff}
    .tab-btn:not(.active):hover{background:#F1F5F9;color:#334155}

    /* ── Stats row ────────────────────────────────────────── */
    .dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem}

    /* ── Modal ────────────────────────────────────────────── */
    .modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;display:flex;align-items:center;justify-content:center;padding:1rem}
    .modal{background:var(--card);border-radius:var(--radius-lg);max-width:820px;width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 25px 50px rgba(0,0,0,.25)}
    .modal__head{padding:1.25rem 1.5rem;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--card);z-index:2}
    .modal__title{font-size:1rem;font-weight:900;color:#1E293B}
    .modal__close{background:none;border:none;font-size:1.3rem;color:var(--tx3);cursor:pointer;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center}
    .modal__close:hover{background:#F1F5F9}
    .modal__body{padding:1.5rem}
    .modal__foot{padding:1rem 1.5rem;border-top:1px solid var(--bdr);display:flex;gap:.75rem;justify-content:flex-end;background:var(--card);position:sticky;bottom:0}

    /* Doc viewer */
    .doc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;margin-bottom:1.5rem}
    .doc-card{border:1px solid var(--bdr);border-radius:var(--radius);overflow:hidden}
    .doc-card__img{width:100%;height:140px;object-fit:cover;display:block;background:#F1F5F9;cursor:pointer}
    .doc-card__img.no-img{display:flex;align-items:center;justify-content:center;color:var(--tx3);font-size:2rem}
    .doc-card__label{padding:.4rem .6rem;font-size:.72rem;font-weight:700;color:var(--tx3);background:#F8FAFC;border-top:1px solid var(--bdr)}
    .info-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:.75rem;margin-bottom:1.5rem}
    .info-field{background:#F8FAFC;border:1px solid var(--bdr);border-radius:var(--radius);padding:.6rem .8rem}
    .info-field__label{font-size:.68rem;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.03em;margin-bottom:.15rem}
    .info-field__val{font-size:.875rem;font-weight:600;color:#334155}
    .reject-area{display:none;margin-top:1rem}
    textarea{width:100%;padding:.75rem 1rem;border:1.5px solid var(--bdr);border-radius:var(--radius);font-family:inherit;font-size:.875rem;resize:vertical;min-height:90px;transition:border-color .2s}
    textarea:focus{outline:none;border-color:var(--pr)}

    /* ── Toast ────────────────────────────────────────────── */
    .toast{position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%) translateY(60px);background:#1E293B;color:#fff;padding:.65rem 1.25rem;border-radius:99px;font-size:.85rem;font-weight:700;z-index:9999;transition:transform .3s;white-space:nowrap}
    .toast.show{transform:translateX(-50%) translateY(0)}

    /* ── Responsive ───────────────────────────────────────── */
    @media(max-width:900px){
      .sidebar{transform:translateX(100%)}
      .sidebar.open{transform:translateX(0)}
      .main{margin-right:0}
      .topbar__burger{display:flex;align-items:center;justify-content:center}
      .sidebar-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:99;display:none}
      .sidebar-overlay.show{display:block}
      .kpi-grid{grid-template-columns:repeat(2,1fr)}
      .dash-grid{grid-template-columns:1fr}
    }
    @media(max-width:480px){
      .kpi-grid{grid-template-columns:1fr 1fr}
      .content{padding:1rem}
      .modal-bg{padding:.5rem}
    }
  </style>
</head>
<body>

<div class="sidebar-overlay" id="overlay"></div>

<!-- ── Sidebar ──────────────────────────────────────────────── -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar__logo">
    <div class="sidebar__logo-name">وصّلها</div>
    <div class="sidebar__logo-sub">لوحة التحكم الإدارية</div>
  </div>
  <div class="sidebar__admin">
    <div class="sidebar__avatar" id="admin-avatar">م</div>
    <div>
      <div class="sidebar__admin-name" id="admin-name">المشرف</div>
      <div class="sidebar__admin-role">مشرف النظام</div>
    </div>
  </div>
  <nav>
    <button class="nav-item active" data-section="dash">
      <span class="nav-item__icon">📊</span> لوحة التحكم
    </button>
    <button class="nav-item" data-section="users">
      <span class="nav-item__icon">👥</span> المستخدمون
    </button>
    <div class="nav-divider"></div>
    <button class="nav-item" data-section="drivers">
      <span class="nav-item__icon">🚗</span> السائقون
      <span class="nav-item__badge hidden" id="badge-drivers">0</span>
    </button>
    <button class="nav-item" data-section="merchants">
      <span class="nav-item__icon">🏪</span> التجار
      <span class="nav-item__badge hidden" id="badge-merchants">0</span>
    </button>
    <div class="nav-divider"></div>
    <button class="nav-item" data-section="orders">
      <span class="nav-item__icon">📦</span> الطلبات
    </button>
    <button class="nav-item" data-section="rides">
      <span class="nav-item__icon">🚖</span> الرحلات
    </button>
    <button class="nav-item" data-section="stores">
      <span class="nav-item__icon">🏬</span> المتاجر
    </button>
    <button class="nav-item" data-section="messages">
      <span class="nav-item__icon">✉️</span> الرسائل
      <span class="nav-item__badge hidden" id="badge-messages">0</span>
    </button>
    <div class="nav-divider"></div>
    <button class="nav-item" data-section="finance">
      <span class="nav-item__icon">💰</span> التقارير المالية
    </button>
    <button class="nav-item" data-section="settings">
      <span class="nav-item__icon">⚙️</span> الإعدادات
    </button>
  </nav>
  <div class="sidebar__logout">
    <button class="btn-logout" id="logout-btn">🚪 تسجيل الخروج</button>
  </div>
</aside>

<!-- ── Main ──────────────────────────────────────────────────── -->
<div class="main">
  <div class="topbar">
    <button class="topbar__burger" id="burger">☰</button>
    <h1 class="topbar__title" id="topbar-title">لوحة التحكم</h1>
    <span class="topbar__date" id="topbar-date"></span>
  </div>

  <div class="content">

    <!-- ═══════════════════ DASHBOARD ══════════════════════ -->
    <div class="section active" id="sec-dash">
      <div class="kpi-grid" id="kpi-grid">
        <div class="kpi kpi--blue"><div class="kpi__icon">👥</div><div class="kpi__val" id="kpi-users">—</div><div class="kpi__label">إجمالي المستخدمين</div></div>
        <div class="kpi kpi--green"><div class="kpi__icon">🚗</div><div class="kpi__val" id="kpi-drivers">—</div><div class="kpi__label">السائقون المعتمدون</div></div>
        <div class="kpi kpi--orange"><div class="kpi__icon">📦</div><div class="kpi__val" id="kpi-today-orders">—</div><div class="kpi__label">طلبات اليوم</div></div>
        <div class="kpi kpi--green"><div class="kpi__icon">💰</div><div class="kpi__val" id="kpi-revenue">—</div><div class="kpi__label">إيرادات اليوم (ج.م)</div></div>
        <div class="kpi kpi--blue"><div class="kpi__icon">🏬</div><div class="kpi__val" id="kpi-stores">—</div><div class="kpi__label">المتاجر النشطة</div></div>
        <div class="kpi kpi--red"><div class="kpi__icon">⏳</div><div class="kpi__val" id="kpi-pending">—</div><div class="kpi__label">طلبات الاعتماد</div></div>
      </div>
      <div class="dash-grid">
        <div class="card">
          <div class="card__head"><span class="card__title">📦 آخر الطلبات</span></div>
          <div class="tbl-wrap">
            <table><thead><tr><th>رقم الطلب</th><th>العميل</th><th>المتجر</th><th>الإجمالي</th><th>الحالة</th><th>التاريخ</th></tr></thead>
            <tbody id="dash-recent-orders"><tr><td colspan="6" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr></tbody></table>
          </div>
        </div>
        <div class="card">
          <div class="card__head"><span class="card__title">⏳ طلبات الاعتماد المعلقة</span></div>
          <div class="card__body" id="dash-pending-list" style="display:flex;flex-direction:column;gap:.75rem">
            <p style="color:#94A3B8;font-size:.875rem">جاري التحميل…</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════ USERS ═══════════════════════════ -->
    <div class="section" id="sec-users">
      <div class="filters-bar">
        <input class="search-input" id="users-search" type="search" placeholder="🔍 بحث بالاسم أو الجوال…"/>
        <select class="filter-select" id="users-role-filter">
          <option value="">جميع الأدوار</option>
          <option value="customer">عملاء</option>
          <option value="driver">سائقون</option>
          <option value="admin">مشرفون</option>
        </select>
        <select class="filter-select" id="users-status-filter">
          <option value="">جميع الحالات</option>
          <option value="active">نشط</option>
          <option value="pending">معلق</option>
          <option value="approved">معتمد</option>
          <option value="rejected">مرفوض</option>
          <option value="banned">محظور</option>
        </select>
        <button class="btn btn--primary" onclick="loadUsers()">🔄 تحديث</button>
      </div>
      <div class="card">
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>#</th><th>الاسم</th><th>الجوال</th><th>الدور</th><th>الحالة</th><th>المدينة</th><th>تاريخ الانضمام</th><th>إجراءات</th></tr></thead>
            <tbody id="users-tbody"><tr><td colspan="8" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ═══════════════════ DRIVERS ═════════════════════════ -->
    <div class="section" id="sec-drivers">
      <div class="tab-bar" id="drivers-tabs">
        <button class="tab-btn active" data-dtab="pending">⏳ معلق <span id="dt-pending-cnt"></span></button>
        <button class="tab-btn" data-dtab="approved">✅ معتمد</button>
        <button class="tab-btn" data-dtab="rejected">❌ مرفوض</button>
        <button class="tab-btn" data-dtab="all">الكل</button>
      </div>
      <div class="card">
        <div class="card__head"><span class="card__title" id="drivers-tab-title">طلبات الاعتماد المعلقة</span>
          <button class="btn btn--ghost btn--sm" onclick="loadDriverApps()">🔄</button>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>الاسم</th><th>الجوال</th><th>السيارة</th><th>تاريخ التقديم</th><th>الحالة</th><th>مراجعة</th></tr></thead>
            <tbody id="drivers-tbody"><tr><td colspan="6" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ═══════════════════ MERCHANTS ═══════════════════════ -->
    <div class="section" id="sec-merchants">
      <div class="tab-bar" id="merchants-tabs">
        <button class="tab-btn active" data-mtab="pending">⏳ معلق <span id="mt-pending-cnt"></span></button>
        <button class="tab-btn" data-mtab="approved">✅ معتمد</button>
        <button class="tab-btn" data-mtab="rejected">❌ مرفوض</button>
        <button class="tab-btn" data-mtab="all">الكل</button>
      </div>
      <div class="card">
        <div class="card__head"><span class="card__title" id="merchants-tab-title">طلبات الاعتماد المعلقة</span>
          <button class="btn btn--ghost btn--sm" onclick="loadMerchantApps()">🔄</button>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>الاسم التجاري</th><th>الجوال</th><th>نوع النشاط</th><th>تاريخ التقديم</th><th>الحالة</th><th>مراجعة</th></tr></thead>
            <tbody id="merchants-tbody"><tr><td colspan="6" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ═══════════════════ ORDERS ══════════════════════════ -->
    <div class="section" id="sec-orders">
      <div class="filters-bar">
