/* ═══════════════════ DASHBOARD CHARTS (hand-rolled SVG) ═════ */
function datesLast14() {
  const days = [];
  for (let i = 13; i >= 0; i--) {
    const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - i);
    days.push(d);
  }
  return days;
}
function renderTrend(elId, current, previous) {
  const el = document.getElementById(elId);
  if (!el) return;
  if (!current && !previous) { el.classList.add('hidden'); return; }
  el.classList.remove('hidden');
  if (!previous) { el.className = 'kpi__trend up'; el.textContent = '▲ جديد'; return; }
  const pct = Math.round(((current - previous) / previous) * 100);
  if (pct > 0)      { el.className = 'kpi__trend up';   el.textContent = `▲ ${pct}%`; }
  else if (pct < 0) { el.className = 'kpi__trend down'; el.textContent = `▼ ${Math.abs(pct)}%`; }
  else              { el.className = 'kpi__trend flat'; el.textContent = '— 0%'; }
}
async function loadDashCharts() {
  const since = new Date(); since.setHours(0, 0, 0, 0); since.setDate(since.getDate() - 13);
  const [ordersR, ridesR, appsR] = await Promise.all([
    sbGet(`orders?select=total,status,created_at&created_at=gte.${since.toISOString()}`),
    sbGet(`rides?select=fare,base_fare,status,created_at&created_at=gte.${since.toISOString()}`),
    sbGet(`driver_applications?select=created_at&status=eq.approved&created_at=gte.${since.toISOString()}`),
  ]);
  const days  = datesLast14();
  const keys  = days.map(d => d.toISOString().slice(0, 10));
  const revenueByDay  = keys.map(() => 0);
  const ridesByDay    = keys.map(() => 0);
  const ordersByDay   = keys.map(() => 0);
  const driversByDay  = keys.map(() => 0);

  (ordersR || []).forEach(o => {
    const idx = keys.indexOf((o.created_at || '').slice(0, 10));
    if (idx === -1) return;
    ordersByDay[idx]++;
    if (o.status === 'delivered') revenueByDay[idx] += Number(o.total) || 0;
  });
  (ridesR || []).forEach(r => {
    const idx = keys.indexOf((r.created_at || '').slice(0, 10));
    if (idx === -1) return;
    ridesByDay[idx]++;
    if (r.status === 'completed') revenueByDay[idx] += Number(r.fare ?? r.base_fare) || 0;
  });
  (appsR || []).forEach(a => {
    const idx = keys.indexOf((a.created_at || '').slice(0, 10));
    if (idx !== -1) driversByDay[idx]++;
  });

  const dayLabels = days.map(d => d.toLocaleDateString('ar-EG', { day: 'numeric', month: 'short' }));

  renderTrend('kpi-revenue-trend', revenueByDay[13], revenueByDay[12]);
  renderTrend('kpi-orders-trend',  ordersByDay[13],  ordersByDay[12]);

  renderLineChart('revenue-chart', 'revenue-tooltip', revenueByDay, dayLabels, { color: '#0E4B49', suffix: ' ج.م' });
  renderGroupedBarChart('activity-chart', 'activity-tooltip', ridesByDay, ordersByDay, dayLabels,
    { colorA: '#2563EB', colorB: '#D97706', labelA: 'رحلات', labelB: 'طلبات' });
  renderBarChart('drivers-chart', 'drivers-tooltip', driversByDay, dayLabels, { color: '#16A34A', unit: 'سائق' });
}

// Area + line chart with a hover crosshair that snaps to the nearest day.
function renderLineChart(svgId, tooltipId, values, labels, opts) {
  const svg = document.getElementById(svgId);
  const tooltip = document.getElementById(tooltipId);
  if (!svg || !tooltip) return;
  const W = 640, H = 200, padL = 4, padR = 4, padT = 16, padB = 8;
  const innerW = W - padL - padR, innerH = H - padT - padB;
  const n = values.length;
  const max = Math.max(1, ...values);
  const stepX = n > 1 ? innerW / (n - 1) : 0;
  const pts = values.map((v, i) => [padL + i * stepX, padT + innerH - (v / max) * innerH]);
  const linePath = pts.map((p, i) => (i === 0 ? 'M' : 'L') + p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
  const baseY = (padT + innerH).toFixed(1);
  const areaPath = `${linePath} L${pts[n - 1][0].toFixed(1)},${baseY} L${pts[0][0].toFixed(1)},${baseY} Z`;
  const gridLines = [0, .5, 1].map(f => {
    const y = (padT + innerH * (1 - f)).toFixed(1);
    return `<line x1="${padL}" y1="${y}" x2="${(padL + innerW).toFixed(1)}" y2="${y}" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="3,3"/>`;
  }).join('');
  const gradId = svgId + '-grad';
  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  svg.innerHTML = `
    <defs><linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="${opts.color}" stop-opacity=".25"/>
      <stop offset="100%" stop-color="${opts.color}" stop-opacity="0"/>
    </linearGradient></defs>
    ${gridLines}
    <path d="${areaPath}" fill="url(#${gradId})"/>
    <path d="${linePath}" fill="none" stroke="${opts.color}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
    <g class="hover-layer" style="display:none">
      <line class="hover-line" y1="${padT}" y2="${baseY}" stroke="#94A3B8" stroke-width="1" stroke-dasharray="2,2"/>
      <circle class="hover-dot" r="4.5" fill="${opts.color}" stroke="#fff" stroke-width="2"/>
    </g>
    <rect class="hover-rect" x="${padL}" y="0" width="${innerW}" height="${H}" fill="transparent" style="cursor:crosshair"/>
  `;
  const hoverLayer = svg.querySelector('.hover-layer');
  const hoverLine  = svg.querySelector('.hover-line');
  const hoverDot   = svg.querySelector('.hover-dot');
  const rect       = svg.querySelector('.hover-rect');
  const wrap       = svg.closest('.chart-card__body');
  rect.addEventListener('mousemove', (e) => {
    const box = svg.getBoundingClientRect();
    const xSvg = ((e.clientX - box.left) / box.width) * W;
    const idx = Math.max(0, Math.min(n - 1, Math.round((xSvg - padL) / (stepX || 1))));
    const [px, py] = pts[idx];
    hoverLine.setAttribute('x1', px.toFixed(1)); hoverLine.setAttribute('x2', px.toFixed(1));
    hoverDot.setAttribute('cx', px.toFixed(1)); hoverDot.setAttribute('cy', py.toFixed(1));
    hoverLayer.style.display = '';
    tooltip.innerHTML = `<div>${fmt(Math.round(values[idx]))}${opts.suffix || ''}</div><div class="chart-tooltip__sub">${labels[idx]}</div>`;
    tooltip.classList.remove('hidden');
    const wrapBox = wrap.getBoundingClientRect();
    tooltip.style.left = ((px / W) * box.width + (box.left - wrapBox.left)) + 'px';
    tooltip.style.top  = ((py / H) * box.height + (box.top - wrapBox.top)) + 'px';
  });
  rect.addEventListener('mouseleave', () => { hoverLayer.style.display = 'none'; tooltip.classList.add('hidden'); });
}

// Two-series grouped bar chart (fixed categorical colors — never reassigned by rank).
function renderGroupedBarChart(svgId, tooltipId, valuesA, valuesB, labels, opts) {
  const svg = document.getElementById(svgId);
  const tooltip = document.getElementById(tooltipId);
  if (!svg || !tooltip) return;
  const W = 640, H = 140, padL = 4, padR = 4, padT = 10, padB = 22;
  const innerW = W - padL - padR, innerH = H - padT - padB;
  const n = valuesA.length;
  const max = Math.max(1, ...valuesA, ...valuesB);
  const groupW = innerW / n;
  const barW = Math.max(3, groupW * 0.32);
  const gap = 2;
  const baseY = (padT + innerH).toFixed(1);
  let bars = '';
  for (let i = 0; i < n; i++) {
    const gx = padL + i * groupW + groupW / 2;
    const ha = (valuesA[i] / max) * innerH, hb = (valuesB[i] / max) * innerH;
    const ya = (padT + innerH - ha).toFixed(1), yb = (padT + innerH - hb).toFixed(1);
    bars += `<rect x="${(gx - barW - gap / 2).toFixed(1)}" y="${ya}" width="${barW.toFixed(1)}" height="${Math.max(1, ha).toFixed(1)}" rx="2" fill="${opts.colorA}"/>`;
    bars += `<rect x="${(gx + gap / 2).toFixed(1)}" y="${yb}" width="${barW.toFixed(1)}" height="${Math.max(1, hb).toFixed(1)}" rx="2" fill="${opts.colorB}"/>`;
  }
  let axisLabels = '';
  labels.forEach((lb, i) => {
    if (i % 3 !== 0 && i !== n - 1) return;
    const x = (padL + i * groupW + groupW / 2).toFixed(1);
    axisLabels += `<text x="${x}" y="${H - 6}" text-anchor="middle" font-size="9" fill="#94A3B8">${lb.split(' ')[0]}</text>`;
  });
  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  svg.innerHTML = `
    <line x1="${padL}" y1="${baseY}" x2="${(padL + innerW).toFixed(1)}" y2="${baseY}" stroke="#E2E8F0" stroke-width="1"/>
    ${bars}${axisLabels}
    <rect class="hover-rect" x="${padL}" y="0" width="${innerW}" height="${H}" fill="transparent" style="cursor:pointer"/>
  `;
  const rect = svg.querySelector('.hover-rect');
  const wrap = svg.closest('.chart-card__body');
  rect.addEventListener('mousemove', (e) => {
    const box = svg.getBoundingClientRect();
    const xSvg = ((e.clientX - box.left) / box.width) * W;
    const idx = Math.max(0, Math.min(n - 1, Math.floor((xSvg - padL) / groupW)));
    tooltip.innerHTML = `<div>${opts.labelA}: ${fmt(valuesA[idx])} · ${opts.labelB}: ${fmt(valuesB[idx])}</div><div class="chart-tooltip__sub">${labels[idx]}</div>`;
    tooltip.classList.remove('hidden');
    const wrapBox = wrap.getBoundingClientRect();
    const gx = padL + idx * groupW + groupW / 2;
    tooltip.style.left = ((gx / W) * box.width + (box.left - wrapBox.left)) + 'px';
    tooltip.style.top  = ((box.top - wrapBox.top) + 10) + 'px';
  });
  rect.addEventListener('mouseleave', () => tooltip.classList.add('hidden'));
}

// Single-series bar chart (new approved drivers per day).
function renderBarChart(svgId, tooltipId, values, labels, opts) {
  const svg = document.getElementById(svgId);
  const tooltip = document.getElementById(tooltipId);
  if (!svg || !tooltip) return;
  const W = 640, H = 100, padL = 4, padR = 4, padT = 10, padB = 22;
  const innerW = W - padL - padR, innerH = H - padT - padB;
  const n = values.length;
  const max = Math.max(1, ...values);
  const groupW = innerW / n;
  const barW = Math.max(4, groupW * 0.55);
  const baseY = (padT + innerH).toFixed(1);
  let bars = '';
  for (let i = 0; i < n; i++) {
    const gx = padL + i * groupW + groupW / 2;
    const h = (values[i] / max) * innerH;
    bars += `<rect x="${(gx - barW / 2).toFixed(1)}" y="${(padT + innerH - h).toFixed(1)}" width="${barW.toFixed(1)}" height="${Math.max(1, h).toFixed(1)}" rx="2" fill="${opts.color}"/>`;
  }
  let axisLabels = '';
  labels.forEach((lb, i) => {
    if (i % 3 !== 0 && i !== n - 1) return;
    const x = (padL + i * groupW + groupW / 2).toFixed(1);
    axisLabels += `<text x="${x}" y="${H - 6}" text-anchor="middle" font-size="9" fill="#94A3B8">${lb.split(' ')[0]}</text>`;
  });
  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  svg.innerHTML = `
    <line x1="${padL}" y1="${baseY}" x2="${(padL + innerW).toFixed(1)}" y2="${baseY}" stroke="#E2E8F0" stroke-width="1"/>
    ${bars}${axisLabels}
    <rect class="hover-rect" x="${padL}" y="0" width="${innerW}" height="${H}" fill="transparent" style="cursor:pointer"/>
  `;
  const rect = svg.querySelector('.hover-rect');
  const wrap = svg.closest('.chart-card__body');
  rect.addEventListener('mousemove', (e) => {
    const box = svg.getBoundingClientRect();
    const xSvg = ((e.clientX - box.left) / box.width) * W;
    const idx = Math.max(0, Math.min(n - 1, Math.floor((xSvg - padL) / groupW)));
    tooltip.innerHTML = `<div>${fmt(values[idx])} ${opts.unit || ''}</div><div class="chart-tooltip__sub">${labels[idx]}</div>`;
    tooltip.classList.remove('hidden');
    const wrapBox = wrap.getBoundingClientRect();
    const gx = padL + idx * groupW + groupW / 2;
    tooltip.style.left = ((gx / W) * box.width + (box.left - wrapBox.left)) + 'px';
    tooltip.style.top  = ((box.top - wrapBox.top) + 10) + 'px';
  });
  rect.addEventListener('mouseleave', () => tooltip.classList.add('hidden'));
}

/* ═══════════════════ USERS ═════════════════════════════════ */
let allUsers = [];
async function loadUsers() {
  const data = await adminListAccounts();
  allUsers = data || [];
  renderUsers();
}
function renderUsers() {
  const search = document.getElementById('users-search').value.trim().toLowerCase();
  const role   = document.getElementById('users-role-filter').value;
  const status = document.getElementById('users-status-filter').value;
  let rows = allUsers;
  if (search) rows = rows.filter(u => (u.name||'').toLowerCase().includes(search)||(u.phone||'').includes(search));
  if (role)   rows = rows.filter(u => u.role === role);
  if (status) rows = rows.filter(u => (u.status||'active') === status);
  const html = rows.map((u,i) => {
    // Protect admin accounts: their role/status can't be changed and they can't
    // be deleted from the UI (prevents an admin from locking themselves out).
    const isAdminRow = u.role === 'admin';
    return `
    <tr>
      <td style="color:#94A3B8;font-size:.78rem">${i+1}</td>
      <td><div class="user-cell">${avatarChip(u.name,u.phone)}<button class="link-btn" onclick="openUserProfile('${u.phone}')" title="عرض الملف الشخصي الكامل">${u.name||'—'}</button></div></td>
      <td class="num" style="text-align:right;font-size:.85rem">${u.phone||'—'}</td>
      <td>${roleBadge(u.role)}</td>
      <td>${badge(u.status||'active')}</td>
      <td style="font-size:.82rem">${u.city||'—'}</td>
      <td style="font-size:.78rem">${fmtDate(u.created_at||u.createdAt)}</td>
      <td>
        ${isAdminRow ? `
        <span style="display:inline-flex;align-items:center;gap:6px;font-size:.78rem;font-weight:700;color:#64748B">🔒 حساب مشرف محميّ</span>
        ` : `
        <div class="btn-row" style="flex-wrap:nowrap;align-items:center;gap:4px">
          <button class="btn btn--outline btn--sm" onclick="viewUserStats('${u.phone}','${(u.name||'').replace(/'/g,"\\'")}','${u.role}')" title="عرض إحصائيات المستخدم">📊 التفاصيل</button>
          <select class="filter-select" style="font-size:.72rem;padding:.25rem .45rem;min-width:75px" onchange="changeUserStatus('${u.phone}',this.value);this.value='${u.status||'active'}'">
            <option value="active"  ${(u.status||'active')==='active'  ?'selected':''}>نشط</option>
            <option value="pending" ${(u.status||'')==='pending' ?'selected':''}>معلق</option>
            <option value="approved"${(u.status||'')==='approved'?'selected':''}>معتمد</option>
            <option value="rejected"${(u.status||'')==='rejected'?'selected':''}>مرفوض</option>
            <option value="banned"  ${(u.status||'')==='banned'  ?'selected':''}>محظور</option>
          </select>
          ${u.role === 'admin' ? `
          <select class="filter-select" style="font-size:.72rem;padding:.25rem .45rem;min-width:75px" disabled title="دور المشرف لا يُغيَّر من هنا">
            <option selected>مشرف</option>
          </select>
          ` : `
          <select class="filter-select" style="font-size:.72rem;padding:.25rem .45rem;min-width:75px" onchange="changeUserRole('${u.phone}',this.value)">
            <option value="customer" ${u.role==='customer'?'selected':''}>عميل</option>
            <option value="driver"   ${u.role==='driver'  ?'selected':''}>سائق</option>
            <option value="merchant" ${u.role==='merchant'?'selected':''}>تاجر</option>
          </select>
          <button class="btn btn--outline btn--sm" onclick="makeAdmin('${u.phone}')" title="ترقية لمشرف — يتطلب كلمة مرور المشرف ومفتاح الأمان">🛡️ ترقية لمشرف</button>
          `}
          <button class="btn btn--red btn--sm" onclick="deleteUser('${u.phone}')">حذف</button>
        </div>
        `}
      </td>
    </tr>`;
  }).join('') || '<tr><td colspan="8" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد نتائج</td></tr>';
  document.getElementById('users-tbody').innerHTML = html;
}
document.getElementById('users-search').addEventListener('input', renderUsers);
document.getElementById('users-role-filter').addEventListener('change', renderUsers);
document.getElementById('users-status-filter').addEventListener('change', renderUsers);

async function changeUserStatus(phone, status) {
  if (!status) return;
  const ok = await sbPatch(`accounts?phone=eq.${encodeURIComponent(phone)}`, { status });
  if (ok) { showToast(`✅ تم تغيير الحالة إلى "${STATUS_AR[status]||status}"`, '#16A34A'); loadUsers(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}
async function makeAdmin(phone) {
  if (!confirm('منح صلاحيات المشرف لهذا المستخدم؟')) return;
  const pass = getAdminPass();
  if (!pass) return;
  const key = getActionKey();
  if (!key) return;
  const ok = await sbRpc('grant_admin', { p_admin_phone: ADMIN.phone, p_admin_password: pass, p_target_phone: phone, p_action_key: key });
  if (ok) { showToast('✅ تم منح صلاحيات المشرف', '#16A34A'); loadUsers(); }
  else { clearAdminPass(); showToast('❌ فشل — تحقق من كلمة المرور ومفتاح الأمان', '#DC2626'); }
}
async function deleteUser(phone) {
  const user = allUsers.find(u => u.phone === phone);
  const roleAr = { driver:'سائق', merchant:'تاجر', customer:'عميل', admin:'مشرف' }[user?.role] || user?.role || '';
  if (!confirm(`⚠️ حذف حساب ${roleAr} "${user?.name || phone}"؟\nسيتم حذف جميع بياناته المرتبطة. هذا الإجراء لا يمكن التراجع عنه.`)) return;
  const pass = getAdminPass();
  if (!pass) return;
  const key = getActionKey();
  if (!key) return;
  // حذف الحساب بالكامل (وكل بياناته المرتبطة) يمر عبر دالة موثّقة تتحقق من
  // كلمة مرور المشرف ومفتاح الأمان الإضافي على الخادم — نفس نمط
  // grant_admin/create_admin — بدل DELETE مباشر بمفتاح anon كان مفتوحاً لأي حد.
  const ok = await sbRpc('admin_delete_account', { p_admin_phone: ADMIN.phone, p_admin_password: pass, p_target_phone: phone, p_action_key: key });
  if (ok) { showToast('✅ تم الحذف بالكامل', '#16A34A'); loadUsers(); }
  else { clearAdminPass(); showToast('❌ فشل الحذف — تحقق من كلمة المرور ومفتاح الأمان', '#DC2626'); }
}
async function changeUserRole(phone, role) {
  if (!role) return;
  // الترقية لمشرف مش من هنا — لها زرّها الخاص (makeAdmin) بتأكيد كلمة مرور
  // ومفتاح أمان، عشان متحصلش بالغلط من ضغطة في قائمة عادية.
  if (!confirm(`تغيير دور هذا المستخدم إلى "${{driver:'سائق',merchant:'تاجر',customer:'عميل'}[role]||role}"؟`)) {
    renderUsers(); return;
  }
  const patch = { role };
  if (role === 'driver') patch.status = 'approved';
  const ok = await sbPatch(`accounts?phone=eq.${encodeURIComponent(phone)}`, patch);
  if (ok) { showToast('✅ تم تغيير الدور', '#16A34A'); loadUsers(); }
  else showToast('❌ حدث خطأ', '#DC2626');
}

/* ═══════════════════ USER PROFILE ══════════════════════════ */
// Full-detail profile view for any row in the users/drivers/merchants
// tables — opened by clicking a name. accounts is the only PII-locked
// table (admin_get_account_detail, password-verified like
// admin_list_accounts); everything else (orders/rides/ratings/stores/
// wallets/driver_applications/merchant_applications) is anon-readable and
// fetched client-side filtered by phone, same pattern as the existing
// viewUserStats/viewMerchantStats/openDriverModal/openMerchantModal.
let currentProfilePhone = null;
function kpiTile(cls, icon, val, label) {
  return `<div class="kpi kpi--${cls}"><div class="kpi__row"><div class="kpi__icon-wrap">${icon}</div></div><div class="kpi__val">${val}</div><div class="kpi__label">${label}</div></div>`;
}
function revField(label, val) {
  if (val === null || val === undefined || val === '') return '';
  return `<div class="rev-field"><div class="rev-field__label">${label}</div><div class="rev-field__val">${val}</div></div>`;
}
function closeUserProfile() {
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  document.querySelector('.nav-item[data-section="users"]')?.classList.add('active');
  document.querySelectorAll('.section').forEach(el => el.classList.remove('active'));
  document.getElementById('sec-users').classList.add('active');
  document.getElementById('topbar-title').textContent = sectionTitles.users;
  currentSection = 'users';
}
async function openUserProfile(phone) {
  if (!phone) return;
  currentProfilePhone = phone;
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.section').forEach(el => el.classList.remove('active'));
  document.getElementById('sec-user-profile').classList.add('active');
  document.getElementById('topbar-title').textContent = 'الملف الشخصي';
  currentSection = 'user-profile';
  closeSidebar();

  document.getElementById('up-name').textContent = 'جاري التحميل…';
  document.getElementById('up-phone').textContent = phone;
  document.getElementById('up-role-badge').innerHTML = '';
  document.getElementById('up-status-badge').innerHTML = '';
  document.getElementById('up-avatar').outerHTML = '<div id="up-avatar" class="rev-avatar no-img">👤</div>';
  document.getElementById('up-kpi-grid').innerHTML = '';
  document.getElementById('up-account-fields').innerHTML = '';
  document.getElementById('up-side-card').style.display = 'none';
  document.getElementById('up-ratings').innerHTML = '<p style="color:#94A3B8;font-size:.875rem">جاري التحميل…</p>';
  document.getElementById('up-activity-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr>';

  const pass = getAdminPass();
  if (!pass) { closeUserProfile(); return; }
  const rows = await sbRpcRows('admin_get_account_detail', { p_admin_phone: ADMIN.phone, p_admin_password: pass, p_target_phone: phone });
  if (rows === null) { clearAdminPass(); showToast('❌ فشل التحقق — أعد المحاولة', '#DC2626'); closeUserProfile(); return; }
  const acc = rows[0];
  if (!acc) { showToast('❌ لم يتم العثور على المستخدم', '#DC2626'); closeUserProfile(); return; }

  document.getElementById('up-name').textContent = acc.name || '—';
  document.getElementById('up-phone').textContent = '📞 ' + (acc.phone || phone);
  document.getElementById('up-role-badge').innerHTML = roleBadge(acc.role);
  document.getElementById('up-status-badge').innerHTML = badge(acc.status || 'active');
  if (acc.avatar_url) {
    document.getElementById('up-avatar').outerHTML = `<img id="up-avatar" class="rev-avatar" src="${acc.avatar_url}" alt="${(acc.name||'').replace(/"/g,'')}" onclick="document.getElementById('lightbox-img').src='${acc.avatar_url}';document.getElementById('lightbox').classList.remove('hidden')"/>`;
  }
  document.getElementById('up-account-fields').innerHTML = [
    revField('اسم المستخدم', acc.username),
    revField('البريد الإلكتروني', acc.email),
    revField('المدينة', acc.city),
    revField('الرقم القومي', acc.national_id),
    revField('تاريخ انتهاء البطاقة', acc.national_id_expiry ? fmtDate(acc.national_id_expiry) : null),
    revField('تاريخ الانضمام', fmtDate(acc.created_at)),
  ].join('') || '<p style="color:#94A3B8;font-size:.85rem">لا توجد بيانات إضافية</p>';

  const wallet = await sbGet(`wallets?${phoneOrFilter(acc.phone)}&select=balance&limit=1`);
  const balance = Math.round((wallet && wallet[0] && wallet[0].balance) || 0);
  const kpis = [];
  const activityRows = [];
  const ratingsBox = document.getElementById('up-ratings');
  const sideCard = document.getElementById('up-side-card');

  if (acc.role === 'driver') {
    const [trip, app, ratings] = await Promise.all([
      sbRpcJson('get_driver_trip_stats', { p_driver_phone: acc.phone }).catch(() => null),
      sbGet(`driver_applications?${phoneOrFilter(acc.phone)}&select=vehicle_model,vehicle_color,vehicle_year,license_number,vehicle_reg_number,status&order=created_at.desc&limit=1`),
      sbGet(`ratings?${phoneOrFilter(acc.phone,'driver_phone')}&rated_by=eq.customer&rating=not.is.null&select=rating,tags,comment,created_at&order=created_at.desc&limit=30`),
    ]);
    const overall = trip?.overall || {};
    kpis.push(
      kpiTile('green', '🚕', fmt(overall.trips || 0), 'رحلات مكتملة'),
      kpiTile('blue', '💰', fmt(Math.round(overall.earnings_total || 0)) + ' ج.م', 'أرباح الرحلات'),
      kpiTile('orange', '📦', fmt(trip?.store_orders?.trips || 0), 'طلبات توصيل'),
      kpiTile('blue', '💳', fmt(balance) + ' ج.م', 'رصيد المحفظة'),
    );
    const a = app && app[0];
    if (a) {
      sideCard.style.display = '';
      document.getElementById('up-side-title').textContent = '🚗 بيانات السائق والمركبة';
      document.getElementById('up-side-fields').innerHTML = [
        revField('حالة طلب الاعتماد', badge(a.status)),
        revField('موديل السيارة', a.vehicle_model),
        revField('اللون', a.vehicle_color),
        revField('سنة الصنع', a.vehicle_year),
        revField('رقم الرخصة', a.license_number),
        revField('رقم لوحة السيارة', a.vehicle_reg_number),
      ].join('');
      document.getElementById('up-side-docs-btn').onclick = () => openDriverModal(acc.phone);
    }
    const rs = ratings || [];
    const avg = rs.length ? (rs.reduce((s,r) => s + Number(r.rating), 0) / rs.length) : 0;
    ratingsBox.innerHTML = rs.length ? `
      <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:1rem">
        <span style="font-size:1.6rem;font-weight:900;color:#D97706">⭐ ${avg.toFixed(1)}</span>
        <span style="color:#64748B;font-size:.85rem">من ${rs.length} تقييم من العملاء</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:.6rem">
        ${rs.slice(0,10).map(r => `
          <div style="background:#F8FAFC;border:1px solid var(--bdr);border-radius:var(--radius);padding:.65rem .85rem">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span style="font-weight:800;color:#D97706">${'⭐'.repeat(Math.round(Number(r.rating)))}</span>
              <span style="font-size:.72rem;color:#94A3B8">${fmtTime(r.created_at)}</span>
            </div>
            ${r.comment ? `<div style="font-size:.82rem;color:#334155;margin-top:.3rem">${escapeHtml(r.comment)}</div>` : ''}
            ${r.tags && r.tags.length ? `<div style="margin-top:.3rem;display:flex;gap:.3rem;flex-wrap:wrap">${r.tags.map(t=>`<span class="badge badge--gray" style="font-size:.68rem">${escapeHtml(t)}</span>`).join('')}</div>` : ''}
          </div>`).join('')}
      </div>` : '<p style="color:#94A3B8;font-size:.875rem">لا توجد تقييمات بعد</p>';

    const rides = await sbGet(`rides?${phoneOrFilter(acc.phone,'driver_phone')}&select=from_area,to_area,fare,status,created_at&order=created_at.desc&limit=15`);
    (rides || []).forEach(r => activityRows.push({ type:'🚕 رحلة', detail:`${r.from_area||'—'} ← ${r.to_area||'—'}`, amount:r.fare, status:r.status, date:r.created_at }));

  } else if (acc.role === 'merchant') {
    const store = await sbGet(`stores?owner_phone=eq.${encodeURIComponent(acc.phone)}&select=*&order=created_at.desc&limit=1`);
    const s = store && store[0];
    let orders = [], ratings = [];
    if (s) {
      [orders, ratings] = await Promise.all([
        sbGet(`orders?store_id=eq.${encodeURIComponent(s.id)}&select=code,total,status,created_at&order=created_at.desc&limit=200`),
        sbGet(`ratings?store_id=eq.${encodeURIComponent(s.id)}&store_rating=not.is.null&select=store_rating,comment,created_at&order=created_at.desc&limit=30`),
      ]);
    }
    const ordersArr = orders || [];
    const completed = ordersArr.filter(o => o.status === 'delivered' || o.status === 'completed');
    const sales = completed.reduce((sum,o) => sum + (Number(o.total)||0), 0);
    const ratingsArr = ratings || [];
    const avgStore = ratingsArr.length ? ratingsArr.reduce((sum,r) => sum + Number(r.store_rating),0) / ratingsArr.length : 0;
    kpis.push(
      kpiTile('green', '🛍️', fmt(completed.length), 'طلبات مكتملة'),
      kpiTile('blue', '💰', fmt(Math.round(sales)) + ' ج.م', 'إجمالي المبيعات'),
      kpiTile('orange', '⭐', ratingsArr.length ? avgStore.toFixed(1) : '—', 'تقييم المتجر'),
      kpiTile('blue', '💳', fmt(balance) + ' ج.م', 'رصيد المحفظة'),
    );
    if (s) {
      sideCard.style.display = '';
      document.getElementById('up-side-title').textContent = '🏪 بيانات المتجر';
      document.getElementById('up-side-fields').innerHTML = [
        revField('اسم المتجر', `${s.emoji||''} ${s.name||''}`.trim()),
        revField('الفئة', s.category),
        revField('المنطقة', s.area),
        revField('العنوان', s.address),
        revField('رسوم التوصيل', s.delivery_fee != null ? `${s.delivery_fee} ج.م` : null),
        revField('حالة المتجر', s.is_open === false ? 'مغلق حالياً' : 'مفتوح'),
      ].join('');
      document.getElementById('up-side-docs-btn').onclick = () => openMerchantModal(acc.phone);
    }
    ratingsBox.innerHTML = ratingsArr.length ? `
      <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:1rem">
        <span style="font-size:1.6rem;font-weight:900;color:#D97706">⭐ ${avgStore.toFixed(1)}</span>
        <span style="color:#64748B;font-size:.85rem">من ${ratingsArr.length} تقييم من العملاء</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:.6rem">
        ${ratingsArr.slice(0,10).map(r => `
          <div style="background:#F8FAFC;border:1px solid var(--bdr);border-radius:var(--radius);padding:.65rem .85rem">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span style="font-weight:800;color:#D97706">${'⭐'.repeat(Math.round(Number(r.store_rating)))}</span>
              <span style="font-size:.72rem;color:#94A3B8">${fmtTime(r.created_at)}</span>
            </div>
            ${r.comment ? `<div style="font-size:.82rem;color:#334155;margin-top:.3rem">${escapeHtml(r.comment)}</div>` : ''}
          </div>`).join('')}
      </div>` : '<p style="color:#94A3B8;font-size:.875rem">لا توجد تقييمات بعد</p>';

    ordersArr.slice(0,15).forEach(o => activityRows.push({ type:'🛍️ طلب', detail:`#${o.code||'—'}`, amount:o.total, status:o.status, date:o.created_at }));

  } else if (acc.role === 'customer') {
    const [orders, rides, ratings] = await Promise.all([
      sbGet(`orders?customer_phone=eq.${encodeURIComponent(acc.phone)}&select=code,total,status,created_at&order=created_at.desc&limit=200`),
      sbGet(`rides?customer_phone=eq.${encodeURIComponent(acc.phone)}&select=from_area,to_area,fare,status,created_at&order=created_at.desc&limit=200`),
      sbGet(`ratings?${phoneOrFilter(acc.phone,'customer_phone')}&rated_by=eq.customer&rating=not.is.null&select=rating,comment,created_at&order=created_at.desc&limit=30`),
    ]);
    const ordersArr = orders || [], ridesArr = rides || [];
    const spend =
      ordersArr.filter(o => o.status === 'delivered' || o.status === 'completed').reduce((s,o) => s + (Number(o.total)||0), 0) +
      ridesArr.filter(r => r.status === 'completed').reduce((s,r) => s + (Number(r.fare)||0), 0);
    kpis.push(
      kpiTile('blue', '🛍️', fmt(ordersArr.length), 'إجمالي الطلبات'),
      kpiTile('green', '🚕', fmt(ridesArr.length), 'إجمالي الرحلات'),
      kpiTile('orange', '💸', fmt(Math.round(spend)) + ' ج.م', 'إجمالي الإنفاق'),
      kpiTile('blue', '💳', fmt(balance) + ' ج.م', 'رصيد المحفظة'),
    );
    const rs = ratings || [];
    ratingsBox.innerHTML = rs.length ? `
      <div style="color:#64748B;font-size:.85rem;margin-bottom:1rem">قيّم ${rs.length} سائقاً حتى الآن</div>
      <div style="display:flex;flex-direction:column;gap:.6rem">
        ${rs.slice(0,10).map(r => `
          <div style="background:#F8FAFC;border:1px solid var(--bdr);border-radius:var(--radius);padding:.65rem .85rem">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span style="font-weight:800;color:#D97706">${'⭐'.repeat(Math.round(Number(r.rating)))}</span>
              <span style="font-size:.72rem;color:#94A3B8">${fmtTime(r.created_at)}</span>
            </div>
            ${r.comment ? `<div style="font-size:.82rem;color:#334155;margin-top:.3rem">${escapeHtml(r.comment)}</div>` : ''}
          </div>`).join('')}
      </div>` : '<p style="color:#94A3B8;font-size:.875rem">لم يقيّم أي سائق بعد</p>';

    ordersArr.slice(0,10).forEach(o => activityRows.push({ type:'🛍️ طلب', detail:`#${o.code||'—'}`, amount:o.total, status:o.status, date:o.created_at }));
    ridesArr.slice(0,10).forEach(r => activityRows.push({ type:'🚕 رحلة', detail:`${r.from_area||'—'} ← ${r.to_area||'—'}`, amount:r.fare, status:r.status, date:r.created_at }));

  } else {
    kpis.push(kpiTile('blue', '💳', fmt(balance) + ' ج.م', 'رصيد المحفظة'));
    ratingsBox.innerHTML = '<p style="color:#94A3B8;font-size:.875rem">لا ينطبق على هذا نوع الحساب</p>';
  }

  document.getElementById('up-kpi-grid').innerHTML = kpis.join('');
  activityRows.sort((a,b) => new Date(b.date||0) - new Date(a.date||0));
  document.getElementById('up-activity-tbody').innerHTML = activityRows.length
    ? activityRows.map(r => `<tr>
        <td style="font-size:.78rem">${r.type}</td>
        <td style="font-size:.78rem">${r.detail}</td>
        <td style="font-weight:800">${r.amount != null ? fmt(Math.round(Number(r.amount)||0)) + ' ج.م' : '—'}</td>
        <td>${badge(r.status)}</td>
        <td style="font-size:.78rem">${fmtTime(r.date)}</td>
      </tr>`).join('')
    : '<tr><td colspan="5" style="text-align:center;color:#94A3B8;padding:2rem">لا يوجد نشاط بعد</td></tr>';
}

