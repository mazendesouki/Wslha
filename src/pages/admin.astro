async function viewUserStats(phone, name, role) {
  document.getElementById('user-stats-modal-title').textContent = `📊 إحصائيات: ${name || phone}`;
  document.getElementById('user-stats-tbody').innerHTML = '<tr><td colspan="4" style="text-align:center;color:#94A3B8;padding:2rem">جاري التحميل…</td></tr>';
  ['us-orders','us-rides','us-amount','us-balance'].forEach(id => document.getElementById(id).textContent = '—');
  document.getElementById('user-stats-modal').classList.remove('hidden');

  const intl  = phone.startsWith('01') ? '+2' + phone : phone;
  const local = phone.startsWith('+20') ? '0' + phone.slice(3) : phone;
  const col = role === 'driver' ? 'driver_phone' : 'customer_phone';
  const filter = `or=(${col}.eq.${encodeURIComponent(intl)},${col}.eq.${encodeURIComponent(local)})`;

  const [orders, rides, wallet] = await Promise.all([
    sbGet(`orders?${filter}&select=total,status,created_at&order=created_at.desc&limit=200`),
    sbGet(`rides?${filter}&select=fare,status,created_at,from_area,to_area&order=created_at.desc&limit=200`),
    sbGet(`wallets?${phoneOrFilter(phone)}&select=balance&limit=1`),
  ]);

  const ordersArr = orders || [];
  const ridesArr  = rides || [];
  const amount =
    ordersArr.filter(o => o.status === 'delivered' || o.status === 'completed').reduce((s, o) => s + (Number(o.total) || 0), 0) +
    ridesArr.filter(r => r.status === 'completed').reduce((s, r) => s + (Number(r.fare) || 0), 0);

  document.getElementById('us-orders').textContent = ordersArr.length;
  document.getElementById('us-rides').textContent  = ridesArr.length;
  document.getElementById('us-amount').textContent = fmt(Math.round(amount)) + ' ج.م';
  document.getElementById('us-amount-lbl').textContent = role === 'driver' ? '💰 أرباح' : '💰 إنفاق';
  document.getElementById('us-balance').textContent = fmt(Math.round((wallet && wallet[0] && wallet[0].balance) || 0)) + ' ج.م';

  const rows = [
    ...ordersArr.map(o => ({ type: 'طلب', date: o.created_at, amount: o.total, status: o.status })),
    ...ridesArr.map(r => ({ type: 'رحلة', date: r.created_at, amount: r.fare, status: r.status })),
  ].sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0));

  document.getElementById('user-stats-tbody').innerHTML = rows.length
    ? rows.map(r => `<tr>
        <td style="font-size:.78rem">${r.type}</td>
        <td style="font-size:.78rem">${fmtTime(r.date)}</td>
        <td style="font-weight:800">${fmt(Math.round(Number(r.amount) || 0))} ج.م</td>
        <td>${badge(r.status)}</td>
      </tr>`).join('')
    : '<tr><td colspan="4" style="text-align:center;color:#94A3B8;padding:2rem">لا توجد بيانات بعد</td></tr>';
}

