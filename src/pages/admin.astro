// نفس رقم الهاتف ممكن يتسجل بصيغة محلية (01...) أو دولية (+201...) —
// نطابق الاتنين بدل مطابقة نصية حرفية قد تفوّت الصف.
function phoneOrFilter(p, col = 'phone') {
  const intl  = p.startsWith('01') ? '+2' + p : p;
  const local = p.startsWith('+20') ? '0' + p.slice(3) : p;
  return `or=(${col}.eq.${encodeURIComponent(intl)},${col}.eq.${encodeURIComponent(local)})`;
}
async function openDriverModal(phone) {
  currentDriverPhone = phone;
  document.getElementById('driver-modal').classList.remove('hidden');
  document.getElementById('driver-reject-area').style.display = 'none';
  document.getElementById('driver-reject-toggle').classList.remove('hidden');
  document.getElementById('driver-reject-confirm').classList.add('hidden');
  document.getElementById('driver-modal-body').innerHTML = '<p style="color:#94A3B8">جاري التحميل…</p>';
  const rows = await sbGet(`driver_applications?${phoneOrFilter(phone)}&select=*&order=created_at.desc&limit=1`);
  const a = rows?.[0];
  if (!a) { document.getElementById('driver-modal-body').innerHTML = '<p style="color:#DC2626">لم يتم العثور على الطلب</p>'; return; }

  const escLbl = (s) => (s || '').replace(/'/g, "\\'");
  const rdoc = (label, url) => `
    <div class="rev-doc">
      ${url
        ? `<img class="rev-doc__img" src="${url}" alt="${label}" onclick="document.getElementById('lightbox-img').src='${url}';document.getElementById('lightbox').classList.remove('hidden')" loading="lazy"/>`
        : `<div class="rev-doc__img no-img">📄</div>`}
      <div class="rev-doc__label">${label}</div>
    </div>`;
  const daysUntil = (dateStr) => dateStr ? Math.floor((new Date(dateStr) - new Date()) / 86400000) : null;
  const rfield = (label, val, dateStr) => {
    if (!val) return '';
    let cls = '';
    if (dateStr !== undefined) {
      const d = daysUntil(dateStr);
      if (d !== null) cls = d < 0 ? 'is-expired' : d <= 30 ? 'is-expiring' : '';
    }
    return `<div class="rev-field"><div class="rev-field__label">${label}</div><div class="rev-field__val ${cls}">${val}</div></div>`;
  };
  const rsection = (icon, title, fieldsHtml, docsHtml) => {
    const fields = (fieldsHtml || []).filter(Boolean).join('');
    const docs   = (docsHtml || []).filter(Boolean).join('');
    if (!fields && !docs) return '';
    return `<div class="rev-section">
      <div class="rev-section__head">${icon} ${title}</div>
      ${fields ? `<div class="rev-fields">${fields}</div>` : ''}
      ${docs ? `<div class="rev-docs">${docs}</div>` : ''}
    </div>`;
  };
  const ownershipAr = { owned: 'ملك', rented: 'إيجار', borrowed: 'مستعار' }[a.vehicle_ownership] || a.vehicle_ownership;
  const VTYPE_LABELS = {
    car:        { icon: '🚘', title: 'بيانات السيارة', docsTitle: 'وثائق السيارة', regDoc: 'رخصة تسجيل السيارة' },
    motorcycle: { icon: '🏍️', title: 'بيانات الدراجة النارية', docsTitle: 'وثائق الدراجة النارية', regDoc: 'رخصة تسجيل الدراجة' },
    cargo:      { icon: '📦', title: 'بيانات سيارة النقل', docsTitle: 'وثائق سيارة النقل', regDoc: 'رخصة تسجيل سيارة النقل' },
  };
  const vt = VTYPE_LABELS[a.vehicle_category] || VTYPE_LABELS.car;

  document.getElementById('driver-modal-body').innerHTML = `
    <div class="rev-header">
      ${a.driver_photo_url
        ? `<img class="rev-avatar" src="${a.driver_photo_url}" alt="${escLbl(a.full_name)}" onclick="document.getElementById('lightbox-img').src='${a.driver_photo_url}';document.getElementById('lightbox').classList.remove('hidden')"/>`
        : `<div class="rev-avatar no-img">🧑‍✈️</div>`}
      <div>
        <div class="rev-header__top">
          <span class="rev-header__name">${a.full_name || '—'}</span>
          ${badge(a.status)}
        </div>
        <div class="rev-header__phone">📞 ${a.phone || '—'}</div>
      </div>
    </div>

    ${rsection('🪪', 'الهوية الوطنية', [
      rfield('رقم الهوية', a.national_id_number),
      rfield('تاريخ الانتهاء', fmtDate(a.national_id_expiry), a.national_id_expiry),
    ], [
      rdoc('الوجه الأمامي', a.national_id_front_url),
      rdoc('الوجه الخلفي', a.national_id_back_url),
    ])}

    ${rsection('🚦', 'رخصة القيادة', [
      rfield('رقم الرخصة', a.license_number),
      rfield('تاريخ الانتهاء', fmtDate(a.license_expiry), a.license_expiry),
    ], [
      rdoc('صورة الرخصة', a.license_photo_url),
    ])}

    ${rsection(vt.icon, vt.title, [
      rfield('الموديل', a.vehicle_model),
      rfield('اللون', a.vehicle_color),
      rfield('سنة الصنع', a.vehicle_year),
      rfield('تاريخ الشراء', a.vehicle_purchase_date ? fmtDate(a.vehicle_purchase_date) : null),
      rfield('الملكية', ownershipAr),
      rfield('رقم اللوحة', a.vehicle_reg_number),
    ], [
      rdoc('اللوحة', a.plate_photo_url),
      rdoc('أمام', a.vehicle_front_url),
      rdoc('خلف', a.vehicle_back_url),
      rdoc('يمين', a.vehicle_right_url),
      rdoc('يسار', a.vehicle_left_url),
    ])}

    ${rsection('📋', vt.docsTitle, [
      rfield('انتهاء رخصة التسجيل', fmtDate(a.vehicle_reg_expiry), a.vehicle_reg_expiry),
      rfield('انتهاء التأمين', a.insurance_expiry ? fmtDate(a.insurance_expiry) : null, a.insurance_expiry),
      rfield('انتهاء الفحص', a.inspection_expiry ? fmtDate(a.inspection_expiry) : null, a.inspection_expiry),
    ], [
      rdoc(vt.regDoc, a.vehicle_reg_photo_url),
      a.insurance_photo_url ? rdoc('التأمين', a.insurance_photo_url) : '',
      a.inspection_photo_url ? rdoc('شهادة الفحص', a.inspection_photo_url) : '',
    ])}

    ${rsection('📝', 'إقرارات وملاحظات', [
      rfield('يتعاطى مخدرات؟', a.uses_drugs === 'no' ? '❌ لا' : '⚠️ نعم'),
      a.handwritten_text ? rfield('النص المكتوب', a.handwritten_text) : '',
    ], [
      a.handwritten_photo_url ? rdoc('إقرار بخط اليد', a.handwritten_photo_url) : '',
      a.good_conduct_url ? rdoc('شهادة حسن السيرة', a.good_conduct_url) : '',
    ])}

    ${a.rejection_reason ? `<div style="background:#FEE2E2;border:1px solid #FECACA;border-radius:8px;padding:.75rem 1rem;margin-top:1rem"><span style="font-size:.8rem;font-weight:700;color:#DC2626">سبب الرفض السابق:</span> <span style="font-size:.85rem;color:#DC2626">${a.rejection_reason}</span></div>` : ''}
    ${a.status !== 'pending' ? `<div style="background:#F8FAFC;border-radius:8px;padding:.75rem 1rem;margin-top:.75rem;font-size:.82rem;color:#64748B">تمت المراجعة بواسطة: ${a.reviewed_by||'—'} — ${fmtDate(a.reviewed_at)}</div>` : ''}
  `;
  // Hide approve/reject if already decided
  const aBtn = document.getElementById('driver-approve-btn');
  const rBtn = document.getElementById('driver-reject-toggle');
  const hide = a.status !== 'pending';
  aBtn.classList.toggle('hidden', hide);
  rBtn.classList.toggle('hidden', hide);
}

