      ${infoF('نوع النشاط', a.business_type)}
      ${infoF('عنوان النشاط', a.business_address)}
      ${infoF('رقم الجوال', a.phone)}
      ${infoF('رقم السجل التجاري', a.commercial_reg_number)}
      ${infoF('تاريخ السجل', a.commercial_reg_date)}
      ${infoF('رقم الهوية الوطنية', a.national_id_number)}
      ${infoF('انتهاء الهوية', a.national_id_expiry)}
      ${infoF('رقم البطاقة الضريبية', a.tax_card_number)}
    </div>
    <h3 style="font-size:.85rem;font-weight:700;color:#64748B;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.75rem;margin-top:1rem">📸 المستندات</h3>
    <div class="doc-grid">
      ${docItem('السجل التجاري', a.commercial_reg_url)}
      ${docItem('الهوية الوطنية', a.national_id_url)}
      ${docItem('البطاقة الضريبية', a.tax_card_url)}
