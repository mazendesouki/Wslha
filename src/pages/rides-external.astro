---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
import { VEHICLE_TYPES } from '../data/airports';
---

<style>
  .ext-wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-10) var(--sp-6) var(--sp-20);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-8);
    align-items: start;
  }
  .ext-form {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    padding: var(--sp-8);
  }
  .ext-form__step { font-size: var(--text-base); font-weight: var(--weight-black); margin: var(--sp-6) 0 var(--sp-4); display: flex; align-items: center; gap: var(--sp-2); }
  .ext-form__step:first-child { margin-top: 0; }
  .ext-form__num { width: 26px; height: 26px; border-radius: var(--radius-full); background: var(--color-primary); color: #fff; font-size: var(--text-sm); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .ext-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .field { margin-bottom: var(--sp-4); }
  .field__label { display: block; font-weight: var(--weight-bold); font-size: var(--text-sm); margin-bottom: var(--sp-2); color: var(--color-text); }
  .field__input, .field__select, .field__textarea {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border); border-radius: var(--radius);
    font-family: var(--font-body); font-size: var(--text-base);
    direction: rtl; background: var(--color-bg); color: var(--color-text); outline: none;
    transition: border-color var(--ease);
  }
  .field__input:focus, .field__select:focus, .field__textarea:focus { border-color: var(--color-primary); }
  .field__hint { font-size: var(--text-xs); color: var(--color-text-faint); margin-top: 4px; }
  .ext-divider { border: none; border-top: 1px solid var(--color-border); margin: var(--sp-6) 0; }

  .veh-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); }
  .veh-card {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: var(--sp-4) var(--sp-3); border: 2px solid var(--color-border);
    border-radius: var(--radius-lg); background: var(--color-bg-soft);
    cursor: pointer; transition: all 0.2s; font-family: var(--font-body); text-align: center;
  }
  .veh-card--active { border-color: var(--color-primary); background: var(--color-primary-light); }
  .veh-card:hover:not(.veh-card--active) { border-color: var(--color-primary); }
  .veh-card__icon { font-size: 1.8rem; }
  .veh-card__name { font-weight: var(--weight-black); font-size: var(--text-sm); color: var(--color-text); }
  .veh-card__desc { font-size: 10px; color: var(--color-text-faint); }
  .veh-card__cap { font-size: 10px; color: var(--color-text-muted); margin-top: 2px; }
  .veh-card--active .veh-card__name { color: var(--color-primary); }
  @media (max-width: 480px) { .veh-grid { grid-template-columns: 1fr; } }

  .loc-wrap { display: flex; align-items: center; gap: 8px; }
  .loc-wrap .field__input { flex: 1; }
  .loc-btn {
    width: 38px; height: 38px; flex-shrink: 0;
    border: 1.5px solid var(--color-border); border-radius: var(--radius);
    background: var(--color-bg-soft); cursor: pointer; font-size: 0.95rem;
    display: flex; align-items: center; justify-content: center; transition: all 0.2s;
  }
  .loc-btn:hover { background: var(--color-primary-light); border-color: var(--color-primary); }
  .pac-container { z-index: 9999 !important; direction: rtl; font-family: var(--font-body); }

  .ext-summary { position: sticky; top: calc(var(--nav-height) + var(--sp-4)); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-xl); box-shadow: var(--shadow-md); overflow: hidden; }
  .ext-summary__head { background: var(--color-primary); color: #fff; padding: var(--sp-5); }
  .ext-summary__head h2 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; }
  .ext-summary__route { font-size: var(--text-sm); opacity: 0.9; margin-top: 2px; }
  .ext-summary__body { padding: var(--sp-5); }
  .ext-prices { border-top: 1px solid var(--color-border); padding-top: var(--sp-4); }
  .ext-prices .row { display: flex; justify-content: space-between; font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--sp-2); }
  .ext-prices .total { display: flex; justify-content: space-between; align-items: baseline; margin-top: var(--sp-3); padding-top: var(--sp-3); border-top: 2px solid var(--color-border); }
  .ext-prices .total b { font-size: var(--text-3xl); font-weight: var(--weight-black); color: var(--color-primary); line-height: 1; }
  .ext-prices .total b small { font-size: var(--text-sm); }
  .ext-error { background: #FEE2E2; color: #B91C1C; border-radius: var(--radius); padding: var(--sp-3) var(--sp-4); font-size: var(--text-sm); margin: var(--sp-4) 0 0; display: none; }
  .ext-error.is-visible { display: block; }
  .ext-submit { width: 100%; margin-top: var(--sp-5); padding: var(--sp-4); background: var(--color-accent); color: var(--color-text); border: none; border-radius: var(--radius); font-family: var(--font-body); font-weight: var(--weight-black); font-size: var(--text-base); cursor: pointer; }
  .ext-submit:hover:not(:disabled) { background: var(--color-accent-dark); }
  .ext-submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .ext-submit:focus-visible, .loc-btn:focus-visible, .veh-card:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
  .ext-note { font-size: var(--text-xs); color: var(--color-text-faint); text-align: center; margin-top: var(--sp-3); }

  .ext-success { display: none; max-width: 520px; margin: var(--sp-12) auto var(--sp-20); padding: 0 var(--sp-4); text-align: center; }
  .ext-success.is-visible { display: block; }
  .ext-success__check { width: 80px; height: 80px; border-radius: var(--radius-full); background: linear-gradient(135deg, #16a34a, #22c55e); display: flex; align-items: center; justify-content: center; font-size: 2.2rem; margin: 0 auto var(--sp-5); box-shadow: 0 8px 24px rgba(22,163,74,0.3); }
  .ext-success__title { font-size: var(--text-2xl); font-weight: var(--weight-black); color: var(--color-text); margin-bottom: var(--sp-2); }
  .ext-success__sub { font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--sp-5); }
  .ext-success__id-wrap { display: inline-flex; align-items: center; gap: var(--sp-2); background: var(--color-primary-light); border: 1.5px dashed var(--color-primary); border-radius: var(--radius-lg); padding: var(--sp-2) var(--sp-5); margin-bottom: var(--sp-7); }
  .ext-success__id-label { font-size: var(--text-xs); color: var(--color-text-muted); font-weight: var(--weight-semi); }
  .ext-success__id-val { font-size: var(--text-base); font-weight: var(--weight-black); color: var(--color-primary); letter-spacing: 0.5px; }
  .ext-success__actions { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .ext-wrap { grid-template-columns: 1fr; }
    .ext-summary { position: static; }
    .ext-row { grid-template-columns: 1fr; }
  }
</style>

<Layout
  title="رحلات خارجية"
  description="رحلات من دمياط إلى خارج المحافظة — القاهرة، الإسكندرية، وكل محافظات مصر — بعداد ثابت للكيلومتر حسب فئة السيارة"
  page="rides-external"
>
  <PageHero
    badge="رحلات خارجية"
    title="من دمياط لأي محافظة في مصر"
    subtitle="اختر السيارة ووجهتك خارج محافظة دمياط — والسعر يُحسب تلقائياً حسب المسافة وفئة السيارة"
  />

  <div class="ext-wrap" id="ext-wrap">
    <form class="ext-form" id="ext-form">

      <!-- قسم 1: اختيار السيارة -->
      <h2 class="ext-form__step"><span class="ext-form__num">1</span> اختيار السيارة</h2>
      <div class="veh-grid">
        <button type="button" class="veh-card veh-card--active" data-veh="sedan">
          <span class="veh-card__icon">🚗</span>
          <span class="veh-card__name">سيدان</span>
          <span class="veh-card__desc">تويوتا / هيونداي</span>
          <span class="veh-card__cap">👤 ٣ ركاب • 🧳 ٢ شنطة</span>
        </button>
        <button type="button" class="veh-card" data-veh="suv">
          <span class="veh-card__icon">🚙</span>
          <span class="veh-card__name">SUV / كروز</span>
          <span class="veh-card__desc">لاند كروزر / باترول</span>
          <span class="veh-card__cap">👥 ٦ ركاب • 🧳 ٤ شنط</span>
        </button>
        <button type="button" class="veh-card" data-veh="van">
          <span class="veh-card__icon">🚐</span>
          <span class="veh-card__name">ميكروباص</span>
          <span class="veh-card__desc">H1 / سبرينتر</span>
          <span class="veh-card__cap">👥 ١٠ ركاب • 🧳 ٨ شنط</span>
        </button>
      </div>
      <p class="field__hint" id="veh-hint">تم اختيار السيدان — ٣ ركاب بحد أقصى</p>

      <div class="ext-row">
        <div class="field">
          <label class="field__label" for="veh-model">الماركة والموديل</label>
          <select id="veh-model" class="field__select"></select>
        </div>
        <div class="field">
          <label class="field__label" for="veh-year">سنة الصنع</label>
          <select id="veh-year" class="field__select"></select>
        </div>
      </div>
      <p class="field__hint" id="veh-rate-hint"></p>

      <hr class="ext-divider">

      <!-- قسم 2: نقطة البداية والوجهة -->
      <h2 class="ext-form__step"><span class="ext-form__num">2</span> نقطة البداية والوجهة</h2>
      <div class="ext-row">
        <div class="field">
          <label class="field__label" for="from-area">نقطة البداية (داخل دمياط)</label>
          <div class="loc-wrap">
            <input type="text" class="field__input" id="from-area" placeholder="اكتب منطقتك أو حيّك في دمياط..." autocomplete="off" />
            <button type="button" class="loc-btn" id="btn-ext-loc" title="موقعي الحالي" aria-label="استخدم موقعي الحالي">📍</button>
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="to-area">الوجهة (خارج محافظة دمياط)</label>
          <input type="text" class="field__input" id="to-area" placeholder="مثال: القاهرة، الإسكندرية، المنصورة..." autocomplete="off" />
          <p class="field__hint" id="to-hint">بحث حي بموقع الوجهة الفعلي — المسافة والسعر تُحسب تلقائياً.</p>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="dest-governorate">محافظة الوجهة</label>
        <select class="field__select" id="dest-governorate">
          <option value="">اختر المحافظة...</option>
          <option>القاهرة</option><option>الجيزة</option><option>الإسكندرية</option>
          <option>الدقهلية</option><option>البحيرة</option><option>الفيوم</option>
          <option>الغربية</option><option>الإسماعيلية</option><option>المنوفية</option>
          <option>المنيا</option><option>القليوبية</option><option>الوادي الجديد</option>
          <option>السويس</option><option>أسوان</option><option>أسيوط</option>
          <option>بني سويف</option><option>بورسعيد</option><option>دمياط</option>
          <option>الشرقية</option><option>جنوب سيناء</option><option>كفر الشيخ</option>
          <option>مطروح</option><option>الأقصر</option><option>قنا</option>
          <option>شمال سيناء</option><option>سوهاج</option><option>البحر الأحمر</option>
        </select>
      </div>

      <div class="field">
        <label class="field__label" for="address">عنوان الاستلام بالتفصيل</label>
        <textarea class="field__textarea" id="address" placeholder="الحي، الشارع، رقم المبنى، علامة مميزة..."></textarea>
      </div>

      <hr class="ext-divider">

      <!-- قسم 3: بيانات الراكب -->
      <h2 class="ext-form__step"><span class="ext-form__num">3</span> بيانات الراكب</h2>
      <div class="ext-row" id="trav-contact-row">
        <div class="field">
          <label class="field__label" for="trav-name">الاسم الكامل</label>
          <input class="field__input" id="trav-name" type="text" placeholder="محمد أحمد" autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="trav-phone">رقم الجوال</label>
          <input class="field__input" id="trav-phone" type="tel" placeholder="010 1234 5678" inputmode="numeric" maxlength="11" pattern="01[0125][0-9]{8}" autocomplete="tel">
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="passengers">عدد الركاب</label>
        <input class="field__input" id="passengers" type="number" min="1" max="3" value="1">
      </div>

      <div class="field">
        <label class="field__label">طريقة الدفع</label>
        <select class="field__select" id="ext-payment">
          <option value="cash">💵 كاش عند الوصول</option>
          <option value="wallet">📱 فودافون كاش / إنستاباي</option>
          <option value="bank_transfer">🏦 تحويل بنكي</option>
        </select>
      </div>
    </form>

    <!-- Live summary -->
    <aside class="ext-summary" aria-label="ملخص الرحلة">
      <div class="ext-summary__head">
        <h2>رحلتك الخارجية</h2>
        <p class="ext-summary__route" id="sum-route">اختر الوجهة لعرض السعر</p>
      </div>
      <div class="ext-summary__body">
        <div class="ext-prices">
          <div class="row"><span>المسافة</span><span id="p-distance">—</span></div>
          <div class="row"><span>مدة الرحلة التقريبية</span><span id="p-duration">—</span></div>
          <div class="row"><span id="p-veh-label">السيارة</span><span id="p-veh">—</span></div>
          <div class="total"><span>الإجمالي</span><b id="p-total">— <small>ج.م</small></b></div>
        </div>
        <div class="ext-error" id="ext-error" role="alert" aria-live="polite"></div>
        <button type="submit" form="ext-form" class="ext-submit" id="ext-submit">تأكيد الحجز ←</button>
        <p class="ext-note">سعر ثابت حسب المسافة — الدفع نقداً أو إلكترونياً</p>
      </div>
    </aside>
  </div>

  <script type="application/json" id="vehicles-json" set:html={JSON.stringify(VEHICLE_TYPES)}></script>

  <!-- Success -->
  <section class="ext-success" id="ext-success" role="alert" aria-live="polite" tabindex="-1">
    <div class="ext-success__check" aria-hidden="true">✅</div>
    <h2 class="ext-success__title">تم تأكيد حجز رحلتك!</h2>
    <p class="ext-success__sub">سيصلك السائق في أقرب وقت.</p>
    <div class="ext-success__id-wrap">
      <span class="ext-success__id-label">رقم الحجز</span>
      <span class="ext-success__id-val" id="ext-success-id">—</span>
    </div>
    <div class="ext-success__actions">
      <a href="/orders" class="btn btn--primary">📋 طلباتي</a>
      <a href="/track" class="btn btn--outline" id="ext-success-track">📡 تتبع الطلب</a>
    </div>
  </section>

  <script>
    import { VEHICLE_MODELS, externalFare, ratePerKmFor, fetchRegisteredVehicles, DAMIETTA_ORIGIN, loadPricingSettings } from '../data/airports';
    import { isEgyptianMobile, normalizeEgyptianPhone, EG_PHONE_ERROR } from '../utils/phone';

    // Admin-configurable pricing (app_settings) — mutates TRIP_RATES/
    // EXTERNAL_BASE_FARE/EXTERNAL_MIN_FARE in data/airports.ts in place, so
    // externalFare() below picks it up automatically once this resolves.
    loadPricingSettings();

    const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';

    const $ = (id: string) => document.getElementById(id)!;
    const form = $('ext-form') as HTMLFormElement;
    const errBox = $('ext-error') as HTMLElement;

    interface VehicleType { id: string; name: string; maxTravelers: number; maxBags: number; freeBags: number; surcharge: number; }
    const VEHICLES_DATA: VehicleType[] = JSON.parse((document.getElementById('vehicles-json') as HTMLScriptElement).textContent || '[]');
    let selectedVehicle: VehicleType = VEHICLES_DATA[0] || { id: 'sedan', name: 'سيدان', maxTravelers: 3, maxBags: 2, freeBags: 2, surcharge: 0 };

    interface VehicleModel { id: string; category: string; name: string; yearFrom: number; yearTo: number; }
    const vehModelSel = $('veh-model') as HTMLSelectElement;
    const vehYearSel  = $('veh-year') as HTMLSelectElement;
    let REGISTERED_VEHICLES: VehicleModel[] = [];
    let selVehModel: VehicleModel = (VEHICLE_MODELS as VehicleModel[]).find(m => m.category === 'sedan') || (VEHICLE_MODELS as VehicleModel[])[0];
    let selVehYear = 2022;

    function populateVehModels(cat: string): void {
      const models = REGISTERED_VEHICLES.filter(m => m.category === cat);
      vehModelSel.innerHTML = models.map(m => `<option value="${m.id}">${m.name}</option>`).join('');
      selVehModel = models[0] || selVehModel;
      populateVehYears();
    }
    function populateVehYears(): void {
      const years: number[] = [];
      for (let y = selVehModel.yearTo; y >= selVehModel.yearFrom; y--) years.push(y);
      vehYearSel.innerHTML = years.map(y => `<option value="${y}"${y === 2022 ? ' selected' : ''}>${y}</option>`).join('');
      selVehYear = parseInt(vehYearSel.value, 10) || years[0];
      updateVehRateHint();
    }
    function updateVehRateHint(): void {
      const h = $('veh-rate-hint');
      if (h) h.textContent = `${selVehModel.name} ${selVehYear} — ${ratePerKmFor('external', selVehModel, selVehYear).toFixed(1)} ج.م/كم`;
    }
    vehModelSel.addEventListener('change', () => {
      selVehModel = REGISTERED_VEHICLES.find(m => m.id === vehModelSel.value) || selVehModel;
      populateVehYears();
      render();
    });
    vehYearSel.addEventListener('change', () => {
      selVehYear = parseInt(vehYearSel.value, 10) || selVehYear;
      updateVehRateHint();
      render();
    });

    async function initRegisteredVehicles(): Promise<void> {
      REGISTERED_VEHICLES = await fetchRegisteredVehicles();
      const availableCats = new Set(REGISTERED_VEHICLES.map(v => v.category));
      let firstAvailable: string | null = null;
      document.querySelectorAll('.veh-card').forEach(card => {
        const cat = (card as HTMLElement).dataset.veh!;
        const has = availableCats.has(cat);
        (card as HTMLElement).hidden = !has;
        if (has && !firstAvailable) firstAvailable = cat;
      });
      if (!firstAvailable) {
        vehModelSel.innerHTML = '';
        vehYearSel.innerHTML = '';
        const h = $('veh-rate-hint');
        if (h) h.textContent = 'لا يوجد سائقون معتمدون حاليًا — حاول لاحقًا.';
        (document.getElementById('ext-submit') as HTMLButtonElement).disabled = true;
        return;
      }
      document.querySelectorAll('.veh-card').forEach(c => c.classList.remove('veh-card--active'));
      document.querySelector(`.veh-card[data-veh="${firstAvailable}"]`)?.classList.add('veh-card--active');
      populateVehModels(firstAvailable);
    }
    initRegisteredVehicles();

    document.querySelectorAll('.veh-card').forEach(card => {
      card.addEventListener('click', () => {
        if ((card as HTMLElement).hidden) return;
        document.querySelectorAll('.veh-card').forEach(c => c.classList.remove('veh-card--active'));
        card.classList.add('veh-card--active');
        const vehId = (card as HTMLElement).dataset.veh!;
        selectedVehicle = VEHICLES_DATA.find(v => v.id === vehId) || VEHICLES_DATA[0];
        const travInput = $('passengers') as HTMLInputElement;
        travInput.max = String(selectedVehicle.maxTravelers);
        if (Number(travInput.value) > selectedVehicle.maxTravelers) travInput.value = String(selectedVehicle.maxTravelers);
        $('veh-hint').textContent = `تم اختيار ${selectedVehicle.name} — ${selectedVehicle.maxTravelers} ركاب بحد أقصى`;
        populateVehModels(vehId);
        render();
      });
    });

    interface Place { name: string; lat: number; lng: number; }
    let fromPlace: Place | null = null;
    let toPlace: Place | null = null;
    let distanceKm = 0, durationMin = 0;
    let distanceToken = 0;

    function loadGoogleMaps(): Promise<void> {
      return new Promise((resolve, reject) => {
        if ((window as any).google?.maps) { resolve(); return; }
        (window as any).__extGmInit = resolve;
        const s = document.createElement('script');
        s.src = `https://maps.googleapis.com/maps/api/js?key=${GMAPS_KEY}&libraries=places&callback=__extGmInit&language=ar&region=EG`;
        s.async = true;
        s.onerror = () => reject(new Error('gmaps_failed'));
        document.head.appendChild(s);
      });
    }

    function setToHint(msg: string, isError = false): void {
      const hint = $('to-hint') as HTMLElement;
      hint.textContent = msg;
      hint.style.color = isError ? '#B91C1C' : 'var(--color-text-faint)';
    }

    function computeDistance(lat: number, lng: number): Promise<{ distanceKm: number; durationMin: number }> {
      return new Promise((resolve, reject) => {
        const G = (window as any).google.maps;
        const svc = new G.DistanceMatrixService();
        svc.getDistanceMatrix({
          origins: [DAMIETTA_ORIGIN],
          destinations: [{ lat, lng }],
          travelMode: 'DRIVING',
        }, (res: any, status: string) => {
          if (status !== 'OK') { reject(new Error(status)); return; }
          const el = res?.rows?.[0]?.elements?.[0];
          if (!el || el.status !== 'OK') { reject(new Error('no_route')); return; }
          resolve({ distanceKm: Math.round(el.distance.value / 1000), durationMin: Math.round(el.duration.value / 60) });
        });
      });
    }

    async function selectDestination(name: string, lat: number, lng: number): Promise<void> {
      const token = ++distanceToken;
      toPlace = null;
      setToHint('جارٍ حساب المسافة من دمياط…');
      render();
      try {
        const { distanceKm: km, durationMin: mins } = await computeDistance(lat, lng);
        if (token !== distanceToken) return;
        toPlace = { name, lat, lng };
        distanceKm = km; durationMin = mins;
        setToHint(`${km} كم من دمياط — ~${mins} دقيقة بالسيارة`);
      } catch {
        if (token !== distanceToken) return;
        setToHint('تعذّر حساب المسافة لهذه الوجهة — جرّب مكاناً آخر أو تأكد من اتصالك بالإنترنت.', true);
      }
      render();
    }

    async function initAutocompletes(): Promise<void> {
      try {
        await loadGoogleMaps();
      } catch {
        setToHint('تعذّر تحميل خرائط جوجل — تحقق من اتصالك بالإنترنت.', true);
        return;
      }
      const G = (window as any).google.maps;

      const damiettaBias = new G.LatLngBounds({ lat: 31.20, lng: 31.50 }, { lat: 31.65, lng: 32.10 });
      const fromAc = new G.places.Autocomplete(document.getElementById('from-area'), {
        bounds: damiettaBias,
        componentRestrictions: { country: 'eg' },
        strictBounds: false,
        types: [],
        fields: ['geometry', 'name', 'formatted_address'],
      });
      fromAc.addListener('place_changed', () => {
        const p = fromAc.getPlace();
        if (!p?.geometry?.location) return;
        fromPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
        render();
      });

      const toAc = new G.places.Autocomplete(document.getElementById('to-area'), {
        componentRestrictions: { country: 'eg' },
        fields: ['geometry', 'name', 'formatted_address'],
      });
      toAc.addListener('place_changed', () => {
        const p = toAc.getPlace();
        if (!p?.geometry?.location) { setToHint('اختر وجهة من نتائج البحث.', true); return; }
        selectDestination(p.name || p.formatted_address, p.geometry.location.lat(), p.geometry.location.lng());
      });
    }
    initAutocompletes();

    (document.getElementById('to-area') as HTMLInputElement).addEventListener('input', () => {
      if (toPlace) { toPlace = null; setToHint('بحث حي بموقع الوجهة الفعلي — المسافة والسعر تُحسب تلقائياً.'); render(); }
    });

    document.getElementById('btn-ext-loc')?.addEventListener('click', () => {
      if (!navigator.geolocation) return;
      const btn = document.getElementById('btn-ext-loc')!;
      btn.textContent = '⏳';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          fromPlace = { name: 'موقعي الحالي', lat: pos.coords.latitude, lng: pos.coords.longitude };
          (document.getElementById('from-area') as HTMLInputElement).value = 'موقعي الحالي';
          btn.textContent = '✅';
          render();
          setTimeout(() => { btn.textContent = '📍'; }, 2000);
        },
        () => { btn.textContent = '📍'; }
      );
    });

    function fare(): number {
      if (!toPlace || !distanceKm) return 0;
      return externalFare(distanceKm, selVehModel, selVehYear);
    }

    function render(): void {
      const fromArea = fromPlace?.name || (document.getElementById('from-area') as HTMLInputElement).value || '';
      $('sum-route').textContent = toPlace ? `${fromArea || 'دمياط'} ← ${toPlace.name}` : 'اختر الوجهة لعرض السعر';
      $('p-distance').textContent = distanceKm ? `${distanceKm} كم` : '—';
      $('p-duration').textContent = durationMin ? `~${durationMin} دقيقة` : '—';
      ($('p-veh-label') as HTMLElement).textContent = 'السيارة';
      $('p-veh').textContent = `${selVehModel.name} ${selVehYear}`;
      const total = fare();
      $('p-total').innerHTML = total ? `${total} <small>ج.م</small>` : '— <small>ج.م</small>';
    }

    form.addEventListener('input', render);
    form.addEventListener('change', render);
    render();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fail = (msg: string) => { errBox.textContent = msg; errBox.classList.add('is-visible'); errBox.scrollIntoView({ block: 'center', behavior: 'smooth' }); };

      if (!toPlace || !distanceKm) return fail('يرجى اختيار وجهة صحيحة خارج محافظة دمياط.');
      const governorate = ($('dest-governorate') as HTMLSelectElement).value;
      if (!governorate) return fail('يرجى اختيار محافظة الوجهة.');
      const name = ($('trav-name') as HTMLInputElement).value.trim();
      const phone = ($('trav-phone') as HTMLInputElement).value.trim();
      if (name.length < 2) return fail('يرجى إدخال الاسم.');
      if (!isEgyptianMobile(phone)) return fail(EG_PHONE_ERROR);
      const pax = Number(($('passengers') as HTMLInputElement).value) || 1;
      if (pax > selectedVehicle.maxTravelers) return fail(`هذه السيارة تتسع لـ ${selectedVehicle.maxTravelers} ركاب فقط.`);
      errBox.classList.remove('is-visible');

      const fromArea = fromPlace?.name || (document.getElementById('from-area') as HTMLInputElement).value || '';
      const total = fare();
      const orderId = 'WSL-' + new Date().getFullYear() + '-' + Math.floor(100000 + Math.random() * 900000);

      const btn = $('ext-submit') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'جارٍ التأكيد…';

      try {
        const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
        const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
        const SB_H = { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY, 'Content-Type': 'application/json', Prefer: 'return=representation' };
        const res = await fetch(SB_URL + '/rest/v1/rides', {
          method: 'POST', headers: SB_H,
          body: JSON.stringify({
            customer_phone: normalizeEgyptianPhone(phone),
            customer_name: name,
            from_area: fromArea,
            from_lat: fromPlace?.lat ?? DAMIETTA_ORIGIN.lat,
            from_lng: fromPlace?.lng ?? DAMIETTA_ORIGIN.lng,
            to_area: toPlace.name,
            to_lat: toPlace.lat,
            to_lng: toPlace.lng,
            distance_km: distanceKm,
            fare: total,
            eta_minutes: durationMin,
            passengers: pax,
            payment: ($('ext-payment') as HTMLSelectElement).value || 'cash',
            governorate,
            vehicle_model: selVehModel.id,
            vehicle_year: selVehYear,
            notes: `رحلة خارجية — عنوان: ${fromArea} — ${(document.getElementById('address') as HTMLTextAreaElement).value.trim()} — سيارة: ${selectedVehicle.name} (${selVehModel.name} ${selVehYear})`,
            status: 'pending',
            ride_type: 'external',
          }),
        });
        if (!res.ok) throw new Error('insert_failed');
        const rows = await res.json();
        const supabaseId = Array.isArray(rows) && rows[0]?.id ? rows[0].id : null;

        try {
          const existing = JSON.parse(localStorage.getItem('wslha_orders') || '[]');
          existing.unshift({
            id: orderId, type: 'رحلة خارجية', icon: '🚗', route: `${fromArea} ← ${toPlace.name}`,
            date: 'الآن', price: `${total} ج.م`, status: 'active', kind: 'ride',
            recipient: name, phone: normalizeEgyptianPhone(phone), createdAt: new Date().toISOString(),
            supabase_id: supabaseId,
          });
          localStorage.setItem('wslha_orders', JSON.stringify(existing));
        } catch { /* storage unavailable */ }

        showExtSuccess(orderId);
      } catch {
        fail('تعذّر تأكيد الحجز — تحقق من اتصالك بالإنترنت وحاول مرة أخرى.');
        btn.disabled = false; btn.textContent = 'تأكيد الحجز ←';
      }
    });

    function showExtSuccess(orderId: string) {
      $('ext-success-id').textContent = orderId;
      ($('ext-success-track') as HTMLAnchorElement).href = `/track?q=${encodeURIComponent(orderId)}`;
      ($('ext-wrap') as HTMLElement).style.display = 'none';
      ($('ext-success') as HTMLElement).classList.add('is-visible');
      $('ext-success').focus();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ── استرجاع الحجز النشط بعد تحديث الصفحة — بدل ما يرجع العميل لفورم
    //    فاضي رغم إن حجزه لسه شغّال في قاعدة البيانات. ──
    async function restoreActiveExternalBooking() {
      let phone: string | null = null;
      try { phone = (JSON.parse(localStorage.getItem('wslha_user') || '{}')).phone || null; } catch {}
      let orders: any[] = [];
      try { orders = JSON.parse(localStorage.getItem('wslha_orders') || '[]'); } catch {}
      const candidate = orders.find((o: any) =>
        o.kind === 'ride' && o.type === 'رحلة خارجية' && o.status === 'active' && o.supabase_id &&
        (!phone || normalizeEgyptianPhone(o.phone || '') === normalizeEgyptianPhone(phone))
      );
      if (!candidate) return;

      try {
        const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
        const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
        const SB_H = { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY };
        const res = await fetch(`${SB_URL}/rest/v1/rides?id=eq.${candidate.supabase_id}&select=status&limit=1`, { headers: SB_H });
        if (!res.ok) return;
        const rows = await res.json();
        const status = Array.isArray(rows) && rows[0] ? rows[0].status : null;
        if (!status || !['pending', 'accepted', 'arrived', 'in_progress'].includes(status)) return;
        showExtSuccess(candidate.id);
      } catch {}
    }
    restoreActiveExternalBooking();

    // Logged-in users don't need to type their name/phone again.
    try {
      const _u = JSON.parse(localStorage.getItem('wslha_user') || 'null');
      if (_u && _u.name && _u.phone) {
        (document.getElementById('trav-name')).value  = _u.name;
        (document.getElementById('trav-phone')).value = _u.phone;
        const row = document.getElementById('trav-contact-row');
        if (row) row.hidden = true;
      }
    } catch {}
  </script>
</Layout>
