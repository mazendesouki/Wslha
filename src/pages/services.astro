---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';

interface Service {
  id: string;
  emoji: string;
  label: string;
  title: string;
  desc: string;
  features: string[];
  cta: string;
  ctaHref: string;
  badge: string;
  badgeLabel: string;
  variant: 'light' | 'tinted';
  // Only 'local' and 'airport' get the real interactive map (it actually
  // shows something meaningful — coverage area / route). Every other card
  // gets a static illustration instead, since a "map" for e.g. "سائق
  // بالساعة" or "عقود الشركات" was never wired up to load anything —
  // it just showed a permanently-stuck loading spinner (see git history).
  illustration?: string;
}

