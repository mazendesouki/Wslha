---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';

interface DeliveryType {
  id: string;
  icon: string;
  title: string;
  desc: string;
  base: number;
  eta: string;
}

const DELIVERY_TYPES: DeliveryType[] = [
  { id: 'local',   icon: '🛵', title: 'توصيل محلي',   desc: 'داخل المدينة خلال 30 دقيقة', base: 25,  eta: '30 دقيقة' },
  { id: 'express', icon: '⚡', title: 'توصيل سريع',   desc: 'أولوية قصوى خلال 15 دقيقة',  base: 45,  eta: '15 دقيقة' },
  { id: 'airport', icon: '✈️', title: 'توصيل المطار', desc: 'من وإلى مطار برج العرب',      base: 150, eta: '90 دقيقة' },
];

const CITIES = ['دمياط الجديدة', 'دمياط', 'كفر سعد', 'فارسكور', 'منية النصر', 'رأس البر', 'الزرقا'];
---

<style>
  .order-wrap {
    padding: var(--sp-12) var(--sp-6) var(--sp-20);
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: var(--sp-8);
    align-items: start;
  }

  /* ── Form ────────────────────────────────────────────────── */
  .order-form {
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--sp-10);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
  }

  .order-form__step-title {
    font-size: var(--text-base);
    font-weight: var(--weight-black);
    margin-bottom: var(--sp-4);
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--color-text);
  }

  .order-error {
    background: #FEE2E2;
    color: #B91C1C;
    border-radius: var(--radius);
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--text-sm);
    margin-top: var(--sp-4);
    display: none;
  }
  .order-error.is-visible { display: block; }

  .order-form__step-num {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: #fff;
    font-size: var(--text-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .order-form__divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--sp-8) 0;
  }

  /* Delivery type options */
  .type-options {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .type-option {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: border-color var(--ease), background var(--ease);
  }

  .type-option:hover { border-color: var(--color-primary); }

  .type-option:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .type-option:has(input:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .type-option input { position: absolute; opacity: 0; pointer-events: none; }

  .type-option__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xl);
    flex-shrink: 0;
  }

  .type-option__title { font-weight: var(--weight-black); font-size: var(--text-sm); }
  .type-option__desc  { font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 2px; }
  .type-option__price { margin-right: auto; font-weight: var(--weight-black); color: var(--color-primary); font-size: var(--text-base); white-space: nowrap; }

  /* Fields */
  .order-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
  }

  .field { margin-bottom: var(--sp-4); }
  .field:last-child { margin-bottom: 0; }

  .field__label {
    display: block;
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    margin-bottom: var(--sp-2);
    color: #374151;
  }

  .field__input,
  .field__select,
  .field__textarea {
    width: 100%;
    padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--text-base);
    outline: none;
    transition: border-color var(--ease);
    direction: rtl;
    color: var(--color-text);
    background: var(--color-bg);
  }

  .field__input:focus,
  .field__select:focus,
  .field__textarea:focus { border-color: var(--color-primary); }

  .field__input::placeholder,
  .field__textarea::placeholder { color: var(--color-text-faint); }

  .field__textarea { resize: vertical; min-height: 80px; }

  /* ── Summary (sticky) ────────────────────────────────────── */
  .summary {
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--sp-8);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    position: sticky;
    top: calc(var(--nav-height) + var(--sp-4));
  }

  .summary__title { font-size: var(--text-lg); font-weight: var(--weight-black); margin-bottom: var(--sp-6); }

  .summary__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--color-bg-soft);
    font-size: var(--text-sm);
  }

  .summary__row span:first-child { color: var(--color-text-muted); }
  .summary__row span:last-child  { font-weight: var(--weight-bold); color: var(--color-text); }

  .summary__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: 2px solid var(--color-border);
  }

  .summary__total-label { font-weight: var(--weight-black); font-size: var(--text-base); }
  .summary__total-value { font-weight: var(--weight-black); font-size: var(--text-3xl); color: var(--color-primary); line-height: 1; }
  .summary__total-value small { font-size: var(--text-sm); font-weight: var(--weight-semi); color: var(--color-text-faint); }

  .summary__submit {
    width: 100%;
    margin-top: var(--sp-6);
    padding: var(--sp-4);
    background: var(--color-accent);
    color: var(--color-text);
    border: none;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-weight: var(--weight-black);
    font-size: var(--text-base);
    cursor: pointer;
    transition: background var(--ease), transform var(--ease);
  }

  .summary__submit:hover         { background: var(--color-accent-dark); transform: translateY(-1px); }
  .summary__submit:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 3px; }
  .summary__submit:disabled      { opacity: 0.6; cursor: not-allowed; transform: none; }

  .summary__note {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    text-align: center;
    margin-top: var(--sp-3);
  }

  /* ── WhatsApp button ─────────────────────────────────────── */
  .summary__whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    width: 100%;
    margin-top: var(--sp-3);
    padding: var(--sp-3);
    background: #25D366;
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    cursor: pointer;
    text-decoration: none;
    transition: background var(--ease);
  }
  .summary__whatsapp:hover { background: #1EB856; }

  /* ── Success state ───────────────────────────────────────── */
  .order-success {
    display: none;
    text-align: center;
    padding: var(--sp-16) var(--sp-6);
    max-width: 520px;
    margin: 0 auto;
  }

  .order-success.is-visible { display: block; }

  .order-success__icon {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    margin: 0 auto var(--sp-6);
  }

  .order-success__title { font-size: var(--text-2xl); font-weight: var(--weight-black); margin-bottom: var(--sp-3); }
  .order-success__desc  { color: var(--color-text-muted); margin-bottom: var(--sp-2); }
  .order-success__id    { font-weight: var(--weight-black); color: var(--color-primary); font-size: var(--text-lg); margin-bottom: var(--sp-8); }
  .order-success__actions { display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .order-wrap      { grid-template-columns: 1fr; }
    .summary         { position: static; }
    .order-form      { padding: var(--sp-6); }
    .order-form__row { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { isEgyptianMobile, normalizeEgyptianPhone, EG_PHONE_ERROR } from '../utils/phone';

  interface Rates { [key: string]: number; }

  const BASE_RATES: Rates = { local: 25, express: 45, airport: 150 };
  const CROSS_CITY_FEE = 20;

  const form      = document.getElementById('order-form')    as HTMLFormElement;
  const orderError = document.getElementById('order-error')  as HTMLElement;
  const wrap      = document.getElementById('order-wrap')    as HTMLElement;
  const success   = document.getElementById('order-success') as HTMLElement;
  const successId = document.getElementById('success-id')    as HTMLElement;
  const fromCity  = document.getElementById('from-city')     as HTMLSelectElement;
  const toCity    = document.getElementById('to-city')       as HTMLSelectElement;
  const sumType   = document.getElementById('sum-type')      as HTMLElement;
  const sumEta    = document.getElementById('sum-eta')       as HTMLElement;
  const sumRoute  = document.getElementById('sum-route')     as HTMLElement;
  const sumBase   = document.getElementById('sum-base')      as HTMLElement;
  const sumCross  = document.getElementById('sum-cross-row') as HTMLElement;
  const sumTotal  = document.getElementById('sum-total')     as HTMLElement;
  const submitBtn = document.getElementById('order-submit')  as HTMLButtonElement;
  const waBtn     = document.getElementById('whatsapp-btn')  as HTMLAnchorElement;

  const TYPE_META: Record<string, { label: string; eta: string }> = {
    local:   { label: 'توصيل محلي',   eta: '30 دقيقة' },
    express: { label: 'توصيل سريع',   eta: '15 دقيقة' },
    airport: { label: 'توصيل المطار', eta: '90 دقيقة' },
  };

  function selectedType(): string {
    const checked = form.querySelector<HTMLInputElement>('input[name="delivery-type"]:checked');
    return checked ? checked.value : 'local';
  }

  function recalc(): void {
    const type      = selectedType();
    const base      = BASE_RATES[type];
    const meta      = TYPE_META[type];
    const crossCity = fromCity.value && toCity.value && fromCity.value !== toCity.value;
    const total     = base + (crossCity ? CROSS_CITY_FEE : 0);

    sumType.textContent  = meta.label;
    sumEta.textContent   = meta.eta;
    sumRoute.textContent = fromCity.value && toCity.value ? `${fromCity.value} ← ${toCity.value}` : '—';
    sumBase.textContent  = `${base} ج.م`;
    sumCross.style.display = crossCity ? 'flex' : 'none';
    sumTotal.innerHTML   = `${total} <small>ج.م</small>`;

    // Build WhatsApp message
    const address   = (document.getElementById('address')   as HTMLTextAreaElement).value;
    const recipient = (document.getElementById('recipient') as HTMLInputElement).value;
    const phone     = (document.getElementById('phone')     as HTMLInputElement).value;
    const msg = `طلب توصيل جديد - وصّلها 🛵\n\nالنوع: ${meta.label}\nالمسار: ${fromCity.value || '—'} ← ${toCity.value || '—'}\nالعنوان: ${address || '—'}\nالمستلم: ${recipient || '—'}\nجوال: ${phone || '—'}\nالإجمالي: ${total} ج.م`;
    waBtn.href = `https://wa.me/201000000000?text=${encodeURIComponent(msg)}`;
  }

  form.addEventListener('change', recalc);
  form.addEventListener('input', recalc);

  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();

    const phoneVal = (document.getElementById('phone') as HTMLInputElement).value;
    if (!isEgyptianMobile(phoneVal)) {
      orderError.textContent = EG_PHONE_ERROR;
      orderError.classList.add('is-visible');
      (document.getElementById('phone') as HTMLInputElement).focus();
      return;
    }
    orderError.classList.remove('is-visible');

    submitBtn.disabled = true;
    submitBtn.textContent = 'جاري التأكيد...';

    await new Promise(resolve => setTimeout(resolve, 900));

    const type      = selectedType();
    const meta      = TYPE_META[type];
    const base      = BASE_RATES[type];
    const crossCity = fromCity.value && toCity.value && fromCity.value !== toCity.value;
    const total     = base + (crossCity ? CROSS_CITY_FEE : 0);
    const orderId   = 'WSL-' + new Date().getFullYear() + '-' + Math.floor(100000 + Math.random() * 900000);

    const address   = (document.getElementById('address')   as HTMLTextAreaElement).value;
    const recipient = (document.getElementById('recipient') as HTMLInputElement).value;
    const phone     = (document.getElementById('phone')     as HTMLInputElement).value;
    const notes     = (document.getElementById('notes')     as HTMLInputElement).value;

    const order = {
      id:        orderId,
      type:      meta.label,
      icon:      type === 'local' ? '🛵' : type === 'express' ? '⚡' : '✈️',
      route:     `${fromCity.value} → ${toCity.value}`,
      date:      'الآن',
      price:     `${total} ج.م`,
      status:    'active',
      address,
      recipient,
      phone: normalizeEgyptianPhone(phone),
      notes,
      createdAt: new Date().toISOString(),
    };

    try {
      const existing = JSON.parse(localStorage.getItem('wslha_orders') || '[]');
      existing.unshift(order);
      localStorage.setItem('wslha_orders', JSON.stringify(existing));
    } catch { /* storage unavailable */ }

    successId.textContent = orderId;
    wrap.style.display = 'none';
    success.classList.add('is-visible');
    success.focus();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  recalc();
</script>

<Layout
  title="طلب توصيل"
  description="اطلب خدمة توصيل من وصّلها — احسب السعر فوراً وأكّد طلبك في دقائق"
  page="order"
>
  <PageHero
    badge="🛵 طلب جديد"
    title="اطلب توصيلتك"
    subtitle="املأ التفاصيل واحسب السعر فوراً — التوصيل في الطريق"
  />

  <div class="order-wrap" id="order-wrap">

    <!-- Form -->
    <form class="order-form" id="order-form">

      <!-- Step 1: type -->
      <h2 class="order-form__step-title">
        <span class="order-form__step-num" aria-hidden="true">1</span>
        نوع التوصيل
      </h2>
      <fieldset class="type-options" style="border:none; padding:0; margin:0;">
        <legend class="sr-only">اختر نوع التوصيل</legend>
        {DELIVERY_TYPES.map((t, i) => (
          <label class="type-option">
            <input type="radio" name="delivery-type" value={t.id} checked={i === 0} required>
            <span class="type-option__icon" aria-hidden="true">{t.icon}</span>
            <span>
              <span class="type-option__title">{t.title}</span>
              <span class="type-option__desc">{t.desc}</span>
            </span>
            <span class="type-option__price">{t.base} ج.م</span>
          </label>
        ))}
      </fieldset>

      <hr class="order-form__divider">

      <!-- Step 2: route -->
      <h2 class="order-form__step-title">
        <span class="order-form__step-num" aria-hidden="true">2</span>
        المسار
      </h2>
      <div class="order-form__row">
        <div class="field">
          <label class="field__label" for="from-city">من منطقة</label>
          <select class="field__select" id="from-city" required>
            <option value="" disabled selected>اختر</option>
            {CITIES.map(c => <option value={c} selected={c === 'دمياط الجديدة'}>{c}</option>)}
          </select>
        </div>
        <div class="field">
          <label class="field__label" for="to-city">إلى منطقة</label>
          <select class="field__select" id="to-city" required>
            <option value="" disabled selected>اختر</option>
            {CITIES.map(c => <option value={c}>{c}</option>)}
          </select>
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="address">عنوان التسليم بالتفصيل</label>
        <textarea class="field__textarea" id="address" placeholder="الحي، الشارع، رقم المبنى، علامة مميزة..." required></textarea>
      </div>

      <hr class="order-form__divider">

      <!-- Step 3: contact -->
      <h2 class="order-form__step-title">
        <span class="order-form__step-num" aria-hidden="true">3</span>
        بيانات المستلم
      </h2>
      <div class="order-form__row">
        <div class="field">
          <label class="field__label" for="recipient">اسم المستلم</label>
          <input class="field__input" type="text" id="recipient" placeholder="محمد أحمد" required autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="phone">رقم الجوال</label>
          <input class="field__input" type="tel" id="phone" placeholder="010 1234 5678" inputmode="numeric" maxlength="11" pattern="01[0125][0-9]{8}" required autocomplete="tel">
        </div>
      </div>
      <div id="order-error" class="order-error" role="alert" aria-live="polite"></div>
      <div class="field">
        <label class="field__label" for="notes">ملاحظات إضافية (اختياري)</label>
        <input class="field__input" type="text" id="notes" placeholder="مثال: اتصل قبل الوصول">
      </div>
    </form>

    <!-- Summary -->
    <aside class="summary" aria-label="ملخص الطلب">
      <h2 class="summary__title">ملخص الطلب</h2>
      <div class="summary__row"><span>نوع التوصيل</span><span id="sum-type">توصيل محلي</span></div>
      <div class="summary__row"><span>وقت التوصيل</span><span id="sum-eta">30 دقيقة</span></div>
      <div class="summary__row"><span>المسار</span><span id="sum-route">—</span></div>
      <div class="summary__row"><span>سعر التوصيل</span><span id="sum-base">25 ج.م</span></div>
      <div class="summary__row" id="sum-cross-row" style="display:none;"><span>رسوم بين المناطق</span><span>20 ج.م</span></div>

      <div class="summary__total">
        <span class="summary__total-label">الإجمالي</span>
        <span class="summary__total-value" id="sum-total">25 <small>ج.م</small></span>
      </div>

      <button type="submit" form="order-form" class="summary__submit" id="order-submit">
        تأكيد الطلب ←
      </button>
      <a href="#" class="summary__whatsapp" id="whatsapp-btn" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        إرسال عبر واتساب
      </a>
      <p class="summary__note">الدفع عند الاستلام أو إلكترونياً</p>
    </aside>

  </div>

  <!-- Success -->
  <section
    class="order-success"
    id="order-success"
    role="alert"
    aria-live="polite"
    tabindex="-1"
  >
    <div class="order-success__icon" aria-hidden="true">✅</div>
    <h2 class="order-success__title">تم استلام طلبك!</h2>
    <p class="order-success__desc">سيتواصل معك المندوب قريباً. يمكنك تتبع طلبك برقم:</p>
    <p class="order-success__id" id="success-id">—</p>
    <div class="order-success__actions">
      <a href="/track" class="btn btn--primary">📡 تتبع الطلب</a>
      <a href="/orders" class="btn btn--outline">طلباتي</a>
    </div>
  </section>
</Layout>
