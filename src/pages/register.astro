---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';

const CITIES = ['دمياط الجديدة', 'دمياط', 'كفر سعد', 'فارسكور', 'منية النصر', 'رأس البر', 'الزرقا'];
---

<style>
  .auth-section {
    padding: var(--sp-10) var(--sp-6) var(--sp-20);
    display: flex; justify-content: center;
  }
  .auth-card {
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--sp-10);
    width: 100%; max-width: 460px;
    box-shadow: var(--shadow-md);
  }
  .auth-card__title { font-size: var(--text-2xl); font-weight: var(--weight-black); margin-bottom: var(--sp-2); }
  .auth-card__sub   { font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--sp-6); }

  /* Steps progress */
  .progress-bar {
    display: flex; gap: var(--sp-2); margin-bottom: var(--sp-7);
  }
  .progress-step {
    flex: 1; height: 4px; border-radius: 99px;
    background: var(--color-border); transition: background 0.3s;
  }
  .progress-step.done   { background: #16a34a; }
  .progress-step.active { background: var(--color-primary); }

  /* Fields */
  .field { margin-bottom: var(--sp-4); }
  .field__label {
    display: flex; align-items: center; justify-content: space-between;
    font-weight: var(--weight-bold); font-size: var(--text-sm);
    margin-bottom: var(--sp-2); color: var(--color-text);
  }
  .field__avail {
    font-size: 11px; font-weight: var(--weight-bold);
    transition: color 0.2s; opacity: 0;
  }
  .field__avail.checking { color: var(--color-text-faint); opacity: 1; }
  .field__avail.ok       { color: #16a34a; opacity: 1; }
  .field__avail.taken    { color: #dc2626; opacity: 1; }

  .field__wrap { position: relative; }
  .field__input,
  .field__select {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border); border-radius: var(--radius);
    font-family: var(--font-body); font-size: var(--text-base);
    outline: none; transition: border-color var(--ease), box-shadow var(--ease);
    direction: rtl; color: var(--color-text); background: var(--color-bg);
  }
  .field__input:focus,
  .field__select:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(59,130,246,.12); }
  .field__input::placeholder { color: var(--color-text-faint); }
  .field__input.ok     { border-color: #16a34a; }
  .field__input.taken  { border-color: #ef4444; }
  .field__input.error  { border-color: #ef4444; }

  /* Password rules */
  .pw-rules { list-style: none; margin: var(--sp-2) 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .pw-rule  { font-size: 0.75rem; color: var(--color-text-muted); transition: color 0.15s; padding: 1px 0; }
  .pw-rule.ok  { color: #16a34a; }
  .pw-rule.bad { color: #dc2626; }

  /* Match indicator */
  .match-row { font-size: 0.75rem; margin-top: var(--sp-1); height: 16px; }
  .match-ok   { color: #16a34a; }
  .match-no   { color: #dc2626; }

  /* Error / success banners */
  .auth-error {
    background: #fef2f2; color: #b91c1c;
    border: 1px solid #fca5a5; border-radius: var(--radius);
    padding: var(--sp-3) var(--sp-4); font-size: var(--text-sm);
    margin-bottom: var(--sp-4); display: none;
  }
  .auth-error.is-visible { display: block; }

  /* Submit */
  .auth-submit {
    width: 100%; padding: var(--sp-4);
    background: var(--color-primary); color: #fff;
    border: none; border-radius: var(--radius);
    font-family: var(--font-body); font-weight: var(--weight-black);
    font-size: var(--text-base); cursor: pointer;
    transition: background var(--ease), transform var(--ease);
    margin-top: var(--sp-2); margin-bottom: var(--sp-4);
  }
  .auth-submit:hover:not(:disabled) { background: var(--color-primary-dark); transform: translateY(-1px); }
  .auth-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  /* Divider */
  .auth-divider {
    display: flex; align-items: center; gap: var(--sp-3);
    margin: var(--sp-5) 0; color: var(--color-text-faint); font-size: var(--text-sm);
  }
  .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: var(--color-border); }

  .auth-actions { display: flex; flex-direction: column; gap: var(--sp-3); }
  .auth-actions .btn { width: 100%; justify-content: center; text-align: center; }
  .auth-footer { margin-top: var(--sp-5); text-align: center; font-size: var(--text-sm); color: var(--color-text-muted); }
  .auth-footer a { color: var(--color-primary); font-weight: var(--weight-bold); }

  @media (max-width: 460px) {
    .auth-card { padding: var(--sp-6); }
    .pw-rules  { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { isEgyptianMobile, normalizeEgyptianPhone, EG_PHONE_ERROR } from '../utils/phone';
  import { validatePassword }    from '../utils/password';
  import { addAccount, fieldExists } from '../utils/accounts';

  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';

  const form      = document.getElementById('register-form')   as HTMLFormElement;
  const errorBox  = document.getElementById('register-error')  as HTMLElement;
  const submitBtn = document.getElementById('register-submit') as HTMLButtonElement;

  const nameInp  = document.getElementById('reg-name')     as HTMLInputElement;
  const userInp  = document.getElementById('reg-username') as HTMLInputElement;
  const phoneInp = document.getElementById('reg-phone')    as HTMLInputElement;
  const emailInp = document.getElementById('reg-email')    as HTMLInputElement;
  const cityInp  = document.getElementById('reg-city')     as HTMLSelectElement;
  const passInp  = document.getElementById('reg-pass')     as HTMLInputElement;
  const pass2Inp = document.getElementById('reg-pass2')    as HTMLInputElement;

  const userAvail  = document.getElementById('user-avail')  as HTMLElement;
  const phoneAvail = document.getElementById('phone-avail') as HTMLElement;
  const emailAvail = document.getElementById('email-avail') as HTMLElement;

  // ── Password rules ──
  const ruleLen = document.getElementById('rule-len')!;
  const ruleUp  = document.getElementById('rule-up')!;
  const ruleLow = document.getElementById('rule-low')!;
  const ruleDig = document.getElementById('rule-dig')!;
  const ruleSym = document.getElementById('rule-sym')!;
  const matchEl = document.getElementById('pass-match')!;

  function setRule(el: HTMLElement, ok: boolean) {
    const label = el.textContent!.replace(/^[✓✗] /, '');
    el.textContent = (ok ? '✓ ' : '✗ ') + label;
    el.className = 'pw-rule ' + (ok ? 'ok' : 'bad');
  }
  passInp.addEventListener('input', () => {
    const v = passInp.value;
    setRule(ruleLen, v.length >= 8);
    setRule(ruleUp,  /[A-Z]/.test(v));
    setRule(ruleLow, /[a-z]/.test(v));
    setRule(ruleDig, /[0-9]/.test(v));
    setRule(ruleSym, v.length > 0 && /^[A-Za-z0-9]+$/.test(v));
    checkMatch();
  });
  pass2Inp.addEventListener('input', checkMatch);
  function checkMatch() {
    if (!pass2Inp.value) { matchEl.textContent = ''; matchEl.className = 'match-row'; return; }
    const ok = pass2Inp.value === passInp.value;
    matchEl.textContent  = ok ? '✓ كلمتا المرور متطابقتان' : '✗ كلمتا المرور غير متطابقتين';
    matchEl.className = 'match-row ' + (ok ? 'match-ok' : 'match-no');
  }

  // ── Real-time uniqueness checking (debounced) ──
  type AvailState = 'idle' | 'checking' | 'ok' | 'taken' | 'error';

  const fieldState: Record<string, AvailState> = {
    username: 'idle', phone: 'idle', email: 'idle',
  };

  function setAvail(el: HTMLElement, inp: HTMLInputElement, state: AvailState, msg = '') {
    el.className = 'field__avail ' + (state === 'idle' ? '' : state);
    el.textContent = msg;
    inp.classList.remove('ok', 'taken');
    if (state === 'ok')    inp.classList.add('ok');
    if (state === 'taken') inp.classList.add('taken');
  }

  function debounce<T extends (...args: any[]) => void>(fn: T, ms: number): T {
    let t: ReturnType<typeof setTimeout>;
    return ((...args: any[]) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); }) as T;
  }

  const checkUsername = debounce(async () => {
    const v = userInp.value.trim();
    if (!v || v.length < 3) { setAvail(userAvail, userInp, 'idle', ''); fieldState.username = 'idle'; return; }
    if (!/^[a-zA-Z0-9_\.]{3,20}$/.test(v)) {
      setAvail(userAvail, userInp, 'taken', '✗ أحرف غير مسموح بها');
      fieldState.username = 'taken'; return;
    }
    setAvail(userAvail, userInp, 'checking', 'جاري الفحص...');
    fieldState.username = 'checking';
    const exists = await fieldExists('username', v);
    if (exists === true)  { setAvail(userAvail, userInp, 'taken', '✗ اسم المستخدم محجوز'); fieldState.username = 'taken'; }
    else if (exists === false) { setAvail(userAvail, userInp, 'ok', '✓ متاح'); fieldState.username = 'ok'; }
    else { setAvail(userAvail, userInp, 'idle', ''); fieldState.username = 'idle'; }
  }, 600);

  const checkPhone = debounce(async () => {
    const v = phoneInp.value.trim();
    if (!v) { setAvail(phoneAvail, phoneInp, 'idle', ''); fieldState.phone = 'idle'; return; }
    if (!isEgyptianMobile(v)) { setAvail(phoneAvail, phoneInp, 'taken', '✗ رقم غير صحيح'); fieldState.phone = 'taken'; return; }
    setAvail(phoneAvail, phoneInp, 'checking', 'جاري الفحص...');
    fieldState.phone = 'checking';
    const norm = normalizeEgyptianPhone(v);
    const exists = await fieldExists('phone', norm);
    if (exists === true)  { setAvail(phoneAvail, phoneInp, 'taken', '✗ مسجّل بالفعل — <a href="/login" style="color:inherit">تسجيل دخول</a>'); fieldState.phone = 'taken'; }
    else if (exists === false) { setAvail(phoneAvail, phoneInp, 'ok', '✓ رقم جديد'); fieldState.phone = 'ok'; }
    else { setAvail(phoneAvail, phoneInp, 'idle', ''); fieldState.phone = 'idle'; }
  }, 600);

  const checkEmail = debounce(async () => {
    const v = emailInp.value.trim();
    if (!v) { setAvail(emailAvail, emailInp, 'idle', ''); fieldState.email = 'idle'; return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
      setAvail(emailAvail, emailInp, 'taken', '✗ صيغة البريد غير صحيحة');
      fieldState.email = 'taken'; return;
    }
    setAvail(emailAvail, emailInp, 'checking', 'جاري الفحص...');
    fieldState.email = 'checking';
    const exists = await fieldExists('email', v.toLowerCase());
    if (exists === true)  { setAvail(emailAvail, emailInp, 'taken', '✗ بريد مسجّل مسبقاً'); fieldState.email = 'taken'; }
    else if (exists === false) { setAvail(emailAvail, emailInp, 'ok', '✓ متاح'); fieldState.email = 'ok'; }
    else { setAvail(emailAvail, emailInp, 'idle', ''); fieldState.email = 'idle'; }
  }, 600);

  userInp.addEventListener('input',  checkUsername);
  phoneInp.addEventListener('input', checkPhone);
  emailInp.addEventListener('input', checkEmail);

  // ── Error helper ──
  function showError(msg: string) {
    errorBox.innerHTML = msg;
    errorBox.classList.add('is-visible');
    submitBtn.disabled    = false;
    submitBtn.textContent = 'إنشاء الحساب ←';
    errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ── Submit ──
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.remove('is-visible');
    submitBtn.disabled    = true;
    submitBtn.textContent = 'جاري إنشاء الحساب...';

    const name     = nameInp.value.trim();
    const username = userInp.value.trim();
    const phone    = phoneInp.value.trim();
    const email    = emailInp.value.trim().toLowerCase();
    const city     = cityInp.value;
    const pass     = passInp.value;
    const pass2    = pass2Inp.value;

    // ── Client-side validation ──
    if (name.length < 2)        { showError('يرجى إدخال الاسم بالكامل (حرفين على الأقل).'); return; }
    if (!username || username.length < 3) { showError('اسم المستخدم يجب أن يكون 3 أحرف على الأقل.'); return; }
    if (!/^[a-zA-Z0-9_\.]{3,20}$/.test(username)) { showError('اسم المستخدم: أحرف إنجليزية وأرقام و _ . فقط (3-20 حرف).'); return; }
    if (!isEgyptianMobile(phone)) { showError(EG_PHONE_ERROR); return; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError('يرجى إدخال بريد إلكتروني صحيح.'); return; }
    if (!city)  { showError('يرجى اختيار المدينة.'); return; }
    const pwResult = validatePassword(pass);
    if (!pwResult.valid) { showError(pwResult.message); return; }
    if (pass !== pass2) { showError('كلمتا المرور غير متطابقتين.'); return; }

    // ── Block if any field already known to be taken ──
    if (fieldState.username === 'taken') { showError('اسم المستخدم محجوز، اختر اسماً آخر.'); return; }
    if (fieldState.phone    === 'taken') { showError('هذا الرقم مسجّل بالفعل. <a href="/login">سجّل الدخول</a> مباشرة.'); return; }
    if (fieldState.email    === 'taken') { showError('هذا البريد الإلكتروني مسجّل بالفعل.'); return; }

    // ── Final server-side uniqueness check before insert ──
    const norm = normalizeEgyptianPhone(phone);
    const [phoneExists, emailExists, userExists] = await Promise.all([
      fieldExists('phone',    norm),
      fieldExists('email',    email),
      fieldExists('username', username),
    ]);

    if (phoneExists === true)  { showError('هذا الرقم مسجّل بالفعل. <a href="/login">سجّل الدخول</a> مباشرة.'); return; }
    if (emailExists === true)  { showError('هذا البريد الإلكتروني مسجّل في النظام.'); return; }
    if (userExists  === true)  { showError('اسم المستخدم محجوز، جرّب اسماً آخر.'); return; }

    // ── Create account ──
    const created = await addAccount({
      name, username, phone: norm, email, password: pass,
      role: 'customer', city,
      createdAt: new Date().toISOString(),
    });

    if (!created) {
      showError('حدث تعارض أثناء الإنشاء — قد يكون أحد البيانات مسجّلاً بالفعل.');
      return;
    }

    try {
      // Clear old user's orders if a different user was previously logged in
      const prevRaw = localStorage.getItem('wslha_user');
      const prevUser = prevRaw ? JSON.parse(prevRaw) : null;
      if (prevUser?.phone && prevUser.phone !== norm) {
        localStorage.removeItem('wslha_orders_' + prevUser.phone);
        localStorage.removeItem('wslha_orders');
      }

      localStorage.setItem('wslha_user', JSON.stringify({
        name, username, phone: norm, email, city,
        role: 'customer',
        createdAt: new Date().toISOString(),
        loginAt:   new Date().toISOString(),
      }));
    } catch {}

    submitBtn.textContent = '✅ تم الإنشاء، جاري التحويل...';
    setTimeout(() => { window.location.href = '/orders'; }, 700);
  });
</script>

<Layout title="حساب جديد | وصّلها" description="أنشئ حساب عميل جديد في وصّلها" page="register">
  <PageHero
    badge="✨ حساب جديد"
    title="إنشاء حساب عميل"
    subtitle="سجّل بياناتك لتبدأ بطلب التوصيل ومتابعة طلباتك"
  />

  <section class="auth-section">
    <div class="auth-card">
      <h2 class="auth-card__title">انضم إلى وصّلها 🎉</h2>
      <p class="auth-card__sub">أنشئ حسابك في دقيقة واحدة — بياناتك آمنة ومشفّرة</p>

      <div class="progress-bar">
        <div class="progress-step active"></div>
        <div class="progress-step active"></div>
        <div class="progress-step active"></div>
      </div>

      <form id="register-form" novalidate>
        <div id="register-error" class="auth-error" role="alert" aria-live="polite"></div>

        <!-- Name -->
        <div class="field">
          <label class="field__label" for="reg-name">الاسم بالكامل</label>
          <div class="field__wrap">
            <input class="field__input" type="text" id="reg-name"
              placeholder="مثال: أحمد محمد علي" required autocomplete="name">
          </div>
        </div>

        <!-- Username -->
        <div class="field">
          <label class="field__label" for="reg-username">
            اسم المستخدم
            <span id="user-avail" class="field__avail"></span>
          </label>
          <div class="field__wrap">
            <input class="field__input" type="text" id="reg-username"
              placeholder="مثال: ahmed_2026" required autocomplete="username"
              minlength="3" maxlength="20" dir="ltr">
          </div>
          <div style="font-size:11px;color:var(--color-text-faint);margin-top:4px;">أحرف إنجليزية وأرقام و _ . فقط (3-20 حرف)</div>
        </div>

        <!-- Phone -->
        <div class="field">
          <label class="field__label" for="reg-phone">
            رقم الجوال
            <span id="phone-avail" class="field__avail"></span>
          </label>
          <div class="field__wrap">
            <input class="field__input" type="tel" id="reg-phone"
              placeholder="010 1234 5678" inputmode="numeric"
              maxlength="11" pattern="01[0125][0-9]{8}" required autocomplete="tel">
          </div>
        </div>

        <!-- Email -->
        <div class="field">
          <label class="field__label" for="reg-email">
            البريد الإلكتروني
            <span id="email-avail" class="field__avail"></span>
          </label>
          <div class="field__wrap">
            <input class="field__input" type="email" id="reg-email"
              placeholder="example@gmail.com" required autocomplete="email" dir="ltr">
          </div>
        </div>

        <!-- City -->
        <div class="field">
          <label class="field__label" for="reg-city">المدينة</label>
          <select class="field__select" id="reg-city" required>
            <option value="">اختر مدينتك</option>
            {CITIES.map(c => <option value={c}>{c}</option>)}
          </select>
        </div>

        <!-- Password -->
        <div class="field">
          <label class="field__label" for="reg-pass">كلمة المرور</label>
          <input class="field__input" type="password" id="reg-pass"
            placeholder="••••••••" required autocomplete="new-password">
          <ul class="pw-rules" aria-live="polite">
            <li id="rule-len" class="pw-rule">✗ 8 أحرف على الأقل</li>
            <li id="rule-up"  class="pw-rule">✗ حرف كبير (A-Z)</li>
            <li id="rule-low" class="pw-rule">✗ حرف صغير (a-z)</li>
            <li id="rule-dig" class="pw-rule">✗ رقم واحد</li>
            <li id="rule-sym" class="pw-rule">✗ بدون رموز أو مسافات</li>
          </ul>
        </div>

        <!-- Confirm Password -->
        <div class="field">
          <label class="field__label" for="reg-pass2">تأكيد كلمة المرور</label>
          <input class="field__input" type="password" id="reg-pass2"
            placeholder="••••••••" required autocomplete="new-password">
          <div id="pass-match" class="match-row"></div>
        </div>

        <button type="submit" class="auth-submit" id="register-submit">إنشاء الحساب ←</button>
      </form>

      <div class="auth-divider"><span>أو</span></div>
      <div class="auth-actions">
        <a href="/login" class="btn btn--outline">لديك حساب؟ سجّل الدخول</a>
        <a href="/driver" class="btn btn--accent">🚗 حساب سائق جديد</a>
      </div>
      <p class="auth-footer">بإنشائك الحساب فأنت توافق على <a href="/about">شروط الخدمة</a></p>
    </div>
  </section>
</Layout>
