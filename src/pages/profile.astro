<script is:inline>
(function () {
  /* ── Constants ─────────────────────────────────────────────── */
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H   = { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY };

  const STATUS_AR = {
    pending:     'قيد الانتظار',
    preparing:   'قيد التحضير',
    on_the_way:  'في الطريق',
    delivered:   'تم التسليم',
    rejected:    'مرفوض',
    cancelled:   'ملغي',
    accepted:    'تم القبول',
    in_progress: 'جارية',
    completed:   'مكتملة',
    active:      'نشط',
  };
  const STATUS_CLASS = {
    pending:     'status--pending',
    preparing:   'status--preparing',
    on_the_way:  'status--active',
    delivered:   'status--delivered',
    rejected:    'status--cancelled',
    cancelled:   'status--cancelled',
    accepted:    'status--active',
    in_progress: 'status--active',
    completed:   'status--completed',
    active:      'status--active',
  };
  const MONTHS_AR = ['يناير','فبراير','مارس','أبريل','مايو','يونيو',
                     'يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];

  /* ── Helpers ───────────────────────────────────────────────── */
  function fmt(n) { return Number(n || 0).toLocaleString('ar-EG'); }
  function fmtDate(iso) {
    if (!iso) return '—';
    const d = new Date(iso);
    return d.toLocaleDateString('ar-EG', { year:'numeric', month:'long', day:'numeric' });
  }
  function fmtDateTime(iso) {
    if (!iso) return '—';
    const d = new Date(iso);
    return d.toLocaleDateString('ar-EG', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' });
  }
  function initials(name) {
    if (!name) return 'م';
    const parts = name.trim().split(/\s+/);
    return parts.length >= 2
      ? parts[0][0] + parts[1][0]
      : parts[0].slice(0, 2);
  }
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('is-visible');
    setTimeout(() => t.classList.remove('is-visible'), 3000);
  }
  function $(id) { return document.getElementById(id); }

  /* ── Auth guard ────────────────────────────────────────────── */
  let user;
  try {
    const raw = localStorage.getItem('wslha_user');
    user = raw ? JSON.parse(raw) : null;
  } catch { user = null; }
  if (!user || !user.phone) {
    window.location.href = '/login?next=/profile';
    return;
  }

  /* ── State ─────────────────────────────────────────────────── */
  let allOrders = [];
  let allRides  = [];
  let currentOrderFilter = 'all';

  /* ── Supabase fetchers (4 s timeout each) ─────────────────── */
  function sbFetch(url) {
    const ctrl = new AbortController();
    const tid  = setTimeout(() => ctrl.abort(), 4000);
    return fetch(url, { headers: SB_H, signal: ctrl.signal })
      .then(r => { clearTimeout(tid); return r.ok ? r.json() : null; })
      .catch(() => null);
  }
  async function fetchOrders(phone) {
    const data = await sbFetch(
      SB_URL + '/rest/v1/orders?customer_phone=eq.' + encodeURIComponent(phone) +
      '&order=created_at.desc&limit=100');
    return Array.isArray(data) ? data : [];
  }
  async function fetchRides(phone) {
    const data = await sbFetch(
      SB_URL + '/rest/v1/rides?customer_phone=eq.' + encodeURIComponent(phone) +
      '&order=created_at.desc&limit=100');
    return Array.isArray(data) ? data : [];
  }
  function localPhone(phone) {
    return phone.startsWith('+20') ? '0' + phone.slice(3) : phone;
  }
  function intlPhone(phone) {
    return phone.startsWith('0') ? '+20' + phone.slice(1) : phone;
  }
  function phoneOrFilter(phone) {
    const intl  = intlPhone(phone);
    const local = localPhone(phone);
    return 'or=(phone.eq.' + encodeURIComponent(intl) + ',phone.eq.' + encodeURIComponent(local) + ')';
  }

  async function fetchAccount(phone) {
    const data = await sbFetch(
      SB_URL + '/rest/v1/accounts?' + phoneOrFilter(phone) + '&select=*&limit=1');
    return Array.isArray(data) ? (data[0] || null) : null;
  }
  async function fetchDriverApp(phone) {
    const data = await sbFetch(
      SB_URL + '/rest/v1/driver_applications?' + phoneOrFilter(phone) +
      '&select=status,rejection_reason&order=created_at.desc&limit=1');
    return Array.isArray(data) ? (data[0] || null) : null;
  }

  /* ── Render helpers ────────────────────────────────────────── */
  const ACCT_STATUS_AR = { active:'نشط', pending:'معلق', approved:'معتمد', rejected:'مرفوض', banned:'محظور' };
  const ACCT_STATUS_CLASS = { active:'status-chip--active', pending:'status-chip--pending', approved:'status-chip--approved', rejected:'status-chip--rejected', banned:'status-chip--banned' };
  const APP_STATUS_AR = { pending:'قيد المراجعة', approved:'معتمد ✓', rejected:'مرفوض' };
  const APP_STATUS_CLASS = { pending:'status-chip--pending', approved:'status-chip--approved', rejected:'status-chip--rejected' };

  function renderStatusChips(acctStatus, appStatus) {
    var acctChip = $('prof-acct-chip');
    var appChip  = $('prof-app-chip');
    // If account is approved but no explicit app record, infer app as approved
    var effectiveApp = appStatus || (acctStatus === 'approved' ? 'approved' : null);
    if (acctStatus) {
      acctChip.textContent = '⚙ ' + (ACCT_STATUS_AR[acctStatus] || acctStatus);
      acctChip.className = 'status-chip ' + (ACCT_STATUS_CLASS[acctStatus] || '');
      acctChip.style.display = 'inline-flex';
    } else {
      acctChip.style.display = 'none';
    }
    if (effectiveApp) {
      appChip.textContent = '📋 ' + (APP_STATUS_AR[effectiveApp] || effectiveApp);
      appChip.className = 'status-chip ' + (APP_STATUS_CLASS[effectiveApp] || '');
      appChip.style.display = 'inline-flex';
    } else {
      appChip.style.display = 'none';
    }
  }

  function renderDriverStatusCard(acctStatus, appData) {
    $('driver-status-card').style.display = '';
    var acctLabel = $('driver-acct-status-label');
    var appLabel  = $('driver-app-status-label');
    var eligDiv   = $('driver-order-eligibility');

    var acctColor = { active:'#16A34A', pending:'#CA8A04', approved:'#2563EB', rejected:'#DC2626', banned:'#64748B' };
    acctLabel.textContent = ACCT_STATUS_AR[acctStatus] || acctStatus || '—';
    acctLabel.style.color = acctColor[acctStatus] || 'var(--color-text)';

    var appStatus = appData ? appData.status : null;
    var appColor  = { pending:'#CA8A04', approved:'#2563EB', rejected:'#DC2626' };
    appLabel.textContent = APP_STATUS_AR[appStatus] || (appData ? appStatus : 'لم يُرفع طلب');
    appLabel.style.color = appColor[appStatus] || 'var(--color-text-muted)';
    if (appData && appData.rejection_reason && appStatus === 'rejected') {
      appLabel.title = appData.rejection_reason;
    }

    // approved account status = admin approved directly on accounts table (same as active + approved app)
    var effectiveAppStatus = appStatus || (acctStatus === 'approved' ? 'approved' : null);
    var canReceive = (acctStatus === 'active' || acctStatus === 'approved') && effectiveAppStatus === 'approved';

    // Update app label if inferred from account status
    if (!appStatus && acctStatus === 'approved') {
      appLabel.textContent = APP_STATUS_AR['approved'] || 'معتمد';
      appLabel.style.color = '#2563EB';
    }

    eligDiv.style.display = '';
    if (canReceive) {
      eligDiv.textContent = '✅ مؤهل لاستقبال الطلبات';
      eligDiv.style.background = '#DCFCE7';
      eligDiv.style.color = '#16A34A';
      eligDiv.style.border = '1px solid #BBF7D0';
    } else {
      eligDiv.textContent = '⛔ غير مؤهل — يجب أن يكون الحساب نشطاً والطلب معتمداً';
      eligDiv.style.background = '#FEE2E2';
      eligDiv.style.color = '#DC2626';
      eligDiv.style.border = '1px solid #FECACA';
    }
  }

  function renderHeader(acc) {
    const name   = acc.name     || user.name   || '—';
    const phone  = acc.phone    || user.phone  || '—';
    const role   = acc.role     || user.role   || 'customer';
    const city   = acc.city     || user.city   || '';
    const since  = acc.created_at || acc.createdAt || '';

    $('prof-avatar').textContent = initials(name);
    $('prof-name').textContent   = name;
    $('prof-phone').textContent  = phone;

    const badge = $('prof-role-badge');
    badge.textContent = role === 'driver' ? '🚗 سائق' : '👤 عميل';
    if (role === 'driver') badge.classList.add('role-badge--driver');

    if (city) {
      $('prof-city').textContent = '📍 ' + city;
      $('prof-city').hidden = false;
    }
    if (since) {
      $('prof-since').textContent = '🗓 عضو منذ ' + fmtDate(since);
    }

    // Info view fields
    $('view-name').textContent     = name;
    $('view-phone').textContent    = phone;
    $('view-email').textContent    = acc.email    || '';
    if (!acc.email)    $('view-email').classList.add('info-field__value--empty'),    $('view-email').textContent    = 'غير محدد';
    $('view-username').textContent = acc.username || '';
    if (!acc.username) $('view-username').classList.add('info-field__value--empty'), $('view-username').textContent = 'غير محدد';
    $('view-city').textContent     = city || 'غير محدد';
    if (!city)         $('view-city').classList.add('info-field__value--empty');
    $('view-role').textContent     = role === 'driver' ? 'سائق توصيل' : 'عميل';
    $('view-created').textContent  = fmtDate(since);
    $('sec-phone').textContent     = phone;

    // Pre-fill edit form
    $('edit-name').value     = name !== '—' ? name : '';
    $('edit-username').value = acc.username || '';
    $('edit-email').value    = acc.email    || '';
    $('edit-city').value     = city;
  }

  function renderStats(orders, rides) {
    const now = new Date();
    const thisMonth = orders.filter(o => {
      const d = new Date(o.created_at || o.date || 0);
      return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth();
    });
    const totalSpent = orders
      .filter(o => o.status === 'delivered' || o.status === 'completed')
      .reduce((s, o) => s + (Number(o.total) || 0), 0);

    $('stat-orders').textContent = orders.length;
    $('stat-spent').textContent  = fmt(Math.round(totalSpent)) + ' ج.م';
    $('stat-rides').textContent  = rides.length;
    $('stat-month').textContent  = thisMonth.length;
  }

  function orderStatusGroup(status) {
    if (!status) return 'active';
    if (['delivered','completed'].includes(status)) return 'delivered';
    if (['rejected','cancelled'].includes(status)) return 'cancelled';
    return 'active';
  }

  function buildOrderCard(o) {
    const status   = o.status || 'pending';
    const group    = orderStatusGroup(status);
    const label    = STATUS_AR[status] || status;
    const cls      = STATUS_CLASS[status] || 'status--pending';
    const store    = o.store_name || o.type || 'طلب توصيل';
    const icon     = o.icon || '🛵';
    const itemsStr = (() => {
      if (!o.items && !o.items_summary) return '';
      if (o.items_summary) return o.items_summary;
      try {
        const items = typeof o.items === 'string' ? JSON.parse(o.items) : o.items;
        if (Array.isArray(items)) return items.map(i => (i.emoji||'') + ' ' + i.name).join(' · ');
      } catch {}
      return '';
    })();
    const total    = o.total ? fmt(o.total) + ' ج.م' : (o.price || '—');
    const date     = fmtDateTime(o.created_at || o.date);
    const id       = o.id || o.code || '';

    const div = document.createElement('div');
    div.className = 'order-card';
    div.dataset.group = group;
    div.innerHTML = `
      <div class="order-icon">${icon}</div>
      <div class="order-main">
        <div class="order-top">
          <span class="order-id">${id}</span>
          <span class="order-status-badge ${cls}">${label}</span>
        </div>
        <div class="order-store">${store}</div>
        ${itemsStr ? `<div class="order-items">${itemsStr}</div>` : ''}
        <div class="order-footer">
          <span class="order-date">${date}</span>
          <span class="order-total">${total}</span>
        </div>
      </div>`;
    return div;
  }

  function renderOrders(orders) {
    const list = $('orders-list');
    if (!orders.length) {
      list.innerHTML = `<div class="empty-state">
        <div class="empty-state__icon">🛵</div>
        <div class="empty-state__title">لا توجد طلبات بعد</div>
        <div class="empty-state__text">طلباتك ستظهر هنا بعد أول عملية توصيل</div>
      </div>`;
      return;
    }
    list.innerHTML = '';
    orders.forEach(o => list.appendChild(buildOrderCard(o)));
    applyOrderFilter(currentOrderFilter);
  }

  function applyOrderFilter(filter) {
    currentOrderFilter = filter;
    const cards = $('orders-list').querySelectorAll('.order-card');
    let visible = 0;
    cards.forEach(c => {
      const show = filter === 'all' || c.dataset.group === filter;
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (visible === 0) {
      let msg = $('orders-empty-msg');
      if (!msg) {
        msg = document.createElement('div');
        msg.id = 'orders-empty-msg';
        msg.className = 'empty-state';
        msg.innerHTML = '<div class="empty-state__icon">📭</div><div class="empty-state__title">لا توجد طلبات في هذه الفئة</div>';
        $('orders-list').appendChild(msg);
      }
      msg.style.display = '';
    } else {
      const msg = $('orders-empty-msg');
      if (msg) msg.style.display = 'none';
    }
  }

  function renderRides(rides) {
    const list = $('rides-list');
    if (!rides.length) {
      list.innerHTML = `<div class="empty-state">
        <div class="empty-state__icon">🚗</div>
        <div class="empty-state__title">لا توجد رحلات بعد</div>
        <div class="empty-state__text">رحلاتك ستظهر هنا بعد أول مشوار</div>
      </div>`;
      return;
    }
    list.innerHTML = '';
    rides.forEach(r => {
      const status  = r.status || 'pending';
      const label   = STATUS_AR[status] || status;
      const cls     = STATUS_CLASS[status] || 'status--pending';
      const from    = r.from_area || '—';
      const to      = r.to_area   || '—';
      const fare    = r.fare ? fmt(r.fare) + ' ج.م' : '—';
      const dist    = r.distance_km ? r.distance_km + ' كم' : '';
      const eta     = r.eta_minutes ? r.eta_minutes + ' دقيقة' : '';
      const date    = fmtDateTime(r.created_at || r.accepted_at);
      const driver  = r.driver_name ? '👨‍✈️ ' + r.driver_name : '';

      const div = document.createElement('div');
      div.className = 'ride-card';
      div.innerHTML = `
        <div class="ride-top">
          <div class="ride-route">
            <span class="ride-route__icon">📍</span>
            <span class="ride-route__text">${from}</span>
            <span class="ride-route__arrow">→</span>
            <span class="ride-route__text">${to}</span>
          </div>
          <span class="order-status-badge ${cls}">${label}</span>
        </div>
        <div class="ride-meta">
          <span class="ride-meta__item">📅 ${date}</span>
          ${dist ? `<span class="ride-meta__item">📏 ${dist}</span>` : ''}
          ${eta  ? `<span class="ride-meta__item">⏱ ${eta}</span>` : ''}
          ${driver ? `<span class="ride-meta__item">${driver}</span>` : ''}
          <span class="ride-fare" style="margin-right:auto">${fare}</span>
        </div>`;
      list.appendChild(div);
    });
  }

  function renderStatisticsTab(orders, rides) {
    const delivered = orders.filter(o => ['delivered','completed'].includes(o.status));
    const totalSpent = delivered.reduce((s, o) => s + (Number(o.total) || 0), 0);
    const avgOrder   = delivered.length ? Math.round(totalSpent / delivered.length) : 0;
    const now = new Date();
    const thisMonth = orders.filter(o => {
      const d = new Date(o.created_at || 0);
      return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth();
    });

    $('st-total-orders').textContent = orders.length;
    $('st-total-spent').textContent  = fmt(Math.round(totalSpent));
    $('st-avg-order').textContent    = fmt(avgOrder);
    $('st-total-rides').textContent  = rides.length;
    $('st-delivered').textContent    = delivered.length;
    $('st-this-month').textContent   = thisMonth.length;

    // Category breakdown (by store_name or type)
    const catMap = {};
    orders.forEach(o => {
      const key = o.store_name || o.type || 'توصيل';
      catMap[key] = (catMap[key] || 0) + (Number(o.total) || 0);
    });
    if (rides.length) catMap['مشاوير'] = (catMap['مشاوير'] || 0) + rides.reduce((s, r) => s + (Number(r.fare) || 0), 0);

    const catEntries = Object.entries(catMap).sort((a, b) => b[1] - a[1]).slice(0, 6);
    const maxCat = catEntries[0] ? catEntries[0][1] : 1;
    const colors = ['', '--green', '--orange', '--purple', '', '--green'];
    const catHtml = catEntries.length
      ? catEntries.map(([name, amt], i) => `
          <div class="category-row">
            <span class="category-row__label">${name}</span>
            <div class="category-bar-wrap">
              <div class="category-bar${colors[i] || ''}" style="width:${Math.round(amt/maxCat*100)}%"></div>
            </div>
            <span class="category-row__count">${fmt(Math.round(amt))} ج</span>
          </div>`).join('')
      : '<p style="color:var(--color-text-muted);font-size:var(--text-sm)">لا توجد بيانات كافية بعد</p>';
    $('category-breakdown').innerHTML = catHtml;

    // Top stores
    const storeMap = {};
    orders.forEach(o => {
      if (!o.store_name) return;
      if (!storeMap[o.store_name]) storeMap[o.store_name] = { count: 0, spent: 0 };
      storeMap[o.store_name].count++;
      storeMap[o.store_name].spent += Number(o.total) || 0;
    });
    const topStores = Object.entries(storeMap).sort((a, b) => b[1].count - a[1].count).slice(0, 5);
    $('top-stores').innerHTML = topStores.length
      ? `<div class="category-list">${topStores.map(([name, s], i) =>
          `<div class="category-row">
            <span class="category-row__label">${['🥇','🥈','🥉','4️⃣','5️⃣'][i]} ${name}</span>
            <div class="category-bar-wrap">
              <div class="category-bar" style="width:${Math.round(s.count/topStores[0][1].count*100)}%"></div>
            </div>
            <span class="category-row__count">${s.count} طلب</span>
          </div>`).join('')}</div>`
      : '<p style="color:var(--color-text-muted);font-size:var(--text-sm)">لا توجد بيانات كافية بعد</p>';

    // Monthly breakdown
    const monthMap = {};
    orders.forEach(o => {
      const d = new Date(o.created_at || 0);
      const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
      if (!monthMap[key]) monthMap[key] = { label: MONTHS_AR[d.getMonth()] + ' ' + d.getFullYear(), count: 0, spent: 0 };
      monthMap[key].count++;
      monthMap[key].spent += Number(o.total) || 0;
    });
    const monthRows = Object.entries(monthMap).sort((a, b) => b[0].localeCompare(a[0])).slice(0, 12);
    $('monthly-tbody').innerHTML = monthRows.length
      ? monthRows.map(([, m]) => {
          const avg = m.count ? Math.round(m.spent / m.count) : 0;
          return `<tr>
            <td>${m.label}</td>
            <td>${m.count}</td>
            <td>${fmt(Math.round(m.spent))} ج.م</td>
            <td>${fmt(avg)} ج.م</td>
          </tr>`;
        }).join('')
      : '<tr><td colspan="4" style="text-align:center;color:var(--color-text-muted)">لا توجد بيانات بعد</td></tr>';
  }

  /* ── Tab switching ─────────────────────────────────────────── */
  document.querySelectorAll('.profile-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      document.querySelectorAll('.profile-tab').forEach(b => {
        b.classList.toggle('is-active', b.dataset.tab === tab);
        b.setAttribute('aria-selected', String(b.dataset.tab === tab));
      });
      document.querySelectorAll('.tab-panel').forEach(p => {
        const show = p.id === 'tab-' + tab;
        p.classList.toggle('is-active', show);
        p.hidden = !show;
      });
    });
  });

  /* ── Order filters ─────────────────────────────────────────── */
  document.querySelectorAll('.orders-filter').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.orders-filter').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      applyOrderFilter(btn.dataset.filter);
    });
  });

  /* ── Edit profile form ─────────────────────────────────────── */
  let cachedAccount = null;

  $('edit-toggle-btn').addEventListener('click', () => {
    $('info-view').hidden = true;
    $('info-edit').hidden = false;
    $('edit-toggle-btn').hidden = true;
  });
  $('edit-cancel-btn').addEventListener('click', () => {
    $('info-view').hidden = false;
    $('info-edit').hidden = true;
    $('edit-toggle-btn').hidden = false;
    $('save-success-msg').style.display = 'none';
  });

  $('profile-edit-form').addEventListener('submit', async e => {
    e.preventDefault();
    const name     = $('edit-name').value.trim();
    const username = $('edit-username').value.trim().toLowerCase();
    const email    = $('edit-email').value.trim().toLowerCase();
    const city     = $('edit-city').value.trim();
    if (!name) { showToast('الاسم مطلوب'); return; }

    // Update Supabase
    try {
      const patch = { name, city: city || null, email: email || null, username: username || null };
      await fetch(SB_URL + '/rest/v1/accounts?phone=eq.' + encodeURIComponent(user.phone), {
        method: 'PATCH',
        headers: { ...SB_H, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify(patch),
      });
    } catch {}

    // Update localStorage
    try {
      const stored = JSON.parse(localStorage.getItem('wslha_user') || '{}');
      stored.name = name; stored.city = city;
      localStorage.setItem('wslha_user', JSON.stringify(stored));
    } catch {}

    // Update accounts cache
    try {
      const accs = JSON.parse(localStorage.getItem('wslha_accounts') || '[]');
      const idx  = accs.findIndex(a => a.phone === user.phone);
      if (idx >= 0) {
        accs[idx] = { ...accs[idx], name, city, email: email || accs[idx].email, username: username || accs[idx].username };
        localStorage.setItem('wslha_accounts', JSON.stringify(accs));
      }
    } catch {}

    // Refresh UI
    if (cachedAccount) {
      cachedAccount.name     = name;
      cachedAccount.city     = city;
      cachedAccount.email    = email;
      cachedAccount.username = username;
    }
    renderHeader(cachedAccount || { name, phone: user.phone, city, email, username, role: user.role });

    $('save-success-msg').style.display = 'inline-flex';
    setTimeout(() => {
      $('info-view').hidden  = false;
      $('info-edit').hidden  = true;
      $('edit-toggle-btn').hidden = false;
      $('save-success-msg').style.display = 'none';
    }, 1800);
    showToast('✅ تم حفظ بياناتك بنجاح');
  });

  /* ── Logout ────────────────────────────────────────────────── */
  $('logout-btn').addEventListener('click', () => {
    localStorage.removeItem('wslha_user');
    window.location.href = '/';
  });

  /* ── Phone change ──────────────────────────────────────────── */
  (function () {
    var panel      = $('phone-change-panel');
    var step1      = $('pc-step1');
    var step2      = $('pc-step2');
    var err1       = $('pc-err1');
    var err2       = $('pc-err2');
    var newPhoneIn = $('pc-new-phone');
    var phoneBadge = $('pc-phone-badge');
    var otpBoxes   = Array.from(document.querySelectorAll('.pc-otp-box'));
    var pcNewPhone = '';

    function showErr(el, msg) { el.textContent = msg; el.classList.add('is-visible'); }
    function hideErr(el) { el.textContent = ''; el.classList.remove('is-visible'); }

    function normalizePhone(p) {
      p = p.replace(/\s/g, '');
      if (p.startsWith('01') && p.length === 11) return '+2' + p;
      if (p.startsWith('+201') && p.length === 13) return p;
      return null;
    }

    async function sendOTP(phone) {
      var arr = new Uint32Array(1);
      crypto.getRandomValues(arr);
      var code = String(100000 + (arr[0] % 900000));
      await fetch(SB_URL + '/rest/v1/otps?phone=eq.' + encodeURIComponent(phone), {
        method: 'DELETE', headers: SB_H,
      }).catch(function(){});
      await fetch(SB_URL + '/rest/v1/otps', {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=minimal' },
        body: JSON.stringify({ phone: phone, code: code }),
      });
      // Dev notice: auto-fill OTP by clicking badge
      phoneBadge.title = 'كود التطوير: ' + code;
      phoneBadge.style.cursor = 'pointer';
      phoneBadge.onclick = function () {
        otpBoxes.forEach(function (b, i) { b.value = code[i] || ''; b.classList.toggle('filled', !!code[i]); });
        doVerify();
      };
    }

    async function verifyOTP(phone, token) {
      var res = await fetch(SB_URL + '/rest/v1/rpc/verify_otp', {
        method: 'POST', headers: SB_H,
        body: JSON.stringify({ p_phone: phone, p_code: token }),
      });
      if (!res.ok) return false;
      var json = await res.json();
      return json === true || json === 'true' || json?.verified === true;
    }

    function goStep2() {
      hideErr(err2);
      otpBoxes.forEach(function (b) { b.value = ''; b.classList.remove('filled', 'shake'); });
      step1.classList.remove('is-active');
      step2.classList.add('is-active');
      phoneBadge.textContent = pcNewPhone;
      setTimeout(function () { otpBoxes[0] && otpBoxes[0].focus(); }, 100);
    }

    function resetPanel() {
      panel.classList.remove('is-open');
      step1.classList.add('is-active');
      step2.classList.remove('is-active');
      hideErr(err1); hideErr(err2);
      newPhoneIn.value = '';
      otpBoxes.forEach(function (b) { b.value = ''; b.classList.remove('filled', 'shake'); });
      pcNewPhone = '';
    }

    $('change-phone-btn').addEventListener('click', function () {
      panel.classList.toggle('is-open');
      if (panel.classList.contains('is-open')) {
        step1.classList.add('is-active');
        step2.classList.remove('is-active');
        setTimeout(function () { newPhoneIn.focus(); }, 50);
      }
    });
    $('pc-cancel-btn').addEventListener('click', resetPanel);
    $('pc-back-btn').addEventListener('click', function () {
      step2.classList.remove('is-active');
      step1.classList.add('is-active');
      hideErr(err2);
    });

    $('pc-send-btn').addEventListener('click', async function () {
      hideErr(err1);
      var raw = newPhoneIn.value.trim();
      var normalized = normalizePhone(raw);
      if (!normalized) { showErr(err1, 'أدخل رقم جوال مصري صحيح (01XXXXXXXXX)'); return; }

      // Check it's not the same as current phone
      var curPhoneLocal = user.phone.startsWith('+20') ? '0' + user.phone.slice(3) : user.phone;
      var normLocal = normalized.startsWith('+20') ? '0' + normalized.slice(3) : normalized;
      if (normLocal === curPhoneLocal) { showErr(err1, 'هذا هو رقمك الحالي بالفعل'); return; }

      // Check number not already in use
      var checkLocal = normLocal;
      var checkIntl  = normalized;
      var existing = await fetch(
        SB_URL + '/rest/v1/accounts?or=(phone.eq.' + encodeURIComponent(checkIntl) + ',phone.eq.' + encodeURIComponent(checkLocal) + ')&select=id&limit=1',
        { headers: SB_H }
      ).then(function (r) { return r.ok ? r.json() : []; }).catch(function () { return []; });
      if (existing.length > 0) { showErr(err1, 'هذا الرقم مسجّل بالفعل لحساب آخر'); return; }

      pcNewPhone = normalized;
      var btn = $('pc-send-btn');
      btn.disabled = true; btn.textContent = 'جاري الإرسال…';
      try {
        await sendOTP(pcNewPhone);
        goStep2();
      } catch (e) {
        showErr(err1, 'فشل الإرسال، حاول مرة أخرى');
      } finally {
        btn.disabled = false; btn.textContent = 'إرسال كود التحقق';
      }
    });

    async function doVerify() {
      var btn = $('pc-verify-btn');
      var allFilled = otpBoxes.every(function (b) { return b.value.length === 1; });
      if (!allFilled) return;
      var token = otpBoxes.map(function (b) { return b.value; }).join('');
      btn.disabled = true; btn.textContent = 'جاري التحقق…';
      hideErr(err2);

      try {
        var ok = await verifyOTP(pcNewPhone, token);
        if (!ok) {
          otpBoxes.forEach(function (b) { b.classList.remove('shake'); void b.offsetWidth; b.classList.add('shake'); b.value = ''; b.classList.remove('filled'); });
          otpBoxes[0] && otpBoxes[0].focus();
          showErr(err2, 'الكود غير صحيح أو انتهت صلاحيته');
          btn.disabled = false; btn.textContent = 'تأكيد التغيير';
          return;
        }

        // Update phone in accounts table — use OR filter to find current account
        var local  = user.phone.startsWith('+20') ? '0' + user.phone.slice(3) : user.phone;
        var intl   = user.phone.startsWith('0')   ? '+2' + user.phone : user.phone;
        var patchRes = await fetch(
          SB_URL + '/rest/v1/accounts?or=(phone.eq.' + encodeURIComponent(intl) + ',phone.eq.' + encodeURIComponent(local) + ')',
          {
            method: 'PATCH',
            headers: { ...SB_H, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
            body: JSON.stringify({ phone: pcNewPhone }),
          }
        );

        if (!patchRes.ok) { showErr(err2, 'فشل تحديث الرقم، حاول مرة أخرى'); btn.disabled = false; btn.textContent = 'تأكيد التغيير'; return; }

        // Update localStorage
        try {
          var stored = JSON.parse(localStorage.getItem('wslha_user') || '{}');
          stored.phone = pcNewPhone;
          localStorage.setItem('wslha_user', JSON.stringify(stored));
        } catch {}

        user.phone = pcNewPhone;
        if (cachedAccount) cachedAccount.phone = pcNewPhone;

        // Refresh displayed phone
        $('prof-phone').textContent = pcNewPhone;
        $('view-phone').textContent = pcNewPhone;
        $('sec-phone').textContent  = pcNewPhone;

        resetPanel();
        showToast('✅ تم تغيير رقم الجوال بنجاح');
      } catch (e) {
        showErr(err2, 'حدث خطأ، حاول مرة أخرى');
        btn.disabled = false; btn.textContent = 'تأكيد التغيير';
      }
    }

    $('pc-verify-btn').addEventListener('click', doVerify);

    // OTP box behavior
    otpBoxes.forEach(function (box, i) {
      box.addEventListener('keydown', function (e) {
        if (e.key === 'Backspace') {
          if (!box.value && i > 0) { otpBoxes[i-1].focus(); otpBoxes[i-1].value = ''; otpBoxes[i-1].classList.remove('filled'); }
          box.value = ''; box.classList.remove('filled');
          e.preventDefault();
        }
        if (e.key === 'ArrowRight' && i > 0) otpBoxes[i-1].focus();
        if (e.key === 'ArrowLeft'  && i < 5) otpBoxes[i+1].focus();
      });
      box.addEventListener('input', function () {
        var v = box.value.replace(/\D/g, '').slice(-1);
        box.value = v;
        box.classList.toggle('filled', !!v);
        if (v && i < 5) otpBoxes[i+1].focus();
        if (otpBoxes.every(function (b) { return b.value.length === 1; })) setTimeout(doVerify, 120);
      });
      box.addEventListener('paste', function (e) {
        e.preventDefault();
        var digits = (e.clipboardData ? e.clipboardData.getData('text') : '').replace(/\D/g, '').slice(0, 6);
        digits.split('').forEach(function (d, j) { if (otpBoxes[j]) { otpBoxes[j].value = d; otpBoxes[j].classList.add('filled'); } });
        var next = Math.min(digits.length, 5);
        otpBoxes[next] && otpBoxes[next].focus();
        if (digits.length === 6) setTimeout(doVerify, 120);
      });
      box.addEventListener('focus', function () { box.select(); });
    });
  })();

  /* ── Init ──────────────────────────────────────────────────── */
  function buildAccFromLocal(phone) {
    try {
      const accounts = JSON.parse(localStorage.getItem('wslha_accounts') || '[]');
      const found = accounts.find(a => a.phone === phone);
      if (found) return found;
    } catch {}
    return { phone, name: user.name || '', role: user.role || 'customer', city: user.city || '', createdAt: user.loginAt || '' };
  }

  function mergeOrders(sbOrders, lsOrders) {
    const ids = new Set(sbOrders.map(o => o.id));
    const extra = lsOrders.filter(o => !ids.has(o.id));
    return [...sbOrders, ...extra].sort((a, b) =>
      new Date(b.created_at || b.date || 0) - new Date(a.created_at || a.date || 0));
  }

  function showContent(acc, orders, rides, acctStatus, appData) {
    cachedAccount = acc;
    allOrders = orders;
    allRides  = rides;
    renderHeader(acc);
    renderStats(orders, rides);
    renderOrders(orders);
    renderRides(rides);
    renderStatisticsTab(orders, rides);

    var role = (acc && acc.role) || user.role || 'customer';
    if (role === 'driver' && acctStatus) {
      renderStatusChips(acctStatus, appData ? appData.status : null);
      renderDriverStatusCard(acctStatus, appData);
    }

    $('profile-loading').hidden  = true;
    $('profile-content').hidden  = false;
  }

  function init() {
    const phone = user.phone;

    // ── Step 1: render immediately from localStorage (instant) ──
    let lsOrders = [];
    try { lsOrders = JSON.parse(localStorage.getItem('wslha_orders') || '[]'); } catch {}
    const lsAcc = buildAccFromLocal(phone);
    showContent(lsAcc, mergeOrders([], lsOrders), [], null, null);

    // ── Step 2: fetch from Supabase in background and refresh ──
    var role = user.role || 'customer';
    var fetches = [fetchAccount(phone), fetchOrders(phone), fetchRides(phone)];
    if (role === 'driver') fetches.push(fetchDriverApp(phone));

    Promise.all(fetches)
      .then(function(results) {
        var sbAcc    = results[0];
        var sbOrders = results[1];
        var sbRides  = results[2];
        var appData  = results[3] || null;
        var acc      = sbAcc || lsAcc;
        var orders   = mergeOrders(sbOrders, lsOrders);
        var acctStatus = acc ? (acc.status || null) : null;
        showContent(acc, orders, sbRides, acctStatus, appData);
      })
      .catch(function(err) { console.warn('[profile] Supabase refresh failed', err); });
  }

  init();
})();
</script>

</Layout>
