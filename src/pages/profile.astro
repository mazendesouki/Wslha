---
import Layout from '../components/layout.astro';
---

<Layout title="حسابي — وصّلها" currentPage="profile">

<style>
  /* ── Layout ─────────────────────────────────────────────────── */
  .profile-wrap {
    min-height: calc(100vh - var(--nav-height));
    background: var(--color-bg-soft);
  }

  /* ── Loading ────────────────────────────────────────────────── */
  .profile-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    min-height: 60vh;
    color: var(--color-text-muted);
  }
  .profile-loading__spinner {
    width: 44px;
    height: 44px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Header ─────────────────────────────────────────────────── */
  .profile-header {
    background: linear-gradient(135deg, var(--color-primary) 0%, #2952D9 100%);
    color: #fff;
    padding: var(--sp-10) var(--sp-6) var(--sp-12);
    position: relative;
    overflow: hidden;
  }
  .profile-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }
  .profile-header__inner {
    max-width: var(--container);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    position: relative;
  }
  .profile-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: rgba(255,255,255,0.25);
    border: 3px solid rgba(255,255,255,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    font-weight: var(--weight-black);
    color: #fff;
    flex-shrink: 0;
    backdrop-filter: blur(8px);
    letter-spacing: -1px;
  }
  .profile-header__info { flex: 1; min-width: 0; }
  .profile-header__name {
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    color: #fff;
    margin: 0 0 var(--sp-1);
    line-height: 1.2;
  }
  .profile-header__phone {
    font-size: var(--text-base);
    color: rgba(255,255,255,0.8);
    margin: 0 0 var(--sp-3);
    direction: ltr;
    text-align: right;
  }
  .profile-header__badges {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .role-badge {
    padding: 3px var(--sp-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    background: rgba(255,255,255,0.2);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.4);
  }
  .role-badge--driver { background: rgba(22,163,74,0.3); border-color: rgba(22,163,74,0.6); }
  .status-chip {
    padding: 3px var(--sp-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    border: 1px solid transparent;
    display: none;
  }
  .status-chip--active   { background: rgba(22,163,74,0.25);  border-color: rgba(22,163,74,0.5);  color: #86EFAC; }
  .status-chip--pending  { background: rgba(202,138,4,0.25);  border-color: rgba(202,138,4,0.5);  color: #FDE68A; }
  .status-chip--approved { background: rgba(59,130,246,0.25); border-color: rgba(59,130,246,0.5); color: #93C5FD; }
  .status-chip--rejected { background: rgba(220,38,38,0.25);  border-color: rgba(220,38,38,0.5);  color: #FCA5A5; }
  .status-chip--banned   { background: rgba(100,116,139,0.25);border-color: rgba(100,116,139,0.5);color: #CBD5E1; }
  .profile-header__city,
  .profile-header__since {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.7);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* ── Stats ──────────────────────────────────────────────────── */
  .profile-stats-wrap {
    max-width: var(--container);
    margin: -36px auto 0;
    padding: 0 var(--sp-6);
    position: relative;
    z-index: 2;
  }
  .profile-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-3);
  }
  .stat-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-4) var(--sp-3);
    text-align: center;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-1);
  }
  .stat-card__icon { font-size: 1.5rem; }
  .stat-card__value {
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    color: var(--color-primary);
    line-height: 1;
  }
  .stat-card__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--weight-semi);
  }

  /* ── Tabs ───────────────────────────────────────────────────── */
  .profile-body {
    max-width: var(--container);
    margin: var(--sp-8) auto var(--sp-16);
    padding: 0 var(--sp-6);
  }
  .profile-tabs-nav {
    display: flex;
    gap: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-1);
    margin-bottom: var(--sp-6);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .profile-tabs-nav::-webkit-scrollbar { display: none; }
  .profile-tab {
    flex: 1;
    min-width: max-content;
    padding: var(--sp-2) var(--sp-4);
    border-radius: calc(var(--radius-lg) - 4px);
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--ease);
    white-space: nowrap;
  }
  .profile-tab.is-active {
    background: var(--color-primary);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }
  .profile-tab:not(.is-active):hover {
    background: var(--color-bg-soft);
    color: var(--color-text);
  }
  .tab-panel { display: none; }
  .tab-panel.is-active { display: block; }

  /* ── Card base ──────────────────────────────────────────────── */
  .card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .card__header {
    padding: var(--sp-4) var(--sp-5);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .card__title {
    font-size: var(--text-base);
    font-weight: var(--weight-black);
    color: var(--color-text);
    margin: 0;
  }
  .card__body { padding: var(--sp-5); }

  /* ── Info tab ───────────────────────────────────────────────── */
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .info-field { display: flex; flex-direction: column; gap: var(--sp-1); }
  .info-field__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .info-field__value {
    font-size: var(--text-base);
    font-weight: var(--weight-semi);
    color: var(--color-text);
    padding: var(--sp-2) var(--sp-3);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    min-height: 42px;
    display: flex;
    align-items: center;
  }
  .info-field__value--empty { color: var(--color-text-faint); font-style: italic; }

  /* Edit form */
  .edit-form { display: flex; flex-direction: column; gap: var(--sp-4); }
  .form-group { display: flex; flex-direction: column; gap: var(--sp-2); }
  .form-label { font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--color-text); }
  .form-input {
    padding: var(--sp-3) var(--sp-4);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-bg);
    transition: border-color var(--ease);
    width: 100%;
    box-sizing: border-box;
  }
  .form-input:focus { outline: none; border-color: var(--color-primary); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .btn-save {
    padding: var(--sp-3) var(--sp-6);
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    cursor: pointer;
    transition: background var(--ease), transform var(--ease);
    align-self: flex-start;
  }
  .btn-save:hover { background: #2952D9; transform: translateY(-1px); }
  .save-success {
    display: none;
    color: #16A34A;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    padding: var(--sp-2) var(--sp-3);
    background: #DCFCE7;
    border-radius: var(--radius);
  }

  /* Security card */
  .security-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .security-row:last-child { border-bottom: none; }
  .security-row__info {}
  .security-row__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }
  .security-row__desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 2px;
  }
  .btn-danger {
    padding: var(--sp-2) var(--sp-4);
    background: #FEE2E2;
    color: #DC2626;
    border: 1.5px solid #FECACA;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    cursor: pointer;
    transition: all var(--ease);
  }
  .btn-danger:hover { background: #DC2626; color: #fff; }

  /* ── Orders tab ─────────────────────────────────────────────── */
  .orders-filters {
    display: flex;
    gap: var(--sp-2);
    margin-bottom: var(--sp-4);
    flex-wrap: wrap;
  }
  .orders-filter {
    padding: var(--sp-2) var(--sp-4);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--ease);
  }
  .orders-filter:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .orders-filter.is-active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }

  .order-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-4) var(--sp-5);
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--ease), transform var(--ease);
    margin-bottom: var(--sp-3);
  }
  .order-card:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); }
  .order-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
  }
  .order-main { flex: 1; min-width: 0; }
  .order-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-bottom: var(--sp-1);
  }
  .order-id {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    font-weight: var(--weight-semi);
    direction: ltr;
  }
  .order-status-badge {
    padding: 2px var(--sp-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
  }
  .status--delivered  { background: #DCFCE7; color: #16A34A; }
  .status--pending    { background: #FEF9C3; color: #CA8A04; }
  .status--active,
  .status--on_the_way,
  .status--accepted,
  .status--in_progress { background: #DBEAFE; color: #2563EB; }
  .status--cancelled,
  .status--rejected   { background: #FEE2E2; color: #DC2626; }
  .status--preparing  { background: #FEF3C7; color: #D97706; }
  .status--completed  { background: #DCFCE7; color: #16A34A; }

  .order-store {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: 2px;
  }
  .order-items {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--sp-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .order-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .order-date { font-size: var(--text-xs); color: var(--color-text-faint); }
  .order-total {
    font-size: var(--text-base);
    font-weight: var(--weight-black);
    color: var(--color-primary);
  }

  /* ── Rides tab ──────────────────────────────────────────────── */
  .ride-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-4) var(--sp-5);
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--sp-3);
    transition: box-shadow var(--ease), transform var(--ease);
  }
  .ride-card:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); }
  .ride-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-3);
  }
  .ride-route {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex: 1;
  }
  .ride-route__icon { font-size: 1.2rem; }
  .ride-route__text {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }
  .ride-route__arrow {
    color: var(--color-primary);
    font-weight: var(--weight-black);
    margin: 0 var(--sp-1);
  }
  .ride-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .ride-meta__item {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .ride-fare {
    font-size: var(--text-lg);
    font-weight: var(--weight-black);
    color: var(--color-primary);
  }

  /* ── Statistics tab ─────────────────────────────────────────── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .stats-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }
  .stats-card__num {
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: var(--sp-1);
  }
  .stats-card__label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: var(--weight-semi);
  }
  .stats-card--green .stats-card__num { color: #16A34A; }
  .stats-card--orange .stats-card__num { color: #D97706; }

  /* Category breakdown */
  .category-list { display: flex; flex-direction: column; gap: var(--sp-3); }
  .category-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .category-row__label {
    width: 100px;
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-text);
    flex-shrink: 0;
    text-align: right;
  }
  .category-bar-wrap {
    flex: 1;
    height: 10px;
    background: var(--color-bg-soft);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .category-bar {
    height: 100%;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    transition: width 0.8s cubic-bezier(.4,0,.2,1);
  }
  .category-bar--green { background: #16A34A; }
  .category-bar--orange { background: #D97706; }
  .category-bar--purple { background: #9333EA; }
  .category-row__count {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    width: 50px;
    text-align: left;
  }

  /* Monthly table */
  .monthly-table { width: 100%; border-collapse: collapse; }
  .monthly-table th {
    padding: var(--sp-2) var(--sp-3);
    text-align: right;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    background: var(--color-bg-soft);
    border-bottom: 1px solid var(--color-border);
  }
  .monthly-table td {
    padding: var(--sp-3);
    text-align: right;
    font-size: var(--text-sm);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }
  .monthly-table tr:last-child td { border-bottom: none; }
  .monthly-table tr:hover td { background: var(--color-bg-soft); }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: var(--sp-12) var(--sp-6);
    color: var(--color-text-muted);
  }
  .empty-state__icon { font-size: 3rem; margin-bottom: var(--sp-3); }
  .empty-state__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--sp-2);
  }
  .empty-state__text { font-size: var(--text-sm); }

  /* Toast */
  .toast {
    position: fixed;
    bottom: var(--sp-8);
    left: 50%;
    transform: translateX(-50%) translateY(60px);
    background: #1E293B;
    color: #fff;
    padding: var(--sp-3) var(--sp-5);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    z-index: 9999;
    transition: transform 0.3s ease;
    white-space: nowrap;
  }
  .toast.is-visible { transform: translateX(-50%) translateY(0); }

  /* ── Phone-change panel ────────────────────────────────────── */
  .phone-change-panel {
    display: none;
    padding: var(--sp-4) var(--sp-5);
    background: var(--color-bg-soft);
    border-top: 1px solid var(--color-border);
  }
  .phone-change-panel.is-open { display: block; }
  .pc-step { display: none; }
  .pc-step.is-active { display: block; }
  .pc-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-black);
    color: var(--color-text);
    margin-bottom: var(--sp-3);
  }
  .pc-otp-group {
    display: flex;
    gap: var(--sp-2);
    justify-content: center;
    direction: ltr;
    margin: var(--sp-4) 0;
  }
  .pc-otp-box {
    width: 44px; height: 52px;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 1.4rem; font-weight: var(--weight-black);
    text-align: center; color: var(--color-text); background: var(--color-bg);
    outline: none; transition: border-color var(--ease);
    caret-color: transparent;
  }
  .pc-otp-box:focus { border-color: var(--color-primary); background: var(--color-primary-light); }
  .pc-otp-box.filled { border-color: var(--color-primary); }
  .pc-otp-box.shake { animation: shake .35s ease; border-color: #ef4444; }
  .pc-err {
    color: #DC2626; font-size: var(--text-xs); font-weight: var(--weight-bold);
    margin: var(--sp-2) 0; display: none;
  }
  .pc-err.is-visible { display: block; }
  .pc-btns { display: flex; gap: var(--sp-3); align-items: center; margin-top: var(--sp-3); }
  .pc-hint { font-size: var(--text-xs); color: var(--color-text-muted); margin-bottom: var(--sp-3); }
  .pc-new-phone-badge {
