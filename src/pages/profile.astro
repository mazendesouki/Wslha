---
import Layout from '../components/layout.astro';
---

<Layout title="حسابي — وصّلها" currentPage="profile">

<style>
  /* ── Reset / Base ───────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; }

  /* ── Page wrapper ───────────────────────────────────────────── */
  .profile-wrap {
    min-height: calc(100vh - var(--nav-height));
    background: #F0F4FF;
    padding: 0 0 var(--sp-16);
  }

  /* ── Loading ────────────────────────────────────────────────── */
  .profile-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    min-height: 60vh;
    color: var(--color-text-muted);
  }
  .profile-loading__spinner {
    width: 44px;
    height: 44px;
    border: 3px solid #D0D8F0;
    border-top-color: #3B5BDB;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Page title bar ─────────────────────────────────────────── */
  .page-title-bar {
    background: #fff;
    border-bottom: 1px solid #E2E8F0;
    padding: var(--sp-4) var(--sp-5);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .page-title-bar__inner {
    max-width: var(--container);
    margin: 0 auto;
  }
  .page-title-bar__text {
    font-size: var(--text-lg);
    font-weight: var(--weight-black);
    color: #1E293B;
    margin: 0;
  }

  /* ── Inner container ────────────────────────────────────────── */
  .profile-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-5) var(--sp-5) 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  /* ── Hero card ──────────────────────────────────────────────── */
  .hero-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 2px 16px rgba(59,91,219,0.08);
    overflow: hidden;
    border-top: 4px solid #3B5BDB;
  }
  .hero-card__body {
    padding: var(--sp-5) var(--sp-5);
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    direction: rtl;
  }

  /* Avatar */
  .hero-avatar-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
  }
  .hero-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3B5BDB, #7048E8);
    padding: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hero-avatar__inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #EEF2FF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    font-weight: var(--weight-black);
    color: #3B5BDB;
    letter-spacing: -1px;
    border: 2px solid #fff;
  }
  .hero-role-emoji {
    font-size: 1.1rem;
    line-height: 1;
  }

  /* Hero info */
  .hero-info {
    flex: 1;
    min-width: 0;
  }
  .hero-info__name {
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    color: #1E293B;
    margin: 0 0 var(--sp-1);
    line-height: 1.2;
  }
  .hero-info__phone {
    font-size: var(--text-sm);
    color: #64748B;
    margin: 0 0 var(--sp-3);
    direction: ltr;
    text-align: right;
    font-feature-settings: "tnum";
  }
  .hero-info__chips {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
    margin-bottom: var(--sp-2);
  }
  .role-badge {
    padding: 4px 12px;
    border-radius: 50px;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    background: #EEF2FF;
    color: #3B5BDB;
    border: 1px solid #C7D2FE;
  }
  .role-badge--driver {
    background: #ECFDF5;
    color: #059669;
    border-color: #A7F3D0;
  }
  .status-chip {
    padding: 4px 12px;
    border-radius: 50px;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    border: 1px solid transparent;
    display: none;
  }
  .status-chip--active   { background: #ECFDF5;  border-color: #A7F3D0;  color: #059669; }
  .status-chip--pending  { background: #FFFBEB;  border-color: #FDE68A;  color: #D97706; }
  .status-chip--approved { background: #EEF2FF;  border-color: #C7D2FE;  color: #3B5BDB; }
  .status-chip--rejected { background: #FEF2F2;  border-color: #FECACA;  color: #DC2626; }
  .status-chip--banned   { background: #F8FAFC;  border-color: #CBD5E1;  color: #64748B; }
  .hero-info__meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
  .hero-meta-item {
    font-size: var(--text-xs);
    color: #94A3B8;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* ── Stats strip ────────────────────────────────────────────── */
  .stats-strip {
    display: flex;
    gap: var(--sp-3);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  .stats-strip::-webkit-scrollbar { display: none; }
  .stat-box {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 2px 16px rgba(59,91,219,0.08);
    padding: var(--sp-4) var(--sp-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-1);
    min-width: 100px;
    flex: 1 0 100px;
    text-align: center;
  }
  .stat-box__icon { font-size: 1.4rem; line-height: 1; }
  .stat-box__value {
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    color: #3B5BDB;
    line-height: 1;
  }
  .stat-box__label {
    font-size: 0.7rem;
    color: #94A3B8;
    font-weight: var(--weight-semi);
    white-space: nowrap;
  }

  /* ── Tab nav ────────────────────────────────────────────────── */
  .profile-tabs-nav {
    display: flex;
    gap: 0;
    border-bottom: 2px solid #E2E8F0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    background: transparent;
    margin-bottom: 0;
  }
  .profile-tabs-nav::-webkit-scrollbar { display: none; }
  .profile-tab {
    padding: var(--sp-3) var(--sp-5);
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: #94A3B8;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .profile-tab.is-active {
    color: #3B5BDB;
    border-bottom-color: #3B5BDB;
  }
  .profile-tab:not(.is-active):hover {
    color: #475569;
    border-bottom-color: #CBD5E1;
  }
  .tab-panel { display: none; }
  .tab-panel.is-active { display: block; }

  /* ── Tabs + content wrapper ─────────────────────────────────── */
  .tabs-wrapper {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 2px 16px rgba(59,91,219,0.08);
    overflow: hidden;
  }
  .tabs-wrapper__nav { padding: 0 var(--sp-2); border-bottom: 2px solid #E2E8F0; }
  .tabs-wrapper__nav .profile-tabs-nav { border-bottom: none; margin-bottom: 0; }
  .tabs-wrapper__body { padding: var(--sp-5); }

  /* ── Card base ──────────────────────────────────────────────── */
  .card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 2px 16px rgba(59,91,219,0.08);
    overflow: hidden;
    margin-bottom: var(--sp-4);
  }
  .card:last-child { margin-bottom: 0; }
  .card__header {
    padding: var(--sp-4) var(--sp-5);
    border-bottom: 1px solid #F1F5F9;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .card__title {
    font-size: var(--text-base);
    font-weight: var(--weight-black);
    color: #1E293B;
    margin: 0;
  }
  .card__body { padding: var(--sp-5); }
  .card__body--no-pad { padding: 0; overflow: hidden; }

  /* ── Info tab ───────────────────────────────────────────────── */
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
  }
  .info-field { display: flex; flex-direction: column; gap: var(--sp-1); }
  .info-field__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .info-field__value {
    font-size: var(--text-base);
    font-weight: var(--weight-semi);
    color: #1E293B;
    padding: var(--sp-2) var(--sp-3);
    background: #F8FAFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    min-height: 42px;
    display: flex;
    align-items: center;
  }
  .info-field__value--empty { color: #CBD5E1; font-style: italic; }

  /* Edit form */
  .edit-form { display: flex; flex-direction: column; gap: var(--sp-4); }
  .form-group { display: flex; flex-direction: column; gap: var(--sp-2); }
  .form-label { font-size: var(--text-sm); font-weight: var(--weight-bold); color: #334155; }
  .form-input {
    padding: var(--sp-3) var(--sp-4);
    border: 1.5px solid #E2E8F0;
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: #1E293B;
    background: #fff;
    transition: border-color 0.18s;
    width: 100%;
  }
  .form-input:focus { outline: none; border-color: #3B5BDB; box-shadow: 0 0 0 3px rgba(59,91,219,0.1); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .btn-save {
    padding: var(--sp-3) var(--sp-6);
    background: #3B5BDB;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    cursor: pointer;
    transition: background 0.18s, transform 0.1s;
    align-self: flex-start;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .btn-save:hover { background: #3451C5; transform: translateY(-1px); }
  .save-success {
    display: none;
    color: #059669;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    padding: var(--sp-2) var(--sp-3);
    background: #ECFDF5;
    border-radius: 8px;
  }

  /* ── Security rows ──────────────────────────────────────────── */
  .security-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-4) var(--sp-5);
    border-bottom: 1px solid #F1F5F9;
  }
  .security-row:last-child { border-bottom: none; }
  .security-row__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: #1E293B;
  }
  .security-row__desc {
    font-size: var(--text-xs);
    color: #94A3B8;
    margin-top: 2px;
    direction: ltr;
  }
  .btn-outline {
    padding: var(--sp-2) var(--sp-4);
    background: #F0F4FF;
    color: #3B5BDB;
    border: 1.5px solid #C7D2FE;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    cursor: pointer;
    transition: all 0.18s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .btn-outline:hover { background: #EEF2FF; border-color: #3B5BDB; }
  .btn-danger {
    padding: var(--sp-2) var(--sp-4);
    background: #FEF2F2;
    color: #DC2626;
    border: 1.5px solid #FECACA;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    cursor: pointer;
    transition: all 0.18s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .btn-danger:hover { background: #DC2626; color: #fff; border-color: #DC2626; }

  /* ── Driver status card ─────────────────────────────────────── */
  .driver-status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-3) var(--sp-4);
    background: #F8FAFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
  }

  /* ── Orders tab ─────────────────────────────────────────────── */
  .orders-filters {
    display: flex;
    gap: var(--sp-2);
    margin-bottom: var(--sp-4);
    flex-wrap: wrap;
  }
  .orders-filter {
    padding: var(--sp-2) var(--sp-4);
    border: 1.5px solid #E2E8F0;
    border-radius: 50px;
    background: #fff;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: #64748B;
    cursor: pointer;
    transition: all 0.18s;
  }
  .orders-filter:hover { border-color: #3B5BDB; color: #3B5BDB; }
  .orders-filter.is-active { background: #3B5BDB; border-color: #3B5BDB; color: #fff; }

  .order-card {
    background: #fff;
    border: 1px solid #F1F5F9;
    border-radius: 14px;
    padding: var(--sp-4) var(--sp-5);
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    box-shadow: 0 1px 6px rgba(59,91,219,0.05);
    transition: box-shadow 0.18s, transform 0.1s;
    margin-bottom: var(--sp-3);
  }
  .order-card:hover { box-shadow: 0 4px 20px rgba(59,91,219,0.12); transform: translateY(-1px); }
  .order-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #EEF2FF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
  }
  .order-main { flex: 1; min-width: 0; }
  .order-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-bottom: var(--sp-1);
  }
  .order-id { font-size: var(--text-xs); color: #CBD5E1; font-weight: var(--weight-semi); direction: ltr; }
  .order-status-badge {
    padding: 3px 10px;
    border-radius: 50px;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
  }
  .status--delivered  { background: #ECFDF5; color: #059669; }
  .status--pending    { background: #FFFBEB; color: #D97706; }
  .status--active,
  .status--on_the_way,
  .status--accepted,
  .status--in_progress { background: #EEF2FF; color: #3B5BDB; }
  .status--cancelled,
  .status--rejected   { background: #FEF2F2; color: #DC2626; }
  .status--preparing  { background: #FFFBEB; color: #D97706; }
  .status--completed  { background: #ECFDF5; color: #059669; }

  .order-store { font-size: var(--text-base); font-weight: var(--weight-bold); color: #1E293B; margin-bottom: 2px; }
  .order-items { font-size: var(--text-xs); color: #94A3B8; margin-bottom: var(--sp-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .order-footer { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2); }
  .order-date { font-size: var(--text-xs); color: #CBD5E1; }
  .order-total { font-size: var(--text-base); font-weight: var(--weight-black); color: #3B5BDB; }

  /* ── Rides tab ──────────────────────────────────────────────── */
  .ride-card {
    background: #fff;
    border: 1px solid #F1F5F9;
    border-radius: 14px;
    padding: var(--sp-4) var(--sp-5);
    box-shadow: 0 1px 6px rgba(59,91,219,0.05);
    margin-bottom: var(--sp-3);
    transition: box-shadow 0.18s, transform 0.1s;
  }
  .ride-card:hover { box-shadow: 0 4px 20px rgba(59,91,219,0.12); transform: translateY(-1px); }
  .ride-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-3); }
  .ride-route { display: flex; align-items: center; gap: var(--sp-2); flex: 1; }
  .ride-route__icon { font-size: 1.1rem; }
  .ride-route__text { font-size: var(--text-sm); font-weight: var(--weight-bold); color: #1E293B; }
  .ride-route__arrow { color: #3B5BDB; font-weight: var(--weight-black); margin: 0 var(--sp-1); }
  .ride-meta { display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap; }
  .ride-meta__item { display: flex; align-items: center; gap: 4px; font-size: var(--text-xs); color: #94A3B8; }
  .ride-fare { font-size: var(--text-lg); font-weight: var(--weight-black); color: #3B5BDB; }

  /* ── Statistics tab ─────────────────────────────────────────── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }
  .stats-card {
    background: #fff;
    border: 1px solid #F1F5F9;
    border-radius: 14px;
    padding: var(--sp-5);
    box-shadow: 0 1px 6px rgba(59,91,219,0.05);
    text-align: center;
  }
  .stats-card__num {
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    color: #3B5BDB;
    line-height: 1;
    margin-bottom: var(--sp-1);
  }
  .stats-card__label { font-size: var(--text-sm); color: #94A3B8; font-weight: var(--weight-semi); }
  .stats-card--green .stats-card__num { color: #059669; }
  .stats-card--orange .stats-card__num { color: #D97706; }

  /* Category breakdown */
  .category-list { display: flex; flex-direction: column; gap: var(--sp-3); }
  .category-row { display: flex; align-items: center; gap: var(--sp-3); }
  .category-row__label { width: 100px; font-size: var(--text-sm); font-weight: var(--weight-semi); color: #334155; flex-shrink: 0; text-align: right; }
  .category-bar-wrap { flex: 1; height: 10px; background: #F1F5F9; border-radius: 50px; overflow: hidden; }
  .category-bar { height: 100%; border-radius: 50px; background: #3B5BDB; transition: width 0.8s cubic-bezier(.4,0,.2,1); }
  .category-bar--green { background: #059669; }
  .category-bar--orange { background: #D97706; }
  .category-bar--purple { background: #7C3AED; }
  .category-row__count { font-size: var(--text-sm); font-weight: var(--weight-bold); color: #94A3B8; width: 56px; text-align: left; }

  /* Monthly table */
  .monthly-table { width: 100%; border-collapse: collapse; }
  .monthly-table th {
    padding: var(--sp-2) var(--sp-3);
    text-align: right;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: #94A3B8;
    background: #F8FAFF;
    border-bottom: 1px solid #E2E8F0;
  }
  .monthly-table td {
    padding: var(--sp-3);
    text-align: right;
    font-size: var(--text-sm);
    color: #334155;
    border-bottom: 1px solid #F1F5F9;
  }
  .monthly-table tr:last-child td { border-bottom: none; }
  .monthly-table tr:hover td { background: #F8FAFF; }

  /* Empty state */
  .empty-state { text-align: center; padding: var(--sp-12) var(--sp-6); color: #94A3B8; }
  .empty-state__icon { font-size: 3rem; margin-bottom: var(--sp-3); }
  .empty-state__title { font-size: var(--text-lg); font-weight: var(--weight-bold); color: #475569; margin-bottom: var(--sp-2); }
  .empty-state__text { font-size: var(--text-sm); }

  /* ── Toast ──────────────────────────────────────────────────── */
  .toast {
    position: fixed;
    bottom: var(--sp-8);
    left: 50%;
    transform: translateX(-50%) translateY(60px);
    background: #1E293B;
    color: #fff;
    padding: var(--sp-3) var(--sp-5);
    border-radius: 50px;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    z-index: 9999;
    transition: transform 0.3s ease;
    white-space: nowrap;
  }
  .toast.is-visible { transform: translateX(-50%) translateY(0); }

  /* ── Phone-change panel ─────────────────────────────────────── */
  .phone-change-panel {
    display: none;
    padding: var(--sp-4) var(--sp-5);
    background: #F8FAFF;
    border-top: 1px solid #E2E8F0;
  }
  .phone-change-panel.is-open { display: block; }
  .pc-step { display: none; }
  .pc-step.is-active { display: block; }
  .pc-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-black);
    color: #1E293B;
    margin-bottom: var(--sp-3);
  }
  .pc-otp-group {
    display: flex;
    gap: var(--sp-2);
    justify-content: center;
    direction: ltr;
    margin: var(--sp-4) 0;
  }
  .pc-otp-box {
    width: 44px; height: 52px;
    border: 2px solid #E2E8F0;
    border-radius: 10px;
