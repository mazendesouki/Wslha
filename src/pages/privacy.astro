---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="سياسة الخصوصية — وصّلها">
  <PageHero
    eyebrow="سياسة الخصوصية"
    title="كيف نحمي بياناتك"
    subtitle="نلتزم بحماية خصوصية مستخدمي تطبيق وصّلها وتوضيح كيفية جمع بياناتهم واستخدامها."
  />

  <section class="policy">
    <div class="wrap">
      <h2>البيانات التي نجمعها</h2>
      <p>عند استخدامك لتطبيق وصّلها، قد نجمع: الاسم، رقم الهاتف، البريد الإلكتروني (اختياري)، المدينة، وعنوان التوصيل الذي تدخله لكل طلب. بالنسبة لخدمة المشاوير وتتبع السائق، نجمع الموقع الجغرافي (GPS) أثناء الرحلة فقط لأغراض التوصيل والتتبع الحي.</p>

      <h2>كيف نستخدم بياناتك</h2>
      <ul>
        <li>تنفيذ طلبات التوصيل والمشاوير وربطك بالسائق المناسب.</li>
        <li>عرض حالة طلبك وتتبعه بشكل حي.</li>
        <li>إدارة محفظتك الإلكترونية داخل التطبيق (الإيداع والسحب والتحويل).</li>
        <li>التواصل معك بخصوص طلباتك أو دعم العملاء.</li>
      </ul>

      <h2>مشاركة البيانات</h2>
      <p>لا نبيع بياناتك لأي طرف ثالث. تتم مشاركة الحد الأدنى من البيانات (الاسم ورقم الهاتف) فقط بين طرفي الطلب (العميل والسائق أو التاجر) لإتمام عملية التوصيل.</p>

      <h2>أمان البيانات</h2>
      <p>نخزّن كلمات المرور مشفّرة بالكامل (bcrypt) ولا يتم تخزينها أو إرسالها كنص واضح. الوصول إلى بيانات الحسابات مقيّد عبر دوال خادم آمنة، ولا يمكن لأي مستخدم الاطّلاع على بيانات مستخدم آخر.</p>

      <h2>حذف الحساب والبيانات</h2>
      <p>يمكنك طلب حذف حسابك وبياناتك في أي وقت عبر التواصل مع فريق الدعم من داخل التطبيق.</p>

      <h2>التواصل</h2>
      <p>لأي استفسار بخصوص هذه السياسة، يمكنك التواصل معنا عبر وسائل الدعم المتاحة داخل تطبيق وصّلها.</p>
    </div>
  </section>
</Layout>

<style>
  .policy { padding: 3rem 1.5rem 5rem; }
  .wrap { max-width: 760px; margin: 0 auto; }
  h2 { font-size: 1.25rem; font-weight: 800; margin: 2rem 0 .75rem; color: #0F172A; }
  h2:first-child { margin-top: 0; }
  p, li { color: #475569; line-height: 1.9; font-size: .98rem; }
  ul { padding-inline-start: 1.25rem; margin-bottom: 1rem; }
  li { margin-bottom: .5rem; }
</style>
