---
import Layout from '../components/layout.astro';
---

<Layout title="الإعدادات — وصّلها" description="إعدادات حسابك في وصّلها" page="settings">
<style>
  .set-wrap { max-width: 520px; margin: 0 auto; padding: var(--sp-5) var(--sp-4) calc(var(--sp-20) + 40px); background: var(--color-bg); }

  .set-head {
    background: linear-gradient(135deg, #0E4B49 0%, #6D5DF6 55%, #8B5CF6 100%);
    border-radius: 22px; padding: var(--sp-6) var(--sp-5); color: #fff;
    display: flex; align-items: center; gap: var(--sp-4);
    box-shadow: 0 14px 40px rgba(59,110,248,.28); margin-bottom: var(--sp-5);
    position: relative; overflow: hidden;
  }
  .set-head::after { content:''; position:absolute; inset:0; background: radial-gradient(320px 160px at 88% 0%, rgba(255,255,255,.22), transparent 70%); }
  .set-head__avatar { width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0; background: rgba(255,255,255,.2); border: 1.5px solid rgba(255,255,255,.45); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 900; }
  .set-head__name { font-size: 1.2rem; font-weight: 900; }
  .set-head__sub  { font-size: .82rem; opacity: .9; margin-top: 2px; }

  .set-group { background:#fff; border:1px solid var(--color-border); border-radius:18px; overflow:hidden; margin-bottom: var(--sp-4); box-shadow: var(--shadow-sm); }
  .set-group__title { font-size:.72rem; font-weight:800; color:var(--color-text-faint); padding: var(--sp-4) var(--sp-5) var(--sp-2); text-transform:uppercase; letter-spacing:.04em; }

  .set-row { display:flex; align-items:center; gap: var(--sp-3); padding: 14px var(--sp-5); border-top: 1px solid var(--color-border); color: var(--color-text); text-decoration:none; width:100%; background:none; border-left:none; border-right:none; border-bottom:none; font-family: var(--font-body); font-size: .92rem; cursor:pointer; text-align:right; }
  .set-row:first-of-type { border-top:none; }
  .set-row:active { background: var(--color-bg-soft); }
  .set-row__icon { font-size:1.2rem; width:26px; text-align:center; flex-shrink:0; }
  .set-row__label { flex:1; font-weight:700; }
  .set-row__chev { color: var(--color-text-faint); font-size:1.1rem; }
  .set-row--danger { color:#DC2626; } .set-row--danger .set-row__icon { color:#DC2626; }

  .set-toggle { position:relative; width:46px; height:26px; border-radius:99px; background:#CBD5E1; border:none; cursor:pointer; transition:background .25s; flex-shrink:0; }
  .set-toggle.on { background:#16A34A; }
  .set-toggle::after { content:''; position:absolute; top:3px; right:3px; width:20px; height:20px; border-radius:50%; background:#fff; transition:transform .25s; box-shadow:0 1px 3px rgba(0,0,0,.3); }
  .set-toggle.on::after { transform: translateX(-20px); }

  .set-foot { text-align:center; font-size:.75rem; color:var(--color-text-faint); margin-top: var(--sp-5); }
</style>

<div class="set-wrap">
  <div class="set-head">
    <div class="set-head__avatar" id="set-avatar">?</div>
    <div>
      <div class="set-head__name" id="set-name">زائر</div>
      <div class="set-head__sub" id="set-sub">سجّل الدخول لإدارة حسابك</div>
    </div>
  </div>

  <div class="set-group">
    <div class="set-group__title">الحساب</div>
    <a class="set-row" href="/profile"><span class="set-row__icon">👤</span><span class="set-row__label">الملف الشخصي</span><span class="set-row__chev">‹</span></a>
    <a class="set-row" href="/wallet"><span class="set-row__icon">💳</span><span class="set-row__label">المحفظة</span><span class="set-row__chev">‹</span></a>
    <a class="set-row" href="/orders"><span class="set-row__icon">📦</span><span class="set-row__label">طلباتي</span><span class="set-row__chev">‹</span></a>
  </div>

  <div class="set-group">
    <div class="set-group__title">التفضيلات</div>
    <div class="set-row"><span class="set-row__icon">🔔</span><span class="set-row__label">الإشعارات</span><button class="set-toggle" id="tg-notif" type="button" aria-label="تبديل الإشعارات"></button></div>
    <div class="set-row"><span class="set-row__icon">🌐</span><span class="set-row__label">اللغة</span><span style="color:var(--color-text-muted);font-weight:700;font-size:.85rem">العربية</span></div>
  </div>

  <div class="set-group">
    <div class="set-group__title">الدعم</div>
    <a class="set-row" href="/contact"><span class="set-row__icon">💬</span><span class="set-row__label">تواصل معنا</span><span class="set-row__chev">‹</span></a>
    <a class="set-row" href="/about"><span class="set-row__icon">ℹ️</span><span class="set-row__label">عن وصّلها</span><span class="set-row__chev">‹</span></a>
  </div>

  <div class="set-group" id="set-session" style="display:none">
    <button class="set-row set-row--danger" id="btn-logout" type="button"><span class="set-row__icon">🚪</span><span class="set-row__label">تسجيل الخروج</span></button>
  </div>

  <div class="set-group" id="set-login" style="display:none">
    <a class="set-row" href="/login"><span class="set-row__icon">🔑</span><span class="set-row__label">تسجيل الدخول</span><span class="set-row__chev">‹</span></a>
    <a class="set-row" href="/register"><span class="set-row__icon">✨</span><span class="set-row__label">إنشاء حساب جديد</span><span class="set-row__chev">‹</span></a>
  </div>

  <p class="set-foot">وصّلها — خدمة توصيل دمياط · الإصدار 1.0</p>
</div>

<script is:inline>
  (function () {
    var user = null;
    try { user = JSON.parse(localStorage.getItem('wslha_user') || 'null'); } catch (e) {}
    if (user && user.phone) {
      var nm = user.name || user.phone;
      document.getElementById('set-name').textContent = nm;
      document.getElementById('set-sub').textContent = user.phone;
      document.getElementById('set-avatar').textContent = (nm[0] || '؟');
      document.getElementById('set-session').style.display = 'block';
    } else {
      document.getElementById('set-login').style.display = 'block';
    }
    var tg = document.getElementById('tg-notif');
    var on = localStorage.getItem('wslha_notif') !== '0';
    if (on) tg.classList.add('on');
    tg.addEventListener('click', function () { on = !on; tg.classList.toggle('on', on); try { localStorage.setItem('wslha_notif', on ? '1' : '0'); } catch (e) {} });
    var lo = document.getElementById('btn-logout');
    if (lo) lo.addEventListener('click', function () { if (!confirm('تسجيل الخروج من حسابك؟')) return; try { localStorage.removeItem('wslha_user'); } catch (e) {} window.location.href = '/'; });
  })();
</script>
</Layout>
