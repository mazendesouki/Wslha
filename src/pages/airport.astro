---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
import { VEHICLE_TYPES } from '../data/airports';
---

<style>
  .air-wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-10) var(--sp-6) var(--sp-20);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-8);
    align-items: start;
  }

  .air-form {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    padding: var(--sp-8);
  }
  .air-form__step {
    font-size: var(--text-base);
    font-weight: var(--weight-black);
    margin: var(--sp-6) 0 var(--sp-4);
    display: flex; align-items: center; gap: var(--sp-2);
  }
  .air-form__step:first-child { margin-top: 0; }
  .air-form__num {
    width: 26px; height: 26px; border-radius: var(--radius-full);
    background: var(--color-primary); color: #fff; font-size: var(--text-sm);
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .air-step3-head { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); flex-wrap: wrap; margin: var(--sp-6) 0 var(--sp-4); }
  .air-step3-head .air-form__step { margin: 0; }
  .swap-dir-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--color-primary-light); color: var(--color-primary);
    border: 1.5px solid var(--color-border); border-radius: var(--radius-full);
    padding: 6px 14px; font-family: var(--font-body); font-weight: var(--weight-bold);
    font-size: var(--text-xs); cursor: pointer; transition: all 0.2s; white-space: nowrap;
  }
  .swap-dir-btn:hover { border-color: var(--color-primary); background: var(--color-border); }
  .swap-dir-btn:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .swap-dir-btn #swap-direction-icon { display: inline-block; transition: transform 0.3s ease; font-size: 1rem; }
  .swap-dir-btn.is-arrival #swap-direction-icon { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .swap-dir-btn #swap-direction-icon { transition: none; } }
  .air-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .field { margin-bottom: var(--sp-4); }
  .field__label { display: block; font-weight: var(--weight-bold); font-size: var(--text-sm); margin-bottom: var(--sp-2); color: var(--color-text); }
  .field__input, .field__select, .field__textarea {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border); border-radius: var(--radius);
    font-family: var(--font-body); font-size: var(--text-base);
    direction: rtl; background: var(--color-bg); color: var(--color-text); outline: none;
    transition: border-color var(--ease);
  }
  .field__input:focus, .field__select:focus, .field__textarea:focus { border-color: var(--color-primary); }
  .field__hint { font-size: var(--text-xs); color: var(--color-text-faint); margin-top: 4px; }

  .trip-type { display: flex; gap: var(--sp-3); }
  .trip-type label {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
    padding: var(--sp-3); border: 2px solid var(--color-border); border-radius: var(--radius-lg);
    cursor: pointer; font-weight: var(--weight-bold); font-size: var(--text-sm);
  }
  .trip-type label:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-light); color: var(--color-primary); }
  .trip-type input { position: absolute; opacity: 0; }

  .air-divider { border: none; border-top: 1px solid var(--color-border); margin: var(--sp-6) 0; }

  /* Summary panel */
  .air-summary {
    position: sticky;
    top: calc(var(--nav-height) + var(--sp-4));
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .air-summary__head {
    background: var(--color-primary);
    color: #fff; padding: var(--sp-5);
  }
  .air-summary__head h2 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; }
  .air-summary__route { font-size: var(--text-sm); opacity: 0.9; margin-top: 2px; }
  .air-summary__body { padding: var(--sp-5); }

  /* Timeline */
  .timeline { list-style: none; position: relative; padding-inline-start: var(--sp-8); margin-bottom: var(--sp-5); }
  .timeline::before { content: ''; position: absolute; inset-inline-start: 9px; top: 8px; bottom: 8px; width: 2px; background: var(--color-border); }
  .tl-item { position: relative; margin-bottom: var(--sp-5); }
  .tl-item:last-child { margin-bottom: 0; }
  .tl-dot { position: absolute; inset-inline-start: calc(-1 * var(--sp-8) + 2px); top: 2px; width: 18px; height: 18px; border-radius: var(--radius-full); background: var(--color-bg); border: 3px solid var(--color-primary); }
  .tl-item--flight .tl-dot { border-color: var(--color-accent); }
  .tl-label { font-size: var(--text-xs); color: var(--color-text-muted); }
  .tl-time { font-weight: var(--weight-black); font-size: var(--text-base); }
  .tl-sub { font-size: var(--text-xs); color: var(--color-text-faint); }
  .tl-empty { color: var(--color-text-faint); font-size: var(--text-sm); }

  .air-prices { border-top: 1px solid var(--color-border); padding-top: var(--sp-4); }
  .air-prices .row { display: flex; justify-content: space-between; font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--sp-2); }
  .air-prices .total { display: flex; justify-content: space-between; align-items: baseline; margin-top: var(--sp-3); padding-top: var(--sp-3); border-top: 2px solid var(--color-border); }
  .air-prices .total b { font-size: var(--text-3xl); font-weight: var(--weight-black); color: var(--color-primary); line-height: 1; }
  .air-prices .total b small { font-size: var(--text-sm); }

  .air-error { background: #FEE2E2; color: #B91C1C; border-radius: var(--radius); padding: var(--sp-3) var(--sp-4); font-size: var(--text-sm); margin: var(--sp-4) 0 0; display: none; }
  .air-error.is-visible { display: block; }

  .air-submit {
    width: 100%; margin-top: var(--sp-5); padding: var(--sp-4);
    background: var(--color-accent); color: var(--color-text); border: none; border-radius: var(--radius);
    font-family: var(--font-body); font-weight: var(--weight-black); font-size: var(--text-base);
  }
  .air-submit:hover:not(:disabled) { background: var(--color-accent-dark); }
  .air-submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .air-submit:focus-visible, .loc-btn:focus-visible, .veh-card:focus-visible {
    outline: 3px solid var(--color-primary); outline-offset: 2px;
  }
  .trip-type label:has(input:focus-visible) { outline: 3px solid var(--color-primary); outline-offset: 2px; }
  .air-note { font-size: var(--text-xs); color: var(--color-text-faint); text-align: center; margin-top: var(--sp-3); }

  /* ── Success Screen ───────────────────────────────────── */
  .air-success {
    display: none;
    max-width: 520px;
    margin: var(--sp-12) auto var(--sp-20);
    padding: 0 var(--sp-4);
    text-align: center;
  }
  .air-success.is-visible { display: block; }

  .air-success__check {
    width: 80px; height: 80px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #16a34a, #22c55e);
    display: flex; align-items: center; justify-content: center;
    font-size: 2.2rem;
    margin: 0 auto var(--sp-5);
    box-shadow: 0 8px 24px rgba(22,163,74,0.3);
  }

  .air-success__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    color: var(--color-text);
    margin-bottom: var(--sp-2);
  }

  .air-success__sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--sp-5);
  }

  .air-success__id-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--color-primary-light);
    border: 1.5px dashed var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--sp-2) var(--sp-5);
    margin-bottom: var(--sp-7);
  }

  .air-success__id-label { font-size: var(--text-xs); color: var(--color-text-muted); font-weight: var(--weight-semi); }
  .air-success__id-val   { font-size: var(--text-base); font-weight: var(--weight-black); color: var(--color-primary); letter-spacing: 0.5px; }

  /* Confirmation card */
  .air-success__card {
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: var(--sp-6);
    text-align: right;
    box-shadow: var(--shadow-sm);
  }

  /* card-header + rows are injected at runtime via innerHTML, so they must be
     :global — Astro's scoped [data-astro-cid] attribute is NOT added to JS-inserted nodes */
  .air-success__card :global(.air-success__card-header) {
    background: var(--color-primary);
    color: #fff;
    padding: var(--sp-4) var(--sp-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .air-success__card :global(.row) {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .air-success__card :global(.row:last-child) { border-bottom: none; }
  .air-success__card :global(.row-label) {
    color: var(--color-text-muted);
    font-weight: var(--weight-semi);
    white-space: nowrap;
  }
  .air-success__card :global(.row-val) {
    font-weight: var(--weight-bold);
    color: var(--color-text);
    text-align: left;
  }
  .air-success__card :global(.row--total) {
    background: var(--color-primary-light);
    font-size: var(--text-base);
  }
  .air-success__card :global(.row--total .row-label) { color: var(--color-primary); font-weight: var(--weight-black); }
  .air-success__card :global(.row--total .row-val)   { color: var(--color-primary); font-size: var(--text-lg); }

  .air-success__actions {
    display: flex;
    gap: var(--sp-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .air-wrap { grid-template-columns: 1fr; }
    .air-summary { position: static; }
    .air-row { grid-template-columns: 1fr; }
  }
  /* ensure Google Places dropdown appears above everything */
  .pac-container { z-index: 9999 !important; direction: rtl; font-family: var(--font-body); }
  .loc-wrap { display: flex; align-items: center; gap: 8px; }
  .loc-wrap .field__input { flex: 1; }
  .loc-btn {
    width: 38px; height: 38px; flex-shrink: 0;
    border: 1.5px solid var(--color-border); border-radius: var(--radius);
    background: var(--color-bg-soft); cursor: pointer; font-size: 0.95rem;
    display: flex; align-items: center; justify-content: center; transition: all 0.2s;
  }
  .loc-btn:hover { background: var(--color-primary-light); border-color: var(--color-primary); }
  /* Airport search dropdown */
  .airport-wrap { position: relative; }
  .airport-list {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0;
    background: var(--color-bg); border: 1.5px solid var(--color-primary);
    border-radius: var(--radius); max-height: 220px; overflow-y: auto;
    z-index: 1000; list-style: none; margin: 0;
    box-shadow: var(--shadow-md); display: none;
  }
  .airport-list.is-open { display: block; }
  .airport-list li {
    padding: var(--sp-3) var(--sp-4); cursor: pointer; font-size: var(--text-sm);
    border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;
  }
  .airport-list li:last-child { border-bottom: none; }
  .airport-list li:hover, .airport-list li.focused { background: var(--color-primary-light); color: var(--color-primary); }
  .airport-list__code { font-weight: var(--weight-black); font-size: 11px; color: var(--color-primary); background: var(--color-primary-light); padding: 2px 6px; border-radius: 4px; }
  .airport-list__km { color: var(--color-text-faint); font-size: 11px; }
  .airport-selected { border-color: var(--color-primary) !important; }

  /* vehicle cards */
  .veh-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); }
  .veh-card {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: var(--sp-4) var(--sp-3); border: 2px solid var(--color-border);
    border-radius: var(--radius-lg); background: var(--color-bg-soft);
    cursor: pointer; transition: all 0.2s; font-family: var(--font-body);
    text-align: center;
  }
  .veh-card--active { border-color: var(--color-primary); background: var(--color-primary-light); }
  .veh-card:hover:not(.veh-card--active) { border-color: var(--color-primary); }
  .veh-card__icon { font-size: 1.8rem; }
  .veh-card__name { font-weight: var(--weight-black); font-size: var(--text-sm); color: var(--color-text); }
  .veh-card__desc { font-size: 10px; color: var(--color-text-faint); }
  .veh-card__cap { font-size: 10px; color: var(--color-text-muted); margin-top: 2px; }
  .veh-card--active .veh-card__name { color: var(--color-primary); }
  @media (max-width: 480px) { .veh-grid { grid-template-columns: 1fr; } }
  /* timeline new items */
  .tl-item--depart .tl-dot { border-color: #16a34a; }
  .tl-item--arrive .tl-dot { border-color: #0ea5e9; }
  .tl-item--checkin .tl-dot { border-color: #f59e0b; }
  .tl-badge { display: inline-block; font-size: 10px; padding: 1px 6px; border-radius: 99px; }
  .tl-badge--ok { background: #dcfce7; color: #16a34a; }
  .tl-badge--warn { background: #fef3c7; color: #92400e; }
</style>

<Layout
  title="توصيل المطار"
  description="خدمة توصيل من دمياط إلى جميع مطارات مصر — أدخل وقت إقلاع رحلتك ونحسب لك وقت المغادرة تلقائياً"
  page="airport"
>
  <PageHero
    badge="توصيل المطار"
    title="من دمياط إلى كل مطارات مصر"
    subtitle="أدخل بيانات رحلتك ووقت الإقلاع — ونحسب لك وقت المغادرة المثالي تلقائياً مع سعر ثابت حسب المسافة"
  />

  <div class="air-wrap" id="air-wrap">

    <!-- Form -->
    <form class="air-form" id="air-form">

      <!-- قسم 1: نوع الرحلة -->
      <h2 class="air-form__step"><span class="air-form__num">1</span> نوع الرحلة</h2>
      <div class="field">
        <span class="field__label">اتجاه الرحلة</span>
        <div class="trip-type">
          <label><input type="radio" name="direction" value="departure" id="dir-departure" checked>🛫 مغادر من مصر</label>
          <label><input type="radio" name="direction" value="arrival" id="dir-arrival">🛬 قادم إلى مصر</label>
        </div>
        <p class="field__hint">مغادر: هنوصّلك من دمياط للمطار. قادم: هنستقبلك من المطار ونوصّلك لدمياط.</p>
      </div>
      <div class="field">
        <span class="field__label">نوع الرحلة</span>
        <div class="trip-type">
          <label><input type="radio" name="trip" value="international" checked>✈️ دولية (3 ساعات)</label>
          <label><input type="radio" name="trip" value="domestic">🛫 محلية (ساعتان)</label>
        </div>
        <p class="field__hint" id="trip-type-hint">نستخدمها لحساب الوقت اللازم للوصول قبل الإقلاع.</p>
      </div>

      <hr class="air-divider">

      <!-- قسم 2: اختيار السيارة -->
      <h2 class="air-form__step"><span class="air-form__num">2</span> اختيار السيارة</h2>
      <div class="veh-grid">
        <button type="button" class="veh-card veh-card--active" data-veh="sedan">
          <span class="veh-card__icon">🚗</span>
          <span class="veh-card__name">سيدان</span>
          <span class="veh-card__desc">تويوتا / هيونداي</span>
          <span class="veh-card__cap">👤 ٣ ركاب • 🧳 ٢ شنطة</span>
        </button>
        <button type="button" class="veh-card" data-veh="suv">
          <span class="veh-card__icon">🚙</span>
          <span class="veh-card__name">SUV / كروز</span>
          <span class="veh-card__desc">لاند كروزر / باترول</span>
          <span class="veh-card__cap">👥 ٦ ركاب • 🧳 ٤ شنط</span>
        </button>
        <button type="button" class="veh-card" data-veh="van">
          <span class="veh-card__icon">🚐</span>
          <span class="veh-card__name">ميكروباص</span>
          <span class="veh-card__desc">H1 / سبرينتر</span>
          <span class="veh-card__cap">👥 ١٠ ركاب • 🧳 ٨ شنط</span>
        </button>
      </div>
      <p class="field__hint" id="veh-hint">تم اختيار السيدان — ٣ ركاب بحد أقصى، شنطتان مجانيتان</p>

      <div class="air-row">
        <div class="field">
          <label class="field__label" for="veh-model">الماركة والموديل</label>
          <select id="veh-model" class="field__select"></select>
        </div>
        <div class="field">
          <label class="field__label" for="veh-year">سنة الصنع</label>
          <select id="veh-year" class="field__select"></select>
        </div>
      </div>
      <p class="field__hint" id="veh-rate-hint"></p>

      <hr class="air-divider">

      <!-- قسم 3: نقطة البداية والوصول -->
      <div class="air-step3-head">
        <h2 class="air-form__step"><span class="air-form__num">3</span> نقطة البداية والوصول</h2>
        <button type="button" class="swap-dir-btn" id="swap-direction-btn" title="بدّل بين مغادر وقادم">
          <span id="swap-direction-icon" aria-hidden="true">⇄</span>
          <span id="swap-direction-text">التبديل لوضع القادم</span>
        </button>
      </div>

      <div class="air-row">
        <div class="field">
          <label class="field__label" for="from-area" id="from-area-label">نقطة البداية (منطقتك)</label>
          <div class="loc-wrap">
            <input type="text" class="field__input" id="from-area" placeholder="اكتب منطقتك أو حيّك في دمياط..." autocomplete="off" />
            <button type="button" class="loc-btn" id="btn-air-loc" title="موقعي الحالي" aria-label="استخدم موقعي الحالي">📍</button>
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="airport-input" id="airport-label">المطار (نقطة النهاية)</label>
          <div class="airport-wrap">
            <input type="text" class="field__input" id="airport-input" placeholder="ابحث باسم المطار: مطار القاهرة، مطار شرم الشيخ..." autocomplete="off" />
            <ul class="airport-list" id="airport-list" role="listbox" hidden></ul>
          </div>
          <p class="field__hint" id="airport-hint">بحث حي بموقع المطار الفعلي — المسافة والسعر تُحسب تلقائياً.</p>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="address">عنوان الاستلام بالتفصيل</label>
        <textarea class="field__textarea" id="address" placeholder="الحي، الشارع، رقم المبنى، علامة مميزة..."></textarea>
      </div>

      <div class="field">
        <label class="field__label" for="flight-time" id="flight-time-label">تاريخ ووقت إقلاع الطائرة</label>
        <input class="field__input" id="flight-time" type="datetime-local">
        <p class="field__hint" id="flight-time-hint">سنحسب لك وقت المغادرة من بيتك ووقت الوصول للمطار تلقائياً.</p>
      </div>

      <hr class="air-divider">

      <!-- قسم 4: الركاب والأمتعة -->
      <h2 class="air-form__step"><span class="air-form__num">4</span> الركاب والأمتعة</h2>

      <div class="air-row">
        <div class="field">
          <label class="field__label" for="passengers">عدد المسافرين (يطيرون)</label>
          <input class="field__input" id="passengers" type="number" min="1" max="3" value="1">
        </div>
        <div class="field">
          <label class="field__label" for="companions">مرافق رايح جاي 🔄</label>
          <input class="field__input" id="companions" type="number" min="0" max="9" value="0">
          <p class="field__hint">شخص يرافق ويرجع مع السيارة — ٢٥٠ ج.م للفرد</p>
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="bags">شنط كبيرة (تُسجَّل في الطائرة)</label>
        <input class="field__input" id="bags" type="number" min="0" max="2" value="1">
        <p class="field__hint" id="bags-hint">شنطتان مجانيتان مع السيدان • كل شنطة إضافية ٢٥ ج.م</p>
      </div>

      <hr class="air-divider">

      <!-- قسم 5: أوقات الانتظار -->
      <h2 class="air-form__step"><span class="air-form__num">5</span> أوقات الانتظار</h2>

      <div class="air-row">
        <div class="field">
