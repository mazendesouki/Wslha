        <div class="air-prices">
          <div class="row"><span>المسافة</span><span id="p-distance">—</span></div>
          <div class="row"><span>سعر المسافة</span><span id="p-base">—</span></div>
          <div class="row" id="p-veh-row" hidden><span id="p-veh-label">رسوم السيارة</span><span id="p-veh">—</span></div>
          <div class="row" id="p-bags-row" hidden><span>شنط إضافية</span><span id="p-bags">—</span></div>
          <div class="row" id="p-comp-row" hidden><span id="p-comp-label">مرافق رايح جاي</span><span id="p-comp">—</span></div>
          <div class="row" id="p-wpick-row" hidden><span>انتظار عند الاستلام</span><span id="p-wpick">—</span></div>
          <div class="row" id="p-wair-row" hidden><span>انتظار في ساحة المطار</span><span id="p-wair">—</span></div>
          <div class="total"><span>الإجمالي</span><b id="p-total">— <small>ج.م</small></b></div>
        </div>

        <div class="air-error" id="air-error" role="alert" aria-live="polite"></div>
        <button type="submit" form="air-form" class="air-submit" id="air-submit">تأكيد الحجز ←</button>
        <p class="air-note">سعر ثابت حسب المسافة — الدفع نقداً أو إلكترونياً</p>
      </div>
    </aside>
  </div>

  <script type="application/json" id="vehicles-json" set:html={JSON.stringify(VEHICLE_TYPES)}></script>

  <!-- Success -->
  <section class="air-success" id="air-success" role="alert" aria-live="polite" tabindex="-1">
    <div class="air-success__check" aria-hidden="true">✅</div>
    <h2 class="air-success__title">تم تأكيد حجز رحلتك!</h2>
    <p class="air-success__sub">سيصلك السائق في الموعد المحدد.</p>

    <div class="air-success__id-wrap">
      <span class="air-success__id-label">رقم الحجز</span>
      <span class="air-success__id-val" id="air-success-id">—</span>
    </div>

    <div class="air-success__card" id="air-success-card">
      <div class="air-success__card-header">✈️ تفاصيل الرحلة</div>
    </div>

    <div class="air-success__actions">
      <a href="/orders" class="btn btn--primary">📋 طلباتي</a>
      <a href="/track"  class="btn btn--outline" id="air-success-track">📡 تتبع الطلب</a>
    </div>
  </section>

  <script>
    import { CHECKIN_BUFFER, SAFETY_MARGIN, ARRIVAL_BUFFER, DRIVER_ARRIVAL_BEFORE_LANDING, DAMIETTA_ORIGIN, VEHICLE_TYPES, VEHICLE_MODELS, fareForVehicle, ratePerKmFor, fetchRegisteredVehicles, EXTRA_BAG_FEE, COMPANION_FEE, WAIT_PICKUP_FREE, WAIT_PICKUP_PER15, WAIT_AIRPORT_FREE, WAIT_AIRPORT_PER30 } from '../data/airports';
    import { isEgyptianMobile, normalizeEgyptianPhone, EG_PHONE_ERROR } from '../utils/phone';

    const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';

    const $ = (id: string) => document.getElementById(id)!;
    const form = $('air-form') as HTMLFormElement;
    const flightInput = $('flight-time') as HTMLInputElement;
    const errBox = $('air-error') as HTMLElement;

    // ── Vehicle selection ──
    interface VehicleType { id: string; name: string; maxTravelers: number; maxBags: number; freeBags: number; surcharge: number; }
    const VEHICLES_DATA: VehicleType[] = JSON.parse((document.getElementById('vehicles-json') as HTMLScriptElement).textContent || '[]');
    let selectedVehicle: VehicleType = VEHICLES_DATA[0] || { id: 'sedan', name: 'سيدان', maxTravelers: 3, maxBags: 2, freeBags: 2, surcharge: 0 };

    // ── vehicle model/year selection: من سائقين معتمدين فعليًا في قاعدة البيانات ──
    interface VehicleModel { id: string; category: string; name: string; yearFrom: number; yearTo: number; }
    const vehModelSel = $('veh-model') as HTMLSelectElement;
    const vehYearSel  = $('veh-year') as HTMLSelectElement;
    let REGISTERED_VEHICLES: VehicleModel[] = [];
    let selVehModel: VehicleModel = (VEHICLE_MODELS as VehicleModel[]).find(m => m.category === 'sedan') || (VEHICLE_MODELS as VehicleModel[])[0];
    let selVehYear = 2022;

    function populateVehModels(cat: string): void {
      const models = REGISTERED_VEHICLES.filter(m => m.category === cat);
      vehModelSel.innerHTML = models.map(m => `<option value="${m.id}">${m.name}</option>`).join('');
      selVehModel = models[0] || selVehModel;
      populateVehYears();
    }
    function populateVehYears(): void {
      const years: number[] = [];
      for (let y = selVehModel.yearTo; y >= selVehModel.yearFrom; y--) years.push(y);
      vehYearSel.innerHTML = years.map(y => `<option value="${y}"${y === 2022 ? ' selected' : ''}>${y}</option>`).join('');
      selVehYear = parseInt(vehYearSel.value, 10) || years[0];
      updateVehRateHint();
    }
    function updateVehRateHint(): void {
      const h = $('veh-rate-hint');
      if (h) h.textContent = `${selVehModel.name} ${selVehYear} — ${ratePerKmFor('airport', selVehModel, selVehYear).toFixed(1)} ج.م/كم`;
    }
    vehModelSel.addEventListener('change', () => {
      selVehModel = REGISTERED_VEHICLES.find(m => m.id === vehModelSel.value) || selVehModel;
      populateVehYears();
      render();
    });
    vehYearSel.addEventListener('change', () => {
      selVehYear = parseInt(vehYearSel.value, 10) || selVehYear;
      updateVehRateHint();
      render();
    });

    async function initRegisteredVehicles(): Promise<void> {
      REGISTERED_VEHICLES = await fetchRegisteredVehicles();
      const availableCats = new Set(REGISTERED_VEHICLES.map(v => v.category));
      let firstAvailable: string | null = null;
      document.querySelectorAll('.veh-card').forEach(card => {
        const cat = (card as HTMLElement).dataset.veh!;
        const has = availableCats.has(cat);
        (card as HTMLElement).hidden = !has;
        if (has && !firstAvailable) firstAvailable = cat;
      });
      if (!firstAvailable) {
        vehModelSel.innerHTML = '';
        vehYearSel.innerHTML = '';
        const h = $('veh-rate-hint');
        if (h) h.textContent = 'لا يوجد سائقون معتمدون حاليًا — حاول لاحقًا.';
        (document.getElementById('air-submit') as HTMLButtonElement).disabled = true;
        return;
      }
      document.querySelectorAll('.veh-card').forEach(c => c.classList.remove('veh-card--active'));
      const activeCard = document.querySelector(`.veh-card[data-veh="${firstAvailable}"]`);
      activeCard?.classList.add('veh-card--active');
      populateVehModels(firstAvailable);
    }
    initRegisteredVehicles();

    // ── Trip direction (مغادر / قادم) ──
    function direction(): 'departure' | 'arrival' {
      return (form.querySelector('input[name="direction"]:checked') as HTMLInputElement)?.value === 'arrival' ? 'arrival' : 'departure';
    }

    function applyDirectionLabels(): void {
      const dep = direction() === 'departure';
      ($('from-area-label') as HTMLElement).textContent = dep ? 'نقطة البداية (منطقتك)' : 'وجهتك (منطقتك)';
      ($('airport-label') as HTMLElement).textContent = dep ? 'المطار (نقطة النهاية)' : 'المطار (نقطة البداية)';
      ($('flight-time-label') as HTMLElement).textContent = dep ? 'تاريخ ووقت إقلاع الطائرة' : 'تاريخ ووقت هبوط الطائرة';
      ($('flight-time-hint') as HTMLElement).textContent = dep
        ? 'سنحسب لك وقت المغادرة من بيتك ووقت الوصول للمطار تلقائياً.'
        : 'سنحسب لك موعد وصول السائق للمطار وموعد وصولك المتوقع لوجهتك تلقائياً.';
      ($('trip-type-hint') as HTMLElement).textContent = dep
        ? 'نستخدمها لحساب الوقت اللازم للوصول قبل الإقلاع.'
        : 'نستخدمها لحساب وقت استلام الأمتعة بعد الهبوط.';
      ($('flight-country-label') as HTMLElement).textContent = dep ? 'مسافر إلى (الدولة)' : 'قادم من (الدولة)';
      // Waiting-at-airport-lounge fee only applies when we drop you off and wait to see you through — not relevant for arrivals.
      ($('wait-airport-field') as HTMLElement).hidden = !dep;
      ($('timeline-departure') as HTMLElement).hidden = !dep;
      ($('timeline-arrival') as HTMLElement).hidden = dep;

      const swapBtn = $('swap-direction-btn') as HTMLElement;
      swapBtn.classList.toggle('is-arrival', !dep);
      ($('swap-direction-text') as HTMLElement).textContent = dep ? 'التبديل لوضع القادم' : 'التبديل لوضع المغادر';
    }

    form.querySelectorAll('input[name="direction"]').forEach(r => r.addEventListener('change', () => { applyDirectionLabels(); render(); }));
    $('swap-direction-btn').addEventListener('click', () => {
      const target = direction() === 'departure' ? 'dir-arrival' : 'dir-departure';
      const radio = $(target) as HTMLInputElement;
      radio.checked = true;
      radio.dispatchEvent(new Event('change', { bubbles: true }));
    });
    applyDirectionLabels();

    // ── Airport search (live Google Places — any real airport, precise location) ──
    interface SelectedAirport { name: string; lat: number; lng: number; distanceKm: number; driveMinutes: number; }
    let selectedAirport: SelectedAirport | null = null;
    let airportLookupToken = 0;

    const airportInput = $('airport-input') as HTMLInputElement;
    const airportList = $('airport-list') as HTMLUListElement;
    airportList.hidden = true; // dropdown no longer used for search — Places supplies its own UI

    // ── Google Places (shared loader for from-area + airport) ──
    let fromAreaPlace: { name: string; lat: number; lng: number } | null = null;

    function loadGoogleMaps(): Promise<void> {
      return new Promise((resolve, reject) => {
        if ((window as any).google?.maps) { resolve(); return; }
        (window as any).__airGmInit = resolve;
        const s = document.createElement('script');
        s.src = `https://maps.googleapis.com/maps/api/js?key=${GMAPS_KEY}&libraries=places&callback=__airGmInit&language=ar&region=EG`;
        s.async = true;
        s.onerror = () => reject(new Error('gmaps_failed'));
        document.head.appendChild(s);
      });
    }

    function setAirportHint(msg: string, isError = false): void {
      const hint = $('airport-hint') as HTMLElement;
      hint.textContent = msg;
      hint.style.color = isError ? '#B91C1C' : 'var(--color-text-faint)';
    }

    function computeDistance(lat: number, lng: number): Promise<{ distanceKm: number; driveMinutes: number }> {
      return new Promise((resolve, reject) => {
        const G = (window as any).google.maps;
        const svc = new G.DistanceMatrixService();
        svc.getDistanceMatrix({
          origins: [DAMIETTA_ORIGIN],
          destinations: [{ lat, lng }],
          travelMode: 'DRIVING',
        }, (res: any, status: string) => {
          if (status !== 'OK') { reject(new Error(status)); return; }
          const el = res?.rows?.[0]?.elements?.[0];
          if (!el || el.status !== 'OK') { reject(new Error('no_route')); return; }
          resolve({ distanceKm: Math.round(el.distance.value / 1000), driveMinutes: Math.round(el.duration.value / 60) });
        });
      });
    }

    async function selectAirportPlace(name: string, lat: number, lng: number): Promise<void> {
      const token = ++airportLookupToken;
      selectedAirport = null;
      airportInput.classList.remove('airport-selected');
      setAirportHint('جارٍ حساب المسافة والوقت من دمياط…');
      render();
      try {
        const { distanceKm, driveMinutes } = await computeDistance(lat, lng);
        if (token !== airportLookupToken) return; // a newer selection superseded this one
        selectedAirport = { name, lat, lng, distanceKm, driveMinutes };
        airportInput.classList.add('airport-selected');
        setAirportHint(`${distanceKm} كم من دمياط — ~${Math.round(driveMinutes)} دقيقة بالسيارة`);
      } catch {
        if (token !== airportLookupToken) return;
        setAirportHint('تعذّر حساب المسافة لهذا المطار — جرّب مطاراً آخر أو تأكد من اتصالك بالإنترنت.', true);
      }
      render();
    }

    async function initAutocompletes(): Promise<void> {
      try {
        await loadGoogleMaps();
      } catch {
        setAirportHint('تعذّر تحميل خرائط جوجل — تحقق من اتصالك بالإنترنت.', true);
        return;
      }
      const G = (window as any).google.maps;

      // Soft bias toward Damietta for the "from-area" field — user can search anywhere in Egypt
      const damiettaBias = new G.LatLngBounds({ lat: 31.20, lng: 31.50 }, { lat: 31.65, lng: 32.10 });
      const fromAc = new G.places.Autocomplete(document.getElementById('from-area'), {
        bounds: damiettaBias,
        componentRestrictions: { country: 'eg' },
        strictBounds: false,
        types: [],
        fields: ['geometry', 'name', 'formatted_address'],
      });
      fromAc.addListener('place_changed', () => {
        const p = fromAc.getPlace();
        if (!p?.geometry?.location) return;
        fromAreaPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
        render();
      });

      // Live airport search — any real airport in Egypt, precise coordinates
      const airportAc = new G.places.Autocomplete(airportInput, {
        componentRestrictions: { country: 'eg' },
        types: ['airport'],
        fields: ['geometry', 'name', 'formatted_address'],
      });
      airportAc.addListener('place_changed', () => {
        const p = airportAc.getPlace();
        if (!p?.geometry?.location) { setAirportHint('اختر مطاراً من نتائج البحث.', true); return; }
        selectAirportPlace(p.name || p.formatted_address, p.geometry.location.lat(), p.geometry.location.lng());
      });
    }

    initAutocompletes();

    airportInput.addEventListener('input', () => {
      if (selectedAirport && airportInput.value !== selectedAirport.name) {
        selectedAirport = null;
        airportInput.classList.remove('airport-selected');
        setAirportHint('بحث حي بموقع المطار الفعلي — المسافة والسعر تُحسب تلقائياً.');
        render();
      }
    });

    document.getElementById('btn-air-loc')?.addEventListener('click', () => {
      if (!navigator.geolocation) return;
      const btn = document.getElementById('btn-air-loc')!;
      btn.textContent = '⏳';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          fromAreaPlace = { name: 'موقعي الحالي', lat: pos.coords.latitude, lng: pos.coords.longitude };
          (document.getElementById('from-area') as HTMLInputElement).value = 'موقعي الحالي';
          btn.textContent = '✅';
          render();
          setTimeout(() => { btn.textContent = '📍'; }, 2000);
        },
        () => { btn.textContent = '📍'; }
      );
    });

    // Minimum datetime = now + 2h
    const min = new Date(Date.now() + 2 * 3600 * 1000);
    flightInput.min = new Date(min.getTime() - min.getTimezoneOffset() * 60000).toISOString().slice(0, 16);

    function fmtDateTime(d: Date): string {
      return new Intl.DateTimeFormat('ar-EG', {
        weekday: 'short', day: 'numeric', month: 'long',
        hour: 'numeric', minute: '2-digit', hour12: true,
      }).format(d);
    }
    function minutesToText(m: number): string {
      const h = Math.floor(m / 60), mm = m % 60;
      if (h && mm) return `${h} ساعة و${mm} دقيقة`;
      if (h) return `${h} ساعة`;
      return `${mm} دقيقة`;
    }

    interface Calc {
      distance: number; drive: number;
      base: number; vehLabel: string; extraBags: number; companionFee: number; waitPickupFee: number; waitAirportFee: number;
      total: number; buffer: number;
      // departure fields
      flight?: Date; arrive?: Date; depart?: Date; driverArrival?: Date; checkinDeadline?: Date;
      // arrival fields
      land?: Date; ready?: Date; leaveAirport?: Date; home?: Date;
    }

    function calc(): Calc {
      const dep = direction() === 'departure';
      const distance = selectedAirport ? selectedAirport.distanceKm : 0;
      const drive = selectedAirport ? selectedAirport.driveMinutes : 0;
      const trip = (form.querySelector('input[name="trip"]:checked') as HTMLInputElement).value as 'domestic' | 'international';
      const buffer = dep
        ? (trip === 'international' ? CHECKIN_BUFFER.international : CHECKIN_BUFFER.domestic)
        : (trip === 'international' ? ARRIVAL_BUFFER.international : ARRIVAL_BUFFER.domestic);
      const bags = Math.max(0, Number(($('bags') as HTMLInputElement).value) || 0);
      const companions = Math.max(0, Number(($('companions') as HTMLInputElement).value) || 0);
      const waitPickupMins = Number(($('wait-pickup') as HTMLSelectElement).value) || 0;
      const waitAirportMins = dep ? (Number(($('wait-airport') as HTMLSelectElement).value) || 0) : 0;

      const base = distance ? fareForVehicle(distance, selVehModel, selVehYear) : 0;
      const vehLabel = `${selVehModel.name} ${selVehYear}`;
      const extraBags = Math.max(0, bags - selectedVehicle.freeBags) * EXTRA_BAG_FEE;
      const companionFee = companions * COMPANION_FEE;
      const waitPickupFee = Math.max(0, Math.floor((waitPickupMins - WAIT_PICKUP_FREE) / 15)) * WAIT_PICKUP_PER15;
      const waitAirportFee = Math.max(0, Math.floor((waitAirportMins - WAIT_AIRPORT_FREE) / 30)) * WAIT_AIRPORT_PER30;
      const total = base + extraBags + companionFee + waitPickupFee + waitAirportFee;

      const result: Calc = { distance, drive, base, vehLabel, extraBags, companionFee, waitPickupFee, waitAirportFee, total, buffer };
      if (!flightInput.value || !distance) return result;
      const flight = new Date(flightInput.value);
      if (isNaN(flight.getTime())) return result;

      if (dep) {
        const checkinClose = trip === 'international' ? 60 : 40;
        result.checkinDeadline = new Date(flight.getTime() - checkinClose * 60000);
        result.arrive = new Date(flight.getTime() - buffer * 60000);
        result.depart = new Date(result.arrive.getTime() - (drive + SAFETY_MARGIN) * 60000);
        result.driverArrival = new Date(result.depart.getTime() - waitPickupMins * 60000);
        result.flight = flight;
      } else {
        result.land = flight;
        result.ready = new Date(flight.getTime() + buffer * 60000);
        result.leaveAirport = result.ready;
        result.home = new Date(result.leaveAirport.getTime() + (drive + SAFETY_MARGIN) * 60000);
      }
      return result;
    }

    function render(): void {
      const c = calc();
      const dep = direction() === 'departure';
      const fromArea = fromAreaPlace?.name || (document.getElementById('from-area') as HTMLInputElement).value || '';

      // Route
      $('sum-route').textContent = selectedAirport
        ? (dep ? `${fromArea} ← ${selectedAirport.name}` : `${selectedAirport.name} ← ${fromArea}`)
        : (dep ? 'اختر المطار ووقت الإقلاع' : 'اختر المطار ووقت الهبوط');

      if (dep) {
        const hasTime = !!c.flight;
        $('tl-empty').hidden = hasTime;
        ['tl-driver', 'tl-depart', 'tl-arrive', 'tl-checkin', 'tl-flight'].forEach(id => ($(id) as HTMLElement).hidden = !hasTime);
        if (hasTime) {
          if (c.driverArrival) { $('tl-driver-time').textContent = fmtDateTime(c.driverArrival); $('tl-driver-sub').textContent = 'موعد وصول السائق لاستلامك'; }
          if (c.depart)        { $('tl-depart-time').textContent  = fmtDateTime(c.depart);        $('tl-depart-sub').textContent  = `زمن الطريق ~${minutesToText(c.drive)} + هامش أمان`; }
          if (c.arrive)        { $('tl-arrive-time').textContent  = fmtDateTime(c.arrive);         $('tl-arrive-sub').textContent  = `قبل الإقلاع بـ ${minutesToText(c.buffer)}`; }
          if (c.checkinDeadline) { $('tl-checkin-time').textContent = fmtDateTime(c.checkinDeadline); $('tl-checkin-sub').textContent = 'آخر موعد لتسليم الأمتعة عند الكاونتر'; }
          $('tl-flight-time').textContent = fmtDateTime(c.flight!);
        }
      } else {
        const hasTime = !!c.land;
        $('tl-empty-arr').hidden = hasTime;
        ['tl-land', 'tl-ready', 'tl-leave-airport', 'tl-home'].forEach(id => ($(id) as HTMLElement).hidden = !hasTime);
        if (hasTime) {
          $('tl-land-time').textContent = fmtDateTime(c.land!);
          if (c.ready) { $('tl-ready-time').textContent = fmtDateTime(c.ready); $('tl-ready-sub').textContent = `هامش ${minutesToText(c.buffer)} للجوازات واستلام الأمتعة`; }
          if (c.leaveAirport) { $('tl-leave-airport-time').textContent = fmtDateTime(c.leaveAirport); }
          if (c.home) { $('tl-home-time').textContent = fmtDateTime(c.home); $('tl-home-sub').textContent = `زمن الطريق ~${minutesToText(c.drive)} + هامش أمان`; }
        }
      }

      // Prices
      $('p-distance').textContent = c.distance ? `${c.distance} كم` : '—';
      $('p-base').textContent = c.base ? `${c.base} ج.م` : '—';

      const vehRow = $('p-veh-row') as HTMLElement;
      vehRow.hidden = !c.distance;
      ($('p-veh-label') as HTMLElement).textContent = 'السيارة';
      $('p-veh').textContent = c.vehLabel;

      const bagsRow = $('p-bags-row') as HTMLElement;
      bagsRow.hidden = c.extraBags === 0;
      $('p-bags').textContent = `${c.extraBags} ج.م`;

      const compRow = $('p-comp-row') as HTMLElement;
      compRow.hidden = c.companionFee === 0;
      $('p-comp').textContent = `${c.companionFee} ج.م`;

      const wpickRow = $('p-wpick-row') as HTMLElement;
      wpickRow.hidden = c.waitPickupFee === 0;
      $('p-wpick').textContent = `${c.waitPickupFee} ج.م`;

      const wairRow = $('p-wair-row') as HTMLElement;
      wairRow.hidden = c.waitAirportFee === 0;
      $('p-wair').textContent = `${c.waitAirportFee} ج.م`;

      $('p-total').innerHTML = c.total ? `${c.total} <small>ج.م</small>` : '— <small>ج.م</small>';
    }

    // ── Vehicle card click handlers ──
    document.querySelectorAll('.veh-card').forEach(card => {
      card.addEventListener('click', () => {
        if ((card as HTMLElement).hidden) return;
        document.querySelectorAll('.veh-card').forEach(c => c.classList.remove('veh-card--active'));
        card.classList.add('veh-card--active');
        const vehId = (card as HTMLElement).dataset.veh!;
        selectedVehicle = VEHICLES_DATA.find(v => v.id === vehId) || VEHICLES_DATA[0];
        // update bags max and hint
        const bagsInput = $('bags') as HTMLInputElement;
        bagsInput.max = String(selectedVehicle.maxBags);
        if (Number(bagsInput.value) > selectedVehicle.maxBags) bagsInput.value = String(selectedVehicle.maxBags);
        const travInput = $('passengers') as HTMLInputElement;
        travInput.max = String(selectedVehicle.maxTravelers);
        if (Number(travInput.value) > selectedVehicle.maxTravelers) travInput.value = String(selectedVehicle.maxTravelers);
        $('veh-hint').textContent = `تم اختيار ${selectedVehicle.name} — ${selectedVehicle.maxTravelers} ركاب بحد أقصى، ${selectedVehicle.freeBags} شنط كبيرة مجانية`;
        $('bags-hint').textContent = `الحد الأقصى للعربية ${selectedVehicle.maxBags} شنطة كبيرة • ${selectedVehicle.freeBags} شنط مجانية`;
        populateVehModels(vehId);
        render();
      });
    });

    document.getElementById('companions')?.addEventListener('input', () => { render(); });

    form.addEventListener('input', render);
    form.addEventListener('change', render);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const c = calc();
      const dep = direction() === 'departure';
      const fail = (msg: string) => { errBox.textContent = msg; errBox.classList.add('is-visible'); errBox.scrollIntoView({ block: 'center', behavior: 'smooth' }); };

      if (!selectedAirport) return fail('يرجى اختيار المطار من نتائج البحث.');
      const flightVal = dep ? c.flight : c.land;
      if (!flightInput.value || !flightVal) return fail(dep ? 'يرجى إدخال تاريخ ووقت إقلاع الطائرة.' : 'يرجى إدخال تاريخ ووقت هبوط الطائرة.');
      if (dep && c.depart && c.depart.getTime() < Date.now()) return fail('وقت الإقلاع قريب جداً — يرجى الحجز قبل موعد كافٍ.');

      const pax = Number(($('passengers') as HTMLInputElement).value) || 1;
      const comp = Number(($('companions') as HTMLInputElement).value) || 0;
      if (pax + comp > selectedVehicle.maxTravelers) return fail(`هذه السيارة تتسع لـ ${selectedVehicle.maxTravelers} ركاب فقط (مسافرون + مرافقون).`);
      const bagsVal = Number(($('bags') as HTMLInputElement).value) || 0;
      if (bagsVal > selectedVehicle.maxBags) return fail(`هذه السيارة تتسع لـ ${selectedVehicle.maxBags} شنطة كبيرة فقط.`);

      const name = ($('trav-name') as HTMLInputElement).value.trim();
      const phone = ($('trav-phone') as HTMLInputElement).value.trim();
      if (name.length < 2) return fail('يرجى إدخال اسم المسافر.');
      if (!isEgyptianMobile(phone)) return fail(EG_PHONE_ERROR);
      errBox.classList.remove('is-visible');

      const fromArea = fromAreaPlace?.name || (document.getElementById('from-area') as HTMLInputElement).value || '';
      const country = ($('flight-country') as HTMLInputElement).value.trim();
      const orderId = 'WSL-' + new Date().getFullYear() + '-' + Math.floor(100000 + Math.random() * 900000);
      const waitPickupMins = Number(($('wait-pickup') as HTMLSelectElement).value) || 0;
      const waitAirportMins = dep ? (Number(($('wait-airport') as HTMLSelectElement).value) || 0) : 0;

      const order = {
        id: orderId,
        type: dep ? 'توصيل مطار (مغادرة)' : 'توصيل مطار (وصول)',
        icon: dep ? '🛫' : '🛬',
        direction: direction(),
        route: dep ? `${fromArea} ← ${selectedAirport!.name}` : `${selectedAirport!.name} ← ${fromArea}`,
        date: 'الآن',
        price: `${c.total} ج.م`,
        status: 'active',
        kind: 'airport',
        airport: selectedAirport!.name,
        country,
        flightTime: dep ? c.flight!.toISOString() : c.land!.toISOString(),
        driverArrivalTime: (dep ? c.driverArrival : c.leaveAirport)?.toISOString(),
        departTime: (dep ? c.depart : c.leaveAirport)?.toISOString(),
        arriveTime: (dep ? c.arrive : c.home)?.toISOString(),
        checkinDeadline: c.checkinDeadline?.toISOString(),
        airline: ($('airline') as HTMLInputElement).value,
        flightNo: ($('flight-no') as HTMLInputElement).value,
        terminal: ($('terminal') as HTMLInputElement).value,
        vehicle: selectedVehicle.id,
        vehicleName: selectedVehicle.name,
        passengers: pax,
        companions: comp,
        bags: bagsVal,
        waitPickup: waitPickupMins,
        waitAirport: waitAirportMins,
        recipient: name,
        phone: normalizeEgyptianPhone(phone),
        address: `${fromArea} — ${($('address') as HTMLTextAreaElement).value.trim()}`,
        createdAt: new Date().toISOString(),
      };

      try {
        const existing = JSON.parse(localStorage.getItem('wslha_orders') || '[]');
        existing.unshift(order);
        localStorage.setItem('wslha_orders', JSON.stringify(existing));
      } catch { /* storage unavailable */ }

      // Insert into Supabase so online drivers receive the request via Realtime
      try {
        const _SB = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
        const _KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
        const _H = { apikey: _KEY, Authorization: 'Bearer ' + _KEY, 'Content-Type': 'application/json', Prefer: 'return=representation' };
        const payRes = await fetch(_SB + '/rest/v1/rides', {
          method: 'POST', headers: _H,
          body: JSON.stringify({
            customer_phone: order.phone,
            customer_name: order.recipient,
            from_area: dep ? fromArea : selectedAirport!.name,
            from_lat: dep ? (fromAreaPlace?.lat ?? 0) : selectedAirport!.lat,
            from_lng: dep ? (fromAreaPlace?.lng ?? 0) : selectedAirport!.lng,
            to_area: dep ? selectedAirport!.name : fromArea,
            to_lat: dep ? selectedAirport!.lat : (fromAreaPlace?.lat ?? 0),
            to_lng: dep ? selectedAirport!.lng : (fromAreaPlace?.lng ?? 0),
            distance_km: selectedAirport!.distanceKm,
            fare: c.total,
            eta_minutes: selectedAirport!.driveMinutes,
            passengers: pax,
            payment: (document.querySelector('input[name="payment"]:checked'))?.value || 'cash',
            vehicle_model: selVehModel.id,
            vehicle_year: selVehYear,
            notes: `${dep ? '🛫 مغادرة' : '🛬 وصول'} ${order.airline || ''} ${order.flightNo || ''}${country ? ' — ' + (dep ? 'إلى' : 'من') + ' ' + country : ''} — عنوان: ${order.address} — ${dep ? 'إقلاع' : 'هبوط'}: ${flightVal?.toLocaleString('ar-EG') || ''} — سيارة: ${order.vehicleName} (${selVehModel.name} ${selVehYear}) — شنط: ${bagsVal}`,
            status: 'pending',
            ride_type: 'airport',
          }),
        });
        if (payRes.ok) {
          const rows = await payRes.json();
          if (Array.isArray(rows) && rows[0]?.id) order.supabase_id = rows[0].id;
        }
      } catch { /* Supabase unavailable — order saved locally */ }

      // Success
      showSuccessCard(order);
    });

    // ── Builds the success-panel card HTML from a stored `order` object
    //    (ISO date strings) — shared by the submit handler above AND the
    //    on-load restore below, so a refresh shows the exact same card
    //    instead of losing the booking and resetting to an empty form. ──
    function buildSuccessCardHtml(order: any): string {
      const dep = order.direction === 'departure';
      const flightDate  = order.flightTime       ? new Date(order.flightTime)       : null;
      const driverArrival = order.driverArrivalTime ? new Date(order.driverArrivalTime) : null;
      const depart      = order.departTime       ? new Date(order.departTime)       : null;
      const arrive      = order.arriveTime       ? new Date(order.arriveTime)       : null;
      const pax = order.passengers ?? 1, comp = order.companions ?? 0, bagsVal = order.bags ?? 0;

      return dep ? `
        <div class="air-success__card-header">🛫 تفاصيل رحلة المغادرة</div>
        <div class="row"><span class="row-label">المطار</span><span class="row-val">${order.airport}</span></div>
        <div class="row"><span class="row-label">السيارة</span><span class="row-val">${order.vehicleName}</span></div>
        ${driverArrival ? `<div class="row"><span class="row-label">وصول السائق للاستلام</span><span class="row-val">${fmtDateTime(driverArrival)}</span></div>` : ''}
        ${depart ? `<div class="row"><span class="row-label">المغادرة من نقطة البداية</span><span class="row-val">${fmtDateTime(depart)}</span></div>` : ''}
        ${arrive ? `<div class="row"><span class="row-label">الوصول للمطار</span><span class="row-val">${fmtDateTime(arrive)}</span></div>` : ''}
        ${flightDate ? `<div class="row"><span class="row-label">إقلاع الطائرة</span><span class="row-val">${fmtDateTime(flightDate)}</span></div>` : ''}
        <div class="row"><span class="row-label">الرحلة</span><span class="row-val">${order.airline || '—'} ${order.flightNo || ''}</span></div>
        <div class="row"><span class="row-label">المسافرون</span><span class="row-val">${pax}</span></div>
        ${comp > 0 ? `<div class="row"><span class="row-label">مرافقون رايح جاي</span><span class="row-val">${comp}</span></div>` : ''}
        <div class="row"><span class="row-label">الشنط الكبيرة</span><span class="row-val">${bagsVal}</span></div>
        <div class="row row--total"><span class="row-label">الإجمالي</span><span class="row-val">${order.price}</span></div>` : `
        <div class="air-success__card-header">🛬 تفاصيل رحلة الوصول</div>
        <div class="row"><span class="row-label">المطار</span><span class="row-val">${order.airport}</span></div>
        <div class="row"><span class="row-label">السيارة</span><span class="row-val">${order.vehicleName}</span></div>
        ${flightDate ? `<div class="row"><span class="row-label">هبوط الطائرة</span><span class="row-val">${fmtDateTime(flightDate)}</span></div>` : ''}
        ${arrive ? `<div class="row"><span class="row-label">الوصول المتوقع لوجهتك</span><span class="row-val">${fmtDateTime(arrive)}</span></div>` : ''}
        <div class="row"><span class="row-label">الرحلة</span><span class="row-val">${order.airline || '—'} ${order.flightNo || ''}</span></div>
        <div class="row"><span class="row-label">المسافرون</span><span class="row-val">${pax}</span></div>
        ${comp > 0 ? `<div class="row"><span class="row-label">مرافقون</span><span class="row-val">${comp}</span></div>` : ''}
        <div class="row"><span class="row-label">الشنط الكبيرة</span><span class="row-val">${bagsVal}</span></div>
        <div class="row row--total"><span class="row-label">الإجمالي</span><span class="row-val">${order.price}</span></div>`;
    }

    function showSuccessCard(order: any) {
      $('air-success-id').textContent = order.id;
      ($('air-success-track') as HTMLAnchorElement).href = `/track?q=${encodeURIComponent(order.id)}`;
      $('air-success-card').innerHTML = buildSuccessCardHtml(order);
      ($('air-wrap') as HTMLElement).style.display = 'none';
      ($('air-success') as HTMLElement).classList.add('is-visible');
      $('air-success').focus();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ── استرجاع الحجز النشط بعد تحديث الصفحة — بدل ما يرجع العميل لفورم
    //    فاضي رغم إن حجزه لسه شغّال في قاعدة البيانات. بيدوّر على آخر
    //    حجز مطار محفوظ محلياً (فيه كل التفاصيل الأصلية) ويتأكد إنه لسه
    //    نشط عن طريق rides قبل ما يعرضه. ──
    async function restoreActiveAirportBooking() {
      let phone: string | null = null;
      try { phone = (JSON.parse(localStorage.getItem('wslha_user') || '{}')).phone || null; } catch {}
      let orders: any[] = [];
      try { orders = JSON.parse(localStorage.getItem('wslha_orders') || '[]'); } catch {}
      const candidate = orders.find((o: any) =>
        o.kind === 'airport' && o.status === 'active' && o.supabase_id &&
        (!phone || normalizeEgyptianPhone(o.phone || '') === normalizeEgyptianPhone(phone))
      );
      if (!candidate) return;

      try {
        const _SB = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
        const _KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
        const _H = { apikey: _KEY, Authorization: 'Bearer ' + _KEY };
        const res = await fetch(`${_SB}/rest/v1/rides?id=eq.${candidate.supabase_id}&select=status&limit=1`, { headers: _H });
        if (!res.ok) return;
        const rows = await res.json();
        const status = Array.isArray(rows) && rows[0] ? rows[0].status : null;
        if (!status || !['pending', 'accepted', 'arrived', 'in_progress'].includes(status)) return;
        showSuccessCard(candidate);
      } catch {}
    }

    render();
    restoreActiveAirportBooking();
  </script>
</Layout>
