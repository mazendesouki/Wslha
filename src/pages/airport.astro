---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
import { AIRPORTS, priceForDistance, VEHICLE_TYPES } from '../data/airports';
---

<style>
  .air-wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-10) var(--sp-6) var(--sp-20);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-8);
    align-items: start;
  }

  .air-form {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    padding: var(--sp-8);
  }
  .air-form__step {
    font-size: var(--text-base);
    font-weight: var(--weight-black);
    margin: var(--sp-6) 0 var(--sp-4);
    display: flex; align-items: center; gap: var(--sp-2);
  }
  .air-form__step:first-child { margin-top: 0; }
  .air-form__num {
    width: 26px; height: 26px; border-radius: var(--radius-full);
    background: var(--color-primary); color: #fff; font-size: var(--text-sm);
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .air-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .field { margin-bottom: var(--sp-4); }
  .field__label { display: block; font-weight: var(--weight-bold); font-size: var(--text-sm); margin-bottom: var(--sp-2); color: #374151; }
  .field__input, .field__select, .field__textarea {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border); border-radius: var(--radius);
    font-family: var(--font-body); font-size: var(--text-base);
    direction: rtl; background: var(--color-bg); color: var(--color-text); outline: none;
    transition: border-color var(--ease);
  }
  .field__input:focus, .field__select:focus, .field__textarea:focus { border-color: var(--color-primary); }
  .field__hint { font-size: var(--text-xs); color: var(--color-text-faint); margin-top: 4px; }

  .trip-type { display: flex; gap: var(--sp-3); }
  .trip-type label {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
    padding: var(--sp-3); border: 2px solid var(--color-border); border-radius: var(--radius-lg);
    cursor: pointer; font-weight: var(--weight-bold); font-size: var(--text-sm);
  }
  .trip-type label:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-light); color: var(--color-primary); }
  .trip-type input { position: absolute; opacity: 0; }

  .air-divider { border: none; border-top: 1px solid var(--color-border); margin: var(--sp-6) 0; }

  /* Summary panel */
  .air-summary {
    position: sticky;
    top: calc(var(--nav-height) + var(--sp-4));
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .air-summary__head {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: #fff; padding: var(--sp-5);
  }
  .air-summary__head h2 { font-size: var(--text-lg); font-weight: var(--weight-black); }
  .air-summary__route { font-size: var(--text-sm); opacity: 0.9; margin-top: 2px; }
  .air-summary__body { padding: var(--sp-5); }

  /* Timeline */
  .timeline { list-style: none; position: relative; padding-inline-start: var(--sp-8); margin-bottom: var(--sp-5); }
  .timeline::before { content: ''; position: absolute; inset-inline-start: 9px; top: 8px; bottom: 8px; width: 2px; background: var(--color-border); }
  .tl-item { position: relative; margin-bottom: var(--sp-5); }
  .tl-item:last-child { margin-bottom: 0; }
  .tl-dot { position: absolute; inset-inline-start: calc(-1 * var(--sp-8) + 2px); top: 2px; width: 18px; height: 18px; border-radius: var(--radius-full); background: var(--color-bg); border: 3px solid var(--color-primary); }
  .tl-item--flight .tl-dot { border-color: var(--color-accent); }
  .tl-label { font-size: var(--text-xs); color: var(--color-text-muted); }
  .tl-time { font-weight: var(--weight-black); font-size: var(--text-base); }
  .tl-sub { font-size: var(--text-xs); color: var(--color-text-faint); }
  .tl-empty { color: var(--color-text-faint); font-size: var(--text-sm); }

  .air-prices { border-top: 1px solid var(--color-border); padding-top: var(--sp-4); }
  .air-prices .row { display: flex; justify-content: space-between; font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--sp-2); }
  .air-prices .total { display: flex; justify-content: space-between; align-items: baseline; margin-top: var(--sp-3); padding-top: var(--sp-3); border-top: 2px solid var(--color-border); }
  .air-prices .total b { font-size: var(--text-3xl); font-weight: var(--weight-black); color: var(--color-primary); line-height: 1; }
  .air-prices .total b small { font-size: var(--text-sm); }

  .air-error { background: #FEE2E2; color: #B91C1C; border-radius: var(--radius); padding: var(--sp-3) var(--sp-4); font-size: var(--text-sm); margin: var(--sp-4) 0 0; display: none; }
  .air-error.is-visible { display: block; }

  .air-submit {
    width: 100%; margin-top: var(--sp-5); padding: var(--sp-4);
    background: var(--color-accent); color: var(--color-text); border: none; border-radius: var(--radius);
    font-family: var(--font-body); font-weight: var(--weight-black); font-size: var(--text-base);
  }
  .air-submit:hover:not(:disabled) { background: var(--color-accent-dark); }
  .air-submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .air-note { font-size: var(--text-xs); color: var(--color-text-faint); text-align: center; margin-top: var(--sp-3); }

  /* ── Success Screen ───────────────────────────────────── */
  .air-success {
    display: none;
    max-width: 520px;
    margin: var(--sp-12) auto var(--sp-20);
    padding: 0 var(--sp-4);
    text-align: center;
  }
  .air-success.is-visible { display: block; }

  .air-success__check {
    width: 80px; height: 80px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #16a34a, #22c55e);
    display: flex; align-items: center; justify-content: center;
    font-size: 2.2rem;
    margin: 0 auto var(--sp-5);
    box-shadow: 0 8px 24px rgba(22,163,74,0.3);
  }

  .air-success__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    color: var(--color-text);
    margin-bottom: var(--sp-2);
  }

  .air-success__sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--sp-5);
  }

  .air-success__id-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--color-primary-light);
    border: 1.5px dashed var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--sp-2) var(--sp-5);
    margin-bottom: var(--sp-7);
  }

  .air-success__id-label { font-size: var(--text-xs); color: var(--color-text-muted); font-weight: var(--weight-semi); }
  .air-success__id-val   { font-size: var(--text-base); font-weight: var(--weight-black); color: var(--color-primary); letter-spacing: 0.5px; }

  /* Confirmation card */
  .air-success__card {
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: var(--sp-6);
    text-align: right;
    box-shadow: var(--shadow-sm);
  }

  /* card-header + rows are injected at runtime via innerHTML, so they must be
     :global — Astro's scoped [data-astro-cid] attribute is NOT added to JS-inserted nodes */
  .air-success__card :global(.air-success__card-header) {
    background: linear-gradient(135deg, var(--color-primary), #1d4ed8);
    color: #fff;
    padding: var(--sp-4) var(--sp-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .air-success__card :global(.row) {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .air-success__card :global(.row:last-child) { border-bottom: none; }
  .air-success__card :global(.row-label) {
    color: var(--color-text-muted);
    font-weight: var(--weight-semi);
    white-space: nowrap;
  }
  .air-success__card :global(.row-val) {
    font-weight: var(--weight-bold);
    color: var(--color-text);
    text-align: left;
  }
  .air-success__card :global(.row--total) {
    background: var(--color-primary-light);
    font-size: var(--text-base);
  }
  .air-success__card :global(.row--total .row-label) { color: var(--color-primary); font-weight: var(--weight-black); }
  .air-success__card :global(.row--total .row-val)   { color: var(--color-primary); font-size: var(--text-lg); }

  .air-success__actions {
    display: flex;
    gap: var(--sp-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .air-wrap { grid-template-columns: 1fr; }
    .air-summary { position: static; }
    .air-row { grid-template-columns: 1fr; }
  }
  /* ensure Google Places dropdown appears above everything */
  .pac-container { z-index: 9999 !important; direction: rtl; font-family: var(--font-body); }
  .loc-wrap { display: flex; align-items: center; gap: 8px; }
  .loc-wrap .field__input { flex: 1; }
  .loc-btn {
    width: 38px; height: 38px; flex-shrink: 0;
    border: 1.5px solid var(--color-border); border-radius: var(--radius);
    background: var(--color-bg-soft); cursor: pointer; font-size: 0.95rem;
    display: flex; align-items: center; justify-content: center; transition: all 0.2s;
  }
  .loc-btn:hover { background: var(--color-primary-light); border-color: var(--color-primary); }
  /* Airport search dropdown */
  .airport-wrap { position: relative; }
  .airport-list {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0;
    background: var(--color-bg); border: 1.5px solid var(--color-primary);
    border-radius: var(--radius); max-height: 220px; overflow-y: auto;
    z-index: 1000; list-style: none; margin: 0;
    box-shadow: var(--shadow-md); display: none;
  }
  .airport-list.is-open { display: block; }
  .airport-list li {
    padding: var(--sp-3) var(--sp-4); cursor: pointer; font-size: var(--text-sm);
    border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;
  }
  .airport-list li:last-child { border-bottom: none; }
  .airport-list li:hover, .airport-list li.focused { background: var(--color-primary-light); color: var(--color-primary); }
  .airport-list__code { font-weight: var(--weight-black); font-size: 11px; color: var(--color-primary); background: var(--color-primary-light); padding: 2px 6px; border-radius: 4px; }
  .airport-list__km { color: var(--color-text-faint); font-size: 11px; }
  .airport-selected { border-color: var(--color-primary) !important; }

  /* vehicle cards */
  .veh-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); }
  .veh-card {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: var(--sp-4) var(--sp-3); border: 2px solid var(--color-border);
    border-radius: var(--radius-lg); background: var(--color-bg-soft);
    cursor: pointer; transition: all 0.2s; font-family: var(--font-body);
    text-align: center;
  }
  .veh-card--active { border-color: var(--color-primary); background: var(--color-primary-light); }
  .veh-card:hover:not(.veh-card--active) { border-color: var(--color-primary); }
  .veh-card__icon { font-size: 1.8rem; }
  .veh-card__name { font-weight: var(--weight-black); font-size: var(--text-sm); color: var(--color-text); }
  .veh-card__desc { font-size: 10px; color: var(--color-text-faint); }
  .veh-card__cap { font-size: 10px; color: var(--color-text-muted); margin-top: 2px; }
  .veh-card--active .veh-card__name { color: var(--color-primary); }
  @media (max-width: 480px) { .veh-grid { grid-template-columns: 1fr; } }
  /* timeline new items */
  .tl-item--depart .tl-dot { border-color: #16a34a; }
  .tl-item--arrive .tl-dot { border-color: #0ea5e9; }
  .tl-item--checkin .tl-dot { border-color: #f59e0b; }
  .tl-badge { display: inline-block; font-size: 10px; padding: 1px 6px; border-radius: 99px; }
  .tl-badge--ok { background: #dcfce7; color: #16a34a; }
  .tl-badge--warn { background: #fef3c7; color: #92400e; }
</style>

<Layout
  title="توصيل المطار"
  description="خدمة توصيل من دمياط إلى جميع مطارات مصر — أدخل وقت إقلاع رحلتك ونحسب لك وقت المغادرة تلقائياً"
  page="airport"
>
  <PageHero
    badge="✈️ توصيل المطار"
    title="من دمياط إلى كل مطارات مصر"
    subtitle="أدخل بيانات رحلتك ووقت الإقلاع — ونحسب لك وقت المغادرة المثالي تلقائياً مع سعر ثابت حسب المسافة"
  />

  <div class="air-wrap" id="air-wrap">

    <!-- Form -->
    <form class="air-form" id="air-form">

      <!-- قسم 1: نوع الرحلة -->
      <h2 class="air-form__step"><span class="air-form__num">1</span> نوع الرحلة</h2>
      <div class="field">
        <span class="field__label">نوع الرحلة</span>
        <div class="trip-type">
          <label><input type="radio" name="trip" value="international" checked>✈️ دولية (3 ساعات)</label>
          <label><input type="radio" name="trip" value="domestic">🛫 محلية (ساعتان)</label>
        </div>
        <p class="field__hint">نستخدمها لحساب الوقت اللازم للوصول قبل الإقلاع.</p>
      </div>

      <hr class="air-divider">

      <!-- قسم 2: اختيار السيارة -->
      <h2 class="air-form__step"><span class="air-form__num">2</span> اختيار السيارة</h2>
      <div class="veh-grid">
        <button type="button" class="veh-card veh-card--active" data-veh="sedan">
          <span class="veh-card__icon">🚗</span>
          <span class="veh-card__name">سيدان</span>
          <span class="veh-card__desc">تويوتا / هيونداي</span>
          <span class="veh-card__cap">👤 ٣ ركاب • 🧳 ٢ شنطة</span>
        </button>
        <button type="button" class="veh-card" data-veh="suv">
          <span class="veh-card__icon">🚙</span>
          <span class="veh-card__name">SUV / كروز</span>
          <span class="veh-card__desc">لاند كروزر / باترول</span>
          <span class="veh-card__cap">👥 ٦ ركاب • 🧳 ٤ شنط</span>
        </button>
        <button type="button" class="veh-card" data-veh="van">
          <span class="veh-card__icon">🚐</span>
          <span class="veh-card__name">ميكروباص</span>
          <span class="veh-card__desc">H1 / سبرينتر</span>
          <span class="veh-card__cap">👥 ١٠ ركاب • 🧳 ٨ شنط</span>
        </button>
      </div>
      <p class="field__hint" id="veh-hint">تم اختيار السيدان — ٣ ركاب بحد أقصى، شنطتان مجانيتان</p>

      <hr class="air-divider">

      <!-- قسم 3: نقطة البداية والوصول -->
      <h2 class="air-form__step"><span class="air-form__num">3</span> نقطة البداية والوصول</h2>

      <div class="air-row">
        <div class="field">
          <label class="field__label" for="from-area">نقطة البداية (منطقتك)</label>
          <div class="loc-wrap">
            <input type="text" class="field__input" id="from-area" placeholder="اكتب منطقتك أو حيّك في دمياط..." autocomplete="off" />
            <button type="button" class="loc-btn" id="btn-air-loc" title="موقعي الحالي">📍</button>
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="airport-input">المطار (نقطة النهاية)</label>
          <div class="airport-wrap">
            <input type="text" class="field__input" id="airport-input" placeholder="ابحث: القاهرة، شرم، الغردقة..." autocomplete="off" />
            <ul class="airport-list" id="airport-list" role="listbox"></ul>
          </div>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="address">عنوان الاستلام بالتفصيل</label>
        <textarea class="field__textarea" id="address" placeholder="الحي، الشارع، رقم المبنى، علامة مميزة..."></textarea>
      </div>

      <div class="field">
        <label class="field__label" for="flight-time">تاريخ ووقت إقلاع الطائرة</label>
        <input class="field__input" id="flight-time" type="datetime-local">
        <p class="field__hint">سنحسب لك وقت المغادرة من بيتك ووقت الوصول للمطار تلقائياً.</p>
      </div>

      <hr class="air-divider">

      <!-- قسم 4: الركاب والأمتعة -->
      <h2 class="air-form__step"><span class="air-form__num">4</span> الركاب والأمتعة</h2>

      <div class="air-row">
        <div class="field">
          <label class="field__label" for="passengers">عدد المسافرين (يطيرون)</label>
          <input class="field__input" id="passengers" type="number" min="1" max="3" value="1">
        </div>
        <div class="field">
          <label class="field__label" for="companions">مرافق رايح جاي 🔄</label>
          <input class="field__input" id="companions" type="number" min="0" max="9" value="0">
          <p class="field__hint">شخص يرافق ويرجع مع السيارة — ٢٥٠ ج.م للفرد</p>
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="bags">شنط كبيرة (تُسجَّل في الطائرة)</label>
        <input class="field__input" id="bags" type="number" min="0" max="2" value="1">
        <p class="field__hint" id="bags-hint">شنطتان مجانيتان مع السيدان • كل شنطة إضافية ٢٥ ج.م</p>
      </div>

      <hr class="air-divider">

      <!-- قسم 5: أوقات الانتظار -->
      <h2 class="air-form__step"><span class="air-form__num">5</span> أوقات الانتظار</h2>

      <div class="air-row">
        <div class="field">
          <label class="field__label" for="wait-pickup">انتظار السائق عند الاستلام</label>
          <select class="field__select" id="wait-pickup">
            <option value="0">بدون انتظار (سأكون جاهزاً)</option>
            <option value="15">١٥ دقيقة — مجاناً</option>
            <option value="30">٣٠ دقيقة (+٣٠ ج.م)</option>
            <option value="45">٤٥ دقيقة (+٦٠ ج.م)</option>
            <option value="60">ساعة كاملة (+٩٠ ج.م)</option>
          </select>
        </div>
        <div class="field" id="wait-airport-field">
          <label class="field__label" for="wait-airport">انتظار السائق في ساحة المطار</label>
          <select class="field__select" id="wait-airport">
            <option value="0">بدون انتظار — يتركني وينصرف</option>
            <option value="30">٣٠ دقيقة — مجاناً</option>
            <option value="60">ساعة (+٤٠ ج.م)</option>
            <option value="90">ساعة ونص (+٨٠ ج.م)</option>
          </select>
        </div>
      </div>

      <hr class="air-divider">

      <!-- قسم 6: بيانات الطيران -->
      <h2 class="air-form__step"><span class="air-form__num">6</span> بيانات الطيران</h2>
      <div class="air-row">
        <div class="field">
          <label class="field__label" for="airline">شركة الطيران</label>
          <input class="field__input" id="airline" type="text" placeholder="مثال: مصر للطيران">
        </div>
        <div class="field">
          <label class="field__label" for="flight-no">رقم الرحلة</label>
          <input class="field__input" id="flight-no" type="text" placeholder="MS 712">
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="terminal">رقم الصالة / المبنى</label>
        <input class="field__input" id="terminal" type="text" placeholder="مثال: مبنى 2">
      </div>

      <hr class="air-divider">

      <!-- قسم 7: بيانات المسافر -->
      <h2 class="air-form__step"><span class="air-form__num">7</span> بيانات المسافر</h2>
      <div class="air-row">
        <div class="field">
          <label class="field__label" for="trav-name">اسم المسافر</label>
          <input class="field__input" id="trav-name" type="text" placeholder="محمد أحمد" autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="trav-phone">رقم الجوال</label>
          <input class="field__input" id="trav-phone" type="tel" placeholder="010 1234 5678" inputmode="numeric" maxlength="11" pattern="01[0125][0-9]{8}" autocomplete="tel">
        </div>
      </div>
    </form>

    <!-- Live summary -->
    <aside class="air-summary" aria-label="ملخص الرحلة">
      <div class="air-summary__head">
        <h2>رحلتك</h2>
        <p class="air-summary__route" id="sum-route">اختر المطار ووقت الإقلاع</p>
      </div>
      <div class="air-summary__body">
        <ol class="timeline" id="timeline">
          <li class="tl-empty" id="tl-empty">أدخل وقت إقلاع الطائرة لعرض الجدول الزمني المقترح.</li>
          <li class="tl-item" id="tl-driver" hidden>
            <span class="tl-dot"></span>
            <p class="tl-label">🚗 وصول السائق للاستلام</p>
            <p class="tl-time" id="tl-driver-time">—</p>
            <p class="tl-sub" id="tl-driver-sub"></p>
          </li>
          <li class="tl-item tl-item--depart" id="tl-depart" hidden>
            <span class="tl-dot"></span>
            <p class="tl-label">🏁 المغادرة من نقطة البداية</p>
            <p class="tl-time" id="tl-depart-time">—</p>
            <p class="tl-sub" id="tl-depart-sub"></p>
          </li>
          <li class="tl-item tl-item--arrive" id="tl-arrive" hidden>
            <span class="tl-dot"></span>
            <p class="tl-label">🛄 الوصول إلى المطار</p>
            <p class="tl-time" id="tl-arrive-time">—</p>
            <p class="tl-sub" id="tl-arrive-sub"></p>
          </li>
          <li class="tl-item tl-item--checkin" id="tl-checkin" hidden>
            <span class="tl-dot"></span>
            <p class="tl-label">🎫 آخر موعد لتسجيل الأمتعة</p>
            <p class="tl-time" id="tl-checkin-time">—</p>
            <p class="tl-sub" id="tl-checkin-sub"></p>
          </li>
          <li class="tl-item tl-item--flight" id="tl-flight" hidden>
            <span class="tl-dot"></span>
            <p class="tl-label">✈️ إقلاع الطائرة</p>
            <p class="tl-time" id="tl-flight-time">—</p>
          </li>
        </ol>

        <div class="air-prices">
          <div class="row"><span>المسافة</span><span id="p-distance">—</span></div>
          <div class="row"><span>سعر المسافة</span><span id="p-base">—</span></div>
          <div class="row" id="p-veh-row" hidden><span id="p-veh-label">رسوم السيارة</span><span id="p-veh">—</span></div>
          <div class="row" id="p-bags-row" hidden><span>شنط إضافية</span><span id="p-bags">—</span></div>
          <div class="row" id="p-comp-row" hidden><span id="p-comp-label">مرافق رايح جاي</span><span id="p-comp">—</span></div>
          <div class="row" id="p-wpick-row" hidden><span>انتظار عند الاستلام</span><span id="p-wpick">—</span></div>
          <div class="row" id="p-wair-row" hidden><span>انتظار في ساحة المطار</span><span id="p-wair">—</span></div>
          <div class="total"><span>الإجمالي</span><b id="p-total">— <small>ج.م</small></b></div>
        </div>

        <div class="air-error" id="air-error" role="alert" aria-live="polite"></div>
        <button type="submit" form="air-form" class="air-submit" id="air-submit">تأكيد الحجز ←</button>
        <p class="air-note">سعر ثابت حسب المسافة — الدفع نقداً أو إلكترونياً</p>
      </div>
    </aside>
  </div>

  <script type="application/json" id="airports-json" set:html={JSON.stringify(AIRPORTS)}></script>
  <script type="application/json" id="vehicles-json" set:html={JSON.stringify(VEHICLE_TYPES)}></script>

  <!-- Success -->
  <section class="air-success" id="air-success" role="alert" aria-live="polite" tabindex="-1">
    <div class="air-success__check" aria-hidden="true">✅</div>
    <h2 class="air-success__title">تم تأكيد حجز رحلتك!</h2>
    <p class="air-success__sub">سيصلك السائق في الموعد المحدد.</p>

    <div class="air-success__id-wrap">
      <span class="air-success__id-label">رقم الحجز</span>
      <span class="air-success__id-val" id="air-success-id">—</span>
    </div>

    <div class="air-success__card" id="air-success-card">
      <div class="air-success__card-header">✈️ تفاصيل الرحلة</div>
    </div>

    <div class="air-success__actions">
      <a href="/orders" class="btn btn--primary">📋 طلباتي</a>
      <a href="/track"  class="btn btn--outline" id="air-success-track">📡 تتبع الطلب</a>
    </div>
  </section>

  <script>
    import { priceForDistance, CHECKIN_BUFFER, SAFETY_MARGIN, VEHICLE_TYPES, EXTRA_BAG_FEE, COMPANION_FEE, WAIT_PICKUP_FREE, WAIT_PICKUP_PER15, WAIT_AIRPORT_FREE, WAIT_AIRPORT_PER30 } from '../data/airports';
    import { isEgyptianMobile, normalizeEgyptianPhone, EG_PHONE_ERROR } from '../utils/phone';

    const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';

    const $ = (id: string) => document.getElementById(id)!;
    const form = $('air-form') as HTMLFormElement;
    const flightInput = $('flight-time') as HTMLInputElement;

    // ── Vehicle selection ──
    interface VehicleType { id: string; name: string; maxTravelers: number; maxBags: number; freeBags: number; surcharge: number; }
    const VEHICLES_DATA: VehicleType[] = JSON.parse((document.getElementById('vehicles-json') as HTMLScriptElement).textContent || '[]');
    let selectedVehicle: VehicleType = VEHICLES_DATA[0] || { id: 'sedan', name: 'سيدان', maxTravelers: 3, maxBags: 2, freeBags: 2, surcharge: 0 };

    // ── Airport search ──
    interface AirportItem { id: string; name: string; code: string; distanceKm: number; driveMinutes: number; }
    const AIRPORTS_DATA: AirportItem[] = JSON.parse((document.getElementById('airports-json') as HTMLScriptElement).textContent || '[]');
    let selectedAirport: AirportItem | null = null;

    const airportInput = $('airport-input') as HTMLInputElement;
    const airportList = $('airport-list') as HTMLUListElement;

    function filterAirports(q: string): AirportItem[] {
      if (!q.trim()) return AIRPORTS_DATA;
      const s = q.trim().toLowerCase();
      return AIRPORTS_DATA.filter(a =>
        a.name.includes(q) || a.code.toLowerCase().includes(s) || a.name.toLowerCase().includes(s)
      );
    }

    function renderAirportList(items: AirportItem[]) {
      airportList.innerHTML = '';
      if (!items.length) {
        airportList.innerHTML = '<li style="color:var(--color-text-faint);cursor:default">لا توجد نتائج</li>';
      } else {
        items.forEach(a => {
          const li = document.createElement('li');
          li.innerHTML = `<span>${a.name}</span><span><span class="airport-list__code">${a.code}</span> <span class="airport-list__km">${a.distanceKm} كم</span></span>`;
          li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            selectAirport(a);
          });
          airportList.appendChild(li);
        });
      }
      airportList.classList.add('is-open');
    }

    function selectAirport(a: AirportItem) {
      selectedAirport = a;
      airportInput.value = `${a.name} (${a.code})`;
      airportInput.classList.add('airport-selected');
      airportList.classList.remove('is-open');
      render();
    }

    airportInput.addEventListener('input', () => {
      selectedAirport = null;
      airportInput.classList.remove('airport-selected');
      renderAirportList(filterAirports(airportInput.value));
      render();
    });
    airportInput.addEventListener('focus', () => {
      renderAirportList(filterAirports(airportInput.value));
    });
    airportInput.addEventListener('blur', () => {
      setTimeout(() => airportList.classList.remove('is-open'), 150);
    });
    const errBox = $('air-error') as HTMLElement;

    // ── Google Places for from-area ──
    let fromAreaPlace: { name: string; lat: number; lng: number } | null = null;

    function loadGoogleMaps(): Promise<void> {
      return new Promise((resolve) => {
        if ((window as any).google?.maps) { resolve(); return; }
        (window as any).__airGmInit = resolve;
        const s = document.createElement('script');
        s.src = `https://maps.googleapis.com/maps/api/js?key=${GMAPS_KEY}&libraries=places&callback=__airGmInit&language=ar&region=EG`;
        s.async = true;
        document.head.appendChild(s);
      });
    }

    async function initFromAreaAutocomplete(): Promise<void> {
      await loadGoogleMaps();
      const G = (window as any).google.maps;
      // Soft bias toward Damietta — user can search anywhere in Egypt
      const damiettaBias = new G.LatLngBounds(
        { lat: 31.20, lng: 31.50 },
        { lat: 31.65, lng: 32.10 }
      );
      const ac = new G.places.Autocomplete(document.getElementById('from-area'), {
        bounds: damiettaBias,
        componentRestrictions: { country: 'eg' },
        strictBounds: false,
        types: [],                   // all types: streets, cafes, buildings...
        fields: ['geometry', 'name', 'formatted_address'],
      });
      ac.addListener('place_changed', () => {
        const p = ac.getPlace();
        if (!p?.geometry?.location) return;
        fromAreaPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
        render();
      });
    }

    initFromAreaAutocomplete();

    document.getElementById('btn-air-loc')?.addEventListener('click', () => {
      if (!navigator.geolocation) return;
      const btn = document.getElementById('btn-air-loc')!;
      btn.textContent = '⏳';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          fromAreaPlace = { name: 'موقعي الحالي', lat: pos.coords.latitude, lng: pos.coords.longitude };
          (document.getElementById('from-area') as HTMLInputElement).value = 'موقعي الحالي';
          btn.textContent = '✅';
          render();
          setTimeout(() => { btn.textContent = '📍'; }, 2000);
        },
        () => { btn.textContent = '📍'; }
      );
    });

    // Minimum datetime = now + 2h
    const min = new Date(Date.now() + 2 * 3600 * 1000);
    flightInput.min = new Date(min.getTime() - min.getTimezoneOffset() * 60000).toISOString().slice(0, 16);

    function fmtDateTime(d: Date): string {
      return new Intl.DateTimeFormat('ar-EG', {
        weekday: 'short', day: 'numeric', month: 'long',
        hour: 'numeric', minute: '2-digit', hour12: true,
      }).format(d);
    }
    function minutesToText(m: number): string {
      const h = Math.floor(m / 60), mm = m % 60;
      if (h && mm) return `${h} ساعة و${mm} دقيقة`;
      if (h) return `${h} ساعة`;
      return `${mm} دقيقة`;
    }

    interface Calc {
      distance: number; drive: number;
      base: number; vehSurcharge: number; extraBags: number; companionFee: number; waitPickupFee: number; waitAirportFee: number;
      total: number; buffer: number;
      flight?: Date; arrive?: Date; depart?: Date; driverArrival?: Date; checkinDeadline?: Date;
    }

    function calc(): Calc {
      const distance = selectedAirport ? selectedAirport.distanceKm : 0;
      const drive = selectedAirport ? selectedAirport.driveMinutes : 0;
      const trip = (form.querySelector('input[name="trip"]:checked') as HTMLInputElement).value as 'domestic' | 'international';
      const buffer = trip === 'international' ? CHECKIN_BUFFER.international : CHECKIN_BUFFER.domestic;
      const bags = Math.max(0, Number(($('bags') as HTMLInputElement).value) || 0);
      const companions = Math.max(0, Number(($('companions') as HTMLInputElement).value) || 0);
      const waitPickupMins = Number(($('wait-pickup') as HTMLSelectElement).value) || 0;
      const waitAirportMins = Number(($('wait-airport') as HTMLSelectElement).value) || 0;

      const base = distance ? priceForDistance(distance) : 0;
      const vehSurcharge = selectedVehicle.surcharge;
      const extraBags = Math.max(0, bags - selectedVehicle.freeBags) * EXTRA_BAG_FEE;
      const companionFee = companions * COMPANION_FEE;
      const waitPickupFee = Math.max(0, Math.floor((waitPickupMins - WAIT_PICKUP_FREE) / 15)) * WAIT_PICKUP_PER15;
      const waitAirportFee = Math.max(0, Math.floor((waitAirportMins - WAIT_AIRPORT_FREE) / 30)) * WAIT_AIRPORT_PER30;
      const total = base + vehSurcharge + extraBags + companionFee + waitPickupFee + waitAirportFee;

      const result: Calc = { distance, drive, base, vehSurcharge, extraBags, companionFee, waitPickupFee, waitAirportFee, total, buffer };

      if (flightInput.value && distance) {
        const flight = new Date(flightInput.value);
        if (!isNaN(flight.getTime())) {
          // checkin deadline: international 60 min before, domestic 40 min before
          const checkinClose = trip === 'international' ? 60 : 40;
          const checkinDeadline = new Date(flight.getTime() - checkinClose * 60000);
          // arrive at airport = flight_time - buffer (with safety margin buffer)
          const arrive = new Date(flight.getTime() - buffer * 60000);
          // depart from pickup = arrive - drive - safety
          const depart = new Date(arrive.getTime() - (drive + SAFETY_MARGIN) * 60000);
          // driver arrives at pickup = depart - waitPickup
          const driverArrival = new Date(depart.getTime() - waitPickupMins * 60000);
          result.flight = flight;
          result.arrive = arrive;
          result.depart = depart;
          result.driverArrival = driverArrival;
          result.checkinDeadline = checkinDeadline;
        }
      }
      return result;
    }

    function render(): void {
      const c = calc();
      const fromArea = fromAreaPlace?.name || (document.getElementById('from-area') as HTMLInputElement).value || '';

      // Route
      $('sum-route').textContent = selectedAirport
        ? `${fromArea} ← ${selectedAirport.name}`
        : 'اختر المطار ووقت الإقلاع';

      // Timeline
      const hasTime = !!c.flight;
      $('tl-empty').hidden = hasTime;
      ['tl-driver', 'tl-depart', 'tl-arrive', 'tl-checkin', 'tl-flight'].forEach(id => ($(id) as HTMLElement).hidden = !hasTime);

      if (hasTime) {
        // Driver arrival
        if (c.driverArrival) {
          $('tl-driver-time').textContent = fmtDateTime(c.driverArrival);
          $('tl-driver-sub').textContent = 'موعد وصول السائق لاستلامك';
        }
        // Depart
        if (c.depart) {
          $('tl-depart-time').textContent = fmtDateTime(c.depart);
          $('tl-depart-sub').textContent = `زمن الطريق ~${minutesToText(c.drive)} + هامش أمان`;
        }
        // Arrive
        if (c.arrive) {
          $('tl-arrive-time').textContent = fmtDateTime(c.arrive);
          $('tl-arrive-sub').textContent = `قبل الإقلاع بـ ${minutesToText(c.buffer)}`;
        }
        // Checkin deadline
        if (c.checkinDeadline) {
          $('tl-checkin-time').textContent = fmtDateTime(c.checkinDeadline);
          $('tl-checkin-sub').textContent = 'آخر موعد لتسليم الأمتعة عند الكاونتر';
        }
        // Flight
        $('tl-flight-time').textContent = fmtDateTime(c.flight!);
      }

      // Prices
      $('p-distance').textContent = c.distance ? `${c.distance} كم` : '—';
      $('p-base').textContent = c.base ? `${c.base} ج.م` : '—';

      const vehRow = $('p-veh-row') as HTMLElement;
      vehRow.hidden = c.vehSurcharge === 0;
      $('p-veh').textContent = `${c.vehSurcharge} ج.م`;

      const bagsRow = $('p-bags-row') as HTMLElement;
      bagsRow.hidden = c.extraBags === 0;
      $('p-bags').textContent = `${c.extraBags} ج.م`;

      const compRow = $('p-comp-row') as HTMLElement;
      compRow.hidden = c.companionFee === 0;
      $('p-comp').textContent = `${c.companionFee} ج.م`;

      const wpickRow = $('p-wpick-row') as HTMLElement;
      wpickRow.hidden = c.waitPickupFee === 0;
      $('p-wpick').textContent = `${c.waitPickupFee} ج.م`;

      const wairRow = $('p-wair-row') as HTMLElement;
      wairRow.hidden = c.waitAirportFee === 0;
      $('p-wair').textContent = `${c.waitAirportFee} ج.م`;

      $('p-total').innerHTML = c.total ? `${c.total} <small>ج.م</small>` : '— <small>ج.م</small>';
    }

    // ── Vehicle card click handlers ──
    document.querySelectorAll('.veh-card').forEach(card => {
      card.addEventListener('click', () => {
        document.querySelectorAll('.veh-card').forEach(c => c.classList.remove('veh-card--active'));
        card.classList.add('veh-card--active');
        const vehId = (card as HTMLElement).dataset.veh!;
        selectedVehicle = VEHICLES_DATA.find(v => v.id === vehId) || VEHICLES_DATA[0];
        // update bags max and hint
        const bagsInput = $('bags') as HTMLInputElement;
        bagsInput.max = String(selectedVehicle.maxBags);
        if (Number(bagsInput.value) > selectedVehicle.maxBags) bagsInput.value = String(selectedVehicle.maxBags);
        const travInput = $('passengers') as HTMLInputElement;
        travInput.max = String(selectedVehicle.maxTravelers);
        if (Number(travInput.value) > selectedVehicle.maxTravelers) travInput.value = String(selectedVehicle.maxTravelers);
        $('veh-hint').textContent = `تم اختيار ${selectedVehicle.name} — ${selectedVehicle.maxTravelers} ركاب بحد أقصى، ${selectedVehicle.freeBags} شنط كبيرة مجانية`;
        $('bags-hint').textContent = `الحد الأقصى للعربية ${selectedVehicle.maxBags} شنطة كبيرة • ${selectedVehicle.freeBags} شنط مجانية`;
        render();
      });
    });

    document.getElementById('companions')?.addEventListener('input', () => { render(); });

    form.addEventListener('input', render);
    form.addEventListener('change', render);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const c = calc();
      const fail = (msg: string) => { errBox.textContent = msg; errBox.classList.add('is-visible'); errBox.scrollIntoView({ block: 'center', behavior: 'smooth' }); };

      if (!selectedAirport) return fail('يرجى اختيار المطار من القائمة.');
      if (!flightInput.value || !c.flight) return fail('يرجى إدخال تاريخ ووقت إقلاع الطائرة.');
      if (c.depart && c.depart.getTime() < Date.now()) return fail('وقت الإقلاع قريب جداً — يرجى الحجز قبل موعد كافٍ.');

      const pax = Number(($('passengers') as HTMLInputElement).value) || 1;
      const comp = Number(($('companions') as HTMLInputElement).value) || 0;
      if (pax + comp > selectedVehicle.maxTravelers) return fail(`هذه السيارة تتسع لـ ${selectedVehicle.maxTravelers} ركاب فقط (مسافرون + مرافقون).`);
      const bagsVal = Number(($('bags') as HTMLInputElement).value) || 0;
      if (bagsVal > selectedVehicle.maxBags) return fail(`هذه السيارة تتسع لـ ${selectedVehicle.maxBags} شنطة كبيرة فقط.`);

      const name = ($('trav-name') as HTMLInputElement).value.trim();
      const phone = ($('trav-phone') as HTMLInputElement).value.trim();
      if (name.length < 2) return fail('يرجى إدخال اسم المسافر.');
      if (!isEgyptianMobile(phone)) return fail(EG_PHONE_ERROR);
      errBox.classList.remove('is-visible');

      const fromArea = fromAreaPlace?.name || (document.getElementById('from-area') as HTMLInputElement).value || '';
      const orderId = 'WSL-' + new Date().getFullYear() + '-' + Math.floor(100000 + Math.random() * 900000);
      const waitPickupMins = Number(($('wait-pickup') as HTMLSelectElement).value) || 0;
      const waitAirportMins = Number(($('wait-airport') as HTMLSelectElement).value) || 0;

      const order = {
        id: orderId,
        type: 'توصيل مطار',
        icon: '✈️',
        route: `${fromArea} ← ${selectedAirport!.name}`,
        date: 'الآن',
        price: `${c.total} ج.م`,
        status: 'active',
        kind: 'airport',
        airport: selectedAirport!.name,
        flightTime: c.flight!.toISOString(),
        driverArrivalTime: c.driverArrival?.toISOString(),
        departTime: c.depart?.toISOString(),
        arriveTime: c.arrive?.toISOString(),
        checkinDeadline: c.checkinDeadline?.toISOString(),
        airline: ($('airline') as HTMLInputElement).value,
        flightNo: ($('flight-no') as HTMLInputElement).value,
        terminal: ($('terminal') as HTMLInputElement).value,
        vehicle: selectedVehicle.id,
        vehicleName: selectedVehicle.name,
        passengers: pax,
        companions: comp,
        bags: bagsVal,
        waitPickup: waitPickupMins,
        waitAirport: waitAirportMins,
        recipient: name,
        phone: normalizeEgyptianPhone(phone),
        address: `${fromArea} — ${($('address') as HTMLTextAreaElement).value.trim()}`,
        createdAt: new Date().toISOString(),
      };

      try {
        const existing = JSON.parse(localStorage.getItem('wslha_orders') || '[]');
        existing.unshift(order);
        localStorage.setItem('wslha_orders', JSON.stringify(existing));
      } catch { /* storage unavailable */ }

      // Insert into Supabase so online drivers receive the request via Realtime
      try {
        const _SB = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
        const _KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
        const _H = { apikey: _KEY, Authorization: 'Bearer ' + _KEY, 'Content-Type': 'application/json', Prefer: 'return=representation' };
        const payRes = await fetch(_SB + '/rest/v1/rides', {
          method: 'POST', headers: _H,
          body: JSON.stringify({
            customer_phone: order.phone,
            customer_name: order.recipient,
            from_area: fromArea,
            from_lat: fromAreaPlace?.lat ?? 0,
            from_lng: fromAreaPlace?.lng ?? 0,
            to_area: selectedAirport.name,
            to_lat: 0, to_lng: 0,
            distance_km: selectedAirport.distanceKm,
            fare: c.total,
            eta_minutes: selectedAirport.driveMinutes,
            passengers: pax,
            payment: (document.querySelector('input[name="payment"]:checked'))?.value || 'cash',
            notes: `✈️ ${order.airline || ''} ${order.flightNo || ''} — استلام: ${order.address} — إقلاع: ${c.flight?.toLocaleString('ar-EG') || ''} — سيارة: ${order.vehicleName} — شنط: ${bagsVal}`,
            status: 'pending',
            ride_type: 'airport',
          }),
        });
        if (payRes.ok) {
          const rows = await payRes.json();
          if (Array.isArray(rows) && rows[0]?.id) order.supabase_id = rows[0].id;
        }
      } catch { /* Supabase unavailable — order saved locally */ }

      // Success
      $('air-success-id').textContent = orderId;
      ($('air-success-track') as HTMLAnchorElement).href = `/track?q=${encodeURIComponent(orderId)}`;
      $('air-success-card').innerHTML = `
        <div class="air-success__card-header">✈️ تفاصيل الرحلة</div>
        <div class="row"><span class="row-label">المطار</span><span class="row-val">${selectedAirport!.name}</span></div>
        <div class="row"><span class="row-label">السيارة</span><span class="row-val">${selectedVehicle.name}</span></div>
        ${c.driverArrival ? `<div class="row"><span class="row-label">وصول السائق للاستلام</span><span class="row-val">${fmtDateTime(c.driverArrival)}</span></div>` : ''}
        ${c.depart ? `<div class="row"><span class="row-label">المغادرة من نقطة البداية</span><span class="row-val">${fmtDateTime(c.depart)}</span></div>` : ''}
        ${c.arrive ? `<div class="row"><span class="row-label">الوصول للمطار</span><span class="row-val">${fmtDateTime(c.arrive)}</span></div>` : ''}
        <div class="row"><span class="row-label">إقلاع الطائرة</span><span class="row-val">${fmtDateTime(c.flight!)}</span></div>
        <div class="row"><span class="row-label">الرحلة</span><span class="row-val">${order.airline || '—'} ${order.flightNo || ''}</span></div>
        <div class="row"><span class="row-label">المسافرون</span><span class="row-val">${pax}</span></div>
        ${comp > 0 ? `<div class="row"><span class="row-label">مرافقون رايح جاي</span><span class="row-val">${comp}</span></div>` : ''}
        <div class="row"><span class="row-label">الشنط الكبيرة</span><span class="row-val">${bagsVal}</span></div>
        <div class="row row--total"><span class="row-label">الإجمالي</span><span class="row-val">${c.total} ج.م</span></div>`;

      ($('air-wrap') as HTMLElement).style.display = 'none';
      ($('air-success') as HTMLElement).classList.add('is-visible');
      $('air-success').focus();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    render();
  </script>
</Layout>
