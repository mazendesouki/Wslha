---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
import { AIRPORTS, priceForDistance } from '../data/airports';
---

<style>
  .air-wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-10) var(--sp-6) var(--sp-20);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-8);
    align-items: start;
  }

  .air-form {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    padding: var(--sp-8);
  }
  .air-form__step {
    font-size: var(--text-base);
    font-weight: var(--weight-black);
    margin: var(--sp-6) 0 var(--sp-4);
    display: flex; align-items: center; gap: var(--sp-2);
  }
  .air-form__step:first-child { margin-top: 0; }
  .air-form__num {
    width: 26px; height: 26px; border-radius: var(--radius-full);
    background: var(--color-primary); color: #fff; font-size: var(--text-sm);
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .air-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .field { margin-bottom: var(--sp-4); }
  .field__label { display: block; font-weight: var(--weight-bold); font-size: var(--text-sm); margin-bottom: var(--sp-2); color: #374151; }
  .field__input, .field__select, .field__textarea {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border); border-radius: var(--radius);
    font-family: var(--font-body); font-size: var(--text-base);
    direction: rtl; background: var(--color-bg); color: var(--color-text); outline: none;
    transition: border-color var(--ease);
  }
  .field__input:focus, .field__select:focus, .field__textarea:focus { border-color: var(--color-primary); }
  .field__hint { font-size: var(--text-xs); color: var(--color-text-faint); margin-top: 4px; }

  .trip-type { display: flex; gap: var(--sp-3); }
  .trip-type label {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
    padding: var(--sp-3); border: 2px solid var(--color-border); border-radius: var(--radius-lg);
    cursor: pointer; font-weight: var(--weight-bold); font-size: var(--text-sm);
  }
  .trip-type label:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-light); color: var(--color-primary); }
  .trip-type input { position: absolute; opacity: 0; }

  .air-divider { border: none; border-top: 1px solid var(--color-border); margin: var(--sp-6) 0; }

  /* Summary panel */
  .air-summary {
    position: sticky;
    top: calc(var(--nav-height) + var(--sp-4));
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .air-summary__head {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: #fff; padding: var(--sp-5);
  }
  .air-summary__head h2 { font-size: var(--text-lg); font-weight: var(--weight-black); }
  .air-summary__route { font-size: var(--text-sm); opacity: 0.9; margin-top: 2px; }
  .air-summary__body { padding: var(--sp-5); }

  /* Timeline */
  .timeline { list-style: none; position: relative; padding-inline-start: var(--sp-8); margin-bottom: var(--sp-5); }
  .timeline::before { content: ''; position: absolute; inset-inline-start: 9px; top: 8px; bottom: 8px; width: 2px; background: var(--color-border); }
  .tl-item { position: relative; margin-bottom: var(--sp-5); }
  .tl-item:last-child { margin-bottom: 0; }
  .tl-dot { position: absolute; inset-inline-start: calc(-1 * var(--sp-8) + 2px); top: 2px; width: 18px; height: 18px; border-radius: var(--radius-full); background: var(--color-bg); border: 3px solid var(--color-primary); }
  .tl-item--flight .tl-dot { border-color: var(--color-accent); }
  .tl-label { font-size: var(--text-xs); color: var(--color-text-muted); }
  .tl-time { font-weight: var(--weight-black); font-size: var(--text-base); }
  .tl-sub { font-size: var(--text-xs); color: var(--color-text-faint); }
  .tl-empty { color: var(--color-text-faint); font-size: var(--text-sm); }

  .air-prices { border-top: 1px solid var(--color-border); padding-top: var(--sp-4); }
  .air-prices .row { display: flex; justify-content: space-between; font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--sp-2); }
  .air-prices .total { display: flex; justify-content: space-between; align-items: baseline; margin-top: var(--sp-3); padding-top: var(--sp-3); border-top: 2px solid var(--color-border); }
  .air-prices .total b { font-size: var(--text-3xl); font-weight: var(--weight-black); color: var(--color-primary); line-height: 1; }
  .air-prices .total b small { font-size: var(--text-sm); }

  .air-error { background: #FEE2E2; color: #B91C1C; border-radius: var(--radius); padding: var(--sp-3) var(--sp-4); font-size: var(--text-sm); margin: var(--sp-4) 0 0; display: none; }
  .air-error.is-visible { display: block; }

  .air-submit {
    width: 100%; margin-top: var(--sp-5); padding: var(--sp-4);
    background: var(--color-accent); color: var(--color-text); border: none; border-radius: var(--radius);
    font-family: var(--font-body); font-weight: var(--weight-black); font-size: var(--text-base);
  }
  .air-submit:hover:not(:disabled) { background: var(--color-accent-dark); }
  .air-submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .air-note { font-size: var(--text-xs); color: var(--color-text-faint); text-align: center; margin-top: var(--sp-3); }

  /* Success */
  .air-success { display: none; max-width: 560px; margin: 0 auto; text-align: center; padding: var(--sp-16) var(--sp-6); }
  .air-success.is-visible { display: block; }
  .air-success__icon { width: 80px; height: 80px; border-radius: var(--radius-full); background: var(--color-primary-light); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto var(--sp-6); }
  .air-success__id { font-weight: var(--weight-black); color: var(--color-primary); font-size: var(--text-lg); margin: var(--sp-2) 0 var(--sp-6); }
  .air-success__card { background: var(--color-bg-soft); border-radius: var(--radius-lg); padding: var(--sp-5); text-align: right; margin-bottom: var(--sp-8); }
  .air-success__card .row { display: flex; justify-content: space-between; padding: var(--sp-2) 0; font-size: var(--text-sm); border-bottom: 1px solid var(--color-border); }
  .air-success__card .row:last-child { border-bottom: none; }
  .air-success__card .row span:first-child { color: var(--color-text-muted); }
  .air-success__card .row span:last-child { font-weight: var(--weight-bold); }

  @media (max-width: 860px) {
    .air-wrap { grid-template-columns: 1fr; }
    .air-summary { position: static; }
    .air-row { grid-template-columns: 1fr; }
  }
  /* ensure Google Places dropdown appears above everything */
  .pac-container { z-index: 9999 !important; direction: rtl; font-family: var(--font-body); }
</style>

<Layout
  title="توصيل المطار"
  description="خدمة توصيل من دمياط إلى جميع مطارات مصر — أدخل وقت إقلاع رحلتك ونحسب لك وقت المغادرة تلقائياً"
  page="airport"
>
  <PageHero
    badge="✈️ توصيل المطار"
    title="من دمياط إلى كل مطارات مصر"
    subtitle="أدخل بيانات رحلتك ووقت الإقلاع — ونحسب لك وقت المغادرة المثالي تلقائياً مع سعر ثابت حسب المسافة"
  />

  <div class="air-wrap" id="air-wrap">

    <!-- Form -->
    <form class="air-form" id="air-form">
      <!-- 1: Trip -->
      <h2 class="air-form__step"><span class="air-form__num">1</span> تفاصيل الرحلة</h2>

      <div class="field">
        <span class="field__label">نوع الرحلة</span>
        <div class="trip-type">
          <label><input type="radio" name="trip" value="international" checked>✈️ دولية (3 ساعات)</label>
          <label><input type="radio" name="trip" value="domestic">🛫 محلية (ساعتان)</label>
        </div>
        <p class="field__hint">نستخدمها لحساب الوقت اللازم للوصول قبل الإقلاع.</p>
      </div>

      <div class="air-row">
        <div class="field">
          <label class="field__label" for="from-area">نقطة البداية (منطقتك)</label>
          <input type="text" class="field__input" id="from-area" placeholder="اكتب منطقتك أو حيّك في دمياط..." autocomplete="off" />
        </div>
        <div class="field">
          <label class="field__label" for="airport">المطار (نقطة النهاية)</label>
          <select class="field__select" id="airport">
            <option value="" disabled selected>اختر المطار</option>
            {AIRPORTS.map(a => (
              <option value={a.id} data-distance={a.distanceKm} data-drive={a.driveMinutes} data-name={a.name}>
                {a.name} ({a.code}) — {a.distanceKm} كم
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="address">عنوان الاستلام بالتفصيل</label>
        <textarea class="field__textarea" id="address" placeholder="الحي، الشارع، رقم المبنى، علامة مميزة..."></textarea>
      </div>

      <div class="field">
        <label class="field__label" for="flight-time">تاريخ ووقت إقلاع الطائرة</label>
        <input class="field__input" id="flight-time" type="datetime-local">
        <p class="field__hint">سنحسب لك وقت المغادرة من بيتك ووقت الوصول للمطار تلقائياً.</p>
      </div>

      <hr class="air-divider">

      <!-- 2: Flight info -->
      <h2 class="air-form__step"><span class="air-form__num">2</span> بيانات الطيران</h2>
      <div class="air-row">
        <div class="field">
          <label class="field__label" for="airline">شركة الطيران</label>
          <input class="field__input" id="airline" type="text" placeholder="مثال: مصر للطيران">
        </div>
        <div class="field">
          <label class="field__label" for="flight-no">رقم الرحلة</label>
          <input class="field__input" id="flight-no" type="text" placeholder="MS 712">
        </div>
      </div>
      <div class="air-row">
        <div class="field">
          <label class="field__label" for="terminal">رقم الصالة / المبنى</label>
          <input class="field__input" id="terminal" type="text" placeholder="مثال: مبنى 2">
        </div>
        <div class="field">
          <label class="field__label" for="passengers">عدد المسافرين</label>
          <input class="field__input" id="passengers" type="number" min="1" max="15" value="1">
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="bags">عدد الشنط</label>
        <input class="field__input" id="bags" type="number" min="0" max="30" value="2">
        <p class="field__hint">٤ شنط مجاناً، وكل شنطة إضافية ١٥ ج.م.</p>
      </div>

      <hr class="air-divider">

      <!-- 3: Traveler -->
      <h2 class="air-form__step"><span class="air-form__num">3</span> بيانات المسافر</h2>
      <div class="air-row">
        <div class="field">
          <label class="field__label" for="trav-name">اسم المسافر</label>
          <input class="field__input" id="trav-name" type="text" placeholder="محمد أحمد" autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="trav-phone">رقم الجوال</label>
          <input class="field__input" id="trav-phone" type="tel" placeholder="010 1234 5678" inputmode="numeric" maxlength="11" pattern="01[0125][0-9]{8}" autocomplete="tel">
        </div>
      </div>
    </form>

    <!-- Live summary -->
    <aside class="air-summary" aria-label="ملخص الرحلة">
      <div class="air-summary__head">
        <h2>رحلتك</h2>
        <p class="air-summary__route" id="sum-route">اختر المطار ووقت الإقلاع</p>
      </div>
      <div class="air-summary__body">
        <ol class="timeline" id="timeline">
          <li class="tl-empty" id="tl-empty">أدخل وقت إقلاع الطائرة لعرض الجدول الزمني المقترح.</li>
          <li class="tl-item" id="tl-pickup" hidden>
            <span class="tl-dot"></span>
            <p class="tl-label">🚗 المغادرة من نقطة البداية</p>
            <p class="tl-time" data-pickup>—</p>
            <p class="tl-sub" id="tl-pickup-sub"></p>
          </li>
          <li class="tl-item" id="tl-arrive" hidden>
            <span class="tl-dot"></span>
            <p class="tl-label">🛄 الوصول إلى المطار</p>
            <p class="tl-time" data-arrive>—</p>
            <p class="tl-sub" id="tl-arrive-sub"></p>
          </li>
          <li class="tl-item tl-item--flight" id="tl-flight" hidden>
            <span class="tl-dot"></span>
            <p class="tl-label">✈️ إقلاع الطائرة</p>
            <p class="tl-time" data-flight>—</p>
          </li>
        </ol>

        <div class="air-prices">
          <div class="row"><span>المسافة</span><span id="p-distance">—</span></div>
          <div class="row"><span>سعر المسافة</span><span id="p-base">—</span></div>
          <div class="row" id="p-van-row" hidden><span>مركبة أكبر (٥+ ركاب)</span><span id="p-van">—</span></div>
          <div class="row" id="p-bags-row" hidden><span>شنط إضافية</span><span id="p-bags">—</span></div>
          <div class="total"><span>الإجمالي</span><b id="p-total">— <small>ج.م</small></b></div>
        </div>

        <div class="air-error" id="air-error" role="alert" aria-live="polite"></div>
        <button type="submit" form="air-form" class="air-submit" id="air-submit">تأكيد الحجز ←</button>
        <p class="air-note">سعر ثابت حسب المسافة — الدفع نقداً أو إلكترونياً</p>
      </div>
    </aside>
  </div>

  <!-- Success -->
  <section class="air-success" id="air-success" role="alert" aria-live="polite" tabindex="-1">
    <div class="air-success__icon" aria-hidden="true">✅</div>
    <h2 style="font-size:var(--text-2xl);font-weight:900;">تم تأكيد حجز رحلتك!</h2>
    <p style="color:var(--color-text-muted);">سيصلك السائق في الموعد المحدد. رقم الحجز:</p>
    <p class="air-success__id" id="air-success-id">—</p>
    <div class="air-success__card" id="air-success-card"></div>
    <div style="display:flex;gap:var(--sp-4);justify-content:center;flex-wrap:wrap;">
      <a href="/orders" class="btn btn--primary">طلباتي</a>
      <a href="/track" class="btn btn--outline">📡 تتبع</a>
    </div>
  </section>

  <script>
    import { priceForDistance, CHECKIN_BUFFER, SAFETY_MARGIN } from '../data/airports';
    import { isEgyptianMobile, normalizeEgyptianPhone, EG_PHONE_ERROR } from '../utils/phone';

    const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';

    const $ = (id: string) => document.getElementById(id)!;
    const form = $('air-form') as HTMLFormElement;
    const airportSel = $('airport') as HTMLSelectElement;
    const flightInput = $('flight-time') as HTMLInputElement;
    const errBox = $('air-error') as HTMLElement;

    // ── Google Places for from-area ──
    let fromAreaPlace: { name: string; lat: number; lng: number } | null = null;

    function loadGoogleMaps(): Promise<void> {
      return new Promise((resolve) => {
        if ((window as any).google?.maps) { resolve(); return; }
        (window as any).__airGmInit = resolve;
        const s = document.createElement('script');
        s.src = `https://maps.googleapis.com/maps/api/js?key=${GMAPS_KEY}&libraries=places&callback=__airGmInit&language=ar`;
        s.async = true;
        document.head.appendChild(s);
      });
    }

    async function initFromAreaAutocomplete(): Promise<void> {
      await loadGoogleMaps();
      const G = (window as any).google.maps;
      const damiettaBounds = new G.LatLngBounds(
        { lat: 31.25, lng: 31.55 },
        { lat: 31.60, lng: 32.05 }
      );
      const ac = new G.places.Autocomplete(document.getElementById('from-area'), {
        bounds: damiettaBounds,
        componentRestrictions: { country: 'eg' },
        strictBounds: false,
        fields: ['geometry', 'name', 'formatted_address'],
      });
      ac.addListener('place_changed', () => {
        const p = ac.getPlace();
        if (!p?.geometry?.location) return;
        fromAreaPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
        render();
      });
    }

    initFromAreaAutocomplete();

    const BAG_FREE = 4;
    const BAG_FEE = 15;
    const VAN_THRESHOLD = 5;
    const VAN_SURCHARGE = 0.40;

    // Minimum datetime = now + 2h
    const min = new Date(Date.now() + 2 * 3600 * 1000);
    flightInput.min = new Date(min.getTime() - min.getTimezoneOffset() * 60000).toISOString().slice(0, 16);

    function fmtDateTime(d: Date): string {
      return new Intl.DateTimeFormat('ar-EG', {
        weekday: 'short', day: 'numeric', month: 'long',
        hour: 'numeric', minute: '2-digit', hour12: true,
      }).format(d);
    }
    function minutesToText(m: number): string {
      const h = Math.floor(m / 60), mm = m % 60;
      if (h && mm) return `${h} ساعة و${mm} دقيقة`;
      if (h) return `${h} ساعة`;
      return `${mm} دقيقة`;
    }

    interface Calc {
      distance: number; drive: number; base: number; van: number; bags: number; total: number;
      flight?: Date; arrive?: Date; pickup?: Date; buffer: number;
    }

    function calc(): Calc {
      const opt = airportSel.selectedOptions[0];
      const distance = opt ? Number(opt.dataset.distance) : 0;
      const drive = opt ? Number(opt.dataset.drive) : 0;
      const trip = (form.querySelector('input[name="trip"]:checked') as HTMLInputElement).value as 'domestic' | 'international';
      const buffer = trip === 'international' ? CHECKIN_BUFFER.international : CHECKIN_BUFFER.domestic;
      const passengers = Math.max(1, Number((($('passengers') as HTMLInputElement).value) || 1));
      const bags = Math.max(0, Number((($('bags') as HTMLInputElement).value) || 0));

      const base = distance ? priceForDistance(distance) : 0;
      const van = passengers >= VAN_THRESHOLD ? Math.ceil(base * VAN_SURCHARGE / 10) * 10 : 0;
      const bagFee = Math.max(0, bags - BAG_FREE) * BAG_FEE;
      const total = base + van + bagFee;

      const result: Calc = { distance, drive, base, van, bags: bagFee, total, buffer };

      if (flightInput.value && distance) {
        const flight = new Date(flightInput.value);
        if (!isNaN(flight.getTime())) {
          const arrive = new Date(flight.getTime() - buffer * 60000);
          const pickup = new Date(arrive.getTime() - (drive + SAFETY_MARGIN) * 60000);
          result.flight = flight; result.arrive = arrive; result.pickup = pickup;
        }
      }
      return result;
    }

    function render(): void {
      const c = calc();
      const opt = airportSel.selectedOptions[0];
      const fromArea = fromAreaPlace?.name || (document.getElementById('from-area') as HTMLInputElement).value || '';

      // Route
      $('sum-route').textContent = opt && opt.value
        ? `${fromArea} ← ${opt.dataset.name}`
        : 'اختر المطار ووقت الإقلاع';

      // Timeline
      const hasTime = !!c.flight;
      $('tl-empty').hidden = hasTime;
      ['tl-pickup', 'tl-arrive', 'tl-flight'].forEach(id => ($(id) as HTMLElement).hidden = !hasTime);
      if (hasTime) {
        (document.querySelector('[data-pickup]') as HTMLElement).textContent = fmtDateTime(c.pickup!);
        (document.querySelector('[data-arrive]') as HTMLElement).textContent = fmtDateTime(c.arrive!);
        (document.querySelector('[data-flight]') as HTMLElement).textContent = fmtDateTime(c.flight!);
        $('tl-pickup-sub').textContent = `زمن الطريق ~${minutesToText(c.drive)} + هامش أمان`;
        $('tl-arrive-sub').textContent = `قبل الإقلاع بـ ${minutesToText(c.buffer)}`;
      }

      // Prices
      $('p-distance').textContent = c.distance ? `${c.distance} كم` : '—';
      $('p-base').textContent = c.base ? `${c.base} ج.م` : '—';
      const vanRow = $('p-van-row'); vanRow.hidden = c.van === 0;
      $('p-van').textContent = `${c.van} ج.م`;
      const bagsRow = $('p-bags-row'); bagsRow.hidden = c.bags === 0;
      $('p-bags').textContent = `${c.bags} ج.م`;
      $('p-total').innerHTML = c.total ? `${c.total} <small>ج.م</small>` : '— <small>ج.م</small>';
    }

    form.addEventListener('input', render);
    form.addEventListener('change', render);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const c = calc();
      const fail = (msg: string) => { errBox.textContent = msg; errBox.classList.add('is-visible'); errBox.scrollIntoView({ block: 'center', behavior: 'smooth' }); };

      if (!airportSel.value) return fail('يرجى اختيار المطار.');
      if (!flightInput.value || !c.flight) return fail('يرجى إدخال تاريخ ووقت إقلاع الطائرة.');
      if (c.pickup && c.pickup.getTime() < Date.now()) return fail('وقت الإقلاع قريب جداً — يرجى الحجز قبل موعد كافٍ.');
      const name = ($('trav-name') as HTMLInputElement).value.trim();
      const phone = ($('trav-phone') as HTMLInputElement).value.trim();
      if (name.length < 2) return fail('يرجى إدخال اسم المسافر.');
      if (!isEgyptianMobile(phone)) return fail(EG_PHONE_ERROR);
      errBox.classList.remove('is-visible');

      const opt = airportSel.selectedOptions[0];
      const fromArea = fromAreaPlace?.name || (document.getElementById('from-area') as HTMLInputElement).value || '';
      const orderId = 'WSL-' + new Date().getFullYear() + '-' + Math.floor(100000 + Math.random() * 900000);

      const order = {
        id: orderId,
        type: 'توصيل مطار',
        icon: '✈️',
        route: `${fromArea} ← ${opt.dataset.name}`,
        date: 'الآن',
        price: `${c.total} ج.م`,
        status: 'active',
        kind: 'airport',
        airport: opt.dataset.name,
        flightTime: c.flight!.toISOString(),
        pickupTime: c.pickup!.toISOString(),
        arriveTime: c.arrive!.toISOString(),
        airline: ($('airline') as HTMLInputElement).value,
        flightNo: ($('flight-no') as HTMLInputElement).value,
        terminal: ($('terminal') as HTMLInputElement).value,
        passengers: ($('passengers') as HTMLInputElement).value,
        bags: ($('bags') as HTMLInputElement).value,
        recipient: name,
        phone: normalizeEgyptianPhone(phone),
        address: `${fromArea} — ${($('address') as HTMLTextAreaElement).value.trim()}`,
        createdAt: new Date().toISOString(),
      };

      try {
        const existing = JSON.parse(localStorage.getItem('wslha_orders') || '[]');
        existing.unshift(order);
        localStorage.setItem('wslha_orders', JSON.stringify(existing));
      } catch { /* storage unavailable */ }

      // Success
      $('air-success-id').textContent = orderId;
      $('air-success-card').innerHTML = `
        <div class="row"><span>المطار</span><span>${opt.dataset.name}</span></div>
        <div class="row"><span>المغادرة من بيتك</span><span>${fmtDateTime(c.pickup!)}</span></div>
        <div class="row"><span>الوصول للمطار</span><span>${fmtDateTime(c.arrive!)}</span></div>
        <div class="row"><span>إقلاع الطائرة</span><span>${fmtDateTime(c.flight!)}</span></div>
        <div class="row"><span>الرحلة</span><span>${order.airline || '—'} ${order.flightNo || ''}</span></div>
        <div class="row"><span>المسافرون / الشنط</span><span>${order.passengers} / ${order.bags}</span></div>
        <div class="row"><span>الإجمالي</span><span>${c.total} ج.م</span></div>`;

      ($('air-wrap') as HTMLElement).style.display = 'none';
      ($('air-success') as HTMLElement).classList.add('is-visible');
      $('air-success').focus();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    render();
  </script>
</Layout>
