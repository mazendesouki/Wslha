---
import Layout from '../../components/layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<style>
  .mine { max-width: 900px; margin: 0 auto; padding: var(--sp-5) var(--sp-4) var(--sp-8); }
  .mine-empty { text-align: center; padding: var(--sp-8) var(--sp-4); color: var(--color-text-muted); background: var(--color-bg); border-radius: var(--radius-lg); }
  .mine-empty__icon { font-size: 2.5rem; margin-bottom: var(--sp-3); }
  .mine-list { display: flex; flex-direction: column; gap: var(--sp-3); }
  .mine-item {
    display: flex; gap: var(--sp-3); align-items: center;
    background: var(--color-surface); border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg); padding: var(--sp-3);
  }
  .mine-item__cover {
    width: 76px; height: 76px; border-radius: var(--radius-md); overflow: hidden;
    background: #F2F7F6; display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem; flex-shrink: 0;
  }
  .mine-item__cover img { width: 100%; height: 100%; object-fit: cover; }
  .mine-item__body { flex: 1; min-width: 0; }
  .mine-item__title { font-weight: var(--weight-bold); font-size: var(--text-sm); margin-bottom: 2px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mine-item__meta { font-size: var(--text-xs); color: var(--color-text-faint); }
  .mine-item__price { font-weight: var(--weight-black); color: #059669; font-size: var(--text-sm); margin-top: 2px; }
  .mine-item__status {
    display: inline-block; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 99px; margin-top: 4px;
  }
  .st-active { background: #DCFCE7; color: #15803D; }
  .st-sold { background: #E0E7FF; color: #3730A3; }
  .st-removed { background: #F1F5F9; color: #64748B; }
  .st-under_review { background: #FEF3C7; color: #92400E; }
  .mine-item__actions { display: flex; flex-direction: column; gap: 6px; flex-shrink: 0; }
  .mine-item__actions button {
    font-size: var(--text-xs); font-weight: 700; padding: 6px 12px; border-radius: var(--radius-md);
    border: 1.5px solid var(--color-border); background: var(--color-surface); cursor: pointer;
  }
  .mine-item__actions button.danger { color: #DC2626; border-color: #FCA5A5; }
  .mine-item__actions button:disabled { opacity: .5; cursor: default; }
</style>

<Layout title="إعلاناتي | وصّلها" description="إعلاناتك في سوق المستعمل" page="marketplace">
  <PageHero badge="سوق المستعمل" title="📋 إعلاناتي" subtitle="إعلاناتك المنشورة — تقدر تحدّد أي إعلان كمباع أو تشيله" />

  <section class="mine">
    <div id="mine-content">
      <p style="text-align:center;color:var(--color-text-muted);padding:var(--sp-6) 0;background:var(--color-bg);border-radius:var(--radius-lg)">جاري التحميل…</p>
    </div>
  </section>
</Layout>

<script>
  import { fetchMyItems, updateOwnItemStatus, type MarketItem } from '../../utils/marketplaceApi';

  let user: any = null;
  try { user = JSON.parse(localStorage.getItem('wslha_user') || 'null'); } catch {}
  if (!user || !user.phone) { window.location.href = '/login?next=/marketplace/mine'; }

  function escapeHtml(s: string) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' } as Record<string,string>)[c]);
  }
  function fmtPrice(n: number) { return Number(n || 0).toLocaleString('ar-EG') + ' ج.م'; }
  const STATUS_LABEL: Record<string, string> = { active: 'منشور', sold: 'تم البيع', removed: 'محذوف', under_review: 'قيد المراجعة' };

  let items: MarketItem[] = [];

  function render() {
    const el = document.getElementById('mine-content')!;
    if (!items.length) {
      el.innerHTML = `<div class="mine-empty"><div class="mine-empty__icon">📦</div><p>لسه معملتش أي إعلان</p>
        <p><a href="/marketplace/post" style="color:var(--color-primary);font-weight:700">أضف أول إعلان لك ←</a></p></div>`;
      return;
    }
    el.innerHTML = `<div class="mine-list">${items.map(i => `
      <div class="mine-item" data-id="${i.id}">
        <div class="mine-item__cover">${i.images?.[0] ? `<img src="${i.images[0]}" alt="">` : '📦'}</div>
        <div class="mine-item__body">
          <div class="mine-item__title">${escapeHtml(i.title)}</div>
          <div class="mine-item__meta">👁️ ${i.views || 0} مشاهدة</div>
          <div class="mine-item__price">${fmtPrice(i.price)}</div>
          <span class="mine-item__status st-${i.status}">${STATUS_LABEL[i.status] || i.status}</span>
        </div>
        <div class="mine-item__actions">
          <button class="btn-mark-sold" data-id="${i.id}" ${i.status !== 'active' ? 'disabled' : ''}>✅ تم البيع</button>
          <button class="btn-remove danger" data-id="${i.id}" ${i.status === 'removed' ? 'disabled' : ''}>🗑️ حذف</button>
        </div>
      </div>`).join('')}</div>`;

    el.querySelectorAll<HTMLButtonElement>('.btn-mark-sold').forEach(btn => {
      btn.addEventListener('click', () => updateStatus(btn.dataset.id!, 'sold', btn));
    });
    el.querySelectorAll<HTMLButtonElement>('.btn-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        if (!confirm('متأكد إنك عايز تحذف الإعلان ده؟')) return;
        updateStatus(btn.dataset.id!, 'removed', btn);
      });
    });
  }

  async function updateStatus(itemId: string, status: 'sold' | 'removed', btn: HTMLButtonElement) {
    btn.disabled = true;
    const ok = await updateOwnItemStatus(user.phone, itemId, status);
    if (ok) {
      const it = items.find(x => x.id === itemId);
      if (it) it.status = status;
      render();
    } else {
      btn.disabled = false;
      alert('تعذّر تحديث الإعلان — حاول مرة أخرى');
    }
  }

  (async () => {
    items = await fetchMyItems(user.phone);
    render();
  })();
</script>
