---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
---

<style>
  .market {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-8) var(--sp-6) var(--sp-20);
  }

  .search-bar {
    display: flex; gap: var(--sp-3); align-items: center;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--sp-3) var(--sp-5);
    margin-bottom: var(--sp-5);
  }
  .search-bar:focus-within { border-color: var(--color-primary); }
  .search-bar__input {
    flex: 1; border: none; outline: none;
    font-family: var(--font-body); font-size: var(--text-base);
    color: var(--color-text); background: transparent; direction: rtl;
  }
  .search-bar__input::placeholder { color: var(--color-text-faint); }

  .post-cta {
    display: flex; align-items: center; justify-content: space-between;
    background: linear-gradient(135deg, #059669, #047857);
    color: #fff; border-radius: var(--radius-xl);
    padding: var(--sp-5) var(--sp-6); margin-bottom: var(--sp-6);
    gap: var(--sp-4); flex-wrap: wrap;
  }
  .post-cta__text { font-weight: var(--weight-bold); font-size: var(--text-base); }
  .post-cta__sub { font-size: var(--text-xs); opacity: .85; margin-top: 2px; }
  .post-cta__btn {
    background: #fff; color: #047857; padding: var(--sp-3) var(--sp-6);
    border-radius: var(--radius-lg); font-weight: var(--weight-black);
    font-size: var(--text-sm); text-decoration: none; white-space: nowrap;
  }

  .cats {
    display: flex; gap: var(--sp-2); overflow-x: auto;
    padding-bottom: var(--sp-2); margin-bottom: var(--sp-6);
    scrollbar-width: thin;
  }
  .cat-chip {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-5); border-radius: var(--radius-full);
    border: 2px solid var(--color-border); background: var(--color-bg);
    font-family: var(--font-body); font-weight: var(--weight-bold);
    font-size: var(--text-sm); color: var(--color-text-muted);
    white-space: nowrap; cursor: pointer; transition: all var(--ease);
  }
  .cat-chip:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .cat-chip.is-active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }

  .results-bar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--sp-4); font-size: var(--text-sm); color: var(--color-text-faint);
  }
  .results-bar strong { color: var(--color-text); }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-5);
  }

  .item-card {
    display: flex; flex-direction: column;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: border-color var(--ease), box-shadow var(--ease), transform var(--ease);
    text-decoration: none; color: inherit;
  }
  .item-card:hover { border-color: var(--color-primary); box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .item-card__cover {
    height: 150px; background: linear-gradient(135deg, var(--color-primary-light), #dbeafe);
    display: flex; align-items: center; justify-content: center; font-size: 2.6rem;
    overflow: hidden; position: relative;
  }
  .item-card__cover img { width: 100%; height: 100%; object-fit: cover; }
  .item-card__badge {
    position: absolute; top: var(--sp-2); right: var(--sp-2);
    background: rgba(0,0,0,.55); color: #fff; border-radius: var(--radius-full);
    padding: 2px var(--sp-3); font-size: 10px; font-weight: var(--weight-bold);
  }
  .item-card__merchant {
    position: absolute; top: var(--sp-2); left: var(--sp-2);
    background: #059669; color: #fff; border-radius: var(--radius-full);
    padding: 2px var(--sp-3); font-size: 10px; font-weight: var(--weight-bold);
  }
  .item-card__body { padding: var(--sp-3) var(--sp-4); flex: 1; display: flex; flex-direction: column; }
  .item-card__title { font-size: var(--text-sm); font-weight: var(--weight-black); margin-bottom: 4px; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .item-card__meta { font-size: 11px; color: var(--color-text-faint); margin-bottom: var(--sp-2); }
  .item-card__price { font-size: var(--text-lg); font-weight: var(--weight-black); color: #059669; margin-top: auto; }

  .no-results { grid-column: 1 / -1; text-align: center; padding: var(--sp-16); color: var(--color-text-muted); }
  .no-results__icon { font-size: 3rem; margin-bottom: var(--sp-3); }

  @media (max-width: 980px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 680px) { .grid { grid-template-columns: repeat(2, 1fr); } .post-cta { flex-direction: column; text-align: center; } }
</style>

<script>
  import { fetchItems, CATEGORIES, type MarketItem } from '../utils/marketplaceApi';

  let all: MarketItem[] = [];
  let activeCat = '';

  function fmtPrice(n: number) { return Number(n || 0).toLocaleString('ar-EG') + ' ج.م'; }

  function render() {
    const search = (document.getElementById('mkt-search') as HTMLInputElement).value.trim().toLowerCase();
    let rows = all;
    if (activeCat) rows = rows.filter(i => i.category === activeCat);
    if (search) rows = rows.filter(i => i.title.toLowerCase().includes(search) || (i.description || '').toLowerCase().includes(search));

    document.getElementById('mkt-count')!.textContent = String(rows.length);

    const grid = document.getElementById('mkt-grid')!;
    if (!rows.length) {
      grid.innerHTML = `<div class="no-results"><div class="no-results__icon">🔍</div><p>لا توجد إعلانات مطابقة</p></div>`;
      return;
    }
    grid.innerHTML = rows.map(i => `
      <a class="item-card" href="/marketplace/item?id=${i.id}">
        <div class="item-card__cover">
          ${i.images?.[0] ? `<img src="${i.images[0]}" loading="lazy" alt="">` : '📦'}
          ${i.seller_type === 'merchant' ? '<span class="item-card__merchant">🏪 تاجر</span>' : ''}
          <span class="item-card__badge">${i.condition === 'new' ? 'جديد' : i.condition === 'like_new' ? 'كالجديد' : 'مستعمل'}</span>
        </div>
        <div class="item-card__body">
          <div class="item-card__title">${i.title}</div>
          <div class="item-card__meta">📍 ${i.city || i.area || 'دمياط الجديدة'}</div>
          <div class="item-card__price">${fmtPrice(i.price)}</div>
        </div>
      </a>`).join('');
  }

  async function load() {
    document.getElementById('mkt-grid')!.innerHTML = `<div class="no-results">جاري التحميل…</div>`;
    all = await fetchItems();
    render();
  }

  document.getElementById('mkt-search')!.addEventListener('input', render);

  const catsEl = document.getElementById('mkt-cats')!;
  catsEl.innerHTML = `<button class="cat-chip is-active" data-cat="">🗂️ الكل</button>` +
    CATEGORIES.map(c => `<button class="cat-chip" data-cat="${c.id}">${c.emoji} ${c.label}</button>`).join('');
  catsEl.querySelectorAll('.cat-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      activeCat = (btn as HTMLElement).dataset.cat || '';
      catsEl.querySelectorAll('.cat-chip').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      render();
    });
  });

  load();
</script>

<Layout title="سوق المستعمل | وصّلها" description="بيع واشترِ مستعمل بسهولة في دمياط الجديدة" page="marketplace">
  <PageHero
    badge="🛍️ سوق المستعمل"
    title="سوق المستعمل"
    subtitle="بيع اللي مش محتاجه، واشترِ بأسعار حلوة — من الجيران في دمياط الجديدة"
  />

  <section class="market">
    <div class="post-cta">
      <div>
        <div class="post-cta__text">عندك حاجة تبيعها؟</div>
        <div class="post-cta__sub">انشر إعلانك في أقل من دقيقة — مجاناً</div>
      </div>
      <a class="post-cta__btn" href="/marketplace/post">➕ أضف إعلان</a>
    </div>

    <div class="search-bar">
      <span>🔍</span>
      <input class="search-bar__input" id="mkt-search" type="search" placeholder="ابحث عن منتج…">
    </div>

    <div class="cats" id="mkt-cats"></div>

    <div class="results-bar">
      <span><strong id="mkt-count">0</strong> إعلان</span>
    </div>

    <div class="grid" id="mkt-grid"></div>
  </section>
</Layout>
