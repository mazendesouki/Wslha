---
import Layout from '../components/layout.astro';
---

<style>
  /* ── page shell ── */
  .wallet-page {
    max-width: 480px;
    margin: 0 auto;
    min-height: 100vh;
    background: #f1f5f9;
    padding-bottom: 90px;
    font-family: var(--font-body);
  }

  /* ── top bar ── */
  .wallet-topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--sp-4) var(--sp-5);
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    position: sticky; top: 0; z-index: 50;
  }
  .wallet-topbar__title { font-size: var(--text-base); font-weight: var(--weight-black); }
  .topbar-back {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 50%;
    border: none; background: #f1f5f9; cursor: pointer;
    font-size: 1.1rem; color: var(--color-text-muted);
    transition: background 0.2s;
  }
  .topbar-back:hover { background: #e2e8f0; }

  /* ── hero balance card ── */
  .balance-hero {
    background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 60%, #06b6d4 100%);
    margin: var(--sp-4);
    border-radius: 24px;
    padding: var(--sp-6) var(--sp-6) var(--sp-5);
    color: #fff;
    box-shadow: 0 8px 32px rgba(29,78,216,.35);
    position: relative;
    overflow: hidden;
  }
  .balance-hero::before {
    content: ''; position: absolute;
    width: 220px; height: 220px; border-radius: 50%;
    background: rgba(255,255,255,.08);
    top: -60px; left: -60px; pointer-events: none;
  }
  .balance-hero::after {
    content: ''; position: absolute;
    width: 160px; height: 160px; border-radius: 50%;
    background: rgba(255,255,255,.06);
    bottom: -50px; right: -30px; pointer-events: none;
  }
  .balance-label { font-size: var(--text-xs); opacity: .85; margin-bottom: var(--sp-1); }
  .balance-amount {
    font-size: 3rem; font-weight: 900; line-height: 1.1;
    display: flex; align-items: baseline; gap: var(--sp-2);
  }
  .balance-currency { font-size: var(--text-base); font-weight: var(--weight-bold); opacity: .85; }
  .balance-card-row {
    display: flex; align-items: center; gap: var(--sp-3);
    margin-top: var(--sp-4); padding-top: var(--sp-4);
    border-top: 1px solid rgba(255,255,255,.2);
  }
  .balance-card-num { font-size: var(--text-xs); letter-spacing: 2px; opacity: .9; flex: 1; }
  .balance-card-badge {
    font-size: 10px; font-weight: var(--weight-bold);
    background: rgba(255,255,255,.2); border-radius: 99px;
    padding: 2px 10px; white-space: nowrap;
  }

  /* ── hero action buttons ── */
  .hero-actions {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-2); margin-top: var(--sp-5);
    position: relative; z-index: 1;
  }
  .hero-action {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    background: rgba(255,255,255,.15); border: none; border-radius: var(--radius-lg);
    padding: var(--sp-3) var(--sp-2); cursor: pointer;
    color: #fff; font-family: var(--font-body);
    transition: background 0.2s;
  }
  .hero-action:hover { background: rgba(255,255,255,.25); }
  .hero-action__icon { font-size: 1.3rem; }
  .hero-action__lbl { font-size: 11px; font-weight: var(--weight-bold); white-space: nowrap; }

  /* ── stats strip ── */
  .stats-strip {
    display: grid; grid-template-columns: repeat(3,1fr);
    gap: var(--sp-3); margin: 0 var(--sp-4) var(--sp-4);
  }
  .stat-box {
    background: #fff; border-radius: var(--radius-xl);
    padding: var(--sp-4) var(--sp-3); text-align: center;
    box-shadow: 0 1px 8px rgba(0,0,0,.06);
  }
  .stat-box__val { font-size: var(--text-xl); font-weight: var(--weight-black); color: var(--color-primary); line-height: 1; }
  .stat-box__lbl { font-size: 10px; color: var(--color-text-faint); margin-top: 4px; }

  /* ── tab bar ── */
  .wallet-tabs {
    display: flex; background: #fff;
    margin: 0 var(--sp-4) var(--sp-4);
    border-radius: var(--radius-xl);
    padding: var(--sp-1);
    box-shadow: 0 1px 8px rgba(0,0,0,.06);
    gap: var(--sp-1);
  }
  .wallet-tab {
    flex: 1; padding: var(--sp-2) var(--sp-3);
    border: none; border-radius: var(--radius-lg);
    background: none; cursor: pointer;
    font-family: var(--font-body); font-size: var(--text-xs); font-weight: var(--weight-bold);
    color: var(--color-text-muted); display: flex; align-items: center; justify-content: center; gap: 4px;
    transition: all 0.2s;
  }
  .wallet-tab.active { background: var(--color-primary); color: #fff; }

  /* ── tab panels ── */
  .tab-panel { display: none; flex-direction: column; gap: var(--sp-4); padding: 0 var(--sp-4); }
  .tab-panel.active { display: flex; }

  /* ── section card ── */
  .w-card {
    background: #fff; border-radius: var(--radius-xl);
    padding: var(--sp-5); box-shadow: 0 1px 8px rgba(0,0,0,.06);
  }
  .w-card__title { font-weight: var(--weight-black); font-size: var(--text-sm); margin-bottom: var(--sp-4); display: flex; align-items: center; gap: var(--sp-2); }

  /* ── quick amounts ── */
  .quick-amounts { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-4); flex-wrap: wrap; }
  .quick-amt {
    flex: 1; min-width: 70px; padding: var(--sp-3);
    border: 2px solid var(--color-border); border-radius: var(--radius-lg);
    background: none; cursor: pointer; font-family: var(--font-body);
    font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--color-text-muted);
    transition: all 0.2s; text-align: center;
  }
  .quick-amt.selected { border-color: var(--color-primary); background: var(--color-primary-light); color: var(--color-primary); }

  /* ── input group ── */
  .input-group { margin-bottom: var(--sp-4); }
  .input-label { font-size: var(--text-xs); font-weight: var(--weight-bold); color: var(--color-text-faint); margin-bottom: var(--sp-2); display: block; }
  .input-field {
    width: 100%; border: 1.5px solid var(--color-border); border-radius: var(--radius-lg);
    padding: var(--sp-3) var(--sp-4); font-family: var(--font-body); font-size: var(--text-base);
    box-sizing: border-box; transition: border-color 0.2s;
  }
  .input-field:focus { outline: none; border-color: var(--color-primary); }

  /* ── pay methods ── */
  .pay-methods { display: flex; flex-direction: column; gap: var(--sp-2); margin-bottom: var(--sp-4); }
  .pay-method {
    display: flex; align-items: center; gap: var(--sp-3);
    border: 1.5px solid var(--color-border); border-radius: var(--radius-lg);
    padding: var(--sp-3) var(--sp-4); cursor: pointer; transition: all 0.2s;
    position: relative;
  }
  .pay-method input { position: absolute; opacity: 0; width: 0; }
  .pay-method:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-light); }
  .pay-method__icon { font-size: 1.4rem; flex-shrink: 0; }
  .pay-method__name { font-weight: var(--weight-bold); font-size: var(--text-sm); }
  .pay-method__desc { font-size: 11px; color: var(--color-text-faint); }
  .pay-check { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--color-border); margin-right: auto; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
  .pay-method:has(input:checked) .pay-check { background: var(--color-primary); border-color: var(--color-primary); }
  .pay-method:has(input:checked) .pay-check::after { content: '✓'; color: #fff; font-size: 10px; font-weight: 900; }

  /* ── action button ── */
  .w-btn {
    width: 100%; padding: var(--sp-4);
    background: var(--color-primary); color: #fff;
    border: none; border-radius: var(--radius-xl);
    font-family: var(--font-body); font-size: var(--text-base); font-weight: var(--weight-black);
    cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
  }
  .w-btn:hover { background: var(--color-primary-dark); transform: translateY(-1px); }
  .w-btn:disabled { background: #94a3b8; cursor: not-allowed; transform: none; }
  .w-btn.red   { background: #dc2626; }
  .w-btn.red:hover { background: #b91c1c; }
  .w-btn.green { background: #16a34a; }
  .w-btn.green:hover { background: #15803d; }

  /* ── transaction list ── */
  .tx-list { display: flex; flex-direction: column; gap: 0; }
  .tx-item {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-4) 0; border-bottom: 1px solid var(--color-border);
  }
  .tx-item:last-child { border-bottom: none; }
  .tx-icon {
    width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
  }
  .tx-icon.in  { background: #dcfce7; }
  .tx-icon.out { background: #fee2e2; }
  .tx-icon.tr  { background: #dbeafe; }
  .tx-info { flex: 1; min-width: 0; }
  .tx-note { font-weight: var(--weight-bold); font-size: var(--text-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tx-date { font-size: 11px; color: var(--color-text-faint); margin-top: 2px; }
  .tx-amt { font-weight: var(--weight-black); font-size: var(--text-sm); flex-shrink: 0; }
  .tx-amt.pos { color: #16a34a; }
  .tx-amt.neg { color: #dc2626; }
  .tx-empty { text-align: center; padding: var(--sp-8); color: var(--color-text-faint); font-size: var(--text-sm); }

  /* ── bottom nav ── */
  .bottom-nav {
    position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
    width: 100%; max-width: 480px;
    background: #fff; border-top: 1px solid var(--color-border);
    display: flex; align-items: center;
    z-index: 100; padding-bottom: env(safe-area-inset-bottom);
  }
  .bn-item {
    flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px;
    padding: var(--sp-2) 0; text-decoration: none; border: none; background: none; cursor: pointer;
    font-family: var(--font-body); color: var(--color-text-faint);
  }
  .bn-item.active { color: var(--color-primary); }
  .bn-item__icon { font-size: 1.3rem; }
  .bn-item__lbl  { font-size: 10px; font-weight: var(--weight-bold); }
  .bn-plus {
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--color-primary); color: #fff;
    border: 4px solid #fff; box-shadow: 0 2px 12px rgba(29,78,216,.4);
    font-size: 1.6rem; display: flex; align-items: center; justify-content: center;
    margin-top: -20px; cursor: pointer; flex-shrink: 0;
    text-decoration: none;
  }

  /* ── toast ── */
  .w-toast {
    position: fixed; top: 80px; left: 50%;
    transform: translateX(-50%) translateY(-20px);
    background: #1f2937; color: #fff;
    padding: var(--sp-3) var(--sp-5); border-radius: var(--radius-lg);
    font-size: var(--text-sm); font-weight: var(--weight-bold);
    z-index: 600; opacity: 0; transition: all 0.3s; white-space: nowrap; pointer-events: none;
  }
  .w-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  /* ── auth prompt ── */
  .auth-box {
    background: #fff; border-radius: var(--radius-xl); padding: var(--sp-10) var(--sp-6);
    text-align: center; margin: var(--sp-6) var(--sp-4); box-shadow: 0 1px 8px rgba(0,0,0,.08);
  }
  .auth-box__icon { font-size: 3rem; margin-bottom: var(--sp-4); }
  .auth-box__title { font-size: var(--text-xl); font-weight: var(--weight-black); margin-bottom: var(--sp-3); }
  .auth-box__sub { color: var(--color-text-muted); font-size: var(--text-sm); margin-bottom: var(--sp-6); }
</style>

<Layout title="المحفظة الإلكترونية | وصّلها" description="محفظتك الإلكترونية — اشحن وحوّل واسحب رصيدك" page="wallet">

  <div class="wallet-page" id="wallet-page">

    <!-- Top bar -->
    <div class="wallet-topbar">
      <button class="topbar-back" onclick="history.back()" type="button">←</button>
      <div class="wallet-topbar__title">💳 المحفظة الإلكترونية</div>
      <div style="width:36px"></div>
    </div>

    <!-- Auth prompt -->
    <div class="auth-box" id="auth-box" style="display:none">
      <div class="auth-box__icon">🔒</div>
      <div class="auth-box__title">تسجيل الدخول مطلوب</div>
      <div class="auth-box__sub">يرجى تسجيل الدخول للوصول إلى محفظتك الإلكترونية</div>
      <div style="display:flex;gap:var(--sp-3);justify-content:center;flex-wrap:wrap;">
        <a href="/login" class="w-btn" style="text-decoration:none;padding:var(--sp-3) var(--sp-6);">تسجيل الدخول</a>
        <a href="/register" class="w-btn green" style="text-decoration:none;padding:var(--sp-3) var(--sp-6);">حساب جديد</a>
      </div>
    </div>

    <!-- Main wallet content -->
    <div id="wallet-main" style="display:none">

      <!-- Balance hero -->
      <div class="balance-hero">
        <div class="balance-label">🏦 رصيدك الحالي</div>
        <div class="balance-amount">
          <span id="balance-val">0</span>
          <span class="balance-currency">جنيه</span>
        </div>
        <div class="balance-card-row">
          <span class="balance-card-num" id="card-num">**** **** **** ----</span>
          <span class="balance-card-badge">وصلة للدفع الإلكتروني</span>
        </div>
        <div class="hero-actions">
          <button class="hero-action" onclick="switchTab('charge')" type="button">
            <span class="hero-action__icon">⬆️</span>
            <span class="hero-action__lbl">شحن رصيد</span>
          </button>
          <button class="hero-action" onclick="switchTab('withdraw')" type="button">
            <span class="hero-action__icon">⬇️</span>
            <span class="hero-action__lbl">سحب رصيد</span>
          </button>
          <button class="hero-action" onclick="switchTab('transfer')" type="button">
            <span class="hero-action__icon">↔️</span>
            <span class="hero-action__lbl">تحويل</span>
          </button>
          <button class="hero-action" onclick="switchTab('log')" type="button">
            <span class="hero-action__icon">📋</span>
            <span class="hero-action__lbl">العمليات</span>
          </button>
        </div>
      </div>

      <!-- Stats -->
      <div class="stats-strip">
        <div class="stat-box">
          <div class="stat-box__val" id="stat-charged">0</div>
          <div class="stat-box__lbl">إجمالي الشحن 💰</div>
        </div>
        <div class="stat-box">
          <div class="stat-box__val" id="stat-spent">0</div>
          <div class="stat-box__lbl">إجمالي الإنفاق 🛒</div>
        </div>
        <div class="stat-box">
          <div class="stat-box__val" id="stat-transferred">0</div>
          <div class="stat-box__lbl">المحوّل ↔️</div>
        </div>
      </div>

      <!-- Tabs -->
      <div class="wallet-tabs">
        <button class="wallet-tab active" data-tab="charge"   onclick="switchTab('charge')"   type="button">⬆️ شحن</button>
        <button class="wallet-tab"        data-tab="withdraw" onclick="switchTab('withdraw')" type="button">⬇️ سحب</button>
        <button class="wallet-tab"        data-tab="transfer" onclick="switchTab('transfer')" type="button">↔️ تحويل</button>
        <button class="wallet-tab"        data-tab="log"      onclick="switchTab('log')"      type="button">📋 السجل</button>
      </div>

      <!-- ─── Charge tab ─── -->
      <div class="tab-panel active" id="panel-charge">
        <div class="w-card">
          <div class="w-card__title">⬆️ شحن الرصيد</div>
          <p style="font-size:var(--text-xs);color:var(--color-text-faint);margin-bottom:var(--sp-4);">اختر المبلغ السريع</p>
          <div class="quick-amounts" id="quick-amounts">
            <button class="quick-amt" data-val="50"  type="button">50 جنيه</button>
            <button class="quick-amt selected" data-val="100" type="button">100 جنيه</button>
            <button class="quick-amt" data-val="200" type="button">200 جنيه</button>
            <button class="quick-amt" data-val="500" type="button">500 جنيه</button>
          </div>
          <div class="input-group">
            <label class="input-label">أو أدخل مبلغاً مخصصاً</label>
            <input type="number" id="charge-amount" class="input-field" placeholder="أدخل المبلغ بالجنيه" min="10" value="100" />
          </div>
          <p style="font-size:var(--text-xs);color:var(--color-text-faint);margin-bottom:var(--sp-3);">طريقة الشحن</p>
          <div class="pay-methods">
            <label class="pay-method">
              <input type="radio" name="charge-method" value="vodafone" checked />
              <span class="pay-method__icon">📱</span>
              <span><span class="pay-method__name">فودافون كاش</span><br><span class="pay-method__desc">01xxxxxxxxxx</span></span>
              <span class="pay-check"></span>
            </label>
            <label class="pay-method">
              <input type="radio" name="charge-method" value="instapay" />
              <span class="pay-method__icon">💳</span>
              <span><span class="pay-method__name">إنستاباي</span><br><span class="pay-method__desc">تحويل فوري عبر التطبيق</span></span>
              <span class="pay-check"></span>
            </label>
            <label class="pay-method">
              <input type="radio" name="charge-method" value="bank" />
              <span class="pay-method__icon">🏦</span>
              <span><span class="pay-method__name">تحويل بنكي</span><br><span class="pay-method__desc">2-24 ساعة للتأكيد</span></span>
              <span class="pay-check"></span>
            </label>
          </div>
          <button class="w-btn" id="charge-btn" type="button">⬆️ شحن الرصيد</button>
        </div>
      </div>

      <!-- ─── Withdraw tab ─── -->
      <div class="tab-panel" id="panel-withdraw">
        <div class="w-card">
          <div class="w-card__title">⬇️ سحب الرصيد</div>
          <div class="input-group">
            <label class="input-label">المبلغ المراد سحبه</label>
            <input type="number" id="withdraw-amount" class="input-field" placeholder="أدخل المبلغ بالجنيه" min="10" />
          </div>
          <div class="input-group">
            <label class="input-label">رقم فودافون كاش / إنستاباي</label>
            <input type="tel" id="withdraw-dest" class="input-field" placeholder="01xxxxxxxxxx" />
          </div>
          <div class="input-group">
            <label class="input-label">ملاحظة (اختياري)</label>
            <input type="text" id="withdraw-note" class="input-field" placeholder="سبب السحب..." />
          </div>
          <div id="withdraw-balance-note" style="font-size:var(--text-xs);color:var(--color-text-faint);margin-bottom:var(--sp-4);">رصيدك المتاح: <strong id="withdraw-avail">0</strong> ج.م</div>
          <button class="w-btn red" id="withdraw-btn" type="button">⬇️ طلب سحب</button>
        </div>
      </div>

      <!-- ─── Transfer tab ─── -->
      <div class="tab-panel" id="panel-transfer">
        <div class="w-card">
          <div class="w-card__title">↔️ تحويل لمستخدم آخر</div>
          <div class="input-group">
            <label class="input-label">رقم جوال المستلم</label>
            <input type="tel" id="transfer-phone" class="input-field" placeholder="01xxxxxxxxxx" />
          </div>
          <div id="transfer-recipient" style="display:none;margin-bottom:var(--sp-4);">
            <div style="display:flex;align-items:center;gap:var(--sp-3);background:#f0fdf4;border:1.5px solid #86efac;border-radius:var(--radius-lg);padding:var(--sp-3) var(--sp-4);">
              <span style="font-size:1.5rem;">👤</span>
              <div>
                <div style="font-weight:800;font-size:var(--text-sm)" id="transfer-recipient-name">—</div>
                <div style="font-size:11px;color:var(--color-text-faint)" id="transfer-recipient-phone">—</div>
              </div>
            </div>
          </div>
          <div class="input-group">
            <label class="input-label">المبلغ</label>
            <input type="number" id="transfer-amount" class="input-field" placeholder="أدخل المبلغ بالجنيه" min="1" />
          </div>
          <div class="input-group">
            <label class="input-label">ملاحظة (اختياري)</label>
            <input type="text" id="transfer-note" class="input-field" placeholder="سبب التحويل..." />
          </div>
          <button class="w-btn" id="transfer-btn" type="button">↔️ تحويل الآن</button>
        </div>
      </div>

      <!-- ─── Log tab ─── -->
      <div class="tab-panel" id="panel-log">
        <div class="w-card">
          <div class="w-card__title">📋 سجل العمليات</div>
          <div class="tx-list" id="tx-list">
            <div class="tx-empty">جاري التحميل...</div>
          </div>
        </div>
      </div>

    </div><!-- /wallet-main -->

  </div><!-- /wallet-page -->

  <!-- Bottom nav -->
  <nav class="bottom-nav">
    <a href="/" class="bn-item"><span class="bn-item__icon">🏠</span><span class="bn-item__lbl">الرئيسية</span></a>
    <a href="/orders" class="bn-item"><span class="bn-item__icon">📋</span><span class="bn-item__lbl">طلباتي</span></a>
    <a href="/rides" class="bn-plus">+</a>
    <a href="/wallet" class="bn-item active"><span class="bn-item__icon">💳</span><span class="bn-item__lbl">المحفظة</span></a>
    <a href="/profile" class="bn-item"><span class="bn-item__icon">⚙️</span><span class="bn-item__lbl">الإعدادات</span></a>
  </nav>

  <div class="w-toast" id="w-toast"></div>

</Layout>

<script is:inline>
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H = { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY, 'Content-Type': 'application/json' };

  /* ── Auth ── */
  var user = null;
  try { var raw = localStorage.getItem('wslha_user'); user = raw ? JSON.parse(raw) : null; } catch {}

  if (!user) {
    document.getElementById('auth-box').style.display = '';
  } else {
    document.getElementById('wallet-main').style.display = 'block';
    // card num last 4 from phone
    var last4 = (user.phone || '').replace(/\D/g, '').slice(-4) || '----';
    document.getElementById('card-num').textContent = '**** **** **** ' + last4;
    loadWallet();
  }

  /* ── Toast ── */
  function toast(msg, ok) {
    var t = document.getElementById('w-toast');
    t.textContent = msg;
    t.style.background = ok === false ? '#dc2626' : '#1f2937';
    t.classList.add('show');
    setTimeout(function() { t.classList.remove('show'); }, 2800);
  }

  /* ── Tab switching ── */
  function switchTab(name) {
    document.querySelectorAll('.wallet-tab').forEach(function(b) {
      b.classList.toggle('active', b.dataset.tab === name);
    });
    document.querySelectorAll('.tab-panel').forEach(function(p) {
      p.classList.toggle('active', p.id === 'panel-' + name);
    });
    if (name === 'log') loadLog();
  }

  /* ── Quick amounts ── */
  document.querySelectorAll('.quick-amt').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.quick-amt').forEach(function(b) { b.classList.remove('selected'); });
      btn.classList.add('selected');
      document.getElementById('charge-amount').value = btn.dataset.val;
    });
  });
  document.getElementById('charge-amount').addEventListener('input', function() {
    document.querySelectorAll('.quick-amt').forEach(function(b) { b.classList.remove('selected'); });
  });

  /* ── Load wallet balance + stats ── */
  async function loadWallet() {
    if (!user) return;
    var p = encodeURIComponent(user.phone);
    try {
      var res = await fetch(SB_URL + '/rest/v1/wallets?phone=eq.' + p + '&select=balance', { headers: SB_H });
      var rows = await res.json();
      var bal = (Array.isArray(rows) && rows[0]) ? (rows[0].balance || 0) : 0;
      document.getElementById('balance-val').textContent = Number(bal).toLocaleString('ar-EG');
      document.getElementById('withdraw-avail').textContent = Number(bal).toLocaleString('ar-EG');
    } catch {}

    try {
      var res2 = await fetch(SB_URL + '/rest/v1/wallet_transactions?phone=eq.' + p + '&select=amount,type', { headers: SB_H });
      var txs = await res2.json();
      if (Array.isArray(txs)) {
        var charged = 0, spent = 0, transferred = 0;
        txs.forEach(function(t) {
          var amt = Math.abs(Number(t.amount));
          if (t.type === 'topup') charged += amt;
          else if (t.type === 'earning') charged += amt;
          else if (t.type === 'commission' || t.type === 'payment') spent += amt;
          else if (t.type === 'transfer_out' || t.type === 'transfer_in') transferred += amt;
        });
        document.getElementById('stat-charged').textContent = charged.toLocaleString('ar-EG');
        document.getElementById('stat-spent').textContent = spent.toLocaleString('ar-EG');
        document.getElementById('stat-transferred').textContent = transferred.toLocaleString('ar-EG');
      }
    } catch {}
  }

  /* ── Load transaction log ── */
  async function loadLog() {
    if (!user) return;
    var p = encodeURIComponent(user.phone);
    try {
      var res = await fetch(SB_URL + '/rest/v1/wallet_transactions?phone=eq.' + p + '&select=amount,type,note,created_at&order=created_at.desc&limit=30', { headers: SB_H });
      var txs = await res.json();
      var el = document.getElementById('tx-list');
      if (!Array.isArray(txs) || !txs.length) {
        el.innerHTML = '<div class="tx-empty">لا توجد عمليات بعد</div>';
        return;
      }
      var typeMap = {
        topup: { icon: '⬆️', cls: 'in', label: 'شحن رصيد' },
        earning: { icon: '💰', cls: 'in', label: 'أرباح' },
        refund: { icon: '↩️', cls: 'in', label: 'استرداد' },
        transfer_in: { icon: '↔️', cls: 'tr', label: 'تحويل وارد' },
        commission: { icon: '🏢', cls: 'out', label: 'عمولة منصة' },
        payment: { icon: '🛒', cls: 'out', label: 'مدفوعات' },
        withdrawal: { icon: '⬇️', cls: 'out', label: 'سحب رصيد' },
        transfer_out: { icon: '↔️', cls: 'tr', label: 'تحويل صادر' },
      };
      el.innerHTML = txs.map(function(t) {
        var amt = Number(t.amount);
        var info = typeMap[t.type] || { icon: '💳', cls: amt >= 0 ? 'in' : 'out', label: t.type };
        var sign = amt >= 0 ? '+' : '';
        var cls = amt >= 0 ? 'pos' : 'neg';
        var d = new Date(t.created_at).toLocaleDateString('ar-EG', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        return '<div class="tx-item">'
          + '<div class="tx-icon ' + info.cls + '">' + info.icon + '</div>'
          + '<div class="tx-info"><div class="tx-note">' + (t.note || info.label) + '</div><div class="tx-date">' + d + '</div></div>'
          + '<div class="tx-amt ' + cls + '">' + sign + Math.abs(amt).toLocaleString('ar-EG') + ' ج.م</div>'
          + '</div>';
      }).join('');
    } catch {
      document.getElementById('tx-list').innerHTML = '<div class="tx-empty">تعذّر تحميل السجل</div>';
    }
  }

  /* ── Charge ── */
  document.getElementById('charge-btn').addEventListener('click', async function() {
    if (!user) return;
    var amt = parseFloat(document.getElementById('charge-amount').value);
    if (!amt || amt < 10) { toast('أدخل مبلغاً لا يقل عن 10 جنيه', false); return; }
    var method = document.querySelector('input[name="charge-method"]:checked').value;
    var methodLabel = { vodafone: 'فودافون كاش', instapay: 'إنستاباي', bank: 'تحويل بنكي' }[method];

    var btn = document.getElementById('charge-btn');
    btn.disabled = true; btn.textContent = 'جاري المعالجة...';

    try {
      // Upsert wallet balance
      var res = await fetch(SB_URL + '/rest/v1/wallets?phone=eq.' + encodeURIComponent(user.phone) + '&select=balance', { headers: SB_H });
      var rows = await res.json();
      var currBal = (Array.isArray(rows) && rows[0]) ? Number(rows[0].balance || 0) : 0;
      var newBal = currBal + amt;

      var wp = await fetch(SB_URL + '/rest/v1/wallets', {
        method: 'POST',
        headers: Object.assign({}, SB_H, { Prefer: 'resolution=merge-duplicates,return=minimal' }),
        body: JSON.stringify({ phone: user.phone, balance: newBal, updated_at: new Date().toISOString() }),
      });

      // Insert transaction
      await fetch(SB_URL + '/rest/v1/wallet_transactions', {
        method: 'POST',
        headers: Object.assign({}, SB_H, { Prefer: 'return=minimal' }),
        body: JSON.stringify({
          id: 'wtx-' + Date.now(),
          phone: user.phone,
          amount: amt,
          type: 'topup',
          note: 'شحن رصيد عبر ' + methodLabel,
          created_at: new Date().toISOString(),
        }),
      });

      document.getElementById('balance-val').textContent = newBal.toLocaleString('ar-EG');
      document.getElementById('withdraw-avail').textContent = newBal.toLocaleString('ar-EG');
      toast('✅ تم شحن ' + amt + ' ج.م بنجاح!');
      loadWallet();
    } catch { toast('حدث خطأ، حاول مرة أخرى', false); }
    btn.disabled = false; btn.textContent = '⬆️ شحن الرصيد';
  });

  /* ── Withdraw ── */
  document.getElementById('withdraw-btn').addEventListener('click', async function() {
    if (!user) return;
    var amt = parseFloat(document.getElementById('withdraw-amount').value);
    var dest = document.getElementById('withdraw-dest').value.trim();
    var note = document.getElementById('withdraw-note').value.trim();
    if (!amt || amt < 10) { toast('أدخل مبلغاً لا يقل عن 10 جنيه', false); return; }
    if (!dest) { toast('أدخل رقم فودافون كاش أو إنستاباي', false); return; }

    // Check balance
    var res = await fetch(SB_URL + '/rest/v1/wallets?phone=eq.' + encodeURIComponent(user.phone) + '&select=balance', { headers: SB_H });
    var rows = await res.json();
    var currBal = (Array.isArray(rows) && rows[0]) ? Number(rows[0].balance || 0) : 0;
    if (amt > currBal) { toast('رصيدك غير كافٍ (المتاح: ' + currBal + ' ج.م)', false); return; }

    var btn = document.getElementById('withdraw-btn');
    btn.disabled = true; btn.textContent = 'جاري المعالجة...';

    try {
      var newBal = currBal - amt;
      await fetch(SB_URL + '/rest/v1/wallets', {
        method: 'POST',
        headers: Object.assign({}, SB_H, { Prefer: 'resolution=merge-duplicates,return=minimal' }),
        body: JSON.stringify({ phone: user.phone, balance: newBal, updated_at: new Date().toISOString() }),
      });
      await fetch(SB_URL + '/rest/v1/wallet_transactions', {
        method: 'POST',
        headers: Object.assign({}, SB_H, { Prefer: 'return=minimal' }),
        body: JSON.stringify({
          id: 'wtx-' + Date.now(),
          phone: user.phone,
          amount: -amt,
          type: 'withdrawal',
          note: (note || 'سحب رصيد') + ' — إلى ' + dest,
          created_at: new Date().toISOString(),
        }),
      });
      document.getElementById('balance-val').textContent = newBal.toLocaleString('ar-EG');
      document.getElementById('withdraw-avail').textContent = newBal.toLocaleString('ar-EG');
      document.getElementById('withdraw-amount').value = '';
      document.getElementById('withdraw-dest').value = '';
      toast('✅ تم طلب سحب ' + amt + ' ج.م — سيصلك خلال 24 ساعة');
      loadWallet();
    } catch { toast('حدث خطأ، حاول مرة أخرى', false); }
    btn.disabled = false; btn.textContent = '⬇️ طلب سحب';
  });

  /* ── Transfer: lookup recipient ── */
  var _transferTimer = null;
  document.getElementById('transfer-phone').addEventListener('input', function() {
    clearTimeout(_transferTimer);
    var ph = this.value.trim();
    document.getElementById('transfer-recipient').style.display = 'none';
    if (ph.length < 10) return;
    _transferTimer = setTimeout(async function() {
      try {
        var local = ph.startsWith('+20') ? '0' + ph.slice(3) : ph;
        var intl  = ph.startsWith('01')  ? '+2' + ph : ph;
        var filter = 'or=(phone.eq.' + encodeURIComponent(intl) + ',phone.eq.' + encodeURIComponent(local) + ')';
        var res = await fetch(SB_URL + '/rest/v1/accounts?' + filter + '&select=name,phone&limit=1', { headers: SB_H });
        var rows = await res.json();
        if (Array.isArray(rows) && rows[0]) {
          document.getElementById('transfer-recipient-name').textContent = rows[0].name || 'مستخدم';
          document.getElementById('transfer-recipient-phone').textContent = rows[0].phone;
          document.getElementById('transfer-recipient').style.display = '';
        }
      } catch {}
    }, 600);
  });

  /* ── Transfer: execute ── */
  document.getElementById('transfer-btn').addEventListener('click', async function() {
    if (!user) return;
    var toPhone = document.getElementById('transfer-phone').value.trim();
    var amt = parseFloat(document.getElementById('transfer-amount').value);
    var note = document.getElementById('transfer-note').value.trim();
    if (!toPhone) { toast('أدخل رقم المستلم', false); return; }
    if (toPhone === user.phone) { toast('لا يمكن التحويل لنفس الحساب', false); return; }
    if (!amt || amt < 1) { toast('أدخل مبلغاً صحيحاً', false); return; }

    // Normalize phone
    var toIntl = toPhone.startsWith('01') ? '+2' + toPhone : toPhone;
    var toLocal = toPhone.startsWith('+20') ? '0' + toPhone.slice(3) : toPhone;

    // Check sender balance
    var res = await fetch(SB_URL + '/rest/v1/wallets?phone=eq.' + encodeURIComponent(user.phone) + '&select=balance', { headers: SB_H });
    var rows = await res.json();
    var currBal = (Array.isArray(rows) && rows[0]) ? Number(rows[0].balance || 0) : 0;
    if (amt > currBal) { toast('رصيدك غير كافٍ (المتاح: ' + currBal + ' ج.م)', false); return; }

    // Verify recipient exists
    var filter = 'or=(phone.eq.' + encodeURIComponent(toIntl) + ',phone.eq.' + encodeURIComponent(toLocal) + ')';
    var rRes = await fetch(SB_URL + '/rest/v1/accounts?' + filter + '&select=name,phone&limit=1', { headers: SB_H });
    var rRows = await rRes.json();
    if (!Array.isArray(rRows) || !rRows[0]) { toast('لم يُعثر على هذا المستخدم', false); return; }
    var recipientPhone = rRows[0].phone;

    var btn = document.getElementById('transfer-btn');
    btn.disabled = true; btn.textContent = 'جاري التحويل...';

    try {
      var now = new Date().toISOString();
      // Debit sender
      var newSenderBal = currBal - amt;
      await fetch(SB_URL + '/rest/v1/wallets', {
        method: 'POST',
        headers: Object.assign({}, SB_H, { Prefer: 'resolution=merge-duplicates,return=minimal' }),
        body: JSON.stringify({ phone: user.phone, balance: newSenderBal, updated_at: now }),
      });
      await fetch(SB_URL + '/rest/v1/wallet_transactions', {
        method: 'POST',
        headers: Object.assign({}, SB_H, { Prefer: 'return=minimal' }),
        body: JSON.stringify({ id: 'wtx-out-' + Date.now(), phone: user.phone, amount: -amt, type: 'transfer_out', note: (note || 'تحويل') + ' → ' + recipientPhone, created_at: now }),
      });

      // Credit recipient
      var rBalRes = await fetch(SB_URL + '/rest/v1/wallets?phone=eq.' + encodeURIComponent(recipientPhone) + '&select=balance', { headers: SB_H });
      var rBalRows = await rBalRes.json();
      var recBal = (Array.isArray(rBalRows) && rBalRows[0]) ? Number(rBalRows[0].balance || 0) : 0;
      await fetch(SB_URL + '/rest/v1/wallets', {
        method: 'POST',
        headers: Object.assign({}, SB_H, { Prefer: 'resolution=merge-duplicates,return=minimal' }),
        body: JSON.stringify({ phone: recipientPhone, balance: recBal + amt, updated_at: now }),
      });
      await fetch(SB_URL + '/rest/v1/wallet_transactions', {
        method: 'POST',
        headers: Object.assign({}, SB_H, { Prefer: 'return=minimal' }),
        body: JSON.stringify({ id: 'wtx-in-' + Date.now(), phone: recipientPhone, amount: amt, type: 'transfer_in', note: (note || 'تحويل') + ' ← ' + user.phone, created_at: now }),
      });

      document.getElementById('balance-val').textContent = newSenderBal.toLocaleString('ar-EG');
      document.getElementById('transfer-phone').value = '';
      document.getElementById('transfer-amount').value = '';
      document.getElementById('transfer-recipient').style.display = 'none';
      toast('✅ تم تحويل ' + amt + ' ج.م بنجاح!');
      loadWallet();
    } catch { toast('حدث خطأ، حاول مرة أخرى', false); }
    btn.disabled = false; btn.textContent = '↔️ تحويل الآن';
  });
</script>

</Layout>
