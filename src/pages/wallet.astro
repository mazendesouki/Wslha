---
import Layout from '../components/layout.astro';
---

<style>
  .wallet-page {
    max-width: 480px; margin: 0 auto;
    min-height: 100vh; background: #f5f5f5;
    padding-bottom: 90px; font-family: var(--font-body);
  }
  .w-topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 18px; background: #fff;
    border-bottom: 1px solid #eee; position: sticky; top: 0; z-index: 50;
  }
  .w-topbar__back {
    width: 36px; height: 36px; border-radius: 50%;
    border: none; background: #f5f5f5; cursor: pointer;
    font-size: 1.1rem; color: #6b7280; display: flex; align-items: center; justify-content: center;
  }
  .w-topbar__title { font-size: 1rem; font-weight: 900; color: #111; }
  .balance-card {
    background: #fff; margin: 14px; border-radius: 16px;
    padding: 22px 20px; box-shadow: 0 2px 12px rgba(0,0,0,.07);
  }
  .balance-card__top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 16px;
  }
  .wallet-icon {
    width: 48px; height: 48px; border-radius: 12px;
    background: #1a2340; display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
  }
  .balance-label { font-size: .78rem; color: #9ca3af; margin-bottom: 4px; text-align: right; }
  .balance-amount { font-size: 1.6rem; font-weight: 900; color: #111; text-align: right; direction: ltr; }
  .w-action-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }
  .w-action-btn {
    padding: 13px; border: none; border-radius: 12px;
    font-family: var(--font-body); font-size: .95rem; font-weight: 900;
    cursor: pointer; transition: opacity .15s;
    background: #1a2340; color: #fff;
  }
  .w-action-btn:hover { opacity: .85; }
  .w-action-btn.transfer { background: #374151; }
  .connected-badge {
    display: flex; align-items: center; gap: 6px;
    font-size: .78rem; color: #16a34a; font-weight: 700; margin-top: 14px;
  }
  .connected-dot { width: 8px; height: 8px; border-radius: 50%; background: #16a34a; }
  .tx-section { margin: 0 14px; }
  .tx-section__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 0 10px; font-size: .95rem; font-weight: 900; color: #111;
  }
  .tx-date-group { font-size: .75rem; font-weight: 700; color: #9ca3af; padding: 8px 0 4px; }
  .tx-item {
    background: #fff; border-radius: 12px; padding: 14px 16px;
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.05);
  }
  .tx-item__left { display: flex; flex-direction: column; gap: 3px; }
  .tx-item__type { font-size: .78rem; color: #6b7280; display: flex; align-items: center; gap: 5px; }
  .tx-item__type-check { color: #16a34a; font-weight: 900; }
  .tx-item__date { font-size: .72rem; color: #9ca3af; }
  .tx-item__amount { font-size: 1rem; font-weight: 900; color: #111; direction: ltr; }
  .tx-item__amount.neg { color: #dc2626; }
  .tx-empty { text-align: center; padding: 40px 0; color: #9ca3af; font-size: .875rem; }
  .sheet-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.5);
    z-index: 700; display: none; align-items: flex-end; justify-content: center;
  }
  .sheet-overlay.visible { display: flex; }
  .sheet {
    background: #fff; border-radius: 20px 20px 0 0;
    width: 100%; max-width: 480px; padding: 20px 20px 40px;
    animation: sheet-up .3s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .sheet__handle { width: 40px; height: 4px; background: #e5e7eb; border-radius: 99px; margin: 0 auto 18px; }
  .sheet__title { font-size: 1rem; font-weight: 900; margin-bottom: 18px; text-align: center; }
  .s-label { font-size: .78rem; color: #6b7280; font-weight: 700; margin-bottom: 6px; display: block; }
  .s-input {
    width: 100%; border: 1.5px solid #e5e7eb; border-radius: 12px;
    padding: 12px 14px; font-family: var(--font-body); font-size: .95rem;
    box-sizing: border-box; margin-bottom: 14px;
  }
  .s-input:focus { outline: none; border-color: #1a2340; }
  .quick-row { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
  .quick-btn {
    flex: 1; min-width: 60px; padding: 9px 6px;
    border: 1.5px solid #e5e7eb; border-radius: 10px;
    background: none; cursor: pointer; font-family: var(--font-body);
    font-size: .825rem; font-weight: 700; color: #6b7280; text-align: center; transition: all .15s;
  }
  .quick-btn.sel { border-color: #1a2340; background: #1a2340; color: #fff; }
  .pay-opts { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
  .pay-opt {
    display: flex; align-items: center; gap: 12px;
    border: 1.5px solid #e5e7eb; border-radius: 12px;
    padding: 11px 14px; cursor: pointer; transition: border-color .15s; position: relative;
  }
  .pay-opt input { position: absolute; opacity: 0; width: 0; }
  .pay-opt:has(input:checked) { border-color: #1a2340; background: #f0f4ff; }
  .pay-opt__icon { font-size: 1.3rem; }
  .pay-opt__name { font-weight: 700; font-size: .875rem; }
  .pay-opt__sub { font-size: .72rem; color: #9ca3af; }
  .pay-opt__dot {
    width: 18px; height: 18px; border-radius: 50%; border: 2px solid #d1d5db;
    margin-right: auto; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all .15s;
  }
  .pay-opt:has(input:checked) .pay-opt__dot { background: #1a2340; border-color: #1a2340; }
  .pay-opt:has(input:checked) .pay-opt__dot::after { content: '✓'; color: #fff; font-size: 10px; font-weight: 900; }
  .s-btn {
    width: 100%; padding: 14px; background: #1a2340; color: #fff;
    border: none; border-radius: 12px; font-family: var(--font-body);
    font-size: .95rem; font-weight: 900; cursor: pointer; transition: opacity .15s;
  }
  .s-btn:hover { opacity: .88; }
  .s-btn:disabled { background: #94a3b8; cursor: not-allowed; }
  .s-avail { font-size: .78rem; color: #6b7280; text-align: center; margin-bottom: 12px; }
  .recipient-box {
    display: none; background: #f0fdf4; border: 1.5px solid #86efac;
    border-radius: 12px; padding: 12px 14px; margin-bottom: 14px;
    align-items: center; gap: 10px;
  }
  .recipient-box.visible { display: flex; }
  /* (Removed the page's own .bottom-nav / .bn-item / .bn-plus — the bottom
     navigation now comes only from the global Layout to avoid duplication.) */
  .auth-box {
    background: #fff; border-radius: 16px; padding: 48px 24px;
    text-align: center; margin: 24px 14px; box-shadow: 0 2px 12px rgba(0,0,0,.07);
  }
  .w-toast {
    position: fixed; top: 80px; left: 50%;
    transform: translateX(-50%) translateY(-20px);
    background: #1f2937; color: #fff;
    padding: 10px 20px; border-radius: 10px; font-size: .875rem; font-weight: 700;
    z-index: 800; opacity: 0; transition: all .3s; white-space: nowrap; pointer-events: none;
  }
  .w-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>

<Layout title="محفظتي | وصّلها" description="محفظتك الإلكترونية" page="wallet">
  <div class="wallet-page">
    <div class="w-topbar">
      <button class="w-topbar__back" onclick="history.back()" type="button">←</button>
      <div class="w-topbar__title">محفظتي</div>
      <div style="width:36px"></div>
    </div>
    <div class="auth-box" id="auth-box" style="display:none">
      <div style="font-size:3rem;margin-bottom:16px">🔒</div>
      <div style="font-size:1.1rem;font-weight:900;margin-bottom:10px">تسجيل الدخول مطلوب</div>
      <div style="color:#6b7280;font-size:.875rem;margin-bottom:24px">يرجى تسجيل الدخول للوصول إلى محفظتك</div>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="/login" style="padding:12px 24px;background:#1a2340;color:#fff;border-radius:12px;text-decoration:none;font-weight:900;">تسجيل الدخول</a>
        <a href="/register" style="padding:12px 24px;background:#16a34a;color:#fff;border-radius:12px;text-decoration:none;font-weight:900;">حساب جديد</a>
      </div>
    </div>
    <div id="wallet-main" style="display:none">
      <div class="balance-card">
        <div class="balance-card__top">
          <div class="wallet-icon">💼</div>
          <div>
            <div class="balance-label">رصيدك الآن</div>
            <div class="balance-amount">EGP <span id="balance-val">0</span></div>
          </div>
        </div>
        <div class="w-action-row">
          <button class="w-action-btn" id="btn-deposit" type="button">إيداع</button>
          <button class="w-action-btn" id="btn-withdraw-open" type="button">سحب</button>
        </div>
        <div style="display:flex;gap:8px;margin-top:8px;">
          <button class="w-action-btn transfer" id="btn-transfer-open" type="button" style="flex:1;padding:10px;font-size:.82rem;">↔️ تحويل</button>
        </div>
        <div class="connected-badge">
          <div class="connected-dot"></div><span>متصل</span>
        </div>
      </div>
      <div class="tx-section">
        <div class="tx-section__header">
          <span>المعاملات</span>
          <span style="font-size:1.2rem;cursor:pointer;" onclick="loadLog()">📅</span>
        </div>
        <div id="tx-list"><div class="tx-empty">جاري التحميل...</div></div>
      </div>
    </div>
  </div>

  <!-- Deposit sheet -->
  <div class="sheet-overlay" id="sheet-deposit">
    <div class="sheet">
      <div class="sheet__handle"></div>
      <div class="sheet__title">⬆️ إيداع رصيد</div>
      <div class="quick-row" id="quick-amounts">
        <button class="quick-btn" data-val="50" type="button">50</button>
        <button class="quick-btn sel" data-val="100" type="button">100</button>
        <button class="quick-btn" data-val="200" type="button">200</button>
        <button class="quick-btn" data-val="500" type="button">500</button>
      </div>
      <label class="s-label">أو أدخل مبلغاً آخر (جنيه)</label>
      <input type="number" id="charge-amount" class="s-input" placeholder="مثال: 150" min="10" value="100" />
      <div class="pay-opts">
        <label class="pay-opt"><input type="radio" name="charge-method" value="vodafone" checked /><span class="pay-opt__icon">📱</span><span><div class="pay-opt__name">فودافون كاش</div><div class="pay-opt__sub">01xxxxxxxxxx</div></span><span class="pay-opt__dot"></span></label>
        <label class="pay-opt"><input type="radio" name="charge-method" value="instapay" /><span class="pay-opt__icon">💳</span><span><div class="pay-opt__name">إنستاباي</div><div class="pay-opt__sub">تحويل فوري</div></span><span class="pay-opt__dot"></span></label>
        <label class="pay-opt"><input type="radio" name="charge-method" value="bank" /><span class="pay-opt__icon">🏦</span><span><div class="pay-opt__name">تحويل بنكي</div><div class="pay-opt__sub">24 ساعة</div></span><span class="pay-opt__dot"></span></label>
      </div>
      <button class="s-btn" id="charge-btn" type="button">إيداع الرصيد</button>
      <button class="s-btn" id="charge-paymob-btn" type="button" style="margin-top:8px;background:#0f9d58">💳 ادفع الآن أونلاين (فيزا / فودافون كاش / فوري)</button>
    </div>
  </div>

  <!-- Paymob checkout sheet (web only — native opens the in-app browser instead) -->
  <div class="sheet-overlay" id="sheet-paymob">
    <div class="sheet" style="padding:0;overflow:hidden;height:85vh">
      <iframe id="paymob-iframe" style="width:100%;height:100%;border:0" title="Paymob"></iframe>
    </div>
  </div>

  <!-- Withdraw sheet -->
  <div class="sheet-overlay" id="sheet-withdraw">
    <div class="sheet">
      <div class="sheet__handle"></div>
      <div class="sheet__title">⬇️ سحب الرصيد</div>
      <p class="s-avail">رصيدك المتاح: <strong id="withdraw-avail">0</strong> ج.م</p>
      <label class="s-label">المبلغ (جنيه)</label>
      <input type="number" id="withdraw-amount" class="s-input" placeholder="أدخل المبلغ" min="10" />
      <label class="s-label">رقم فودافون كاش / إنستاباي</label>
      <input type="tel" id="withdraw-dest" class="s-input" placeholder="01xxxxxxxxxx" />
      <label class="s-label">ملاحظة (اختياري)</label>
      <input type="text" id="withdraw-note" class="s-input" placeholder="سبب السحب..." />
      <button class="s-btn" id="withdraw-btn" type="button">طلب سحب</button>
    </div>
  </div>

  <!-- Transfer sheet -->
  <div class="sheet-overlay" id="sheet-transfer">
    <div class="sheet">
      <div class="sheet__handle"></div>
      <div class="sheet__title">↔️ تحويل لمستخدم</div>
      <label class="s-label">رقم جوال المستلم</label>
      <input type="tel" id="transfer-phone" class="s-input" placeholder="01xxxxxxxxxx" />
      <div class="recipient-box" id="transfer-recipient">
        <span style="font-size:1.5rem">👤</span>
        <div><div style="font-weight:800;font-size:.875rem" id="transfer-recipient-name">—</div><div style="font-size:.72rem;color:#6b7280" id="transfer-recipient-phone">—</div></div>
      </div>
      <label class="s-label">المبلغ (جنيه)</label>
      <input type="number" id="transfer-amount" class="s-input" placeholder="أدخل المبلغ" min="1" />
      <label class="s-label">ملاحظة (اختياري)</label>
      <input type="text" id="transfer-note" class="s-input" placeholder="سبب التحويل..." />
      <label class="s-label">كلمة مرور حسابك (للتأكيد)</label>
      <input type="password" id="transfer-password" class="s-input" placeholder="••••••••" />
      <button class="s-btn" id="transfer-btn" type="button">تحويل الآن</button>
    </div>
  </div>

  <!-- Bottom navigation is provided globally by the Layout (BottomNav.astro);
       the page no longer renders its own to avoid a duplicate/overlapping bar. -->
  <div class="w-toast" id="w-toast"></div>
</Layout>

<script>
  import { getValidAccessToken } from '../utils/clientSession';
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H = { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY, 'Content-Type': 'application/json' };
  var user = null;
  try { var raw = localStorage.getItem('wslha_user'); user = raw ? JSON.parse(raw) : null; } catch {}
  if (!user) { document.getElementById('auth-box').style.display = ''; }
  else { document.getElementById('wallet-main').style.display = 'block'; loadWallet(); loadLog(); }

  function toast(msg, ok) {
    var t = document.getElementById('w-toast');
    t.textContent = msg; t.style.background = ok === false ? '#dc2626' : '#1f2937';
    t.classList.add('show'); setTimeout(function() { t.classList.remove('show'); }, 2800);
  }
  function openSheet(id) { document.getElementById(id).classList.add('visible'); }
  function closeSheet(id) { document.getElementById(id).classList.remove('visible'); }
  ['sheet-deposit','sheet-withdraw','sheet-transfer','sheet-paymob'].forEach(function(id) {
    document.getElementById(id).addEventListener('click', function(e) { if (e.target === this) closeSheet(id); });
  });
  document.getElementById('btn-deposit').addEventListener('click', function() { openSheet('sheet-deposit'); });
  document.getElementById('btn-withdraw-open').addEventListener('click', function() { openSheet('sheet-withdraw'); });
  document.getElementById('btn-transfer-open').addEventListener('click', function() { openSheet('sheet-transfer'); });

  document.querySelectorAll('.quick-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.quick-btn').forEach(function(b) { b.classList.remove('sel'); });
      btn.classList.add('sel');
      document.getElementById('charge-amount').value = btn.dataset.val;
    });
  });
  document.getElementById('charge-amount').addEventListener('input', function() {
    document.querySelectorAll('.quick-btn').forEach(function(b) { b.classList.remove('sel'); });
  });

  function renderBalance(bal) {
    document.getElementById('balance-val').textContent = Number(bal).toLocaleString('ar-EG');
    document.getElementById('withdraw-avail').textContent = Number(bal).toLocaleString('ar-EG');
  }

  async function loadWallet() {
    if (!user) return;

    // First choice: the new access-token-verified endpoint (security
    // system, security-50) — the server reads the phone from the signed
    // token itself, never from anything this page sends. Only reachable
    // if this browser has an active session (logged in/registered since
    // that system shipped); falls through to the old phone-trust RPC
    // otherwise so nothing breaks for existing sessions.
    try {
      const token = await getValidAccessToken();
      if (token) {
        const res = await fetch('/api/wallet/balance', { headers: { Authorization: 'Bearer ' + token } });
        if (res.ok) {
          const { balance } = await res.json();
          renderBalance(balance || 0);
          return;
        }
      }
    } catch {}

    try {
      // get_my_wallet_balance (security-49) — direct SELECT on wallets is
      // closed since it had no filter and dumped every user's balance.
      var res = await fetch(SB_URL + '/rest/v1/rpc/get_my_wallet_balance', {
        method: 'POST', headers: { ...SB_H, 'Content-Type': 'application/json' },
        body: JSON.stringify({ p_phone: user.phone }),
      });
      var bal = res.ok ? (await res.json()) || 0 : 0;
      renderBalance(bal);
    } catch {}
  }

  async function loadLog() {
    if (!user) return;
    try {
      var res = await fetch(SB_URL + '/rest/v1/wallet_transactions?phone=eq.' + encodeURIComponent(user.phone) + '&select=amount,type,note,created_at&order=created_at.desc&limit=50', { headers: SB_H });
      var txs = await res.json();
      var el = document.getElementById('tx-list');
      if (!Array.isArray(txs) || !txs.length) { el.innerHTML = '<div class="tx-empty">لا توجد معاملات بعد</div>'; return; }
      var labels = { topup:'إيداع', deposit:'إيداع', earning:'أرباح', refund:'استرداد', transfer_in:'تحويل وارد', commission:'عمولة', payment:'مدفوعات', withdrawal:'سحب', transfer_out:'تحويل صادر', admin_credit:'شحن يدوي', admin_debit:'خصم يدوي' };
      var today = new Date().toDateString();
      var groups = {};
      txs.forEach(function(t) {
        var d = new Date(t.created_at); var key = d.toDateString();
        if (!groups[key]) groups[key] = { label: key === today ? 'اليوم' : d.toLocaleDateString('ar-EG', { year:'numeric', month:'long', day:'numeric' }), items: [] };
        groups[key].items.push(t);
      });
      var html = '';
      Object.keys(groups).forEach(function(key) {
        var g = groups[key];
        html += '<div class="tx-date-group">' + g.label + '</div>';
        g.items.forEach(function(t) {
          var amt = Number(t.amount); var isPos = amt >= 0;
          var label = labels[t.type] || t.type;
          var time = new Date(t.created_at).toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
          var dateStr = new Date(t.created_at).toLocaleDateString('ar-EG', { day:'numeric', month:'short', year:'numeric' });
          html += '<div class="tx-item"><div class="tx-item__left"><div class="tx-item__type"><span class="tx-item__type-check">' + (isPos?'✓':'✕') + '</span>' + label + '</div><div class="tx-item__date">' + dateStr + ' ' + time + '</div></div><div class="tx-item__amount ' + (isPos?'pos':'neg') + '">' + (isPos?'+':'') + Math.abs(amt).toLocaleString('ar-EG') + '</div></div>';
        });
      });
      el.innerHTML = html;
    } catch { document.getElementById('tx-list').innerHTML = '<div class="tx-empty">تعذّر تحميل المعاملات</div>'; }
  }

  // Map RPC error codes → friendly Arabic messages
  function rpcError(txt) {
    if (/insufficient_funds/.test(txt))     return 'رصيدك غير كافٍ';
    if (/amount_too_small/.test(txt))       return 'المبلغ أقل من الحد المسموح';
    if (/destination_required/.test(txt))   return 'أدخل رقم التحويل';
    if (/recipient_not_found/.test(txt))    return 'لم يُعثر على هذا المستخدم';
    if (/same_account/.test(txt))           return 'لا يمكن التحويل لنفس الحساب';
    if (/invalid_credentials/.test(txt))    return 'كلمة المرور غير صحيحة';
    return 'حدث خطأ، حاول مرة أخرى';
  }
  async function callRpc(name, payload) {
    var res = await fetch(SB_URL + '/rest/v1/rpc/' + name, {
      method: 'POST', headers: SB_H, body: JSON.stringify(payload)
    });
    var body = await res.text();
    if (!res.ok) { throw new Error(rpcError(body)); }
    try { return JSON.parse(body); } catch { return null; }
  }

  // ── Deposit: never changes the balance on the client. It records a
  //    top-up request the admin confirms once the real money arrives.
  document.getElementById('charge-btn').addEventListener('click', async function() {
    if (!user) return;
    var amt = parseFloat(document.getElementById('charge-amount').value);
    if (!amt || amt < 10) { toast('أدخل مبلغاً لا يقل عن 10 جنيه', false); return; }
    var method = document.querySelector('input[name="charge-method"]:checked').value;
    var methodLabel = { vodafone:'فودافون كاش', instapay:'إنستاباي', bank:'تحويل بنكي' }[method];
    var btn = this; btn.disabled = true; btn.textContent = 'جاري الإرسال...';
    try {
      await callRpc('request_deposit', { p_phone:user.phone, p_amount:amt, p_method:methodLabel, p_note:'طلب إيداع عبر '+methodLabel });
      closeSheet('sheet-deposit');
      toast('✅ تم استلام طلب الإيداع — سيُضاف الرصيد بعد تأكيد التحويل');
    } catch(ex) { toast(ex.message, false); }
    btn.disabled = false; btn.textContent = 'إيداع الرصيد';
  });

  // ── Online deposit via Paymob: server creates the checkout intention,
  //    balance is only ever credited by the paymob-webhook function once
  //    Paymob confirms the payment (HMAC-verified) — never from the client.
  document.getElementById('charge-paymob-btn').addEventListener('click', async function() {
    if (!user) return;
    var amt = parseFloat(document.getElementById('charge-amount').value);
    if (!amt || amt < 10) { toast('أدخل مبلغاً لا يقل عن 10 جنيه', false); return; }
    var btn = this; btn.disabled = true; btn.textContent = 'جاري التحضير...';
    try {
      var res = await fetch(SB_URL + '/functions/v1/paymob-create-intention', {
        method: 'POST', headers: SB_H, body: JSON.stringify({ phone: user.phone, amount: amt }),
      });
      var data = await res.json();
      if (!res.ok || !data.iframe_url) throw new Error(data.error === 'gateway_not_configured' ? 'الدفع الإلكتروني غير مفعّل حالياً' : 'تعذّر بدء عملية الدفع');
      closeSheet('sheet-deposit');
      if (window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform()) {
        var Browser = window.Capacitor.Plugins.Browser;
        Browser.addListener('browserFinished', function() { loadWallet(); loadLog(); });
        await Browser.open({ url: data.iframe_url });
      } else {
        document.getElementById('paymob-iframe').src = data.iframe_url;
        openSheet('sheet-paymob');
        pollPaymobRequest(data.request_id);
      }
    } catch(ex) { toast(ex.message, false); }
    btn.disabled = false; btn.textContent = '💳 ادفع الآن أونلاين (فيزا / فودافون كاش / فوري)';
  });

  // Polls the wallet_requests row while the Paymob sheet is open so we can
  // close it and refresh the balance the moment paymob-webhook marks it
  // done/rejected — the client never decides this itself.
  function pollPaymobRequest(requestId) {
    var tries = 0;
    var timer = setInterval(async function() {
      tries++;
      if (!document.getElementById('sheet-paymob').classList.contains('visible') || tries > 100) {
        clearInterval(timer); return;
      }
      try {
        var res = await fetch(SB_URL + '/rest/v1/wallet_requests?id=eq.' + encodeURIComponent(requestId) + '&select=status', { headers: SB_H });
        var rows = await res.json();
        var status = rows && rows[0] && rows[0].status;
        if (status === 'done' || status === 'rejected') {
          clearInterval(timer);
          closeSheet('sheet-paymob');
          loadWallet(); loadLog();
          toast(status === 'done' ? '✅ تم الإيداع بنجاح' : '❌ لم تكتمل عملية الدفع', status === 'done');
        }
      } catch {}
    }, 3000);
  }

  // ── Withdraw: the server reserves the funds atomically (checks the
  //    balance, deducts, logs) and opens an admin payout request. The
  //    client cannot set its own balance — it only calls the RPC.
  document.getElementById('withdraw-btn').addEventListener('click', async function() {
    if (!user) return;
    var amt = parseFloat(document.getElementById('withdraw-amount').value);
    var dest = document.getElementById('withdraw-dest').value.trim();
    var note = document.getElementById('withdraw-note').value.trim();
    if (!amt || amt < 10) { toast('أدخل مبلغاً لا يقل عن 10 جنيه', false); return; }
    if (!dest) { toast('أدخل رقم فودافون كاش أو إنستاباي', false); return; }
    var btn = this; btn.disabled = true; btn.textContent = 'جاري المعالجة...';
    try {
      await callRpc('request_withdrawal', { p_phone:user.phone, p_amount:amt, p_dest:dest, p_note:note || null });
      document.getElementById('withdraw-amount').value = '';
      document.getElementById('withdraw-dest').value = '';
      document.getElementById('withdraw-note').value = '';
      closeSheet('sheet-withdraw');
      toast('✅ تم طلب سحب ' + amt + ' ج.م — قيد المراجعة');
      loadWallet(); loadLog();
    } catch(ex) { toast(ex.message, false); }
    btn.disabled = false; btn.textContent = 'طلب سحب';
  });

  var _trTimer = null;
  document.getElementById('transfer-phone').addEventListener('input', function() {
    clearTimeout(_trTimer); var ph = this.value.trim();
    document.getElementById('transfer-recipient').classList.remove('visible');
    if (ph.length < 10) return;
    _trTimer = setTimeout(async function() {
      try {
        var res = await fetch(SB_URL+'/rest/v1/rpc/lookup_account', {
          method: 'POST', headers: SB_H, body: JSON.stringify({ p_phone: ph }),
        });
        var rows = await res.json();
        if (Array.isArray(rows) && rows[0]) {
          document.getElementById('transfer-recipient-name').textContent = rows[0].name||'مستخدم';
          document.getElementById('transfer-recipient-phone').textContent = rows[0].phone;
          document.getElementById('transfer-recipient').classList.add('visible');
        }
      } catch {}
    }, 600);
  });

  // ── Transfer: a single atomic SECURITY DEFINER RPC moves the money on
  //    the server (balance check + both ledger entries). No client write.
  document.getElementById('transfer-btn').addEventListener('click', async function() {
    if (!user) return;
    var toPhone = document.getElementById('transfer-phone').value.trim();
    var amt = parseFloat(document.getElementById('transfer-amount').value);
    var note = document.getElementById('transfer-note').value.trim();
    var password = document.getElementById('transfer-password').value;
    if (!toPhone) { toast('أدخل رقم المستلم', false); return; }
    if (toPhone === user.phone) { toast('لا يمكن التحويل لنفس الحساب', false); return; }
    if (!amt || amt < 1) { toast('أدخل مبلغاً صحيحاً', false); return; }
    if (!password) { toast('أدخل كلمة مرور حسابك لتأكيد التحويل', false); return; }

    // Resolve the recipient to their canonical stored phone via the narrow lookup RPC.
    var rRes = await fetch(SB_URL+'/rest/v1/rpc/lookup_account', {
      method: 'POST', headers: SB_H, body: JSON.stringify({ p_phone: toPhone }),
    });
    var rRows = await rRes.json();
    if (!Array.isArray(rRows)||!rRows[0]) { toast('لم يُعثر على هذا المستخدم', false); return; }
    var recipientPhone = rRows[0].phone;
    if (recipientPhone === user.phone) { toast('لا يمكن التحويل لنفس الحساب', false); return; }

    var btn = this; btn.disabled = true; btn.textContent = 'جاري التحويل...';
    try {
      await callRpc('wallet_transfer', { p_from:user.phone, p_from_password:password, p_to:recipientPhone, p_amount:amt, p_note:note || null });
      document.getElementById('transfer-phone').value = '';
      document.getElementById('transfer-amount').value = '';
      document.getElementById('transfer-note').value = '';
      document.getElementById('transfer-password').value = '';
      document.getElementById('transfer-recipient').classList.remove('visible');
      closeSheet('sheet-transfer');
      toast('✅ تم تحويل ' + amt + ' ج.م بنجاح!');
      loadWallet(); loadLog();
    } catch(ex) { toast(ex.message, false); }
    btn.disabled = false; btn.textContent = 'تحويل الآن';
  });
</script>

</Layout>
