---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';

const SIZES = [
  { id: 'doc',    label: '📄 مستند / ورقة',              base: 25 },
  { id: 'small',  label: '📦 طرد صغير — حتى 2 كجم',       base: 30 },
  { id: 'medium', label: '📦 طرد متوسط — حتى 5 كجم',      base: 40 },
  { id: 'large',  label: '📦 طرد كبير — حتى 10 كجم',      base: 55 },
];
---

<style>
  .courier-page { max-width: 720px; margin: 0 auto; padding: var(--sp-8) var(--sp-6) var(--sp-20); }
  .courier-card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); box-shadow: var(--shadow-md); overflow: hidden;
  }
  .form-section { padding: var(--sp-6); }
  .field { margin-bottom: var(--sp-4); }
  .field__label { display: block; font-weight: var(--weight-bold); font-size: var(--text-sm); margin-bottom: var(--sp-2); color: var(--color-text); }
  .field__input, .field__select, .field__textarea {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border); border-radius: var(--radius);
    font-family: var(--font-body); font-size: var(--text-sm);
    direction: rtl; background: var(--color-bg); color: var(--color-text); outline: none; transition: border-color var(--ease);
    box-sizing: border-box;
  }
  .field__input:focus, .field__select:focus, .field__textarea:focus { border-color: var(--color-primary); }
  .field__textarea { resize: vertical; min-height: 60px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); }

  .size-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-2); }
  .size-opt {
    border: 2px solid var(--color-border); border-radius: var(--radius-lg);
    padding: var(--sp-3); cursor: pointer; text-align: center; transition: all var(--ease);
  }
  .size-opt input { position: absolute; opacity: 0; width: 0; }
  .size-opt:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-light); }
  .size-opt__label { font-weight: var(--weight-bold); font-size: var(--text-sm); }
  .size-opt__fee { font-size: 11px; color: var(--color-text-faint); margin-top: 2px; }

  .route-summary {
    margin: 0 var(--sp-6) var(--sp-4);
    background: linear-gradient(135deg, #F2F7F6, #E3EDEC);
    border: 1px solid #C9DEDC; border-radius: var(--radius-xl);
    padding: var(--sp-3) var(--sp-5);
    display: flex; gap: var(--sp-4); align-items: center; justify-content: space-between;
    transition: opacity 0.3s;
  }
  .route-summary.empty { opacity: 0.45; }
  .route-summary__stat { text-align: center; }
  .route-summary__val { font-size: var(--text-lg); font-weight: var(--weight-black); color: var(--color-primary); }
  .route-summary__val--price { color: #16a34a; }
  .route-summary__key { font-size: 10px; color: var(--color-text-faint); }
  .route-summary__divider { width: 1px; height: 28px; background: #C9DEDC; flex-shrink: 0; }

  .submit-btn {
    width: 100%; padding: var(--sp-4); border-radius: var(--radius-lg);
    background: var(--color-primary); color: #fff; font-family: var(--font-body);
    font-size: var(--text-sm); font-weight: var(--weight-black);
    border: none; cursor: pointer; transition: all var(--ease);
  }
  .submit-btn:hover:not(:disabled) { background: var(--color-primary-dark); }
  .submit-btn:disabled { opacity: .45; cursor: not-allowed; }
  .alert-error { padding: var(--sp-3); border-radius: var(--radius); font-size: var(--text-sm); margin-bottom: var(--sp-3); display: none; background: #fef2f2; border: 1px solid #fca5a5; color: #b91c1c; }
  .alert-error.visible { display: block; }

  @media (max-width: 560px) {
    .form-row { grid-template-columns: 1fr; }
    .size-grid { grid-template-columns: 1fr; }
  }
</style>

<Layout title="توصيل مستندات وطرود | وصّلها" page="courier">
  <PageHero
    title="توصيل مستندات وطرود 📦"
    subtitle="سائق مخصص ينقل مستنداتك أو طردك من عنوان لعنوان داخل دمياط — بدون ما تحتاج تخرج من مكانك"
  />

  <div class="courier-page">
    <div class="courier-card" id="booking-card">
      <div class="form-section">
        <div id="courier-alert" class="alert-error"></div>

        <div class="field">
          <label class="field__label">نوع الشحنة</label>
          <div class="size-grid" id="size-grid">
            {SIZES.map((s, i) => (
              <label class="size-opt">
                <input type="radio" name="c-size" value={s.id} checked={i === 0} />
                <div class="size-opt__label">{s.label}</div>
                <div class="size-opt__fee">من {s.base} ج.م</div>
              </label>
            ))}
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="c-from">عنوان الاستلام</label>
          <input id="c-from" type="text" class="field__input" placeholder="من أين نستلم الشحنة؟" autocomplete="off" />
        </div>
        <div class="field">
          <label class="field__label" for="c-to">عنوان التسليم</label>
          <input id="c-to" type="text" class="field__input" placeholder="نوصّل الشحنة لأين؟" autocomplete="off" />
        </div>

        <div class="form-row" id="c-sender-row">
          <div class="field"><label class="field__label" for="c-sender-name">اسمك (المُرسِل)</label><input id="c-sender-name" type="text" class="field__input" placeholder="محمد أحمد" /></div>
          <div class="field"><label class="field__label" for="c-sender-phone">رقم جوالك</label><input id="c-sender-phone" type="tel" class="field__input" placeholder="010 1234 5678" /></div>
        </div>
        <div class="form-row">
          <div class="field"><label class="field__label" for="c-recv-name">اسم المستلم</label><input id="c-recv-name" type="text" class="field__input" placeholder="اسم من هيستلم الشحنة" /></div>
          <div class="field"><label class="field__label" for="c-recv-phone">رقم جوال المستلم</label><input id="c-recv-phone" type="tel" class="field__input" placeholder="010 1234 5678" /></div>
        </div>
        <div class="field"><label class="field__label" for="c-notes">وصف الشحنة / ملاحظات (اختياري)</label><textarea id="c-notes" class="field__textarea" placeholder="مثلاً: ظرف مستندات، يُسلَّم شخصياً..."></textarea></div>
        <div class="field">
          <label class="field__label">طريقة الدفع</label>
          <select id="c-payment" class="field__select">
            <option value="cash">💵 كاش عند الاستلام</option>
            <option value="wallet">📱 فودافون كاش / إنستاباي</option>
          </select>
        </div>
      </div>

      <div id="route-summary" class="route-summary empty">
        <div class="route-summary__stat"><div id="sum-dist" class="route-summary__val">—</div><div class="route-summary__key">المسافة الفعلية</div></div>
        <div class="route-summary__divider"></div>
        <div class="route-summary__stat"><div id="sum-price" class="route-summary__val route-summary__val--price">—</div><div class="route-summary__key">أجرة التوصيل</div></div>
      </div>

      <div class="form-section" style="padding-top:0">
        <button id="courier-submit-btn" class="submit-btn" type="button" disabled>📦 اطلب مندوباً الآن</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' };

  const SIZES: Record<string, { label: string; base: number }> = {
    doc:    { label: '📄 مستند / ورقة',        base: 25 },
    small:  { label: '📦 طرد صغير',             base: 30 },
    medium: { label: '📦 طرد متوسط',            base: 40 },
    large:  { label: '📦 طرد كبير',             base: 55 },
  };

  function normPhone(s: string) { return s.replace(/[\s\-()+]/g, ''); }
  const EG = /^01[0125][0-9]{8}$/;

  function haversineKm(lat1: number, lng1: number, lat2: number, lng2: number) {
    const R = 6371, dLat = (lat2 - lat1) * Math.PI / 180, dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }
  function currentSizeId(): string {
    return (document.querySelector('input[name="c-size"]:checked') as HTMLInputElement)?.value || 'doc';
  }
  function feeFor(km: number): number {
    const base = SIZES[currentSizeId()]?.base ?? 25;
    const raw  = base + Math.max(0, km - 3) * 3;
    return Math.ceil(raw / 5) * 5;
  }

  // ── Logged-in sender auto-fill ──
  function hideSenderFieldsIfLoggedIn() {
    try {
      const u = JSON.parse(localStorage.getItem('wslha_user') || 'null');
      if (u?.name && u?.phone) {
        (document.getElementById('c-sender-name') as HTMLInputElement).value  = u.name;
        (document.getElementById('c-sender-phone') as HTMLInputElement).value = u.phone;
        const row = document.getElementById('c-sender-row');
        if (row) row.hidden = true;
      }
    } catch {}
  }
  hideSenderFieldsIfLoggedIn();

  // ── Google Places (Damietta-only, same bounds as rides.astro) ──
  const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';
  let fromPlace: { name: string; lat: number; lng: number } | null = null;
  let toPlace:   { name: string; lat: number; lng: number } | null = null;
  let realRoadKm = 0;

  function loadGoogleMaps(): Promise<void> {
    return new Promise((resolve) => {
      if ((window as any).google?.maps) { resolve(); return; }
      (window as any).__gmCourierInit = resolve;
      const s = document.createElement('script');
      s.src = `https://maps.googleapis.com/maps/api/js?key=${GMAPS_KEY}&libraries=places&callback=__gmCourierInit&language=ar&region=EG`;
      s.async = true;
      document.head.appendChild(s);
    });
  }

  async function computeRoute() {
    if (!fromPlace || !toPlace) return;
    const km = haversineKm(fromPlace.lat, fromPlace.lng, toPlace.lat, toPlace.lng) * 1.35;
    realRoadKm = km;
    updateSummary();
  }

  function updateSummary() {
    const summary = document.getElementById('route-summary')!;
    const btn = document.getElementById('courier-submit-btn') as HTMLButtonElement;
    if (!fromPlace || !toPlace) {
      document.getElementById('sum-dist')!.textContent  = '—';
      document.getElementById('sum-price')!.textContent = '—';
      summary.classList.add('empty');
      btn.disabled = true;
      return;
    }
    document.getElementById('sum-dist')!.textContent  = '~' + realRoadKm.toFixed(1) + ' كم';
    document.getElementById('sum-price')!.textContent = feeFor(realRoadKm) + ' ج.م';
    summary.classList.remove('empty');
    btn.disabled = false;
  }

  document.querySelectorAll('input[name="c-size"]').forEach(r => r.addEventListener('change', updateSummary));

  let placesInited = false;
  async function initPlaces() {
    if (placesInited) return;
    placesInited = true;
    await loadGoogleMaps();
    const G = (window as any).google.maps;
    const damiettaBias = new G.LatLngBounds({ lat: 31.20, lng: 31.50 }, { lat: 31.65, lng: 32.10 });
    const opts = { bounds: damiettaBias, componentRestrictions: { country: 'eg' }, strictBounds: true, types: [], fields: ['geometry', 'name', 'formatted_address'] };

    const acFrom = new G.places.Autocomplete(document.getElementById('c-from'), opts);
    const acTo   = new G.places.Autocomplete(document.getElementById('c-to'), opts);
    acFrom.addListener('place_changed', () => {
      const p = acFrom.getPlace();
      if (!p?.geometry?.location) return;
      fromPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
      computeRoute();
    });
    acTo.addListener('place_changed', () => {
      const p = acTo.getPlace();
      if (!p?.geometry?.location) return;
      toPlace = { name: p.name || p.formatted_address, lat: p.geometry.location.lat(), lng: p.geometry.location.lng() };
      computeRoute();
    });
  }
  ['c-from', 'c-to'].forEach(id => {
    document.getElementById(id)?.addEventListener('focus', () => { initPlaces(); }, { once: true });
  });

  document.getElementById('courier-submit-btn')?.addEventListener('click', async () => {
    const errEl = document.getElementById('courier-alert')!;
    errEl.classList.remove('visible');

    const senderName  = (document.getElementById('c-sender-name') as HTMLInputElement).value.trim();
    const senderPhone = normPhone((document.getElementById('c-sender-phone') as HTMLInputElement).value.trim());
    const recvName    = (document.getElementById('c-recv-name') as HTMLInputElement).value.trim();
    const recvPhone   = normPhone((document.getElementById('c-recv-phone') as HTMLInputElement).value.trim());
    const notes       = (document.getElementById('c-notes') as HTMLTextAreaElement).value.trim();
    const payment     = (document.getElementById('c-payment') as HTMLSelectElement).value;

    if (!senderName)          { errEl.textContent = 'يرجى إدخال اسمك.'; errEl.classList.add('visible'); return; }
    if (!EG.test(senderPhone)) { errEl.textContent = 'رقم جوالك غير صحيح (01...)'; errEl.classList.add('visible'); return; }
    if (!recvName)             { errEl.textContent = 'يرجى إدخال اسم المستلم.'; errEl.classList.add('visible'); return; }
    if (!EG.test(recvPhone))   { errEl.textContent = 'رقم جوال المستلم غير صحيح (01...)'; errEl.classList.add('visible'); return; }
    if (!fromPlace || !toPlace) { errEl.textContent = 'يرجى اختيار عنوان الاستلام والتسليم.'; errEl.classList.add('visible'); return; }

    const btn = document.getElementById('courier-submit-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'جاري إرسال الطلب...';

    const sizeId = currentSizeId();
    const fee = feeFor(realRoadKm);
    const code = 'WSL-' + new Date().getFullYear() + '-' + Math.floor(100000 + Math.random() * 900000);
    const itemLabel = SIZES[sizeId].label + (notes ? ' — ' + notes : '');

    try {
      const res = await fetch(`${SB_URL}/rest/v1/orders`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify({
          code,
          store_id: 'courier',
          store_name: `طرد من ${senderName} — ${fromPlace.name}`,
          store_emoji: '📦',
          customer_name: recvName,
          customer_phone: recvPhone,
          area: toPlace.name,
          address: toPlace.name,
          items: [{ name: itemLabel, qty: 1, price: 0 }],
          items_summary: itemLabel,
          subtotal: 0,
          delivery_fee: fee,
          total: fee,
          payment,
          // pending until the courier team reviews it in the admin panel's
          // "الطرود والمستندات" tab — accepting there flips this to
          // 'preparing', which is what actually triggers driver dispatch.
          status: 'pending',
          store_lat: fromPlace.lat,
          store_lng: fromPlace.lng,
          customer_lat: toPlace.lat,
          customer_lng: toPlace.lng,
          notes: `المُرسِل: ${senderName} — ${senderPhone}`,
        }),
      });
      if (!res.ok) {
        const detail = await res.text().catch(() => '');
        console.error('[courier] order insert failed', res.status, detail);
        errEl.textContent = 'تعذر إرسال الطلب، حاول مرة أخرى.'; errEl.classList.add('visible');
        btn.disabled = false; btn.textContent = '📦 اطلب مندوباً الآن';
        return;
      }
      window.location.href = `/track?q=${encodeURIComponent(code)}`;
    } catch (e) {
      console.error('[courier] order insert error', e);
      errEl.textContent = 'تعذر إرسال الطلب، تحقق من الاتصال وحاول مرة أخرى.'; errEl.classList.add('visible');
      btn.disabled = false; btn.textContent = '📦 اطلب مندوباً الآن';
    }
  });
</script>
