---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
import { STORES, CATEGORIES } from '../data/stores';
---

<style>
  .market {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-10) var(--sp-6) var(--sp-20);
  }

  /* How it works strip */
  .how {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
    margin-bottom: var(--sp-10);
  }
  .how-step {
    background: var(--color-bg-soft);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    text-align: center;
  }
  .how-step__num {
    width: 32px; height: 32px;
    margin: 0 auto var(--sp-2);
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: #fff; font-weight: var(--weight-black);
    display: flex; align-items: center; justify-content: center;
  }
  .how-step__title { font-weight: var(--weight-black); font-size: var(--text-sm); margin-bottom: 2px; }
  .how-step__desc  { font-size: var(--text-xs); color: var(--color-text-muted); line-height: 1.6; }

  /* Category filter */
  .cats {
    display: flex;
    gap: var(--sp-2);
    overflow-x: auto;
    padding-bottom: var(--sp-2);
    margin-bottom: var(--sp-8);
    scrollbar-width: thin;
  }
  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-5);
    border-radius: var(--radius-full);
    border: 2px solid var(--color-border);
    background: var(--color-bg);
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
    cursor: pointer;
    transition: all var(--ease);
  }
  .cat-chip:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .cat-chip.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  /* Store grid */
  .stores-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-6);
  }

  .store-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: border-color var(--ease), box-shadow var(--ease), transform var(--ease);
  }
  .store-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .store-card__cover {
    height: 120px;
    background: linear-gradient(135deg, var(--color-primary-light), #DBEAFE);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    position: relative;
  }
  .store-card__fee {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    background: var(--color-bg);
    border-radius: var(--radius-full);
    padding: 3px var(--sp-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    box-shadow: var(--shadow-sm);
  }

  .store-card__body { padding: var(--sp-5); flex: 1; display: flex; flex-direction: column; }
  .store-card__cat  { font-size: var(--text-xs); color: var(--color-primary); font-weight: var(--weight-bold); margin-bottom: 2px; }
  .store-card__name { font-size: var(--text-lg); font-weight: var(--weight-black); margin-bottom: var(--sp-1); }
  .store-card__tagline { font-size: var(--text-xs); color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--sp-4); flex: 1; }

  .store-card__meta {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: var(--sp-3);
  }
  .store-card__meta strong { color: var(--color-text); font-weight: var(--weight-bold); }
  .store-card__rating { color: var(--color-accent-dark); font-weight: var(--weight-bold); }

  .store-card__cta {
    margin-top: var(--sp-4);
    display: block;
    text-align: center;
    padding: var(--sp-3);
    border-radius: var(--radius);
    background: var(--color-primary);
    color: #fff;
    font-weight: var(--weight-black);
    font-size: var(--text-sm);
    transition: background var(--ease);
  }
  .store-card__cta:hover { background: var(--color-primary-dark); }

  .no-results {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--sp-16);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .stores-grid { grid-template-columns: repeat(2, 1fr); }
    .how { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .stores-grid { grid-template-columns: 1fr; }
  }
</style>

<Layout
  title="المتاجر المحلية"
  description="اطلب من متاجر ومطاعم دمياط المحلية — تصفّح المنتجات والأسعار، اطلب وادفع، ونحن نوصّلها لك"
  page="stores"
>
  <PageHero
    badge="🛍️ المتاجر المحلية"
    title="تسوّق من متاجر دمياط دون أن تغادر بيتك"
    subtitle="تصفّح المنتجات والأسعار، أضف لسلتك، اطلب وادفع — ونحن نوصّلها لباب بيتك"
  />

  <div class="market">

    <!-- How it works -->
    <div class="how">
      <div class="how-step">
        <div class="how-step__num">1</div>
        <p class="how-step__title">اختر متجرك</p>
        <p class="how-step__desc">تصفّح مطاعم ومتاجر دمياط المحلية</p>
      </div>
      <div class="how-step">
        <div class="how-step__num">2</div>
        <p class="how-step__title">شاهد الأسعار</p>
        <p class="how-step__desc">اعرف السعر قبل الطلب بكل شفافية</p>
      </div>
      <div class="how-step">
        <div class="how-step__num">3</div>
        <p class="how-step__title">اطلب وادفع</p>
        <p class="how-step__desc">أضف للسلة واختر وسيلة الدفع</p>
      </div>
      <div class="how-step">
        <div class="how-step__num">4</div>
        <p class="how-step__title">يحضّره التاجر</p>
        <p class="how-step__desc">ومندوبنا يوصّله لباب بيتك</p>
      </div>
    </div>

    <!-- Category filter -->
    <div class="cats" role="tablist" aria-label="تصنيفات المتاجر">
      {CATEGORIES.map((c, i) => (
        <button
          class:list={['cat-chip', i === 0 && 'is-active']}
          data-cat={c.id}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          <span aria-hidden="true">{c.emoji}</span>{c.label}
        </button>
      ))}
    </div>

    <!-- Stores -->
    <div class="stores-grid" id="stores-grid">
      {STORES.map(s => (
        <article class="store-card" data-cat={s.categoryId}>
          <div class="store-card__cover">
            <span aria-hidden="true">{s.emoji}</span>
            <span class="store-card__fee">🚚 {s.deliveryFee} ج.م توصيل</span>
          </div>
          <div class="store-card__body">
            <p class="store-card__cat">{s.category} · {s.area}</p>
            <h2 class="store-card__name">{s.name}</h2>
            <p class="store-card__tagline">{s.tagline}</p>
            <div class="store-card__meta">
              <span class="store-card__rating">★ {s.rating.toFixed(1)}</span>
              <span>⏱️ {s.deliveryTime}</span>
              <span>الحد الأدنى <strong>{s.minOrder} ج.م</strong></span>
            </div>
            <a href={`/store/${s.id}`} class="store-card__cta">تصفّح المتجر ←</a>
          </div>
        </article>
      ))}
      <p class="no-results" id="no-results" hidden>لا توجد متاجر في هذا التصنيف حالياً.</p>
    </div>

  </div>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('.cat-chip');
    const cards = document.querySelectorAll<HTMLElement>('.store-card');
    const noResults = document.getElementById('no-results') as HTMLElement;

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => { c.classList.remove('is-active'); c.setAttribute('aria-selected', 'false'); });
        chip.classList.add('is-active');
        chip.setAttribute('aria-selected', 'true');

        const cat = chip.dataset.cat;
        let visible = 0;
        cards.forEach(card => {
          const show = cat === 'all' || card.dataset.cat === cat;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        noResults.hidden = visible > 0;
      });
    });
  </script>
</Layout>
