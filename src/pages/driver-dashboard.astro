    font-size: 10px; font-weight: var(--weight-bold); padding: 2px 8px;
    border-radius: var(--radius-full); display: inline-block; margin-top: 2px;
  }
  .activity-status.completed { background: #DCFCE7; color: #14532D; }
  .activity-status.cancelled { background: #FEE2E2; color: #991B1B; }
</style>

