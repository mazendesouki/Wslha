  /* ── Supabase helpers ── */
  async function upsertLocation(online) {
    if (!driver) return;
    try {
      await fetch(`${SB_URL}/rest/v1/driver_locations`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({
          driver_phone: driver.phone,
          driver_name: driver.name || driver.phone,
          lat: driverLat ?? 31.418,
          lng: driverLng ?? 31.814,
          is_online: online,
          updated_at: new Date().toISOString(),
          ...(currentRide ? { ride_id: currentRide.id } : { ride_id: null }),
        }),
      });
    } catch {}
  }

  async function pollRides() {
    if (!isOnline || currentRide) return;
    try {
      const res = await fetch(
        `${SB_URL}/rest/v1/rides?status=eq.pending&driver_phone=is.null&select=*&order=created_at.asc&limit=1`,
        { headers: SB_H }
      );
      const rides = await res.json();
      if (Array.isArray(rides) && rides.length > 0) {
        const ride = rides[0];
        const reqEl = document.getElementById('ride-request');
        if (!reqEl.classList.contains('visible') || pendingRide?.id !== ride.id) {
          showRideRequest(ride);
        }
      } else {
        if (pendingRide) { hideRideRequest(); pendingRide = null; }
      }
    } catch {}
  }

  async function acceptRide(ride) {
    try {
      const res = await fetch(`${SB_URL}/rest/v1/rides?id=eq.${ride.id}`, {
        method: 'PATCH',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify({
          status: 'accepted',
          driver_phone: driver.phone,
          driver_name: driver.name || driver.phone,
          accepted_at: new Date().toISOString(),
        }),
      });
      const rows = await res.json();
      return Array.isArray(rows) ? rows[0] : null;
    } catch { return null; }
  }

  async function patchRide(id, data) {
    try {
      const res = await fetch(`${SB_URL}/rest/v1/rides?id=eq.${id}`, {
        method: 'PATCH',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify(data),
      });
      const rows = await res.json();
      return Array.isArray(rows) ? rows[0] : null;
    } catch { return null; }
  }

  /* ── Delivery orders polling + actions ── */
  async function pollOrders() {
    if (!isOnline || currentRide || currentOrder) return;
    try {
      // Broadcast model: any order the merchant accepted (preparing) with no driver yet
      const res = await fetch(
        `${SB_URL}/rest/v1/orders?status=eq.preparing&driver_phone=is.null&select=*&order=accepted_at.asc&limit=1`,
        { headers: SB_H }
      );
      const orders = await res.json();
      if (Array.isArray(orders) && orders.length > 0) {
        const order = orders[0];
        const reqEl = document.getElementById('ride-request');
        if (!reqEl.classList.contains('visible') || pendingOrder?.id !== order.id) {
          if (!pendingRide) showOrderRequest(order);  // rides take priority if already showing
        }
      } else if (pendingOrder) {
        hideRideRequest(); pendingOrder = null;
      }
    } catch {}
  }

  async function patchOrder(id, data) {
    try {
      const res = await fetch(`${SB_URL}/rest/v1/orders?id=eq.${id}`, {
        method: 'PATCH',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify(data),
      });
      const rows = await res.json();
      return Array.isArray(rows) ? rows[0] : null;
    } catch { return null; }
  }

  // Atomic-ish claim: only set driver if still unclaimed
  async function claimOrder(order) {
    try {
      const res = await fetch(
        `${SB_URL}/rest/v1/orders?id=eq.${order.id}&driver_phone=is.null&status=eq.preparing`,
        {
          method: 'PATCH',
          headers: { ...SB_H, Prefer: 'return=representation' },
          body: JSON.stringify({
            status: 'on_the_way',
            driver_phone: driver.phone,
            driver_name: driver.name || driver.phone,
            picked_up_at: null,
          }),
        }
      );
      const rows = await res.json();
      return Array.isArray(rows) && rows.length ? rows[0] : null;  // empty array = already claimed
    } catch { return null; }
  }

  function showActiveOrder() {
    const o = currentOrder;
    document.getElementById('active-customer-name').textContent = `🛵 توصيل — ${o.store_name || ''}`;
    document.getElementById('active-call-btn').href = 'tel:' + (o.customer_phone || '');
    document.getElementById('active-from').textContent = `🏪 ${o.store_name || ''} — ${o.area || ''}`;
    document.getElementById('active-to').textContent   = `🏠 ${o.customer_name || 'العميل'} — ${o.address || ''}`;
    document.getElementById('active-fare').textContent = String(o.delivery_fee ?? 20);
    document.getElementById('active-trip-status').textContent = 'توجّه للمتجر لاستلام الطلب';

    const arriveBtn3  = document.getElementById('btn-arrive');
    const pickupBtn   = document.getElementById('btn-pickup');
    const completeBtn = document.getElementById('btn-complete');
    arriveBtn3.textContent  = '📍 وصلت للمتجر';
    arriveBtn3.disabled     = false;
    arriveBtn3.classList.add('arrive');
    pickupBtn.textContent   = '📦 استلمت الطلب من المتجر';
    completeBtn.textContent = '✅ سلّمت الطلب للعميل';
    pickupBtn.disabled      = true;
    completeBtn.disabled    = true;
    pickupBtn.classList.add('pickup');
    completeBtn.classList.remove('complete');

    showState('active');
    if (o.store_lat && o.store_lng) {
      initDriverMap(Number(o.store_lat), Number(o.store_lng),
        Number(o.customer_lat ?? o.store_lat), Number(o.customer_lng ?? o.store_lng));
    }
  }

  /* ── Accept ── */
  document.getElementById('accept-btn').addEventListener('click', async () => {
    // Delivery order takes this branch
    if (pendingOrder) {
      const offer = pendingOrder;
      hideRideRequest();
      const claimed = await claimOrder(offer);
      pendingOrder = null;
      if (!claimed) { showToast('سبقك سائق آخر لهذا الطلب'); return; }
      currentOrder = claimed;
      await upsertLocation(true);
      showActiveOrder();
      // Lock: no cancellation after acceptance
      document.getElementById('reject-btn').style.display = 'none';
      showToast('تم قبول الطلب! توجّه إلى المتجر');
      return;
    }

    const ride = pendingRide;
    if (!ride) return;
    hideRideRequest();
    const accepted = await acceptRide(ride);
    if (!accepted) { showToast('حدث خطأ، حاول مرة أخرى'); return; }
    currentRide = accepted;
    // Lock: no cancellation after acceptance until completion
    document.getElementById('reject-btn').style.display = 'none';
    await upsertLocation(true);

    document.getElementById('active-customer-name').textContent = currentRide.customer_name || '—';
    document.getElementById('active-call-btn').href = 'tel:' + (currentRide.customer_phone || '');
    document.getElementById('active-from').textContent = currentRide.from_area;
    document.getElementById('active-to').textContent   = currentRide.to_area;
    document.getElementById('active-fare').textContent = currentRide.fare;
    document.getElementById('active-trip-status').textContent = 'في الطريق للإستلام';

    const arriveBtn2  = document.getElementById('btn-arrive');
    const pickupBtn   = document.getElementById('btn-pickup');
    const completeBtn = document.getElementById('btn-complete');
    arriveBtn2.textContent = '📍 وصلت لنقطة الاستلام';
    arriveBtn2.disabled    = false;
    arriveBtn2.classList.add('arrive');
    pickupBtn.disabled     = true;
    pickupBtn.classList.add('pickup');
    completeBtn.disabled   = true;
    completeBtn.classList.remove('complete');

    showState('active');
    initDriverMap(currentRide.from_lat, currentRide.from_lng, currentRide.to_lat, currentRide.to_lng);
    showToast('تم قبول الرحلة! توجه إلى الراكب');
  });

  /* ── Reject ── */
  document.getElementById('reject-btn').addEventListener('click', () => {
    hideRideRequest(); pendingRide = null; pendingOrder = null;
  });

  /* ── Arrived at pickup point ── */
  document.getElementById('btn-arrive').addEventListener('click', async () => {
    const arriveBtn  = document.getElementById('btn-arrive');
    const pickupBtn  = document.getElementById('btn-pickup');
    if (currentRide) {
      await patchRide(currentRide.id, { status: 'arrived' });
      currentRide.status = 'arrived';
      document.getElementById('active-trip-status').textContent = 'وصلت — انتظر الراكب 📍';
    }
    // For deliveries: no DB update needed, just unlock pickup button
    arriveBtn.disabled = true;
    arriveBtn.classList.remove('arrive');
    pickupBtn.disabled = false;
    if (currentRide) startWaitingTimer();
    showToast(currentRide ? 'وصلت لنقطة الاستلام — انتظر الراكب' : 'وصلت للمتجر — استلم الطلب');
  });

  /* ── Picked up ── */
  document.getElementById('btn-pickup').addEventListener('click', async () => {
    // Delivery order branch — picked up from store
    if (currentOrder) {
      await patchOrder(currentOrder.id, { status: 'on_the_way', picked_up_at: new Date().toISOString() });
      currentOrder.status = 'on_the_way';
      document.getElementById('active-trip-status').textContent = 'في الطريق للعميل 🚗';
      const pickupBtn   = document.getElementById('btn-pickup');
      const completeBtn = document.getElementById('btn-complete');
      pickupBtn.disabled   = true;
      pickupBtn.classList.remove('pickup');
      completeBtn.disabled = false;
      completeBtn.classList.add('complete');
      showToast('تم الاستلام — توجّه للعميل!');
      return;
    }

    if (!currentRide) return;
    stopWaitingTimer();
    await patchRide(currentRide.id, { status: 'in_progress' });
    currentRide.status = 'in_progress';
    document.getElementById('active-trip-status').textContent = 'في الطريق للوجهة 🚗';
    const pickupBtn   = document.getElementById('btn-pickup');
    const completeBtn = document.getElementById('btn-complete');
    pickupBtn.disabled   = true;
    pickupBtn.classList.remove('pickup');
    completeBtn.disabled = false;
    completeBtn.classList.add('complete');
    showToast('تم التأكيد — استمر في الرحلة!');
  });

  function resetActionButtons() {
    const arriveBtn  = document.getElementById('btn-arrive');
    const pickupBtn  = document.getElementById('btn-pickup');
    const completeBtn = document.getElementById('btn-complete');
    arriveBtn.textContent   = '📍 وصلت لنقطة الاستلام';
    arriveBtn.disabled      = false;
    arriveBtn.classList.add('arrive');
    pickupBtn.textContent   = '✓ التقطت الراكب / الطلب';
    pickupBtn.disabled      = true;
    pickupBtn.classList.add('pickup');
    completeBtn.textContent = '✓ وصلت للوجهة';
    completeBtn.disabled    = true;
    completeBtn.classList.remove('complete');
    // Restore reject button for next trip
    document.getElementById('reject-btn').style.display = '';
  }

  /* ── Complete ── */
  document.getElementById('btn-complete').addEventListener('click', async () => {
    // Delivery order branch — delivered to customer
    if (currentOrder) {
      await patchOrder(currentOrder.id, { status: 'delivered', delivered_at: new Date().toISOString() });
      const fee = currentOrder.delivery_fee || 0;
      const orderId = currentOrder.id;
      try {
        const key = 'wslha_driver_stats_' + (driver?.phone || '') + '_' + new Date().toDateString();
        todayStats.trips += 1;
        todayStats.earn  += fee;
        localStorage.setItem(key, JSON.stringify(todayStats));
        renderStats();
      } catch {}
      await recordCompletion('delivery', orderId, fee);
      // Credit merchant wallet with order subtotal (order total minus delivery fee)
      if (storeId) {
        try {
          const storeData = await fetch(`${SB_URL}/rest/v1/stores?id=eq.${storeId}&select=owner_phone`, { headers: SB_H }).then(r => r.json());
          const mPhone = storeData?.[0]?.owner_phone;
          if (mPhone) {
            const subtotal = Math.max(0, (currentOrder.subtotal || currentOrder.total || 0) - fee);
            await Promise.allSettled([
              fetch(`${SB_URL}/rest/v1/rpc/add_wallet_balance`, { method: 'POST', headers: SB_H, body: JSON.stringify({ p_phone: mPhone, p_amount: subtotal }) }),
              fetch(`${SB_URL}/rest/v1/rpc/log_wallet_transaction`, { method: 'POST', headers: { ...SB_H, 'Content-Type': 'application/json' }, body: JSON.stringify({ p_phone: mPhone, p_amount: subtotal, p_type: 'earning', p_reference_id: orderId, p_note: `أرباح طلب #${currentOrder.code || orderId}` }) }),
            ]);
          }
        } catch {}
      }
      currentOrder = null;
      await upsertLocation(true);
      map = null; driverMarker = null;
      resetActionButtons();
      showState('waiting');
      showToast(`تم توصيل الطلب! أرباح +${fee} ج.م 🎉`);
      setTimeout(() => loadActivityLog(), 600);
      return;
    }

    if (!currentRide) return;
    await patchRide(currentRide.id, { status: 'completed', completed_at: new Date().toISOString() });
    const fare   = currentRide.fare;
    const rideId = currentRide.id;
    try {
      const key = 'wslha_driver_stats_' + (driver?.phone || '') + '_' + new Date().toDateString();
      todayStats.trips += 1;
      todayStats.earn  += fare || 0;
      localStorage.setItem(key, JSON.stringify(todayStats));
      renderStats();
    } catch {}
    const rideType = currentRide ? (currentRide.ride_type === 'airport' ? 'airport' : 'ride') : 'ride';
    const completedRide = { ...currentRide };
    await recordCompletion(rideType, rideId, fare || 0);
    currentRide = null;
    stopWaitingTimer();
    await upsertLocation(true);
    map = null; driverMarker = null;
    resetActionButtons();
    showReceiptModal(completedRide);
    setTimeout(() => loadActivityLog(), 600);
  });

  /* ── Navigate button: open Google Maps ── */
  document.getElementById('btn-navigate').addEventListener('click', () => {
    if (!destLat || !destLng) return;
    const origin = (driverLat && driverLng) ? `${driverLat},${driverLng}` : '';
    const url = `https://www.google.com/maps/dir/${origin}/${destLat},${destLng}`;
    window.open(url, '_blank');
  });

  /* ── Tab switching ── */
  function switchTab(name) {
    document.querySelectorAll('.dash-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.toggle('active', p.id === `tab-${name}`));
    if (name === 'account')  loadAccountData();
    if (name === 'activity') loadActivityLog();
  }

  /* ── Load approval status ── */
  async function loadApprovalStatus() {
    if (!driver) return;
    try {
      // Support both phone formats
      const p = driver.phone;
      const local  = p.startsWith('+20') ? '0' + p.slice(3) : p;
      const intl   = p.startsWith('01')  ? '+2' + p : p;
      const orFilter = `or=(phone.eq.${encodeURIComponent(intl)},phone.eq.${encodeURIComponent(local)})`;

      const [acctRes, appRes] = await Promise.all([
        fetch(`${SB_URL}/rest/v1/rpc/lookup_account?p_phone=${encodeURIComponent(p)}`, { headers: SB_H }),
        fetch(`${SB_URL}/rest/v1/driver_applications?${orFilter}&select=status,rejection_reason,created_at&order=created_at.desc&limit=1`, { headers: SB_H }),
      ]);

      const acctRows = acctRes.ok ? await acctRes.json() : [];
      const appRows  = appRes.ok  ? await appRes.json()  : [];

      const acctStatus = Array.isArray(acctRows) && acctRows[0] ? (acctRows[0].status || 'active') : null;
      const acctRole   = Array.isArray(acctRows) && acctRows[0] ? acctRows[0].role : null;
      const appStatus  = Array.isArray(appRows)  && appRows[0]  ? appRows[0].status : null;
      const rejection  = Array.isArray(appRows)  && appRows[0]  ? appRows[0].rejection_reason : null;

      // ── Status chips in status bar ──
      const acctChip = document.getElementById('acct-status-chip');
      const appChip  = document.getElementById('app-status-chip');

      const acctStyles = {
        active:   { bg:'#DCFCE7', color:'#14532D', label:'🟢 الحساب: نشط' },
        approved: { bg:'#DBEAFE', color:'#1E3A8A', label:'✅ الحساب: معتمد' },
        pending:  { bg:'#FEF9C3', color:'#92400E', label:'🟡 الحساب: معلق' },
        rejected: { bg:'#FEE2E2', color:'#991B1B', label:'❌ الحساب: مرفوض' },
        banned:   { bg:'#FEE2E2', color:'#991B1B', label:'🚫 الحساب: محظور' },
      };
      const appStyles = {
        pending:  { bg:'#FEF9C3', color:'#92400E', label:'⏳ الطلب: قيد المراجعة' },
        approved: { bg:'#DCFCE7', color:'#14532D', label:'✅ الطلب: مقبول' },
        rejected: { bg:'#FEE2E2', color:'#991B1B', label:'❌ الطلب: مرفوض' },
      };

      if (acctChip && acctStatus) {
        const s = acctStyles[acctStatus] || { bg:'#F1F5F9', color:'#334155', label:'الحساب: ' + acctStatus };
        acctChip.style.cssText = `display:inline-block;font-size:.7rem;font-weight:800;padding:2px 10px;border-radius:99px;background:${s.bg};color:${s.color}`;
        acctChip.textContent = s.label;
      }
      if (appChip && appStatus) {
        const s = appStyles[appStatus] || { bg:'#F1F5F9', color:'#334155', label:'الطلب: ' + appStatus };
        appChip.style.cssText = `display:inline-block;font-size:.7rem;font-weight:800;padding:2px 10px;border-radius:99px;background:${s.bg};color:${s.color}`;
        appChip.textContent = s.label;
      }

      // ── Approval banner ──
      const banner = document.getElementById('approval-banner');
      if (!banner) return;

      // Handle banned account first
      if (acctStatus === 'banned') {
        banner.innerHTML = `<div class="approval-banner rejected"><div class="approval-banner__icon">🚫</div><div><div class="approval-banner__title">حسابك محظور</div><div class="approval-banner__sub">يرجى التواصل مع الدعم. <a href="/contact" style="color:#991B1B;font-weight:700">تواصل معنا</a></div></div></div>`;
        banner.style.display = 'block';
        document.getElementById('toggle-btn').disabled = true;
        return;
      }

      // If account itself is approved, or role is driver (admin set it), treat as approved
      const effectiveAppStatus = appStatus || (acctStatus === 'approved' || acctRole === 'driver' ? 'approved' : null);

      if (!effectiveAppStatus) {
        banner.innerHTML = `<div class="approval-banner pending"><div class="approval-banner__icon">📋</div><div><div class="approval-banner__title">لم تقدّم طلب انضمام بعد</div><div class="approval-banner__sub">قدّم طلبك لبدء العمل كسائق. <a href="/driver" style="color:var(--color-primary);font-weight:700">تقديم الطلب الآن</a></div></div></div>`;
        banner.style.display = 'block';
        document.getElementById('toggle-btn').disabled = true;
        return;
      }

      const configs = {
        pending: {
          cls:'pending', icon:'⏳',
          title:'طلبك قيد المراجعة',
          sub:'يراجع فريق وصّلها وثائقك خلال 1-3 أيام عمل. سنتواصل معك فور اتخاذ القرار.'
        },
        approved: {
          cls:'approved', icon:'✅',
          title:'تم اعتمادك كسائق! 🎉',
          sub:'يمكنك الآن تفعيل التشغيل واستقبال الطلبات.'
        },
        rejected: {
          cls:'rejected', icon:'❌',
          title:'تم رفض طلبك',
          sub:(rejection ? `سبب الرفض: ${rejection}. ` : '') + '<a href="/contact" style="color:#991B1B;font-weight:700">تواصل معنا</a> لمزيد من التفاصيل أو <a href="/driver" style="color:#991B1B;font-weight:700">أعد التقديم</a>.'
        },
      };

      const c = configs[effectiveAppStatus] || configs.pending;
      banner.innerHTML = `<div class="approval-banner ${c.cls}"><div class="approval-banner__icon">${c.icon}</div><div><div class="approval-banner__title">${c.title}</div><div class="approval-banner__sub">${c.sub}</div></div></div>`;
      banner.style.display = 'block';

      if (effectiveAppStatus !== 'approved') {
        document.getElementById('toggle-btn').disabled = true;
        document.getElementById('toggle-btn').title = 'يجب اعتماد طلبك أولاً';
      } else {
        // Auto-activate: go online immediately when driver is approved
        await goOnline();
      }
    } catch(e) { console.error('loadApprovalStatus error', e); }
  }

  /* ── Load wallet, points, ratings ── */
  async function loadAccountData() {
    if (!driver) return;
    const phone = encodeURIComponent(driver.phone);
    // Parallel fetches
    const [walletRes, walletTxRes, pointsRes, pointsTxRes, ratingsRes] = await Promise.allSettled([
      fetch(`${SB_URL}/rest/v1/wallets?phone=eq.${phone}&select=balance`, { headers: SB_H }),
      fetch(`${SB_URL}/rest/v1/wallet_transactions?phone=eq.${phone}&select=amount,type,note,created_at&order=created_at.desc&limit=10`, { headers: SB_H }),
      fetch(`${SB_URL}/rest/v1/points?phone=eq.${phone}&select=total_points`, { headers: SB_H }),
      fetch(`${SB_URL}/rest/v1/point_transactions?phone=eq.${phone}&select=points,type,created_at&order=created_at.desc&limit=10`, { headers: SB_H }),
      fetch(`${SB_URL}/rest/v1/ratings?driver_phone=eq.${driver.phone}&select=id,rating,comment,service_type,created_at,driver_reply&order=created_at.desc&limit=20`, { headers: SB_H }),
    ]);

    // Wallet
    try {
      const walletData = await walletRes.value.json();
      const balance = walletData?.[0]?.balance ?? 0;
      document.getElementById('wallet-balance').textContent = Number(balance).toLocaleString('ar-EG');
    } catch {}
    try {
      const txs = await walletTxRes.value.json();
      const container = document.getElementById('wallet-txs');
      if (Array.isArray(txs) && txs.length) {
        container.innerHTML = txs.map(t => {
          const amt = Number(t.amount);
          const sign = amt >= 0 ? '+' : '';
          const cls  = amt >= 0 ? 'pos' : 'neg';
          const d = new Date(t.created_at).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' });
          const typeLabel = { commission:'عمولة منصة', earning:'أرباح', topup:'إضافة رصيد', withdrawal:'سحب', refund:'استرداد' }[t.type] || t.type;
          return `<div class="acct-tx"><span class="acct-tx__note">${t.note || typeLabel}</span><span class="acct-tx__date">${d}</span><span class="acct-tx__amt ${cls}">${sign}${Math.abs(amt)} ج.م</span></div>`;
        }).join('');
      }
    } catch {}

    // Points
    try {
      const pointsData = await pointsRes.value.json();
      document.getElementById('points-total').textContent = (pointsData?.[0]?.total_points ?? 0).toLocaleString('ar-EG');
    } catch {}
    try {
      const ptxs = await pointsTxRes.value.json();
      const container = document.getElementById('points-txs');
      if (Array.isArray(ptxs) && ptxs.length) {
        container.innerHTML = ptxs.map(t => {
          const p = Number(t.points);
          const sign = p >= 0 ? '+' : '';
          const cls  = p >= 0 ? 'pos' : 'neg';
          const d = new Date(t.created_at).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' });
          const typeLabel = { ride:'مشوار', delivery:'توصيل متجر', airport:'رحلة مطار', bonus:'مكافأة', redeem:'استبدال' }[t.type] || t.type;
          return `<div class="acct-tx"><span class="acct-tx__note">${typeLabel}</span><span class="acct-tx__date">${d}</span><span class="acct-tx__amt ${cls}">${sign}${Math.abs(p)} نقطة</span></div>`;
        }).join('');
      }
    } catch {}

    // Ratings
    try {
      const rts = await ratingsRes.value.json();
      if (Array.isArray(rts) && rts.length) {
        const avg = rts.reduce((s, r) => s + r.rating, 0) / rts.length;
        const stars = '⭐'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg));
        document.getElementById('rating-avg').textContent   = avg.toFixed(1);
        document.getElementById('rating-stars').textContent = stars;
        document.getElementById('rating-count').textContent = `${rts.length} تقييم`;
        document.getElementById('stat-rating').textContent  = avg.toFixed(1);
        document.getElementById('ratings-list').innerHTML = rts.map(r => {
          const d = new Date(r.created_at).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' });
          const s = '⭐'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
          const typeIcon = r.service_type === 'delivery' ? '🛵' : r.service_type === 'airport' ? '✈️' : '🚗';
          const commentHtml = r.comment ? `<div class="rating-item__comment">"${r.comment}"</div>` : '';
          const replyHtml = r.driver_reply
            ? `<div class="rating-item__reply"><div class="rating-item__reply-label">ردك:</div>${r.driver_reply}</div>`
            : `<div class="rating-reply-form"><textarea class="rating-reply-input" rows="1" placeholder="اكتب ردك..."></textarea><button class="rating-reply-send" onclick="sendReply('${r.id}',this)">إرسال</button></div>`;
          return `<div class="rating-item" id="rt-${r.id}"><div class="rating-item__top"><span class="rating-item__stars">${s}</span><span class="rating-item__date">${typeIcon} ${d}</span></div>${commentHtml}${replyHtml}</div>`;
        }).join('');
      }
    } catch {}
  }

  /* ── Load activity log ── */
  async function loadActivityLog() {
    if (!driver) return;
    const phone = encodeURIComponent(driver.phone);
    const [ridesRes, ordersRes] = await Promise.allSettled([
      fetch(`${SB_URL}/rest/v1/rides?driver_phone=eq.${driver.phone}&select=id,from_area,to_area,fare,status,completed_at&order=completed_at.desc&limit=20`, { headers: SB_H }),
      fetch(`${SB_URL}/rest/v1/orders?driver_phone=eq.${driver.phone}&select=id,store_name,address,delivery_fee,status,delivered_at&order=delivered_at.desc&limit=20`, { headers: SB_H }),
    ]);

    const items = [];
    try {
      const rides = await ridesRes.value.json();
      if (Array.isArray(rides)) rides.forEach(r => items.push({
        icon: '🚗', title: `${r.from_area} ← ${r.to_area}`, earn: r.fare,
        status: r.status, type: 'ride', date: r.completed_at,
      }));
    } catch {}
    try {
      const orders = await ordersRes.value.json();
      if (Array.isArray(orders)) orders.forEach(o => items.push({
        icon: '🛵', title: `توصيل — ${o.store_name || ''}`, earn: o.delivery_fee,
        status: o.status, type: 'delivery', date: o.delivered_at,
      }));
    } catch {}

    items.sort((a, b) => new Date(b.date||0) - new Date(a.date||0));
    const container = document.getElementById('activity-list');
    if (!items.length) { container.innerHTML = '<div class="acct-empty">لا يوجد سجل نشاط بعد</div>'; return; }
    container.innerHTML = items.map(it => {
      const d = it.date ? new Date(it.date).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
      const statusLabel = { completed:'مكتملة', delivered:'مكتمل', cancelled:'ملغاة' }[it.status] || it.status;
      const statusCls   = (it.status === 'completed' || it.status === 'delivered') ? 'completed' : 'cancelled';
      return `<div class="activity-item"><div class="activity-icon">${it.icon}</div><div class="activity-info"><div class="activity-title">${it.title}</div><div class="activity-sub"><span class="activity-status ${statusCls}">${statusLabel}</span></div></div><div class="activity-right"><div class="activity-earn">+${it.earn || 0} ج.م</div><div class="activity-date">${d}</div></div></div>`;
    }).join('');
  }

  /* ── Award points & update wallet on trip completion ── */
  async function recordCompletion(type, referenceId, fare) {
    if (!driver) return;
    const rate         = type === 'airport' ? RATES.airport : type === 'delivery' ? RATES.delivery : RATES.ride;
    const commission   = Math.round(fare * rate);
    const driverEarn   = fare - commission;
    const pointsEarned = type === 'airport' ? 50 : type === 'delivery' ? 20 : 10;
    const phone = driver.phone;
    const now   = new Date().toISOString();
    const txId  = `wtx-${Date.now()}`;
    const ptId  = `ptx-${Date.now()}`;
    const typeLabel = type === 'delivery' ? 'توصيل' : type === 'airport' ? 'مطار' : 'رحلة';

    await Promise.allSettled([
      // Accumulate driver wallet balance via RPC (prevents overwrite)
      fetch(`${SB_URL}/rest/v1/rpc/add_wallet_balance`, {
        method: 'POST',
        headers: { ...SB_H },
        body: JSON.stringify({ p_phone: phone, p_amount: driverEarn }),
      }),
      // Driver earning transaction
      fetch(`${SB_URL}/rest/v1/rpc/log_wallet_transaction`, {
        method: 'POST',
        headers: { ...SB_H, 'Content-Type': 'application/json' },
        body: JSON.stringify({ p_id: txId, p_phone: phone, p_amount: driverEarn, p_type: 'earning', p_reference_id: referenceId, p_note: `أرباح ${typeLabel} — بعد خصم العمولة ${Math.round(rate*100)}%` }),
      }),
      // Platform commission transaction
      fetch(`${SB_URL}/rest/v1/rpc/log_wallet_transaction`, {
        method: 'POST',
        headers: { ...SB_H, 'Content-Type': 'application/json' },
        body: JSON.stringify({ p_id: `pcom-${Date.now()}-${Math.random().toString(36).slice(2,6)}`, p_phone: 'platform', p_amount: commission, p_type: 'commission', p_reference_id: referenceId, p_note: `عمولة ${typeLabel} — ${Math.round(rate*100)}% من ${fare} ج.م` }),
      }),
      // Points transaction
      fetch(`${SB_URL}/rest/v1/point_transactions`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=minimal' },
        body: JSON.stringify({ id: ptId, phone, points: pointsEarned, type, reference_id: referenceId, created_at: now }),
      }),
      // Accumulate points total via RPC (prevents overwrite)
      fetch(`${SB_URL}/rest/v1/rpc/add_points`, {
        method: 'POST',
        headers: { ...SB_H },
        body: JSON.stringify({ p_phone: phone, p_amount: pointsEarned }),
      }),
    ]);
  }

  /* ── Go online (shared by auto-activate and toggle) ── */
  async function goOnline() {
    isOnline = true;
    const btn   = document.getElementById('toggle-btn');
    const label = document.getElementById('toggle-label');
    const text  = document.getElementById('toggle-text');
    btn.classList.replace('offline', 'online');
    text.textContent  = 'تشغيل';
    label.textContent = 'متصل الآن';
    label.className   = 'toggle-label online-text';
    showState('waiting');

    if (navigator.geolocation) {
      geoWatchId = navigator.geolocation.watchPosition(
        pos => { driverLat = pos.coords.latitude; driverLng = pos.coords.longitude; updateDriverMarker(); },
        () => {}, { enableHighAccuracy: true, maximumAge: 3000 }
      );
    }
    await upsertLocation(true);
    await ensureNotifyPermission();
    subscribeWebPush();

    function startRealtime() {
      if (!_sb) return;
      ridesChannel = _sb.channel('driver-new-rides')
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'rides' }, payload => {
          const ride = payload.new;
          if (ride.status === 'pending' && !ride.driver_phone && isOnline && !currentRide && !currentOrder) {
            const reqEl = document.getElementById('ride-request');
            if (!reqEl.classList.contains('visible') || pendingRide?.id !== ride.id) showRideRequest(ride);
          }
        })
        .subscribe(status => {
          if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
            if (!pollInterval) pollInterval = setInterval(() => { pollRides(); pollOrders(); }, 4000);
          }
          if (status === 'SUBSCRIBED') { clearInterval(pollInterval); pollInterval = null; }
        });
      ordersChannel = _sb.channel('driver-new-orders')
        .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'orders' }, payload => {
          const order = payload.new;
          if (order.status === 'preparing' && !order.driver_phone && isOnline && !currentRide && !currentOrder) {
            const reqEl = document.getElementById('ride-request');
            if (!reqEl.classList.contains('visible') || pendingOrder?.id !== order.id) {
              if (!pendingRide) showOrderRequest(order);
            }
          }
        })
        .subscribe();
    }

    if (_sb) {
      startRealtime();
    } else {
      setTimeout(() => {
        if (_sb) startRealtime();
        else pollInterval = setInterval(() => { pollRides(); pollOrders(); }, 2500);
      }, 1500);
    }

    window._gpsInterval = setInterval(() => upsertLocation(true), 3000);
  }

  /* ── Toggle online/offline ── */
  document.getElementById('toggle-btn').addEventListener('click', async () => {
    if (!driver) return;
    isOnline = !isOnline;

    if (isOnline) {
      await goOnline();
      showToast('أنت الآن متصل — انتظر الطلبات');
    } else {
      btn.classList.replace('online', 'offline');
      text.textContent  = 'إيقاف';
      label.textContent = 'غير متصل';
      label.className   = 'toggle-label offline-text';
      showState('offline');
      if (geoWatchId !== null) { navigator.geolocation.clearWatch(geoWatchId); geoWatchId = null; }
      // إلغاء Realtime channels
      if (ridesChannel)  { ridesChannel.unsubscribe();  ridesChannel  = null; }
      if (ordersChannel) { ordersChannel.unsubscribe(); ordersChannel = null; }
      clearInterval(pollInterval); pollInterval = null;
      clearInterval(window._gpsInterval); window._gpsInterval = null;
      hideRideRequest(); pendingRide = null; pendingOrder = null;
      await upsertLocation(false);
      showToast('تم إيقاف التشغيل');
    }
  });
</script>
