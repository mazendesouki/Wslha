---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
---

<style>
  .dash-page {
    max-width: 520px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-4) var(--sp-20);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  /* Status bar */
  .status-bar {
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--sp-4) var(--sp-5);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    box-shadow: var(--shadow-md);
  }
  .status-bar__info { flex: 1; min-width: 0; }
  .status-bar__label { font-size: 11px; color: var(--color-text-faint); }
  .status-bar__name  { font-weight: var(--weight-black); font-size: var(--text-base); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .status-bar__phone { font-size: var(--text-xs); color: var(--color-text-muted); }

  /* Toggle */
  .toggle-wrap { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .toggle-btn {
    position: relative;
    width: 64px; height: 34px;
    border-radius: 999px;
    border: none; cursor: pointer;
    display: flex; align-items: center;
    transition: background 0.3s;
    padding: 0 4px;
  }
  .toggle-btn.offline { background: #d1d5db; justify-content: flex-start; }
  .toggle-btn.online  { background: #16a34a; justify-content: flex-end; }
  .toggle-btn__knob {
    width: 26px; height: 26px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,.3);
    flex-shrink: 0;
  }
  .toggle-label { font-size: 11px; font-weight: var(--weight-bold); white-space: nowrap; }
  .toggle-label.online-text  { color: #16a34a; }
  .toggle-label.offline-text { color: #6b7280; }

  /* Stats */
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3);
  }
  .stat-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--sp-4) var(--sp-3);
    text-align: center;
    box-shadow: var(--shadow-md);
  }
  .stat-card__val  { font-size: var(--text-2xl); font-weight: var(--weight-black); color: var(--color-primary); line-height: 1; }
  .stat-card__key  { font-size: 11px; color: var(--color-text-faint); margin-top: var(--sp-1); }

  /* Offline state */
  #state-offline {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--sp-10) var(--sp-6);
    text-align: center;
    box-shadow: var(--shadow-md);
  }
  #state-offline.hidden { display: none; }
  .offline-icon  { font-size: 3.5rem; margin-bottom: var(--sp-4); }
  .offline-title { font-size: var(--text-xl); font-weight: var(--weight-black); margin-bottom: var(--sp-2); }
  .offline-sub   { color: var(--color-text-faint); font-size: var(--text-sm); }

  /* Waiting state */
  #state-waiting {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--sp-10) var(--sp-6);
    text-align: center;
    box-shadow: var(--shadow-md);
    display: none;
  }
  #state-waiting.visible { display: block; }
  .radar-wrap {
    position: relative; width: 140px; height: 140px;
    margin: 0 auto var(--sp-6);
    display: flex; align-items: center; justify-content: center;
  }
  .radar-ring {
    position: absolute;
    border-radius: 50%;
    border: 2px solid var(--color-primary);
    opacity: 0;
    animation: radar-pulse 2.4s ease-out infinite;
  }
  .radar-ring:nth-child(1) { width: 140px; height: 140px; animation-delay: 0s; }
  .radar-ring:nth-child(2) { width: 100px; height: 100px; animation-delay: 0.6s; }
  .radar-ring:nth-child(3) { width:  60px; height:  60px; animation-delay: 1.2s; }
  @keyframes radar-pulse {
    0%   { opacity: 0.8; transform: scale(0.6); }
    100% { opacity: 0;   transform: scale(1); }
  }
  .radar-center {
    position: relative; z-index: 2;
    width: 52px; height: 52px;
    background: var(--color-primary);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem;
    box-shadow: 0 0 0 6px var(--color-primary-light);
  }
  .waiting-title { font-size: var(--text-lg); font-weight: var(--weight-black); margin-bottom: var(--sp-2); }
  .waiting-sub   { color: var(--color-text-faint); font-size: var(--text-sm); }

  /* Active trip */
  #state-active { display: none; flex-direction: column; gap: var(--sp-4); }
  #state-active.visible { display: flex; }

  .customer-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--sp-5);
    box-shadow: var(--shadow-md);
  }
  .customer-card__header {
    display: flex; align-items: center; gap: var(--sp-3);
    margin-bottom: var(--sp-4); padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--color-border);
  }
  .customer-avatar {
    width: 50px; height: 50px; border-radius: 50%;
    background: var(--color-primary-light);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; flex-shrink: 0;
  }
  .customer-name   { font-weight: var(--weight-black); font-size: var(--text-base); }
  .customer-status { font-size: var(--text-xs); color: var(--color-text-faint); }
  .call-btn {
    margin-right: auto;
    display: flex; align-items: center; gap: var(--sp-2);
    background: #dcfce7; color: #16a34a;
    border-radius: var(--radius-lg);
    padding: var(--sp-2) var(--sp-4);
    font-size: var(--text-sm); font-weight: var(--weight-bold);
    text-decoration: none; transition: background 0.2s;
  }
  .call-btn:hover { background: #bbf7d0; }

  .trip-route { display: flex; flex-direction: column; gap: var(--sp-2); margin-bottom: var(--sp-4); }
  .trip-route-row { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--text-sm); }
  .trip-route-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .trip-route-dot.from { background: #0E4B49; }
  .trip-route-dot.to   { background: #ef4444; }
  .fare-badge {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    background: #dcfce7; color: #16a34a;
    border-radius: var(--radius-lg);
    padding: var(--sp-2) var(--sp-4);
    font-weight: var(--weight-black); font-size: var(--text-base);
  }

  .trip-map-card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-md);
  }
  .trip-map-header {
    padding: var(--sp-3) var(--sp-4); border-bottom: 1px solid var(--color-border);
    font-weight: var(--weight-black); font-size: var(--text-sm);
    display: flex; align-items: center; gap: var(--sp-2);
  }
  #driver-map { width: 100%; height: 280px; }

  .driver-map-stats {
    display: grid; grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-border);
  }
  .driver-map-stat {
    padding: var(--sp-3); text-align: center;
    border-left: 1px solid var(--color-border);
  }
  .driver-map-stat:last-child { border-left: none; }
  .driver-map-stat__val { font-size: var(--text-base); font-weight: var(--weight-black); color: var(--color-primary); }
  .driver-map-stat__lbl { font-size: 10px; color: var(--color-text-faint); margin-top: 2px; }

  .nav-to-btn {
    width: 100%; padding: var(--sp-3); border: none; border-top: 1px solid var(--color-border);
    background: var(--color-primary); color: #fff; font-family: var(--font-body);
    font-weight: var(--weight-black); font-size: var(--text-sm); cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
    transition: background 0.2s;
  }
  .nav-to-btn:hover { background: var(--color-primary-dark); }

  .action-card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); padding: var(--sp-5); box-shadow: var(--shadow-md);
  }
  .action-card__title { font-weight: var(--weight-black); font-size: var(--text-sm); margin-bottom: var(--sp-4); color: var(--color-text-faint); }
  .action-btn {
    width: 100%; padding: var(--sp-4); border-radius: var(--radius-lg);
    border: none; cursor: pointer;
    font-family: var(--font-body); font-size: var(--text-base); font-weight: var(--weight-black);
    transition: all 0.2s; margin-bottom: var(--sp-3);
    display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
  }
  .action-btn:last-child { margin-bottom: 0; }
  .action-btn.arrive  { background: #E3EDEC; color: #082F2E; border: 1.5px solid #C9DEDC; }
  .action-btn.arrive:hover  { background: #bfdbfe; transform: translateY(-1px); }
  .action-btn.pickup  { background: var(--color-primary); color: #fff; }
  .action-btn.pickup:hover  { background: #082F2E; transform: translateY(-1px); }
  .action-btn.complete { background: #16a34a; color: #fff; }
  .action-btn.complete:hover { background: #15803d; transform: translateY(-1px); }
  .action-btn:disabled { background: #f3f4f6; color: #9ca3af; cursor: not-allowed; transform: none !important; }

  /* Ride request notification */
  #ride-request {
    position: fixed; bottom: -100%; left: 0; right: 0; z-index: 500; padding: var(--sp-4);
    transition: bottom 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  #ride-request.visible { bottom: 0; }
  .ride-req-card {
    background: #fff; border-radius: var(--radius-xl);
    box-shadow: 0 -4px 40px rgba(0,0,0,.25), 0 0 0 1px rgba(0,0,0,.06);
    overflow: hidden; max-width: 480px; margin: 0 auto;
  }
  .ride-req-header {
    background: linear-gradient(135deg, #082F2E, #0E4B49);
    padding: var(--sp-4) var(--sp-5);
    display: flex; align-items: center; gap: var(--sp-3); color: #fff;
  }
  .bell-icon { font-size: 2rem; animation: bell-shake 0.5s ease-in-out infinite alternate; }
  @keyframes bell-shake {
    0%   { transform: rotate(-15deg); }
    100% { transform: rotate(15deg); }
  }
  .ride-req-header__title { font-size: var(--text-lg); font-weight: var(--weight-black); }
  .ride-req-header__sub   { font-size: var(--text-xs); opacity: 0.85; }
  .ride-req-timer {
    margin-right: auto; width: 48px; height: 48px; border-radius: 50%;
    border: 3px solid rgba(255,255,255,.4);
    display: flex; align-items: center; justify-content: center;
    font-size: var(--text-lg); font-weight: var(--weight-black);
    background: rgba(255,255,255,.15);
  }
  .ride-req-body { padding: var(--sp-5); }
  .route-display {
    display: flex; flex-direction: column; gap: var(--sp-2);
    background: #f8fafc; border-radius: var(--radius-lg); padding: var(--sp-4); margin-bottom: var(--sp-4);
  }
  .route-point { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--text-sm); }
  .route-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .route-dot.from { background: #0E4B49; }
  .route-dot.to   { background: #ef4444; }
  .ride-meta { display: flex; gap: var(--sp-3); margin-bottom: var(--sp-5); }
  .ride-meta__item {
    flex: 1; background: var(--color-primary-light);
    border-radius: var(--radius-lg); padding: var(--sp-3); text-align: center;
  }
  .ride-meta__val { font-size: var(--text-base); font-weight: var(--weight-black); color: var(--color-primary); }
  .ride-meta__key { font-size: 10px; color: var(--color-text-faint); }
  .ride-meta__item.fare { background: #dcfce7; }
  .ride-meta__item.fare .ride-meta__val { color: #16a34a; }
  .req-btns { display: flex; gap: var(--sp-3); align-items: center; }
  .accept-btn {
    flex: 1; padding: var(--sp-4); background: #16a34a; color: #fff;
    border: none; border-radius: var(--radius-lg);
    font-family: var(--font-body); font-size: var(--text-base); font-weight: var(--weight-black);
    cursor: pointer; transition: all 0.2s;
  }
  .accept-btn:hover { background: #15803d; transform: translateY(-1px); }
  .reject-btn {
    padding: var(--sp-3) var(--sp-4); background: #f3f4f6; color: #6b7280;
    border: 1.5px solid #d1d5db; border-radius: var(--radius-lg);
    font-family: var(--font-body); font-size: var(--text-sm); font-weight: var(--weight-bold);
    cursor: pointer; transition: all 0.2s; white-space: nowrap;
  }
  .reject-btn:hover { background: #fee2e2; color: #dc2626; border-color: #fca5a5; }

  /* Waiting timer banner */
  .waiting-banner {
    display: none; align-items: center; justify-content: center; gap: var(--sp-3);
    background: #dc2626; color: #fff;
    padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-lg);
    font-size: var(--text-sm); font-weight: var(--weight-bold);
    margin-bottom: var(--sp-3); text-align: center;
    animation: pulse-banner 2s ease-in-out infinite;
  }
  .waiting-banner.visible { display: flex; }
  @keyframes pulse-banner { 0%,100% { background: #dc2626; } 50% { background: #b91c1c; } }
  .waiting-banner__timer { font-size: var(--text-lg); font-weight: 900; min-width: 40px; text-align: center; }

  /* Completion receipt modal */
  .receipt-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.55);
    z-index: 700; display: none; align-items: flex-end; justify-content: center; padding: var(--sp-4);
  }
  .receipt-overlay.visible { display: flex; }
  .receipt-card {
    background: #fff; border-radius: 20px 20px 16px 16px;
    width: 100%; max-width: 480px; overflow: hidden;
    box-shadow: 0 -8px 40px rgba(0,0,0,.3);
    animation: slide-up-receipt .35s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes slide-up-receipt { from { transform: translateY(100%); opacity:0; } to { transform: translateY(0); opacity:1; } }
  .receipt-header { background: #16a34a; color: #fff; text-align: center; padding: var(--sp-5) var(--sp-5) var(--sp-4); }
  .receipt-header__icon { font-size: 2.5rem; margin-bottom: var(--sp-2); }
  .receipt-header__title { font-size: var(--text-xl); font-weight: 900; }
  .receipt-header__sub { font-size: var(--text-xs); opacity: .85; margin-top: 4px; }
  .receipt-body { padding: var(--sp-5); }
  .receipt-customer { display: flex; align-items: center; gap: var(--sp-3); background: #f8fafc; border-radius: var(--radius-lg); padding: var(--sp-4); margin-bottom: var(--sp-4); }
  .receipt-avatar { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg,#0E4B49,#082F2E); color:#fff; font-size:1.1rem; font-weight:900; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .receipt-customer__name { font-weight: var(--weight-black); font-size: var(--text-base); }
  .receipt-route { display: flex; flex-direction: column; gap: var(--sp-2); background: #f8fafc; border-radius: var(--radius-lg); padding: var(--sp-4); margin-bottom: var(--sp-4); }
  .receipt-route-row { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--text-sm); }
  .receipt-route-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .receipt-route-dot.from { background: #0E4B49; }
  .receipt-route-dot.to   { background: #ef4444; }
  .receipt-fare-box { background: #f0fdf4; border: 1.5px solid #86efac; border-radius: var(--radius-lg); padding: var(--sp-4); margin-bottom: var(--sp-4); }
  .receipt-fare-row { display: flex; justify-content: space-between; align-items: center; font-size: var(--text-sm); color: var(--color-text-muted); padding: var(--sp-1) 0; }
  .receipt-fare-row.total { border-top: 1.5px solid #86efac; margin-top: var(--sp-2); padding-top: var(--sp-3); font-size: var(--text-base); font-weight: 900; color: #15803d; }
  .receipt-collect-btn { width: 100%; padding: var(--sp-4); background: #082F2E; color: #fff; border: none; border-radius: var(--radius-lg); font-family: var(--font-body); font-size: var(--text-base); font-weight: 900; cursor: pointer; transition: background .2s; }
  .receipt-collect-btn:hover { background: #0E4B49; }

  /* Toast */
  .toast {
    position: fixed; top: 80px; left: 50%;
    transform: translateX(-50%) translateY(-20px);
    background: #1f2937; color: #fff;
    padding: var(--sp-3) var(--sp-5); border-radius: var(--radius-lg);
    font-size: var(--text-sm); font-weight: var(--weight-bold);
    z-index: 600; opacity: 0; transition: all 0.3s ease; white-space: nowrap;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  /* Auth prompt */
  .auth-prompt {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); padding: var(--sp-10) var(--sp-6);
    text-align: center; box-shadow: var(--shadow-md);
  }
  .auth-prompt__icon  { font-size: 3rem; margin-bottom: var(--sp-4); }
  .auth-prompt__title { font-size: var(--text-xl); font-weight: var(--weight-black); margin-bottom: var(--sp-3); }
  .auth-prompt__desc  { color: var(--color-text-muted); font-size: var(--text-sm); margin-bottom: var(--sp-6); }

  /* ── Dashboard Tabs ── */
  .dash-tabs {
    display: flex; gap: 0; border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--sp-4); overflow-x: auto; scrollbar-width: none;
  }
  .dash-tabs::-webkit-scrollbar { display: none; }
  .dash-tab {
    padding: var(--sp-3) var(--sp-5); background: none; border: none;
    font-family: var(--font-body); font-weight: var(--weight-bold);
    font-size: var(--text-sm); cursor: pointer; color: var(--color-text-faint);
    border-bottom: 3px solid transparent; margin-bottom: -2px; white-space: nowrap;
    transition: all 0.2s;
  }
  .dash-tab.active { color: var(--color-primary); border-bottom-color: var(--color-primary); }
  .tab-pane { display: none; flex-direction: column; gap: var(--sp-4); }
  .tab-pane.active { display: flex; }

  /* ── Approval banner ── */
  .approval-banner {
    border-radius: var(--radius-xl); padding: var(--sp-4) var(--sp-5);
    display: flex; align-items: flex-start; gap: var(--sp-3);
    box-shadow: var(--shadow-md);
  }
  .approval-banner.pending  { background: #FEF9C3; border: 1.5px solid #FDE047; }
  .approval-banner.approved { background: #DCFCE7; border: 1.5px solid #86EFAC; }
  .approval-banner.rejected { background: #FEE2E2; border: 1.5px solid #FCA5A5; }
  .approval-banner__icon  { font-size: 1.8rem; flex-shrink: 0; }
  .approval-banner__title { font-weight: var(--weight-black); font-size: var(--text-sm); margin-bottom: 2px; }
  .approval-banner.pending  .approval-banner__title { color: #92400E; }
  .approval-banner.approved .approval-banner__title { color: #14532D; }
  .approval-banner.rejected .approval-banner__title { color: #991B1B; }
  .approval-banner__sub   { font-size: var(--text-xs); color: var(--color-text-muted); line-height: 1.5; }

  /* ── Wallet & Points cards ── */
  .acct-card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); padding: var(--sp-5); box-shadow: var(--shadow-md);
  }
  .acct-card__header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--sp-4); padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--color-border);
  }
  .acct-card__title { font-weight: var(--weight-black); font-size: var(--text-base); display: flex; align-items: center; gap: var(--sp-2); }
  .acct-card__big   { font-size: var(--text-3xl); font-weight: var(--weight-black); color: var(--color-primary); }
  .acct-card__unit  { font-size: var(--text-sm); color: var(--color-text-muted); }
  .acct-tx-list     { display: flex; flex-direction: column; gap: var(--sp-2); }
  .acct-tx {
    display: flex; align-items: center; justify-content: space-between;
    font-size: var(--text-xs); padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .acct-tx:last-child { border-bottom: none; }
  .acct-tx__note  { color: var(--color-text-muted); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .acct-tx__date  { color: var(--color-text-faint); font-size: 10px; margin: 0 var(--sp-2); flex-shrink: 0; }
  .acct-tx__amt   { font-weight: var(--weight-bold); flex-shrink: 0; }
  .acct-tx__amt.pos { color: #16a34a; }
  .acct-tx__amt.neg { color: #dc2626; }
  .acct-empty { text-align: center; color: var(--color-text-faint); font-size: var(--text-xs); padding: var(--sp-4); }

  /* ── Ratings ── */
  .rating-summary {
    display: flex; align-items: center; gap: var(--sp-5);
    margin-bottom: var(--sp-4); padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--color-border);
  }
  .rating-big { font-size: var(--text-4xl); font-weight: var(--weight-black); color: var(--color-primary); line-height: 1; }
  .rating-stars { font-size: var(--text-lg); }
  .rating-count { font-size: var(--text-xs); color: var(--color-text-faint); }
  .rating-item {
    display: flex; flex-direction: column; gap: 2px;
    padding: var(--sp-3) 0; border-bottom: 1px solid var(--color-border);
  }
  .rating-item:last-child { border-bottom: none; }
  .rating-item__top { display: flex; align-items: center; justify-content: space-between; }
  .rating-item__stars { font-size: var(--text-sm); }
  .rating-item__date  { font-size: 10px; color: var(--color-text-faint); }
  .rating-item__comment { font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 2px; }
  .rating-item__reply { margin-top:6px; padding:6px 10px; background:#E3EDEC; border-radius:8px; font-size:var(--text-xs); color:#0E4B49; border-right:3px solid #0E4B49; }
  .rating-item__reply-label { font-size:10px; color:#64748b; margin-bottom:2px; }
  .rating-reply-form { margin-top:6px; display:flex; gap:6px; }
  .rating-reply-input { flex:1; padding:6px 10px; border:1.5px solid var(--color-border); border-radius:8px; font-size:var(--text-xs); resize:none; direction:rtl; font-family:var(--font-body); background:var(--color-bg); color:var(--color-text); }
  .rating-reply-send { padding:6px 14px; background:var(--color-primary); color:#fff; border:none; border-radius:8px; font-size:var(--text-xs); cursor:pointer; }

  /* ── Activity log ── */
  .activity-item {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: var(--sp-4);
    display: flex; align-items: center; gap: var(--sp-3);
    box-shadow: var(--shadow-sm);
  }
  .activity-icon { font-size: 1.6rem; flex-shrink: 0; }
  .activity-info { flex: 1; min-width: 0; }
  .activity-title { font-weight: var(--weight-bold); font-size: var(--text-sm); }
  .activity-sub   { font-size: var(--text-xs); color: var(--color-text-muted); }
  .activity-right { text-align: left; flex-shrink: 0; }
