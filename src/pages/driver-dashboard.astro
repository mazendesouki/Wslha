<script>
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' };

  // Commission rates (loaded from app_settings, defaults to 15%)
  const RATES = { ride: 0.15, delivery: 0.15, airport: 0.15 };

  async function loadCommissionRates() {
    try {
      const res = await fetch(`${SB_URL}/rest/v1/app_settings?key=in.(commission_ride,commission_delivery,commission_airport)&select=key,value`, { headers: SB_H });
      const rows = await res.json();
      if (Array.isArray(rows)) {
        rows.forEach(r => {
          const val = parseFloat(r.value) / 100;
          if (!isNaN(val) && val >= 0 && val < 1) {
            if (r.key === 'commission_ride')     RATES.ride     = val;
            if (r.key === 'commission_delivery') RATES.delivery = val;
            if (r.key === 'commission_airport')  RATES.airport  = val;
          }
        });
      }
    } catch {}
  }
  loadCommissionRates();

  // Supabase Realtime client
  let _sb = null;
  try {
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js';
    script.onload = () => {
      _sb = window.supabase.createClient(SB_URL, SB_KEY);
    };
    document.head.appendChild(script);
  } catch {}

  /* ── Auth guard ── */
  let driver = null;
  try { const raw = localStorage.getItem('wslha_user'); driver = raw ? JSON.parse(raw) : null; } catch {}

  const authPrompt = document.getElementById('auth-prompt');
  const mainDash   = document.getElementById('main-dash');

  if (!driver || driver.role !== 'driver') {
    authPrompt.style.display = 'block';
  } else {
    mainDash.style.display = 'flex';
    document.getElementById('driver-name-bar').textContent  = driver.name  || driver.phone;
    document.getElementById('driver-phone-bar').textContent = driver.phone || '';
    // Load approval status and initial account data
    loadApprovalStatus();
    loadTodayStats();
  }

  /* ── Stats ── */
  let todayStats = { trips: 0, earn: 0 };
  try {
    const key = 'wslha_driver_stats_' + (driver?.phone || '') + '_' + new Date().toDateString();
    todayStats = JSON.parse(localStorage.getItem(key) || '{"trips":0,"earn":0}');
  } catch {}
  function renderStats() {
    document.getElementById('stat-trips').textContent = String(todayStats.trips);
    document.getElementById('stat-earn').textContent  = String(todayStats.earn);
  }
  renderStats();

  /* ── State ── */
  let isOnline      = false;
  let currentRide   = null;
  let pendingRide   = null;
  let currentOrder  = null;   // active delivery order
  let pendingOrder  = null;   // delivery offer awaiting accept
  let pollInterval  = null;   // fallback REST poll (30s)
  let ridesChannel  = null;   // Realtime channel for new rides
  let ordersChannel = null;   // Realtime channel for new orders
  let geoWatchId    = null;
  let timerInterval = null;
  let waitingTimerInterval = null;
  let waitingStartTime = null;
  let driverLat = null;
  let driverLng = null;
  let map = null, driverMarker = null, fromMarkerRef = null, toMarkerRef = null, routeLine = null;

  /* ── Toast ── */
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2800);
  }

  /* ── Waiting timer ── */
  function startWaitingTimer() {
    stopWaitingTimer();
    waitingStartTime = Date.now();
    const banner = document.getElementById('waiting-banner');
    const timerEl = document.getElementById('waiting-timer-text');
    banner.classList.add('visible');
    function tick() {
      const elapsed = Math.floor((Date.now() - waitingStartTime) / 1000);
      const mins = Math.floor(elapsed / 60), secs = elapsed % 60;
      timerEl.textContent = `${mins}:${String(secs).padStart(2, '0')}`;
    }
    tick();
    waitingTimerInterval = setInterval(tick, 1000);
  }
  function stopWaitingTimer() {
    if (waitingTimerInterval) { clearInterval(waitingTimerInterval); waitingTimerInterval = null; }
    const banner = document.getElementById('waiting-banner');
    if (banner) banner.classList.remove('visible');
    waitingStartTime = null;
  }

  /* ── Completion receipt modal ── */
  function showReceiptModal(ride) {
    const rate = ride?.ride_type === 'airport' ? RATES.airport : RATES.ride;
    const fare = Number(ride?.fare || 0);
    const commission = Math.round(fare * rate);
    const net = fare - commission;
    const name = ride?.customer_name || '—';
    const now = new Date().toLocaleDateString('ar-EG', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' });
    document.getElementById('receipt-avatar').textContent = name.trim().slice(0, 2) || '؟';
    document.getElementById('receipt-customer-name').textContent = name;
    document.getElementById('receipt-date').textContent = now;
    document.getElementById('receipt-from').textContent = ride?.from_area || '—';
    document.getElementById('receipt-to').textContent = ride?.to_area || '—';
    document.getElementById('receipt-gross').textContent = fare + ' ج.م';
    document.getElementById('receipt-commission').textContent = '− ' + commission + ' ج.م';
    document.getElementById('receipt-net').textContent = net + ' ج.م';
    document.getElementById('receipt-collect-amount').textContent = net;
    document.getElementById('receipt-overlay').classList.add('visible');
  }
  function hideReceiptModal() {
    document.getElementById('receipt-overlay').classList.remove('visible');
  }
  document.getElementById('receipt-collect-btn').addEventListener('click', () => {
    hideReceiptModal(); showState('waiting');
  });
  document.getElementById('receipt-overlay').addEventListener('click', (e) => {
    if (e.target === document.getElementById('receipt-overlay')) hideReceiptModal();
  });

  /* ── Google Maps helpers ── */
  const GMAPS_KEY = 'AIzaSyAKvFfBYNDcTZgvZZH5s_lQbOc24LNjLsY';
  let _dirRenderer = null;
  let _gpsCount = 0;

  function loadGoogleMaps() {
    return new Promise((resolve) => {
      if (window.google?.maps) { resolve(); return; }
      window.__gmInit = resolve;
      const s = document.createElement('script');
      s.src = `https://maps.googleapis.com/maps/api/js?key=${GMAPS_KEY}&callback=__gmInit&language=ar`;
      s.async = true;
      document.head.appendChild(s);
    });
  }

  let destLat = null;
  let destLng = null;

  async function initDriverMap(fromLat, fromLng, toLat, toLng) {
    try { await loadGoogleMaps(); } catch { return; }
    destLat = toLat; destLng = toLng;
    const mapEl = document.getElementById('driver-map');
    if (!mapEl) return;
    const G = window.google.maps;

    if (map) {
      if (fromMarkerRef) fromMarkerRef.setMap(null);
      if (toMarkerRef)   toMarkerRef.setMap(null);
      fromMarkerRef = new G.Marker({ position: { lat: fromLat, lng: fromLng }, map, title: 'نقطة الاستلام',
        icon: { path: G.SymbolPath.CIRCLE, fillColor: '#0E4B49', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 3, scale: 10 } });
      toMarkerRef = new G.Marker({ position: { lat: toLat, lng: toLng }, map, title: 'الوجهة',
        icon: { path: G.SymbolPath.CIRCLE, fillColor: '#ef4444', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 3, scale: 10 } });
      await drawDriverRoute();
      return;
    }

    map = new G.Map(mapEl, {
      center: { lat: fromLat, lng: fromLng }, zoom: 13,
      mapTypeControl: false, fullscreenControl: false, streetViewControl: false,
    });

    fromMarkerRef = new G.Marker({ position: { lat: fromLat, lng: fromLng }, map, title: 'نقطة الاستلام',
      icon: { path: G.SymbolPath.CIRCLE, fillColor: '#0E4B49', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 3, scale: 10 } });
    toMarkerRef = new G.Marker({ position: { lat: toLat, lng: toLng }, map, title: 'الوجهة',
      icon: { path: G.SymbolPath.CIRCLE, fillColor: '#ef4444', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 3, scale: 10 } });

    if (driverLat && driverLng) {
      driverMarker = new G.Marker({ position: { lat: driverLat, lng: driverLng }, map, title: 'موقعك', zIndex: 999,
        icon: { path: G.SymbolPath.FORWARD_CLOSED_ARROW, fillColor: '#16a34a', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 2, scale: 7 } });
    }

    await drawDriverRoute();

    const bounds = new G.LatLngBounds();
    bounds.extend({ lat: fromLat, lng: fromLng });
    bounds.extend({ lat: toLat, lng: toLng });
    if (driverLat && driverLng) bounds.extend({ lat: driverLat, lng: driverLng });
    map.fitBounds(bounds);
  }

  async function drawDriverRoute() {
    if (!map || !destLat || !destLng) return;
    const G = window.google.maps;
    const oLat = driverLat ?? destLat;
    const oLng = driverLng ?? destLng;

    if (!_dirRenderer) {
      _dirRenderer = new G.DirectionsRenderer({
        map, suppressMarkers: true,
        polylineOptions: { strokeColor: '#16a34a', strokeWeight: 5, strokeOpacity: 0.85 },
      });
    }
    try {
      const result = await new Promise((res, rej) =>
        new G.DirectionsService().route({
          origin: { lat: oLat, lng: oLng },
          destination: { lat: destLat, lng: destLng },
          travelMode: G.TravelMode.DRIVING,
        }, (r, s) => s === 'OK' ? res(r) : rej(s))
      );
      _dirRenderer.setDirections(result);
      const leg = result.routes[0].legs[0];
      const distEl = document.getElementById('driver-stat-dist');
      const durEl  = document.getElementById('driver-stat-dur');
      if (distEl) distEl.textContent = (leg.distance.value / 1000).toFixed(1) + ' كم';
      if (durEl)  durEl.textContent  = Math.ceil(leg.duration.value / 60) + ' دق';
    } catch {}
  }

  function updateDriverMarker() {
    if (!driverLat || !driverLng || !map) return;
    const G = window.google.maps;
    if (driverMarker) {
      driverMarker.setPosition({ lat: driverLat, lng: driverLng });
    } else {
      driverMarker = new G.Marker({ position: { lat: driverLat, lng: driverLng }, map, title: 'موقعك', zIndex: 999,
        icon: { path: G.SymbolPath.FORWARD_CLOSED_ARROW, fillColor: '#16a34a', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 2, scale: 7 } });
    }
    // Redraw route every ~30s (every 10th GPS tick)
    _gpsCount++;
    if (_gpsCount === 1 || _gpsCount % 10 === 0) drawDriverRoute();
  }

  /* ── UI state ── */
  function showState(name) {
    document.getElementById('state-offline').classList.toggle('hidden', name !== 'offline');
    document.getElementById('state-waiting').classList.toggle('visible', name === 'waiting');
    document.getElementById('state-active').classList.toggle('visible',  name === 'active');
  }

  /* ── Notification helpers ── */
  function playAlert() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      [[880,0],[660,0.18],[880,0.36]].forEach(([freq,t]) => {
        const o = ctx.createOscillator(), g = ctx.createGain();
        o.connect(g); g.connect(ctx.destination);
        o.type = 'sine'; o.frequency.value = freq;
        g.gain.setValueAtTime(0.5, ctx.currentTime + t);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + t + 0.17);
        o.start(ctx.currentTime + t); o.stop(ctx.currentTime + t + 0.18);
      });
    } catch {}
    if (navigator.vibrate) navigator.vibrate([150, 80, 150, 80, 300]);
  }

  function pushNotify(title, body) {
    if (typeof Notification === 'undefined' || Notification.permission !== 'granted') return;
    try {
      const n = new Notification(title, { body, icon: '/favicon.ico', tag: 'wslha-req', requireInteraction: true });
      n.onclick = () => { window.focus(); n.close(); };
    } catch {}
  }

  async function ensureNotifyPermission() {
    if (typeof Notification !== 'undefined' && Notification.permission === 'default') {
      await Notification.requestPermission();
    }
  }

  /* ── Web Push حقيقي: يوصل للسائق حتى والتطبيق مقفول ── */
  const VAPID_PUBLIC_KEY = 'BAff2dem6ctMexZ88fk51q9YJKanqGjn1wFa1FHJx67xW_f0-m5nN2kmKSMmiCrN99S808bz3zwJb26b6Omyv3M';

  function urlBase64ToUint8Array(base64) {
    const padding = '='.repeat((4 - (base64.length % 4)) % 4);
    const raw = atob((base64 + padding).replace(/-/g, '+').replace(/_/g, '/'));
    return Uint8Array.from([...raw].map(c => c.charCodeAt(0)));
  }

  async function subscribeWebPush() {
    if (!driver?.phone || !('serviceWorker' in navigator) || !('PushManager' in window)) return;
    if (typeof Notification === 'undefined' || Notification.permission !== 'granted') return;
    try {
      const reg = await navigator.serviceWorker.ready;
      let sub = await reg.pushManager.getSubscription();
      if (!sub) {
        sub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY),
        });
      }
      // upsert على (phone, role) — الاشتراك الأحدث بيحل محل القديم لنفس السائق
      await fetch(`${SB_URL}/rest/v1/push_subscriptions?on_conflict=phone,role`, {
        method: 'POST',
        headers: { ...SB_H, 'Content-Type': 'application/json', Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({
          phone: driver.phone,
          role: 'driver',
          subscription: sub.toJSON(),
          updated_at: new Date().toISOString(),
        }),
      });
    } catch { /* المتصفح رفض أو مفيش دعم — الإشعارات المحلية بالـ polling شغالة كخطة بديلة */ }
  }

  function hideRideRequest() {
    document.getElementById('ride-request').classList.remove('visible');
    if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
  }

  function showRideRequest(ride) {
    playAlert();
    pushNotify('🚗 طلب رحلة جديد!', `${ride.from_area || ''} ← ${ride.to_area || ''} — ${ride.fare || ''} ج.م`);
    pendingRide = ride;
    document.getElementById('req-customer-name').textContent = (ride.customer_name || 'راكب') + ' — راكب جديد';
    document.getElementById('req-from').textContent = ride.from_area;
    document.getElementById('req-to').textContent   = ride.to_area;
    document.getElementById('req-dist').textContent = (ride.distance_km * 1.35).toFixed(1);
    document.getElementById('req-eta').textContent  = ride.eta_minutes;
    document.getElementById('req-fare').textContent = ride.fare;
    document.getElementById('ride-request').classList.add('visible');
    let secs = 30;
    document.getElementById('req-timer').textContent = String(secs);
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      secs--;
      document.getElementById('req-timer').textContent = String(secs);
      if (secs <= 0) { clearInterval(timerInterval); timerInterval = null; hideRideRequest(); pendingRide = null; }
    }, 1000);
  }

  /* ── Delivery-order request (HungerStation-style) ── */
  function showOrderRequest(order) {
    pendingOrder = order;
    const header = document.querySelector('.ride-req-header__title');
    const sub    = document.getElementById('req-customer-name');
    header.textContent = '🛵 طلب توصيل جديد!';
