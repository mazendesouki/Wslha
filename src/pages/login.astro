---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
---

<style>
  .auth-section {
    padding: var(--sp-16) var(--sp-6) var(--sp-20);
    display: flex;
    justify-content: center;
  }

  .auth-card {
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--sp-10);
    width: 100%;
    max-width: 420px;
    box-shadow: var(--shadow-md);
  }

  .auth-card__title { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 800; margin-bottom: var(--sp-2); }
  .auth-card__sub   { font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--sp-8); }

  /* Steps */
  .step { display: none; }
  .step.active { display: block; }

  /* Field */
  .field { margin-bottom: var(--sp-5); }
  .field__label {
    display: block; font-weight: var(--weight-bold);
    font-size: var(--text-sm); margin-bottom: var(--sp-2); color: var(--color-text);
  }
  .field__input {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border); border-radius: var(--radius);
    font-family: var(--font-body); font-size: var(--text-base);
    outline: none; transition: border-color var(--ease);
    direction: rtl; color: var(--color-text); background: var(--color-bg);
  }
  .field__input:focus { border-color: var(--color-primary); }
  .field__input::placeholder { color: var(--color-text-faint); }
  .field__input[type="password"] { direction: ltr; text-align: right; }

  /* Forgot-password link */
  .forgot-link {
    display: block; text-align: left; margin: calc(-1 * var(--sp-2)) 0 var(--sp-5);
    background: none; border: none; padding: 0; cursor: pointer;
    font-family: var(--font-body); font-size: var(--text-sm);
    font-weight: var(--weight-bold); color: var(--color-primary); text-decoration: underline;
  }
  .forgot-link:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }

  /* OTP boxes */
  .otp-group {
    display: flex;
    gap: var(--sp-3);
    justify-content: center;
    margin: var(--sp-6) 0;
    direction: ltr;
  }
  .otp-box {
    width: 52px; height: 60px;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-family: var(--font-body);
    font-size: 1.6rem; font-weight: var(--weight-black);
    text-align: center; color: var(--color-text); background: var(--color-bg);
    outline: none; transition: all var(--ease);
    caret-color: transparent;
  }
  .otp-box:focus { border-color: var(--color-primary); background: var(--color-primary-light); }
  .otp-box.filled { border-color: var(--color-primary); }
  .otp-box.shake  {
    animation: shake .35s ease;
    border-color: #ef4444;
  }
  @keyframes shake {
    0%,100% { transform: translateX(0); }
    20%      { transform: translateX(-6px); }
    60%      { transform: translateX(6px); }
    80%      { transform: translateX(-3px); }
  }

  /* Phone display */
  .phone-badge {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    background: var(--color-primary-light); color: var(--color-primary);
    border-radius: var(--radius-full); padding: var(--sp-1) var(--sp-4);
    font-weight: var(--weight-bold); font-size: var(--text-sm);
    margin-bottom: var(--sp-2);
  }

  /* Dev / on-screen code notice (used only when SMS provider is unavailable) */
  .dev-notice {
    background: var(--color-bg-soft);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-lg); padding: var(--sp-4) var(--sp-5);
    font-size: var(--text-sm); margin-bottom: var(--sp-4);
    display: none; text-align: center;
  }
  .dev-notice.visible { display: block; }
  .dev-notice__label { color: var(--color-accent-dark); margin-bottom: var(--sp-2); font-weight: var(--weight-bold); }
  .dev-notice__code {
    font-weight: var(--weight-black); font-size: 2.2rem; letter-spacing: .25em;
    color: var(--color-primary); display: block; margin-top: var(--sp-1); direction: ltr;
    background: #fff; border-radius: var(--radius); padding: var(--sp-2) var(--sp-4);
    border: 2px dashed var(--color-border); cursor: pointer; transition: background 0.2s;
    user-select: all;
  }
  .dev-notice__code:hover { background: var(--color-primary-light); }
  .dev-notice__code:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .dev-notice__hint { font-size: 11px; color: var(--color-accent-dark); margin-top: var(--sp-1); }

  /* Error */
  .auth-error {
    background: #FEE2E2; color: #B91C1C;
    border-radius: var(--radius); padding: var(--sp-3) var(--sp-4);
    font-size: var(--text-sm); margin-bottom: var(--sp-4); display: none;
  }
  .auth-error.is-visible { display: block; }
  .auth-error a { color: inherit; font-weight: var(--weight-bold); text-decoration: underline; }

  /* Submit */
  .auth-submit {
    width: 100%; padding: var(--sp-4); background: var(--color-primary);
    color: #fff; border: none; border-radius: var(--radius);
    font-family: var(--font-body); font-weight: var(--weight-black);
    font-size: var(--text-base); cursor: pointer;
    transition: background var(--ease), transform var(--ease);
    margin-bottom: var(--sp-4);
  }
  .auth-submit:hover:not(:disabled) { background: var(--color-primary-dark); transform: translateY(-1px); }
  .auth-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .back-btn {
    background: none; border: none; color: var(--color-text-faint);
    font-family: var(--font-body); font-size: var(--text-sm);
    cursor: pointer; display: flex; align-items: center; gap: var(--sp-1);
    margin-bottom: var(--sp-5); padding: 0;
  }
  .back-btn:hover { color: var(--color-text); }
  .back-btn:focus-visible, .otp-box:focus-visible, .auth-submit:focus-visible {
    outline: 3px solid var(--color-accent); outline-offset: 2px;
  }

  /* Divider */
  .auth-divider {
    display: flex; align-items: center; gap: var(--sp-3);
    margin: var(--sp-6) 0; color: var(--color-text-faint); font-size: var(--text-sm);
  }
  .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: var(--color-border); }

  .auth-actions { display: flex; flex-direction: column; gap: var(--sp-3); }
  .auth-actions .btn { width: 100%; justify-content: center; text-align: center; }
  .auth-footer { margin-top: var(--sp-6); text-align: center; font-size: var(--text-sm); color: var(--color-text-muted); }
  .auth-footer a { color: var(--color-primary); font-weight: var(--weight-bold); }

  @media (max-width: 460px) {
    .auth-card { padding: var(--sp-6); }
    .otp-box { width: 44px; height: 52px; font-size: 1.4rem; }
    .otp-group { gap: var(--sp-2); }
  }
</style>

<script>
  import { isEgyptianMobile, normalizeEgyptianPhone, EG_PHONE_ERROR } from '../utils/phone';
  import { validatePassword } from '../utils/password';
  import { verifyLogin, lookupAccount } from '../utils/accounts';
  import { SB_URL, SB_KEY } from '../utils/supabaseClient';

  const SB_H = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' };

  const $ = (id: string) => document.getElementById(id)!;
  function showErr(el: HTMLElement, msg: string) { el.innerHTML = msg; el.classList.add('is-visible'); }
  function hideErr(el: HTMLElement) { el.classList.remove('is-visible'); }

  function dashboardFor(role: string): string {
    if (role === 'admin')    return '/admin';
    if (role === 'driver')   return '/driver-dashboard';
    if (role === 'merchant') return '/merchant-dashboard';
    return '/orders';
  }

  function storeSession(account: any, phone: string) {
    try {
      const prevRaw = localStorage.getItem('wslha_user');
      const prev = prevRaw ? JSON.parse(prevRaw) : null;
      if (prev?.phone && prev.phone !== phone) {
        localStorage.removeItem('wslha_orders_' + prev.phone);
        localStorage.removeItem('wslha_orders');
      }
    } catch {}
    localStorage.setItem('wslha_user', JSON.stringify({
      name: account?.name || '', phone,
      role: account?.role || 'customer', city: account?.city || '',
      loginAt: new Date().toISOString(),
    }));
  }

  /* ─────────────────────────  STEP 1: PASSWORD LOGIN  ───────────────────────── */
  const loginPhone = $('login-phone') as HTMLInputElement;
  const loginPass  = $('login-pass')  as HTMLInputElement;
  const loginBtn   = $('login-btn')   as HTMLButtonElement;
  const errLogin   = $('err-login');

  async function doLogin() {
    hideErr(errLogin);
    const phone = loginPhone.value.trim();
    const pass  = loginPass.value;
    if (!isEgyptianMobile(phone)) { showErr(errLogin, EG_PHONE_ERROR); return; }
    if (!pass) { showErr(errLogin, 'أدخل كلمة المرور.'); return; }

    loginBtn.disabled = true; loginBtn.textContent = 'جاري الدخول...';
    try {
      const res = await verifyLogin(phone, pass);
      if (!res.ok) {
        showErr(errLogin, res.reason === 'not_found'
          ? 'هذا الرقم غير مسجّل. <a href="/register">أنشئ حساباً جديداً</a>.'
          : 'رقم الجوال أو كلمة المرور غير صحيحة.');
        return;
      }
      storeSession(res.account, res.account.phone || normalizeEgyptianPhone(phone));
      loginBtn.textContent = '✅ تم الدخول، جاري التحويل...';
      setTimeout(() => { window.location.href = dashboardFor(res.account.role); }, 500);
    } catch {
      showErr(errLogin, 'حدث خطأ، حاول مرة أخرى.');
    } finally {
      if (!loginBtn.textContent!.startsWith('✅')) { loginBtn.disabled = false; loginBtn.textContent = 'دخول ←'; }
    }
  }
  loginBtn.addEventListener('click', doLogin);
  loginPass.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
  loginPhone.addEventListener('keydown', e => { if (e.key === 'Enter') loginPass.focus(); });

  /* ─────────────────────────  FORGOT PASSWORD  ───────────────────────── */
  const stepLogin = $('step-login');
  const stepFp    = $('step-fp');
  const fpPhone   = $('fp-phone') as HTMLInputElement;
  const fpPass    = $('fp-pass')  as HTMLInputElement;
  const fpPass2   = $('fp-pass2') as HTMLInputElement;
  const fpSendBtn = $('fp-send-btn') as HTMLButtonElement;
  const fpSetBtn  = $('fp-set-btn')  as HTMLButtonElement;
  const errFp     = $('err-fp');
  const fpBadge   = $('fp-badge');
  const fpDev     = $('fp-dev-notice');
  const fpDevCode = $('fp-dev-code');
  const fpOtpBoxes = Array.from(document.querySelectorAll<HTMLInputElement>('.otp-box'));
  const fpSendArea = $('fp-send-area');
  const fpResetArea = $('fp-reset-area');
  let fpCurrentPhone = '';

  $('forgot-link').addEventListener('click', () => {
    stepLogin.classList.remove('active'); stepFp.classList.add('active');
    fpSendArea.style.display = ''; fpResetArea.style.display = 'none';
    hideErr(errFp); fpDev.classList.remove('visible');
    fpPhone.value = loginPhone.value.trim();
    setTimeout(() => fpPhone.focus(), 60);
  });
  $('fp-back-btn').addEventListener('click', () => {
    stepFp.classList.remove('active'); stepLogin.classList.add('active');
  });

  // Account lookup (both phone formats) via the narrow RPC — the anon key
  // can no longer SELECT the accounts table directly.
  async function findAccountPhone(normalized: string): Promise<string | null> {
    const acc = await lookupAccount(normalized);
    return acc?.phone ?? null;
  }

  // Request a recovery code. The SERVER generates the code, stores it, and
  // emails it to the account's registered address — the browser NEVER sees it.
  // This closes the account-takeover hole of showing the code on screen.
  async function sendResetOTP(phone: string): Promise<void> {
    fpDev.classList.remove('visible');
    // NOTE: the deployed edge function slug is "swift-processor" (its code is
    // the request-password-reset logic). Keep this in sync with the function name.
    const r = await fetch(`${SB_URL}/functions/v1/swift-processor`, {
      method: 'POST', headers: SB_H, body: JSON.stringify({ phone }),
    });
    if (!r.ok) {
      const t = await r.text().catch(() => '');
      if (/no_email/.test(t))   throw new Error('no_email');
      if (/not_found/.test(t))  throw new Error('not_found');
      throw new Error('send_failed');
    }
  }

  fpSendBtn.addEventListener('click', async () => {
    hideErr(errFp);
    const phone = fpPhone.value.trim();
    if (!isEgyptianMobile(phone)) { showErr(errFp, EG_PHONE_ERROR); return; }
    fpSendBtn.disabled = true; fpSendBtn.textContent = 'جاري الإرسال...';
    try {
      const normalized = normalizeEgyptianPhone(phone);
      const acc = await findAccountPhone(normalized);
      if (!acc) { showErr(errFp, 'هذا الرقم غير مسجّل في النظام.'); return; }
      fpCurrentPhone = acc;
      await sendResetOTP(acc);
      fpBadge.textContent = acc;
      fpSendArea.style.display = 'none';
      fpResetArea.style.display = '';
      fpOtpBoxes.forEach(b => { b.value = ''; b.classList.remove('filled'); });
      setTimeout(() => fpOtpBoxes[0]?.focus(), 80);
    } catch (e: any) {
      const m = e?.message;
      if (m === 'no_email')      showErr(errFp, 'لا يوجد بريد إلكتروني مسجّل لهذا الحساب. تواصل مع الدعم لإعادة التعيين.');
      else if (m === 'not_found') showErr(errFp, 'هذا الرقم غير مسجّل في النظام.');
      else                        showErr(errFp, 'تعذّر إرسال البريد. حاول لاحقاً أو تواصل مع الدعم.');
    } finally {
      fpSendBtn.disabled = false; fpSendBtn.textContent = 'إرسال رمز التحقق ←';
    }
  });

  // OTP box keyboard handling
  fpOtpBoxes.forEach((box, i) => {
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !box.value && i > 0) { fpOtpBoxes[i - 1].focus(); fpOtpBoxes[i - 1].value = ''; fpOtpBoxes[i - 1].classList.remove('filled'); e.preventDefault(); }
    });
    box.addEventListener('input', () => {
      const v = box.value.replace(/\D/g, '').slice(-1); box.value = v;
      box.classList.toggle('filled', !!v);
      if (v && i < 5) fpOtpBoxes[i + 1].focus();
    });
    box.addEventListener('paste', (e) => {
      e.preventDefault();
      const digits = (e.clipboardData?.getData('text') || '').replace(/\D/g, '').slice(0, 6);
      digits.split('').forEach((d, j) => { if (fpOtpBoxes[j]) { fpOtpBoxes[j].value = d; fpOtpBoxes[j].classList.add('filled'); } });
      fpOtpBoxes[Math.min(digits.length, 5)].focus();
    });
    box.addEventListener('focus', () => box.select());
  });

  fpSetBtn.addEventListener('click', async () => {
    hideErr(errFp);
    const code = fpOtpBoxes.map(b => b.value).join('');
    if (code.length !== 6) { showErr(errFp, 'أدخل رمز التحقق المكوّن من 6 أرقام.'); return; }
    const p1 = fpPass.value, p2 = fpPass2.value;
    const pw = validatePassword(p1);
    if (!pw.valid) { showErr(errFp, pw.message); return; }
    if (p1 !== p2) { showErr(errFp, 'كلمتا المرور غير متطابقتين.'); return; }

    fpSetBtn.disabled = true; fpSetBtn.textContent = 'جاري الحفظ...';
    try {
      const res = await fetch(`${SB_URL}/rest/v1/rpc/reset_password`, {
        method: 'POST', headers: SB_H,
        body: JSON.stringify({ p_phone: fpCurrentPhone, p_code: code, p_new_password: p1 }),
      });
      const ok = res.ok && (await res.json()) === true;
      if (!ok) {
        fpOtpBoxes.forEach(b => { b.classList.remove('shake'); void b.offsetWidth; b.classList.add('shake'); });
        showErr(errFp, 'الرمز غير صحيح أو انتهت صلاحيته.');
        fpSetBtn.disabled = false; fpSetBtn.textContent = 'تعيين كلمة المرور';
        return;
      }
      // Success → back to login, prefilled.
      fpSetBtn.textContent = '✅ تم التغيير';
      loginPhone.value = fpCurrentPhone.startsWith('+20') ? '0' + fpCurrentPhone.slice(3) : fpCurrentPhone;
      setTimeout(() => {
        stepFp.classList.remove('active'); stepLogin.classList.add('active');
        fpSetBtn.disabled = false; fpSetBtn.textContent = 'تعيين كلمة المرور';
        showErr(errLogin, '✅ تم تغيير كلمة المرور. سجّل الدخول الآن.');
        errLogin.style.background = '#DCFCE7'; errLogin.style.color = '#14532D';
        loginPass.focus();
      }, 900);
    } catch {
      showErr(errFp, 'حدث خطأ، حاول مرة أخرى.');
      fpSetBtn.disabled = false; fpSetBtn.textContent = 'تعيين كلمة المرور';
    }
  });
</script>

<Layout title="تسجيل الدخول" description="ادخل إلى حسابك في وصّلها" page="login">
  <PageHero
    badge="حسابي"
    title="تسجيل الدخول"
    subtitle="أدخل رقمك وكلمة المرور للدخول"
  />

  <section class="auth-section">
    <div class="auth-card">

      <!-- ── Step 1: Password login ── -->
      <div id="step-login" class="step active">
        <h2 class="auth-card__title">مرحباً بعودتك 👋</h2>
        <p class="auth-card__sub">سجّل الدخول إلى حسابك</p>

        <div id="err-login" class="auth-error" role="alert" aria-live="polite"></div>

        <div class="field">
          <label class="field__label" for="login-phone">رقم الجوال</label>
          <input class="field__input" type="tel" id="login-phone"
            placeholder="010 1234 5678" inputmode="numeric"
            maxlength="11" pattern="01[0125][0-9]{8}" required autocomplete="username">
        </div>

        <div class="field">
          <label class="field__label" for="login-pass">كلمة المرور</label>
          <input class="field__input" type="password" id="login-pass"
            placeholder="••••••••" required autocomplete="current-password">
        </div>

        <button type="button" class="forgot-link" id="forgot-link">نسيت كلمة المرور؟</button>

        <button type="button" class="auth-submit" id="login-btn">دخول ←</button>

        <div class="auth-divider"><span>أو</span></div>
        <div class="auth-actions">
          <a href="/register" class="btn btn--outline">إنشاء حساب عميل جديد</a>
          <a href="/driver" class="btn btn--accent">🚗 حساب سائق جديد</a>
        </div>
        <p class="auth-footer">مشكلة في الدخول؟ <a href="/contact">تواصل معنا</a></p>
      </div>

      <!-- ── Step 2: Forgot password ── -->
      <div id="step-fp" class="step">
        <button type="button" id="fp-back-btn" class="back-btn">→ رجوع لتسجيل الدخول</button>
        <h2 class="auth-card__title">استعادة كلمة المرور 🔑</h2>

        <div id="err-fp" class="auth-error" role="alert" aria-live="polite"></div>

        <!-- 2a: enter phone -->
        <div id="fp-send-area">
          <p class="auth-card__sub">أدخل رقم جوالك وسنرسل لك رمز تحقق لإعادة التعيين</p>
          <div class="field">
            <label class="field__label" for="fp-phone">رقم الجوال</label>
            <input class="field__input" type="tel" id="fp-phone"
              placeholder="010 1234 5678" inputmode="numeric" maxlength="11" pattern="01[0125][0-9]{8}">
          </div>
          <button type="button" class="auth-submit" id="fp-send-btn">إرسال رمز التحقق ←</button>
        </div>

        <!-- 2b: enter OTP + new password -->
        <div id="fp-reset-area" style="display:none">
          <p class="auth-card__sub">
            أرسلنا رمز التحقق إلى بريدك الإلكتروني المسجّل لحساب<br>
            <span class="phone-badge">📱 <span id="fp-badge"></span></span><br>
            <span style="font-size:var(--text-sm);color:var(--color-text-faint)">📧 تحقّق من صندوق الوارد (ومجلد الرسائل غير المرغوبة)</span>
          </p>

          <div id="fp-dev-notice" class="dev-notice" role="alert" style="display:none">
            <div class="dev-notice__label">📧 تحقّق من بريدك الإلكتروني</div>
            <span id="fp-dev-code" class="dev-notice__code"></span>
          </div>

          <div class="otp-group" aria-label="رمز التحقق">
            <input type="text" class="otp-box" inputmode="numeric" maxlength="1" autocomplete="one-time-code">
            <input type="text" class="otp-box" inputmode="numeric" maxlength="1">
            <input type="text" class="otp-box" inputmode="numeric" maxlength="1">
            <input type="text" class="otp-box" inputmode="numeric" maxlength="1">
            <input type="text" class="otp-box" inputmode="numeric" maxlength="1">
            <input type="text" class="otp-box" inputmode="numeric" maxlength="1">
          </div>

          <div class="field">
            <label class="field__label" for="fp-pass">كلمة المرور الجديدة</label>
            <input class="field__input" type="password" id="fp-pass" placeholder="••••••••" autocomplete="new-password">
          </div>
          <div class="field">
            <label class="field__label" for="fp-pass2">تأكيد كلمة المرور</label>
            <input class="field__input" type="password" id="fp-pass2" placeholder="••••••••" autocomplete="new-password">
          </div>

          <button type="button" class="auth-submit" id="fp-set-btn">تعيين كلمة المرور</button>
        </div>
      </div>

    </div>
  </section>
</Layout>
