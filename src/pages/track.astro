---
import Layout from '../components/layout.astro';
---

<style>
  .page-hero {
    background: #3B6EF8;
    padding: 3.5rem 1.5rem 3rem;
    text-align: center;
    color: #fff;
  }

  .page-hero h1 {
    font-size: 2.2rem;
    font-weight: 900;
    margin-bottom: 0.6rem;
  }

  .page-hero p {
    color: rgba(255,255,255,0.8);
    font-size: 1rem;
  }

  .track-wrap {
    padding: 3rem 1.5rem 5rem;
    max-width: 680px;
    margin: 0 auto;
  }

  .track-box {
    background: #fff;
    border-radius: 18px;
    padding: 2.5rem;
    box-shadow: 0 8px 40px rgba(59,110,248,0.1);
    margin-bottom: 1.5rem;
    border: 1px solid #E2E8F0;
  }

  .track-box h2 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    color: #1A1A2E;
  }

  .form-label {
    display: block;
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    color: #374151;
  }

  .input-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0;
  }

  .form-input {
    flex: 1;
    padding: 0.85rem 1.1rem;
    border: 2px solid #E2E8F0;
    border-radius: 10px;
    font-family: 'Cairo', sans-serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
    direction: rtl;
    color: #1A1A2E;
  }

  .form-input:focus { border-color: #3B6EF8; }
  .form-input::placeholder { color: #94A3B8; }

  .track-submit {
    padding: 0.85rem 1.5rem;
    background: #3B6EF8;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-family: 'Cairo', sans-serif;
    font-weight: 800;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .track-submit:hover { background: #2952D9; }

  /* Result */
  .result-box {
    display: none;
    background: #fff;
    border-radius: 18px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 8px 40px rgba(59,110,248,0.08);
    overflow: hidden;
  }

  .result-box.show { display: block; }

  .result-header {
    background: #3B6EF8;
    color: #fff;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .result-id { font-size: 0.8rem; opacity: 0.8; margin-bottom: 0.2rem; }
  .result-name { font-size: 1.1rem; font-weight: 800; }

  .status-pill {
    padding: 0.4rem 1.1rem;
    border-radius: 100px;
    font-size: 0.82rem;
    font-weight: 700;
    background: #F5B800;
    color: #1A1A2E;
  }

  .result-body { padding: 2rem; }

  .timeline { position: relative; padding-right: 2.5rem; }

  .timeline::before {
    content: '';
    position: absolute;
    right: 10px; top: 12px; bottom: 12px;
    width: 2px;
    background: #E2E8F0;
  }

  .tl-item {
    position: relative;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .tl-dot {
    position: absolute;
    right: -2.5rem;
    top: 3px;
    width: 20px; height: 20px;
    border-radius: 50%;
    border: 3px solid #fff;
  }

  .tl-dot.done  { background: #3B6EF8; box-shadow: 0 0 0 2px #3B6EF8; }
  .tl-dot.active{ background: #F5B800; box-shadow: 0 0 0 4px rgba(245,184,0,0.25); }
  .tl-dot.wait  { background: #E2E8F0; box-shadow: 0 0 0 2px #E2E8F0; }

  .tl-title { font-weight: 800; font-size: 0.9rem; color: #1A1A2E; }
  .tl-meta  { font-size: 0.78rem; color: #94A3B8; }
  .tl-desc  { font-size: 0.82rem; color: #64748B; }

  .result-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #F1F5F9;
  }

  .ri-label { font-size: 0.72rem; color: #94A3B8; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.15rem; }
  .ri-value { font-weight: 700; font-size: 0.9rem; color: #1A1A2E; }
</style>

<script>
  function trackShipment() {
    const val = document.getElementById('trackInput').value.trim();
    if (!val) { document.getElementById('trackInput').focus(); return; }
    document.getElementById('resultId').textContent = val;
    const box = document.getElementById('resultBox');
    box.classList.add('show');
    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('trackForm').addEventListener('submit', e => {
      e.preventDefault();
      trackShipment();
    });
    const q = new URLSearchParams(location.search).get('q');
    if (q) { document.getElementById('trackInput').value = q; trackShipment(); }
  });
</script>

<Layout title="تتبع الطلب" description="تتبع طلبك لحظة بلحظة مع وصّلها" page="track">

  <section class="page-hero">
    <div style="display:inline-block; background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.3); color:#fff; font-weight:700; font-size:0.8rem; padding:0.3rem 1rem; border-radius:100px; margin-bottom:1rem;">📡 تتبع فوري</div>
    <h1>تتبع طلبك</h1>
    <p>أدخل رقم الطلب لمعرفة حالته لحظة بلحظة</p>
  </section>

  <div class="track-wrap">
    <div class="track-box">
      <h2>🔍 أدخل رقم الطلب</h2>
      <form id="trackForm">
        <label class="form-label" for="trackInput">رقم الطلب أو رقم التتبع</label>
        <div class="input-row">
          <input id="trackInput" class="form-input" type="text" placeholder="مثال: WSL-2024-001234" autocomplete="off">
          <button type="submit" class="track-submit">تتبع ←</button>
        </div>
      </form>
    </div>

    <div class="result-box" id="resultBox">
      <div class="result-header">
        <div>
          <div class="result-id">رقم الطلب: <strong id="resultId">—</strong></div>
          <div class="result-name">📦 طرد — توصيل محلي</div>
        </div>
        <span class="status-pill">في الطريق</span>
      </div>

      <div class="result-body">
        <div class="timeline">
          <div class="tl-item">
            <div class="tl-dot done"></div>
            <div class="tl-title">تم استلام الطلب</div>
            <div class="tl-meta">اليوم — 10:00 ص</div>
            <div class="tl-desc">تم تأكيد طلبك بنجاح</div>
          </div>
          <div class="tl-item">
            <div class="tl-dot done"></div>
            <div class="tl-title">المندوب في الطريق للاستلام</div>
            <div class="tl-meta">اليوم — 10:20 ص</div>
            <div class="tl-desc">المندوب توجه للمتجر لاستلام طلبك</div>
          </div>
          <div class="tl-item">
            <div class="tl-dot active"></div>
            <div class="tl-title">في الطريق إليك</div>
            <div class="tl-meta">اليوم — 10:45 ص</div>
            <div class="tl-desc">المندوب في طريقه لتوصيل طلبك</div>
          </div>
          <div class="tl-item">
            <div class="tl-dot wait"></div>
            <div class="tl-title">تم التسليم</div>
            <div class="tl-meta">متوقع — خلال 15 دقيقة</div>
          </div>
        </div>

        <div class="result-info">
          <div><div class="ri-label">من</div><div class="ri-value">متجر النخيل</div></div>
          <div><div class="ri-label">إلى</div><div class="ri-value">حي الروضة</div></div>
          <div><div class="ri-label">المندوب</div><div class="ri-value">أحمد محمد</div></div>
          <div><div class="ri-label">وقت التوصيل المتوقع</div><div class="ri-value">خلال 15 دقيقة</div></div>
        </div>
      </div>
    </div>
  </div>

</Layout>
