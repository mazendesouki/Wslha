---
import Layout from '../components/layout.astro';
import PageHero from '../components/PageHero.astro';
---

<style>
  .track-wrap {
    padding: var(--sp-12) var(--sp-6) var(--sp-20);
    max-width: 680px;
    margin: 0 auto;
  }

  /* Search box */
  .search-box {
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--sp-10);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    margin-bottom: var(--sp-6);
  }

  .search-box__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-black);
    margin-bottom: var(--sp-6);
    color: var(--color-text);
  }

  .search-box__label {
    display: block;
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    margin-bottom: var(--sp-2);
    color: #374151;
  }

  .search-box__row {
    display: flex;
    gap: var(--sp-3);
  }

  .search-box__input {
    flex: 1;
    padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--text-base);
    outline: none;
    transition: border-color var(--ease);
    direction: rtl;
    color: var(--color-text);
    background: var(--color-bg);
  }

  .search-box__input:focus         { border-color: var(--color-primary); }
  .search-box__input::placeholder  { color: var(--color-text-faint); }

  .search-box__submit {
    padding: var(--sp-3) var(--sp-5);
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-weight: var(--weight-black);
    font-size: var(--text-base);
    cursor: pointer;
    transition: background var(--ease), transform var(--ease);
    white-space: nowrap;
  }

  .search-box__submit:hover         { background: var(--color-primary-dark); transform: translateY(-1px); }
  .search-box__submit:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }

  /* Result */
  .result {
    display: none;
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .result.is-visible { display: block; }

  .result__header {
    background: var(--color-primary);
    color: #fff;
    padding: var(--sp-6) var(--sp-8);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  .result__id   { font-size: var(--text-xs); opacity: 0.75; margin-bottom: var(--sp-1); }
  .result__name { font-size: var(--text-xl); font-weight: var(--weight-black); }

  .result__status {
    padding: var(--sp-1) var(--sp-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    background: var(--color-accent);
    color: var(--color-text);
  }

  .result__body { padding: var(--sp-8); }

  /* Timeline — HungerStation style */
  .timeline-hs {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    position: relative;
    padding: var(--sp-4) 0;
    margin-bottom: var(--sp-4);
  }
  .timeline-hs::before {
    content: '';
    position: absolute;
    top: 32px;
    right: 28px;
    left: 28px;
    height: 3px;
    background: var(--color-border);
    z-index: 0;
  }
  .timeline-hs__progress {
    position: absolute;
    top: 32px;
    right: 28px;
    height: 3px;
    background: var(--color-primary);
    z-index: 1;
    transition: width .6s ease;
    width: 0%;
  }
  .tl-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    z-index: 2;
    flex: 1;
  }
  .tl-step__icon {
    width: 44px; height: 44px;
    border-radius: var(--radius-full);
    border: 3px solid var(--color-border);
    background: var(--color-bg);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem;
    transition: all .3s;
  }
  .tl-step--done .tl-step__icon   { border-color: var(--color-primary); background: var(--color-primary); filter: grayscale(0); }
  .tl-step--active .tl-step__icon { border-color: var(--color-accent); background: var(--color-accent-dark);
    box-shadow: 0 0 0 6px rgba(245,184,0,.2); animation: tl-pulse .9s ease-in-out infinite; }
  .tl-step--wait .tl-step__icon   { filter: grayscale(1); opacity: .4; }
  @keyframes tl-pulse {
    0%,100% { box-shadow: 0 0 0 4px rgba(245,184,0,.25); }
    50%      { box-shadow: 0 0 0 10px rgba(245,184,0,0); }
  }
  .tl-step__label { font-size: 11px; font-weight: var(--weight-semi); text-align: center;
    color: var(--color-text-muted); max-width: 70px; line-height: 1.3; }
  .tl-step--done .tl-step__label, .tl-step--active .tl-step__label { color: var(--color-text); }

  /* ETA card */
  .eta-card {
    display: flex; align-items: center; gap: var(--sp-3);
    background: var(--color-primary-light); border: 1.5px solid var(--color-primary);
    border-radius: var(--radius-lg); padding: var(--sp-3) var(--sp-4); margin-bottom: var(--sp-5);
  }
  .eta-card__time { font-size: var(--text-lg); font-weight: var(--weight-black); color: var(--color-primary); }
  .eta-card__label { font-size: var(--text-sm); color: var(--color-text-muted); }
  .eta-card__badge {
    margin-right: auto; background: #dcfce7; color: #15803d;
    font-size: var(--text-xs); font-weight: var(--weight-bold);
    border-radius: 999px; padding: 3px 10px;
  }

  /* Old timeline kept as fallback (hidden) */
  .timeline { display: none; }
  .timeline__title { font-weight: var(--weight-black); font-size: var(--text-base); color: var(--color-text); }
  .timeline__time  { font-size: var(--text-xs); color: var(--color-text-faint); margin-top: var(--sp-1); }
  .timeline__desc  { font-size: var(--text-sm); color: var(--color-text-muted); margin-top: var(--sp-1); }

  /* Info grid */
  .result__info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--color-bg-soft);
  }

  .result__info-label { font-size: var(--text-xs); color: var(--color-text-faint); font-weight: var(--weight-bold); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--sp-1); }
  .result__info-value { font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--color-text); }

  /* Live driver map */
  .track-map-card {
    margin-top: var(--sp-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: none;
  }
  .track-map-card.visible { display: block; }
  .track-map-card__head {
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--color-border);
    font-weight: var(--weight-black); font-size: var(--text-sm);
    display: flex; align-items: center; gap: var(--sp-2);
    background: var(--color-bg-soft);
    flex-wrap: wrap;
  }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #16a34a; animation: live-blink 1.2s infinite; flex-shrink:0; }
  @keyframes live-blink { 0%,100%{opacity:1} 50%{opacity:.3} }
  #track-map { width: 100%; height: 340px; }

  /* Distance + ETA strip under map */
  .map-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-top: 1px solid var(--color-border);
  }
  .map-stat {
    padding: var(--sp-3) var(--sp-2);
    text-align: center;
    border-left: 1px solid var(--color-border);
  }
  .map-stat:last-child { border-left: none; }
  .map-stat__val { font-size: var(--text-base); font-weight: var(--weight-black); color: var(--color-primary); }
  .map-stat__lbl { font-size: 10px; color: var(--color-text-faint); margin-top: 2px; }

  /* Map legend */
  .map-legend {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-2) var(--sp-4);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    font-size: 11px;
    flex-wrap: wrap;
  }
  .map-legend__item { display: flex; align-items: center; gap: 5px; color: var(--color-text-muted); }
  .map-legend__dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

  /* Geolocation button */
  .btn-myloc {
    margin-right: auto;
    background: var(--color-primary-light);
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    border-radius: var(--radius);
    padding: 3px 10px;
    font-size: 11px;
    font-weight: var(--weight-bold);
    cursor: pointer;
    font-family: var(--font-body);
    display: flex;
    align-items: center;
    gap: 4px;
    transition: background 0.2s;
  }
  .btn-myloc:hover { background: var(--color-primary); color: #fff; }

  /* Status-change banner */
  .status-banner {
    position: fixed; top: 76px; left: 50%; transform: translateX(-50%) translateY(-30px);
    background: #16a34a; color: #fff; padding: var(--sp-3) var(--sp-6);
    border-radius: var(--radius-xl); font-weight: var(--weight-bold); font-size: var(--text-sm);
    box-shadow: var(--shadow-lg); z-index: 1000; opacity: 0; transition: all 0.35s;
    max-width: 90vw; text-align: center;
  }
  .status-banner.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .status-banner.reject { background: #dc2626; }

  /* Rating card */
  .rate-card {
    margin-top: var(--sp-6); padding: var(--sp-6);
    border: 1.5px solid var(--color-border); border-radius: var(--radius-xl);
    background: var(--color-bg-soft); display: none;
  }
  .rate-card.visible { display: block; }
  .rate-card__title { font-weight: var(--weight-black); font-size: var(--text-base); margin-bottom: var(--sp-4); text-align: center; }
  .rate-row { margin-bottom: var(--sp-5); }
  .rate-row__label { font-size: var(--text-sm); font-weight: var(--weight-bold); margin-bottom: var(--sp-2); }
  .stars { display: flex; gap: var(--sp-2); justify-content: center; direction: ltr; }
  .star {
    font-size: 2rem; cursor: pointer; color: #d1d5db; transition: transform .15s, color .15s;
    background: none; border: none; padding: 0; line-height: 1;
  }
  .star:hover { transform: scale(1.15); }
  .star.active { color: #f59e0b; }
  .rate-comment {
    width: 100%; padding: var(--sp-3); border: 2px solid var(--color-border);
    border-radius: var(--radius); font-family: var(--font-body); font-size: var(--text-sm);
    direction: rtl; resize: vertical; min-height: 60px; margin-bottom: var(--sp-4);
  }
  .rate-submit {
    width: 100%; padding: var(--sp-4); border: none; border-radius: var(--radius-lg);
    background: var(--color-primary); color: #fff; font-family: var(--font-body);
    font-weight: var(--weight-black); font-size: var(--text-base); cursor: pointer; transition: background .2s;
  }
  .rate-submit:hover:not(:disabled) { background: var(--color-primary-dark); }
  .rate-submit:disabled { opacity: .5; cursor: not-allowed; }
  .rate-thanks { text-align: center; padding: var(--sp-6); color: #15803d; font-weight: var(--weight-bold); display: none; }
  .rate-thanks.visible { display: block; }
</style>

<script>
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H   = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` };

  const form  = document.getElementById('track-form');
  const input = document.getElementById('track-input');
  const result = document.getElementById('track-result');
  const resultId = document.getElementById('result-id');

  let lastStatus = null;
  let driverPollTimer = null;
  let map = null;
  let driverMarker = null;
  let storeMarker = null;
  let customerMarker = null;
  let routeLine = null;
  let customerLatLng = null;
  let storeLLng = null;

  // ── Status-change banner + optional browser notification ──
  function notifyStatusChange(status, order) {
    const messages = {
      preparing:  `✅ قبِل ${order.store_name || 'المتجر'} طلبك ويجهّزه الآن`,
      on_the_way: `🛵 طلبك في الطريق إليك مع ${order.driver_name || 'المندوب'}`,
      delivered:  '🎉 تم توصيل طلبك بنجاح — بالهنا والشفا!',
      rejected:   '❌ نعتذر، رفض المتجر طلبك',
    };
    const msg = messages[status];
    if (!msg) return;
    const banner = document.getElementById('status-banner');
    banner.textContent = msg;
    banner.classList.toggle('reject', status === 'rejected');
    banner.classList.add('show');
    setTimeout(() => banner.classList.remove('show'), 5000);

    // Browser notification if permitted
    try {
      if ('Notification' in window) {
        if (Notification.permission === 'granted') new Notification('وصّلها — تحديث الطلب', { body: msg });
        else if (Notification.permission !== 'denied') Notification.requestPermission();
      }
    } catch {}

    if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
  }

  // ── Leaflet ──────────────────────────────────────────────
  function loadLeaflet() {
    return new Promise((resolve) => {
      if (window.L) { resolve(); return; }
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);
      const s = document.createElement('script');
      s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      s.onload = resolve;
      document.head.appendChild(s);
    });
  }

  function makeIcon(emoji, color) {
    return L.divIcon({
      html: `<div style="background:${color};width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;border:3px solid white;box-shadow:0 2px 6px rgba(0,0,0,.3)">${emoji}</div>`,
      className: '',
      iconSize: [36, 36],
      iconAnchor: [18, 18],
      popupAnchor: [0, -18],
    });
  }

  async function fetchOSRMRoute(lat1, lng1, lat2, lng2) {
    const res = await fetch(`https://router.project-osrm.org/route/v1/driving/${lng1},${lat1};${lng2},${lat2}?overview=full&geometries=geojson`);
    const data = await res.json();
    if (!data.routes?.[0]) return null;
    return {
      coords: data.routes[0].geometry.coordinates.map(([lng, lat]) => [lat, lng]),
      distanceKm: data.routes[0].distance / 1000,
      durationMin: Math.ceil(data.routes[0].duration / 60),
    };
  }

  async function initTrackMap(sLat, sLng) {
    document.getElementById('track-map-card').classList.add('visible');
    try { await loadLeaflet(); } catch { return; }
    if (map) return;
    storeLLng = { lat: sLat, lng: sLng };

    map = L.map('track-map').setView([sLat, sLng], 14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19,
    }).addTo(map);

    // Store marker (blue)
    storeMarker = L.marker([sLat, sLng], { icon: makeIcon('🏪', '#3b82f6'), title: 'المتجر' })
      .addTo(map)
      .bindPopup('<div style="font-family:Cairo,sans-serif;font-size:13px;font-weight:700">🏪 المتجر</div>')
      .openPopup();

    // My-location button
    document.getElementById('btn-my-location').addEventListener('click', getCustomerLocation);
  }

  // Draw route: driver → customer (or store if no customer)
  async function drawRoute(dLat, dLng) {
    if (!map) return;
    const dest = customerLatLng || storeLLng;
    if (!dest) return;

    if (routeLine) { map.removeLayer(routeLine); routeLine = null; }

    try {
      const route = await fetchOSRMRoute(dLat, dLng, dest.lat, dest.lng);
      if (route) {
        routeLine = L.polyline(route.coords, { color: '#3b82f6', weight: 5, opacity: 0.85 }).addTo(map);
        document.getElementById('stat-distance').textContent = route.distanceKm.toFixed(1) + ' كم';
        document.getElementById('stat-duration').textContent = route.durationMin + ' دق';
        const arr = new Date(Date.now() + route.durationMin * 60 * 1000);
        document.getElementById('stat-eta').textContent = arr.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
        document.getElementById('map-stats').style.display = 'grid';
      }
    } catch {}
  }

  function updateDriverOnMap(lat, lng) {
    if (!map) return;

    if (driverMarker) {
      driverMarker.setLatLng([lat, lng]);
    } else {
      driverMarker = L.marker([lat, lng], { icon: makeIcon('🛵', '#16a34a'), zIndexOffset: 999, title: 'المندوب' }).addTo(map);
    }

    // Fit bounds to show all markers
    const points = [[lat, lng]];
    if (storeLLng) points.push([storeLLng.lat, storeLLng.lng]);
    if (customerLatLng) points.push([customerLatLng.lat, customerLatLng.lng]);
    if (customerMarker) points.push(customerMarker.getLatLng());
    map.fitBounds(L.latLngBounds(points), { padding: [40, 40] });

    // Draw route
    drawRoute(lat, lng);
  }

  // Get customer's real location
  function getCustomerLocation() {
    if (!navigator.geolocation) return;
    const btn = document.getElementById('btn-my-location');
    btn.textContent = '⏳ جارٍ التحديد...';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        btn.textContent = '📍 تم تحديد موقعي';
        btn.style.cssText = 'background:#d1fae5;border-color:#16a34a;color:#16a34a';
        customerLatLng = { lat: pos.coords.latitude, lng: pos.coords.longitude };

        if (map) {
          if (customerMarker) customerMarker.setLatLng([customerLatLng.lat, customerLatLng.lng]);
          else {
            customerMarker = L.marker([customerLatLng.lat, customerLatLng.lng], {
              icon: makeIcon('🏠', '#ef4444'), title: 'موقع التوصيل'
            }).addTo(map);
          }
          // Redraw route with real destination
          if (driverMarker) {
            const ll = driverMarker.getLatLng();
            drawRoute(ll.lat, ll.lng);
          }
        }
      },
      () => { btn.textContent = '📍 موقعي'; }
    );
  }

  async function pollDriverLocation(driverPhone) {
    try {
      const r = await fetch(
        `${SB_URL}/rest/v1/driver_locations?driver_phone=eq.${encodeURIComponent(driverPhone)}&select=lat,lng,heading,updated_at&limit=1`,
        { headers: SB_H }
      );
      if (!r.ok) return;
      const rows = await r.json();
      const loc = rows?.[0];
      if (loc?.lat && loc?.lng) updateDriverOnMap(Number(loc.lat), Number(loc.lng));
    } catch {}
  }

  // ── Rating ──
  let currentOrder = null;

  function setupStars(containerId) {
    const container = document.getElementById(containerId);
    container.querySelectorAll('.star').forEach(star => {
      star.addEventListener('click', () => {
        const v = Number(star.dataset.v);
        container.dataset.rating = String(v);
        container.querySelectorAll('.star').forEach((s, i) => s.classList.toggle('active', i < v));
      });
    });
  }
  setupStars('stars-store');
  setupStars('stars-driver');

  function maybeShowRating(o) {
    const card = document.getElementById('rate-card');
    const thanks = document.getElementById('rate-thanks');
    if (o.status !== 'delivered') { card.classList.remove('visible'); return; }

    // Already rated? (kept in localStorage per order code)
    let rated = [];
    try { rated = JSON.parse(localStorage.getItem('wslha_rated') || '[]'); } catch {}
    if (rated.includes(o.code)) { thanks.classList.add('visible'); return; }

    // Hide driver row if no driver
    document.getElementById('rate-driver-row').style.display = o.driver_phone ? 'block' : 'none';
    document.getElementById('rate-store-label').textContent = `تقييم ${o.store_name || 'المتجر'}`;
    card.classList.add('visible');
  }

  async function submitRating() {
    if (!currentOrder) return;
    const o = currentOrder;
    const storeRating  = Number(document.getElementById('stars-store').dataset.rating || '0');
    const driverRating = Number(document.getElementById('stars-driver').dataset.rating || '0');
    const comment = document.getElementById('rate-comment').value.trim();

    if (storeRating === 0) { alert('يرجى اختيار تقييم المتجر أولاً'); return; }

    const btn = document.getElementById('rate-submit');
    btn.disabled = true; btn.textContent = 'جارٍ الإرسال...';

    // Save the rating row
    try {
      await fetch(`${SB_URL}/rest/v1/ratings`, {
        method: 'POST',
        headers: { ...SB_H, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify({
          order_code: o.code, store_id: o.store_id, driver_phone: o.driver_phone || null,
          store_rating: storeRating, driver_rating: driverRating || null, comment: comment || null,
        }),
      });
    } catch {}

    // Update store's average rating
    try {
      const sr = await fetch(`${SB_URL}/rest/v1/stores?id=eq.${encodeURIComponent(o.store_id)}&select=rating,reviews&limit=1`, { headers: SB_H });
      const store = (await sr.json())?.[0];
      if (store) {
        const reviews = (store.reviews || 0) + 1;
        const newAvg = ((store.rating || 5) * (store.reviews || 0) + storeRating) / reviews;
        await fetch(`${SB_URL}/rest/v1/stores?id=eq.${encodeURIComponent(o.store_id)}`, {
          method: 'PATCH',
          headers: { ...SB_H, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify({ rating: Math.round(newAvg * 100) / 100, reviews }),
        });
      }
    } catch {}

    try {
      const rated = JSON.parse(localStorage.getItem('wslha_rated') || '[]');
      rated.push(o.code); localStorage.setItem('wslha_rated', JSON.stringify(rated));
    } catch {}

    document.getElementById('rate-card').classList.remove('visible');
    document.getElementById('rate-thanks').classList.add('visible');
  }

  document.getElementById('rate-submit').addEventListener('click', submitRating);

  // Status → ordered timeline steps
  const STEPS = [
    { key: 'pending',    title: 'تم استلام الطلب',          desc: 'بانتظار تأكيد المتجر' },
    { key: 'preparing',  title: 'المتجر يجهّز طلبك',         desc: 'جارٍ تجهيز الطلب والبحث عن مندوب' },
    { key: 'on_the_way', title: 'المندوب في الطريق إليك',    desc: 'طلبك في الطريق' },
    { key: 'delivered',  title: 'تم التسليم',               desc: 'تم توصيل طلبك بنجاح' },
  ];
  const STATUS_BADGE = {
    pending:'قيد الانتظار', preparing:'قيد التجهيز', on_the_way:'في الطريق',
    delivered:'تم التسليم', rejected:'مرفوض',
  };

  let pollTimer = null;

  function renderTimeline(status, order) {
    const KEYS = ['pending', 'preparing', 'on_the_way', 'delivered'];
    const curIdx = KEYS.indexOf(status);

    // Drive icon steps
    KEYS.forEach((key, i) => {
      const el = document.getElementById('tl-' + key);
      if (!el) return;
      el.className = 'tl-step';
      if (status === 'rejected') { el.classList.add('tl-step--wait'); return; }
      if (i < curIdx)       el.classList.add('tl-step--done');
      else if (i === curIdx) el.classList.add('tl-step--active');
      else                   el.classList.add('tl-step--wait');
    });

    // Progress bar width
    const prog = document.getElementById('tl-progress');
    const pct = status === 'rejected' ? 0
      : curIdx <= 0 ? 0 : Math.round((curIdx / (KEYS.length - 1)) * 100);
    prog.style.width = pct + '%';

    // ETA window
    const etaWindow  = document.getElementById('eta-window');
    const etaLabel   = document.getElementById('eta-label');
    const etaBadge   = document.getElementById('eta-badge');
    const fmt = (d) => d.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
    const now = new Date();
    if (status === 'delivered') {
      etaWindow.textContent = 'تم التسليم ✅';
      etaLabel.textContent  = 'وصل طلبك بنجاح';
      etaBadge.textContent  = '🎉 مكتمل';
      etaBadge.style.background = '#dbeafe'; etaBadge.style.color = '#1e40af';
    } else if (status === 'rejected') {
      etaWindow.textContent = 'تم الإلغاء';
      etaLabel.textContent  = 'الطلب مرفوض من المتجر';
      etaBadge.textContent  = '❌ ملغي';
      etaBadge.style.background = '#fee2e2'; etaBadge.style.color = '#b91c1c';
    } else if (status === 'on_the_way') {
      const lo = new Date(now.getTime() + 10 * 60000);
      const hi = new Date(now.getTime() + 25 * 60000);
      etaWindow.textContent = `${fmt(lo)} – ${fmt(hi)}`;
      etaLabel.textContent  = 'الوقت المتوقع للوصول';
      etaBadge.textContent  = '🛵 في الطريق';
      etaBadge.style.background = '#dbeafe'; etaBadge.style.color = '#1d4ed8';
    } else if (status === 'preparing') {
      const lo = new Date(now.getTime() + 20 * 60000);
      const hi = new Date(now.getTime() + 40 * 60000);
      etaWindow.textContent = `${fmt(lo)} – ${fmt(hi)}`;
      etaLabel.textContent  = 'الوقت المقدر للتوصيل';
      etaBadge.textContent  = '👨‍🍳 قيد التجهيز';
      etaBadge.style.background = '#fef9c3'; etaBadge.style.color = '#854d0e';
    } else {
      const lo = new Date(now.getTime() + 25 * 60000);
      const hi = new Date(now.getTime() + 45 * 60000);
      etaWindow.textContent = `${fmt(lo)} – ${fmt(hi)}`;
      etaLabel.textContent  = 'بانتظار تأكيد المتجر';
      etaBadge.textContent  = '📋 جديد';
    }
  }

  function renderOrder(o) {
    currentOrder = o;
    document.getElementById('result-empty').style.display = 'none';
    document.getElementById('result-timeline').style.display = '';
    document.querySelector('.result__info').style.display = '';

    resultId.textContent = o.code || o.id;
    document.getElementById('result-name').textContent = `${o.store_emoji || '📦'} طلب من ${o.store_name || ''}`;
    const badge = document.getElementById('result-status');
    badge.textContent = STATUS_BADGE[o.status] || o.status;

    document.getElementById('info-from').textContent   = o.store_name || '—';
    document.getElementById('info-to').textContent     = `${o.area || ''}${o.address ? ' — ' + o.address : ''}`;
    document.getElementById('info-driver').textContent = o.driver_name || (o.status === 'preparing' ? 'جارٍ التعيين…' : '—');
    document.getElementById('info-total').textContent  = `${o.total || 0} ج.م`;

    renderTimeline(o.status);

    // Status-change notification
    if (lastStatus !== null && lastStatus !== o.status) notifyStatusChange(o.status, o);
    lastStatus = o.status;

    // Live driver map once a driver is on the way
    if (o.status === 'on_the_way' && o.driver_phone && o.store_lat && o.store_lng) {
      initTrackMap(Number(o.store_lat), Number(o.store_lng));
      pollDriverLocation(o.driver_phone);
      if (!driverPollTimer) {
        driverPollTimer = setInterval(() => pollDriverLocation(o.driver_phone), 4000);
      }
    } else if (o.status === 'delivered' || o.status === 'rejected') {
      if (driverPollTimer) { clearInterval(driverPollTimer); driverPollTimer = null; }
    }

    maybeShowRating(o);
  }

  function showEmpty(code) {
    resultId.textContent = code;
    document.getElementById('result-timeline').style.display = 'none';
    document.querySelector('.result__info').style.display = 'none';
    document.getElementById('result-status').textContent = '—';
    document.getElementById('result-empty').style.display = 'block';
  }

  async function fetchOrder(code) {
    try {
      const r = await fetch(`${SB_URL}/rest/v1/orders?code=eq.${encodeURIComponent(code)}&limit=1`, { headers: SB_H });
      if (!r.ok) return null;
      const rows = await r.json();
      return rows?.[0] || null;
    } catch { return null; }
  }

  async function track(code) {
    result.classList.add('is-visible');
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    // Reset per-order state
    lastStatus = null;
    if (driverPollTimer) { clearInterval(driverPollTimer); driverPollTimer = null; }
    map = null; driverMarker = null; storeMarker = null; storeLLng = null;
    document.getElementById('track-map-card').classList.remove('visible');
    document.getElementById('rate-card').classList.remove('visible');
    document.getElementById('rate-thanks').classList.remove('visible');
    try { if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission(); } catch {}

    const order = await fetchOrder(code);
    if (order) renderOrder(order);
    else showEmpty(code);

    // Live polling while a non-terminal order is shown
    if (pollTimer) clearInterval(pollTimer);
    if (order && order.status !== 'delivered' && order.status !== 'rejected') {
      pollTimer = setInterval(async () => {
        const fresh = await fetchOrder(code);
        if (fresh) {
          renderOrder(fresh);
          if (fresh.status === 'delivered' || fresh.status === 'rejected') {
            clearInterval(pollTimer); pollTimer = null;
          }
        }
      }, 5000);
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = input.value.trim();
    if (val) track(val);
    else input.focus();
  });

  // Auto-fill from query param or last order in localStorage
  const trackParam = new URLSearchParams(location.search).get('q');
  if (trackParam) {
    input.value = trackParam;
    track(trackParam);
  } else {
    try {
      const orders = JSON.parse(localStorage.getItem('wslha_orders') || '[]');
      const last = orders.find((o) => o.kind === 'store' && o.code);
      if (last) { input.value = last.code; track(last.code); }
    } catch {}
  }
</script>

<Layout
  title="تتبع الطلب"
  description="تتبع طلبك لحظة بلحظة مع وصّلها"
  page="track"
>
  <PageHero
    badge="📡 تتبع فوري"
    title="تتبع طلبك"
    subtitle="أدخل رقم الطلب لمعرفة حالته لحظة بلحظة"
  />

  <div class="track-wrap">

    <!-- Search -->
    <div class="search-box">
      <h2 class="search-box__title">🔍 أدخل رقم الطلب</h2>
      <form id="track-form" role="search">
        <label class="search-box__label" for="track-input">رقم الطلب أو رقم التتبع</label>
        <div class="search-box__row">
          <input
            id="track-input"
            class="search-box__input"
            type="search"
            placeholder="مثال: WSL-2024-001234"
            autocomplete="off"
            aria-label="أدخل رقم التتبع"
          >
          <button type="submit" class="search-box__submit">تتبع ←</button>
        </div>
      </form>
    </div>

    <!-- Result -->
    <section
      id="track-result"
      class="result"
      aria-live="polite"
      aria-label="نتيجة التتبع"
    >
      <div class="result__header">
        <div>
          <p class="result__id">رقم الطلب: <strong id="result-id">—</strong></p>
          <p class="result__name" id="result-name">📦 طلب — توصيل محلي</p>
        </div>
        <span class="result__status" role="status" id="result-status">—</span>
      </div>

      <div class="result__body">

        <!-- HungerStation-style icon timeline -->
        <div class="timeline-hs" id="timeline-hs" aria-label="مراحل التوصيل">
          <div class="timeline-hs__progress" id="tl-progress"></div>
          <div class="tl-step" id="tl-pending">
            <div class="tl-step__icon">📋</div>
            <span class="tl-step__label">استلام الطلب</span>
          </div>
          <div class="tl-step" id="tl-preparing">
            <div class="tl-step__icon">👨‍🍳</div>
            <span class="tl-step__label">جاري التجهيز</span>
          </div>
          <div class="tl-step" id="tl-on_the_way">
            <div class="tl-step__icon">🛵</div>
            <span class="tl-step__label">في الطريق</span>
          </div>
          <div class="tl-step" id="tl-delivered">
            <div class="tl-step__icon">✅</div>
            <span class="tl-step__label">تم التسليم</span>
          </div>
        </div>

        <!-- ETA window -->
        <div class="eta-card" id="eta-card">
          <span style="font-size:1.4rem">🕐</span>
          <div>
            <div class="eta-card__time" id="eta-window">—</div>
            <div class="eta-card__label" id="eta-label">الوقت المقدر للتوصيل</div>
          </div>
          <span class="eta-card__badge" id="eta-badge">قيد التجهيز</span>
        </div>

        <!-- hidden old timeline (kept for JS compat) -->
        <ol class="timeline" id="result-timeline" style="display:none" aria-hidden="true"></ol>

        <dl class="result__info">
          <div><dt class="result__info-label">من</dt>          <dd class="result__info-value" id="info-from">—</dd></div>
          <div><dt class="result__info-label">إلى</dt>         <dd class="result__info-value" id="info-to">—</dd></div>
          <div><dt class="result__info-label">المندوب</dt>     <dd class="result__info-value" id="info-driver">—</dd></div>
          <div><dt class="result__info-label">الإجمالي</dt>    <dd class="result__info-value" id="info-total">—</dd></div>
        </dl>

        <!-- Live driver map -->
        <div class="track-map-card" id="track-map-card">
          <div class="track-map-card__head">
            <span class="live-dot"></span>
            <span>🛵 موقع المندوب المباشر</span>
            <button class="btn-myloc" id="btn-my-location" type="button">
              📍 موقعي
            </button>
          </div>
          <div id="track-map"></div>
          <!-- Distance / Duration / ETA stats -->
          <div class="map-stats" id="map-stats" style="display:none">
            <div class="map-stat">
              <div class="map-stat__val" id="stat-distance">—</div>
              <div class="map-stat__lbl">المسافة المتبقية</div>
            </div>
            <div class="map-stat">
              <div class="map-stat__val" id="stat-duration">—</div>
              <div class="map-stat__lbl">وقت التوصيل</div>
            </div>
            <div class="map-stat">
              <div class="map-stat__val" id="stat-eta">—</div>
              <div class="map-stat__lbl">الوصول المتوقع</div>
            </div>
          </div>
          <!-- Legend -->
          <div class="map-legend">
            <div class="map-legend__item">
              <div class="map-legend__dot" style="background:#3b82f6"></div>
              <span>المتجر</span>
            </div>
            <div class="map-legend__item">
              <div class="map-legend__dot" style="background:#16a34a"></div>
              <span>المندوب</span>
            </div>
            <div class="map-legend__item">
              <div class="map-legend__dot" style="background:#ef4444"></div>
              <span>موقع التوصيل</span>
            </div>
          </div>
        </div>

        <!-- Rating (after delivery) -->
        <div class="rate-card" id="rate-card">
          <p class="rate-card__title">⭐ كيف كانت تجربتك؟</p>
          <div class="rate-row">
            <p class="rate-row__label" id="rate-store-label">تقييم المتجر</p>
            <div class="stars" id="stars-store" data-rating="0">
              <button class="star" data-v="1">★</button><button class="star" data-v="2">★</button>
              <button class="star" data-v="3">★</button><button class="star" data-v="4">★</button>
              <button class="star" data-v="5">★</button>
            </div>
          </div>
          <div class="rate-row" id="rate-driver-row">
            <p class="rate-row__label">تقييم المندوب</p>
            <div class="stars" id="stars-driver" data-rating="0">
              <button class="star" data-v="1">★</button><button class="star" data-v="2">★</button>
              <button class="star" data-v="3">★</button><button class="star" data-v="4">★</button>
              <button class="star" data-v="5">★</button>
            </div>
          </div>
          <textarea class="rate-comment" id="rate-comment" placeholder="أضف تعليقاً (اختياري)..."></textarea>
          <button class="rate-submit" id="rate-submit">إرسال التقييم</button>
        </div>
        <div class="rate-thanks" id="rate-thanks">🙏 شكراً لتقييمك! نسعد بخدمتك دائماً.</div>

        <p id="result-empty" style="text-align:center;color:var(--color-text-faint);font-size:var(--text-sm);display:none;padding:var(--sp-4) 0;">
          لم نعثر على طلب بهذا الرقم. تأكد من الرقم وحاول مرة أخرى.
        </p>
      </div>
    </section>

  </div>

  <div class="status-banner" id="status-banner"></div>
</Layout>
