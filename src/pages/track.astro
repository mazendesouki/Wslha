---
import Layout from '../components/layout.astro';
---

<style>
  .page-hero {
    background: linear-gradient(135deg, #f0fdf4, #dcfce7);
    padding: 4rem 1.5rem 3rem;
    text-align: center;
  }
  .page-hero h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 0.75rem; }
  .page-hero p { color: #64748b; font-size: 1.05rem; }

  .track-section {
    padding: 3rem 1.5rem 5rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .track-box {
    background: #fff;
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 8px 40px rgba(0,0,0,0.08);
    margin-bottom: 2rem;
  }

  .track-box h2 {
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-label {
    display: block;
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    color: #374151;
  }

  .form-input {
    width: 100%;
    padding: 0.85rem 1.25rem;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    font-family: 'Cairo', sans-serif;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
    direction: rtl;
    color: #1a1a2e;
  }

  .form-input:focus { border-color: #16a34a; }
  .form-input::placeholder { color: #94a3b8; }

  .submit-btn {
    width: 100%;
    padding: 1rem;
    background: #16a34a;
    color: #fff;
    border: none;
    border-radius: 12px;
    font-family: 'Cairo', sans-serif;
    font-weight: 800;
    font-size: 1.05rem;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .submit-btn:hover { background: #15803d; transform: translateY(-1px); }

  /* Result box */
  .result-box {
    display: none;
    background: #fff;
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 8px 40px rgba(0,0,0,0.08);
  }

  .result-box.show { display: block; }

  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .result-id {
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .result-title { font-size: 1.2rem; font-weight: 900; }

  .status-badge {
    padding: 0.4rem 1rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .status-badge.in-transit {
    background: #fef3c7;
    color: #b45309;
  }

  .status-badge.delivered {
    background: #d1fae5;
    color: #065f46;
  }

  .timeline {
    position: relative;
    padding-right: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    right: 9px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: #e2e8f0;
  }

  .timeline-item {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    position: relative;
  }

  .tl-dot {
    width: 20px; height: 20px;
    border-radius: 50%;
    position: absolute;
    right: -2rem;
    top: 2px;
    flex-shrink: 0;
    border: 3px solid #fff;
  }

  .tl-dot.done { background: #16a34a; box-shadow: 0 0 0 2px #16a34a; }
  .tl-dot.active { background: #f59e0b; box-shadow: 0 0 0 4px rgba(245,158,11,0.25); }
  .tl-dot.pending { background: #e2e8f0; box-shadow: 0 0 0 2px #e2e8f0; }

  .tl-content { flex: 1; }
  .tl-title { font-weight: 800; font-size: 0.95rem; margin-bottom: 0.15rem; }
  .tl-meta { font-size: 0.8rem; color: #94a3b8; }
  .tl-desc { font-size: 0.85rem; color: #64748b; margin-top: 0.25rem; }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #f1f5f9;
  }

  .info-item { }
  .info-label { font-size: 0.78rem; color: #94a3b8; font-weight: 700; margin-bottom: 0.2rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .info-value { font-weight: 700; font-size: 0.9rem; }
</style>

<script>
  function trackShipment() {
    const input = document.getElementById('trackingInput');
    const val = input.value.trim();
    if (!val) { input.focus(); return; }
    const resultBox = document.getElementById('resultBox');
    document.getElementById('resultTrackId').textContent = val;
    resultBox.classList.add('show');
    resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('trackForm').addEventListener('submit', (e) => {
      e.preventDefault();
      trackShipment();
    });
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      document.getElementById('trackingInput').value = q;
      trackShipment();
    }
  });
</script>

<Layout title="تتبع الشحنة" description="تتبع شحنتك لحظة بلحظة مع وصّلها" page="track">

  <section class="page-hero">
    <div class="badge" style="display:inline-block; background:rgba(22,163,74,0.12); color:#15803d; font-weight:700; font-size:0.8rem; padding:0.35rem 1rem; border-radius:100px; margin-bottom:1rem;">📡 تتبع فوري</div>
    <h1>تتبع شحنتك</h1>
    <p>أدخل رقم التتبع الخاص بك لمعرفة حالة شحنتك لحظة بلحظة</p>
  </section>

  <div class="track-section">
    <div class="track-box">
      <h2>🔍 البحث عن الشحنة</h2>
      <form id="trackForm">
        <div class="form-group">
          <label class="form-label" for="trackingInput">رقم التتبع</label>
          <input
            id="trackingInput"
            class="form-input"
            type="text"
            placeholder="مثال: WSL-2024-000123"
            autocomplete="off"
          />
        </div>
        <button type="submit" class="submit-btn">تتبع الشحنة ←</button>
      </form>
    </div>

    <div class="result-box" id="resultBox">
      <div class="result-header">
        <div>
          <div class="result-id">رقم التتبع: <strong id="resultTrackId">—</strong></div>
          <div class="result-title">📦 طرد — الرياض إلى جدة</div>
        </div>
        <span class="status-badge in-transit">في الطريق</span>
      </div>

      <div class="timeline">
        <div class="timeline-item">
          <div class="tl-dot done"></div>
          <div class="tl-content">
            <div class="tl-title">تم استلام الطلب</div>
            <div class="tl-meta">اليوم — 10:00 صباحاً</div>
            <div class="tl-desc">تم استلام الشحنة في مستودع الرياض</div>
          </div>
        </div>
        <div class="timeline-item">
          <div class="tl-dot done"></div>
          <div class="tl-content">
            <div class="tl-title">قيد الفرز والتحضير</div>
            <div class="tl-meta">اليوم — 11:30 صباحاً</div>
            <div class="tl-desc">تم فرز الشحنة وتحضيرها للشحن</div>
          </div>
        </div>
        <div class="timeline-item">
          <div class="tl-dot active"></div>
          <div class="tl-content">
            <div class="tl-title">في الطريق إلى جدة</div>
            <div class="tl-meta">اليوم — 02:00 مساءً</div>
            <div class="tl-desc">الشحنة مع السائق وفي طريقها للوصول</div>
          </div>
        </div>
        <div class="timeline-item">
          <div class="tl-dot pending"></div>
          <div class="tl-content">
            <div class="tl-title">تم التسليم</div>
            <div class="tl-meta">متوقع — غداً 10:00 صباحاً</div>
          </div>
        </div>
      </div>

      <div class="info-grid">
        <div class="info-item">
          <div class="info-label">المرسل</div>
          <div class="info-value">متجر النخيل</div>
        </div>
        <div class="info-item">
          <div class="info-label">المستلم</div>
          <div class="info-value">محمد أحمد</div>
        </div>
        <div class="info-item">
          <div class="info-label">من</div>
          <div class="info-value">الرياض</div>
        </div>
        <div class="info-item">
          <div class="info-label">إلى</div>
          <div class="info-value">جدة</div>
        </div>
        <div class="info-item">
          <div class="info-label">الوزن</div>
          <div class="info-value">2.5 كجم</div>
        </div>
        <div class="info-item">
          <div class="info-label">التوصيل المتوقع</div>
          <div class="info-value">غداً ٢ يونيو</div>
        </div>
      </div>
    </div>
  </div>

</Layout>
