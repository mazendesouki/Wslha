<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>دخول المشرف — وصّلها</title>
  <link rel="icon" href="/icon.svg" type="image/svg+xml"/>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap');
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{--pr:#0E4B49;--pr2:#082F2E;--pr3:#3FA79A;--tx3:#5C716D;--bdr:#DCE6E3;--card-2:#EAF0EE}
    /* Same identity as admin.astro's password/confirm gates — a centered
       white card with the app's gradient mark, on the green brand
       background, instead of the old dark navy "generic SaaS login" card. */
    body{font-family:'Cairo',system-ui,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem;
      background:radial-gradient(circle at 50% 0%,var(--pr3) 0%,var(--pr) 45%,var(--pr2) 100%)}
    .card{background:#fff;border-radius:16px;padding:2rem 1.75rem 1.75rem;width:100%;max-width:380px;box-shadow:0 30px 70px rgba(0,0,0,.35);text-align:center}
    .logo-mark{width:58px;height:58px;border-radius:14px;margin:0 auto .9rem;background:linear-gradient(135deg,var(--pr3),var(--pr));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:1.6rem;box-shadow:0 10px 24px -8px rgba(63,167,154,.6)}
    h1{font-size:1.05rem;font-weight:900;color:#10201E}
    .subtitle{font-size:.8rem;color:var(--tx3);margin-top:.3rem;margin-bottom:1.5rem}
    .field{margin-bottom:1.1rem;text-align:right}
    label{display:block;font-size:.78rem;font-weight:700;color:var(--tx3);margin-bottom:.4rem}
    input{width:100%;padding:.7rem .9rem;background:#fff;border:1.5px solid var(--bdr);border-radius:9px;color:#10201E;font-family:inherit;font-size:.95rem;transition:border-color .2s}
    input:focus{outline:none;border-color:var(--pr3)}
    input::placeholder{color:#9DB3AF}
    .btn{width:100%;padding:.75rem;background:var(--pr);color:#fff;border:none;border-radius:9px;font-family:inherit;font-size:.95rem;font-weight:800;cursor:pointer;transition:background .2s;margin-top:.6rem}
    .btn:hover{background:var(--pr2)}
    .btn:disabled{opacity:.6;cursor:not-allowed}
    .error{background:#FEE2E2;color:#DC2626;padding:.7rem .9rem;border-radius:9px;font-size:.82rem;font-weight:700;margin-bottom:1rem;display:none;text-align:center}
    .back{display:block;text-align:center;margin-top:1.3rem;font-size:.8rem;color:var(--tx3);text-decoration:none}
    .back:hover{color:var(--pr)}
  </style>
</head>
<body>
  <div class="card">
    <div class="logo-mark">و</div>
    <h1>لوحة تحكم المشرفين</h1>
    <p class="subtitle">هذه المنطقة مخصصة للمشرفين المخوّلين فقط</p>
    <div class="error" id="err"></div>
    <form id="admin-login-form" novalidate>
      <div class="field">
        <label for="phone">رقم الجوال</label>
        <input id="phone" type="tel" placeholder="01XXXXXXXXX" dir="ltr" autocomplete="username" required/>
      </div>
      <div class="field">
        <label for="password">كلمة المرور</label>
        <input id="password" type="password" placeholder="••••••••" autocomplete="current-password" required/>
      </div>
      <button class="btn" type="submit" id="submit-btn">دخول إلى لوحة التحكم</button>
    </form>
    <a class="back" href="/">← العودة للموقع</a>
  </div>

  <script is:inline>
    const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
    const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
    const SB_H   = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` };

    // Explains an auto-logout redirect from the admin panel (5 min idle)
    // instead of just landing back here with no context.
    if (new URLSearchParams(location.search).get('reason') === 'idle') {
      const err = document.getElementById('err');
      err.textContent = '⏱️ تم تسجيل خروجك تلقائياً بعد 5 دقائق بدون نشاط — سجّل دخولك مرة أخرى.';
      err.style.display = 'block';
    }

    function toIntl(p) {
      if (!p) return '';
      p = p.trim().replace(/\s+/g,'');
      if (p.startsWith('00')) return '+' + p.slice(2);
      if (p.startsWith('01') && p.length === 11) return '+20' + p.slice(1);
      if (p.startsWith('1') && p.length === 10) return '+20' + p;
      return p;
    }
    function toLocal(p) {
      if (!p) return '';
      p = p.trim().replace(/\s+/g,'');
      if (p.startsWith('+20')) return '0' + p.slice(3);
      if (p.startsWith('0020')) return '0' + p.slice(4);
      return p;
    }

    document.getElementById('admin-login-form').addEventListener('submit', async e => {
      e.preventDefault();
      const err = document.getElementById('err');
      const btn = document.getElementById('submit-btn');
      err.style.display = 'none';

      const raw      = document.getElementById('phone').value;
      const intl     = toIntl(raw);
      const local    = toLocal(intl);
      const password = document.getElementById('password').value;

      if (!raw || !password) {
        err.textContent = 'يرجى إدخال الجوال وكلمة المرور';
        err.style.display = 'block'; return;
      }

      btn.disabled = true; btn.textContent = 'جاري التحقق…';

      try {
        // Server-side password check (bcrypt) — password never returned to the browser.
        const res  = await fetch(`${SB_URL}/rest/v1/rpc/verify_login`, {
          method: 'POST',
          headers: { ...SB_H, 'Content-Type': 'application/json' },
          body: JSON.stringify({ p_phone: local, p_password: password }),
        });
        const rows = res.ok ? await res.json() : [];
        const acc  = Array.isArray(rows) ? rows[0] : rows;

        if (!acc || !acc.phone) { throw new Error('رقم الجوال أو كلمة المرور غير صحيحة'); }
        if (acc.role !== 'admin') { throw new Error('ليس لديك صلاحية الوصول لهذه المنطقة'); }

        localStorage.setItem('wslha_admin', JSON.stringify({
          phone: acc.phone, name: acc.name, role: 'admin', loginAt: new Date().toISOString()
        }));
        localStorage.setItem('wslha_user', JSON.stringify({
          phone: acc.phone, name: acc.name, role: 'admin', loginAt: new Date().toISOString()
        }));
        window.location.href = '/admin';
      } catch(ex) {
        err.textContent = ex.message || 'حدث خطأ، حاول مجدداً';
        err.style.display = 'block';
        btn.disabled = false; btn.textContent = 'دخول إلى لوحة التحكم';
      }
    });

    // Redirect if already logged in as admin
    try {
      const a = JSON.parse(localStorage.getItem('wslha_admin') || 'null');
      if (a?.role === 'admin') window.location.href = '/admin';
    } catch {}
  </script>
</body>
</html>
