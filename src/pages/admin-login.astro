<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>دخول المشرف — وصّلها</title>
  <link rel="icon" href="/icon.svg" type="image/svg+xml"/>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap');
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Cairo',system-ui,sans-serif;background:#0F172A;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem}
    .card{background:#1E293B;border:1px solid #334155;border-radius:16px;padding:2.5rem;width:100%;max-width:420px;box-shadow:0 25px 50px rgba(0,0,0,0.5)}
    .logo{text-align:center;margin-bottom:2rem}
    .logo-name{font-size:2.2rem;font-weight:900;background:linear-gradient(135deg,#3B6EF8,#818CF8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .logo-sub{font-size:.8rem;color:#64748B;margin-top:.25rem}
    h1{font-size:1.3rem;font-weight:700;color:#F1F5F9;text-align:center;margin-bottom:.5rem}
    .subtitle{font-size:.85rem;color:#64748B;text-align:center;margin-bottom:2rem}
    .field{margin-bottom:1.2rem}
    label{display:block;font-size:.8rem;font-weight:700;color:#94A3B8;margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.05em}
    input{width:100%;padding:.75rem 1rem;background:#0F172A;border:1.5px solid #334155;border-radius:8px;color:#F1F5F9;font-family:inherit;font-size:1rem;transition:border-color .2s}
    input:focus{outline:none;border-color:#3B6EF8}
    input::placeholder{color:#475569}
    .btn{width:100%;padding:.9rem;background:#3B6EF8;color:#fff;border:none;border-radius:8px;font-family:inherit;font-size:1rem;font-weight:700;cursor:pointer;transition:background .2s,transform .2s;margin-top:.5rem}
    .btn:hover{background:#2952D9;transform:translateY(-1px)}
    .btn:disabled{opacity:.6;cursor:not-allowed;transform:none}
    .error{background:#FEE2E2;color:#DC2626;padding:.75rem 1rem;border-radius:8px;font-size:.875rem;font-weight:600;margin-bottom:1rem;display:none}
    .back{display:block;text-align:center;margin-top:1.5rem;font-size:.85rem;color:#64748B;text-decoration:none}
    .back:hover{color:#94A3B8}
    .shield{font-size:2.5rem;text-align:center;margin-bottom:1rem}
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">
      <div class="logo-name">وصّلها</div>
      <div class="logo-sub">لوحة التحكم الإدارية</div>
    </div>
    <div class="shield">🛡️</div>
    <h1>دخول المشرفين</h1>
    <p class="subtitle">هذه المنطقة مخصصة للمشرفين المخوّلين فقط</p>
    <div class="error" id="err"></div>
    <form id="admin-login-form" novalidate>
      <div class="field">
        <label for="phone">رقم الجوال</label>
        <input id="phone" type="tel" placeholder="01XXXXXXXXX" dir="ltr" autocomplete="username" required/>
      </div>
      <div class="field">
        <label for="password">كلمة المرور</label>
        <input id="password" type="password" placeholder="••••••••" autocomplete="current-password" required/>
      </div>
      <button class="btn" type="submit" id="submit-btn">دخول إلى لوحة التحكم</button>
    </form>
    <a class="back" href="/">← العودة للموقع</a>
  </div>

  <script is:inline>
    const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
    const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
    const SB_H   = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` };

    function norm(p) {
      if (!p) return '';
      p = p.trim().replace(/\s+/g,'');
      if (p.startsWith('+20')) p = '0' + p.slice(3);
      else if (p.startsWith('0020')) p = '0' + p.slice(4);
      else if (p.startsWith('20') && p.length === 12) p = '0' + p.slice(2);
      return p;
    }

    document.getElementById('admin-login-form').addEventListener('submit', async e => {
      e.preventDefault();
      const err = document.getElementById('err');
      const btn = document.getElementById('submit-btn');
      err.style.display = 'none';

      const phone    = norm(document.getElementById('phone').value);
      const password = document.getElementById('password').value;

      if (!phone || !password) {
        err.textContent = 'يرجى إدخال الجوال وكلمة المرور';
        err.style.display = 'block'; return;
      }

      btn.disabled = true; btn.textContent = 'جاري التحقق…';

      try {
        const res  = await fetch(
          `${SB_URL}/rest/v1/accounts?phone=eq.${encodeURIComponent(phone)}&select=*&limit=1`,
          { headers: SB_H }
        );
        const rows = res.ok ? await res.json() : [];
        const acc  = rows[0];

        if (!acc) { throw new Error('رقم الجوال غير مسجل'); }
        if (acc.password !== password) { throw new Error('كلمة المرور غير صحيحة'); }
        if (acc.role !== 'admin') { throw new Error('ليس لديك صلاحية الوصول لهذه المنطقة'); }

        localStorage.setItem('wslha_admin', JSON.stringify({
          phone: acc.phone, name: acc.name, role: 'admin', loginAt: new Date().toISOString()
        }));
        localStorage.setItem('wslha_user', JSON.stringify({
          phone: acc.phone, name: acc.name, role: 'admin', loginAt: new Date().toISOString()
        }));
        window.location.href = '/admin';
      } catch(ex) {
        err.textContent = ex.message || 'حدث خطأ، حاول مجدداً';
        err.style.display = 'block';
        btn.disabled = false; btn.textContent = 'دخول إلى لوحة التحكم';
      }
    });

    // Redirect if already logged in as admin
    try {
      const a = JSON.parse(localStorage.getItem('wslha_admin') || 'null');
      if (a?.role === 'admin') window.location.href = '/admin';
    } catch {}
  </script>
</body>
</html>
