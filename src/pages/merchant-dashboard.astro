</Layout>

<script>
  function escapeHtml(s: string | null | undefined): string {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' } as Record<string,string>)[c]);
  }
  const SB_URL = 'https://vtikgyiopkjnrwlqnmfx.supabase.co';
  const SB_KEY = 'sb_publishable_PLSnpvCT-sAyUMtymNgTwA_QmL2suw4';
  const SB_H   = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' };

  const CAT_LABELS: Record<string, string> = {
    restaurant:'مطعم', grocery:'سوبر ماركت', pharmacy:'صيدلية',
    bakery:'مخبز وحلويات', produce:'خضار وفاكهة', electronics:'إلكترونيات',
  };

  // ── Toast ──
  function toast(msg: string, ms = 2600) {
    const t = document.getElementById('toast')!;
    t.textContent = msg; t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), ms);
  }

  // ── Supabase helpers ──
  async function sbGet(path: string) {
    try {
      const r = await fetch(`${SB_URL}/rest/v1/${path}`, { headers: SB_H });
      return r.ok ? await r.json() : null;
    } catch { return null; }
  }
  async function sbPost(path: string, body: object) {
    try {
      const r = await fetch(`${SB_URL}/rest/v1/${path}`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=representation' },
        body: JSON.stringify(body),
      });
      return r.ok ? await r.json() : null;
    } catch { return null; }
  }
  async function sbPatch(path: string, body: object) {
    try {
      const r = await fetch(`${SB_URL}/rest/v1/${path}`, {
        method: 'PATCH',
        headers: { ...SB_H, Prefer: 'return=minimal' },
        body: JSON.stringify(body),
      });
      return r.ok;
    } catch { return false; }
  }
  async function sbDel(path: string) {
    try {
      const r = await fetch(`${SB_URL}/rest/v1/${path}`, { method: 'DELETE', headers: SB_H });
      return r.ok;
    } catch { return false; }
  }
  async function sbUpsert(path: string, body: object) {
    try {
      const r = await fetch(`${SB_URL}/rest/v1/${path}`, {
        method: 'POST',
        headers: { ...SB_H, Prefer: 'return=representation,resolution=merge-duplicates' },
        body: JSON.stringify(body),
      });
      return r.ok ? await r.json() : null;
    } catch { return null; }
  }

  // ── Realtime ──
  let _sb: any = null;
  let _ordersChannel: any = null;

  function loadSupabaseSDK(): Promise<void> {
    return new Promise((resolve) => {
      if ((window as any).supabase) {
        _sb = (window as any).supabase.createClient(SB_URL, SB_KEY);
        resolve(); return;
      }
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js';
      s.onload = () => { _sb = (window as any).supabase.createClient(SB_URL, SB_KEY); resolve(); };
      s.onerror = () => resolve();
      document.head.appendChild(s);
    });
  }

  function subscribeOrders() {
    if (!_sb || !currentStore) { startOrdersPolling(); return; }
    if (_ordersChannel) { try { _sb.removeChannel(_ordersChannel); } catch {} }

    _ordersChannel = _sb
      .channel(`merchant-orders-${currentStore.id}`)
      .on('postgres_changes', {
        event: 'INSERT', schema: 'public', table: 'orders',
        filter: `store_id=eq.${currentStore.id}`,
      }, (payload: any) => {
        const o = payload.new || {};
        playChime();
        toast('🔔 طلب جديد وصل!', 4000);
        showBrowserNotification(
          '🛎️ طلب جديد في ' + (currentStore.name || 'متجرك'),
          `${o.customer_name || 'عميل جديد'} · ${o.total || 0} ج.م`,
          '/merchant-dashboard'
        );
        loadOrders(false);
      })
      .on('postgres_changes', {
        event: 'UPDATE', schema: 'public', table: 'orders',
        filter: `store_id=eq.${currentStore.id}`,
      }, () => loadOrders(false))
      .subscribe((status: string) => {
        if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
          if (!ordersPollTimer) startOrdersPolling();
        } else if (status === 'SUBSCRIBED') {
          if (ordersPollTimer) { clearInterval(ordersPollTimer); ordersPollTimer = null; }
        }
      });
  }

  async function requestNotificationPermission() {
    if (!('Notification' in window)) return;
    if (Notification.permission === 'default') {
      await Notification.requestPermission();
    }
  }

  function showBrowserNotification(title: string, body: string, url = '/merchant-dashboard') {
    if (!('Notification' in window) || Notification.permission !== 'granted') return;
    try {
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.ready.then(reg => {
          reg.showNotification(title, {
            body, icon: '/icon-192.png', badge: '/icon-192.png',
            tag: 'wslha-order', dir: 'rtl', lang: 'ar',
            data: { url },
          } as any);
        });
      } else {
        const n = new Notification(title, { body, icon: '/icon-192.png', dir: 'rtl', lang: 'ar' });
        n.onclick = () => { window.focus(); n.close(); };
      }
    } catch {}
  }

  // ── State ──
  let currentStore: any = null;
  let sections: any[]   = [];
  let products: any[]   = [];

  // ── Show/Hide sections ──
  function show(id: string) { document.getElementById(id)!.hidden = false; }
  function hide(id: string) { document.getElementById(id)!.hidden = true; }

  // ── Init ──
  async function init() {
    // Check login
    let user: any = null;
    try { user = JSON.parse(localStorage.getItem('wslha_user') || 'null'); } catch {}

    hide('md-loading');
    if (!user?.phone) { show('md-gate'); return; }

    // Check if they have a store
    const stores = await sbGet(`stores?owner_phone=eq.${encodeURIComponent(user.phone)}&limit=1`);
    if (!stores || stores.length === 0) {
      // No store yet — show registration
      show('md-register');
      initRegisterForm(user.phone);
      return;
    }

    currentStore = stores[0];
    await loadDashboard();
  }

  // ── Register new store ──
  function initRegisterForm(ownerPhone: string) {
    document.getElementById('reg-submit')!.addEventListener('click', async () => {
      const btn = document.getElementById('reg-submit') as HTMLButtonElement;
      const errEl = document.getElementById('reg-error')!;
      errEl.style.display = 'none';

      const name    = (document.getElementById('reg-name') as HTMLInputElement).value.trim();
      const emoji   = (document.getElementById('reg-emoji') as HTMLInputElement).value.trim() || '🏪';
      const catId   = (document.getElementById('reg-cat') as HTMLSelectElement).value;
      const area    = (document.getElementById('reg-area') as HTMLSelectElement).value;
      const address = (document.getElementById('reg-address') as HTMLInputElement).value.trim();
      const phone   = (document.getElementById('reg-phone') as HTMLInputElement).value.trim();
      const fee     = parseInt((document.getElementById('reg-fee') as HTMLInputElement).value) || 20;
      const minOrd  = parseInt((document.getElementById('reg-min') as HTMLInputElement).value) || 50;
      const time    = (document.getElementById('reg-time') as HTMLInputElement).value.trim() || '30–45 دقيقة';
      const tagline = (document.getElementById('reg-tagline') as HTMLInputElement).value.trim();

      if (!name) { errEl.textContent = 'يرجى إدخال اسم المتجر'; errEl.style.display = 'block'; return; }

      btn.disabled = true; btn.textContent = 'جاري التسجيل...';

      const storeId = name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '') + '-' + Date.now().toString(36);
      const rows = await sbUpsert('stores', {
        id: storeId, name, emoji,
        category: CAT_LABELS[catId] || catId, category_id: catId,
        area, address, phone, owner_phone: ownerPhone,
        delivery_fee: fee, min_order: minOrd,
        delivery_time: time, tagline,
        rating: 5.0, reviews: 0,
        is_open: true, is_active: true,
      });

      if (!rows) {
        errEl.textContent = 'حدث خطأ أثناء التسجيل — تحقق من الاتصال وأعد المحاولة';
        errEl.style.display = 'block';
        btn.disabled = false; btn.textContent = '🚀 تسجيل المتجر الآن';
        return;
      }

      currentStore = Array.isArray(rows) ? rows[0] : rows;
      hide('md-register');
      await loadDashboard();
    });
  }

  // ── Load dashboard ──
  async function loadDashboard() {
    show('md-dash');

    // Header
    document.getElementById('dh-emoji')!.textContent  = currentStore.emoji || '🏪';
    document.getElementById('dh-name')!.textContent   = currentStore.name;
    document.getElementById('dh-area')!.textContent   = `📍 ${currentStore.area} — ${currentStore.address || ''}`;
    (document.getElementById('dh-view-link') as HTMLAnchorElement).href = `/store/${currentStore.id}`;

    // Open/closed toggle
    updateOpenToggle(currentStore.is_open);
    document.getElementById('open-toggle')!.addEventListener('click', toggleOpen);

    // Stats
    document.getElementById('stat-rating')!.textContent = '★ ' + (currentStore.rating || 5.0).toFixed(1);
    loadStats();

    // Settings tab prefill
    prefillSettings();

    // Load sections & products
    await loadMenu();

    // Load orders + start Realtime (with polling fallback)
    await loadOrders();
    loadSupabaseSDK().then(() => subscribeOrders());
    requestNotificationPermission();

    // Tabs
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const tab = (btn as HTMLElement).dataset.tab;
        document.getElementById('tab-' + tab)!.classList.add('active');
        if (tab === 'account') loadMerchantAccountData();
      });
    });

    // Load approval status
    loadMerchantApprovalStatus();

    // Add section
    document.getElementById('add-section-btn')!.addEventListener('click', () => {
      const f = document.getElementById('add-section-form')!;
      f.style.display = f.style.display === 'none' ? 'block' : 'none';
      if (f.style.display === 'block') (document.getElementById('new-section-name') as HTMLInputElement).focus();
    });
    document.getElementById('cancel-section-btn')!.addEventListener('click', () => {
      document.getElementById('add-section-form')!.style.display = 'none';
    });
    document.getElementById('save-section-btn')!.addEventListener('click', saveNewSection);

    // Settings save
    document.getElementById('save-settings-btn')!.addEventListener('click', saveSettings);
  }

  function updateOpenToggle(isOpen: boolean) {
    const tog = document.getElementById('open-toggle')!;
    const lbl = document.getElementById('open-label')!;
    tog.className = 'open-toggle ' + (isOpen ? 'open' : 'closed');
    lbl.textContent = isOpen ? 'المتجر مفتوح' : 'المتجر مغلق';
  }

  async function toggleOpen() {
    const newState = !currentStore.is_open;
    const ok = await sbPatch(`stores?id=eq.${currentStore.id}`, { is_open: newState });
    if (ok) { currentStore.is_open = newState; updateOpenToggle(newState); toast(newState ? '✅ المتجر مفتوح الآن' : '🔴 المتجر مغلق'); }
    else toast('❌ فشل تحديث الحالة');
  }

  async function loadStats() {
    const today = new Date().toISOString().split('T')[0];
    const [todayOrd, allProd] = await Promise.all([
      sbGet(`orders?store_id=eq.${currentStore.id}&created_at=gte.${today}&status=in.(delivered,completed)&select=total,subtotal`),
      sbGet(`products?store_id=eq.${currentStore.id}&select=is_available`),
    ]);
    const todayRevenue = (todayOrd || []).reduce((s: number, o: any) => s + (o.subtotal || o.total || 0), 0);
    const availCount   = (allProd || []).filter((p: any) => p.is_available).length;
    const totalCount   = (allProd || []).length;
    document.getElementById('stat-orders')!.textContent  = String((todayOrd || []).length);
    document.getElementById('stat-revenue')!.textContent = todayRevenue + ' ج.م';
    document.getElementById('stat-products')!.textContent = `${availCount} / ${totalCount}`;
  }

  // ── Menu management ──
  async function loadMenu() {
    const [secs, prods] = await Promise.all([
      sbGet(`menu_sections?store_id=eq.${currentStore.id}&order=sort_order`),
      sbGet(`products?store_id=eq.${currentStore.id}&order=sort_order`),
    ]);
    sections = secs || [];
    products = prods || [];
    renderMenu();
  }

  function renderMenu() {
    const container = document.getElementById('sections-container')!;
    if (!sections.length) {
      container.innerHTML = '<div style="text-align:center;padding:var(--sp-10);color:var(--color-text-faint);">لا توجد أقسام — أضف قسماً للبدء</div>';
      return;
    }

    container.innerHTML = sections.map(sec => {
      const secProducts = products.filter(p => p.section_id === sec.id);
      const productRows = secProducts.map(p => `
        <div class="product-row" data-pid="${p.id}">
          <span class="product-emoji">${p.emoji || '📦'}</span>
          <div class="product-info">
            <div class="product-name">${p.name}</div>
            <div class="product-desc">${p.description || ''}</div>
          </div>
          <span class="product-price">${p.price} ج.م</span>
          <div class="product-actions">
            <button class="avail-toggle ${p.is_available ? 'on' : ''}" data-pid="${p.id}" title="${p.is_available ? 'متاح' : 'غير متاح'}"></button>
            <button class="btn-ghost edit-product-btn" data-pid="${p.id}">✏️</button>
            <button class="btn-danger del-product-btn" data-pid="${p.id}">🗑️</button>
          </div>
        </div>
        <div id="edit-${p.id}" class="add-product-row inline-edit" style="display:none;">
          <div class="form-row">
            <input class="field__input" id="ep-name-${p.id}" value="${p.name}" placeholder="اسم المنتج" />
            <input class="field__input" id="ep-emoji-${p.id}" value="${p.emoji || '📦'}" placeholder="إيموجي" maxlength="4" />
          </div>
          <div class="form-row">
            <input class="field__input" id="ep-price-${p.id}" type="number" value="${p.price}" placeholder="السعر" min="0" />
            <input class="field__input" id="ep-desc-${p.id}" value="${p.description || ''}" placeholder="وصف (اختياري)" />
          </div>
          <div style="display:flex;gap:var(--sp-2);margin-top:var(--sp-2);">
            <button class="btn-primary save-product-edit-btn" data-pid="${p.id}">💾 حفظ</button>
            <button class="btn-ghost cancel-product-edit-btn" data-pid="${p.id}">إلغاء</button>
          </div>
        </div>
      `).join('');

      return `
        <div class="section-block" data-sid="${sec.id}">
          <div class="section-block__header">
            <span class="section-block__name">📂 ${sec.name} <span style="color:var(--color-text-faint);font-size:11px;">(${secProducts.length} منتج)</span></span>
            <div class="section-block__actions">
              <button class="btn-ghost add-product-btn" data-sid="${sec.id}">+ منتج</button>
              <button class="btn-danger del-section-btn" data-sid="${sec.id}">حذف القسم</button>
            </div>
          </div>
          ${productRows}
          <div id="add-prod-${sec.id}" class="add-product-row">
            <div class="form-row" style="margin-bottom:var(--sp-3);">
              <input class="field__input" id="np-name-${sec.id}" placeholder="اسم المنتج *" />
              <input class="field__input" id="np-emoji-${sec.id}" placeholder="🍕" maxlength="4" />
            </div>
            <div class="form-row" style="margin-bottom:var(--sp-3);">
              <input class="field__input" id="np-price-${sec.id}" type="number" placeholder="السعر (ج.م) *" min="0" />
              <input class="field__input" id="np-desc-${sec.id}" placeholder="وصف (اختياري)" />
            </div>
            <div style="display:flex;gap:var(--sp-2);">
              <button class="btn-primary save-product-btn" data-sid="${sec.id}">✅ إضافة</button>
              <button class="btn-ghost cancel-product-btn" data-sid="${sec.id}">إلغاء</button>
            </div>
          </div>
        </div>
      `;
    }).join('');

    // Bind events
    bindMenuEvents();
  }

  function bindMenuEvents() {
    // Add product toggle
    document.querySelectorAll('.add-product-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const sid = (btn as HTMLElement).dataset.sid!;
        const row = document.getElementById(`add-prod-${sid}`)!;
        row.classList.toggle('visible');
        if (row.classList.contains('visible')) (document.getElementById(`np-name-${sid}`) as HTMLInputElement).focus();
      });
    });
    document.querySelectorAll('.cancel-product-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const row = document.getElementById(`add-prod-${(btn as HTMLElement).dataset.sid!}`)!;
        row.classList.remove('visible');
      });
    });

    // Save new product
    document.querySelectorAll('.save-product-btn').forEach(btn => {
      btn.addEventListener('click', () => saveNewProduct((btn as HTMLElement).dataset.sid!));
    });

    // Delete section
    document.querySelectorAll('.del-section-btn').forEach(btn => {
      btn.addEventListener('click', () => deleteSection((btn as HTMLElement).dataset.sid!));
    });

    // Availability toggle
    document.querySelectorAll('.avail-toggle').forEach(btn => {
      btn.addEventListener('click', async () => {
        const pid = (btn as HTMLElement).dataset.pid!;
        const isOn = btn.classList.contains('on');
        const ok = await sbPatch(`products?id=eq.${pid}`, { is_available: !isOn });
        if (ok) {
          btn.classList.toggle('on');
          const p = products.find(p => p.id === pid);
          if (p) p.is_available = !isOn;
          toast(isOn ? '⛔ المنتج غير متاح' : '✅ المنتج متاح');
          loadStats();
        }
      });
    });

    // Edit product
    document.querySelectorAll('.edit-product-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pid = (btn as HTMLElement).dataset.pid!;
        const row = document.getElementById(`edit-${pid}`)!;
        row.style.display = row.style.display === 'none' ? 'block' : 'none';
      });
    });
    document.querySelectorAll('.save-product-edit-btn').forEach(btn => {
      btn.addEventListener('click', () => saveProductEdit((btn as HTMLElement).dataset.pid!));
    });
    document.querySelectorAll('.cancel-product-edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById(`edit-${(btn as HTMLElement).dataset.pid!}`)!.style.display = 'none';
      });
    });

    // Delete product
    document.querySelectorAll('.del-product-btn').forEach(btn => {
      btn.addEventListener('click', () => deleteProduct((btn as HTMLElement).dataset.pid!));
    });
  }

  async function saveNewSection() {
    const input = document.getElementById('new-section-name') as HTMLInputElement;
    const name  = input.value.trim();
    if (!name) { toast('❌ أدخل اسم القسم'); return; }

    const rows = await sbPost('menu_sections', {
      store_id: currentStore.id, name, sort_order: sections.length,
    });
    if (rows?.[0]) {
      sections.push(rows[0]);
      input.value = '';
      document.getElementById('add-section-form')!.style.display = 'none';
      renderMenu();
      toast('✅ تم إضافة القسم');
    } else toast('❌ فشل إضافة القسم');
  }

  async function deleteSection(sid: string) {
    if (!confirm('هل تريد حذف هذا القسم وكل منتجاته؟')) return;
    const ok = await sbDel(`menu_sections?id=eq.${sid}`);
    if (ok) {
      sections = sections.filter(s => s.id !== sid);
      products = products.filter(p => p.section_id !== sid);
      renderMenu();
      toast('🗑️ تم حذف القسم');
    } else toast('❌ فشل حذف القسم');
  }

  async function saveNewProduct(sid: string) {
    const name  = (document.getElementById(`np-name-${sid}`) as HTMLInputElement).value.trim();
    const emoji = (document.getElementById(`np-emoji-${sid}`) as HTMLInputElement).value.trim() || '📦';
    const price = parseInt((document.getElementById(`np-price-${sid}`) as HTMLInputElement).value) || 0;
    const desc  = (document.getElementById(`np-desc-${sid}`) as HTMLInputElement).value.trim();

    if (!name || !price) { toast('❌ اسم المنتج والسعر مطلوبان'); return; }

    const secProds = products.filter(p => p.section_id === sid);
    const rows = await sbPost('products', {
      store_id: currentStore.id, section_id: sid,
      name, emoji, price, description: desc || null,
      is_available: true, sort_order: secProds.length,
    });
    if (rows?.[0]) {
      products.push(rows[0]);
      renderMenu();
      loadStats();
      toast('✅ تم إضافة المنتج');
    } else toast('❌ فشل إضافة المنتج');
  }

  async function saveProductEdit(pid: string) {
    const name  = (document.getElementById(`ep-name-${pid}`) as HTMLInputElement).value.trim();
    const emoji = (document.getElementById(`ep-emoji-${pid}`) as HTMLInputElement).value.trim() || '📦';
    const price = parseInt((document.getElementById(`ep-price-${pid}`) as HTMLInputElement).value) || 0;
    const desc  = (document.getElementById(`ep-desc-${pid}`) as HTMLInputElement).value.trim();

    if (!name || !price) { toast('❌ الاسم والسعر مطلوبان'); return; }

    const ok = await sbPatch(`products?id=eq.${pid}`, { name, emoji, price, description: desc || null });
    if (ok) {
      const p = products.find(p => p.id === pid);
      if (p) Object.assign(p, { name, emoji, price, description: desc });
      renderMenu();
      toast('✅ تم تحديث المنتج');
    } else toast('❌ فشل تحديث المنتج');
  }

  async function deleteProduct(pid: string) {
    if (!confirm('هل تريد حذف هذا المنتج؟')) return;
    const ok = await sbDel(`products?id=eq.${pid}`);
    if (ok) {
      products = products.filter(p => p.id !== pid);
      renderMenu();
      loadStats();
      toast('🗑️ تم حذف المنتج');
    } else toast('❌ فشل حذف المنتج');
  }

  // ── Orders (real-time) ──
  const STATUS_LABEL: Record<string, string> = {
    pending:'قيد الانتظار', preparing:'قيد التجهيز', on_the_way:'في الطريق',
    delivered:'تم التوصيل', rejected:'مرفوض',
  };

  let knownPendingIds = new Set<string>();
  let ordersPollTimer: any = null;
  let audioCtx: AudioContext | null = null;

  function soundEnabled(): boolean {
    const el = document.getElementById('sound-toggle') as HTMLInputElement | null;
    return el ? el.checked : true;
  }

  // Short two-tone chime via Web Audio (no asset needed)
  function playChime() {
    if (!soundEnabled()) return;
    try {
      audioCtx = audioCtx || new (window.AudioContext || (window as any).webkitAudioContext)();
      const now = audioCtx.currentTime;
      [[880, 0], [1320, 0.16]].forEach(([freq, t]) => {
        const osc = audioCtx!.createOscillator();
        const gain = audioCtx!.createGain();
        osc.type = 'sine'; osc.frequency.value = freq as number;
        gain.gain.setValueAtTime(0.0001, now + (t as number));
        gain.gain.exponentialRampToValueAtTime(0.3, now + (t as number) + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + (t as number) + 0.32);
        osc.connect(gain); gain.connect(audioCtx!.destination);
        osc.start(now + (t as number)); osc.stop(now + (t as number) + 0.34);
      });
    } catch {}
    if (navigator.vibrate) navigator.vibrate([120, 60, 120]);
  }

  function timeAgo(iso: string): string {
    if (!iso) return '';
    const diff = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    if (diff < 60) return 'الآن';
    if (diff < 3600) return `منذ ${Math.floor(diff / 60)} دقيقة`;
    return new Date(iso).toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
  }

  function renderItems(o: any): string {
    let items: any[] = [];
    try { items = Array.isArray(o.items) ? o.items : JSON.parse(o.items || '[]'); } catch {}
    if (items.length) return items.map(i => `${i.qty}× ${i.emoji || ''} ${i.name}`).join('<br>');
    return o.items_summary || '—';
  }

  async function loadOrders(announce = false) {
    const orders = await sbGet(`orders?store_id=eq.${currentStore.id}&order=created_at.desc&limit=40`);
    if (!orders) return;

    const pending  = orders.filter((o: any) => o.status === 'pending');
    const active   = orders.filter((o: any) => o.status === 'preparing' || o.status === 'on_the_way');
    const history  = orders.filter((o: any) => o.status === 'delivered' || o.status === 'rejected');

    // Detect genuinely new pending orders → chime
    const currentPendingIds = new Set<string>(pending.map((o: any) => o.id));
    if (announce) {
      const hasNew = pending.some((o: any) => !knownPendingIds.has(o.id));
      if (hasNew) { playChime(); toast('🔔 طلب جديد وصل!'); }
    }
    knownPendingIds = currentPendingIds;

    // Badge on tab
    const badge = document.getElementById('orders-badge')!;
    if (pending.length > 0) { badge.hidden = false; badge.textContent = String(pending.length); }
    else badge.hidden = true;

    // ── New orders (need accept/reject) ──
    const newWrap = document.getElementById('new-orders')!;
    newWrap.innerHTML = pending.map((o: any) => `
      <div class="new-order ringing" data-oid="${o.id}">
        <div class="new-order__head">
          <span class="new-order__code">🆕 ${o.code || ('#' + String(o.id).slice(-6))}</span>
          <span class="new-order__time">${timeAgo(o.created_at)}</span>
        </div>
        <div class="new-order__cust">
          <b>${o.customer_name || '—'}</b> · ${o.customer_phone || ''}<br>
          📍 ${o.area || ''} — ${o.address || ''}
        </div>
        <div class="new-order__items">${renderItems(o)}</div>
        <div class="new-order__total">
          <span>الإجمالي (${o.payment || 'كاش'})</span>
          <b>${o.total || 0} ج.م</b>
        </div>
        <div class="new-order__actions">
          <button class="btn-accept" data-accept="${o.id}">✅ قبول وتجهيز</button>
          <button class="btn-reject" data-reject="${o.id}">✗ رفض</button>
        </div>
      </div>
    `).join('');

    newWrap.querySelectorAll('[data-accept]').forEach(b =>
      b.addEventListener('click', () => acceptOrder((b as HTMLElement).dataset.accept!)));
    newWrap.querySelectorAll('[data-reject]').forEach(b =>
      b.addEventListener('click', () => rejectOrder((b as HTMLElement).dataset.reject!)));

    // ── Active orders ──
    const activeWrap  = document.getElementById('active-orders')!;
    const activeTitle = document.getElementById('active-orders-title')!;
    activeTitle.hidden = active.length === 0;
    activeWrap.innerHTML = active.map((o: any) => {
      const statusBit = o.status === 'preparing'
        ? (o.driver_phone
            ? `<span class="ao-driver">🛵 السائق ${o.driver_name || ''} في الطريق للاستلام</span>`
            : `<span class="searching-pill"><span class="dot"></span> جارٍ البحث عن سائق…</span>`)
        : `<span class="ao-driver">🚗 ${o.driver_name || 'السائق'} — في الطريق للعميل</span>`;
      const readyBtn = o.status === 'preparing'
        ? `<button class="btn-ready" data-ready="${o.id}">📦 الطلب جاهز للتسليم</button>` : '';
      return `
        <div class="active-order" data-oid="${o.id}">
          <div class="active-order__info">
            <div class="active-order__code">${o.code || ('#' + String(o.id).slice(-6))} · <span class="order-status ${o.status}">${STATUS_LABEL[o.status]}</span></div>
            <div class="active-order__meta">${o.customer_name || ''} · ${o.total || 0} ج.م · ${o.area || ''}</div>
            <div style="margin-top:4px;">${statusBit}</div>
          </div>
          ${readyBtn}
        </div>`;
    }).join('');

    activeWrap.querySelectorAll('[data-ready]').forEach(b =>
      b.addEventListener('click', () => markReady((b as HTMLElement).dataset.ready!)));

    // ── History ──
    const container = document.getElementById('orders-container')!;
    if (!history.length) {
      container.innerHTML = '<div style="padding:var(--sp-8);text-align:center;color:var(--color-text-faint);">لا يوجد سجل بعد</div>';
    } else {
      container.innerHTML = history.map((o: any) => `
        <div class="order-row">
          <span class="order-id">${o.code || ('#' + String(o.id).slice(-6))}</span>
          <div class="order-cust">
            <div style="font-weight:600;">${o.customer_name || '—'}</div>
            <div style="font-size:11px;color:var(--color-text-faint);">${o.customer_phone || ''} · ${o.area || ''}</div>
          </div>
          <span class="order-total">${o.total || 0} ج.م</span>
          <span class="order-status ${o.status}">${STATUS_LABEL[o.status] || o.status}</span>
        </div>
      `).join('');
    }
  }

  // Merchant accepts → preparing + becomes visible to drivers (broadcast)
  async function acceptOrder(id: string) {
    const ok = await sbPatch(`orders?id=eq.${id}`, {
      status: 'preparing', accepted_at: new Date().toISOString(),
    });
    if (ok) { toast('✅ تم قبول الطلب — جارٍ البحث عن سائق'); knownPendingIds.delete(id); await loadOrders(); loadStats(); }
    else toast('❌ فشل قبول الطلب');
  }

  async function rejectOrder(id: string) {
    if (!confirm('هل تريد رفض هذا الطلب؟')) return;
    const ok = await sbPatch(`orders?id=eq.${id}`, {
      status: 'rejected', rejected_at: new Date().toISOString(),
    });
    if (ok) { toast('تم رفض الطلب'); knownPendingIds.delete(id); await loadOrders(); }
    else toast('❌ فشل رفض الطلب');
  }

  async function markReady(id: string) {
    const ok = await sbPatch(`orders?id=eq.${id}`, { ready_at: new Date().toISOString() });
    if (ok) { toast('📦 تم وسم الطلب كجاهز'); await loadOrders(); }
  }

  function startOrdersPolling() {
    if (ordersPollTimer) return;
    ordersPollTimer = setInterval(() => loadOrders(true), 5000);
  }

  // ── Settings ──
  function prefillSettings() {
    const s = currentStore;
    (document.getElementById('set-name') as HTMLInputElement).value    = s.name || '';
    (document.getElementById('set-emoji') as HTMLInputElement).value   = s.emoji || '🏪';
    (document.getElementById('set-phone') as HTMLInputElement).value   = s.phone || '';
    (document.getElementById('set-address') as HTMLInputElement).value = s.address || '';
    (document.getElementById('set-fee') as HTMLInputElement).value     = String(s.delivery_fee || 20);
    (document.getElementById('set-min') as HTMLInputElement).value     = String(s.min_order || 50);
    (document.getElementById('set-time') as HTMLInputElement).value    = s.delivery_time || '30–45 دقيقة';
    (document.getElementById('set-tagline') as HTMLInputElement).value = s.tagline || '';
  }

  async function saveSettings() {
    const patch = {
      name:          (document.getElementById('set-name') as HTMLInputElement).value.trim(),
      emoji:         (document.getElementById('set-emoji') as HTMLInputElement).value.trim(),
      phone:         (document.getElementById('set-phone') as HTMLInputElement).value.trim(),
      address:       (document.getElementById('set-address') as HTMLInputElement).value.trim(),
      delivery_fee:  parseInt((document.getElementById('set-fee') as HTMLInputElement).value) || 20,
      min_order:     parseInt((document.getElementById('set-min') as HTMLInputElement).value) || 0,
      delivery_time: (document.getElementById('set-time') as HTMLInputElement).value.trim(),
      tagline:       (document.getElementById('set-tagline') as HTMLInputElement).value.trim(),
    };
    const ok = await sbPatch(`stores?id=eq.${currentStore.id}`, patch);
    if (ok) {
      Object.assign(currentStore, patch);
      document.getElementById('dh-emoji')!.textContent = patch.emoji;
      document.getElementById('dh-name')!.textContent  = patch.name;
      toast('✅ تم حفظ الإعدادات');
    } else toast('❌ فشل حفظ الإعدادات');
  }

  // ── Approval status ──
  async function loadMerchantApprovalStatus() {
    let user: any = null;
    try { user = JSON.parse(localStorage.getItem('wslha_user') || 'null'); } catch {}
    if (!user?.phone) return;
    try {
      const rows = await sbGet(`merchant_applications?phone=eq.${encodeURIComponent(user.phone)}&select=status&order=created_at.desc&limit=1`);
      const banner = document.getElementById('merchant-approval-banner')!;
      if (!rows || rows.length === 0) { banner.style.display = 'none'; return; }
      const { status } = rows[0];
      const configs: Record<string, {cls:string;icon:string;title:string;sub:string}> = {
        pending:  { cls:'pending',  icon:'⏳', title:'طلبك قيد المراجعة',    sub:'يراجع فريق وصّلها وثائقك خلال 2-3 أيام عمل.' },
        approved: { cls:'approved', icon:'✅', title:'تم اعتماد متجرك!',      sub:'يمكنك الآن استقبال الطلبات ونشر منتجاتك.' },
        rejected: { cls:'rejected', icon:'❌', title:'تم رفض طلبك',           sub:'يرجى التواصل مع الدعم. <a href="/contact" style="color:#991B1B;font-weight:700">تواصل معنا</a>' },
      };
      const c = configs[status] || configs.pending;
      banner.innerHTML = `<div class="approval-banner ${c.cls}"><div class="approval-banner__icon">${c.icon}</div><div><div class="approval-banner__title">${c.title}</div><div class="approval-banner__sub">${c.sub}</div></div></div>`;
      banner.style.display = 'block';
    } catch {}
  }

  // ── Merchant account data (wallet, points, ratings) ──
  async function loadMerchantAccountData() {
    let user: any = null;
    try { user = JSON.parse(localStorage.getItem('wslha_user') || 'null'); } catch {}
    if (!user?.phone) return;
    const phone = encodeURIComponent(user.phone);

    const [walletRes, walletTxRes, pointsRes, pointsTxRes, ratingsRes, salesRes] = await Promise.allSettled([
      sbGet(`wallets?phone=eq.${phone}&select=balance`),
      sbGet(`wallet_transactions?phone=eq.${phone}&select=amount,type,note,created_at&order=created_at.desc&limit=10`),
      sbGet(`points?phone=eq.${phone}&select=total_points`),
      sbGet(`point_transactions?phone=eq.${phone}&select=points,type,created_at&order=created_at.desc&limit=10`),
      currentStore?.id
        ? sbGet(`ratings?store_id=eq.${encodeURIComponent(currentStore.id)}&store_rating=not.is.null&select=store_rating,comment,order_code,created_at&order=created_at.desc&limit=10`)
        : Promise.resolve(null),
      currentStore?.id
        ? sbGet(`orders?store_id=eq.${encodeURIComponent(currentStore.id)}&status=in.(delivered,completed)&select=total,created_at&order=created_at.desc&limit=1000`)
        : Promise.resolve(null),
    ]);

    // Wallet
    if (walletRes.status === 'fulfilled') {
      const b = (walletRes.value as any)?.[0]?.balance ?? 0;
      document.getElementById('m-wallet-balance')!.textContent = Number(b).toLocaleString('ar-EG');
    }
    if (walletTxRes.status === 'fulfilled') {
      const txs = walletTxRes.value as any[];
      const el  = document.getElementById('m-wallet-txs')!;
      if (Array.isArray(txs) && txs.length) {
        el.innerHTML = txs.map(t => {
          const amt = Number(t.amount); const sign = amt >= 0 ? '+' : ''; const cls = amt >= 0 ? 'pos' : 'neg';
          const d = new Date(t.created_at).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' });
          const lbl = ({commission:'عمولة منصة',earning:'أرباح',topup:'إضافة رصيد',withdrawal:'سحب',refund:'استرداد'} as any)[t.type] || t.type;
          return `<div class="acct-tx"><span class="acct-tx__note">${t.note || lbl}</span><span class="acct-tx__date">${d}</span><span class="acct-tx__amt ${cls}">${sign}${Math.abs(amt)} ج.م</span></div>`;
        }).join('');
      }
    }
    // Points
    if (pointsRes.status === 'fulfilled') {
      const p = (pointsRes.value as any)?.[0]?.total_points ?? 0;
      document.getElementById('m-points-total')!.textContent = Number(p).toLocaleString('ar-EG');
    }
    if (pointsTxRes.status === 'fulfilled') {
      const ptxs = pointsTxRes.value as any[];
      const el   = document.getElementById('m-points-txs')!;
      if (Array.isArray(ptxs) && ptxs.length) {
        el.innerHTML = ptxs.map(t => {
          const p = Number(t.points); const sign = p >= 0 ? '+' : ''; const cls = p >= 0 ? 'pos' : 'neg';
          const d = new Date(t.created_at).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' });
          const lbl = ({ride:'مشوار',delivery:'توصيل',airport:'مطار',bonus:'مكافأة',redeem:'استبدال'} as any)[t.type] || t.type;
          return `<div class="acct-tx"><span class="acct-tx__note">${lbl}</span><span class="acct-tx__date">${d}</span><span class="acct-tx__amt ${cls}">${sign}${Math.abs(p)} نقطة</span></div>`;
        }).join('');
      }
    }
    // Store ratings (order.store_rating — customers rate the store after delivery)
    if (ratingsRes.status === 'fulfilled') {
      const rts = ratingsRes.value as any[];
      if (Array.isArray(rts) && rts.length) {
        const avg = rts.reduce((s: number, r: any) => s + r.store_rating, 0) / rts.length;
        const stars = '⭐'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg));
        document.getElementById('m-rating-avg')!.textContent   = avg.toFixed(1);
        document.getElementById('m-rating-stars')!.textContent = stars;
        document.getElementById('m-rating-count')!.textContent = `${rts.length} تقييم`;
        document.getElementById('m-ratings-list')!.innerHTML = rts.map((r: any) => {
          const d = new Date(r.created_at).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' });
          const s = '⭐'.repeat(r.store_rating) + '☆'.repeat(5 - r.store_rating);
          return `<div class="rating-item"><div class="rating-item__top"><span class="rating-item__stars">${s}</span><span class="rating-item__date">${d}</span></div>${r.comment ? `<div class="rating-item__comment">"${escapeHtml(r.comment)}"</div>` : ''}</div>`;
        }).join('');
      }
    }
    // Monthly/weekly sales
    if (salesRes.status === 'fulfilled') {
      renderMerchantSales((salesRes.value as any[]) || []);
    }
  }

  const MONTHS_AR_M = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
  let _merchantSalesData: any[] = [];

  function renderMerchantSales(orders: any[]) {
    const monthMap: Record<string, any> = {};
    orders.forEach(o => {
      const d = new Date(o.created_at || 0);
      const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
      if (!monthMap[key]) monthMap[key] = { label: MONTHS_AR_M[d.getMonth()] + ' ' + d.getFullYear(), count: 0, spent: 0, weeks: {} as Record<string, any> };
      monthMap[key].count++;
      monthMap[key].spent += Number(o.total) || 0;
      const wn = Math.ceil(d.getDate() / 7);
      const wkey = 'w' + wn;
      if (!monthMap[key].weeks[wkey]) monthMap[key].weeks[wkey] = { label: 'الأسبوع ' + wn, count: 0, spent: 0 };
      monthMap[key].weeks[wkey].count++;
      monthMap[key].weeks[wkey].spent += Number(o.total) || 0;
    });

    _merchantSalesData = Object.entries(monthMap).sort((a, b) => b[0].localeCompare(a[0])).slice(0, 12);
    const tbody = document.getElementById('m-sales-tbody')!;
    if (!_merchantSalesData.length) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--color-text-faint);padding:1rem">لا توجد بيانات بعد</td></tr>';
      return;
    }
    tbody.innerHTML = _merchantSalesData.map(([, m]: [string, any], i: number) => {
      const avg = m.count ? Math.round(m.spent / m.count) : 0;
      const weekRows = Object.values(m.weeks).map((w: any) => {
        const wavg = w.count ? Math.round(w.spent / w.count) : 0;
        return `<tr class="m-sales-week-row" data-month="${i}" style="display:none"><td style="padding-right:2rem;color:var(--color-text-faint)">↳ ${w.label}</td><td>${w.count}</td><td>${Math.round(w.spent).toLocaleString('ar-EG')} ج.م</td><td>${wavg.toLocaleString('ar-EG')} ج.م</td></tr>`;
      }).join('');
      return `<tr class="m-sales-row" data-month="${i}" style="cursor:pointer;border-bottom:1px solid #E3EDEC" onclick="toggleMerchantSalesWeeks(${i})">
          <td style="padding:.5rem .75rem">▸ ${m.label}</td><td style="padding:.5rem .75rem">${m.count}</td><td style="padding:.5rem .75rem">${Math.round(m.spent).toLocaleString('ar-EG')} ج.م</td><td style="padding:.5rem .75rem">${avg.toLocaleString('ar-EG')} ج.م</td>
        </tr>${weekRows}`;
    }).join('');
  }

  function toggleMerchantSalesWeeks(i: number) {
    const rows = document.querySelectorAll(`.m-sales-week-row[data-month="${i}"]`) as NodeListOf<HTMLElement>;
    const isHidden = rows.length > 0 && rows[0].style.display === 'none';
    rows.forEach(r => r.style.display = isHidden ? '' : 'none');
    const arrowCell = document.querySelector(`.m-sales-row[data-month="${i}"] td:first-child`);
    if (arrowCell) arrowCell.textContent = arrowCell.textContent!.replace(isHidden ? '▸' : '▾', isHidden ? '▾' : '▸');
  }
  // The whole script is bundled as an ES module, so plain function
  // declarations aren't reachable from onclick="..." attributes (which
  // resolve names against the global scope) — expose explicitly.
  (window as any).toggleMerchantSalesWeeks = toggleMerchantSalesWeeks;

  function downloadMerchantSalesExcel() {
    if (!_merchantSalesData.length) return;
    const rows: any[][] = [['الشهر', 'الأسبوع', 'عدد الطلبات', 'إجمالي المبيعات (ج.م)', 'متوسط الطلب (ج.م)']];
    _merchantSalesData.forEach(([, m]: [string, any]) => {
      const avg = m.count ? Math.round(m.spent / m.count) : 0;
      rows.push([m.label, 'الإجمالي', m.count, Math.round(m.spent), avg]);
      Object.values(m.weeks).forEach((w: any) => {
        const wavg = w.count ? Math.round(w.spent / w.count) : 0;
        rows.push([m.label, w.label, w.count, Math.round(w.spent), wavg]);
      });
    });
    const csv = '﻿' + rows.map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'المبيعات-الشهرية.csv';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }
  document.getElementById('m-sales-export-btn')?.addEventListener('click', downloadMerchantSalesExcel);

  // ── Bootstrap ──
  init();
</script>
