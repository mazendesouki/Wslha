---
import Layout from '../components/layout.astro';
---

<style>
  /* ── Layout ── */
  .md-page { max-width: 1100px; margin: 0 auto; padding: var(--sp-8) var(--sp-5) var(--sp-20); }

  /* ── Auth gate ── */
  .gate {
    min-height: 60vh; display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: var(--sp-5); text-align: center;
  }
  .gate__icon  { font-size: 4rem; }
  .gate__title { font-size: var(--text-2xl); font-weight: var(--weight-black); }
  .gate__sub   { color: var(--color-text-faint); max-width: 400px; }
  .gate__btn   {
    background: var(--color-primary); color: #fff; border: none;
    border-radius: var(--radius-lg); padding: var(--sp-3) var(--sp-7);
    font-family: var(--font-body); font-weight: var(--weight-black);
    font-size: var(--text-base); cursor: pointer; text-decoration: none;
  }

  /* ── Register store form ── */
  .reg-card {
    background: var(--color-bg); border: 1.5px solid var(--color-border);
    border-radius: var(--radius-2xl); padding: var(--sp-8); max-width: 560px;
    margin: 0 auto; box-shadow: var(--shadow-md);
  }
  .reg-card__title { font-size: var(--text-xl); font-weight: var(--weight-black); margin-bottom: var(--sp-6); }

  /* ── Dashboard header ── */
  .dash-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--sp-6); flex-wrap: wrap; gap: var(--sp-4);
  }
  .dash-header__store { display: flex; align-items: center; gap: var(--sp-4); }
  .dash-header__emoji { font-size: 3rem; }
  .dash-header__name  { font-size: var(--text-2xl); font-weight: var(--weight-black); }
  .dash-header__area  { font-size: var(--text-sm); color: var(--color-text-faint); }

  .open-toggle {
    display: flex; align-items: center; gap: var(--sp-3);
    background: var(--color-bg); border: 2px solid var(--color-border);
    border-radius: var(--radius-xl); padding: var(--sp-3) var(--sp-5);
    font-weight: var(--weight-bold); font-size: var(--text-sm); cursor: pointer;
    transition: all 0.2s;
  }
  .open-toggle.open   { border-color: #16a34a; background: #dcfce7; color: #15803d; }
  .open-toggle.closed { border-color: #dc2626; background: #fee2e2; color: #b91c1c; }
  .open-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .open-toggle.open   .open-dot { background: #16a34a; }
  .open-toggle.closed .open-dot { background: #dc2626; }

  /* ── Stats strip ── */
  .stats-strip {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4); margin-bottom: var(--sp-7);
  }
  .stat-card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); padding: var(--sp-5);
  }
  .stat-card__label { font-size: var(--text-xs); color: var(--color-text-faint); margin-bottom: var(--sp-1); }
  .stat-card__val   { font-size: var(--text-2xl); font-weight: var(--weight-black); color: var(--color-primary); }
  .stat-card__sub   { font-size: 11px; color: var(--color-text-faint); margin-top: 2px; }

  /* ── Tabs ── */
  .tabs {
    display: flex; gap: 0; border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--sp-7); overflow-x: auto; scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab-btn {
    padding: var(--sp-3) var(--sp-6); background: none; border: none;
    font-family: var(--font-body); font-weight: var(--weight-bold);
    font-size: var(--text-sm); cursor: pointer; color: var(--color-text-faint);
    border-bottom: 3px solid transparent; margin-bottom: -2px;
    white-space: nowrap; transition: all 0.2s;
  }
  .tab-btn:hover  { color: var(--color-primary); }
  .tab-btn.active { color: var(--color-primary); border-bottom-color: var(--color-primary); }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ── Approval banner ── */
  .approval-banner {
    border-radius: var(--radius-xl); padding: var(--sp-4) var(--sp-5);
    display: flex; align-items: flex-start; gap: var(--sp-3);
    margin-bottom: var(--sp-5); box-shadow: var(--shadow-sm);
  }
  .approval-banner.pending  { background: #FEF9C3; border: 1.5px solid #FDE047; }
  .approval-banner.approved { background: #DCFCE7; border: 1.5px solid #86EFAC; }
  .approval-banner.rejected { background: #FEE2E2; border: 1.5px solid #FCA5A5; }
  .approval-banner__icon  { font-size: 1.8rem; flex-shrink: 0; }
  .approval-banner__title { font-weight: var(--weight-black); font-size: var(--text-sm); margin-bottom: 2px; }
  .approval-banner.pending  .approval-banner__title { color: #92400E; }
  .approval-banner.approved .approval-banner__title { color: #14532D; }
  .approval-banner.rejected .approval-banner__title { color: #991B1B; }
  .approval-banner__sub   { font-size: var(--text-xs); color: var(--color-text-muted); line-height: 1.5; }

  /* ── Account cards ── */
  .acct-card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); padding: var(--sp-5);
    margin-bottom: var(--sp-5); box-shadow: var(--shadow-sm);
  }
  .acct-card__header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--sp-4); padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--color-border);
  }
  .acct-card__title { font-weight: var(--weight-black); font-size: var(--text-base); display: flex; align-items: center; gap: var(--sp-2); }
  .acct-card__big   { font-size: var(--text-3xl); font-weight: var(--weight-black); color: var(--color-primary); }
  .acct-card__unit  { font-size: var(--text-sm); color: var(--color-text-muted); }
  .acct-tx-list     { display: flex; flex-direction: column; gap: var(--sp-2); }
  .acct-tx {
    display: flex; align-items: center; justify-content: space-between;
    font-size: var(--text-xs); padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .acct-tx:last-child { border-bottom: none; }
  .acct-tx__note  { color: var(--color-text-muted); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .acct-tx__date  { color: var(--color-text-faint); font-size: 10px; margin: 0 var(--sp-2); flex-shrink: 0; }
  .acct-tx__amt   { font-weight: var(--weight-bold); flex-shrink: 0; }
  .acct-tx__amt.pos { color: #16a34a; }
  .acct-tx__amt.neg { color: #dc2626; }
  .acct-empty { text-align: center; color: var(--color-text-faint); font-size: var(--text-xs); padding: var(--sp-4); }
  .rating-summary { display: flex; align-items: center; gap: var(--sp-5); margin-bottom: var(--sp-4); padding-bottom: var(--sp-4); border-bottom: 1px solid var(--color-border); }
  .rating-big     { font-size: var(--text-4xl); font-weight: var(--weight-black); color: var(--color-primary); line-height: 1; }
  .rating-count   { font-size: var(--text-xs); color: var(--color-text-faint); }
  .rating-item    { display: flex; flex-direction: column; gap: 2px; padding: var(--sp-3) 0; border-bottom: 1px solid var(--color-border); }
  .rating-item:last-child { border-bottom: none; }
  .rating-item__top  { display: flex; align-items: center; justify-content: space-between; }
  .rating-item__stars { font-size: var(--text-sm); }
  .rating-item__date  { font-size: 10px; color: var(--color-text-faint); }
  .rating-item__comment { font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 2px; }

  /* ── Fields ── */
  .field { margin-bottom: var(--sp-4); }
  .field__label { display: block; font-weight: var(--weight-bold); font-size: var(--text-sm); margin-bottom: var(--sp-2); }
  .field__input, .field__select, .field__textarea {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    border: 2px solid var(--color-border); border-radius: var(--radius);
    font-family: var(--font-body); font-size: var(--text-sm);
    direction: rtl; color: var(--color-text); background: var(--color-bg);
    outline: none; transition: border-color var(--ease);
  }
  .field__input:focus, .field__select:focus, .field__textarea:focus { border-color: var(--color-primary); }
  .field__textarea { resize: vertical; min-height: 70px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); }

  /* ── Buttons ── */
  .btn-primary {
    background: var(--color-primary); color: #fff; border: none;
    border-radius: var(--radius-lg); padding: var(--sp-3) var(--sp-6);
    font-family: var(--font-body); font-weight: var(--weight-black);
    font-size: var(--text-sm); cursor: pointer; transition: all 0.2s;
  }
  .btn-primary:hover { background: var(--color-primary-dark); }
  .btn-danger {
    background: #fee2e2; color: #b91c1c; border: 1.5px solid #fca5a5;
    border-radius: var(--radius-lg); padding: var(--sp-2) var(--sp-4);
    font-family: var(--font-body); font-size: var(--text-xs);
    font-weight: var(--weight-bold); cursor: pointer; transition: all 0.2s;
  }
  .btn-danger:hover { background: #fca5a5; }
  .btn-ghost {
    background: none; border: 1.5px solid var(--color-border); color: var(--color-text-faint);
    border-radius: var(--radius-lg); padding: var(--sp-2) var(--sp-4);
    font-family: var(--font-body); font-size: var(--text-xs);
    font-weight: var(--weight-bold); cursor: pointer; transition: all 0.2s;
  }
  .btn-ghost:hover { border-color: var(--color-primary); color: var(--color-primary); }

  /* ── Section & product cards ── */
  .section-block {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); margin-bottom: var(--sp-5); overflow: hidden;
  }
  .section-block__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--sp-4) var(--sp-5);
    background: var(--color-bg-soft); border-bottom: 1px solid var(--color-border);
  }
  .section-block__name { font-weight: var(--weight-black); font-size: var(--text-sm); }
  .section-block__actions { display: flex; gap: var(--sp-2); }

  .product-row {
    display: flex; align-items: center; gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5); border-bottom: 1px solid var(--color-border);
    transition: background 0.15s;
  }
  .product-row:last-child { border-bottom: none; }
  .product-row:hover { background: #f9fafb; }
  .product-emoji { font-size: 1.6rem; flex-shrink: 0; }
  .product-info  { flex: 1; min-width: 0; }
  .product-name  { font-weight: var(--weight-bold); font-size: var(--text-sm); }
  .product-desc  { font-size: 11px; color: var(--color-text-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .product-price { font-weight: var(--weight-black); color: #16a34a; font-size: var(--text-base); white-space: nowrap; }
  .product-actions { display: flex; gap: var(--sp-2); align-items: center; flex-shrink: 0; }

  /* Availability toggle */
  .avail-toggle {
    width: 40px; height: 22px; border-radius: 99px;
    background: #d1d5db; border: none; cursor: pointer;
    position: relative; transition: background 0.2s; flex-shrink: 0;
  }
  .avail-toggle::after {
    content: ''; position: absolute; top: 3px; right: 3px;
    width: 16px; height: 16px; border-radius: 50%; background: #fff;
    transition: transform 0.2s;
  }
  .avail-toggle.on { background: #16a34a; }
  .avail-toggle.on::after { transform: translateX(-18px); }

  /* Add product form */
  .add-product-row {
    padding: var(--sp-4) var(--sp-5);
    background: var(--color-primary-light);
    border-top: 1px solid var(--color-border); display: none;
  }
  .add-product-row.visible { display: block; }
  .add-product-row .form-row { margin-bottom: var(--sp-3); }

  /* Edit inline */
  .inline-edit { display: none; }
  .inline-edit.visible { display: grid; }

  /* Orders tab */
  .order-row {
    display: flex; align-items: center; gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5); border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .order-row:last-child { border-bottom: none; }
  .order-id   { font-weight: var(--weight-black); color: var(--color-primary); min-width: 100px; }
  .order-cust { flex: 1; }
  .order-total{ font-weight: var(--weight-black); color: #16a34a; }
  .order-status {
    padding: 2px 10px; border-radius: var(--radius-full);
    font-size: 11px; font-weight: var(--weight-bold);
  }
  .order-status.pending    { background: #fef3c7; color: #92400e; }
  .order-status.preparing  { background: #dbeafe; color: #1e40af; }
  .order-status.on_the_way { background: #ede9fe; color: #6d28d9; }
  .order-status.delivered  { background: #dcfce7; color: #166534; }
  .order-status.rejected   { background: #fee2e2; color: #b91c1c; }

  /* Tab badge */
  .tab-badge {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 20px; height: 20px; padding: 0 6px; margin-inline-start: 4px;
    background: #dc2626; color: #fff; border-radius: 99px;
    font-size: 11px; font-weight: var(--weight-black);
    animation: badge-pop 1.5s ease-in-out infinite;
  }
  @keyframes badge-pop { 0%,100%{transform:scale(1)} 50%{transform:scale(1.18)} }

  /* New order card (needs action) */
  .new-order {
    background: var(--color-bg);
    border: 2px solid #f59e0b; border-radius: var(--radius-2xl);
    padding: var(--sp-5); margin-bottom: var(--sp-4);
    box-shadow: 0 6px 24px rgba(245,158,11,0.18);
    animation: new-order-in 0.4s cubic-bezier(0.34,1.56,0.64,1);
  }
  @keyframes new-order-in { from{opacity:0;transform:translateY(-12px)} to{opacity:1;transform:none} }
  .new-order.ringing { animation: ring-shake 0.6s ease-in-out infinite; }
  @keyframes ring-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-3px)} 75%{transform:translateX(3px)} }
  .new-order__head { display:flex; align-items:center; justify-content:space-between; margin-bottom: var(--sp-3); }
  .new-order__code { font-weight: var(--weight-black); color: var(--color-primary); font-size: var(--text-base); }
  .new-order__time { font-size: 11px; color: var(--color-text-faint); }
  .new-order__cust { font-size: var(--text-sm); margin-bottom: var(--sp-3); }
  .new-order__cust b { font-weight: var(--weight-bold); }
  .new-order__items {
    background: var(--color-bg-soft); border-radius: var(--radius-lg);
    padding: var(--sp-3) var(--sp-4); font-size: var(--text-sm);
    margin-bottom: var(--sp-3); line-height: 1.7;
  }
  .new-order__total { display:flex; justify-content:space-between; font-weight: var(--weight-black); margin-bottom: var(--sp-4); }
  .new-order__total b { color: #16a34a; }
  .new-order__actions { display:flex; gap: var(--sp-3); }
  .btn-accept {
    flex:1; background:#16a34a; color:#fff; border:none; border-radius: var(--radius-lg);
    padding: var(--sp-4); font-family: var(--font-body); font-weight: var(--weight-black);
    font-size: var(--text-base); cursor:pointer; transition: all .2s;
  }
  .btn-accept:hover { background:#15803d; transform: translateY(-1px); }
  .btn-reject {
    background:#fee2e2; color:#b91c1c; border:1.5px solid #fca5a5; border-radius: var(--radius-lg);
    padding: var(--sp-4) var(--sp-5); font-family: var(--font-body); font-weight: var(--weight-bold);
    font-size: var(--text-sm); cursor:pointer; transition: all .2s; white-space:nowrap;
  }
  .btn-reject:hover { background:#fca5a5; }

  /* Active order card */
  .active-order {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); padding: var(--sp-4) var(--sp-5);
    margin-bottom: var(--sp-3); display:flex; align-items:center; gap: var(--sp-4); flex-wrap:wrap;
  }
  .active-order__info { flex:1; min-width: 0; }
  .active-order__code { font-weight: var(--weight-black); color: var(--color-primary); font-size: var(--text-sm); }
  .active-order__meta { font-size: 11px; color: var(--color-text-faint); }
  .ao-driver { font-size: 11px; color:#6d28d9; font-weight: var(--weight-bold); }
  .btn-ready {
    background:var(--color-primary-light); color:var(--color-primary); border:1.5px solid var(--color-border); border-radius: var(--radius-lg);
    padding: var(--sp-2) var(--sp-4); font-family: var(--font-body); font-weight: var(--weight-bold);
    font-size: var(--text-xs); cursor:pointer; transition: all .2s;
  }
  .btn-ready:hover { background:var(--color-border); }
  .searching-pill {
    display:inline-flex; align-items:center; gap:6px; font-size:11px; font-weight:var(--weight-bold);
    color:#92400e; background:#fef3c7; padding:3px 10px; border-radius:99px;
  }
  .searching-pill .dot { width:6px;height:6px;border-radius:50%;background:#f59e0b;animation:blink 1s infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.25} }

  /* Toast */
  .toast {
    position: fixed; bottom: var(--sp-6); right: var(--sp-6);
    background: #1e293b; color: #fff; padding: var(--sp-3) var(--sp-5);
    border-radius: var(--radius-xl); font-size: var(--text-sm);
    font-weight: var(--weight-bold); z-index: 9999;
    transform: translateY(80px); opacity: 0;
    transition: all 0.3s; pointer-events: none;
  }
  .toast.show { transform: translateY(0); opacity: 1; }

  /* Responsive */
  @media (max-width: 768px) {
    .stats-strip { grid-template-columns: repeat(2, 1fr); }
    .form-row    { grid-template-columns: 1fr; }
    .dash-header { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 480px) {
    .stats-strip { grid-template-columns: 1fr 1fr; }
    .product-row { flex-wrap: wrap; }
  }
</style>

<Layout title="لوحة تحكم التاجر | وصّلها" page="">

  <div class="md-page" id="md-root">

    <!-- Loading -->
    <div id="md-loading" style="min-height:50vh;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">
      جاري التحميل...
    </div>

    <!-- Auth gate -->
    <div id="md-gate" class="gate" hidden>
      <div class="gate__icon">🔐</div>
      <h1 class="gate__title">تسجيل الدخول مطلوب</h1>
      <p class="gate__sub">يجب أن تكون مسجّلاً دخولاً للوصول إلى لوحة التحكم</p>
      <a href="/login" class="gate__btn">تسجيل الدخول</a>
    </div>

    <!-- Register store -->
    <div id="md-register" hidden>
      <div class="reg-card">
        <h1 class="reg-card__title">🏪 سجّل متجرك في وصّلها</h1>
        <div id="reg-error" style="background:#fee2e2;color:#b91c1c;border-radius:var(--radius);padding:var(--sp-3);margin-bottom:var(--sp-4);display:none;font-size:var(--text-sm);"></div>
        <div class="form-row">
          <div class="field"><label class="field__label">اسم المتجر</label><input class="field__input" id="reg-name" placeholder="مثال: مطعم الريف" /></div>
          <div class="field"><label class="field__label">الإيموجي 🏪</label><input class="field__input" id="reg-emoji" placeholder="🍕" maxlength="4" /></div>
        </div>
        <div class="form-row">
          <div class="field"><label class="field__label">التصنيف</label>
            <select class="field__select" id="reg-cat">
              <option value="restaurant">🍔 مطعم</option>
              <option value="grocery">🛒 سوبر ماركت</option>
              <option value="pharmacy">💊 صيدلية</option>
              <option value="bakery">🥐 مخبز وحلويات</option>
              <option value="produce">🥬 خضار وفاكهة</option>
              <option value="electronics">📱 إلكترونيات</option>
            </select>
          </div>
          <div class="field"><label class="field__label">المنطقة</label>
            <select class="field__select" id="reg-area">
              <option>دمياط الجديدة</option><option>دمياط</option>
              <option>كفر سعد</option><option>فارسكور</option>
              <option>رأس البر</option><option>الزرقا</option>
            </select>
          </div>
        </div>
        <div class="field"><label class="field__label">العنوان التفصيلي</label><input class="field__input" id="reg-address" placeholder="مثال: شارع الجيش، بجوار بنك مصر" /></div>
        <div class="form-row">
          <div class="field"><label class="field__label">رقم الهاتف</label><input class="field__input" id="reg-phone" placeholder="057-226-XXXX" /></div>
          <div class="field"><label class="field__label">رسوم التوصيل (ج.م)</label><input class="field__input" id="reg-fee" type="number" value="20" min="0" /></div>
        </div>
        <div class="form-row">
          <div class="field"><label class="field__label">الحد الأدنى للطلب (ج.م)</label><input class="field__input" id="reg-min" type="number" value="50" min="0" /></div>
          <div class="field"><label class="field__label">وقت التوصيل</label><input class="field__input" id="reg-time" placeholder="30–45 دقيقة" /></div>
        </div>
        <div class="field"><label class="field__label">وصف مختصر (tagline)</label><input class="field__input" id="reg-tagline" placeholder="مثال: أشهى المشويات في دمياط" /></div>
