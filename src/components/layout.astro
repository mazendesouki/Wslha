---
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description: string;
  page?: string;
}

const { title, description, page = '' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://wslha.co');
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- SEO -->
  <title>{title} | وصّلها</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>

  <!-- Open Graph -->
  <meta property="og:title"       content={`${title} | وصّلها`}>
  <meta property="og:description" content={description}>
  <meta property="og:type"        content="website">
  <meta property="og:url"         content={canonicalURL}>

  <!-- Icons & PWA -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/icon.svg"    type="image/svg+xml">
  <link rel="apple-touch-icon"    href="/apple-touch-icon.png">
  <link rel="manifest"            href="/site.webmanifest">
  <meta name="theme-color"        content="#3B6EF8">

  <!-- iOS standalone web-app -->
  <meta name="mobile-web-app-capable"             content="yes">
  <meta name="apple-mobile-web-app-capable"       content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title"         content="وصّلها">

  <!-- Disable Netlify Identity widget -->
  <meta name="netlify-identity-widget" content="disabled">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Base styles -->
  <link rel="stylesheet" href="/global.css">

  <!-- Capture beforeinstallprompt ASAP (Chrome/Edge/Samsung) -->
  <script is:inline>
    window.__pwaPrompt = null;
    window.addEventListener('beforeinstallprompt', function(e) {
      e.preventDefault();
      window.__pwaPrompt = e;
      var fab = document.getElementById('pwa-fab');
      if (fab) fab.hidden = false;
    });
  </script>

  <style is:global>
    /* ── Layout utilities ──────────────────────────────────── */
    .container {
      max-width: var(--container);
      margin: 0 auto;
      padding: 0 var(--sp-6);
    }

    .section {
      padding: var(--sp-20) var(--sp-6);
    }

    /* ── Button system ─────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      padding: var(--sp-3) var(--sp-6);
      border-radius: var(--radius);
      font-family: var(--font-body);
      font-size: var(--text-base);
      font-weight: var(--weight-bold);
      border: none;
      transition: background var(--ease), transform var(--ease), border-color var(--ease);
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      line-height: 1;
    }

    .btn:focus-visible {
      outline: 3px solid var(--color-accent);
      outline-offset: 3px;
    }

    .btn--primary {
      background: var(--color-primary);
      color: #fff;
    }
    .btn--primary:hover { background: var(--color-primary-dark); transform: translateY(-1px); }

    .btn--accent {
      background: var(--color-accent);
      color: var(--color-text);
    }
    .btn--accent:hover { background: var(--color-accent-dark); transform: translateY(-1px); }

    .btn--white {
      background: #fff;
      color: var(--color-primary);
      border: 2px solid #fff;
    }
    .btn--white:hover { background: var(--color-primary-light); border-color: var(--color-primary-light); }

    .btn--outline {
      background: transparent;
      color: var(--color-primary);
      border: 2px solid var(--color-primary);
    }
    .btn--outline:hover { background: var(--color-primary-light); }

    /* ── Accessibility ─────────────────────────────────────── */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    /* ── WhatsApp float ────────────────────────────────────── */
    .whatsapp-float {
      position: fixed;
      bottom: var(--sp-6);
      right: var(--sp-6);
      width: 52px;
      height: 52px;
      background: #25D366;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--text-xl);
      box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
      z-index: 999;
      transition: transform var(--ease);
    }

    .whatsapp-float:hover   { transform: scale(1.1); }
    .whatsapp-float:focus-visible {
      outline: 3px solid var(--color-accent);
      outline-offset: 3px;
    }
  </style>
</head>

<body>
  <Nav currentPage={page} />

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <a
    href="https://wa.me/201102667324"
    class="whatsapp-float"
    aria-label="تواصل معنا عبر واتساب"
    rel="noopener noreferrer"
    target="_blank"
  >
    💬
  </a>

  <Footer />

  <!-- ── بانر تثبيت التطبيق — يظهر تلقائياً بـ CSS بدون انتظار JS ── -->
  <div id="pwa-banner" class="pwa-banner">
    <div class="pwa-banner__inner">
      <button class="pwa-banner__close" id="pwa-banner-close" aria-label="إغلاق">✕</button>
      <div class="pwa-banner__app">
        <img src="/icon-192.png" width="52" height="52" alt="" class="pwa-banner__logo">
        <div class="pwa-banner__info">
          <div class="pwa-banner__name">📲 وصّلها</div>
          <div class="pwa-banner__sub">ثبّت التطبيق — أسرع وأسهل من المتصفح</div>
          <div class="pwa-banner__rating">⭐⭐⭐⭐⭐ &nbsp;مجاني تماماً</div>
        </div>
      </div>
      <button id="pwa-install-btn" class="pwa-banner__btn">⬇️ تثبيت التطبيق الآن</button>
    </div>
  </div>

  <!-- مودال تعليمات التثبيت -->
  <div id="pwa-modal" class="pwa-modal" hidden role="dialog" aria-modal="true">
    <div class="pwa-modal__box">
      <button class="pwa-modal__close" id="pwa-modal-close" aria-label="إغلاق">✕</button>
      <img src="/icon-192.png" width="60" height="60" alt="وصّلها" style="border-radius:14px;margin-bottom:10px">
      <h2 class="pwa-modal__title">ثبّت تطبيق وصّلها</h2>
      <p class="pwa-modal__sub">أيقونة مباشرة على شاشتك الرئيسية</p>
      <ol class="pwa-modal__steps" id="pwa-steps"></ol>
    </div>
  </div>

  <style is:global>
    /* بانر التثبيت — يظهر بـ CSS animation مباشرة */
    @keyframes pwa-slide-up {
      from { transform: translateY(100%); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }
    .pwa-banner {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      z-index: 9999;
      animation: pwa-slide-up .4s ease-out 1.5s both;
      padding-bottom: env(safe-area-inset-bottom, 0);
    }
    .pwa-banner.pwa-hidden { display: none; }
    .pwa-banner__inner {
      background: #fff;
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -6px 40px rgba(0,0,0,0.18);
      padding: 16px 18px 18px;
      direction: rtl;
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 500px;
      margin: 0 auto;
      position: relative;
    }
    .pwa-banner__close {
      position: absolute; top: 12px; left: 12px;
      width: 28px; height: 28px; border-radius: 50%;
      background: #eee; border: none; font-size: 13px;
      cursor: pointer; color: #555;
      display: flex; align-items: center; justify-content: center;
    }
    .pwa-banner__app { display: flex; align-items: center; gap: 12px; }
    .pwa-banner__logo { border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); flex-shrink: 0; }
    .pwa-banner__info { flex: 1; }
    .pwa-banner__name { font-size: 16px; font-weight: 800; color: #111; font-family: var(--font-body,sans-serif); }
    .pwa-banner__sub  { font-size: 12px; color: #555; margin-top: 2px; font-family: var(--font-body,sans-serif); }
    .pwa-banner__rating { font-size: 11px; color: #888; margin-top: 3px; font-family: var(--font-body,sans-serif); }
    .pwa-banner__btn {
      background: #3B6EF8; color: #fff; border: none;
      border-radius: 12px; padding: 14px;
      font-family: var(--font-body,sans-serif); font-size: 15px; font-weight: 800;
      width: 100%; cursor: pointer;
      box-shadow: 0 4px 18px rgba(59,110,248,.4);
      touch-action: manipulation;
    }
    .pwa-banner__btn:active { opacity: .9; transform: scale(.98); }

    .pwa-modal { position:fixed; inset:0; background:rgba(0,0,0,.6); display:flex; align-items:flex-end; justify-content:center; z-index:10000; padding:16px; }
    .pwa-modal[hidden] { display:none; }
    .pwa-modal__box { background:#fff; border-radius:20px 20px 14px 14px; padding:24px 20px 28px; width:100%; max-width:400px; text-align:center; direction:rtl; position:relative; }
    .pwa-modal__close { position:absolute; top:10px; left:10px; background:#eee; border:none; border-radius:50%; width:36px; height:36px; font-size:15px; cursor:pointer; }
    .pwa-modal__title { font-size:19px; font-weight:800; color:#111; margin:0 0 5px; }
    .pwa-modal__sub { font-size:13px; color:#666; margin:0 0 18px; }
    .pwa-modal__steps { list-style:none; padding:0; margin:0; text-align:right; display:flex; flex-direction:column; gap:10px; }
    .pwa-modal__steps li { display:flex; align-items:center; gap:10px; background:#f5f7ff; border-radius:10px; padding:11px 13px; font-size:13px; font-weight:600; color:#111; }
    .pwa-modal__steps li .step-num { background:#3B6EF8; color:#fff; border-radius:50%; width:24px; height:24px; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; flex-shrink:0; }
    .pwa-modal__extra { margin-top:14px; }
    .pwa-chrome-btn { display:block; background:#3B6EF8; color:#fff; text-decoration:none; border-radius:10px; padding:13px; font-weight:700; font-size:14px; text-align:center; }
  </style>

  <script is:inline>
    // ── Service worker ────────────────────────────────────────
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(function(){});
    }

    // ── PWA Banner ────────────────────────────────────────────
    (function () {
      var banner     = document.getElementById('pwa-banner');
      var closeBtn   = document.getElementById('pwa-banner-close');
      var installBtn = document.getElementById('pwa-install-btn');
      var modal      = document.getElementById('pwa-modal');
      var steps      = document.getElementById('pwa-steps');
      var modalClose = document.getElementById('pwa-modal-close');

      // امسح مفاتيح localStorage القديمة
      try { localStorage.removeItem('wslha_dismissed'); } catch(x) {}

      function hide(el) { if (el) el.classList.add('pwa-hidden'); }

      // أخفِ إذا مثبّت أو رُفض مؤخراً
      var dismissed = parseInt(localStorage.getItem('wslha_da') || '0', 10);
      var installed = localStorage.getItem('wslha_installed') === '1'
        || window.matchMedia('(display-mode: standalone)').matches
        || !!window.navigator.standalone;
      if (installed || (dismissed && Date.now() - dismissed < 3*86400000)) {
        hide(banner); return;
      }

      var ua = navigator.userAgent;
      var isIOS    = /iP(hone|ad|od)/.test(ua);
      var isSafari = isIOS && /WebKit/.test(ua) && !/CriOS|FxiOS/.test(ua);
      var isFF     = /Firefox\//.test(ua);

      // زر الإغلاق
      if (closeBtn) closeBtn.addEventListener('click', function() {
        hide(banner);
        try { localStorage.setItem('wslha_da', String(Date.now())); } catch(x) {}
      });

      // زر التثبيت
      if (installBtn) installBtn.addEventListener('click', function() {
        if (window.__pwaPrompt) {
          hide(banner);
          window.__pwaPrompt.prompt();
          window.__pwaPrompt.userChoice.then(function(c) {
            if (c.outcome === 'accepted') try { localStorage.setItem('wslha_installed','1'); } catch(x) {}
            window.__pwaPrompt = null;
          });
        } else if (isSafari) {
          hide(banner);
          openModal(['اضغط زر المشاركة 🔗 أسفل شاشة Safari','اختر "إضافة إلى الشاشة الرئيسية" 📲','اضغط "إضافة" ✅']);
        } else {
          hide(banner);
          openModal(['افتح قائمة المتصفح ⋮ أو ⋯','اختر "إضافة إلى الشاشة الرئيسية" 📲','اضغط "تثبيت" أو "إضافة" ✅']);
        }
      });

      function openModal(arr) {
        if (!steps || !modal) return;
        steps.innerHTML = '';
        arr.forEach(function(t,i){
          var li = document.createElement('li');
          li.innerHTML = '<span class="step-num">'+(i+1)+'</span><span>'+t+'</span>';
          steps.appendChild(li);
        });
        modal.hidden = false;
      }
      if (modalClose) modalClose.addEventListener('click', function(){ modal.hidden = true; });
      if (modal) modal.addEventListener('click', function(e){ if(e.target===modal) modal.hidden=true; });

      window.addEventListener('beforeinstallprompt', function(e) {
        e.preventDefault(); window.__pwaPrompt = e;
      });
      window.addEventListener('appinstalled', function() {
        try { localStorage.setItem('wslha_installed','1'); } catch(x) {}
        hide(banner); modal.hidden = true;
      });
    })();

    // ── Native (Capacitor) progressive enhancement ───────────
    // Runs only inside the packaged Android/iOS app. On the web this
    // block is inert, so the same build serves browser + native.
    (function () {
      var Cap = window.Capacitor;
      if (!Cap || !Cap.isNativePlatform || !Cap.isNativePlatform()) return;

      var P = Cap.Plugins || {};

      // Status bar to brand colour.
      if (P.StatusBar) {
        try {
          P.StatusBar.setBackgroundColor({ color: '#2952D9' });
          P.StatusBar.setStyle({ style: 'LIGHT' });
        } catch (e) {}
      }

      // Hide the splash once the page is interactive.
      if (P.SplashScreen) {
        try { P.SplashScreen.hide(); } catch (e) {}
      }

      // Request notification permission (+ register push if available).
      if (P.PushNotifications) {
        try {
          P.PushNotifications.requestPermissions().then(function (r) {
            if (r && r.receive === 'granted') P.PushNotifications.register();
          });
        } catch (e) {}
      }
      if (P.LocalNotifications) {
        try { P.LocalNotifications.requestPermissions(); } catch (e) {}
      }

      // Bridge web notification calls to native local notifications so
      // status/order alerts still fire inside the WebView.
      if (P.LocalNotifications) {
        window.wslhaNativeNotify = function (title, body) {
          try {
            P.LocalNotifications.schedule({
              notifications: [{
                id: Date.now() % 100000,
                title: title || 'وصّلها',
                body: body || '',
                smallIcon: 'ic_stat_icon',
              }],
            });
          } catch (e) {}
        };
      }

      // Hardware back button: go back in history, else stay (don't exit abruptly).
      if (P.App) {
        try {
          P.App.addListener('backButton', function (info) {
            if (info && info.canGoBack) window.history.back();
            else if (P.App.exitApp) P.App.exitApp();
          });
        } catch (e) {}
      }
    })();
  </script>
</body>
</html>
