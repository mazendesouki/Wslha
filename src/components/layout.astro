---
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description: string;
  page?: string;
}

const { title, description, page = '' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://wslha.co');
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- SEO -->
  <title>{title} | وصّلها</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>

  <!-- Open Graph -->
  <meta property="og:title"       content={`${title} | وصّلها`}>
  <meta property="og:description" content={description}>
  <meta property="og:type"        content="website">
  <meta property="og:url"         content={canonicalURL}>

  <!-- Icons & PWA -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/icon.svg"    type="image/svg+xml">
  <link rel="apple-touch-icon"    href="/apple-touch-icon.png">
  <link rel="manifest"            href="/site.webmanifest">
  <meta name="theme-color"        content="#3B6EF8">

  <!-- iOS standalone web-app -->
  <meta name="mobile-web-app-capable"             content="yes">
  <meta name="apple-mobile-web-app-capable"       content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title"         content="وصّلها">

  <!-- Disable Netlify Identity widget -->
  <meta name="netlify-identity-widget" content="disabled">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Base styles -->
  <link rel="stylesheet" href="/global.css">

  <!-- Capture beforeinstallprompt ASAP (Chrome/Edge/Samsung) -->
  <script is:inline>
    window.__pwaPrompt = null;
    window.addEventListener('beforeinstallprompt', function(e) {
      e.preventDefault();
      window.__pwaPrompt = e;
      var fab = document.getElementById('pwa-fab');
      if (fab) fab.hidden = false;
    });
  </script>

  <style is:global>
    /* ── Layout utilities ──────────────────────────────────── */
    .container {
      max-width: var(--container);
      margin: 0 auto;
      padding: 0 var(--sp-6);
    }

    .section {
      padding: var(--sp-20) var(--sp-6);
    }

    /* ── Button system ─────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      padding: var(--sp-3) var(--sp-6);
      border-radius: var(--radius);
      font-family: var(--font-body);
      font-size: var(--text-base);
      font-weight: var(--weight-bold);
      border: none;
      transition: background var(--ease), transform var(--ease), border-color var(--ease);
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      line-height: 1;
    }

    .btn:focus-visible {
      outline: 3px solid var(--color-accent);
      outline-offset: 3px;
    }

    .btn--primary {
      background: var(--color-primary);
      color: #fff;
    }
    .btn--primary:hover { background: var(--color-primary-dark); transform: translateY(-1px); }

    .btn--accent {
      background: var(--color-accent);
      color: var(--color-text);
    }
    .btn--accent:hover { background: var(--color-accent-dark); transform: translateY(-1px); }

    .btn--white {
      background: #fff;
      color: var(--color-primary);
      border: 2px solid #fff;
    }
    .btn--white:hover { background: var(--color-primary-light); border-color: var(--color-primary-light); }

    .btn--outline {
      background: transparent;
      color: var(--color-primary);
      border: 2px solid var(--color-primary);
    }
    .btn--outline:hover { background: var(--color-primary-light); }

    /* ── Accessibility ─────────────────────────────────────── */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    /* ── WhatsApp float ────────────────────────────────────── */
    .whatsapp-float {
      position: fixed;
      bottom: var(--sp-6);
      right: var(--sp-6);
      width: 52px;
      height: 52px;
      background: #25D366;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--text-xl);
      box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
      z-index: 999;
      transition: transform var(--ease);
    }

    .whatsapp-float:hover   { transform: scale(1.1); }
    .whatsapp-float:focus-visible {
      outline: 3px solid var(--color-accent);
      outline-offset: 3px;
    }
  </style>
</head>

<body>
  <Nav currentPage={page} />

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <a
    href="https://wa.me/201000000000"
    class="whatsapp-float"
    aria-label="تواصل معنا عبر واتساب"
    rel="noopener noreferrer"
    target="_blank"
  >
    💬
  </a>

  <Footer />

  <!-- ── زرار + مودال تثبيت التطبيق (يعمل على كل المتصفحات) ── -->
  <button id="pwa-fab" class="pwa-fab" hidden aria-label="تثبيت التطبيق">
    <span class="pwa-fab__icon">📲</span>
    <span class="pwa-fab__text">تثبيت التطبيق</span>
  </button>

  <!-- مودال تعليمات Safari/Firefox -->
  <div id="pwa-modal" class="pwa-modal" hidden role="dialog" aria-modal="true" aria-label="تثبيت التطبيق">
    <div class="pwa-modal__box">
      <button class="pwa-modal__close" id="pwa-modal-close" aria-label="إغلاق">✕</button>
      <div class="pwa-modal__icon">📲</div>
      <h2 class="pwa-modal__title">ثبّت تطبيق وصّلها</h2>
      <p class="pwa-modal__sub">أسرع وأسهل — أيقونة مباشرة على شاشتك</p>
      <ol class="pwa-modal__steps" id="pwa-steps"></ol>
    </div>
  </div>

  <style is:global>
    .pwa-fab {
      position: fixed;
      bottom: 80px;
      left: 16px;
      display: flex;
      align-items: center;
      gap: 6px;
      background: #3B6EF8;
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: 10px 18px 10px 14px;
      font-family: var(--font-body, sans-serif);
      font-size: 14px;
      font-weight: 700;
      box-shadow: 0 4px 16px rgba(59,110,248,.4);
      cursor: pointer;
      z-index: 1000;
      transition: transform .2s, opacity .2s;
    }
    .pwa-fab:active { transform: scale(.94); }
    .pwa-fab__icon { font-size: 18px; line-height: 1; }

    .pwa-modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.55);
      display: flex;
      align-items: flex-end;
      justify-content: center;
      z-index: 2000;
      padding: 16px;
    }
    .pwa-modal[hidden] { display: none; }
    .pwa-modal__box {
      background: #fff;
      border-radius: 20px 20px 16px 16px;
      padding: 28px 24px 32px;
      width: 100%;
      max-width: 420px;
      text-align: center;
      position: relative;
      direction: rtl;
    }
    .pwa-modal__close {
      position: absolute;
      top: 14px;
      left: 16px;
      background: #f0f0f0;
      border: none;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      font-size: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .pwa-modal__icon { font-size: 48px; margin-bottom: 8px; }
    .pwa-modal__title { font-size: 20px; font-weight: 800; color: #1a1a2e; margin: 0 0 6px; }
    .pwa-modal__sub { font-size: 14px; color: #666; margin: 0 0 20px; }
    .pwa-modal__steps {
      list-style: none;
      padding: 0;
      margin: 0;
      text-align: right;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .pwa-modal__steps li {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #f7f8ff;
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 14px;
      font-weight: 600;
      color: #1a1a2e;
    }
    .pwa-modal__steps li span.step-num {
      background: #3B6EF8;
      color: #fff;
      border-radius: 50%;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 800;
      flex-shrink: 0;
    }
  </style>

  <script is:inline>
    // ── Service worker registration ──────────────────────────
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () {});
      });
    }

    // ── Universal PWA install ────────────────────────────────
    (function () {
      var fab   = document.getElementById('pwa-fab');
      var modal = document.getElementById('pwa-modal');
      var steps = document.getElementById('pwa-steps');
      var closeBtn = document.getElementById('pwa-modal-close');

      function isInstalled() {
        return window.matchMedia('(display-mode: standalone)').matches ||
               window.navigator.standalone === true ||
               localStorage.getItem('wslha_installed') === '1';
      }

      if (isInstalled()) return;

      // ── Detect browser ────────────────────────────────────
      var ua = navigator.userAgent;
      var isIOS = /iP(hone|ad|od)/.test(ua);
      var isSafari = isIOS && /WebKit/.test(ua) && !/CriOS|FxiOS|OPiOS/.test(ua);
      var isFirefox = /Firefox\//.test(ua) && !/Seamonkey/.test(ua);
      var isChromeLike = 'onbeforeinstallprompt' in window || window.__pwaPrompt !== undefined;

      function makeStep(num, text) {
        var li = document.createElement('li');
        li.innerHTML = '<span class="step-num">' + num + '</span><span>' + text + '</span>';
        return li;
      }

      function showModal(stepsArr) {
        if (!steps || !modal) return;
        steps.innerHTML = '';
        stepsArr.forEach(function(t, i) { steps.appendChild(makeStep(i + 1, t)); });
        modal.hidden = false;
      }

      function hideModal() {
        if (modal) modal.hidden = true;
      }

      if (closeBtn) closeBtn.addEventListener('click', hideModal);
      if (modal) modal.addEventListener('click', function(e) {
        if (e.target === modal) hideModal();
      });

      // ── Chrome/Edge/Samsung: use native prompt ────────────
      if (window.__pwaPrompt) {
        if (fab) fab.hidden = false;
      }

      window.addEventListener('beforeinstallprompt', function(e) {
        e.preventDefault();
        window.__pwaPrompt = e;
        if (fab) fab.hidden = false;
      });

      if (fab) fab.addEventListener('click', function () {
        if (window.__pwaPrompt) {
          // Chrome/Edge: trigger native dialog
          fab.hidden = true;
          window.__pwaPrompt.prompt();
          window.__pwaPrompt.userChoice.then(function(c) {
            if (c.outcome === 'accepted') {
              try { localStorage.setItem('wslha_installed', '1'); } catch(x) {}
            } else {
              if (fab) fab.hidden = false;
            }
            window.__pwaPrompt = null;
          });
        } else if (isSafari) {
          // Safari iOS: manual instructions
          showModal([
            'اضغط على زر المشاركة 🔗 في شريط Safari أسفل الشاشة',
            'اختر "إضافة إلى الشاشة الرئيسية" 📲',
            'اضغط "إضافة" في الأعلى ✅'
          ]);
        } else if (isFirefox) {
          // Firefox Android
          showModal([
            'اضغط على النقاط الثلاث ⋮ في شريط Firefox',
            'اختر "تثبيت" أو "إضافة إلى الشاشة الرئيسية" 📲',
            'اضغط "إضافة" ✅'
          ]);
        } else {
          // Other browsers
          showModal([
            'افتح قائمة المتصفح (النقاط الثلاث ⋮)',
            'اختر "إضافة إلى الشاشة الرئيسية" 📲',
            'اضغط "إضافة" أو "تثبيت" ✅'
          ]);
        }
      });

      // ── Show FAB for Safari/Firefox even without beforeinstallprompt
      if (!window.__pwaPrompt && (isSafari || isFirefox || (!isChromeLike))) {
        if (fab) fab.hidden = false;
      }

      window.addEventListener('appinstalled', function () {
        try { localStorage.setItem('wslha_installed', '1'); } catch(x) {}
        if (fab) fab.hidden = true;
        hideModal();
        window.__pwaPrompt = null;
      });
    })();

    // ── Native (Capacitor) progressive enhancement ───────────
    // Runs only inside the packaged Android/iOS app. On the web this
    // block is inert, so the same build serves browser + native.
    (function () {
      var Cap = window.Capacitor;
      if (!Cap || !Cap.isNativePlatform || !Cap.isNativePlatform()) return;

      var P = Cap.Plugins || {};

      // Status bar to brand colour.
      if (P.StatusBar) {
        try {
          P.StatusBar.setBackgroundColor({ color: '#2952D9' });
          P.StatusBar.setStyle({ style: 'LIGHT' });
        } catch (e) {}
      }

      // Hide the splash once the page is interactive.
      if (P.SplashScreen) {
        try { P.SplashScreen.hide(); } catch (e) {}
      }

      // Request notification permission (+ register push if available).
      if (P.PushNotifications) {
        try {
          P.PushNotifications.requestPermissions().then(function (r) {
            if (r && r.receive === 'granted') P.PushNotifications.register();
          });
        } catch (e) {}
      }
      if (P.LocalNotifications) {
        try { P.LocalNotifications.requestPermissions(); } catch (e) {}
      }

      // Bridge web notification calls to native local notifications so
      // status/order alerts still fire inside the WebView.
      if (P.LocalNotifications) {
        window.wslhaNativeNotify = function (title, body) {
          try {
            P.LocalNotifications.schedule({
              notifications: [{
                id: Date.now() % 100000,
                title: title || 'وصّلها',
                body: body || '',
                smallIcon: 'ic_stat_icon',
              }],
            });
          } catch (e) {}
        };
      }

      // Hardware back button: go back in history, else stay (don't exit abruptly).
      if (P.App) {
        try {
          P.App.addListener('backButton', function (info) {
            if (info && info.canGoBack) window.history.back();
            else if (P.App.exitApp) P.App.exitApp();
          });
        } catch (e) {}
      }
    })();
  </script>
</body>
</html>
