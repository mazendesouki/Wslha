---
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'right';
}

const { badge, title, subtitle, align = 'center' } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`]}>
  {badge && <span class="section-header__badge">{badge}</span>}
  <h2 class="section-header__title">{title}</h2>
  {subtitle && <p class="section-header__subtitle">{subtitle}</p>}
</div>

<style>
  .section-header { margin-bottom: var(--sp-12); }

  .section-header--center { text-align: center; }
  .section-header--right  { text-align: right; }

  .section-header__badge {
    display: inline-block;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    padding: var(--sp-1) var(--sp-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--sp-3);
  }

  .section-header__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-black);
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: var(--sp-3);
  }

  .section-header__subtitle {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.7;
    max-width: 560px;
  }

  .section-header--center .section-header__subtitle { margin: 0 auto; }

  @media (max-width: 640px) {
    .section-header__title { font-size: var(--text-3xl); }
  }
</style>
