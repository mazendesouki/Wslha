---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class:list={['app-cta', { 'app-cta--compact': compact }]}>
  <div class="app-cta__inner">
    <div class="app-cta__text">
      <span class="app-cta__eyebrow">📲 التطبيق</span>
      <h2 class="app-cta__title">احجز الخدمة من تطبيق وصّلها</h2>
      <p class="app-cta__desc">
        الحجز الفعلي بقى بس من تطبيق الموبايل — تتبّع لحظي للسائق، دفع أسهل، وإشعارات فورية.
        حمّل التطبيق دلوقتي وابدأ.
      </p>
    </div>
    <div class="app-cta__actions">
      <a href="/downloads/wslha-customer.apk" download class="app-cta__btn app-cta__btn--primary">
        ⬇️ تحميل تطبيق العميل (Android)
      </a>
      <a href="/download" class="app-cta__btn app-cta__btn--ghost">طريقة التثبيت خطوة بخطوة</a>
    </div>
  </div>
</section>

<style>
  .app-cta {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: var(--radius-xl);
    padding: var(--sp-10) var(--sp-8);
    color: #fff;
    margin: var(--sp-10) 0;
  }
  .app-cta--compact { padding: var(--sp-6) var(--sp-6); margin: var(--sp-6) 0; }
  .app-cta__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-5);
  }
  .app-cta__eyebrow {
    display: inline-block;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.3);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    padding: var(--sp-1) var(--sp-4);
    border-radius: var(--radius-full);
  }
  .app-cta__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    margin: var(--sp-3) 0 var(--sp-2);
  }
  .app-cta__desc { color: rgba(255,255,255,.85); font-size: var(--text-sm); line-height: 1.7; }
  .app-cta__actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; justify-content: center; }
  .app-cta__btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 26px; border-radius: var(--radius-lg);
    font-weight: var(--weight-black); font-size: var(--text-sm);
    text-decoration: none; transition: transform .15s, box-shadow .15s;
  }
  .app-cta__btn--primary { background: var(--color-accent); color: #241a0a; box-shadow: 0 8px 22px rgba(184,134,59,.35); }
  .app-cta__btn--primary:hover { transform: translateY(-2px); }
  .app-cta__btn--ghost { background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(255,255,255,.35); }
  .app-cta__btn--ghost:hover { background: rgba(255,255,255,.2); }
</style>
