/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your (release) keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# Exception: app/debug.keystore is a fixed DEBUG-only key (fixed password
# "android", same as Android's own auto-generated default) committed on
# purpose so every CI build signs identically — otherwise each GitHub
# Actions run generates a fresh random debug key and every install
# conflicts with the previous one ("package conflicts with an existing
# package"). Never do this for a release keystore.
!app/debug.keystore
