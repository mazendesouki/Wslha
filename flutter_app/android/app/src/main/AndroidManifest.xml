<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Driver flavor: one-shot position fetch when going online (see
         features/driver/driver_repository.dart). Customer flavor: the
         "استخدم موقعي" GPS button on the rides "من" field (see
         features/rides/address_field.dart). Harmless to declare in every
         flavor — merchant just never prompts for it since it never calls
         Geolocator. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Flutter's tooling auto-injects this for debug/profile builds, but
         NOT for release — declare it explicitly so Supabase/Places/HTTP
         calls keep working once we build a real release APK. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ requires this to actually show notifications — the
         flutter_local_notifications requestNotificationsPermission() call
         in core/notifications.dart prompts the user for it at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Driver flavor: capturing the personal photo on the native
         registration screen (features/auth/driver_register_screen.dart)
         via image_picker's camera source. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- google_maps_flutter (live tracking map) — same Android-app-
             restricted key already used for Static Maps/Places (see
             core/maps_launcher.dart); needs "Maps SDK for Android" enabled
             on it in Google Cloud Console. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCSJQuStVvhhNhbAZF1tuwO_IacicXqyhM"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher needs these declared (Android 11+ package
             visibility) to open the phone dialer (تليفون السائق/العميل),
             WhatsApp chats (wa.me), and Google Maps navigation links. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
