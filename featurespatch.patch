+  /* ── Reply to rating ── */
+  async function sendRatingReply(ratingId, btn) {
+    const form  = btn.closest('.rating-reply-form');
+    const input = form.querySelector('textarea');
+    const reply = (input.value || '').trim();
+    if (!reply) { input.focus(); return; }
+    btn.disabled = true;
+    btn.textContent = '...';
+    try {
+      const res = await fetch(`${SB_URL}/rest/v1/ratings?id=eq.${ratingId}`, {
+        method: 'PATCH',
+        headers: { ...SB_H, Prefer: 'return=minimal' },
+        body: JSON.stringify({ driver_reply: reply }),
+      });
+      if (res.ok) {
+        const item = document.getElementById('rt-' + ratingId);
+        if (item) {
+          form.outerHTML = `<div class="rating-item__reply"><div class="rating-item__reply-label">ردك:</div>${reply}</div>`;
+        }
+      } else {
+        btn.disabled = false;
+        btn.textContent = 'إرسال';
+        alert('حدث خطأ، حاول مرة أخرى');
+      }
+    } catch { btn.disabled = false; btn.textContent = 'إرسال'; }
+  }
+  window.sendRatingReply = sendRatingReply;
