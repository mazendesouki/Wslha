{
  "appId": "co.wslha.app",
  "appName": "وصّلها",
  "webDir": "dist",
  "backgroundColor": "#082F2E",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0E4B49",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"],
      "fcmSenderId": "840374700129"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#0E4B49"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#082F2E"
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
